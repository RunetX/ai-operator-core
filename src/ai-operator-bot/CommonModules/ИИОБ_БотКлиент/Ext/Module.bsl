// Клиентская часть канала «бот СВ»: нажатие кнопок под ответом бота и подбор получателей.
// Кнопки нажимает человек: инструмент вызывается через клиентский реестр ядра с правами нажавшего,
// предпросмотр строится заново в его сеансе, «Выполнить» нажимает он сам.

#Область СлужебныйПрограммныйИнтерфейс

// Нажатие кнопки в сообщении Системы взаимодействия. Кнопки конфигурации сюда тоже приходят - их пропускаем.
//
// Параметры:
//  Сообщение - СообщениеСистемыВзаимодействия
//  Кнопка - КнопкаПанелиКнопокСообщенияСистемыВзаимодействия
Процедура ПриНажатииКнопки(Сообщение, Кнопка) Экспорт

	Если Кнопка.ИмяДействия <> ИИОБ_БотКлиентСервер.ИмяДействияКнопки() Тогда
		Возврат;
	КонецЕсли;
	Данные = Кнопка.Данные;
	Если Не ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки(Данные) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Кнопка устарела: задайте вопрос ИИ-оператору еще раз.'"));
		Возврат;
	КонецЕсли;
	// Кнопку видят все участники обсуждения, а предложена она владельцу бота: с его правами и по его вопросу.
	// Окончательная проверка владельца - на сервере при записи итога (ИИОБ_Бот.НаписатьИтог).
	Если Данные.ВладелецСВ <> ИИОБ_БотВызовСервераПовтИсп.ТекущийПользовательСВ() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Кнопки ответа работают у того, кто задал вопрос. Спросите своего ИИ-оператора.'"));
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВызоваИнструмента", ИИОБ_БотКлиент, Данные);
	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("bot");
	ПараметрыВызова.ОповещениеОЗавершении = Оповещение;
	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать(Данные.Инструмент, Данные.Аргументы, ПараметрыВызова);
	Если Ответ <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(Оповещение, Ответ);
	КонецЕсли;

КонецПроцедуры

// Подбор получателей: каждому оставляем только его личного бота, чужих убираем.
//
// Параметры:
//  Текст - Строка
//  ДанныеВыбора - СписокЗначений, Неопределено
//  НазначениеВыбора - НазначениеВыбораПользователейСистемыВзаимодействия
Процедура АвтоПодбор(Текст, ДанныеВыбора, НазначениеВыбора) Экспорт

	Если ТипЗнч(ДанныеВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	Скрыть = ИИОБ_БотВызовСервераПовтИсп.ПравилаПодбора().Скрыть;
	Если Скрыть.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Индекс = ДанныеВыбора.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Идентификаторы = ИИОБ_БотКлиентСервер.ИдентификаторыЭлементаПодбора(ДанныеВыбора[Индекс].Значение);
		Для Каждого Идентификатор Из Идентификаторы Цикл
			Если Скрыть.Найти(Строка(Идентификатор)) <> Неопределено Тогда
				ДанныеВыбора.Удалить(Индекс);
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс - 1;
	КонецЦикла;

КонецПроцедуры

// Продолжение ПриНажатииКнопки: ответ инструмента. После предпросмотра итог действия пишется в ветку.
//
// Параметры:
//  Ответ - Структура, Соответствие - Ответ инструмента после маскирования клиентским реестром.
//  Данные - см. ИИОБ_БотКлиентСервер.НовыеДанныеКнопки
Процедура ПослеВызоваИнструмента(Ответ, Данные) Экспорт

	Если Данные.Инструмент = "perform" Тогда
		ИИОБ_БотВызовСервера.НаписатьИтог(Данные, Ответ);
	ИначеЕсли ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) Тогда
		Ошибка = ИИО_МаскированиеКлиент.Демаскировать(ИИО_ОтветКлиентСервер.Аргумент(Ответ, "error", Новый Структура));
		ПоказатьПредупреждение(, ИИО_ОтветКлиентСервер.Аргумент(Ошибка, "message",
			НСтр("ru = 'Не получилось выполнить команду кнопки.'")));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
