// Состояние пакета для формы «Состояние ИИ-оператора» ядра (этап 3д, Р-2). Ядро находит модуль по окончанию
// имени _СостояниеПакета в подсистеме пакета. Проверки собираются без вызовов ядра: пакет работает и с ядром,
// которое этот модуль еще не знает.

#Область ПрограммныйИнтерфейс

// Имя расширения пакета.
//
// Возвращаемое значение:
//  Строка
Функция ИмяРасширения() Экспорт

	Возврат "ИИОператор_Бот";

КонецФункции

// Версия пакета. Совпадает со свойством «Версия» в Configuration.xml (проверяют сборка и выпуск):
// читать версии расширений пользователю не позволяют права.
//
// Возвращаемое значение:
//  Строка
Функция ВерсияПакета() Экспорт

	Возврат "0.1.1.1";

КонецФункции

// С какой версии ядра пакет работает.
//
// Возвращаемое значение:
//  Строка
Функция МинимальнаяВерсияЯдра() Экспорт

	Возврат "0.1.14.0";

КонецФункции

// Уровень API пакетов ядра, для которого написан пакет, см. ИИО_Настройки.ВерсияКонтрактаПакетов.
//
// Возвращаемое значение:
//  Число
Функция ВерсияКонтрактаЯдра() Экспорт

	Возврат 1;

КонецФункции

// Проверки канала «бот в обсуждениях»: подключение базы к Системе взаимодействия, патч конфигурации,
// регламентные задания и личные боты.
//
// Параметры:
//  Проверки - Массив из Структура - см. ИИО_Диагностика.НоваяПроверка.
Процедура ПриСбореПроверок(Проверки) Экспорт

	Если Метаданные.Боты.Найти("ИИОператор") = Неопределено Тогда
		Проверки.Добавить(НоваяПроверка("bot.patch", НСтр("ru = 'Патч конфигурации для бота'"), "error",
			НСтр("ru = 'В конфигурации нет бота «ИИОператор»: канал не работает.'"),
			НСтр("ru = 'Наложите патч скриптом tools/install-bot-cfg.ps1 при закрытой 1С.'")));
		Возврат;
	КонецЕсли;
	Проверки.Добавить(НоваяПроверка("bot.patch", НСтр("ru = 'Патч конфигурации для бота'"), "ok",
		НСтр("ru = 'Бот «ИИОператор» есть в конфигурации.'")));

	Состояние = ИИОБ_Боты.Состояние();
	Если Не Состояние.Зарегистрирована Тогда
		Проверки.Добавить(НоваяПроверка("bot.collaboration", НСтр("ru = 'Система взаимодействия'"), "error",
			НСтр("ru = 'База не подключена к Системе взаимодействия: бот не получает сообщения.'"),
			НСтр("ru = 'Подключите базу: «Администрирование → Обсуждения».'")));
		Возврат;
	КонецЕсли;
	Проверки.Добавить(НоваяПроверка("bot.collaboration", НСтр("ru = 'Система взаимодействия'"), "ok",
		НСтр("ru = 'База подключена.'")));

	Если Состояние.ЗаданиеОбработки Или Состояние.ТиповоеЗаданиеОбработки Тогда
		Проверки.Добавить(НоваяПроверка("bot.jobs", НСтр("ru = 'Задание обработки сообщений'"), "ok",
			НСтр("ru = 'Включено.'")));
	Иначе
		Проверки.Добавить(НоваяПроверка("bot.jobs", НСтр("ru = 'Задание обработки сообщений'"), "error",
			НСтр("ru = 'Регламентное задание обработки сообщений ботов выключено: бот не отвечает.'"),
			НСтр("ru = 'Включите задание «ИИ-оператор: обработка ботов» в «Регламентных и фоновых заданиях».'")));
	КонецЕсли;

	Если Состояние.Ботов > 0 Тогда
		Проверки.Добавить(НоваяПроверка("bot.bots", НСтр("ru = 'Личные боты'"), "ok",
			СтрШаблон(НСтр("ru = 'Ботов: %1.'"), Состояние.Ботов), , "ИИОБ_СостояниеПакета.sync_bots:"
				+ НСтр("ru = 'Синхронизировать'")));
	Иначе
		Проверки.Добавить(НоваяПроверка("bot.bots", НСтр("ru = 'Личные боты'"), "warning",
			НСтр("ru = 'Личных ботов нет: пользователи не видят «ИИ-оператор» в получателях.'"),
			НСтр("ru = 'Нажмите «Синхронизировать»: бот появится у каждого, кому доступен ИИ-оператор.'"),
			"ИИОБ_СостояниеПакета.sync_bots:" + НСтр("ru = 'Синхронизировать'")));
	КонецЕсли;

КонецПроцедуры

// Действие проверки: sync_bots - создать и обновить личных ботов. Только для администратора ИИ-оператора.
//
// Параметры:
//  Действие - Строка
//
// Возвращаемое значение:
//  Строка - Итог для пользователя.
Функция ВыполнитьДействие(Действие) Экспорт

	Если Действие <> "sync_bots" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'У канала бота нет действия %1.'"), Действие);
	КонецЕсли;
	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		Возврат НСтр("ru = 'Синхронизировать ботов может администратор ИИ-оператора.'");
	КонецЕсли;
	Итог = ИИОБ_Боты.Синхронизировать();
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итог.Ошибка;
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Ботов: %1 (создано %2, обновлено %3, удалено %4).'"), Итог.Всего, Итог.Создано,
		Итог.Обновлено, Итог.Удалено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверка в формате ядра, см. ИИО_Диагностика.НоваяПроверка.
//
// Параметры:
//  Код - Строка
//  Заголовок - Строка
//  Статус - Строка - ok, warning, error, skipped.
//  Текст - Строка
//  Подсказка - Строка
//  Действие - Строка
//
// Возвращаемое значение:
//  Структура
Функция НоваяПроверка(Код, Заголовок, Статус, Текст, Подсказка = "", Действие = "")

	Возврат Новый Структура("Код, Группа, Заголовок, Статус, Текст, Подсказка, Действие",
		Код, "Пакеты", Заголовок, Статус, Текст, Подсказка, Действие);

КонецФункции

#КонецОбласти
