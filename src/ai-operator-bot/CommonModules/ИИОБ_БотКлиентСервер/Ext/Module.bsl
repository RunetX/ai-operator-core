// Общие функции канала «бот СВ» для клиента и сервера: данные кнопок ответа, разбор навигационной ссылки
// обсуждения, команды владельца, итог действия для ветки.

#Область СлужебныйПрограммныйИнтерфейс

// Имя действия кнопок ответа бота: по нему ИИОБ_БотКлиент.ПриНажатииКнопки отличает свои кнопки от кнопок
// конфигурации.
//
// Возвращаемое значение:
//  Строка
Функция ИмяДействияКнопки() Экспорт

	Возврат "ИИОБ_Инструмент";

КонецФункции

// Данные кнопки ответа: какой инструмент вызвать в клиенте нажавшего и чья это кнопка.
//
// Возвращаемое значение:
//  Структура:
//   * Инструмент - Строка - open_object, show_in_1c или perform.
//   * Аргументы - Структура - Аргументы инструмента без токенов, см. ИИО_РеестрИнструментов.НоваяКнопка.
//   * ВладелецСВ - Строка - Идентификатор пользователя СВ владельца бота: кнопка работает только у него.
//   * ПользовательБота - Строка - Идентификатор пользователя СВ бота: от его имени пишется итог действия.
//   * Обсуждение - Строка - Идентификатор обсуждения, куда пишется итог действия.
Функция НовыеДанныеКнопки() Экспорт

	Возврат Новый Структура("Инструмент, Аргументы, ВладелецСВ, ПользовательБота, Обсуждение");

КонецФункции

// Проверяет, что данные нажатой кнопки - данные кнопки ответа бота со всеми полями.
//
// Параметры:
//  Данные - Произвольный - Данные кнопки из сообщения.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоДанныеКнопки(Данные) Экспорт

	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КлючИЗначение Из НовыеДанныеКнопки() Цикл
		Если Не Данные.Свойство(КлючИЗначение.Ключ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат ТипЗнч(Данные.Инструмент) = Тип("Строка") И ТипЗнч(Данные.ВладелецСВ) = Тип("Строка");

КонецФункции

// Сколько кнопок ставится в один ряд под ответом.
//
// Возвращаемое значение:
//  Число
Функция КнопокВРяду() Экспорт

	Возврат 3;

КонецФункции

// Команда владельца «начать заново»: забыть разговор в этом обсуждении.
//
// Параметры:
//  Текст - Строка - Текст сообщения.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоКомандаНачатьЗаново(Текст) Экспорт

	Команда = НРег(СокрЛП(Текст));
	Пока СтрЗаканчиваетсяНа(Команда, ".") Или СтрЗаканчиваетсяНа(Команда, "!") Цикл
		Команда = СокрП(Лев(Команда, СтрДлина(Команда) - 1));
	КонецЦикла;
	Возврат Команда = "начать заново" Или Команда = "/new";

КонецФункции

// Разбирает навигационную ссылку на объект вида e1cib/data/Документ.Имя?ref=<32 шестнадцатеричных символа>.
// Группы уникального идентификатора идут в ссылке в порядке хранения: 4-я, 5-я, 3-я, 2-я, 1-я.
//
// Параметры:
//  НавигационнаяСсылка - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если это не ссылка на объект:
//   * ПолноеИмя - Строка - Полное имя объекта метаданных, например Документ.РеализацияТоваровУслуг.
//   * Идентификатор - Строка - Уникальный идентификатор объекта в обычной записи.
Функция РазборНавигационнойСсылки(НавигационнаяСсылка) Экспорт

	Префикс = "e1cib/data/";
	Если ТипЗнч(НавигационнаяСсылка) <> Тип("Строка") Или Не СтрНачинаетсяС(НавигационнаяСсылка, Префикс) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПозицияПараметра = СтрНайти(НавигационнаяСсылка, "?ref=");
	Если ПозицияПараметра = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолноеИмя = Сред(НавигационнаяСсылка, СтрДлина(Префикс) + 1, ПозицияПараметра - СтрДлина(Префикс) - 1);
	Шестнадцатеричный = Сред(НавигационнаяСсылка, ПозицияПараметра + 5);
	Если СтрРазделить(ПолноеИмя, ".").Количество() <> 2 Или Не ЭтоШестнадцатеричнаяСтрока(Шестнадцатеричный, 32) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = СтрШаблон("%1-%2-%3-%4-%5", Сред(Шестнадцатеричный, 25, 8), Сред(Шестнадцатеричный, 21, 4),
		Сред(Шестнадцатеричный, 17, 4), Сред(Шестнадцатеричный, 1, 4), Сред(Шестнадцатеричный, 5, 12));
	Возврат Новый Структура("ПолноеИмя, Идентификатор", ПолноеИмя, Идентификатор);

КонецФункции

// Итог действия для ветки обсуждения по ответу perform после предпросмотра.
//
// Параметры:
//  Ответ - Структура, Соответствие - Ответ perform: cancelled, summary (done, failed, skipped) или error.
//
// Возвращаемое значение:
//  Строка
Функция ТекстИтогаДействия(Ответ) Экспорт

	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) Тогда
		Возврат НСтр("ru = 'Действие не выполнено: произошла ошибка. Подробности - в журнале операций ИИ-оператора.'");
	ИначеЕсли ИИО_ОтветКлиентСервер.Аргумент(Ответ, "cancelled", Ложь) = Истина Тогда
		Возврат НСтр("ru = 'Действие отменено: ничего не изменилось.'");
	КонецЕсли;
	Итог = ИИО_ОтветКлиентСервер.Аргумент(Ответ, "summary", Новый Структура);
	Выполнено = ИИО_ОтветКлиентСервер.Аргумент(Итог, "done", 0);
	Ошибок = ИИО_ОтветКлиентСервер.Аргумент(Итог, "failed", 0);
	Пропущено = ИИО_ОтветКлиентСервер.Аргумент(Итог, "skipped", 0);
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Готово: выполнено %1'"), Выполнено));
	Если Ошибок > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'с ошибкой %1'"), Ошибок));
	КонецЕсли;
	Если Пропущено > 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'пропущено %1'"), Пропущено));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ") + "."
		+ ?(Ошибок > 0, " " + НСтр("ru = 'Причины ошибок - в журнале операций ИИ-оператора.'"), "");

КонецФункции

// Идентификаторы пользователей СВ в элементе подбора: один пользователь или недавнее сочетание получателей.
//
// Параметры:
//  Значение - ИдентификаторПользователяСистемыВзаимодействия, Массив, ФиксированныйМассив, СписокЗначений
//
// Возвращаемое значение:
//  Массив
Функция ИдентификаторыЭлементаПодбора(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) = Тип("ФиксированныйМассив") Тогда
		Возврат Новый Массив(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("СписокЗначений") Тогда
		Возврат Значение.ВыгрузитьЗначения();
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоШестнадцатеричнаяСтрока(Текст, Длина)

	Если СтрДлина(Текст) <> Длина Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По Длина Цикл
		Если СтрНайти("0123456789abcdefABCDEF", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
