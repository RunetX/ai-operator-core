// Личные боты ИИ-оператора: у каждого пользователя, которому доступен ИИ-оператор, свой экземпляр
// бота ИИОператор. Обработчик сообщений выполняется от имени владельца - с его ролями и RLS. Для людей бот один:
// все экземпляры называются «ИИ-оператор», подбор получателей оставляет каждому только его экземпляр.
//
// Создавать пользователей и ботов Система взаимодействия разрешает из клиента и фонового задания,
// но не из внешнего соединения (проверено на платформе 8.3.27).

#Область СлужебныйПрограммныйИнтерфейс

// Приводит личных ботов в соответствие с правами: создает ботов тем, кому доступен ИИ-оператор,
// обновляет параметры и удаляет ботов тех, у кого доступа больше нет или кого нет в базе.
//
// Возвращаемое значение:
//  Структура:
//   * Создано - Число
//   * Обновлено - Число
//   * Удалено - Число
//   * Всего - Число - Сколько ботов после синхронизации.
//   * Ошибка - Строка - Почему синхронизация не выполнена; пустая строка, если выполнена.
Функция Синхронизировать() Экспорт

	Итог = Новый Структура("Создано, Обновлено, Удалено, Всего, Ошибка", 0, 0, 0, 0, "");
	УстановитьПривилегированныйРежим(Истина);
	Если СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		СинхронизироватьБотов(Итог);
	Иначе
		Итог.Ошибка = НСтр("ru = 'База не подключена к Системе взаимодействия.'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Если Итог.Создано + Итог.Обновлено + Итог.Удалено > 0 Тогда
		Сведения = Новый Структура("created, updated, deleted, total", Итог.Создано, Итог.Обновлено, Итог.Удалено,
			Итог.Всего);
		ИИО_Журнал.ЗаписатьСобытие("Бот.Синхронизация", УровеньЖурналаРегистрации.Информация, Сведения);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Состояние канала для формы настроек и диагностики.
//
// Возвращаемое значение:
//  Структура:
//   * Зарегистрирована - Булево - База подключена к Системе взаимодействия.
//   * Ботов - Число - Личных ботов ИИ-оператора.
//   * Владельцы - Массив из Строка - Имена пользователей ИБ, у которых есть бот.
//   * ЗаданиеОбработки - Булево - Регламентное задание обработки сообщений включено.
//   * ТиповоеЗаданиеОбработки - Булево - Включено задание конфигурации ОбработкаБотов, если оно есть.
Функция Состояние() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Состояние = Новый Структура("Зарегистрирована, Ботов, Владельцы, ЗаданиеОбработки, ТиповоеЗаданиеОбработки",
		СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована(), 0, Новый Массив, Ложь, Ложь);
	Если Состояние.Зарегистрирована Тогда
		Для Каждого Бот Из НашиБоты() Цикл
			Состояние.Владельцы.Добавить(ВладелецБота(Бот));
		КонецЦикла;
		Состояние.Ботов = Состояние.Владельцы.Количество();
	КонецЕсли;
	Состояние.ЗаданиеОбработки = ЗаданиеВключено(Метаданные.РегламентныеЗадания.ИИОБ_ОбработкаБотов);
	Типовое = Метаданные.РегламентныеЗадания.Найти("ОбработкаБотов");
	Состояние.ТиповоеЗаданиеОбработки = Типовое <> Неопределено И ЗаданиеВключено(Типовое);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Состояние;

КонецФункции

// Параметры личного бота из его ДополнительныеПараметры.
//
// Параметры:
//  ДополнительныеПараметры - Произвольный - Значение свойства бота.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если параметры не от личного бота ИИ-оператора:
//   * Владелец - Строка - Имя пользователя ИБ.
//   * ВладелецСВ - Строка - Идентификатор пользователя СВ владельца.
//   * ПользовательБота - Строка - Идентификатор пользователя СВ бота.
Функция ПараметрыБота(ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура")
		И ТипЗнч(ДополнительныеПараметры) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Параметры = Новый Структура("Владелец, ВладелецСВ, ПользовательБота");
	ЗаполнитьЗначенияСвойств(Параметры, ДополнительныеПараметры);
	Для Каждого КлючИЗначение Из Параметры Цикл
		Если ТипЗнч(КлючИЗначение.Значение) <> Тип("Строка") Или Не ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Параметры;

КонецФункции

// Что показывать текущему пользователю в подборе получателей: свой бот и чужие, которых надо скрыть.
// Скрываются все пользователи СВ, созданные для личных ботов, кроме своего: и боты других пользователей,
// и пользователи удаленных ботов - сервис взаимодействия оставляет их после удаления бота.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Свой - Строка - Идентификатор пользователя СВ своего бота или пустая строка.
//   * Скрыть - ФиксированныйМассив из Строка - Идентификаторы остальных пользователей СВ личных ботов.
Функция ПравилаПодбора() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Свой = "";
	Скрыть = Новый Массив;
	Если СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		Для Каждого Бот Из НашиБоты() Цикл
			Если ВладелецБота(Бот) = ИмяПользователя() Тогда
				Свой = Строка(Бот.Пользователь);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ПользовательСВ Из ПользователиБотов() Цикл
			Идентификатор = Строка(ПользовательСВ.Идентификатор);
			Если Идентификатор <> Свой Тогда
				Скрыть.Добавить(Идентификатор);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Новый ФиксированнаяСтруктура("Свой, Скрыть", Свой, Новый ФиксированныйМассив(Скрыть));

КонецФункции

// Бот - личный бот ИИ-оператора текущего пользователя.
//
// Параметры:
//  ПользовательБота - ИдентификаторПользователяСистемыВзаимодействия
//
// Возвращаемое значение:
//  Булево
Функция ЭтоЛичныйБотТекущегоПользователя(ПользовательБота) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Бот = СистемаВзаимодействия.ПолучитьБота(ПользовательБота);
	Параметры = ?(Бот = Неопределено Или Бот.Метаданные <> Метаданные.Боты.ИИОператор, Неопределено,
		ПараметрыБота(Бот.ДополнительныеПараметры));
	Текущий = Строка(СистемаВзаимодействия.ИдентификаторТекущегоПользователя());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Параметры <> Неопределено И Параметры.ВладелецСВ = Текущий
		И Параметры.ПользовательБота = Строка(ПользовательБота);

КонецФункции

// Идентификатор пользователя СВ текущего пользователя.
//
// Возвращаемое значение:
//  Строка
Функция ТекущийПользовательСВ() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Текущий = Строка(СистемаВзаимодействия.ИдентификаторТекущегоПользователя());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Текущий;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает, обновляет и удаляет ботов по правам пользователей. Вызывается в привилегированном режиме.
//
// Параметры:
//  Итог - см. Синхронизировать
Процедура СинхронизироватьБотов(Итог)

	Боты = Новый Соответствие;
	Для Каждого Бот Из НашиБоты() Цикл
		Владелец = ВладелецБота(Бот);
		Если Боты.Получить(Владелец) = Неопределено Тогда
			Боты.Вставить(Владелец, Бот);
		Иначе
			// Второй бот того же владельца: в подборе он виден как еще один «ИИ-оператор».
			УдалитьБота(Бот);
			Итог.Удалено = Итог.Удалено + 1;
		КонецЕсли;
	КонецЦикла;

	Владельцы = Новый Соответствие;
	Для Каждого ПользовательИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если Не ИИО_Права.ДоступенИИОператорПользователю(ПользовательИБ) Тогда
			Продолжить;
		КонецЕсли;
		Владельцы.Вставить(ПользовательИБ.Имя, Истина);
		Бот = Боты.Получить(ПользовательИБ.Имя);
		Если Бот = Неопределено Тогда
			СоздатьБота(ПользовательИБ);
			Итог.Создано = Итог.Создано + 1;
		ИначеЕсли ОбновитьБота(Бот, ПользовательИБ) Тогда
			Итог.Обновлено = Итог.Обновлено + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючИЗначение Из Боты Цикл
		Если Владельцы.Получить(КлючИЗначение.Ключ) = Неопределено Тогда
			УдалитьБота(КлючИЗначение.Значение);
			Итог.Удалено = Итог.Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	Итог.Удалено = Итог.Удалено + ЗаблокироватьПользователейУдаленныхБотов();
	Итог.Всего = Владельцы.Количество();

КонецПроцедуры

// Удаляет бота и блокирует его пользователя СВ: сервис взаимодействия оставляет пользователя после удаления
// бота, и без блокировки он виден в подборе получателей как еще один «ИИ-оператор».
//
// Параметры:
//  Бот - БотСистемыВзаимодействия
Процедура УдалитьБота(Бот)

	ПользовательСВ = СистемаВзаимодействия.ПолучитьПользователя(Бот.Пользователь);
	Бот.Удалить();
	Если ПользовательСВ <> Неопределено И Не ПользовательСВ.Заблокирован Тогда
		ПользовательСВ.Заблокирован = Истина;
		ПользовательСВ.Записать();
	КонецЕсли;

КонецПроцедуры

// Блокирует пользователей СВ личных ботов, у которых бота уже нет.
//
// Возвращаемое значение:
//  Число - Сколько пользователей заблокировано.
Функция ЗаблокироватьПользователейУдаленныхБотов()

	ПользователиЖивыхБотов = Новый Соответствие;
	Для Каждого Бот Из НашиБоты() Цикл
		ПользователиЖивыхБотов.Вставить(Строка(Бот.Пользователь), Истина);
	КонецЦикла;
	Заблокировано = 0;
	Для Каждого ПользовательСВ Из ПользователиБотов() Цикл
		Если ПользовательСВ.Заблокирован
			Или ПользователиЖивыхБотов.Получить(Строка(ПользовательСВ.Идентификатор)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПользовательСВ.Заблокирован = Истина;
		ПользовательСВ.Записать();
		Заблокировано = Заблокировано + 1;
	КонецЦикла;
	Возврат Заблокировано;

КонецФункции

// Пользователи СВ, созданные для личных ботов ИИ-оператора, в том числе удаленных. Вызывается
// в привилегированном режиме.
//
// Возвращаемое значение:
//  Массив из ПользовательСистемыВзаимодействия
Функция ПользователиБотов()

	Результат = Новый Массив;
	Префикс = ПрефиксИмениПользователяБота();
	Для Каждого ПользовательСВ Из СистемаВзаимодействия.ПолучитьПользователей() Цикл
		Если СтрНачинаетсяС(ПользовательСВ.Имя, Префикс) Тогда
			Результат.Добавить(ПользовательСВ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Начало имени пользователя СВ личного бота: так его называет СоздатьБота.
//
// Возвращаемое значение:
//  Строка
Функция ПрефиксИмениПользователяБота()

	Возврат "ИИОператор_";

КонецФункции

Функция НашиБоты()

	Боты = Новый Массив;
	Для Каждого Бот Из СистемаВзаимодействия.ПолучитьБотов() Цикл
		Если Бот.Метаданные = Метаданные.Боты.ИИОператор Тогда
			Боты.Добавить(Бот);
		КонецЕсли;
	КонецЦикла;
	Возврат Боты;

КонецФункции

Функция ВладелецБота(Бот)

	Параметры = ПараметрыБота(Бот.ДополнительныеПараметры);
	Возврат ?(Параметры = Неопределено, "", Параметры.Владелец);

КонецФункции

// Создает пользователя СВ бота и бота. Если владелец ни разу не входил в базу с подключенной Системой
// взаимодействия, у него еще нет пользователя СВ - он создается.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы
Процедура СоздатьБота(ПользовательИБ)

	ПользовательБота = СистемаВзаимодействия.СоздатьПользователя();
	ПользовательБота.Имя = "ИИОператор_" + Строка(Новый УникальныйИдентификатор);
	// Видимое имя у всех личных ботов одно: для людей бот один, экземпляр у каждого свой.
	ПользовательБота.ПолноеИмя = НСтр("ru = 'ИИ-оператор'");
	ПользовательБота.Записать();

	Бот = СистемаВзаимодействия.СоздатьБота();
	Бот.Пользователь = ПользовательБота.Идентификатор;
	Бот.Метаданные = Метаданные.Боты.ИИОператор;
	ОбновитьБота(Бот, ПользовательИБ);

КонецПроцедуры

// Записывает исполнителя и параметры бота, если они изменились.
//
// Параметры:
//  Бот - БотСистемыВзаимодействия
//  ПользовательИБ - ПользовательИнформационнойБазы - Владелец бота.
//
// Возвращаемое значение:
//  Булево - Истина, если бот записан.
Функция ОбновитьБота(Бот, ПользовательИБ)

	ВладелецСВ = Строка(ИдентификаторПользователяСВ(ПользовательИБ));
	Параметры = ПараметрыБота(Бот.ДополнительныеПараметры);
	Если Параметры <> Неопределено
		И Параметры.Владелец = ПользовательИБ.Имя
		И Параметры.ВладелецСВ = ВладелецСВ
		И Параметры.ПользовательБота = Строка(Бот.Пользователь)
		И Бот.ИмяПользователяИнформационнойБазыВыполненияОбработки = ПользовательИБ.Имя Тогда
		Возврат Ложь;
	КонецЕсли;
	Бот.ИмяПользователяИнформационнойБазыВыполненияОбработки = ПользовательИБ.Имя;
	Бот.ДополнительныеПараметры = Новый Структура("Владелец, ВладелецСВ, ПользовательБота",
		ПользовательИБ.Имя, ВладелецСВ, Строка(Бот.Пользователь));
	Бот.Записать();
	Возврат Истина;

КонецФункции

Функция ИдентификаторПользователяСВ(ПользовательИБ)

	Попытка
		Возврат СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);
	Исключение
		// Обычная причина - пользователь ни разу не входил в базу с подключенной Системой взаимодействия, и у него
		// нет пользователя СВ. Исходная ошибка пишется в журнал: если причина другая, создание пользователя ниже
		// упадет само, а администратор увидит обе ошибки.
		ИИО_Журнал.ЗаписатьСобытие("Бот.Синхронизация", УровеньЖурналаРегистрации.Примечание,
			Новый Структура("user, error", ПользовательИБ.Имя,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		ПользовательСВ = СистемаВзаимодействия.СоздатьПользователя(ПользовательИБ);
		ПользовательСВ.Записать();
		Возврат ПользовательСВ.Идентификатор;
	КонецПопытки;

КонецФункции

Функция ЗаданиеВключено(МетаданныеЗадания)

	Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Новый Структура("Метаданные", МетаданныеЗадания));
	Возврат Задания.Количество() > 0 И Задания[0].Использование;

КонецФункции

#КонецОбласти
