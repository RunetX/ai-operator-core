// Канал «бот Системы взаимодействия». Модуль бота ИИОператор в конфигурации вызывает
// ОбработатьСообщение; обработчик короткий и запускает ход агента фоновым заданием, чтобы долгий ход
// не держал обработку сообщений остальных ботов. Обработчик и фоновое задание работают в сеансе владельца бота -
// с его ролями и RLS. Ответ в ветку пишется от имени бота; модель видит только маскированный текст.
//
// Обращение к Системе взаимодействия идет в сервис (1С:Диалог), поэтому за ход их не больше трех:
// получить обсуждение, написать «Думаю…», заменить его ответом.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик сообщения личному боту ИИ-оператора.
//
// Параметры:
//  Сообщение - СообщениеСистемыВзаимодействия
//  ДополнительныеПараметры - Структура - Параметры бота, см. ИИОБ_Боты.ПараметрыБота.
Процедура ОбработатьСообщение(Сообщение, ДополнительныеПараметры) Экспорт

	Параметры = ИИОБ_Боты.ПараметрыБота(ДополнительныеПараметры);
	Если Параметры = Неопределено Тогда
		ЗаписатьОшибку("Бот.Сообщение", НСтр("ru = 'У бота нет параметров владельца.'"));
		Возврат;
	КонецЕсли;
	Автор = Строка(Сообщение.Автор);
	Если Автор = Параметры.ПользовательБота Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Автор = Параметры.ВладелецСВ Тогда
			ОбработатьСообщениеВладельца(Сообщение, Параметры);
		Иначе
			ОтказатьЧужому(Сообщение, Параметры);
		КонецЕсли;
	Исключение
		ЗаписатьОшибку("Бот.Сообщение", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Ход агента в фоновом задании: «Думаю…» в ветку, ход агента, замена «Думаю…» ответом с кнопками.
//
// Параметры:
//  Параметры - см. НовыеПараметрыХода
Процедура ВыполнитьХод(Параметры) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Обсуждение = Новый ИдентификаторОбсужденияСистемыВзаимодействия(Параметры.Обсуждение);
	ПользовательБота = Новый ИдентификаторПользователяСистемыВзаимодействия(Параметры.ПользовательБота);
	Сведения = Новый Структура("status, steps, buttons, duration_ms, wait_ms", "", 0, 0, 0,
		Начало - Параметры.ПолученоМс);
	Ответ = Неопределено;
	Попытка
		Ответ = НовыйОтвет(Обсуждение, ПользовательБота, НСтр("ru = 'Думаю…'"));
		ЗаписатьОтвет(Ответ);

		Диалог = ИИО_Диалоги.Диалог(Параметры.Обсуждение);
		Результат = ИИО_Агент.ВыполнитьХод(Диалог, Параметры.Вопрос, Параметры.Документ,
			Начало + МаксимумХодаСек() * 1000);
		Сведения.status = Результат.Статус;
		Сведения.steps = Результат.Шаги;
		Сведения.buttons = Результат.Кнопки.Количество();

		Ответ.Текст = Новый ФорматированнаяСтрока(Результат.Ответ);
		ДобавитьКнопки(Ответ, Результат.Кнопки, Параметры);
		ЗаписатьОтвет(Ответ);
	Исключение
		Сведения.status = "error";
		Сведения.Вставить("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СообщитьОСбое(Обсуждение, ПользовательБота, Ответ);
	КонецПопытки;
	Сведения.duration_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	ИИО_Журнал.ЗаписатьСобытие("Бот.Ход", ?(Сведения.status = "ok", УровеньЖурналаРегистрации.Информация,
		УровеньЖурналаРегистрации.Ошибка), Сведения);

КонецПроцедуры

// Итог действия после «Выполнить» в предпросмотре: пишет в ветку от имени бота. Вызывается из клиента
// нажавшего кнопку. Данным кнопки от клиента сервер не доверяет: бот должен быть личным ботом текущего
// пользователя, обсуждение - доступным ему без привилегированного режима, а текст итога сервер собирает сам
// из чисел ответа, чтобы от имени бота нельзя было написать произвольный текст.
//
// Параметры:
//  ДанныеКнопки - см. ИИОБ_БотКлиентСервер.НовыеДанныеКнопки
//  Ответ - Структура, Соответствие - Ответ perform после предпросмотра.
Процедура НаписатьИтог(ДанныеКнопки, Ответ) Экспорт

	ПользовательБота = Новый ИдентификаторПользователяСистемыВзаимодействия(ДанныеКнопки.ПользовательБота);
	Обсуждение = Новый ИдентификаторОбсужденияСистемыВзаимодействия(ДанныеКнопки.Обсуждение);
	Если Не ИИОБ_Боты.ЭтоЛичныйБотТекущегоПользователя(ПользовательБота)
		Или СистемаВзаимодействия.ПолучитьОбсуждение(Обсуждение) = Неопределено Тогда
		ВызватьИсключение(НСтр("ru = 'Итог действия пишет только владелец бота в своем обсуждении.'"),
			КатегорияОшибки.НарушениеПравДоступа);
	КонецЕсли;
	ЗаписатьОтвет(НовыйОтвет(Обсуждение, ПользовательБота, ИИОБ_БотКлиентСервер.ТекстИтогаДействия(Ответ)));

КонецПроцедуры

// Метод регламентного задания ИИОБ_ОбработкаБотов: сообщения ботам базы обрабатываются здесь.
Процедура ОбработатьБотов() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ИИОБ_ОбработкаБотов);
	// Проверка регистрации не обращается к сервису взаимодействия, а задание запускается каждые несколько секунд.
	Если СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		СистемаВзаимодействия.ВыполнитьОбработкуБотов();
	КонецЕсли;

КонецПроцедуры

// Метод регламентного задания ИИОБ_Обслуживание: личные боты по правам пользователей, очистка старых диалогов
// и журнала обмена с моделью.
Процедура Обслужить() Экспорт

	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ИИОБ_Обслуживание);
	Итог = ИИОБ_Боты.Синхронизировать();
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ИИО_Журнал.ЗаписатьСобытие("Бот.Синхронизация", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", Итог.Ошибка));
	КонецЕсли;
	ИИО_Диалоги.УдалитьУстаревшие();
	ИИО_Журнал.УдалитьУстаревшийОбмен();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сообщение владельца: команда «начать заново» или ход агента в фоновом задании.
//
// Параметры:
//  Сообщение - СообщениеСистемыВзаимодействия
//  Параметры - см. ИИОБ_Боты.ПараметрыБота
Процедура ОбработатьСообщениеВладельца(Сообщение, Параметры)

	ПолученоМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПользовательБота = Новый ИдентификаторПользователяСистемыВзаимодействия(Параметры.ПользовательБота);
	Ключ = Строка(Сообщение.Обсуждение);
	Вопрос = СокрЛП(Строка(Сообщение.Текст));
	Если Не ЗначениеЗаполнено(Вопрос) Тогда
		ОтветитьТекстом(Сообщение.Обсуждение, ПользовательБота,
			НСтр("ru = 'Пока я понимаю только текст: напишите вопрос словами.'"));
		Возврат;
	ИначеЕсли ИИОБ_БотКлиентСервер.ЭтоКомандаНачатьЗаново(Вопрос) Тогда
		ИИО_Диалоги.Удалить(Ключ);
		ОтветитьТекстом(Сообщение.Обсуждение, ПользовательБота,
			НСтр("ru = 'Начинаем заново: прошлый разговор в этом обсуждении я забыл.'"));
		Возврат;
	КонецЕсли;

	КлючЗадания = "ИИОБ_Ход_" + Параметры.ВладелецСВ + "_" + Ключ;
	Активные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ, Состояние", КлючЗадания,
		СостояниеФоновогоЗадания.Активно));
	Если Активные.Количество() > 0 Тогда
		ОтветитьТекстом(Сообщение.Обсуждение, ПользовательБота,
			НСтр("ru = 'Еще отвечаю на прошлый вопрос в этом обсуждении. Напишите, когда я отвечу.'"));
		Возврат;
	КонецЕсли;

	ПараметрыХода = НовыеПараметрыХода();
	ПараметрыХода.Обсуждение = Ключ;
	ПараметрыХода.ПользовательБота = Параметры.ПользовательБота;
	ПараметрыХода.ВладелецСВ = Параметры.ВладелецСВ;
	ПараметрыХода.Вопрос = Вопрос;
	ПараметрыХода.Документ = ОбъектОбсуждения(Сообщение.Обсуждение);
	ПараметрыХода.ПолученоМс = ПолученоМс;
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПараметрыХода);
	ФоновыеЗадания.Выполнить("ИИОБ_Бот.ВыполнитьХод", ПараметрыЗадания, КлючЗадания,
		НСтр("ru = 'ИИ-оператор: ответ в обсуждении'"));

КонецПроцедуры

// Личный бот работает с правами владельца: ответ другому человеку был бы утечкой данных владельца.
// Сообщения других ботов пропускаются, чтобы два бота в обсуждении не отвечали друг другу.
//
// Параметры:
//  Сообщение - СообщениеСистемыВзаимодействия
//  Параметры - см. ИИОБ_Боты.ПараметрыБота
Процедура ОтказатьЧужому(Сообщение, Параметры)

	УстановитьПривилегированныйРежим(Истина);
	ОтБота = СистемаВзаимодействия.ПолучитьБота(Сообщение.Автор) <> Неопределено;
	УстановитьПривилегированныйРежим(Ложь);
	Если ОтБота Тогда
		Возврат;
	КонецЕсли;
	Текст = СтрШаблон(НСтр("ru = 'Я помощник пользователя %1 и отвечаю только ему.
		|Ваш ИИ-оператор - в списке получателей под тем же именем.'"), Параметры.Владелец);
	ОтветитьТекстом(Сообщение.Обсуждение,
		Новый ИдентификаторПользователяСистемыВзаимодействия(Параметры.ПользовательБота), Текст);
	ИИО_Журнал.ЗаписатьСобытие("Бот.Сообщение", УровеньЖурналаРегистрации.Предупреждение,
		Новый Структура("status", "not_owner"));

КонецПроцедуры

// Параметры фонового задания хода.
//
// Возвращаемое значение:
//  Структура:
//   * Обсуждение - Строка - Идентификатор обсуждения; он же ключ диалога, см. ИИО_Диалоги.Диалог.
//   * ПользовательБота - Строка - Идентификатор пользователя СВ бота.
//   * ВладелецСВ - Строка - Идентификатор пользователя СВ владельца.
//   * Вопрос - Строка - Текст пользователя как есть.
//   * Документ - ЛюбаяСсылка, Неопределено - Объект контекстного обсуждения.
//   * ПолученоМс - Число - Когда обработчик получил сообщение (ТекущаяУниверсальнаяДатаВМиллисекундах).
Функция НовыеПараметрыХода()

	Возврат Новый Структура("Обсуждение, ПользовательБота, ВладелецСВ, Вопрос, Документ, ПолученоМс");

КонецФункции

// Объект 1С, у которого идет обсуждение. Обычное обсуждение или ссылка не на объект - Неопределено.
//
// Параметры:
//  ИдентификаторОбсуждения - ИдентификаторОбсужденияСистемыВзаимодействия
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено
Функция ОбъектОбсуждения(ИдентификаторОбсуждения)

	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(ИдентификаторОбсуждения);
	Если Обсуждение = Неопределено Или Обсуждение.КонтекстОбсуждения = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СсылкаИзНавигационнойСсылки(Обсуждение.КонтекстОбсуждения.НавигационнаяСсылка);

КонецФункции

// Ссылка на объект по навигационной ссылке вида e1cib/data/Документ.<Имя>?ref=<32 hex>.
//
// Параметры:
//  НавигационнаяСсылка - Строка
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - Неопределено, если ссылка не на объект ссылочного типа.
Функция СсылкаИзНавигационнойСсылки(НавигационнаяСсылка)

	Разбор = ИИОБ_БотКлиентСервер.РазборНавигационнойСсылки(НавигационнаяСсылка);
	Если Разбор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Разбор.ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Или Не ОбщегоНазначения.ЭтоОбъектСсылочногоТипа(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Разбор.ПолноеИмя);
	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Разбор.Идентификатор));

КонецФункции

// Кнопки ответа: нажатие обрабатывает клиент нажавшего (ИИОБ_БотКлиент.ПриНажатииКнопки).
//
// Параметры:
//  Ответ - СообщениеСистемыВзаимодействия
//  Кнопки - Массив из см. ИИО_РеестрИнструментов.НоваяКнопка
//  Параметры - см. НовыеПараметрыХода
Процедура ДобавитьКнопки(Ответ, Кнопки, Параметры)

	Ряд = Неопределено;
	Для Каждого Кнопка Из Кнопки Цикл
		Если Ряд = Неопределено Или Ряд.Количество() = ИИОБ_БотКлиентСервер.КнопокВРяду() Тогда
			Ряд = Ответ.ПанельКнопок.РядыКнопок.Добавить();
		КонецЕсли;
		Элемент = Ряд.Добавить(ДействиеКнопкиПанелиКнопокСообщенияСистемыВзаимодействия.ОбработатьНаКлиенте,
			Кнопка.Заголовок);
		Элемент.ИмяДействия = ИИОБ_БотКлиентСервер.ИмяДействияКнопки();
		Данные = ИИОБ_БотКлиентСервер.НовыеДанныеКнопки();
		Данные.Инструмент = Кнопка.Инструмент;
		Данные.Аргументы = Кнопка.Аргументы;
		Данные.ВладелецСВ = Параметры.ВладелецСВ;
		Данные.ПользовательБота = Параметры.ПользовательБота;
		Данные.Обсуждение = Параметры.Обсуждение;
		Элемент.Данные = Данные;
	КонецЦикла;

КонецПроцедуры

// Сообщение от имени бота. Записывается процедурой ЗаписатьОтвет: автор - другой пользователь СВ.
//
// Параметры:
//  Обсуждение - ИдентификаторОбсужденияСистемыВзаимодействия
//  ПользовательБота - ИдентификаторПользователяСистемыВзаимодействия
//  Текст - Строка
//
// Возвращаемое значение:
//  СообщениеСистемыВзаимодействия
Функция НовыйОтвет(Обсуждение, ПользовательБота, Текст)

	Ответ = СистемаВзаимодействия.СоздатьСообщение(Обсуждение);
	Ответ.Автор = ПользовательБота;
	Ответ.Текст = Новый ФорматированнаяСтрока(Текст);
	Возврат Ответ;

КонецФункции

// Записывает сообщение от имени бота: писать за другого пользователя СВ можно только в привилегированном режиме.
//
// Параметры:
//  Ответ - СообщениеСистемыВзаимодействия
Процедура ЗаписатьОтвет(Ответ)

	УстановитьПривилегированныйРежим(Истина);
	Ответ.Записать();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура ОтветитьТекстом(Обсуждение, ПользовательБота, Текст)

	ЗаписатьОтвет(НовыйОтвет(Обсуждение, ПользовательБота, Текст));

КонецПроцедуры

// Ход упал до ответа: пользователь не должен ждать «Думаю…» вечно.
//
// Параметры:
//  Обсуждение - ИдентификаторОбсужденияСистемыВзаимодействия
//  ПользовательБота - ИдентификаторПользователяСистемыВзаимодействия
//  Ответ - СообщениеСистемыВзаимодействия, Неопределено - Записанное «Думаю…», если успели.
Процедура СообщитьОСбое(Обсуждение, ПользовательБота, Ответ)

	Текст = НСтр("ru = 'Не получилось ответить из-за ошибки. Подробности - в журнале регистрации, событие ИИОператор.Бот.Ход.'");
	Попытка
		Если Ответ = Неопределено Тогда
			ОтветитьТекстом(Обсуждение, ПользовательБота, Текст);
		Иначе
			Ответ.Текст = Новый ФорматированнаяСтрока(Текст);
			ЗаписатьОтвет(Ответ);
		КонецЕсли;
	Исключение
		ЗаписатьОшибку("Бот.Ход", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

