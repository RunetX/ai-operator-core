// Сценарии e2e канала «бот СВ» (tests/e2e/test_bot.py): сообщение личному боту от имени пользователя
// и ожидание ответа в ветке. Писать в Систему взаимодействия из внешнего соединения нельзя, поэтому
// test_bot.py запускает РазговорСБотом фоновым заданием и читает итог из временного хранилища.

#Область СлужебныйПрограммныйИнтерфейс

// Пишет боту и ждет ответ. Автор сообщения подменяется в привилегированном режиме: так тест пишет от имени
// пользователя без права на внешнее соединение, а бот работает в сеансе своего владельца.
//
// Параметры:
//  Параметры - Структура:
//   * Автор - Строка - Имя пользователя ИБ, от чьего имени сообщение.
//   * ВладелецБота - Строка - Имя пользователя ИБ, чьему личному боту сообщение.
//   * Текст - Строка
//   * Документ - Строка - Ссылка для контекстного обсуждения (ИИО_Ответ.СсылкаВСтроку) или пустая строка.
//   * ОжиданиеСек - Число - Сколько ждать ответ без «Думаю…».
//   * АдресРезультата - Строка - Временное хранилище для JSON итога: ответы бота (text, buttons) и секунды.
//     У кнопки - title, tool, action и args (аргументы инструмента строкой JSON).
Процедура РазговорСБотом(Параметры) Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	УстановитьПривилегированныйРежим(Истина);
	ПользовательБота = ПользовательБота(Параметры.ВладелецБота);
	Автор = ИдентификаторПользователяСВ(Параметры.Автор);
	Обсуждение = ОбсуждениеДляТеста(Параметры, Автор, ПользовательБота);
	Если Параметры.Автор = Параметры.ВладелецБота Тогда
		// Диалог владельца: тест начинается без истории прошлых прогонов.
		ИИО_Диалоги.Удалить(Строка(Обсуждение));
	КонецЕсли;

	Сообщение = СистемаВзаимодействия.СоздатьСообщение(Обсуждение);
	Сообщение.Автор = Автор;
	Сообщение.Текст = Новый ФорматированнаяСтрока(Параметры.Текст);
	Сообщение.Получатели.Добавить(ПользовательБота);
	Сообщение.Записать();

	Ответы = Новый Массив;
	Срок = Начало + Параметры.ОжиданиеСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Пауза(2);
		Ответы = ОтветыБота(Обсуждение, Сообщение.Идентификатор, ПользовательБота);
		Если ОтветГотов(Ответы) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);

	Итог = Новый Структура("answers, seconds", Ответы, (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
	ПоместитьВоВременноеХранилище(ИИО_ОтветКлиентСервер.ВJSON(Итог), Параметры.АдресРезультата);

КонецПроцедуры

// Проверка вложений от бота (план 3а.4, для К-3): бот пишет в обсуждение теста сообщения с текстовыми файлами
// заданных размеров. Итог по каждому размеру - записано ли сообщение и текст ошибки сервиса.
//
// Параметры:
//  Параметры - Структура:
//   * ВладелецБота - Строка - Имя пользователя ИБ, чей бот пишет.
//   * РазмерыКБ - Массив из Число - Размеры файлов в килобайтах.
//   * АдресРезультата - Строка - Временное хранилище для JSON итога.
Процедура ПроверитьВложения(Параметры) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ПользовательБота = ПользовательБота(Параметры.ВладелецБота);
	Автор = ИдентификаторПользователяСВ(Параметры.ВладелецБота);
	Обсуждение = ОбсуждениеДляТеста(Новый Структура("Автор, ВладелецБота, Документ", Параметры.ВладелецБота,
		Параметры.ВладелецБота, ""), Автор, ПользовательБота);
	Итог = Новый Массив;
	Для Каждого РазмерКБ Из Параметры.РазмерыКБ Цикл
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Проба = Новый Структура("size_kb, ok, ms, error", РазмерКБ, Истина, 0, "");
		Попытка
			Поток = Новый ПотокВПамяти;
			Запись = Новый ЗаписьДанных(Поток);
			Блок = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("x", 1022) + Символы.ПС;
			Для Номер = 1 По РазмерКБ Цикл
				Запись.ЗаписатьСтроку(Формат(Номер % 10, "ЧН=0") + Блок);
			КонецЦикла;
			Запись.Закрыть();
			Поток.Перейти(0, ПозицияВПотоке.Начало);
			Сообщение = СистемаВзаимодействия.СоздатьСообщение(Обсуждение);
			Сообщение.Автор = ПользовательБота;
			Сообщение.Текст = Новый ФорматированнаяСтрока(СтрШаблон("Вложение %1 КБ", РазмерКБ));
			Сообщение.Вложения.Добавить(Поток, СтрШаблон("проверка-%1кб.txt", РазмерКБ));
			Сообщение.Записать();
		Исключение
			Проба.ok = Ложь;
			Проба.error = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Проба.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Итог.Добавить(Проба);
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	ПоместитьВоВременноеХранилище(ИИО_ОтветКлиентСервер.ВJSON(Итог), Параметры.АдресРезультата);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПользовательБота(Владелец)

	Для Каждого Бот Из СистемаВзаимодействия.ПолучитьБотов() Цикл
		Параметры = ИИОБ_Боты.ПараметрыБота(Бот.ДополнительныеПараметры);
		Если Бот.Метаданные = Метаданные.Боты.ИИОператор И Параметры <> Неопределено
			И Параметры.Владелец = Владелец Тогда
			Возврат Бот.Пользователь;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("У пользователя %1 нет личного бота", Владелец);

КонецФункции

Функция ИдентификаторПользователяСВ(ИмяПользователя)

	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(ИмяПользователя);
	Если ПользовательИБ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Нет пользователя ИБ %1", ИмяПользователя);
	КонецЕсли;
	Возврат СистемаВзаимодействия.ПолучитьИдентификаторПользователя(ПользовательИБ.УникальныйИдентификатор);

КонецФункции

// Контекстное обсуждение документа или групповое обсуждение теста с автором и ботом.
//
// Параметры:
//  Параметры - см. РазговорСБотом
//  Автор - ИдентификаторПользователяСистемыВзаимодействия
//  ПользовательБота - ИдентификаторПользователяСистемыВзаимодействия
//
// Возвращаемое значение:
//  ИдентификаторОбсужденияСистемыВзаимодействия
Функция ОбсуждениеДляТеста(Параметры, Автор, ПользовательБота)

	Если ЗначениеЗаполнено(Параметры.Документ) Тогда
		Контекст = Новый КонтекстОбсужденияСистемыВзаимодействия(
			ПолучитьНавигационнуюСсылку(ИИО_Ответ.СсылкаИзСтроки(Параметры.Документ)));
		Отбор = Новый ОтборОбсужденийСистемыВзаимодействия;
		Отбор.КонтекстноеОбсуждение = Истина;
		Отбор.КонтекстОбсуждения = Контекст;
		Найденные = СистемаВзаимодействия.ПолучитьОбсуждения(Отбор);
		Если Найденные.Количество() > 0 Тогда
			Возврат Найденные[0].Идентификатор;
		КонецЕсли;
		Обсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
		Обсуждение.КонтекстОбсуждения = Контекст;
		Обсуждение.Заголовок = "Тест канала ИИ-оператора";
		Обсуждение.Записать();
		Возврат Обсуждение.Идентификатор;
	КонецЕсли;

	Ключ = "ИИОБ-тест-" + Параметры.Автор + "-" + Параметры.ВладелецБота;
	Обсуждение = СистемаВзаимодействия.ПолучитьОбсуждение(Ключ);
	Если Обсуждение = Неопределено Тогда
		Обсуждение = СистемаВзаимодействия.СоздатьОбсуждение();
		Обсуждение.Ключ = Ключ;
		Обсуждение.Заголовок = "Тест канала ИИ-оператора: " + Параметры.Автор;
		Обсуждение.Групповое = Истина;
		Обсуждение.Участники.Добавить(Автор);
		Обсуждение.Участники.Добавить(ПользовательБота);
		Обсуждение.Записать();
	КонецЕсли;
	Возврат Обсуждение.Идентификатор;

КонецФункции

Функция ОтветыБота(Обсуждение, ПослеСообщения, ПользовательБота)

	Отбор = Новый ОтборСообщенийСистемыВзаимодействия;
	Отбор.Обсуждение = Обсуждение;
	Отбор.После = ПослеСообщения;
	Отбор.Количество = 20;
	Ответы = Новый Массив;
	Для Каждого Сообщение Из СистемаВзаимодействия.ПолучитьСообщения(Отбор) Цикл
		Если Сообщение.Автор <> ПользовательБота Тогда
			Продолжить;
		КонецЕсли;
		Кнопки = Новый Массив;
		Для Каждого Ряд Из Сообщение.ПанельКнопок.РядыКнопок Цикл
			Для Каждого Кнопка Из Ряд Цикл
				Данные = Кнопка.Данные;
				ЕстьДанные = ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Инструмент");
				Кнопки.Добавить(Новый Структура("title, tool, action, args", Кнопка.Текст,
					?(ЕстьДанные, Данные.Инструмент, ""), Кнопка.ИмяДействия,
					?(ЕстьДанные, ИИО_ОтветКлиентСервер.ВJSON(Данные.Аргументы), "")));
			КонецЦикла;
		КонецЦикла;
		Ответы.Добавить(Новый Структура("text, buttons", Строка(Сообщение.Текст), Кнопки));
	КонецЦикла;
	Возврат Ответы;

КонецФункции

Функция ОтветГотов(Ответы)

	Если Ответы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ответ Из Ответы Цикл
		Если СтрНачинаетсяС(Ответ.text, "Думаю") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Процедура Пауза(Секунд)

	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Попытка
		Задание.ОжидатьЗавершенияВыполнения(Секунд);
	Исключение
		// Таймаут ожидания самого себя и есть пауза.
		Возврат;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
