КонецПроцедуры

Процедура ЛичныйБотТолькоСДоступомКИИОператору() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Администратор = ПользователиИнформационнойБазы.НайтиПоИмени("Администратор (ФедоровБМ)");
	Логист = ПользователиИнформационнойБазы.НайтиПоИмени("Логист (ВолковАИ)");
	УстановитьПривилегированныйРежим(Ложь);
	ЮТест.ОжидаетЧто(Администратор).ИмеетТип("ПользовательИнформационнойБазы");
	ЮТест.ОжидаетЧто(Логист).ИмеетТип("ПользовательИнформационнойБазы");

	УстановитьПривилегированныйРежим(Истина);
	ДоступАдминистратора = ИИО_Права.ДоступенИИОператорПользователю(Администратор);
	ДоступЛогиста = ИИО_Права.ДоступенИИОператорПользователю(Логист);
	УстановитьПривилегированныйРежим(Ложь);
	ЮТест.ОжидаетЧто(ДоступАдминистратора).ЭтоИстина();
	ЮТест.ОжидаетЧто(ДоступЛогиста).ЭтоЛожь();

КонецПроцедуры

Процедура ИтогДействияПишетТолькоСвойБот() Экспорт

	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		ЮТест.Пропустить("База не зарегистрирована в Системе взаимодействия: личных ботов нет");
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	СвойБот = Неопределено;
	ЧужойБот = Неопределено;
	Для Каждого Бот Из СистемаВзаимодействия.ПолучитьБотов() Цикл
		Параметры = ИИОБ_Боты.ПараметрыБота(Бот.ДополнительныеПараметры);
		Если Бот.Метаданные <> Метаданные.Боты.ИИОператор Или Параметры = Неопределено Тогда
			Продолжить;
		ИначеЕсли Параметры.Владелец = ИмяПользователя() Тогда
			СвойБот = Бот.Пользователь;
		Иначе
			ЧужойБот = Бот.Пользователь;
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Если СвойБот = Неопределено Или ЧужойБот = Неопределено Тогда
		ЮТест.Пропустить("В базе нет личного бота текущего пользователя и бота другого пользователя");
		Возврат;
	КонецЕсли;

	ЮТест.ОжидаетЧто(ИИОБ_Боты.ЭтоЛичныйБотТекущегоПользователя(СвойБот)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ЭтоЛичныйБотТекущегоПользователя(ЧужойБот)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ЭтоЛичныйБотТекущегоПользователя(
		Новый ИдентификаторПользователяСистемыВзаимодействия(ИИОБ_Боты.ТекущийПользовательСВ()))).ЭтоЛожь();

КонецПроцедуры

Процедура ПодборСкрываетВсехЧужихИИОператоров() Экспорт

	// Пользователь СВ остается и после удаления бота: подбор должен скрывать и таких, а не только чужих ботов.
	Если Не СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована() Тогда
		ЮТест.Пропустить("База не зарегистрирована в Системе взаимодействия: личных ботов нет");
		Возврат;
	КонецЕсли;
	Правила = ИИОБ_Боты.ПравилаПодбора();
	Для Каждого Пользователь Из СистемаВзаимодействия.ПолучитьПользователей() Цикл
		Идентификатор = Строка(Пользователь.Идентификатор);
		Если СтрНачинаетсяС(Пользователь.Имя, "ИИОператор_") И Идентификатор <> Правила.Свой Тогда
			ЮТест.ОжидаетЧто(Правила.Скрыть.Найти(Идентификатор), "в подборе остался " + Пользователь.Имя)
				.НеРавно(Неопределено);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПерваяРеализация()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реализация.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализация.Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий()).ЭтоИстина();
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
