Процедура ДанныеКнопкиПроверяютсяПоПолям() Экспорт

	Данные = ИИОБ_БотКлиентСервер.НовыеДанныеКнопки();
	Данные.Инструмент = "open_object";
	Данные.Аргументы = Новый Структура("ref", "Документ.РеализацияТоваровУслуг:1");
	Данные.ВладелецСВ = "владелец";
	Данные.ПользовательБота = "бот";
	Данные.Обсуждение = "обсуждение";
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки(Данные)).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки(Новый ФиксированнаяСтруктура(Данные))).ЭтоИстина();

	Данные.Удалить("ВладелецСВ");
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки(Данные)).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки("open_object")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ЭтоДанныеКнопки(Неопределено)).ЭтоЛожь();

КонецПроцедуры

Процедура НавигационнаяСсылкаДаетТуЖеСсылку() Экспорт

	Ссылка = ПерваяРеализация();
	Разбор = ИИОБ_БотКлиентСервер.РазборНавигационнойСсылки(ПолучитьНавигационнуюСсылку(Ссылка));

	ЮТест.ОжидаетЧто(Разбор).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Разбор.ПолноеИмя).Равно("Документ.РеализацияТоваровУслуг");
	ЮТест.ОжидаетЧто(Разбор.Идентификатор).Равно(Строка(Ссылка.УникальныйИдентификатор()));

КонецПроцедуры

