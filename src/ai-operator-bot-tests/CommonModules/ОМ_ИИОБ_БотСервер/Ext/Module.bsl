Процедура ПараметрыБотаПроверяются() Экспорт

	Параметры = Новый Структура("Владелец, ВладелецСВ, ПользовательБота", "Логист", "в1", "б1");
	Результат = ИИОБ_Боты.ПараметрыБота(Параметры);
	ЮТест.ОжидаетЧто(Результат).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Результат.ВладелецСВ).Равно("в1");
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ПараметрыБота(Новый ФиксированнаяСтруктура(Параметры))).ИмеетТип("Структура");

	Параметры.ВладелецСВ = "";
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ПараметрыБота(Параметры)).НеЗаполнено();
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ПараметрыБота(Новый Структура("Владелец", "Логист"))).НеЗаполнено();
	ЮТест.ОжидаетЧто(ИИОБ_Боты.ПараметрыБота("Логист")).НеЗаполнено();

КонецПроцедуры

Процедура ИтогДействияДляВетки() Экспорт

	Отмена = Новый Структура("batch_id, cancelled, reason", "п1", Истина, "user");
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ТекстИтогаДействия(Отмена)).Содержит("отменено");

	Выполнено = Новый Структура("batch_id, cancelled, summary", "п1", Ложь,
		Новый Структура("done, failed, skipped", 3, 0, 0));
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ТекстИтогаДействия(Выполнено)).Равно("Готово: выполнено 3.");

	СОшибками = Новый Структура("batch_id, cancelled, summary", "п1", Ложь,
		Новый Структура("done, failed, skipped", 2, 1, 1));
	Текст = ИИОБ_БотКлиентСервер.ТекстИтогаДействия(СОшибками);
	ЮТест.ОжидаетЧто(Текст).Содержит("выполнено 2").Содержит("с ошибкой 1").Содержит("пропущено 1")
		.Содержит("журнале операций");

	Ошибка = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", "Сбой");
	ЮТест.ОжидаетЧто(ИИОБ_БотКлиентСервер.ТекстИтогаДействия(Ошибка)).Содержит("не выполнено");

КонецПроцедуры

