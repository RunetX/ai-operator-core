// Установка ИИ-оператора (этап 3д, Р-3): проверки базы, выбор компонентов и установка по шагам. Между шагами
// форма показывает ход. Без Асинх: обработка открывается и в режиме совместимости 8.3.17, чтобы сказать, что не так.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьФорму();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКомпоненты

&НаКлиенте
Процедура КомпонентыПометкаПриИзменении(Элемент)

	Строка = Элементы.Компоненты.ТекущиеДанные;
	Если Строка <> Неопределено И Не Строка.Доступен Тогда
		// Ядро обязательно, а недоступный компонент поставить нельзя: причина написана в строке.
		Строка.Пометка = Не Строка.Пометка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)

	Если Не МожноУстанавливать Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала исправьте ошибки в проверках базы.'"));
		Возврат;
	КонецЕсли;
	Шаги.Очистить();
	Для Каждого Строка Из Компоненты Цикл
		Если Строка.Пометка И (Строка.Действие = "install" Или Строка.Действие = "update") Тогда
			Шаги.Добавить(Строка.Код, Строка.Представление);
		КонецЕсли;
	КонецЦикла;
	Если Шаги.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Нечего устанавливать: отмеченные компоненты уже установлены.'"));
		Возврат;
	КонецЕсли;
	Шаги.Добавить("log", НСтр("ru = 'Журнал регистрации'"));
	Шаги.Добавить("bsp", НСтр("ru = 'Профили доступа'"));
	Вопрос = НСтр("ru = 'Расширения будут скачаны из релизов github.com/RunetX и записаны без безопасного режима
		|и защиты от опасных действий: так им доступны MCP-сервер и журнал операций.
		|Расширения из недостоверных источников могут навредить компьютерам пользователей, серверу и данным базы.
		|Устанавливайте, только если доверяете источнику. Установить?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОбУстановке", ЭтотОбъект), Вопрос, РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Нет);

КонецПроцедуры

// Продолжение команды «Установить» после подтверждения.
//
// Параметры:
//  Ответ - КодВозвратаДиалога
//  ДополнительныеПараметры - Неопределено
&НаКлиенте
Процедура ПослеВопросаОбУстановке(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Шаги.Очистить();
		Возврат;
	КонецЕсли;
	Элементы.ФормаУстановить.Доступность = Ложь;
	ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Перезапустить(Команда)

	// Глобальное свойство ПараметрЗапуска только для чтения: команды для нового сеанса - своей переменной.
	КомандыЯдра = "ИИО_Состояние";
	Если ДобавитьВГруппу Тогда
		КомандыЯдра = "ИИО_ДобавитьВГруппу;" + КомандыЯдра;
	КонецЕсли;
	ЗавершитьРаботуСистемы(Истина, Истина, СтрШаблон("/C""%1""", КомандыЯдра));

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьФорму();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьФорму()

	Обработка = РеквизитФормыВЗначение("Объект");
	Среда = Обработка.СостояниеСреды();
	МожноУстанавливать = Среда.МожноУстанавливать;
	ДобавитьВГруппу = Не Среда.Полноправный;

	Проверки.Очистить();
	Для Каждого Проверка Из Среда.Проверки Цикл
		ДобавитьПроверку(Проверка);
	КонецЦикла;

	Компоненты.Очистить();
	Если МожноУстанавливать Тогда
		Каталог = Обработка.Каталог(Среда);
		Если Каталог.ok Тогда
			Для Каждого Компонент Из Каталог.Компоненты Цикл
				ДобавитьКомпонент(Компонент);
			КонецЦикла;
		Иначе
			МожноУстанавливать = Ложь;
			ДобавитьПроверку(Новый Структура("Код, Статус, Заголовок, Текст, Подсказка", "catalog", "error",
				НСтр("ru = 'Релизы на GitHub'"), Каталог.error,
				НСтр("ru = 'Проверьте доступ сервера 1С к api.github.com и github.com и настройки прокси в «Администрирование → Интернет-поддержка и сервисы».'")));
		КонецЕсли;
	КонецЕсли;

	Элементы.ФормаУстановить.Доступность = МожноУстанавливать;
	Элементы.ФормаПерезапустить.Видимость = Ложь;
	Итог = ?(МожноУстанавливать,
		НСтр("ru = 'Отметьте, что ставить, и нажмите «Установить». Файлы скачиваются из релизов github.com/RunetX и сверяются по SHA-256.'"),
		НСтр("ru = 'Установка невозможна: исправьте ошибки в проверках и нажмите «Проверить снова».'"));

КонецПроцедуры

&НаСервере
Процедура ДобавитьПроверку(Проверка)

	Строка = Проверки.Добавить();
	Строка.Заголовок = Проверка.Заголовок;
	Строка.Статус = Проверка.Статус;
	Строка.СостояниеПредставление = ПредставлениеСтатуса(Проверка.Статус);
	Строка.Описание = Проверка.Текст;
	Если ЗначениеЗаполнено(Проверка.Подсказка) Тогда
		Строка.Описание = Строка.Описание + Символы.ПС + НСтр("ru = 'Что сделать: '") + Проверка.Подсказка;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКомпонент(Компонент)

	Строка = Компоненты.Добавить();
	// Описание из манифеста (Соответствие) в форму не передается.
	ЗаполнитьЗначенияСвойств(Строка, Компонент,
		"Код, Представление, Расширение, Версия, Установлена, Действие, Причина, Файл, Адрес, Хеш, Дайджест, Размер,
		|Обязательный");
	Строка.Пометка = Компонент.Действие = "install" Или Компонент.Действие = "update";
	Строка.Доступен = Строка.Пометка И Не Компонент.Обязательный;
	Если Компонент.Действие = "install" Тогда
		Строка.Состояние = НСтр("ru = 'Будет установлен.'");
	ИначеЕсли Компонент.Действие = "update" Тогда
		Строка.Состояние = СтрШаблон(НСтр("ru = 'Будет обновлен с версии %1.'"), Компонент.Установлена);
	ИначеЕсли Компонент.Действие = "none" Тогда
		Строка.Состояние = СтрШаблон(НСтр("ru = 'Установлена версия %1.'"), Компонент.Установлена);
	Иначе
		Строка.Состояние = Компонент.Причина;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеСтатуса(Статус)

	Если Статус = "ok" Тогда
		Возврат НСтр("ru = 'Ок'");
	ИначеЕсли Статус = "warning" Тогда
		Возврат НСтр("ru = 'Внимание'");
	ИначеЕсли Статус = "error" Тогда
		Возврат НСтр("ru = 'Ошибка'");
	КонецЕсли;
	Возврат "-";

КонецФункции

&НаКлиенте
Процедура ВыполнитьСледующийШаг()

	Шаг = Шаги[0];
	Итог = СтрШаблон(НСтр("ru = '%1...'"), Шаг.Представление);
	Результат = ВыполнитьШагНаСервере(Шаг.Значение);
	Шаги.Удалить(0);
	Если Не Результат.ok И Шаг.Значение = "bsp" Тогда
		// Профили БСП создаст и при следующем запуске: это не повод считать установку неудачной.
		Результат.ok = Истина;
	КонецЕсли;
	Если Не Результат.ok Тогда
		Шаги.Очистить();
		Элементы.ФормаУстановить.Доступность = Истина;
		Если Результат.code = "EXCLUSIVE_LOCK" Тогда
			Итог = НСтр("ru = 'С базой работают другие пользователи: расширение с данными записывается только монопольно. Попросите всех выйти (или завершите сеансы в «Администрирование → Обслуживание») и нажмите «Установить» снова.'");
		Иначе
			Итог = СтрШаблон(НСтр("ru = 'Установка остановлена на шаге «%1»: %2'"), Шаг.Представление, Результат.error);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Шаги.Количество() > 0 Тогда
		ПодключитьОбработчикОжидания("ВыполнитьСледующийШаг", 0.1, Истина);
		Возврат;
	КонецЕсли;
	Элементы.ФормаПерезапустить.Видимость = Истина;
	Элементы.ФормаПерезапустить.КнопкаПоУмолчанию = Истина;
	Итог = НСтр("ru = 'Готово. Нажмите «Перезапустить»: 1С откроется с формой «Состояние ИИ-оператора», там токен и настройки MCP-клиента.'");

КонецПроцедуры

&НаСервере
Функция ВыполнитьШагНаСервере(Знач Шаг)

	Обработка = РеквизитФормыВЗначение("Объект");
	Если Шаг = "log" Тогда
		Возврат Обработка.ВключитьЖурнал();
	ИначеЕсли Шаг = "bsp" Тогда
		Возврат Обработка.ОбновитьПараметрыРасширений();
	КонецЕсли;
	Строка = Компоненты.НайтиСтроки(Новый Структура("Код", Шаг))[0];
	Компонент = Новый Структура("Код, Расширение, Версия, Файл, Адрес, Хеш, Дайджест, Размер");
	ЗаполнитьЗначенияСвойств(Компонент, Строка);
	Результат = Обработка.УстановитьКомпонент(Компонент);
	Если Результат.ok Тогда
		Строка.Установлена = Строка.Версия;
		Строка.Действие = "none";
		Строка.Состояние = СтрШаблон(НСтр("ru = 'Установлена версия %1.'"), Строка.Версия);
	Иначе
		Строка.Состояние = Результат.error;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
