Функция РежимСовместимости(ВерсияПлатформы)

	Режим = Строка(Метаданные.РежимСовместимости);
	Цифры = "";
	Для Номер = 1 По СтрДлина(Режим) Цикл
		Символ = Сред(Режим, Номер, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли ЗначениеЗаполнено(Цифры) И Прав(Цифры, 1) <> "." Тогда
			Цифры = Цифры + ".";
		КонецЕсли;
	КонецЦикла;
	Если Прав(Цифры, 1) = "." Тогда
		Цифры = Лев(Цифры, СтрДлина(Цифры) - 1);
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Цифры), Цифры, ВерсияПлатформы);

КонецФункции

