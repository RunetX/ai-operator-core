#КонецОбласти

#Область ВыборВерсий

// Описание компонента для формы и установки.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - core, bot или код пакета.
//   * Представление - Строка
//   * Расширение - Строка - Имя расширения.
//   * Версия - Строка - Версия из манифеста.
//   * Установлена - Строка - Версия в базе; пустая - не установлен.
//   * Действие - Строка - install, update, none, unavailable.
//   * Причина - Строка - Почему недоступен.
//   * Файл - Строка
//   * Адрес - Строка
//   * Хеш - Строка - SHA-256 из манифеста.
//   * Дайджест - Строка - SHA-256 файла по данным GitHub, если есть.
//   * Размер - Число - Байты файла по данным GitHub; 0 - неизвестен.
//   * Обязательный - Булево
//   * Описание - Соответствие - Компонент из манифеста; форме не передается.
Функция НовыйКомпонент()

	Возврат Новый Структура(
		"Код, Представление, Расширение, Версия, Установлена, Действие, Причина, Файл, Адрес, Хеш, Дайджест, Размер,
		|Обязательный, Описание", "", "", "", "", "", "", "", "", "", "", "", 0, Ложь, Неопределено);

КонецФункции

// Компонент из манифеста релиза с файлом для конфигурации базы.
//
// Параметры:
//  Релиз - см. Релизы
//  Код - Строка - Код компонента; пустой - первый компонент манифеста (у пакета он один).
//  Среда - см. СостояниеСреды
//
// Возвращаемое значение:
//  см. НовыйКомпонент
//  Неопределено - В манифесте нет такого компонента.
Функция КомпонентРелиза(Релиз, Код, Среда)

	Компоненты = Релиз.Манифест.Получить("components");
	Если ТипЗнч(Компоненты) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Описание Из Компоненты Цикл
		Если ЗначениеЗаполнено(Код) И Описание.Получить("id") <> Код Тогда
			Продолжить;
		КонецЕсли;
		Компонент = НовыйКомпонент();
		Компонент.Код = СтрокаИзМанифеста(Описание.Получить("id"));
		Компонент.Представление = СтрокаИзМанифеста(Описание.Получить("title"));
		Компонент.Расширение = СтрокаИзМанифеста(Описание.Получить("extension"));
		Компонент.Версия = СтрокаИзМанифеста(Описание.Получить("version"));
		Компонент.Описание = Описание;
		Файл = ФайлДляКонфигурации(Описание, Среда.Конфигурация);
		Если Файл <> Неопределено Тогда
			Компонент.Файл = СтрокаИзМанифеста(Файл.Получить("name"));
			Компонент.Хеш = НРег(СтрокаИзМанифеста(Файл.Получить("sha256")));
			Ссылка = Релиз.Файлы.Получить(Компонент.Файл);
			Если Ссылка <> Неопределено Тогда
				Компонент.Адрес = Ссылка.Адрес;
				Компонент.Дайджест = Ссылка.Дайджест;
				Компонент.Размер = Ссылка.Размер;
			КонецЕсли;
		КонецЕсли;
		Возврат Компонент;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Новейший компонент, совместимый с базой и ядром. Если подходящего нет - последний с причиной.
// Компонент не для этой конфигурации не показывается: выбор без лишних строк.
//
// Параметры:
//  Релизы - Массив из см. Релизы
//  Код - Строка - Код компонента; пустой - компонент пакета.
//  Среда - см. СостояниеСреды
//  ВерсияЯдра - Строка
//  Контракт - Число - Уровень контракта ядра с пакетами (package_api).
//
// Возвращаемое значение:
//  см. НовыйКомпонент
//  Неопределено - Компонент не для этой конфигурации или релизов с ним нет.
Функция СовместимыйКомпонент(Релизы, Код, Среда, ВерсияЯдра, Контракт)

	Первый = Неопределено;
	Для Каждого Релиз Из Релизы Цикл
		Если Релиз.Манифест = Неопределено Или Релиз.Манифест.Получить("schema") > СхемаМанифеста() Тогда
			Продолжить;
		КонецЕсли;
		Компонент = КомпонентРелиза(Релиз, Код, Среда);
		Если Компонент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Первый = Неопределено Тогда
			Если Не ДляКонфигурации(Компонент.Описание, Среда.Конфигурация) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Первый = Компонент;
		КонецЕсли;
		Компонент.Причина = Несовместимость(Компонент.Описание, Среда, ВерсияЯдра, Контракт);
		Если Не ЗначениеЗаполнено(Компонент.Причина) И ЗначениеЗаполнено(Компонент.Адрес) Тогда
			ОпределитьДействие(Компонент, Среда);
			Возврат Компонент;
		КонецЕсли;
	КонецЦикла;
	Если Первый <> Неопределено Тогда
		ОпределитьДействие(Первый, Среда);
	КонецЕсли;
	Возврат Первый;

КонецФункции

// Почему компонент нельзя поставить в эту базу к этому ядру.
//
// Параметры:
//  Описание - Соответствие - Компонент манифеста.
//  Среда - см. СостояниеСреды
//  ВерсияЯдра - Строка - Пустая для самого ядра.
//  Контракт - Число - Уровень контракта ядра; 0 для самого ядра.
//
// Возвращаемое значение:
//  Строка - Пустая, если совместим.
Функция Несовместимость(Описание, Среда, ВерсияЯдра, Контракт)

	Если Не ДляКонфигурации(Описание, Среда.Конфигурация) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Не для конфигурации %1.'"), Среда.Конфигурация);
	КонецЕсли;
	Платформа = СтрокаИзМанифеста(Описание.Получить("platform_min"));
	Если ЗначениеЗаполнено(Платформа) И СравнитьВерсии(Среда.Платформа, Платформа) < 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Нужна платформа %1 или новее.'"), Платформа);
	КонецЕсли;
	Режим = СтрокаИзМанифеста(Описание.Получить("compat_min"));
	Если ЗначениеЗаполнено(Режим) И СравнитьВерсии(Среда.РежимСовместимости, Режим) < 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Нужен режим совместимости конфигурации %1 или новее.'"), Режим);
	КонецЕсли;
	Если Контракт > 0 Тогда
		Если ЧислоИзМанифеста(Описание.Получить("package_api")) <> Контракт Тогда
			Возврат СтрШаблон(НСтр("ru = 'Написан для другого контракта с ядром (%1, у ядра %2).'"),
				ЧислоИзМанифеста(Описание.Получить("package_api")), Контракт);
		КонецЕсли;
		МинимальноеЯдро = СтрокаИзМанифеста(Описание.Получить("core_min"));
		Если Не ЗначениеЗаполнено(ВерсияЯдра) Тогда
			Возврат НСтр("ru = 'Сначала нужно ядро.'");
		ИначеЕсли ЗначениеЗаполнено(МинимальноеЯдро) И СравнитьВерсии(ВерсияЯдра, МинимальноеЯдро) < 0 Тогда
			Возврат СтрШаблон(НСтр("ru = 'Нужно ядро %1 или новее.'"), МинимальноеЯдро);
		КонецЕсли;
	КонецЕсли;
	Условия = Описание.Получить("requires");
	Если ТипЗнч(Условия) = Тип("Массив") Тогда
		Для Каждого Условие Из Условия Цикл
			Если Не Среда.Условия.Свойство(Условие) Тогда
				Возврат НСтр("ru = 'Нужна новая установочная обработка: условие компонента ей неизвестно.'");
			ИначеЕсли Не Среда.Условия[Условие] Тогда
				Возврат ТекстУсловия(Условие);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ТекстУсловия(Условие)

	Если Условие = "bot_patch" Тогда
		Возврат НСтр("ru = 'В конфигурации нет бота «ИИОператор». Добавьте его скриптом install-bot-cfg.ps1 из репозитория ai-operator-core при закрытой 1С, затем запустите установку снова.'");
	ИначеЕсли Условие = "kontur_kedo" Тогда
		Возврат НСтр("ru = 'Нужно установленное расширение Контур.КЭДО.'");
	ИначеЕсли Условие = "bed_etrn" Тогда
		Возврат НСтр("ru = 'В конфигурации нет ЭТрН библиотеки электронных документов (БЭД 1.9).'");
	ИначеЕсли Условие = "interaction_system" Тогда
		Возврат НСтр("ru = 'База не подключена к Системе взаимодействия.'");
	КонецЕсли;
	Возврат Условие;

КонецФункции

Процедура ОпределитьДействие(Компонент, Среда)

	Установлена = Среда.Установленные.Получить(Компонент.Расширение);
	Компонент.Установлена = ?(Установлена = Неопределено, "", Установлена);
	Если ЗначениеЗаполнено(Компонент.Причина) Тогда
		Компонент.Действие = "unavailable";
	ИначеЕсли Не ЗначениеЗаполнено(Компонент.Установлена) Тогда
		Компонент.Действие = "install";
	ИначеЕсли СравнитьВерсии(Компонент.Версия, Компонент.Установлена) > 0 Тогда
		Компонент.Действие = "update";
	Иначе
		Компонент.Действие = "none";
	КонецЕсли;

КонецПроцедуры

Функция ДляКонфигурации(Описание, Конфигурация)

	Конфигурации = Описание.Получить("configurations");
	Если ТипЗнч(Конфигурации) <> Тип("Массив") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Конфигурации.Найти(Конфигурация) <> Неопределено Или Конфигурации.Найти("*") <> Неопределено;

КонецФункции

Функция ФайлДляКонфигурации(Описание, Конфигурация)

	Файлы = Описание.Получить("assets");
	Если ТипЗнч(Файлы) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Файл Из Файлы Цикл
		Если ДляКонфигурации(Файл, Конфигурация) Тогда
			Возврат Файл;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПоследнийСМанифестом(Релизы)

	Для Каждого Релиз Из Релизы Цикл
		Если Релиз.Манифест <> Неопределено Тогда
			Возврат Релиз;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Сравнивает версии вида 8.3.20 или 0.1.15.0 по числам.
//
// Параметры:
//  Версия1 - Строка
//  Версия2 - Строка
//
// Возвращаемое значение:
//  Число - -1, 0 или 1.
Функция СравнитьВерсии(Версия1, Версия2)

	Части1 = СтрРазделить(Версия1, ".");
	Части2 = СтрРазделить(Версия2, ".");
	Для Номер = 0 По Макс(Части1.Количество(), Части2.Количество()) - 1 Цикл
		Число1 = ?(Номер < Части1.Количество(), ЧислоИзСтроки(Части1[Номер]), 0);
		Число2 = ?(Номер < Части2.Количество(), ЧислоИзСтроки(Части2[Номер]), 0);
		Если Число1 <> Число2 Тогда
			Возврат ?(Число1 > Число2, 1, -1);
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

