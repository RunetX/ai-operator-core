// Установка ИИ-оператора (этап 3д, Р-3): проверка базы, выбор совместимых версий по manifest.json
// последних релизов GitHub, скачивание с проверкой SHA-256 и запись расширений по образцу формы БСП «Расширения».
// Код без Асинх и без функций БСП новее 3.1.7: обработка должна открыться и в старой базе, чтобы сказать, что не так.
// Экспортные функции вызывает форма, а e2e-тест - через COM-соединение.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Версия установочной обработки: совпадает с версией ядра, с релизом которого она выходит.
//
// Возвращаемое значение:
//  Строка
Функция ВерсияОбработки() Экспорт

	Возврат "0.1.15.1";

КонецФункции

// Состояние базы до установки.
//
// Возвращаемое значение:
//  Структура:
//   * Проверки - Массив из см. НоваяПроверка
//   * МожноУстанавливать - Булево - Нет проверок со статусом error.
//   * Конфигурация - Строка - Имя конфигурации из метаданных.
//   * Платформа - Строка
//   * РежимСовместимости - Строка - Например, 8.3.20; без режима совместимости - версия платформы.
//   * Установленные - Соответствие из КлючИЗначение - Ключ - имя расширения, значение - версия.
//   * Условия - Структура - bot_patch, kontur_kedo, bed_etrn, interaction_system: Булево.
//   * Полноправный - Булево - Роль «Полные права» БСП.
Функция СостояниеСреды() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Среда = Новый Структура;
	Среда.Вставить("Проверки", Новый Массив);
	Среда.Вставить("МожноУстанавливать", Истина);
	Среда.Вставить("Конфигурация", Метаданные.Имя);
	Среда.Вставить("Платформа", СистемнаяИнформация.ВерсияПриложения);
	Среда.Вставить("РежимСовместимости", РежимСовместимости(Среда.Платформа));
	Среда.Вставить("Установленные", Новый Соответствие);
	Среда.Вставить("Условия", Новый Структура);
	Среда.Вставить("Полноправный", Полноправный());

	ПроверитьПлатформу(Среда);
	ПроверитьПрава(Среда);
	ПроверитьБазу(Среда);
	ПроверитьРасширения(Среда);
	ЗаполнитьУсловия(Среда);

	Для Каждого Проверка Из Среда.Проверки Цикл
		Если Проверка.Статус = "error" Тогда
			Среда.МожноУстанавливать = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Среда;

КонецФункции

// Что ставить: версии из manifest.json релизов, совместимые между собой и с базой.
//
// Параметры:
//  Среда - см. СостояниеСреды
//  АдресРелизов - Строка - Адрес API релизов владельца репозиториев. Пустой - GitHub; другой - только для тестов.
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * error - Строка
//   * Компоненты - Массив из см. НовыйКомпонент - Ядро, бот, пакеты этой конфигурации.
Функция Каталог(Среда, АдресРелизов = "") Экспорт

	Результат = Новый Структура("ok, error, Компоненты", Ложь, "", Новый Массив);
	Адрес = ?(ЗначениеЗаполнено(АдресРелизов), АдресРелизов, "https://api.github.com/repos/RunetX");

	РелизыЯдра = Релизы(Адрес, "ai-operator-core");
	Если Не РелизыЯдра.ok Тогда
		Результат.error = РелизыЯдра.error;
		Возврат Результат;
	КонецЕсли;
	Последний = ПоследнийСМанифестом(РелизыЯдра.Релизы);
	Если Последний = Неопределено Тогда
		Результат.error = НСтр("ru = 'В релизах ядра нет manifest.json: установочная обработка работает с ядром 0.1.15.0 и новее.'");
		Возврат Результат;
	КонецЕсли;
	Если Последний.Манифест.Получить("schema") > СхемаМанифеста() Тогда
		Результат.error = СтрШаблон(
			НСтр("ru = 'Релиз ядра %1 описан новой схемой. Скачайте новую установочную обработку из этого релиза: %2'"),
			Последний.Тег, Последний.Ссылка);
		Возврат Результат;
	КонецЕсли;

	Ядро = КомпонентРелиза(Последний, "core", Среда);
	Если Ядро = Неопределено Тогда
		Результат.error = НСтр("ru = 'В манифесте ядра нет компонента core.'");
		Возврат Результат;
	КонецЕсли;
	Ядро.Обязательный = Истина;
	Ядро.Причина = Несовместимость(Ядро.Описание, Среда, "", 0);
	Если Не ЗначениеЗаполнено(Ядро.Причина) И Не ЗначениеЗаполнено(Ядро.Файл) Тогда
		Ядро.Причина = СтрШаблон(НСтр("ru = 'Ядро не собрано для конфигурации %1.'"), Среда.Конфигурация);
	КонецЕсли;
	ОпределитьДействие(Ядро, Среда);
	Результат.Компоненты.Добавить(Ядро);

	// Пакеты сверяются с ядром, которое будет в базе после установки, и с уровнем контракта его манифеста.
	ВерсияЯдра = ?(Ядро.Действие = "install" Или Ядро.Действие = "update", Ядро.Версия, Ядро.Установлена);
	Контракт = ЧислоИзМанифеста(Ядро.Описание.Получить("package_api"));

	Бот = СовместимыйКомпонент(РелизыЯдра.Релизы, "bot", Среда, ВерсияЯдра, Контракт);
	Если Бот <> Неопределено Тогда
		Результат.Компоненты.Добавить(Бот);
	КонецЕсли;
	Для Каждого Репозиторий Из СтрРазделить("ai-operator-kedo,ai-operator-epd", ",") Цикл
		РелизыПакета = Релизы(Адрес, Репозиторий);
		Если Не РелизыПакета.ok Тогда
			Результат.error = РелизыПакета.error;
			Возврат Результат;
		КонецЕсли;
		Пакет = СовместимыйКомпонент(РелизыПакета.Релизы, "", Среда, ВерсияЯдра, Контракт);
		Если Пакет <> Неопределено Тогда
			Результат.Компоненты.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Результат.ok = Истина;
	Возврат Результат;

КонецФункции

// Скачивает расширение, сверяет SHA-256 и записывает его со снятыми флагами «Безопасный режим» и
// «Защита от опасных действий». Сбой записи не оставляет новое расширение в базе.
//
// Параметры:
//  Компонент - см. НовыйКомпонент
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * code - Строка - DOWNLOAD_FAILED, HASH_MISMATCH, NOT_APPLICABLE, EXCLUSIVE_LOCK, WRITE_FAILED.
//   * error - Строка
Функция УстановитьКомпонент(Компонент) Экспорт

	Загрузка = Скачать(Компонент.Адрес, ТаймаутФайла(Компонент.Размер));
	Если Не Загрузка.ok Тогда
		Возврат НовыйРезультат("DOWNLOAD_FAILED", Загрузка.error);
	КонецЕсли;
	Хеш = ХешФайла(Загрузка.Данные);
	Если Хеш <> НРег(Компонент.Хеш)
		Или ЗначениеЗаполнено(Компонент.Дайджест) И Хеш <> НРег(Компонент.Дайджест) Тогда
		Возврат НовыйРезультат("HASH_MISMATCH", СтрШаблон(
			НСтр("ru = 'Контрольная сумма файла %1 не совпала с манифестом релиза: файл не установлен.'"), Компонент.Файл));
	КонецЕсли;

	Найденные = РасширенияКонфигурации.Получить(Новый Структура("Имя", Компонент.Расширение));
	Новое = Найденные.Количество() = 0;
	Расширение = ?(Новое, РасширенияКонфигурации.Создать(), Найденные[0]);
	Если Не Новое Тогда
		Проблемы = КритичныеПроблемы(Расширение, Загрузка.Данные);
		Если ЗначениеЗаполнено(Проблемы) Тогда
			Возврат НовыйРезультат("NOT_APPLICABLE", Проблемы);
		КонецЕсли;
	КонецЕсли;

	// Расширения ИИ-оператора хранят данные: запись меняет структуру базы и требует монопольного доступа.
	Попытка
		УстановитьМонопольныйРежим(Истина);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , Компонент.Расширение,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Возврат НовыйРезультат("EXCLUSIVE_LOCK", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	КонецПопытки;

	Попытка
		Расширение.БезопасныйРежим = Ложь;
		Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		Расширение.ЗащитаОтОпасныхДействий = Защита;
		Если Новое Тогда
			// Роли выдаются профилями БСП, а не всем пользователям сразу.
			Расширение.ИспользоватьОсновныеРолиДляВсехПользователей = Ложь;
		КонецЕсли;
		Расширение.Записать(Загрузка.Данные);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , Компонент.Расширение,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Если Новое Тогда
			УдалитьРасширение(Компонент.Расширение);
		КонецЕсли;
		УстановитьМонопольныйРежим(Ложь);
		Возврат НовыйРезультат("WRITE_FAILED", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	КонецПопытки;
	УстановитьМонопольныйРежим(Ложь);
	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , Компонент.Расширение,
		СтрШаблон("%1 %2 (%3)", Компонент.Расширение, Компонент.Версия, Компонент.Файл));
	Возврат НовыйРезультат("", "");

КонецФункции

// Включает уровень «Информация» в журнале регистрации: без него действия ИИ-оператора недоступны.
// Платформа принимает только сплошной набор уровней; «Примечание» остается, если писалось.
//
// Возвращаемое значение:
//  Структура - ok, code, error, см. УстановитьКомпонент.
Функция ВключитьЖурнал() Экспорт

	ИсходныеУровни = ПолучитьИспользованиеЖурналаРегистрации();
	Если ИсходныеУровни.Найти(УровеньЖурналаРегистрации.Информация) <> Неопределено Тогда
		Возврат НовыйРезультат("", "");
	КонецЕсли;
	Уровни = Новый Массив;
	Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
	Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
	Уровни.Добавить(УровеньЖурналаРегистрации.Информация);
	Если ИсходныеУровни.Найти(УровеньЖурналаРегистрации.Примечание) <> Неопределено Тогда
		Уровни.Добавить(УровеньЖурналаРегистрации.Примечание);
	КонецЕсли;
	Попытка
		УстановитьИспользованиеЖурналаРегистрации(Уровни);
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Возврат НовыйРезультат("WRITE_FAILED", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	КонецПопытки;
	Возврат НовыйРезультат("", "");

КонецФункции

// Обновляет параметры работы расширений БСП: идентификаторы объектов, поставляемые профили и роли. Так делает
// форма БСП «Расширения» после записи; без этого профили «ИИ-оператор» появятся только при следующем обновлении.
//
// Возвращаемое значение:
//  Структура - ok, code, error, см. УстановитьКомпонент.
Функция ОбновитьПараметрыРасширений() Экспорт

	Попытка
		РегистрыСведений.ПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
	Исключение
		Информация = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Возврат НовыйРезультат("WRITE_FAILED", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	КонецПопытки;
	Возврат НовыйРезультат("", "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроверкиСреды

// Строка проверки среды.
//
// Параметры:
//  Код - Строка
//  Статус - Строка - ok, warning, error.
//  Заголовок - Строка
//  Текст - Строка
//  Подсказка - Строка
//
// Возвращаемое значение:
//  Структура - Код, Статус, Заголовок, Текст, Подсказка.
Функция НоваяПроверка(Код, Статус, Заголовок, Текст, Подсказка = "")

	Возврат Новый Структура("Код, Статус, Заголовок, Текст, Подсказка", Код, Статус, Заголовок, Текст, Подсказка);

КонецФункции

Процедура ПроверитьПлатформу(Среда)

	Заголовок = НСтр("ru = 'Платформа'");
	Если СравнитьВерсии(Среда.Платформа, МинимальнаяВерсия()) < 0 Тогда
		Среда.Проверки.Добавить(НоваяПроверка("platform", "error", Заголовок,
			СтрШаблон(НСтр("ru = 'Версия %1, нужна %2 или новее.'"), Среда.Платформа, МинимальнаяВерсия()),
			НСтр("ru = 'Обновите платформу 1С:Предприятие на сервере и рабочих местах.'")));
	Иначе
		Среда.Проверки.Добавить(НоваяПроверка("platform", "ok", Заголовок, Среда.Платформа));
	КонецЕсли;

	Заголовок = НСтр("ru = 'Режим совместимости конфигурации'");
	Если СравнитьВерсии(Среда.РежимСовместимости, МинимальнаяВерсия()) < 0 Тогда
		Среда.Проверки.Добавить(НоваяПроверка("compatibility", "error", Заголовок,
			СтрШаблон(НСтр("ru = 'Версия %1, расширения ИИ-оператора собраны в режиме %2.'"), Среда.РежимСовместимости,
				МинимальнаяВерсия()),
			НСтр("ru = 'Обновите конфигурацию: в релизах БП 3.0, ЗУП 3.1 и УТ 11.5 последних лет режим подходит.'")));
	Иначе
		Среда.Проверки.Добавить(НоваяПроверка("compatibility", "ok", Заголовок, Среда.РежимСовместимости));
	КонецЕсли;

	Среда.Проверки.Добавить(НоваяПроверка("configuration", "ok", НСтр("ru = 'Конфигурация'"),
		СтрШаблон("%1 %2", Метаданные.Синоним, Метаданные.Версия)));

КонецПроцедуры

Процедура ПроверитьПрава(Среда)

	Заголовок = НСтр("ru = 'Права'");
	Если Не ПравоДоступа("Администрирование", Метаданные)
		Или Не ПравоДоступа("АдминистрированиеРасширенийКонфигурации", Метаданные) Тогда
		Среда.Проверки.Добавить(НоваяПроверка("rights", "error", Заголовок,
			НСтр("ru = 'Нет прав «Администрирование» и «Администрирование расширений конфигурации».'"),
			НСтр("ru = 'Запустите обработку под администратором базы (профиль «Администратор»).'")));
	Иначе
		Среда.Проверки.Добавить(НоваяПроверка("rights", "ok", Заголовок, НСтр("ru = 'Администратор.'")));
	КонецЕсли;

	Если БезопасныйРежим() <> Ложь Тогда
		Среда.Проверки.Добавить(НоваяПроверка("safe_mode", "error", НСтр("ru = 'Безопасный режим'"),
			НСтр("ru = 'Обработка открыта в безопасном режиме: расширения в нем не записываются.'"),
			НСтр("ru = 'Откройте обработку через «Файл → Открыть» и разрешите открытие.'")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьБазу(Среда)

	Заголовок = НСтр("ru = 'Информационная база'");
	Вид = ?(СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1,
		НСтр("ru = 'файловая'"), НСтр("ru = 'клиент-серверная'"));
	Ошибка = "";
	Попытка
		Если ОбновлениеИнформационнойБазы.НеобходимоОбновлениеИнформационнойБазы() Тогда
			Ошибка = НСтр("ru = 'Конфигурация обновлена, но обновление информационной базы не завершено.'");
		КонецЕсли;
	Исключение
		// Проверка не должна останавливать остальные: причину видно в строке и в журнале регистрации.
		ЗаписатьПредупреждение(ИнформацияОбОшибке());
		Ошибка = НСтр("ru = 'Не удалось проверить, обновлена ли информационная база: подробности в журнале регистрации.'");
	КонецПопытки;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Среда.Проверки.Добавить(НоваяПроверка("infobase", "error", Заголовок, Ошибка,
			НСтр("ru = 'Перезапустите 1С и дождитесь окончания обновления.'")));
	Иначе
		Среда.Проверки.Добавить(НоваяПроверка("infobase", "ok", Заголовок, Вид));
	КонецЕсли;

	Попытка
		ПрофилиБезопасности = РаботаВБезопасномРежиме.ИспользуютсяПрофилиБезопасности();
	Исключение
		// В старых версиях БСП функции нет, профили безопасности там не используются.
		ЗаписатьПредупреждение(ИнформацияОбОшибке());
		ПрофилиБезопасности = Ложь;
	КонецПопытки;
	Если ПрофилиБезопасности Тогда
		Среда.Проверки.Добавить(НоваяПроверка("security_profiles", "error", НСтр("ru = 'Профили безопасности'"),
			НСтр("ru = 'В кластере включены профили безопасности: установщик их пока не поддерживает.'"),
			НСтр("ru = 'Установите расширения вручную по инструкции install.md из репозитория ai-operator-core.'")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРасширения(Среда)

	Список = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если СтрНачинаетсяС(Расширение.Имя, "ИИОператор") Тогда
			Среда.Установленные.Вставить(Расширение.Имя, Расширение.Версия);
			Список.Добавить(СтрШаблон("%1 %2", Расширение.Имя, Расширение.Версия));
		КонецЕсли;
	КонецЦикла;
	Заголовок = НСтр("ru = 'Установлено'");
	Если Список.Количество() = 0 Тогда
		Среда.Проверки.Добавить(НоваяПроверка("installed", "ok", Заголовок, НСтр("ru = 'ИИ-оператора в базе нет.'")));
	Иначе
		Среда.Проверки.Добавить(НоваяПроверка("installed", "ok", Заголовок, СтрСоединить(Список, ", ")));
	КонецЕсли;

КонецПроцедуры

// Условия компонентов из манифестов (поле requires): те же проверки, что у модулей _СостояниеПакета,
// но до установки этих модулей в базе нет.
//
// Параметры:
//  Среда - см. СостояниеСреды
Процедура ЗаполнитьУсловия(Среда)

	Среда.Условия.Вставить("bot_patch", ЕстьПатчБота());
	Среда.Условия.Вставить("kontur_kedo", Метаданные.Обработки.Найти("КонтурКэдоПриглашениеСотрудников") <> Неопределено
		И Метаданные.Справочники.Найти("КЭДО_Организации") <> Неопределено);
	Среда.Условия.Вставить("bed_etrn", ЕстьЭТрН());
	Попытка
		Среда.Условия.Вставить("interaction_system", СистемаВзаимодействия.ИнформационнаяБазаЗарегистрирована());
	Исключение
		// Сервис взаимодействия недоступен: для установки это значит «не подключена».
		ЗаписатьПредупреждение(ИнформацияОбОшибке());
		Среда.Условия.Вставить("interaction_system", Ложь);
	КонецПопытки;

КонецПроцедуры

