// Критичные проблемы применения новой версии к базе, как в форме БСП «Расширения».
//
// Параметры:
//  Расширение - РасширениеКонфигурации
//  Данные - ДвоичныеДанные
//
// Возвращаемое значение:
//  Строка - Пустая, если проблем нет.
Функция КритичныеПроблемы(Расширение, Данные)

	Тексты = Новый Массив;
	Для Каждого Проблема Из Расширение.ПроверитьВозможностьПрименения(Данные, Ложь) Цикл
		Если Проблема.Важность = ВажностьПроблемыПримененияРасширенияКонфигурации.Критичная Тогда
			Тексты.Добавить(Проблема.Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

Процедура УдалитьРасширение(Имя)

	Для Каждого Расширение Из РасширенияКонфигурации.Получить(Новый Структура("Имя", Имя)) Цикл
		// Расширение с данными платформа удаляет только неактивным.
		Если Расширение.Активно Тогда
			Расширение.Активно = Ложь;
			Расширение.Записать();
		КонецЕсли;
		Расширение.Удалить();
	КонецЦикла;

КонецПроцедуры

