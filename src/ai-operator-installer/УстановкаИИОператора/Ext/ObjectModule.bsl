#Область Загрузка

// Релизы репозитория, новые первыми, без черновиков и предварительных.
//
// Параметры:
//  Адрес - Строка - Адрес API релизов владельца.
//  Репозиторий - Строка
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * error - Строка
//   * Релизы - Массив из Структура:
//     ** Тег - Строка
//     ** Ссылка - Строка - Страница релиза.
//     ** Файлы - Соответствие из КлючИЗначение - Ключ - имя файла, значение - Структура: Адрес, Дайджест.
//     ** Манифест - Соответствие - manifest.json релиза; Неопределено, если его нет.
Функция Релизы(Адрес, Репозиторий)

	Результат = Новый Структура("ok, error, Релизы", Ложь, "", Новый Массив);
	Загрузка = Скачать(СтрШаблон("%1/%2/releases?per_page=10", Адрес, Репозиторий), ТаймаутЗапроса(), Истина);
	Если Не Загрузка.ok Тогда
		Результат.error = СтрШаблон(НСтр("ru = 'Не удалось получить список релизов %1: %2'"), Репозиторий, Загрузка.error);
		Возврат Результат;
	КонецЕсли;
	Список = ПрочитанныеДанные(Загрузка.Данные);
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Результат.error = СтрШаблон(НСтр("ru = 'Список релизов %1 не прочитан.'"), Репозиторий);
		Возврат Результат;
	КонецЕсли;
	Для Каждого Описание Из Список Цикл
		Если Описание.Получить("draft") = Истина Или Описание.Получить("prerelease") = Истина Тогда
			Продолжить;
		КонецЕсли;
		Релиз = Новый Структура("Тег, Ссылка, Файлы, Манифест", СтрокаИзМанифеста(Описание.Получить("tag_name")),
			СтрокаИзМанифеста(Описание.Получить("html_url")), Новый Соответствие, Неопределено);
		Файлы = Описание.Получить("assets");
		Если ТипЗнч(Файлы) = Тип("Массив") Тогда
			Для Каждого Файл Из Файлы Цикл
				Дайджест = СтрокаИзМанифеста(Файл.Получить("digest"));
				Ссылка = Новый Структура("Адрес, Дайджест, Размер",
					СтрокаИзМанифеста(Файл.Получить("browser_download_url")),
					?(СтрНачинаетсяС(Дайджест, "sha256:"), Сред(Дайджест, 8), ""),
					ЧислоИзМанифеста(Файл.Получить("size")));
				Релиз.Файлы.Вставить(СтрокаИзМанифеста(Файл.Получить("name")), Ссылка);
			КонецЦикла;
		КонецЕсли;
		ФайлМанифеста = Релиз.Файлы.Получить("manifest.json");
		Если ФайлМанифеста <> Неопределено Тогда
			ЗагрузкаМанифеста = Скачать(ФайлМанифеста.Адрес, ТаймаутЗапроса());
			Если ЗагрузкаМанифеста.ok Тогда
				Манифест = ПрочитанныеДанные(ЗагрузкаМанифеста.Данные);
				Релиз.Манифест = ?(ТипЗнч(Манифест) = Тип("Соответствие"), Манифест, Неопределено);
			КонецЕсли;
		КонецЕсли;
		Результат.Релизы.Добавить(Релиз);
	КонецЦикла;
	Результат.ok = Истина;
	Возврат Результат;

КонецФункции

// Скачивает файл средствами БСП: редиректы GitHub, прокси из настроек, HTTPS с сертификатами ОС.
//
// Параметры:
//  Адрес - Строка
//  Таймаут - Число - Секунды, см. ТаймаутЗапроса и ТаймаутФайла.
//  ЗапросСпискаРелизов - Булево - Запрос к API релизов: нужен заголовок Accept.
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * error - Строка
//   * Данные - ДвоичныеДанные
Функция Скачать(Адрес, Таймаут, ЗапросСпискаРелизов = Ложь)

	Результат = Новый Структура("ok, error, Данные", Ложь, "", Неопределено);
	Параметры = ПолучениеФайловИзИнтернетаКлиентСервер.ПараметрыПолученияФайла();
	// Автоматический таймаут БСП на ответ 302 от GitHub дает 30 секунд на весь файл, поэтому он задается явно.
	Параметры.Таймаут = Таймаут;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", "ai-operator-installer/" + ВерсияОбработки());
	Если ЗапросСпискаРелизов Тогда
		Заголовки.Вставить("Accept", "application/vnd.github+json");
	КонецЕсли;
	Параметры.Вставить("Заголовки", Заголовки);
	Загрузка = ПолучениеФайловИзИнтернета.СкачатьФайлВоВременноеХранилище(Адрес, Параметры);
	Если Не Загрузка.Статус Тогда
		Результат.error = Загрузка.СообщениеОбОшибке;
		Возврат Результат;
	КонецЕсли;
	Результат.Данные = ПолучитьИзВременногоХранилища(Загрузка.Путь);
	УдалитьИзВременногоХранилища(Загрузка.Путь);
	Результат.ok = ТипЗнч(Результат.Данные) = Тип("ДвоичныеДанные");
	Если Не Результат.ok Тогда
		Результат.error = СтрШаблон(НСтр("ru = 'Пустой ответ на запрос %1.'"), Адрес);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Таймаут запроса к API релизов и manifest.json: короткие ответы.
//
// Возвращаемое значение:
//  Число
Функция ТаймаутЗапроса()

	Возврат 30;

КонецФункции

// Таймаут скачивания файла расширения: 128 секунд на мегабайт, не меньше 180; без размера - 300.
//
// Параметры:
//  Размер - Число - Байты.
//
// Возвращаемое значение:
//  Число
Функция ТаймаутФайла(Размер)

	Если Не ЗначениеЗаполнено(Размер) Тогда
		Возврат 300;
	КонецЕсли;
	Возврат Макс(180, Окр(Размер / 1048576 * 128));

КонецФункции

// Записывает в журнал регистрации проверку, которая не прошла, но не мешает остальным.
//
// Параметры:
//  Информация - ИнформацияОбОшибке
Процедура ЗаписатьПредупреждение(Информация)

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , ,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));

КонецПроцедуры

Функция ПрочитанныеДанные(Данные)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8));
	Попытка
		Значение = ПрочитатьJSON(Чтение, Истина);
	Исключение
		// Испорченный ответ - как отсутствующий манифест: каталог покажет причину, подробности - в журнале.
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка, , ,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Значение = Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

Функция ХешФайла(Данные)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

