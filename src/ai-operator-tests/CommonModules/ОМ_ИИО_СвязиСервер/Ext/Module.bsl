#Область Тесты

Процедура СчетФактураПодчиненРеализации() Экспорт

	Пара = РеализацияСоСчетомФактурой();

	Результат = СвязанныеОбъекты(Пара.Реализация);

	Связь = Связь(Результат.children, Пара.СчетФактура);
	ЮТест.ОжидаетЧто(Связь).Заполнено();
	ЮТест.ОжидаетЧто(Связь.via).Равно("ДокументОснование");
	ЮТест.ОжидаетЧто(Связь.date).Заполнено();
	ЮТест.ОжидаетЧто(Результат.object.ref).Равно(ИИО_Ответ.СсылкаВСтроку(Пара.Реализация));
	ЮТест.ОжидаетЧто(Результат.source.method).Содержит("Связанные документы");

КонецПроцедуры

Процедура РеализацияОснованиеСчетаФактуры() Экспорт

	Пара = РеализацияСоСчетомФактурой();

	Результат = СвязанныеОбъекты(Пара.СчетФактура);

	ЮТест.ОжидаетЧто(Связь(Результат.parents, Пара.Реализация)).Заполнено();
	ЮТест.ОжидаетЧто(Связь(Результат.children, Пара.Реализация)).НеЗаполнено();

КонецПроцедуры

Процедура ЛимитОбрезаетСвязи() Экспорт

	// У реализации в демо-базе есть подчиненный счет-фактура, а обычно и основание - счет покупателю.
	Пара = РеализацияСоСчетомФактурой();
	Полный = СвязанныеОбъекты(Пара.Реализация);

	Результат = ИИО_Связи.СвязанныеОбъекты(Новый Структура("ref, limit", ИИО_Ответ.СсылкаВСтроку(Пара.Реализация), 1));

	ЮТест.ОжидаетЧто(Результат.children).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Результат.parents.Количество() <= 1).ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.truncated).Равно(Полный.parents.Количество() > 1 Или Полный.children.Количество() > 1);

КонецПроцедуры

