#Область СлужебныеПроцедурыИФункции

Функция СвязанныеОбъекты(Ссылка)

	Результат = ИИО_Связи.СвязанныеОбъекты(Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(Ссылка)));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Результат) Тогда
		ВызватьИсключение Результат.error.message;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращает связь с этим документом из parents или children, или Неопределено.
//
// Параметры:
//  Связи - Массив из Структура - parents или children ответа, см. ИИО_Связи.СвязанныеОбъекты.
//  Ссылка - ДокументСсылка - Искомый документ.
//
// Возвращаемое значение:
//  Структура, Неопределено - Элемент Связи или Неопределено, если документа среди связей нет.
Функция Связь(Связи, Ссылка)

	Идентификатор = ИИО_Ответ.СсылкаВСтроку(Ссылка);
	Для Каждого Связь Из Связи Цикл
		Если Связь.object.ref = Идентификатор Тогда
			Возврат Связь;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция РеализацияСоСчетомФактурой()

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 С.ДокументОснование КАК Реализация, С.Ссылка КАК СчетФактура
	|ИЗ Документ.СчетФактураВыданный КАК С
	|ГДЕ С.ДокументОснование ССЫЛКА Документ.РеализацияТоваровУслуг И НЕ С.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО С.Дата");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В демо-базе нет счета-фактуры на реализацию";
	КонецЕсли;
	Возврат Новый Структура("Реализация, СчетФактура", Выборка.Реализация, Выборка.СчетФактура);

КонецФункции

// Возвращает идентификаторы первых реализаций для аргумента refs.
//
// Параметры:
//  Количество - Число - Сколько реализаций взять.
//
// Возвращаемое значение:
//  Массив из Строка - Идентификаторы ссылок, см. ИИО_Ответ.СсылкаВСтроку.
Функция Реализации(Количество)

	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1 Р.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р
	|УПОРЯДОЧИТЬ ПО Р.Дата", Количество));
	Ссылки = Новый Массив;
	Для Каждого Ссылка Из Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка") Цикл
		Ссылки.Добавить(ИИО_Ответ.СсылкаВСтроку(Ссылка));
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

Функция Идентификаторы(Формы)

	Результат = Новый Массив;
	Для Каждого Форма Из Формы Цикл
		Результат.Добавить(Форма.id);
	КонецЦикла;
	Возврат Результат;

КонецФункции

