// Пустые правила учетной политики теста, см. УстановитьПолитику.
//
// Возвращаемое значение:
//  Структура:
//   * Распределение - Массив из см. НовоеПравило
//   * НЗП - Структура - Ключ - имя предопределенного счета, значение - имя варианта учета НЗП.
//   * Роли - Структура - Ключ - имя предопределенного счета, значение - имя роли счета затрат, пустое - строка
//     без роли.
//   * РазрезыНЗП - Структура - Ключ - имя предопределенного счета, значение - имя вида субконто разреза НЗП.
Функция НоваяПолитика()

	Возврат Новый Структура("Распределение, НЗП, Роли, РазрезыНЗП", Новый Массив, Новый Структура, Новый Структура,
		Новый Структура);

КонецФункции

// Правило распределения косвенных затрат.
//
// Параметры:
//  Счет - Строка - Имя предопределенного счета.
//  База - Строка - Имя значения перечисления БазыРаспределенияКосвенныхРасходов.
//  Подразделение - СправочникСсылка.ПодразделенияОрганизаций, Неопределено
//  Филиал - СправочникСсылка.Организации, Неопределено
//  Статья - СправочникСсылка.СтатьиЗатрат, Неопределено
//
// Возвращаемое значение:
//  Структура
Функция НовоеПравило(Счет, База, Подразделение = Неопределено, Филиал = Неопределено, Статья = Неопределено)

	Возврат Новый Структура("Счет, База, Подразделение, Филиал, Статья", Счет, База, Подразделение, Филиал, Статья);

КонецФункции

// Учетная политика организации на месяц даты с новыми настройками учета затрат: правила теста вместо демо-базы.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
//  Политика - см. НоваяПолитика
Процедура УстановитьПолитику(Организация, Дата, Политика)

	Настройки = Справочники.НастройкиУчетаЗатрат.СоздатьЭлемент();
	Настройки.Заполнить(Неопределено);
	// Заполнение по умолчанию может добавить правила: в настройках теста - только его правила.
	Настройки.ПланСчетов.Очистить();
	Настройки.Распределение.Очистить();
	Настройки.НезавершенноеПроизводство.Очистить();
	Настройки.РазрезыУчетаНезавершенногоПроизводства.Очистить();
	Настройки.Наименование = "Тест закрытия месяца";
	Для Каждого Правило Из Политика.Распределение Цикл
		Запись = Настройки.Распределение.Добавить();
		Запись.Счет = ПланыСчетов.Хозрасчетный[Правило.Счет];
		Запись.БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхРасходов[Правило.База];
		Запись.Подразделение = Правило.Подразделение;
		Запись.Филиал = Правило.Филиал;
		Запись.СтатьяЗатрат = Правило.Статья;
	КонецЦикла;
	Для Каждого Правило Из Политика.НЗП Цикл
		Запись = Настройки.НезавершенноеПроизводство.Добавить();
		Запись.Счет = ПланыСчетов.Хозрасчетный[Правило.Ключ];
		Запись.ВариантУчета = Перечисления.ВариантыУчетаНезавершенногоПроизводства[Правило.Значение];
	КонецЦикла;
	Для Каждого Правило Из Политика.Роли Цикл
		Запись = Настройки.ПланСчетов.Добавить();
		Запись.Счет = ПланыСчетов.Хозрасчетный[Правило.Ключ];
		Если ЗначениеЗаполнено(Правило.Значение) Тогда
			Запись.Роль = Перечисления.РолиСчетовЗатрат[Правило.Значение];
		КонецЕсли;
	КонецЦикла;
	Для Каждого Разрез Из Политика.РазрезыНЗП Цикл
		Запись = Настройки.РазрезыУчетаНезавершенногоПроизводства.Добавить();
		Запись.Счет = ПланыСчетов.Хозрасчетный[Разрез.Ключ];
		Запись.ВидАналитики = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[Разрез.Значение];
	КонецЦикла;
	Настройки.ОбменДанными.Загрузка = Истина;
	Настройки.Записать();

	Набор = РегистрыСведений.УчетнаяПолитика.СоздатьНаборЗаписей();
	Набор.Отбор.Организация.Установить(Организация);
	Набор.Отбор.Период.Установить(НачалоМесяца(Дата));
	Запись = Набор.Добавить();
	Запись.Период = НачалоМесяца(Дата);
	Запись.Организация = Организация;
	Запись.НастройкиУчетаЗатрат = Настройки.Ссылка;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

КонецПроцедуры

// Месяц после данных организации, не раньше заданного, с выполненной операцией «Закрытие счетов 90, 91»: в нем
// только проводки теста.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  НеРаньше - Дата - Самый ранний месяц.
//
// Возвращаемое значение:
//  Дата - Начало месяца.
Функция ЗакрытыйПустойМесяц(Организация, НеРаньше = '00010101')

	Месяц = Макс(НачалоМесяца(ДобавитьМесяц(ПоследняяПроводка(Организация), 1)), НачалоМесяца(НеРаньше));
	НовыйДокумент("РегламентнаяОперация", Организация, КонецМесяца(Месяц), Новый Структура("ВидОперации, Состояние",
		Перечисления.ВидыРегламентныхОпераций.ЗакрытиеСчетов90_91,
		Перечисления.ВидыСостоянийРегламентныхОпераций.Выполнено));
	Возврат Месяц;

КонецФункции

Функция НовыйЭлемент(ИмяСправочника, Владелец = Неопределено)

	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Заполнить(Неопределено);
	Элемент.Наименование = "Тест закрытия месяца";
	Если Владелец <> Неопределено Тогда
		Элемент.Владелец = Владелец;
	КонецЕсли;
	Элемент.ОбменДанными.Загрузка = Истина;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

// Непроведенный документ с проводками при проведении, записанный без обработчиков БП.
//
// Параметры:
//  ИмяДокумента - Строка - Имя документа в метаданных: АвансовыйОтчет, ПриходныйКассовыйОрдер.
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
//  Реквизиты - Структура, Неопределено - Другие реквизиты: ФизЛицо, ПометкаУдаления.
//
// Возвращаемое значение:
//  ДокументСсылка
Функция НовыйДокумент(ИмяДокумента, Организация, Дата, Реквизиты = Неопределено)

	Документ = Документы[ИмяДокумента].СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = Дата;
	Документ.Организация = Организация;
	Если Реквизиты <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Документ, Реквизиты);
	КонецЕсли;
	Документ.УстановитьНовыйНомер();
	Документ.ОбменДанными.Загрузка = Истина;
	Документ.Записать();
	Возврат Документ.Ссылка;

КонецФункции

// Предупреждение синхронизации БСП «документ не проведен при загрузке».
//
// Параметры:
//  Объект - ДокументСсылка
//  ДатаДокумента - Дата
//  Причина - Строка
Процедура ЗаписатьОшибкуОбмена(Объект, ДатаДокумента, Причина)

	Набор = РегистрыСведений.РезультатыОбменаДанными.СоздатьНаборЗаписей();
	Набор.Отбор.ПроблемныйОбъект.Установить(Объект);
	Запись = Набор.Добавить();
	Запись.ПроблемныйОбъект = Объект;
	Запись.ТипПроблемы = Перечисления.ТипыПроблемОбменаДанными.НепроведенныйДокумент;
	Запись.Причина = Причина;
	Запись.ДатаДокумента = ДатаДокумента;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

КонецПроцедуры

#КонецОбласти

#Область Ответ

Функция Находка(Ответ, Код)

	Для Каждого Находка Из Ответ.problems Цикл
		Если Находка.code = Код Тогда
			Возврат Находка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Нет находки %1", Код);

КонецФункции

Функция Количество(Ответ, Код)

	Для Каждого Находка Из Ответ.problems Цикл
		Если Находка.code = Код Тогда
			Возврат Находка.count;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;

КонецФункции

// Первый элемент находки, у которого в поле есть ссылка. Элементы без поля пропускаются: у строки затрат без
// подразделения нет department.
//
// Параметры:
//  Элементы - Массив из Структура - items находки.
//  Поле - Строка - Поле элемента: ссылка или массив ссылок в виде для модели.
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Структура
Функция ЭлементСоСсылкой(Элементы, Поле, Ссылка)

	Идентификатор = ИИО_Ответ.СсылкаВСтроку(Ссылка);
	Для Каждого Элемент Из Элементы Цикл
		Значение = Неопределено;
		Если Не Элемент.Свойство(Поле, Значение) Тогда
			Продолжить;
		ИначеЕсли ТипЗнч(Значение) <> Тип("Массив") Тогда
			Значение = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение);
		КонецЕсли;
		Если Ссылки(Значение).Найти(Идентификатор) <> Неопределено Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Нет элемента с %1 в поле %2: %3", Идентификатор, Поле,
		Лев(ИИО_ОтветКлиентСервер.ВJSON(Элементы), 1000));

КонецФункции

// Значения поля у элементов массива: коды проверок, счета находок, инструменты кнопок.
//
// Параметры:
//  Элементы - Массив из Структура
//  Поле - Строка
//
// Возвращаемое значение:
//  Массив
Функция Значения(Элементы, Поле)

	Результат = Новый Массив;
	Для Каждого Элемент Из Элементы Цикл
		Результат.Добавить(Элемент[Поле]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Ссылки(Объекты)

	Результат = Новый Массив;
	Для Каждого Объект Из Объекты Цикл
		Результат.Добавить(ИИО_Ответ.ИдентификаторСсылки(Объект));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Кнопка(Кнопки, Инструмент)

	Для Каждого Кнопка Из Кнопки Цикл
		Если Кнопка.Инструмент = Инструмент Тогда
			Возврат Кнопка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Нет кнопки %1", Инструмент);

КонецФункции

