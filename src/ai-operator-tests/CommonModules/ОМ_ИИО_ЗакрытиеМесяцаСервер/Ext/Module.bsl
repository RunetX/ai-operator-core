	Константы.ОтключитьКонтрольОтрицательныхОстатков.Установить(Истина);
	ЮТест.ОжидаетЧто(Находка(Проверить(Организация, Месяц, 50), "NEGATIVE_STOCK").allow_negative_stock).ЭтоИстина();

КонецПроцедуры

