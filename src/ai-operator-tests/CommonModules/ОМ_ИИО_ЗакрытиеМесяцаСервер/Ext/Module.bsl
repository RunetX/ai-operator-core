// Роли счетов, как их читает закрытие БП: строка «Плана счетов» без роли оставляет роль по умолчанию - 25
// распределяется, а без своих правил - по основному набору (правила первого счета, 20.01); другая роль у 25
// распределение снимает. С 2021 года (ФСБУ 5) 26 с ролью «Косвенные затраты» базовая БП закрывает целиком: остаток без
// данных баз - не «нет базы», распределение не показывается; в месяце демо-данных до 2021 года - распределяется.
Процедура РолиСчетовКакВЗакрытииБП() Экспорт

	Организация = ОрганизацияСПроводками();
	Выручка = Строка(Перечисления.БазыРаспределенияКосвенныхРасходов.Выручка);
	ДемоМесяц = МесяцыОрганизации().СЗакрытием;
	Месяц = ЗакрытыйПустойМесяц(Организация, '20250101');
	Дата = КонецМесяца(Месяц);
	Политика = НоваяПолитика();
	Политика.Распределение.Добавить(НовоеПравило("РасходыНаПродажу", "ОплатаТруда"));
	Политика.Распределение.Добавить(НовоеПравило("ОсновноеПроизводство", "Выручка"));
	Политика.Роли.Вставить("ОбщепроизводственныеРасходы", "");
	Политика.Роли.Вставить("ОбщехозяйственныеРасходы", "КосвенныеЗатраты");
	УстановитьПолитику(Организация, Дата, Политика);
	Цех = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	НоваяПроводка(Организация, Дата, Сторона("ОбщепроизводственныеРасходы", , Цех), Сторона("РасчетныеСчета"), 1000000);
	Управление = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Управление), Сторона("РасчетныеСчета"),
		1000000);

	Элементы = Находка(Проверить(Организация, Месяц, 50), "COST_BALANCES").items;

	Остаток = ЭлементСоСсылкой(Элементы, "department", Цех);
	ЮТест.ОжидаетЧто(Остаток.reason).Равно("NO_BASE");
	ЮТест.ОжидаетЧто(Остаток.policy.distributed).ЭтоИстина();
	ЮТест.ОжидаетЧто(Остаток.policy.allocation).ИмеетДлину(1).Содержит(Выручка);
	Остаток = ЭлементСоСсылкой(Элементы, "department", Управление);
	ЮТест.ОжидаетЧто(Остаток.reason).Равно("unknown");
	ЮТест.ОжидаетЧто(Остаток).НеИмеетСвойства("policy");
	Политика.Роли.Вставить("ОбщепроизводственныеРасходы", "УправленческиеРасходы");
	УстановитьПолитику(Организация, Дата, Политика);
	Остаток = ЭлементСоСсылкой(Находка(Проверить(Организация, Месяц, 50), "COST_BALANCES").items, "department", Цех);
	ЮТест.ОжидаетЧто(Остаток.reason).Равно("unknown");
	ЮТест.ОжидаетЧто(Остаток.policy.distributed).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Остаток.policy).НеИмеетСвойства("allocation");

	// До 2021 года (ПБУ 5) роль «Косвенные затраты» у 26 действует: распределяется по основному набору.
	УстановитьПолитику(Организация, ДемоМесяц, Политика);
	НоваяПроводка(Организация, КонецМесяца(ДемоМесяц), Сторона("ОбщехозяйственныеРасходы", , Управление),
		Сторона("РасчетныеСчета"), 1000000);
	Остаток = ЭлементСоСсылкой(Находка(Проверить(Организация, ДемоМесяц, 50), "COST_BALANCES").items, "department",
		Управление);
	ЮТест.ОжидаетЧто(Остаток.policy.distributed).ЭтоИстина();
	ЮТест.ОжидаетЧто(Остаток.policy.allocation).ИмеетДлину(1).Содержит(Выручка);

КонецПроцедуры

// Товар уходил в минус по количеству дважды: ответ - последний раз, после которого минус остался, и поступления
// после него, а не до. Сумма товара в минус второй раз не уходит: минус по количеству ищется по количеству.
// Минус только по сумме ищется по сумме; минус с прошлого месяца - с поступлением в месяце и без движений.
Процедура МинусРасшифровываетсяДоДокумента() Экспорт

	Организация = ОрганизацияСПроводками();
	Месяц = НачалоМесяца(ПоследняяПроводка(Организация));
	День = 86400;
	Товар = НовыйЭлемент("Номенклатура");
	НоваяПроводка(Организация, Месяц + 9 * День, Сторона("РасчетныеСчета"), Склад(Товар), 3000000, 3);
	Раннее = НоваяПроводка(Организация, Месяц + 14 * День, Склад(Товар), Сторона("РасчетныеСчета"), 5000000, 0, 5);
	Списание = НоваяПроводка(Организация, Месяц + 17 * День, Сторона("РасчетныеСчета"), Склад(Товар), 1000000, 4);
	Позднее = НоваяПроводка(Организация, Месяц + 19 * День, Склад(Товар), Сторона("РасчетныеСчета"), 1000000, 0, 1);
	ПоСумме = НовыйЭлемент("Номенклатура");
	СписаниеСуммы = НоваяПроводка(Организация, Месяц + 11 * День, Сторона("РасчетныеСчета"), Склад(ПоСумме), 1000000);
	СПоступлением = НовыйЭлемент("Номенклатура");
	НоваяПроводка(Организация, Месяц - День, Сторона("РасчетныеСчета"), Склад(СПоступлением), 2000000, 2);
	НоваяПроводка(Организация, Месяц + 19 * День, Склад(СПоступлением), Сторона("РасчетныеСчета"), 1000000, 0, 1);
	БезДвижений = НовыйЭлемент("Номенклатура");
	НоваяПроводка(Организация, Месяц - День, Сторона("РасчетныеСчета"), Склад(БезДвижений), 2000000, 2);

	Элементы = Находка(Проверить(Организация, Месяц, 50), "NEGATIVE_STOCK").items;

	Минус = ЭлементСоСсылкой(Элементы, "analytics", Товар);
	ЮТест.ОжидаетЧто(ИИО_Ответ.ИдентификаторСсылки(Минус.went_negative)).Равно(ИИО_Ответ.СсылкаВСтроку(Списание));
	ЮТест.ОжидаетЧто(Ссылки(Минус.receipts_after)).Содержит(ИИО_Ответ.СсылкаВСтроку(Позднее))
		.НеСодержит(ИИО_Ответ.СсылкаВСтроку(Раннее));
	ЮТест.ОжидаетЧто(Минус).НеИмеетСвойства("negative_before_month");
	Минус = ЭлементСоСсылкой(Элементы, "analytics", ПоСумме);
	ЮТест.ОжидаетЧто(ИИО_Ответ.ИдентификаторСсылки(Минус.went_negative))
		.Равно(ИИО_Ответ.СсылкаВСтроку(СписаниеСуммы));
	Минус = ЭлементСоСсылкой(Элементы, "analytics", СПоступлением);
	ЮТест.ОжидаетЧто(Минус.negative_before_month).ЭтоИстина();
	ЮТест.ОжидаетЧто(Минус).НеИмеетСвойства("went_negative");
	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "analytics", БезДвижений).negative_before_month).ЭтоИстина();

КонецПроцедуры

// Поступлений после ухода в минус не больше пяти; признак «списание без остатков разрешено» - из константы.
