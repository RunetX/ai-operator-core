// Аргументы инструмента, как их передает модель.
//
// Параметры:
//  Организация - ЛюбаяСсылка
//  Месяц - Дата, Строка, Неопределено - Дата - любой день месяца; строка передается как есть.
//  Лимит - Число, Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Аргументы(Организация, Месяц, Лимит)

	Аргументы = Новый Структура("organization", ИИО_Ответ.СсылкаВСтроку(Организация));
	Если ТипЗнч(Месяц) = Тип("Дата") Тогда
		Аргументы.Вставить("month", Формат(Месяц, "ДФ=yyyy-MM"));
	ИначеЕсли Месяц <> Неопределено Тогда
		Аргументы.Вставить("month", Месяц);
	КонецЕсли;
	Если Лимит <> Неопределено Тогда
		Аргументы.Вставить("limit", Лимит);
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

// Документ с НДС в проводках находится проверкой, когда со счета-фактуры на него снята связь: счет-фактура удален.
//
// Параметры:
//  Код - Строка - Код проверки.
//  ИмяДокумента - см. ДокументСоСчетомФактурой.ИмяДокумента
//  ИмяСчетаФактуры - см. ДокументСоСчетомФактурой.ИмяСчетаФактуры
//  ПолеСчета - см. ДокументСоСчетомФактурой.ПолеСчета
//  ИмяСчета - см. ДокументСоСчетомФактурой.ИмяСчета
Процедура ДокументБезСчетаФактурыНаходится(Код, ИмяДокумента, ИмяСчетаФактуры, ПолеСчета, ИмяСчета)

	Пара = ДокументСоСчетомФактурой(ИмяДокумента, ИмяСчетаФактуры, ПолеСчета, ИмяСчета);
	Было = Количество(Проверить(Пара.Организация, Пара.Дата), Код);

	СчетФактура = Пара.СчетФактура.ПолучитьОбъект();
	СчетФактура.ОбменДанными.Загрузка = Истина;
	СчетФактура.Удалить();
	Ответ = Проверить(Пара.Организация, Пара.Дата);

	Находка = Находка(Ответ, Код);
	ЮТест.ОжидаетЧто(Находка.count > Было).ЭтоИстина();
	ЮТест.ОжидаетЧто(Находка.amount).Заполнено();
	ЮТест.ОжидаетЧто(Находка.text).Содержит("счета-фактуры");

КонецПроцедуры

