// Организация с наибольшим числом проводок в демо-базе.
//
// Возвращаемое значение:
//  СправочникСсылка.Организации
Функция ОрганизацияСПроводками()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Проводки.Организация КАК Организация,
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
		|
		|СГРУППИРОВАТЬ ПО
		|	Проводки.Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Количество УБЫВ");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Организация;

КонецФункции

Функция ДругаяОрганизация(Организация)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
