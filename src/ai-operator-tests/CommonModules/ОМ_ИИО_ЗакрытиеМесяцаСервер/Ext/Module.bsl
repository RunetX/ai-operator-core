Процедура ПроведениеБезРазрешенияНеПредлагается() Экспорт

	Организация = ОрганизацияСПроводками();
	Месяц = ПоследняяПроводка(Организация);
	ОМ_ИИО_ДействияСервер.УстановитьРазрешение(Пользователи.АвторизованныйПользователь(), "post", Ложь);
	Ссылка = ИИО_Ответ.СсылкаВСтроку(НовыйДокумент("АвансовыйОтчет", Организация, КонецМесяца(Месяц)));
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	Ответ = ВызватьВБоте(Организация, Месяц, Контекст);

	ЮТест.ОжидаетЧто(Ссылки(Находка(Ответ, "UNPOSTED_DOCUMENTS").items)).Содержит(Ссылка);
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("actions");
	// Причина точная: запрет в настройках ИИ-оператора, а не «или нет права».
	ЮТест.ОжидаетЧто(Ответ.action_denied).Содержит("в настройках ИИ-оператора").НеСодержит("нет права");
