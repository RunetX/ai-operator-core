	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", ПоБазам.ОбъемВыпуска).reason).Равно("NO_BASE");
	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", ПоБазам.ПлановаяСебестоимость).reason).Равно("NO_BASE");
