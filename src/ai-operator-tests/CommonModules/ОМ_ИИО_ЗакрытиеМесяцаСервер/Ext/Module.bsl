// Тесты month_close_check. Данные - демо-база БП: организация с наибольшим числом проводок, ее месяцы
// с закрытием и без него. Изменения данных - только в транзакции теста: проводки пишутся документом «Операция»
// в режиме загрузки, без обработчиков БП.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Проверка закрытия месяца")
		.ДобавитьТест("ИнструментЕстьТолькоВБП")
		.ДобавитьТест("БезОрганизацииПереспрашивает")
		.ДобавитьТест("НеОрганизацияИНеМесяцДаютОшибку")
		.ДобавитьТест("МесяцБезПроводокНеСчитаетсяЗакрытым")
		.ДобавитьТест("БезМесяцаБеретсяМесяцПоследнейПроводки").ВТранзакции()
		.ДобавитьТест("ДоЗакрытияОстаткиЗатратНеПроверяются")
		.ДобавитьТест("ПослеЗакрытияПроверяютсяОстаткиЗатрат").ВТранзакции()
		.ДобавитьТест("ОстатокЗатратРасшифровываетсяДоДокументаИПричины").ВТранзакции()
		.ДобавитьТест("НетБазыПроверяетсяПоДаннымМесяца").ВТранзакции()
		.ДобавитьТест("РолиСчетовКакВЗакрытииБП").ВТранзакции()
		.ДобавитьТест("МинусРасшифровываетсяДоДокумента").ВТранзакции()
		.ДобавитьТест("МинусПоказываетПоступленияИРазрешениеСписания").ВТранзакции()
		.ДобавитьТест("РазрешениеСписанияТолькоПриМинусах").ВТранзакции()
		.ДобавитьТест("СуммаБезКоличестваНаходится").ВТранзакции()
		.ДобавитьТест("ПродукцияПриНЗППоИнвентаризацииНаходится").ВТранзакции()
		.ДобавитьТест("НепроведенныйДокументПредлагаетсяПровести").ВТранзакции()
		.ДобавитьТест("ПроведениеБезРазрешенияНеПредлагается").ВТранзакции()
		.ДобавитьТест("ПроводятсяТолькоВидыСПравом").ВТранзакции()
		.ДобавитьТест("РеализацияБезСчетаФактурыНаходится").ВТранзакции()
		.ДобавитьТест("ПоступлениеБезСчетаФактурыНаходится").ВТранзакции()
		.ДобавитьТест("НезачтенныеАвансыНаходятся").ВТранзакции()
		.ДобавитьТест("МинусыИНДСНа19Находятся").ВТранзакции()
		.ДобавитьТест("НеПроведенноеОбменомСводитсяПоПричинеБезПДн").ВТранзакции()
		.ДобавитьТест("БезСчетаПроверкиИнструментСообщаетОбОшибке").ВТранзакции();

КонецПроцедуры

#Область Тесты

Процедура ИнструментЕстьТолькоВБП() Экспорт

	ЮТест.ОжидаетЧто(ИИО_ЗакрытиеМесяца.Поддерживается()).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_РеестрИнструментов.НовыйКонтекстВызова().Инструменты.Получить("month_close_check"))
		.Заполнено();
	// Без признака БП инструмента в определениях нет: так его не видят УТ и ЗУП.
	Для Каждого Определение Из ИИО_ИнструментыКлиентСервер.Определения() Цикл
		ЮТест.ОжидаетЧто(Определение.Имя).НеРавно("month_close_check");
	КонецЦикла;

КонецПроцедуры

Процедура БезОрганизацииПереспрашивает() Экспорт

	Ответ = ИИО_ЗакрытиеМесяца.Проверить(Новый Структура);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("AMBIGUOUS");
	ЮТест.ОжидаетЧто(Ответ.error.candidates.Количество() > 1).ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.error.candidates[0].ref).Содержит("Справочник.Организации:");

КонецПроцедуры

Процедура НеОрганизацияИНеМесяцДаютОшибку() Экспорт

	Контрагенты = Справочники.Контрагенты.Выбрать();
	Контрагенты.Следующий();

	НеОрганизация = Проверить(Контрагенты.Ссылка);
	НеМесяц = Проверить(ОрганизацияСПроводками(), "март 2016");

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(НеОрганизация)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(НеМесяц)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(НеМесяц.error.hint).Содержит("ГГГГ-ММ");

КонецПроцедуры

Процедура МесяцБезПроводокНеСчитаетсяЗакрытым() Экспорт

	Организация = ОрганизацияСПроводками();
	// До первой проводки базы и после последней проводки организации: проверять нечего, но это не «закрыто».
	Ответ = Проверить(Организация, "2001-01");
	ПослеГраницы = Проверить(Организация, ДобавитьМесяц(ПоследняяПроводка(Организация), 1));

	ЮТест.ОжидаетЧто(Ответ.result).Равно("no_data");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("passed");
	ЮТест.ОжидаетЧто(Ответ.last_entry).Заполнено();
	ЮТест.ОжидаетЧто(ПослеГраницы.result).Равно("no_data");

КонецПроцедуры

Процедура БезМесяцаБеретсяМесяцПоследнейПроводки() Экспорт

	Организация = ОрганизацияСПроводками();
	Последняя = ПоследняяПроводка(Организация);
	// Проводка другой организации позже: граница данных проверяемой организации от нее не сдвигается.
	НоваяПроводка(ДругаяОрганизация(Организация), ДобавитьМесяц(Последняя, 2), Сторона("РасчетныеСчета"),
		Сторона("РасчетыСПокупателями"), 1);

	Ответ = Проверить(Организация);

	ЮТест.ОжидаетЧто(Лев(Ответ.last_entry, 10)).Равно(Формат(Последняя, "ДФ=yyyy-MM-dd"));
	ЮТест.ОжидаетЧто(Ответ.month).Равно(Формат(Последняя, "ДФ=yyyy-MM"));
	ЮТест.ОжидаетЧто(Ответ.result).НеРавно("no_data");

КонецПроцедуры

Процедура ДоЗакрытияОстаткиЗатратНеПроверяются() Экспорт

	Месяцы = МесяцыОрганизации();
	Ответ = Проверить(Месяцы.Организация, Месяцы.БезЗакрытия);

	ЮТест.ОжидаетЧто(Значения(Ответ.problems, "code")).Содержит("CLOSING_NOT_DONE");
	ЮТест.ОжидаетЧто(Значения(Ответ.skipped, "code")).Содержит("COST_BALANCES").Содержит("BALANCE_90_91");
	// Ответ компактный: коды, числа и до limit объектов в каждой проверке.
	ЮТест.ОжидаетЧто(СтрДлина(ИИО_ОтветКлиентСервер.ВJSON(Ответ)) < 12000).ЭтоИстина();

КонецПроцедуры

Процедура ПослеЗакрытияПроверяютсяОстаткиЗатрат() Экспорт

	Месяцы = МесяцыОрганизации();
	Дата = КонецМесяца(Месяцы.СЗакрытием);
	// Статьи затрат на 26 ведутся только оборотами: проводку в остатках видно по подразделению.
	Подразделение = НовыйЭлемент("ПодразделенияОрганизаций", Месяцы.Организация);
	НоваяПроводка(Месяцы.Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Подразделение),
		Сторона("РасчетныеСчета"), 3000000);
	НоваяПроводка(Месяцы.Организация, Дата, Сторона("РасчетныеСчета"), Сторона("ПрочиеДоходы"), 2000000);

	Ответ = Проверить(Месяцы.Организация, Месяцы.СЗакрытием, 50);

	ЮТест.ОжидаетЧто(Ответ.passed).Содержит("CLOSING_NOT_DONE");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("skipped");
	Затраты = ЭлементСоСсылкой(Находка(Ответ, "COST_BALANCES").items, "department", Подразделение);
	ЮТест.ОжидаетЧто(СокрЛП(Затраты.account)).Равно("26");
	ЮТест.ОжидаетЧто(Затраты.amount).Равно(3000000);
	ЮТест.ОжидаетЧто(Значения(Находка(Ответ, "BALANCE_90_91").items, "account")).Содержит("91");

КонецПроцедуры

// Причины остатка - по оборотам строки за месяц: проводки после закрытия видны как остаток, который закрытие не
// списало, частично, полностью или с лишком; проводка прошлого месяца - как остаток без оборотов месяца.
Процедура ОстатокЗатратРасшифровываетсяДоДокументаИПричины() Экспорт

	Месяцы = МесяцыОрганизации();
	Организация = Месяцы.Организация;
	Дата = КонецМесяца(Месяцы.СЗакрытием);
	// Роль 26 по умолчанию - управленческие расходы: счет закрывается целиком, остаток базой не объяснить.
	УстановитьПолитику(Организация, Дата, НоваяПолитика());
	Несписанное = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	Затраты = НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Несписанное),
		Сторона("РасчетныеСчета"), 3000000);
	// Документов в строке не больше пяти, крупные первыми.
	Для Номер = 1 По 5 Цикл
		НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Несписанное), Сторона("РасчетныеСчета"),
			Номер);
	КонецЦикла;
	Частичное = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Частичное), Сторона("РасчетныеСчета"),
		2000000);
	НоваяПроводка(Организация, Дата, Сторона("РасчетныеСчета"), Сторона("ОбщехозяйственныеРасходы", , Частичное),
		500000);
	БезПодразделения = НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы"),
		Сторона("РасчетныеСчета"), 4000000);
	СПрошлогоМесяца = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	НоваяПроводка(Организация, Месяцы.СЗакрытием - 1, Сторона("ОбщехозяйственныеРасходы", , СПрошлогоМесяца),
		Сторона("РасчетныеСчета"), 2500000);
	Перерасход = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	НоваяПроводка(Организация, Дата, Сторона("ОбщехозяйственныеРасходы", , Перерасход), Сторона("РасчетныеСчета"),
		100000);
	Лишнее = НоваяПроводка(Организация, Дата, Сторона("РасчетныеСчета"),
		Сторона("ОбщехозяйственныеРасходы", , Перерасход), 110000);

	Элементы = Находка(Проверить(Организация, Месяцы.СЗакрытием, 50), "COST_BALANCES").items;

	Строка = ЭлементСоСсылкой(Элементы, "department", Несписанное);
	ЮТест.ОжидаетЧто(Строка.reason).Равно("unknown");
	ЮТест.ОжидаетЧто(Строка.policy.distributed).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Строка.policy).НеИмеетСвойства("allocation");
	ЮТест.ОжидаетЧто(Строка.documents.Количество()).Равно(5);
	ЮТест.ОжидаетЧто(Ссылки(Строка.documents)[0]).Равно(ИИО_Ответ.СсылкаВСтроку(Затраты));
	// Кредитовый остаток объясняют документы с Кт.
	Строка = ЭлементСоСсылкой(Элементы, "department", Перерасход);
	ЮТест.ОжидаетЧто(Строка.reason).Равно("OVER_WRITTEN_OFF");
	ЮТест.ОжидаетЧто(Ссылки(Строка.documents)[0]).Равно(ИИО_Ответ.СсылкаВСтроку(Лишнее));
	Строка = ЭлементСоСсылкой(Элементы, "department", Частичное);
	ЮТест.ОжидаетЧто(Строка.reason).Равно("PARTLY_WRITTEN_OFF");
	Строка = ЭлементСоСсылкой(Элементы, "documents", БезПодразделения);
	ЮТест.ОжидаетЧто(Строка.reason).Равно("NO_DEPARTMENT");
	ЮТест.ОжидаетЧто(Строка).НеИмеетСвойства("department");
	Строка = ЭлементСоСсылкой(Элементы, "department", СПрошлогоМесяца);
	ЮТест.ОжидаетЧто(Строка.reason).Равно("FROM_PREVIOUS_MONTHS");
	ЮТест.ОжидаетЧто(Строка.documents).ИмеетДлину(0);
	// С limit меньше пяти документов в строке не больше limit.
	Элементы = Находка(Проверить(Организация, Месяцы.СЗакрытием, 2), "COST_BALANCES").items;
	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", Несписанное).documents).ИмеетДлину(2);

КонецПроцедуры

// Нет базы - по данным месяца после закрытия, по правилам учетной политики, как их применяет БП: у 25 - правило
// своего подразделения вместо общего, правила чужого филиала и отдельных статей не действуют; у 20 - выручка по
// номенклатурной группе строки. Данные баз появляются по одной: прямые затраты, выручка, выпуск. Месяц пустой: в нем
// только проводки теста.
Процедура НетБазыПроверяетсяПоДаннымМесяца() Экспорт

	Организация = ОрганизацияСПроводками();
	Месяц = ЗакрытыйПустойМесяц(Организация);
	Дата = КонецМесяца(Месяц);
	Политика = НоваяПолитика();
	ПоБазам = Новый Структура;
	ИменаБаз = "Выручка,ВыручкаОтРеализацииУслуг,ОбъемВыпуска,ПлановаяСебестоимость,ОплатаТруда";
	Для Каждого База Из СтрРазделить(ИменаБаз, ",") Цикл
		ПоБазам.Вставить(База, НовыйЭлемент("ПодразделенияОрганизаций", Организация));
		Политика.Распределение.Добавить(НовоеПравило("ОбщепроизводственныеРасходы", База, ПоБазам[База]));
	КонецЦикла;
	Политика.Распределение.Добавить(НовоеПравило("ОбщепроизводственныеРасходы", "ПрямыеЗатраты"));
	ВФилиале = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	Политика.Распределение.Добавить(НовоеПравило("ОбщепроизводственныеРасходы", "ОплатаТруда", ВФилиале,
		ДругаяОрганизация(Организация)));
	СвойФилиал = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	Политика.Распределение.Добавить(НовоеПравило("ОбщепроизводственныеРасходы", "Выручка", СвойФилиал, Организация));
	ПоСтатье = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	Политика.Распределение.Добавить(НовоеПравило("ОбщепроизводственныеРасходы", "ОплатаТруда", ПоСтатье, ,
		НовыйЭлемент("СтатьиЗатрат")));
	// Правило счета-группы 20 действует на субсчет 20.01.
	Политика.НЗП.Вставить("ОсновноеПроизводство_", "ВедетсяБезИнвентаризации");
	УстановитьПолитику(Организация, Дата, Политика);
	Общее = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	Подразделения = Новый Массив;
	Для Каждого База Из ПоБазам Цикл
		Подразделения.Добавить(База.Значение);
	КонецЦикла;
	Подразделения.Добавить(Общее);
	Подразделения.Добавить(ВФилиале);
	Подразделения.Добавить(СвойФилиал);
	Подразделения.Добавить(ПоСтатье);
	Для Каждого Подразделение Из Подразделения Цикл
		НоваяПроводка(Организация, Дата, Сторона("ОбщепроизводственныеРасходы", , Подразделение),
			Сторона("РасчетныеСчета"), 1000000);
	КонецЦикла;
	ПрямыеЗатраты = Строка(Перечисления.БазыРаспределенияКосвенныхРасходов.ПрямыеЗатраты);
	Выручка = Строка(Перечисления.БазыРаспределенияКосвенныхРасходов.Выручка);

	Элементы = Находка(Проверить(Организация, Месяц, 50), "COST_BALANCES").items;

	Для Каждого Подразделение Из Подразделения Цикл
		ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", Подразделение).reason)
			.Равно(?(Подразделение = ПоБазам.ОплатаТруда, "unknown", "NO_BASE"));
	КонецЦикла;
	// Правило своего подразделения заменяет общее, и с филиалом проверяемой организации тоже; у остальных - общее,
	// правила чужого филиала и статьи не действуют.
	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", ПоБазам.Выручка).policy.allocation)
		.ИмеетДлину(1).Содержит(Выручка);
	ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", СвойФилиал).policy.allocation)
		.ИмеетДлину(1).Содержит(Выручка);
	Для Каждого Подразделение Из Подразделения Цикл
		Если Подразделение = Общее Или Подразделение = ВФилиале Или Подразделение = ПоСтатье Тогда
			ЮТест.ОжидаетЧто(ЭлементСоСсылкой(Элементы, "department", Подразделение).policy.allocation)
				.ИмеетДлину(1).Содержит(ПрямыеЗатраты);
		КонецЕсли;
	КонецЦикла;

	// Появились прямые затраты: база есть только у общего правила; у 20 без выручки по группе базы нет.
	Цех = НовыйЭлемент("ПодразделенияОрганизаций", Организация);
	БезВыручки = НовыйЭлемент("НоменклатурныеГруппы");
	НоваяПроводка(Организация, Дата, СторонаПроизводства(БезВыручки, Цех), Сторона("РасчетныеСчета"), 2000000);
	Элементы = Находка(Проверить(Организация, Месяц, 50), "COST_BALANCES").items;
