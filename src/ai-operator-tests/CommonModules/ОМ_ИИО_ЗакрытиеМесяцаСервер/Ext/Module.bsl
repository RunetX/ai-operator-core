// Дата последней проводки организации - запросом теста, независимо от инструмента.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//
// Возвращаемое значение:
//  Дата
Функция ПоследняяПроводка(Организация)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	МАКСИМУМ(Проводки.Период) КАК Период
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
		|ГДЕ
		|	Проводки.Организация = &Организация");
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Период;

КонецФункции

// Месяцы организации с проводками: последний с выполненным закрытием счетов 90, 91 и последний без него.
//
// Возвращаемое значение:
//  Структура:
//   * Организация - СправочникСсылка.Организации
//   * СЗакрытием - Дата - Начало месяца.
//   * БезЗакрытия - Дата - Начало месяца.
Функция МесяцыОрганизации()

	Организация = ОрганизацияСПроводками();
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НАЧАЛОПЕРИОДА(Проводки.Период, МЕСЯЦ) КАК Месяц
		|ПОМЕСТИТЬ Месяцы
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
		|ГДЕ
		|	Проводки.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Месяцы.Месяц КАК Месяц,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Операции.Ссылка ЕСТЬ NULL
		|				ТОГДА ЛОЖЬ
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ) КАК Закрыт
		|ИЗ
		|	Месяцы КАК Месяцы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РегламентнаяОперация КАК Операции
		|		ПО (НАЧАЛОПЕРИОДА(Операции.Дата, МЕСЯЦ) = Месяцы.Месяц)
		|			И (Операции.Организация = &Организация)
		|			И (Операции.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыРегламентныхОпераций.ЗакрытиеСчетов90_91))
		|			И (Операции.Состояние = ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийРегламентныхОпераций.Выполнено))
		|			И (НЕ Операции.ПометкаУдаления)
		|
		|СГРУППИРОВАТЬ ПО
		|	Месяцы.Месяц
		|
		|УПОРЯДОЧИТЬ ПО
		|	Месяц");
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Новый Структура("Организация, СЗакрытием, БезЗакрытия", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат[?(Выборка.Закрыт, "СЗакрытием", "БезЗакрытия")] = Выборка.Месяц;
	КонецЦикла;
	Если Результат.СЗакрытием = Неопределено Или Результат.БезЗакрытия = Неопределено Тогда
		ВызватьИсключение "В демо-базе нет месяцев организации с закрытием и без него";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проведенный документ с НДС в проводках и счетом-фактурой на него.
//
// Параметры:
//  ИмяДокумента - Строка - Реализация или поступление.
//  ИмяСчетаФактуры - Строка - Счет-фактура с табличной частью ДокументыОснования.
//  ПолеСчета - Строка - СчетДт или СчетКт: сторона проводки по счету НДС.
//  ИмяСчета - Строка - Предопределенный счет НДС.
//
// Возвращаемое значение:
//  Структура:
//   * СчетФактура - ДокументСсылка
//   * Организация - СправочникСсылка.Организации
//   * Дата - Дата - Дата документа.
Функция ДокументСоСчетомФактурой(ИмяДокумента, ИмяСчетаФактуры, ПолеСчета, ИмяСчета)

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СчетаФактуры.Ссылка КАК СчетФактура,
	|	СчетаФактуры.Организация КАК Организация,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	&Основания КАК Основания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ &СчетФактура КАК СчетаФактуры
	|		ПО Основания.Ссылка = СчетаФактуры.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ &Документ КАК Документы
	|		ПО Основания.ДокументОснование = Документы.Ссылка
	|ГДЕ
	|	Документы.Проведен
	|	И НЕ СчетаФактуры.ПометкаУдаления
	|	И Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				Проводки.Регистратор КАК Регистратор
	|			ИЗ
	|				РегистрБухгалтерии.Хозрасчетный КАК Проводки
	|			ГДЕ
	|				&ПолеСчета В ИЕРАРХИИ (&Счет))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Основания ", "Документ." + ИмяСчетаФактуры + ".ДокументыОснования ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетФактура ", "Документ." + ИмяСчетаФактуры + " ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Документ ", "Документ." + ИмяДокумента + " ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСчета", "Проводки." + ПолеСчета);
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Хозрасчетный[ИмяСчета]);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("В демо-базе нет счета-фактуры на документ %1 с НДС", ИмяДокумента);
	КонецЕсли;
	Возврат Новый Структура("СчетФактура, Организация, Дата", Выборка.СчетФактура, Выборка.Организация, Выборка.Дата);

КонецФункции

// Физическое лицо из авансовых отчетов демо-базы: подотчетное лицо, а не группа справочника.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.ФизическиеЛица
//   * Наименование - Строка
Функция ПодотчетноеЛицо()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Лица.Ссылка КАК Ссылка,
		|	Лица.Наименование КАК Наименование
		|ИЗ
		|	Документ.АвансовыйОтчет КАК Отчеты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК Лица
		|		ПО Отчеты.ФизЛицо = Лица.Ссылка");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В демо-базе нет авансового отчета с подотчетным лицом";
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Наименование", Выборка.Ссылка, Выборка.Наименование);

КонецФункции

#КонецОбласти

#Область ЗаписьДанных

// Проводка в регистре Хозрасчетный документом «Операция»: он не проводится, проводки пишутся набором записей.
// Документ и набор - в режиме загрузки, обработчики БП не выполняются.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
//  Дт - см. Сторона
//  Кт - см. Сторона
//  Сумма - Число
//  КоличествоКт - Число
//  КоличествоДт - Число
//
// Возвращаемое значение:
//  ДокументСсылка.ОперацияБух
Функция НоваяПроводка(Организация, Дата, Дт, Кт, Сумма, КоличествоКт = 0, КоличествоДт = 0)

	Документ = Документы.ОперацияБух.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = Дата;
	Документ.Организация = Организация;
	Документ.УстановитьНовыйНомер();
	Документ.ОбменДанными.Загрузка = Истина;
	Документ.Записать();
	Набор = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Документ.Ссылка);
	Запись = Набор.Добавить();
	Запись.Период = Дата;
	Запись.Организация = Организация;
	Запись.СчетДт = Дт.Счет;
	Запись.СчетКт = Кт.Счет;
	Запись.ПодразделениеДт = Дт.Подразделение;
	Запись.ПодразделениеКт = Кт.Подразделение;
	Запись.Сумма = Сумма;
	Запись.КоличествоКт = КоличествоКт;
	Запись.КоличествоДт = КоличествоДт;
	Для Каждого Субконто Из Дт.Субконто Цикл
		Запись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[Субконто.Ключ]] = Субконто.Значение;
	КонецЦикла;
	Для Каждого Субконто Из Кт.Субконто Цикл
		Запись.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные[Субконто.Ключ]] = Субконто.Значение;
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	Возврат Документ.Ссылка;

КонецФункции

// Сторона проводки.
//
// Параметры:
//  ИмяСчета - Строка - Предопределенный счет плана счетов Хозрасчетный.
//  Субконто - Структура, Неопределено - Ключ - предопределенный вид субконто, значение - субконто.
//  Подразделение - СправочникСсылка.ПодразделенияОрганизаций, Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * Счет - ПланСчетовСсылка.Хозрасчетный
//   * Субконто - Структура
//   * Подразделение - СправочникСсылка.ПодразделенияОрганизаций
Функция Сторона(ИмяСчета, Субконто = Неопределено, Подразделение = Неопределено)

	Возврат Новый Структура("Счет, Субконто, Подразделение", ПланыСчетов.Хозрасчетный[ИмяСчета],
		?(Субконто = Неопределено, Новый Структура, Субконто),
		?(Подразделение = Неопределено, Справочники.ПодразделенияОрганизаций.ПустаяСсылка(), Подразделение));

КонецФункции

