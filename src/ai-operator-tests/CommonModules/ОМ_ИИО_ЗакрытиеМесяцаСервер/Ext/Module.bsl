// Пользователь проводит только приходные кассовые ордера: авансовый отчет остается в списке, но не предлагается
// к проведению, и ответ называет его вид.
Процедура ПроводятсяТолькоВидыСПравом() Экспорт

	Организация = ОрганизацияСПроводками();
	Месяц = ПоследняяПроводка(Организация);
	ОМ_ИИО_ДействияСервер.РазрешитьДействия();
	Ордер = ИИО_Ответ.СсылкаВСтроку(НовыйДокумент("ПриходныйКассовыйОрдер", Организация, КонецМесяца(Месяц)));
	Отчет = ИИО_Ответ.СсылкаВСтроку(НовыйДокумент("АвансовыйОтчет", Организация, КонецМесяца(Месяц)));
	Кнопки = Новый Массив;

	Ответ = ИИО_ЗакрытиеМесяца.Проверить(Аргументы(Организация, Месяц, 50), Кнопки,
		ОМ_ИИО_ДействияСервер.НовыйПользовательИБПриходныхОрдеров());

	ЮТест.ОжидаетЧто(Ссылки(Находка(Ответ, "UNPOSTED_DOCUMENTS").items)).Содержит(Ордер).Содержит(Отчет);
	ЮТест.ОжидаетЧто(Ссылки(Ответ.actions[0].refs)).Содержит(Ордер).НеСодержит(Отчет);
	ЮТест.ОжидаетЧто(Кнопка(Кнопки, "perform").Аргументы.refs).Содержит(Ордер).НеСодержит(Отчет);
	ЮТест.ОжидаетЧто(Ответ.action_denied).Содержит("нет права «Проведение»")
		.Содержит(Метаданные.Документы.АвансовыйОтчет.Представление())
		.НеСодержит(Метаданные.Документы.ПриходныйКассовыйОрдер.Представление());
	ЮТест.ОжидаетЧто(Ответ.hint).Содержит("action_denied");

