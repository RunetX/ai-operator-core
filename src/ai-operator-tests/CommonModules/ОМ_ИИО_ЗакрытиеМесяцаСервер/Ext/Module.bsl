Процедура НепроведенныйДокументПредлагаетсяПровести() Экспорт

	Организация = ОрганизацияСПроводками();
	Месяц = ПоследняяПроводка(Организация);
	// Канал MCP: кнопок нет, модель сама показывает списки и проводит через perform.
	ВКаналеMCP = Проверить(Организация, Месяц);
	ЮТест.ОжидаетЧто(ВКаналеMCP).НеИмеетСвойства("button");
	ЮТест.ОжидаетЧто(ВКаналеMCP.hint).Содержит("perform").Содержит("action_denied").НеСодержит("не вызывай");
	Было = Количество(ВКаналеMCP, "UNPOSTED_DOCUMENTS");
	ОМ_ИИО_ДействияСервер.РазрешитьДействия();
	Ссылка = ИИО_Ответ.СсылкаВСтроку(НовыйДокумент("АвансовыйОтчет", Организация, КонецМесяца(Месяц)));
	Помеченный = ИИО_Ответ.СсылкаВСтроку(НовыйДокумент("АвансовыйОтчет", Организация, КонецМесяца(Месяц),
		Новый Структура("ПометкаУдаления", Истина)));
	// «Операция» без проведения пишет проводки при записи: непроведенной она не считается.
	Ручная = ИИО_Ответ.СсылкаВСтроку(НоваяПроводка(Организация, КонецМесяца(Месяц), Сторона("РасчетныеСчета"),
		Сторона("РасчетыСПокупателями"), 1));
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	Ответ = ВызватьВБоте(Организация, Месяц, Контекст);

	Находка = Находка(Ответ, "UNPOSTED_DOCUMENTS");
	ЮТест.ОжидаетЧто(Находка.count).Равно(Было + 1);
	ЮТест.ОжидаетЧто(Ссылки(Находка.items)).Содержит(Ссылка).НеСодержит(Помеченный).НеСодержит(Ручная);
	ЮТест.ОжидаетЧто(Ответ.actions[0].action).Равно("post");
	ЮТест.ОжидаетЧто(Ссылки(Ответ.actions[0].refs)).Содержит(Ссылка);
	ЮТест.ОжидаетЧто(Ответ.button).ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.hint).Содержит("не вызывай");
	Предпросмотр = Кнопка(Контекст.Кнопки, "perform");
	ЮТест.ОжидаетЧто(Предпросмотр.Аргументы.action).Равно("post");
	ЮТест.ОжидаетЧто(Предпросмотр.Аргументы.refs).Содержит(Ссылка);
	ЮТест.ОжидаетЧто(Кнопка(Контекст.Кнопки, "show_in_1c").Аргументы.refs).Содержит(Ссылка);

