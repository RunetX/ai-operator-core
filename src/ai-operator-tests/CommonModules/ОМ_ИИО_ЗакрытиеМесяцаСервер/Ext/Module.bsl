Процедура НеПроведенноеОбменомСводитсяПоПричинеБезПДн() Экспорт

	Организация = ОрганизацияСПроводками();
	Дата = КонецМесяца(ПоследняяПроводка(Организация));
	Человек = ПодотчетноеЛицо();
	Причина = "Не удалось провести документ, полученный из другой информационной базы: нет счета расчетов с "
		+ Человек.Наименование + ".";
	Было = Количество(Проверить(Организация, Дата), "EXCHANGE_NOT_POSTED");
	Авансовые = Новый Массив;
	Для Номер = 1 По 2 Цикл
		Авансовые.Добавить(НовыйДокумент("АвансовыйОтчет", Организация, Дата,
			Новый Структура("ФизЛицо", Человек.Ссылка)));
		ЗаписатьОшибкуОбмена(Авансовые[Номер - 1], Дата, Причина);
	КонецЦикла;
	// Документ, который пользователь прочитать не может (здесь - несуществующий), не показывается и не считается.
	ЗаписатьОшибкуОбмена(Документы.АвансовыйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор), Дата, Причина);

	Находка = Находка(Проверить(Организация, Дата), "EXCHANGE_NOT_POSTED");
	ЮТест.ОжидаетЧто(Находка.count).Равно(Было + 2);
	Обмен = ЭлементСоСсылкой(Находка.items, "objects", Авансовые[0]);
	ЮТест.ОжидаетЧто(Обмен.reason).Равно(Причина);
	ЮТест.ОжидаетЧто(Обмен.count).Равно(2);
	ЮТест.ОжидаетЧто(Ссылки(Обмен.objects)).Содержит(ИИО_Ответ.СсылкаВСтроку(Авансовые[1]));
	// Модели уходит причина без ФИО: человек из реквизита документа скрыт токеном.
	Текст = ИИО_ОтветКлиентСервер.ВJSON(ВызватьВБоте(Организация, Дата,
		ИИО_РеестрИнструментов.НовыйКонтекстВызова()));
	ЮТест.ОжидаетЧто(Текст).НеСодержит(Человек.Наименование).Содержит("[ФИО#");

КонецПроцедуры

Процедура БезСчетаПроверкиИнструментСообщаетОбОшибке() Экспорт

	// Счета проверки нет в плане счетов: без ошибки проверка по нему молча прошла бы.
	Счет = ПланыСчетов.Хозрасчетный.ГотоваяПродукция.ПолучитьОбъект();
	Счет.Код = "43.99";
	Счет.ОбменДанными.Загрузка = Истина;
	Счет.Записать();
	Организация = ОрганизацияСПроводками();

	Ответ = ВызватьВБоте(Организация, ПоследняяПроводка(Организация), ИИО_РеестрИнструментов.НовыйКонтекстВызова());

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INTERNAL");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("счетов проверки закрытия месяца");

