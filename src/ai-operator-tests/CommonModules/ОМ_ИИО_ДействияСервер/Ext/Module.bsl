// Тесты действий perform и undo на сервере.
// Опираются на демо-данные БП: меняют только реализации декабря 2016 (после даты запрета 30.06.2016).
// Демо-пользователь полноправный, поэтому запрет изменения на него не действует: тесты не трогают закрытые периоды.
// Тесты выдают текущему пользователю разрешения post и unpost и оставляют их: они нужны стенду для приемки.
// Документы, которые тесты распроводят, в конце теста проводятся обратно.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Права и разрешения")
		.ДобавитьТест("РеестрСодержитПроведениеИОтмену")
		.ДобавитьТест("БезРазрешенияДействиеЗапрещено")
		.ДобавитьТест("РазрешениеЧерезГруппуИЗапретНаПользователя")
		.ДобавитьТест("РазрешенныеДействияОднимЗапросом")
		.ДобавитьТест("БезПраваПлатформыДействиеЗапрещено")
		.ДобавитьТестовыйНабор("План")
		.ДобавитьТест("НеизвестноеДействиеИНеподходящиеОбъектыОтклоняются")
		.ДобавитьТест("ЛимитОбъектовПроверяется")
		.ДобавитьТест("ПробныйЗапускПоказываетИзмененияИНичегоНеМеняет")
		.ДобавитьТест("БлокировкаВиднаВПлане")
		.ДобавитьТестовыйНабор("Подтверждение")
		.ДобавитьТест("БезКлючаПодтвержденияНичегоНеВыполняется")
		.ДобавитьТест("КлючВыдаетсяОдинРаз")
		.ДобавитьТест("ОтменаНичегоНеМеняетИВозвращаетCancelled")
		.ДобавитьТестовыйНабор("Выполнение и откат")
		.ДобавитьТест("ОтменаПроведенияИОткатВозвращаютСостояние")
		.ДобавитьТест("ИзмененныйПослеПакетаОбъектНеОткатывается")
		.ДобавитьТест("ИзмененныйПослеПредпросмотраОбъектНеМеняется");

КонецПроцедуры

#Область Тесты

Процедура РеестрСодержитПроведениеИОтмену() Экспорт

	Действия = ИИО_Действия.Действия();

	ЮТест.ОжидаетЧто(Действия.Получить("post").Право).Равно("Проведение");
	ЮТест.ОжидаетЧто(Действия.Получить("unpost").Право).Равно("ОтменаПроведения");
	ЮТест.ОжидаетЧто(Действия.Получить("delete")).ЭтоНеопределено();

КонецПроцедуры

Процедура БезРазрешенияДействиеЗапрещено() Экспорт

	Действие = ТестовоеДействие();
	УдалитьРазрешения(Действие.Код);

	Ошибка = ИИО_Права.ОшибкаДоступаКДействию(Действие, ВидыРеализаций());

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ошибка)).Равно("ACTION_DENIED");
	ЮТест.ОжидаетЧто(Ошибка.error.message).Содержит("не разрешено");

КонецПроцедуры

Процедура РазрешениеЧерезГруппуИЗапретНаПользователя() Экспорт

	Код = ТестовоеДействие().Код;
	Пользователь = Пользователи.АвторизованныйПользователь();
	Попытка
		УстановитьРазрешение(Пользователи.ГруппаВсеПользователи(), Код, Истина);
		ЮТест.ОжидаетЧто(ИИО_Права.ДействиеРазрешено(Код, Пользователь)).Равно(Истина);

		// Запись на пользователя важнее записи на группу.
		УстановитьРазрешение(Пользователь, Код, Ложь);
		ЮТест.ОжидаетЧто(ИИО_Права.ДействиеРазрешено(Код, Пользователь)).Равно(Ложь);
	Исключение
		УдалитьРазрешения(Код);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьРазрешения(Код);
	ЮТест.ОжидаетЧто(ИИО_Права.ДействиеРазрешено(Код, Пользователь)).Равно(Ложь);

КонецПроцедуры

// Правило то же, что у ДействиеРазрешено: запись на пользователя важнее группы, без записей - запрещено.
Процедура РазрешенныеДействияОднимЗапросом() Экспорт

	Пользователь = Пользователи.АвторизованныйПользователь();
	Коды = Новый Массив;
	Коды.Добавить("test_group");
	Коды.Добавить("test_user_deny");
	Коды.Добавить("test_user_allow");
	Коды.Добавить("test_none");
	Попытка
		УстановитьРазрешение(Пользователи.ГруппаВсеПользователи(), "test_group", Истина);
		УстановитьРазрешение(Пользователи.ГруппаВсеПользователи(), "test_user_deny", Истина);
		УстановитьРазрешение(Пользователь, "test_user_deny", Ложь);
		УстановитьРазрешение(Пользователи.ГруппаВсеПользователи(), "test_user_allow", Ложь);
		УстановитьРазрешение(Пользователь, "test_user_allow", Истина);

		Разрешенные = ИИО_Права.РазрешенныеДействия(Коды, Пользователь);
		ЮТест.ОжидаетЧто(Разрешенные).ИмеетДлину(2);
		ЮТест.ОжидаетЧто(Разрешенные).Содержит("test_group");
		ЮТест.ОжидаетЧто(Разрешенные).Содержит("test_user_allow");
	Исключение
		Для Каждого Код Из Коды Цикл
			УдалитьРазрешения(Код);
		КонецЦикла;
		ВызватьИсключение;
	КонецПопытки;
	Для Каждого Код Из Коды Цикл
		УдалитьРазрешения(Код);
	КонецЦикла;

КонецПроцедуры

Процедура БезПраваПлатформыДействиеЗапрещено() Экспорт

	Действие = ТестовоеДействие();
	Пользователь = Пользователи.АвторизованныйПользователь();
	// Пользователь ИБ только с ролью ИИ-оператора: права «Проведение» на реализации у него нет.
	ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
	ПользовательИБ.Роли.Добавить(Метаданные.Роли.ИИО_ПользовательИИОператора);
	Попытка
		УстановитьРазрешение(Пользователь, Действие.Код, Истина);
		Ошибка = ИИО_Права.ОшибкаДоступаКДействию(Действие, ВидыРеализаций(), Пользователь, ПользовательИБ);
		ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ошибка)).Равно("ACTION_DENIED");
		ЮТест.ОжидаетЧто(Ошибка.error.message).Содержит("нет права «Проведение»");

		// С правом платформы и разрешением ошибки нет.
		ЮТест.ОжидаетЧто(ИИО_Права.ОшибкаДоступаКДействию(Действие, ВидыРеализаций(), Пользователь))
			.ЭтоНеопределено();
	Исключение
		УдалитьРазрешения(Действие.Код);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьРазрешения(Действие.Код);

КонецПроцедуры

Процедура НеизвестноеДействиеИНеподходящиеОбъектыОтклоняются() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();

	Ответ = ИИО_Действия.ПодготовитьДействие(Аргументы("delete", Документ), "test");
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.hint).Содержит("post");

	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Контрагент");
	Ответ = ИИО_Действия.ПодготовитьДействие(Аргументы("post", Контрагент), "test");
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("Справочник.Контрагенты");

	Ответ = ИИО_Действия.ПодготовитьДействие(Новый Структура("action, refs", "post", "Документ.НетТакого:1"), "test");
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INVALID_ARGUMENT");

КонецПроцедуры

Процедура ЛимитОбъектовПроверяется() Экспорт

	РазрешитьДействия();
	Лимит = ИИО_Настройки.Значение("ИИО_ЛимитОбъектовДействия");
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1000 Р.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р");
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Идентификаторы = Новый Массив;
	Для Индекс = 0 По Лимит Цикл
		Идентификаторы.Добавить(ИИО_Ответ.СсылкаВСтроку(Ссылки[Индекс]));
	КонецЦикла;

	Ответ = ИИО_Действия.ПодготовитьДействие(Новый Структура("action, refs, dry_run", "post", Идентификаторы, Истина),
		"test");

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Ответ.error.message).Содержит("не больше " + Формат(Лимит, "ЧГ=0"));

КонецПроцедуры

Процедура ПробныйЗапускПоказываетИзмененияИНичегоНеМеняет() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Версия = ВерсияДанных(Документ);

	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("post", Документ, Истина), "test");
	ЮТест.ОжидаетЧто(Подготовленный.ПробныйЗапуск).Равно(Истина);
	Объект = Подготовленный.Ответ.objects[0];
	ЮТест.ОжидаетЧто(Объект.change).Равно("repost");
	ЮТест.ОжидаетЧто(Объект.reversible).Равно(Ложь);
	ЮТест.ОжидаетЧто(Объект.state.posted).Равно(Истина);

	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ, Истина), "test");
	Объект = Подготовленный.Ответ.objects[0];
	ЮТест.ОжидаетЧто(Объект.change).Равно("unpost");
	ЮТест.ОжидаетЧто(Объект).НеИмеетСвойства("reversible");
	ЮТест.ОжидаетЧто(Подготовленный.Ответ.summary.will_change).Равно(1);

	// Пробный запуск не получает ключа подтверждения, поэтому выполнить его нельзя.
	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(Предпросмотр.Ключ).ЭтоНеопределено();
	ЮТест.ОжидаетЧто(ВыполнениеОтклонено(Предпросмотр.АдресПлана, Новый УникальныйИдентификатор)).Равно(Истина);
	ЮТест.ОжидаетЧто(ВерсияДанных(Документ)).Равно(Версия);

КонецПроцедуры

Процедура БлокировкаВиднаВПлане() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	// Документ открыт и изменяется в другой форме: такая форма держит блокировку со своим идентификатором.
	ВладелецБлокировки = Новый УникальныйИдентификатор;
	ЗаблокироватьДанныеДляРедактирования(Документ, , ВладелецБлокировки);
	Попытка
		Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ, Истина), "test");
	Исключение
		РазблокироватьДанныеДляРедактирования(Документ, ВладелецБлокировки);
		ВызватьИсключение;
	КонецПопытки;
	РазблокироватьДанныеДляРедактирования(Документ, ВладелецБлокировки);

	Объект = Подготовленный.Ответ.objects[0];
	ЮТест.ОжидаетЧто(Объект).ИмеетСвойство("errors");
	ЮТест.ОжидаетЧто(Объект.errors[0]).Содержит("редактируется");
	ЮТест.ОжидаетЧто(Подготовленный.Ответ.summary.with_errors).Равно(1);

КонецПроцедуры

Процедура БезКлючаПодтвержденияНичегоНеВыполняется() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Версия = ВерсияДанных(Документ);

	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ), "test");
	ЮТест.ОжидаетЧто(Подготовленный.ПробныйЗапуск).Равно(Ложь);
	// Предпросмотр еще не открыт: ключа нет ни у кого.
	ЮТест.ОжидаетЧто(ВыполнениеОтклонено(Подготовленный.АдресПлана, Новый УникальныйИдентификатор)).Равно(Истина);

	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);
	ЮТест.ОжидаетЧто(ВыполнениеОтклонено(Предпросмотр.АдресПлана, Новый УникальныйИдентификатор)).Равно(Истина);
	ЮТест.ОжидаетЧто(ВыполнениеОтклонено(Предпросмотр.АдресПлана, Неопределено)).Равно(Истина);
	ЮТест.ОжидаетЧто(ВерсияДанных(Документ)).Равно(Версия);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Проведен")).Равно(Истина);

КонецПроцедуры

Процедура КлючВыдаетсяОдинРаз() Экспорт

	РазрешитьДействия();
	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", ОткрытыйДокумент()), "test");
	ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);

	Отклонено = Ложь;
	Попытка
		ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	ЮТест.ОжидаетЧто(Отклонено).Равно(Истина);

КонецПроцедуры

Процедура ОтменаНичегоНеМеняетИВозвращаетCancelled() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Версия = ВерсияДанных(Документ);
	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ), "test");
	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);

	Ответ = ИИО_Действия.ОтменитьПакет(Предпросмотр.АдресПлана, "user");

	ЮТест.ОжидаетЧто(Ответ.cancelled).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ.reason).Равно("user");
	ЮТест.ОжидаетЧто(Ответ.batch_id).Равно(Подготовленный.Пакет);
	ЮТест.ОжидаетЧто(Ответ.done).ИмеетДлину(0);
	// После отмены пакет не выполняется даже с ключом.
	ЮТест.ОжидаетЧто(ВыполнениеОтклонено(Предпросмотр.АдресПлана, Предпросмотр.Ключ)).Равно(Истина);
	ЮТест.ОжидаетЧто(ВерсияДанных(Документ)).Равно(Версия);
	ЮТест.ОжидаетЧто(ИИО_Журнал.ДанныеОтката(Подготовленный.Пакет)).ИмеетДлину(0);

КонецПроцедуры

Процедура ОтменаПроведенияИОткатВозвращаютСостояние() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Попытка
		Ответ = ВыполнитьПодтвержденное(ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ), "test"));
		ЮТест.ОжидаетЧто(Ответ.done).ИмеетДлину(1);
		ЮТест.ОжидаетЧто(Ответ.done[0].ref).Равно(ИИО_Ответ.СсылкаВСтроку(Документ));
		ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Проведен")).Равно(Ложь);
		Пакет = Ответ.batch_id;

		Данные = ИИО_Журнал.ДанныеОтката(Пакет);
		ЮТест.ОжидаетЧто(Данные).ИмеетДлину(1);
		ЮТест.ОжидаетЧто(Данные[0].Действие).Равно("unpost");
		ЮТест.ОжидаетЧто(Данные[0].СостояниеДо.posted).Равно(Истина);
		ЮТест.ОжидаетЧто(Данные[0].ВерсияДанныхПосле).Равно(ВерсияДанных(Документ));

		Откат = ВыполнитьПодтвержденное(ИИО_Действия.ПодготовитьОткат(Новый Структура("batch_id", Пакет), "test"));
		ЮТест.ОжидаетЧто(Откат.undo_of).Равно(Пакет);
		ЮТест.ОжидаетЧто(Откат.done).ИмеетДлину(1);
	Исключение
		ПровестиОбратно(Документ);
		ВызватьИсключение;
	КонецПопытки;

	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Проведен")).Равно(Истина);
	ЮТест.ОжидаетЧто(ИИО_Журнал.ДанныеОтката(Пакет)[0].ОткаченоПакетом).Равно(Откат.batch_id);

	// Повторно откатить нечего.
	Повтор = ИИО_Действия.ПодготовитьОткат(Новый Структура("batch_id", Пакет), "test");
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Повтор)).Равно("NOT_FOUND");
	ЮТест.ОжидаетЧто(Повтор.error.skipped[0].reason).Содержит("Уже откачено");

	// Пакет и объект видны в журнале операций.
	Пакеты = ИИО_Журнал.ПакетыЗаПериод(НачалоДня(ТекущаяДатаСеанса()), КонецДня(ТекущаяДатаСеанса()), Ложь);
	СтрокаПакета = Пакеты.Найти(Пакет, "Пакет");
	ЮТест.ОжидаетЧто(СтрокаПакета).ЭтоНеНеопределено();
	ЮТест.ОжидаетЧто(СтрокаПакета.Состояние).Равно("undone");
	ЮТест.ОжидаетЧто(СтрокаПакета.Выполнено).Равно(1);
	Объекты = ИИО_Журнал.ОбъектыПакета(Пакет, СтрокаПакета.Дата);
	ЮТест.ОжидаетЧто(Объекты).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Объекты[0].Объект).Равно(Документ);
	ЮТест.ОжидаетЧто(Объекты[0].Результат).Равно("done");

КонецПроцедуры

Процедура ИзмененныйПослеПакетаОбъектНеОткатывается() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Попытка
		Ответ = ВыполнитьПодтвержденное(ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ), "test"));
		ЮТест.ОжидаетЧто(Ответ.done).ИмеетДлину(1);

		// Пользователь изменил документ после пакета: откат затер бы его изменения.
		Объект = Документ.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.Запись);

		Откат = ИИО_Действия.ПодготовитьОткат(Новый Структура("batch_id", Ответ.batch_id), "test");
		ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Откат)).Равно("NOT_FOUND");
		ЮТест.ОжидаетЧто(Откат.error.skipped[0].reason).Содержит("изменен после пакета");
	Исключение
		ПровестиОбратно(Документ);
		ВызватьИсключение;
	КонецПопытки;
	ПровестиОбратно(Документ);

КонецПроцедуры

Процедура ИзмененныйПослеПредпросмотраОбъектНеМеняется() Экспорт

	РазрешитьДействия();
	Документ = ОткрытыйДокумент();
	Подготовленный = ИИО_Действия.ПодготовитьДействие(Аргументы("unpost", Документ), "test");
	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);

	// Пока пользователь смотрел предпросмотр, документ перепровели: подтверждение относилось к другому состоянию.
	Документ.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Версия = ВерсияДанных(Документ);
	ИИО_Действия.ВыполнитьПорцию(Предпросмотр.АдресПлана, Предпросмотр.Ключ, 0, 100);
	Ответ = ИИО_Действия.ЗавершитьПакет(Предпросмотр.АдресПлана, Предпросмотр.Ключ);

	ЮТест.ОжидаетЧто(Ответ.done).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Ответ.failed).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Ответ.failed[0].object.ref).Равно(ИИО_Ответ.СсылкаВСтроку(Документ));
	ЮТест.ОжидаетЧто(Ответ.failed[0].error).Содержит("изменен после предпросмотра");
	ЮТест.ОжидаетЧто(ВерсияДанных(Документ)).Равно(Версия);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Проведен")).Равно(Истина);
	ЮТест.ОжидаетЧто(ИИО_Журнал.ДанныеОтката(Ответ.batch_id)).ИмеетДлину(0);

	// Отказ записан в журнал регистрации вместе с текстом ошибки.
	Объекты = ИИО_Журнал.ОбъектыПакета(Ответ.batch_id, НачалоДня(ТекущаяДатаСеанса()));
	ЮТест.ОжидаетЧто(Объекты).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Объекты[0].Результат).Равно("failed");
	ЮТест.ОжидаетЧто(Объекты[0].Ошибка).Содержит("изменен после предпросмотра");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет подготовленный пакет так же, как форма предпросмотра после нажатия «Выполнить».
// Ошибку подготовки превращает в исключение.
//
// Параметры:
//  Подготовленный - Структура - Ошибка для модели или сведения о пакете, см. ИИО_Действия.ПодготовитьДействие.
//
// Возвращаемое значение:
//  см. ИИО_Действия.ЗавершитьПакет
Функция ВыполнитьПодтвержденное(Подготовленный)

	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		ВызватьИсключение ИИО_ОтветКлиентСервер.ВJSON(Подготовленный);
	КонецЕсли;
	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);
	ИИО_Действия.ВыполнитьПорцию(Предпросмотр.АдресПлана, Предпросмотр.Ключ, 0, 100);
	Возврат ИИО_Действия.ЗавершитьПакет(Предпросмотр.АдресПлана, Предпросмотр.Ключ);

КонецФункции

Функция ВыполнениеОтклонено(АдресПлана, Ключ)

	Попытка
		ИИО_Действия.ВыполнитьПорцию(АдресПлана, Ключ, 0, 100);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

Функция Аргументы(Действие, Ссылка, ПробныйЗапуск = Ложь)

	Возврат Новый Структура("action, refs, dry_run", Действие,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИИО_Ответ.СсылкаВСтроку(Ссылка)), ПробныйЗапуск);

КонецФункции

// Возвращает последнюю проведенную реализацию декабря 2016: период открыт для изменений.
//
// Возвращаемое значение:
//  ДокументСсылка.РеализацияТоваровУслуг
Функция ОткрытыйДокумент()

	Возврат ДокументЗаПериод('20161201', '20161231235959');

КонецФункции

Функция ДокументЗаПериод(Начало, Конец)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Р.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Р
		|ГДЕ
		|	Р.Дата МЕЖДУ &Начало И &Конец
		|	И Р.Проведен
		|	И НЕ Р.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Р.Дата УБЫВ");
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В демо-базе нет проведенной реализации за период";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

Процедура ПровестиОбратно(Документ)

	Объект = Документ.ПолучитьОбъект();
	Если Не Объект.Проведен Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	КонецЕсли;

КонецПроцедуры

Функция ВерсияДанных(Ссылка)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ВерсияДанных");

КонецФункции

Функция ВидыРеализаций()

	Возврат ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Метаданные.Документы.РеализацияТоваровУслуг);

КонецФункции

// Возвращает действие с правом «Проведение» под отдельным кодом: тесты разрешений не трогают настройки
// post и unpost.
//
// Возвращаемое значение:
//  см. ИИО_Действия.НовоеДействие
Функция ТестовоеДействие()

	Возврат ИИО_Действия.НовоеДействие("test_post", "Провести (тест)", "Проведение", "Проведение",
		"ИИО_ДействияПроведение");

КонецФункции

Процедура РазрешитьДействия()

	Пользователь = Пользователи.АвторизованныйПользователь();
	Для Каждого Код Из СтрРазделить("post,unpost", ",") Цикл
		Если Не ИИО_Права.ДействиеРазрешено(Код, Пользователь) Тогда
			УстановитьРазрешение(Пользователь, Код, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьРазрешение(Пользователь, Действие, Разрешено)

	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.Действие = Действие;
	Запись.Разрешено = Разрешено;
	Запись.Записать();

КонецПроцедуры

Процедура УдалитьРазрешения(Действие)

	Набор = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьНаборЗаписей();
	Набор.Отбор.Действие.Установить(Действие);
	Набор.Записать();

КонецПроцедуры

#КонецОбласти
