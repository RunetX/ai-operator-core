// Тесты чтения ошибок пользователя из журнала регистрации для explain_error: берутся события
// уровня «Ошибка» самого пользователя в клиентском сеансе, без событий ИИ-оператора и без повторов.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Ошибки пользователя")
		.ДобавитьТест("ОшибкаПользователяЧитается")
		.ДобавитьТест("СобытияИИОператораИПовторыНеЧитаются")
		.ДобавитьТест("ДоступныйОбъектСобытияУходитСсылкой");

КонецПроцедуры

#Область Тесты

Процедура ОшибкаПользователяЧитается() Экспорт

	Начало = ТекущаяДатаСеанса() - 1;
	Текст = НовыйТекст();
	ЗаписьЖурналаРегистрации("Тест.ОшибкаПользователя", УровеньЖурналаРегистрации.Ошибка, , , Текст);
	ЗаписьЖурналаРегистрации("Тест.Предупреждение", УровеньЖурналаРегистрации.Предупреждение, , , Текст);

	Ошибки = ИИО_Журнал.ОшибкиПользователя(Начало, 5);

	Найденные = Ошибки.НайтиСтроки(Новый Структура("Комментарий", Текст));
	ЮТест.ОжидаетЧто(Найденные.Количество(), "только ошибка, без предупреждения").Равно(1);
	ЮТест.ОжидаетЧто(Найденные[0].Событие).Равно("Тест.ОшибкаПользователя");

КонецПроцедуры

Процедура СобытияИИОператораИПовторыНеЧитаются() Экспорт

	Начало = ТекущаяДатаСеанса() - 1;
	Текст = НовыйТекст();
	ЗаписьЖурналаРегистрации("Тест.Повтор", УровеньЖурналаРегистрации.Ошибка, , , Текст);
	ЗаписьЖурналаРегистрации("Тест.Повтор", УровеньЖурналаРегистрации.Ошибка, , , Текст);
	ИИО_Журнал.ЗаписатьСобытие("Тест.Ошибка", УровеньЖурналаРегистрации.Ошибка, Новый Структура("error", Текст));

	Ошибки = ИИО_Журнал.ОшибкиПользователя(Начало, 5);

	Количество = 0;
	Для Каждого Строка Из Ошибки Цикл
		Если СтрНайти(Строка.Комментарий, Текст) > 0 Тогда
			Количество = Количество + 1;
			ЮТест.ОжидаетЧто(Строка.Событие).Равно("Тест.Повтор");
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Количество, "повтор и событие ИИ-оператора не берутся").Равно(1);

КонецПроцедуры

Процедура ДоступныйОбъектСобытияУходитСсылкой() Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Т");
	Организация = Запрос.Выполнить().Выгрузить()[0].Ссылка;
	Текст = НовыйТекст();
	ЗаписьЖурналаРегистрации("Тест.ОшибкаОбъекта", УровеньЖурналаРегистрации.Ошибка, Организация.Метаданные(),
		Организация, Текст);

	Ответ = ИИО_РазборОшибок.РазобратьОшибку(Новый Структура);

	Найденные = Новый Массив;
	Для Каждого Ошибка Из Ответ.journal Цикл
		Если Ошибка.text = Текст Тогда
			Найденные.Добавить(Ошибка);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найденные.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(ТипЗнч(Найденные[0].object), "объект - ссылка, а не вид объекта").Равно(Тип("Структура"));
	ЮТест.ОжидаетЧто(Найденные[0].object.ref).Равно(ИИО_Ответ.СсылкаВСтроку(Организация));

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйТекст()

	Возврат "Тест explain_error " + Строка(Новый УникальныйИдентификатор);

КонецФункции

#КонецОбласти
