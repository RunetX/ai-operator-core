// Тесты показа в 1С: show_in_1c открывает штатный список сразу, с заголовком и плоским видом,
// а close_forms его закрывает. open_object открывает структуру подчиненности и движения документа, print_documents
// выполняет команду из меню «Печать» списка. Ожидание чужой формы завершает вызов по сроку. Данные - демо-база БП.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Показ в 1С")
		.ДобавитьТест("СписокОткрываетсяСразуСЗаголовкомИПлоскимВидом")
		.ДобавитьТест("ЗакрытиеФормЗакрываетПоказанныйСписок")
		.ДобавитьТест("СписокБезФормыОжиданияОткрываетсяСПараметромБП")
		.ДобавитьТестовыйНабор("Связи и печать")
		.ДобавитьТест("СтруктураПодчиненностиИДвиженияОткрываютсяИЗакрываются")
		.ДобавитьТест("ПечатьВыполняетКомандуМенюСписка")
		.ДобавитьТестовыйНабор("Ожидание формы")
		.ДобавитьТест("ВызовЗавершаетсяПоСрокуАФормаОстаетсяОткрытой")
		.ДобавитьТест("ЗакрытаяФормаНеЗавершаетВызовПоСроку");

КонецПроцедуры

Процедура ПослеКаждогоТеста() Экспорт

	Вызвать("close_forms", Новый Структура);

КонецПроцедуры

// Возвращает итог по сроку для ожидания формы в тестах, см. ИИО_ФормыКлиент.ОжидатьЗакрытия.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Ожидаемая форма.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * form_open - Булево - Открыта ли форма к сроку.
Функция ИтогПоСроку(Форма, ДополнительныеПараметры) Экспорт

	Возврат Новый Структура("form_open", Форма.Открыта());

КонецФункции

// Запоминает ответы отложенного вызова в тестах.
//
// Параметры:
//  Ответ - Структура, Соответствие - Подготовленный ответ ядра.
//  Приемник - Структура - Накопитель ответов:
//   * Ответы - Массив из Структура, Соответствие - Полученные ответы, пополняется.
Процедура ЗапомнитьОтвет(Ответ, Приемник) Экспорт

	Приемник.Ответы.Добавить(Ответ);

КонецПроцедуры

#Область Тесты

Процедура СписокОткрываетсяСразуСЗаголовкомИПлоскимВидом() Экспорт

	// В новом сеансе БП открыла бы список через форму ожидания и пересоздала бы его через пару секунд.
	Ответ = Вызвать("show_in_1c", Новый Структура("refs, title", Ссылки("Справочник.Контрагенты", "Суприм"),
		"Проверка показа"));

	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("error");
	Формы = ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("Справочник.Контрагенты.Форма.ФормаСписка");
	ЮТест.ОжидаетЧто(Формы).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Формы[0].Заголовок).Равно("Проверка показа");
	ЮТест.ОжидаетЧто(Формы[0].Элементы.Список.Отображение = ОтображениеТаблицы.Список).ЭтоИстина();

КонецПроцедуры

Процедура ЗакрытиеФормЗакрываетПоказанныйСписок() Экспорт

	Вызвать("show_in_1c", Новый Структура("refs", Ссылки("Справочник.Контрагенты", "Суприм")));
	Формы = ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("Справочник.Контрагенты.Форма.ФормаСписка");
	ЮТест.ОжидаетЧто(Формы).ИмеетДлину(1);

	Ответ = Вызвать("close_forms", Новый Структура);

	ЮТест.ОжидаетЧто(Ответ.closed).Равно(1);
	ЮТест.ОжидаетЧто(Формы[0].Открыта()).ЭтоЛожь();

КонецПроцедуры

Процедура СписокБезФормыОжиданияОткрываетсяСПараметромБП() Экспорт

	// Список валют БП открывает без формы ожидания: параметр для нее список пропускает без ошибки.
	Ответ = Вызвать("show_in_1c", Новый Структура("refs", Ссылки("Справочник.Валюты", "руб")));

	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("error");
	ЮТест.ОжидаетЧто(Ответ.opened).ЭтоИстина();

КонецПроцедуры

Процедура СтруктураПодчиненностиИДвиженияОткрываютсяИЗакрываются() Экспорт

	Документ = Ссылки("Документ.РеализацияТоваровУслуг", "0000-000001")[0];

	Связи = Вызвать("open_object", Новый Структура("ref, view", Документ, "related"));
	Движения = Вызвать("open_object", Новый Структура("ref, view", Документ, "movements"));

	ЮТест.ОжидаетЧто(Связи.opened).ЭтоИстина();
	ЮТест.ОжидаетЧто(Движения.view).Равно("movements");
	ЮТест.ОжидаетЧто(ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("ОбщаяФорма.СвязанныеДокументы")).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("Обработка.КорректировкаДвижений.Форма.ОсновнаяФорма"))
		.ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Вызвать("close_forms", Новый Структура).closed).Равно(2);

КонецПроцедуры

Процедура ПечатьВыполняетКомандуМенюСписка() Экспорт

	// Команда нашлась в подключенных командах открытого списка и выполнена; форма печати открывается асинхронно.
	Документы = Ссылки("Документ.РеализацияТоваровУслуг", "0000-000001");

	Формы = Вызвать("print_documents", Новый Структура("refs", Документы));
	Ответ = Вызвать("print_documents", Новый Структура("refs, form", Документы, "ТОРГ12_БезУслуг"));

	ЮТест.ОжидаетЧто(Формы.forms).Заполнено();
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("error");
	ЮТест.ОжидаетЧто(Ответ.opened).ЭтоИстина();
	ЮТест.ОжидаетЧто(Ответ.print_form.id).Равно("ТОРГ12_БезУслуг");
	ЮТест.ОжидаетЧто(ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("Документ.РеализацияТоваровУслуг.Форма.ФормаСписка"))
		.ИмеетДлину(1);

КонецПроцедуры

Процедура ВызовЗавершаетсяПоСрокуАФормаОстаетсяОткрытой() Экспорт

	Приемник = Новый Структура("Ответы", Новый Массив);
	Вызов = НовыйВызов(Приемник);
	Форма = ОткрытьСписокВалют();

	ИИО_ФормыКлиент.ОжидатьЗакрытия(Форма, Вызов, Новый ОписаниеОповещения("ИтогПоСроку", ОМ_ИИО_ПоказКлиент), 0);
	ИИО_ФормыКлиент.ПроверитьОжидание();

	ЮТест.ОжидаетЧто(Приемник.Ответы).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Приемник.Ответы[0].form_open).ЭтоИстина();
	ЮТест.ОжидаетЧто(Форма.Открыта()).ЭтоИстина();
	// Закрытие формы после срока вызов уже не завершает: сервер MCP получил ответ по сроку.
	ИИО_РеестрИнструментовКлиент.Завершить(Вызов, Новый Структура("form_open", Ложь));
	ЮТест.ОжидаетЧто(Приемник.Ответы).ИмеетДлину(1);

КонецПроцедуры

Процедура ЗакрытаяФормаНеЗавершаетВызовПоСроку() Экспорт

	Приемник = Новый Структура("Ответы", Новый Массив);
	Вызов = НовыйВызов(Приемник);
	Форма = ОткрытьСписокВалют();
	ИИО_ФормыКлиент.ОжидатьЗакрытия(Форма, Вызов, Новый ОписаниеОповещения("ИтогПоСроку", ОМ_ИИО_ПоказКлиент), 0);

	Форма.Закрыть();
	ИИО_ФормыКлиент.ПроверитьОжидание();

	ЮТест.ОжидаетЧто(Приемник.Ответы).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Вызов.Завершен).ЭтоЛожь();

КонецПроцедуры

