#Область СлужебныеПроцедурыИФункции

// Возвращает вызов с отложенным ответом, как у ИИО_РеестрИнструментовКлиент.НовыйВызов.
// Ответ вызова попадает в Приемник.Ответы.
//
// Параметры:
//  Приемник - Структура - Накопитель ответов, см. ЗапомнитьОтвет.
//
// Возвращаемое значение:
//  см. ИИО_РеестрИнструментовКлиент.НовыйВызов
Функция НовыйВызов(Приемник)

	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test");
	Вызов = Новый Структура;
	Вызов.Вставить("Инструмент", "test_wait");
	Вызов.Вставить("Аргументы", Новый Структура);
	Вызов.Вставить("Источник", ПараметрыВызова.Источник);
	Вызов.Вставить("Идентификатор", Неопределено);
	Вызов.Вставить("ТокенПрогресса", Неопределено);
	Вызов.Вставить("ОповещениеОЗавершении",
		Новый ОписаниеОповещения("ЗапомнитьОтвет", ОМ_ИИО_ПоказКлиент, Приемник));
	Вызов.Вставить("ОповещениеОПрогрессе", Неопределено);
	Вызов.Вставить("ОповещениеОбОтмене", Неопределено);
	Вызов.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Вызов.Вставить("Завершен", Ложь);
	Возврат Вызов;

КонецФункции

Функция ОткрытьСписокВалют()

	Форма = ОткрытьФорму("Справочник.Валюты.ФормаСписка", , , Новый УникальныйИдентификатор);
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	Возврат Форма;

КонецФункции

Функция Вызвать(ИмяИнструмента, Аргументы)

	Возврат ИИО_РеестрИнструментовКлиент.Вызвать(ИмяИнструмента, Аргументы,
		ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test"));

КонецФункции

Функция Ссылки(Вид, Текст)

	Ответ = Вызвать("find_ref", Новый Структура("kind, text", Вид, Текст));
	Ссылки = Новый Массив;
	Для Каждого Кандидат Из Ответ.candidates Цикл
		Ссылки.Добавить(Кандидат.object.ref);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Ссылки, Вид + " " + Текст).Заполнено();
	Возврат Ссылки;

КонецФункции

#КонецОбласти
