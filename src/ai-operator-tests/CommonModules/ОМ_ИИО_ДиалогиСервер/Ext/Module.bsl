// Тесты хранения диалогов канала бота (план 3а.2): словарь и история между ходами,
// срок хранения, чужой диалог по ключу не читается. Каждый тест работает со своим ключом и удаляет его записи;
// тест срока хранения удаляет все устаревшие диалоги базы, поэтому идет в транзакции.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Диалоги")
		.ДобавитьТест("НовыйДиалогПустой")
		.ДобавитьТест("СловарьИИсторияВосстанавливаются")
		.ДобавитьТест("ДиалогУдаляется")
		.ДобавитьТест("ЧужойДиалогНеЧитается")
		.ДобавитьТест("УстаревшийДиалогНеЧитаетсяИУдаляется").ВТранзакции();

КонецПроцедуры

#Область Тесты

Процедура НовыйДиалогПустой() Экспорт

	Диалог = ИИО_Диалоги.Диалог(НовыйКлюч());

	ЮТест.ОжидаетЧто(Диалог.Словарь.Исходные.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Диалог.История.Количество()).Равно(0);

КонецПроцедуры

Процедура СловарьИИсторияВосстанавливаются() Экспорт

	Ключ = НовыйКлюч();
	Диалог = ИИО_Диалоги.Диалог(Ключ);
	Токен = ИИО_МаскированиеКлиентСервер.Замаскировать(
		Новый Структура("pii, value", "ФИО", "Тестов Тест Тестович"), Диалог.Словарь);
	Диалог.История.Добавить(Новый Структура("role, content", "user", "Где груз " + Токен + "?"));
	ИИО_Диалоги.Записать(Диалог);

	Попытка
		Прочитанный = ИИО_Диалоги.Диалог(Ключ);
		ЮТест.ОжидаетЧто(Прочитанный.История.Количество()).Равно(1);
		ЮТест.ОжидаетЧто(Прочитанный.История[0].content).Содержит(Токен);
		ЮТест.ОжидаетЧто(ИИО_МаскированиеКлиентСервер.Демаскировать(Токен, Прочитанный.Словарь))
			.Равно("Тестов Тест Тестович");
		// Нумерация токенов продолжается: то же значение - тот же токен, новое - следующий номер.
		ЮТест.ОжидаетЧто(ИИО_МаскированиеКлиентСервер.ЗамаскироватьТекст("Тестов Т.Т.", Прочитанный.Словарь))
			.Равно(Токен);
		ДругойТокен = ИИО_МаскированиеКлиентСервер.Замаскировать(
			Новый Структура("pii, value", "ФИО", "Другов Друг Другович"), Прочитанный.Словарь);
		ЮТест.ОжидаетЧто(ДругойТокен).Равно("[ФИО#2]");
	Исключение
		ИИО_Диалоги.Удалить(Ключ);
		ВызватьИсключение;
	КонецПопытки;
	ИИО_Диалоги.Удалить(Ключ);

КонецПроцедуры

Процедура ДиалогУдаляется() Экспорт

	Ключ = НовыйКлюч();
	Диалог = ИИО_Диалоги.Диалог(Ключ);
	Диалог.История.Добавить(Новый Структура("role, content", "user", "вопрос"));
	ИИО_Диалоги.Записать(Диалог);

	ИИО_Диалоги.Удалить(Ключ);

	ЮТест.ОжидаетЧто(ИИО_Диалоги.Диалог(Ключ).История.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(КоличествоЗаписей(Ключ)).Равно(0);

КонецПроцедуры

Процедура ЧужойДиалогНеЧитается() Экспорт

	Ключ = НовыйКлюч();
	ЗаписатьНапрямую(Ключ, ДругойПользователь(), ТекущаяДатаСеанса());

	Попытка
		ЮТест.ОжидаетЧто(ИИО_Диалоги.Диалог(Ключ).История.Количество()).Равно(0);
	Исключение
		УдалитьНапрямую(Ключ);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьНапрямую(Ключ);

КонецПроцедуры

Процедура УстаревшийДиалогНеЧитаетсяИУдаляется() Экспорт

	Ключ = НовыйКлюч();
	СрокЧас = ИИО_Настройки.Значение("ИИО_СрокХраненияДиалоговЧас");
	ЗаписатьНапрямую(Ключ, Пользователи.ТекущийПользователь(), ТекущаяДатаСеанса() - (СрокЧас + 1) * 3600);

	ЮТест.ОжидаетЧто(ИИО_Диалоги.Диалог(Ключ).История.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(ИИО_Диалоги.УдалитьУстаревшие()).Больше(0);
	ЮТест.ОжидаетЧто(КоличествоЗаписей(Ключ)).Равно(0);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйКлюч()

	Возврат "test-" + Строка(Новый УникальныйИдентификатор);

КонецФункции

Функция ДругойПользователь()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка <> &Текущий");
	Запрос.УстановитьПараметр("Текущий", Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "в базе есть второй пользователь").ЭтоИстина();
	Возврат Выборка.Ссылка;

КонецФункции

Процедура ЗаписатьНапрямую(Ключ, Владелец, Изменен)

	Запись = РегистрыСведений.ИИО_Диалоги.СоздатьМенеджерЗаписи();
	Запись.Ключ = Ключ;
	Запись.Владелец = Владелец;
	Запись.Словарь = Новый ХранилищеЗначения(ИИО_МаскированиеКлиентСервер.НовыйСловарь());
	Запись.История = Новый ХранилищеЗначения(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Новый Структура("role, content", "user", "чужой вопрос")));
	Запись.Изменен = Изменен;
	УстановитьПривилегированныйРежим(Истина);
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура УдалитьНапрямую(Ключ)

	Набор = РегистрыСведений.ИИО_Диалоги.СоздатьНаборЗаписей();
	Набор.Отбор.Ключ.Установить(Ключ);
	УстановитьПривилегированныйРежим(Истина);
	Набор.Записать();
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция КоличествоЗаписей(Ключ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.ИИО_Диалоги КАК Диалоги
	|ГДЕ
	|	Диалоги.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", Ключ);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

#КонецОбласти
