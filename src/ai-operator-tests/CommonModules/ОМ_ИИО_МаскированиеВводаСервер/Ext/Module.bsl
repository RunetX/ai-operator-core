Процедура ГородаВПереченеИПослеПредлогаНеСкрываются() Экспорт

	// Города, совпадающие с фамилиями из базы, в начале предложения после предлога и в перечне мест не скрываются.
	// Человек после обращения скрывается.
	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
	// В тексте буква е с двумя точками и длинное тире, как во вводе пользователя.
	БукваЕ = Символ(1105);
	Тире = Символ(8212);
	Текст = СтрШаблон("Из Иванова приехали 2 фуры. Рейс Корол%1в %2 Мытищи %2 Пушкино, отч%1т по рейсам из Серпухова "
		+ "и Корол%1ва. Позвони Королеву", БукваЕ, Тире);

	Результат = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Текст, Словарь);

	ЮТест.ОжидаетЧто(Результат.Текст).Равно(СтрЗаменить(Текст, "Позвони Королеву", "Позвони [ФИО#1]"));

