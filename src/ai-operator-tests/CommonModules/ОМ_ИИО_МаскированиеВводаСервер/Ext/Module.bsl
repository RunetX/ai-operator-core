Функция Абрамов()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ФизическиеЛица.Ссылка) КАК Представление
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Наименование = &Наименование");
	Запрос.УстановитьПараметр("Наименование", "Абрамов Геннадий Сергеевич");
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "в демо-базе есть физлицо Абрамов").ЭтоИстина();
	Возврат Новый Структура("Ссылка, Представление", Выборка.Ссылка, Выборка.Представление);

КонецФункции

