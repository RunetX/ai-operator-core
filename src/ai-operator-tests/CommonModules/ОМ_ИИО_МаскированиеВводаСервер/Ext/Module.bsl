Процедура КороткаяФамилияИзБазыНаходитсяЗапросом() Экспорт

	// Тест идет в транзакции (ВТранзакции): физлицо откатывается, демо-данные не меняются.
	Объект = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Объект.Наименование = "Юн Сергей Петрович";
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Результаты = Новый Массив;
	Для Каждого Текст Из СтрРазделить("Груз для Юна не дошел|Передай Юну, что груз не дошел", "|") Цикл
		Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
		Результат = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Текст, Словарь, Истина);
		Результаты.Добавить(Результат.Текст + " / " + ?(Результат.Замены.Количество() = 0, "",
			Результат.Замены[0].Источник));
	КонецЦикла;

	ЮТест.ОжидаетЧто(Результаты[0]).Равно("Груз для [ФИО#1] не дошел / база");
	ЮТест.ОжидаетЧто(Результаты[1]).Равно("Передай [ФИО#1], что груз не дошел / база");

КонецПроцедуры

