#Область СлужебныеПроцедурыИФункции

Функция НайтиКандидатов(Вид, Текст, Лимит = 10)

	Результат = ИИО_Поиск.НайтиСсылки(Новый Структура("kind, text, limit", Вид, Текст, Лимит));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Результат) Тогда
		ВызватьИсключение Результат.error.message;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// match кандидата с этой ссылкой или пустая строка, если его нет среди кандидатов.
//
// Параметры:
//  Результат - см. ИИО_Поиск.НайтиСсылки
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка - exact, partial или пустая строка.
Функция Совпадение(Результат, Ссылка)

	Кандидат = Кандидат(Результат, Ссылка);
	Возврат ?(Кандидат = Неопределено, "", Кандидат.match);

КонецФункции

Функция Кандидат(Результат, Ссылка)

	Идентификатор = ИИО_Ответ.СсылкаВСтроку(Ссылка);
	Для Каждого Кандидат Из Результат.candidates Цикл
		Если Кандидат.object.ref = Идентификатор Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция Контрагент(ВидЛица, СИНН = Истина)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка, К.Наименование КАК Наименование, К.ИНН КАК ИНН
	|ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления И К.ЮридическоеФизическоеЛицо = &ВидЛица И (К.ИНН <> """" ИЛИ НЕ &СИНН)
	|УПОРЯДОЧИТЬ ПО К.ИНН УБЫВ, К.Наименование");
	Запрос.УстановитьПараметр("ВидЛица", ВидЛица);
	Запрос.УстановитьПараметр("СИНН", СИНН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("В демо-базе нет контрагента вида %1 с ИНН", ВидЛица);
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Наименование, ИНН", Выборка.Ссылка, Выборка.Наименование, Выборка.ИНН);

КонецФункции

Функция КонтрагентСНесколькимиСловами()

	Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Наименование КАК Наименование
	|ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления И К.Наименование ПОДОБНО ""% %""
	|УПОРЯДОЧИТЬ ПО К.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Слова = СтрРазделить(ИИО_Поиск.НормализованнаяСтрока(Выборка.Наименование), " ", Ложь);
		Если Слова.Количество() >= 2 И СтрДлина(Слова[Слова.ВГраница()]) >= 4 Тогда
			Возврат Новый Структура("Ссылка, Наименование", Выборка.Ссылка, Выборка.Наименование);
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В демо-базе нет контрагента с наименованием из нескольких слов";

КонецФункции

// Контрагент и слово его наименования из букв, не короче пяти.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - СправочникСсылка.Контрагенты
//   * Слово - Строка - Слово в нижнем регистре, см. ИИО_Поиск.НормализованнаяСтрока.
Функция КонтрагентСоСловомИзБукв()

	Запрос = Новый Запрос("ВЫБРАТЬ К.Ссылка КАК Ссылка, К.Наименование КАК Наименование
	|ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И НЕ К.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО К.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Слово Из СтрРазделить(ИИО_Поиск.НормализованнаяСтрока(Выборка.Наименование), " ", Ложь) Цикл
			Если СтрДлина(Слово) >= 5 И ТолькоБуквы(Слово) Тогда
				Возврат Новый Структура("Ссылка, Слово", Выборка.Ссылка, Слово);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ВызватьИсключение "В демо-базе нет контрагента со словом из букв";

КонецФункции

Функция ТолькоБуквы(Слово)

	Для Позиция = 1 По СтрДлина(Слово) Цикл
		Символ = Сред(Слово, Позиция, 1);
		Если ВРег(Символ) = НРег(Символ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция Реализации(Количество)

	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ %1 Р.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р
	|УПОРЯДОЧИТЬ ПО Р.Дата", Количество));
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("Идентификатор");
	Для Каждого СтрокаТаблицы Из Таблица Цикл
