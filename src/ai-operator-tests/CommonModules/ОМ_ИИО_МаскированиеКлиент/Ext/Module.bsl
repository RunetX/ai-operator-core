	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать("no_such_tool", Новый Структура,
		ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test"));

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("NOT_FOUND");

КонецПроцедуры

Процедура ЯдроДемаскируетАргументыПередОбработчиком() Экспорт

	// Модель передает токен, а обработчик должен получить исходное значение.
	Токен = ИИО_МаскированиеКлиент.Замаскировать(
		ПомеченнаяСсылка("Справочник.Контрагенты:1", "Справочник.Контрагенты")).presentation;

	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать("describe_metadata", Новый Структура("name", Токен),
		ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test"));

	// Обработчик нашел объект по исходному значению, а в ответе словарь снова заменил его токеном.
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("error");
	ЮТест.ОжидаетЧто(Ответ.name).Равно(Токен);
	ЮТест.ОжидаетЧто(Ответ.attributes).Заполнено();

КонецПроцедуры

