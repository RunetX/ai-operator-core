Процедура ФормаМаскированияПоказываетПреднастройку() Экспорт

	Форма = ПолучитьФорму("ОбщаяФорма.ИИО_НастройкаМаскирования");

	ЮТест.ОжидаетЧто(Форма.Правила.Количество()).Больше(0);
	ЮТест.ОжидаетЧто(Форма.Элементы.ПравилаВидПДн.СписокВыбора.НайтиПоЗначению("ФИО") <> Неопределено).ЭтоИстина();
	Источники = Новый Массив;
	Для Каждого Строка Из Форма.Правила Цикл
		Если Строка.Объект = "Справочник.ФизическиеЛица" И Строка.Поле = "ИНН" Тогда
			Источники.Добавить(Строка.Источник);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Источники).ИмеетДлину(1);

КонецПроцедуры

