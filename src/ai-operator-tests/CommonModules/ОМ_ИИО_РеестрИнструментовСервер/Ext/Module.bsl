// Тесты серверного реестра канала бота: набор инструментов, маскирование словарем хода,
// синхронный run_query, кнопки вместо форм, perform только пробным запуском. И вызов сервера канала MCP
// для инструментов без работы на клиенте: выполняются только они.
// Данные - демо-база БП: контрагент-физлицо и реализация декабря 2016. Документы не меняются.
// Тест perform выдает текущему пользователю разрешения post и unpost через ОМ_ИИО_ДействияСервер.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Реестр бота")
		.ДобавитьТест("НаборБотаСтроитсяИзОпределений")
		.ДобавитьТест("ИнструментВнеБотаНеНайден")
		.ДобавитьТестовыйНабор("Маскирование словарем хода")
		.ДобавитьТест("АргументыДемаскируютсяСловаремХода")
		.ДобавитьТест("ОтветМаскируетсяСловаремХода")
		.ДобавитьТест("СловариХодовНезависимы")
		.ДобавитьТест("ТокенПослеНезакрытойСкобкиДемаскируется")
		.ДобавитьТестовыйНабор("Инструменты на сервере")
		.ДобавитьТест("ЗапросВыполняетсяСинхронно")
		.ДобавитьТест("ОшибкаЗапросаВозвращаетсяМодели")
		.ДобавитьТест("ОткрытиеОбъектаДаетКнопку")
		.ДобавитьТест("ДействиеТолькоПробноеСКнопкойПредпросмотра")
		.ДобавитьТестовыйНабор("Вызов сервера канала MCP")
		.ДобавитьТест("СерверВыполняетТолькоИнструментыБезКлиента");

КонецПроцедуры

#Область Тесты

Процедура НаборБотаСтроитсяИзОпределений() Экспорт

	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	ИменаБота = "describe_metadata,find_ref,related_objects,explain_error,run_query,list_reports,run_report,"
		+ "open_object,show_in_1c,perform";
	Для Каждого Имя Из СтрРазделить(ИменаБота, ",") Цикл
		Инструмент = Контекст.Инструменты.Получить(Имя);
		ЮТест.ОжидаетЧто(Инструмент, Имя).Заполнено();
		ЮТест.ОжидаетЧто(Инструмент.Описание, Имя).Заполнено();
		ЮТест.ОжидаетЧто(Инструмент.Схема.type, Имя).Равно("object");
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ping,print_documents,undo,close_forms", ",") Цикл
		ЮТест.ОжидаетЧто(Контекст.Инструменты.Получить(Имя), Имя).ЭтоНеопределено();
	КонецЦикла;

КонецПроцедуры

Процедура ИнструментВнеБотаНеНайден() Экспорт

	Ответ = ИИО_РеестрИнструментов.Вызвать("print_documents", Новый Структура,
		ИИО_РеестрИнструментов.НовыйКонтекстВызова());

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("NOT_FOUND");

КонецПроцедуры

Процедура АргументыДемаскируютсяСловаремХода() Экспорт

	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();
	Токен = ИИО_МаскированиеКлиентСервер.Замаскировать(Новый Структура("pii, value", "Наименование",
		"Справочник.Контрагенты"), Контекст.Словарь);
	ЮТест.ОжидаетЧто(Токен).Содержит("[Наименование#");

	Ответ = ИИО_РеестрИнструментов.Вызвать("describe_metadata", Новый Структура("name", Токен), Контекст);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ)).Равно(Ложь);

КонецПроцедуры

Процедура ОтветМаскируетсяСловаремХода() Экспорт

	Контрагент = КонтрагентФизлицо();
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	Ответ = ИИО_РеестрИнструментов.Вызвать("find_ref",
		Новый Структура("kind, text", "Справочник.Контрагенты", Контрагент.Наименование), Контекст);

	Текст = ИИО_ОтветКлиентСервер.ВJSON(Ответ);
	ЮТест.ОжидаетЧто(Текст).НеСодержит(Контрагент.Наименование);
	ЮТест.ОжидаетЧто(Текст).Содержит("[ФИО#");
	ЮТест.ОжидаетЧто(ИИО_МаскированиеКлиентСервер.Демаскировать(Текст, Контекст.Словарь))
		.Содержит(Контрагент.Наименование);

КонецПроцедуры

Процедура СловариХодовНезависимы() Экспорт

	Контрагент = КонтрагентФизлицо();
	Первый = ИИО_РеестрИнструментов.НовыйКонтекстВызова();
	ИИО_РеестрИнструментов.Вызвать("find_ref",
		Новый Структура("kind, text", "Справочник.Контрагенты", Контрагент.Наименование), Первый);
	Второй = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	ЮТест.ОжидаетЧто(Первый.Словарь.Исходные.Количество()).Больше(0);
	ЮТест.ОжидаетЧто(Второй.Словарь.Исходные.Количество()).Равно(0);

КонецПроцедуры

Процедура ТокенПослеНезакрытойСкобкиДемаскируется() Экспорт

	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
	Токен = ИИО_МаскированиеКлиентСервер.Замаскировать(Новый Структура("pii, value", "ФИО", "Петров Петр"), Словарь);

	ЮТест.ОжидаетЧто(ИИО_МаскированиеКлиентСервер.Демаскировать("[{""a"": """ + Токен + """}] и [x] " + Токен, Словарь))
		.Равно("[{""a"": ""Петров Петр""}] и [x] Петров Петр");

КонецПроцедуры

Процедура ЗапросВыполняетсяСинхронно() Экспорт

	ТекстЗапроса = "ВЫБРАТЬ Реализации.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Реализации";
	Ответ = ИИО_РеестрИнструментов.Вызвать("run_query", Новый Структура("text, limit", ТекстЗапроса, 3),
		ИИО_РеестрИнструментов.НовыйКонтекстВызова());

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), ИИО_ОтветКлиентСервер.ВJSON(Ответ)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.rows.Количество()).Равно(3);
	ЮТест.ОжидаетЧто(Ответ).ИмеетСвойство("wait_ms");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("run_ms");

КонецПроцедуры

Процедура ОшибкаЗапросаВозвращаетсяМодели() Экспорт

	Ответ = ИИО_РеестрИнструментов.Вызвать("run_query", Новый Структура("text", "ВЫБРАТЬ ИЗ"),
		ИИО_РеестрИнструментов.НовыйКонтекстВызова());

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("QUERY_SYNTAX");

КонецПроцедуры

Процедура ОткрытиеОбъектаДаетКнопку() Экспорт

	Документ = РеализацияДекабря();
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	Ответ = ИИО_РеестрИнструментов.Вызвать("open_object",
		Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(Документ)), Контекст);

	ЮТест.ОжидаетЧто(Ответ.button).Равно(Истина);
	ЮТест.ОжидаетЧто(Контекст.Кнопки.Количество()).Равно(1);
	Кнопка = Контекст.Кнопки[0];
	ЮТест.ОжидаетЧто(Кнопка.Вид).Равно("open");
	ЮТест.ОжидаетЧто(Кнопка.Инструмент).Равно("open_object");
	ЮТест.ОжидаетЧто(Кнопка.Аргументы.ref).Равно(ИИО_Ответ.СсылкаВСтроку(Документ));

КонецПроцедуры

Процедура ДействиеТолькоПробноеСКнопкойПредпросмотра() Экспорт

	ОМ_ИИО_ДействияСервер.РазрешитьДействия();
	Документ = РеализацияДекабря();
	Версия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВерсияДанных");
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();
	Ссылка = ИИО_Ответ.СсылкаВСтроку(Документ);

	// Модель просит выполнить по-настоящему - канал бота все равно делает только пробный запуск.
	Ответ = ИИО_РеестрИнструментов.Вызвать("perform",
		Новый Структура("action, refs, dry_run", "unpost", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка), Ложь),
		Контекст);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), ИИО_ОтветКлиентСервер.ВJSON(Ответ)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ.dry_run).Равно(Истина);
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("pii_context");
	ЮТест.ОжидаетЧто(Ответ.button).Равно(Истина);
	Кнопка = Контекст.Кнопки[0];
	ЮТест.ОжидаетЧто(Кнопка.Вид).Равно("preview");
	ЮТест.ОжидаетЧто(Кнопка.Аргументы.action).Равно("unpost");
	ЮТест.ОжидаетЧто(Кнопка.Аргументы.dry_run).Равно(Ложь);
	ЮТест.ОжидаетЧто(Кнопка.Аргументы.refs[0]).Равно(Ссылка);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВерсияДанных")).Равно(Версия);
	ЮТест.ОжидаетЧто(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Проведен")).Равно(Истина);

КонецПроцедуры

Процедура СерверВыполняетТолькоИнструментыБезКлиента() Экспорт

	// Пустые аргументы: каждый из трех инструментов отвечает своим кодом, значит, вызван его обработчик.
	Ожидаемые = Новый Структура("describe_metadata, find_ref, related_objects", "", "INVALID_ARGUMENT",
		"INVALID_ARGUMENT");
	Для Каждого КлючИЗначение Из Ожидаемые Цикл
		Ответ = ИИО_РеестрИнструментовВызовСервера.ВыполнитьИнструмент(КлючИЗначение.Ключ, Новый Структура);
		ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), КлючИЗначение.Ключ).Равно(КлючИЗначение.Значение);
	КонецЦикла;

	// С клиента может прийти любое имя: инструменты с работой на клиенте и чужие имена сервер не выполняет.
	Для Каждого Имя Из СтрРазделить("perform,undo,run_query,run_report,print_documents,ping,no_such_tool", ",") Цикл
		Ответ = ИИО_РеестрИнструментовВызовСервера.ВыполнитьИнструмент(Имя, Новый Структура);
		ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ), Имя).Равно("NOT_FOUND");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КонтрагентФизлицо()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|	И НЕ Контрагенты.ПометкаУдаления
		|	И НЕ Контрагенты.ЭтоГруппа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагенты.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В демо-базе нет контрагента-физлица";
	КонецЕсли;
	Возврат Выборка;

КонецФункции

Функция РеализацияДекабря()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Реализации.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Реализации
		|ГДЕ
		|	Реализации.Дата МЕЖДУ &Начало И &Конец
		|	И Реализации.Проведен
		|	И НЕ Реализации.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Реализации.Дата УБЫВ");
	Запрос.УстановитьПараметр("Начало", '20161201');
	Запрос.УстановитьПараметр("Конец", '20161231235959');
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "В демо-базе нет проведенной реализации за декабрь 2016";
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
