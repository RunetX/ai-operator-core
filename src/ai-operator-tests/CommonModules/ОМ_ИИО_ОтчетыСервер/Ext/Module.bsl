Процедура ВыручкаНаходитПродажиПоКонтрагентамПервыми() Экспорт

	Результат = ИИО_Отчеты.НайтиОтчеты(Новый Структура("text", "выручка по контрагентам за квартал"));

	ЮТест.ОжидаетЧто(Результат.reports[0].report).Равно("Отчет.Продажи");
	ЮТест.ОжидаетЧто(Результат.reports[0].variant).Равно("ПродажиПоКонтрагентам");
	ЮТест.ОжидаетЧто(Результат.reports[0].supported).Равно(Истина);
	// Описание отчета модель получает один раз, у следующих вариантов - только описание варианта.
	ЮТест.ОжидаетЧто(Результат.reports[0].description).Содержит("90.01");
	ЮТест.ОжидаетЧто(Результат.reports[1].description).НеСодержит("90.01");

