Процедура ПараметрыОткрытияФормыПовторяютНастройки() Экспорт

	Покупатель = КрупныйПокупатель();
	Параметры = Новый Структура;
	ОтборПокупателя = Новый Структура("field, value", "Контрагент", ИИО_Ответ.СсылкаВСтроку(Покупатель));
	Параметры.Вставить("filters", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОтборПокупателя));
	Параметры.Вставить("group_by", СтрРазделить("Контрагент,Документ", ","));
	Открытие = ИИО_Отчеты.ПараметрыОткрытияФормы(ИИО_Отчеты.ПодготовитьФормирование(Аргументы(Параметры)));

	ЮТест.ОжидаетЧто(Открытие.ИмяФормы).Равно("Отчет.Продажи.Форма.ФормаОтчета");
	ЮТест.ОжидаетЧто(Открытие.Параметры.ВидРасшифровки).Равно(2);
	ЮТест.ОжидаетЧто(Открытие.Параметры.СформироватьПриОткрытии).Равно(Истина);
	Свойства = Открытие.Параметры.ПользовательскиеНастройки.ДополнительныеСвойства;
	ЮТест.ОжидаетЧто(Свойства.КлючВарианта).Равно("ПродажиПоКонтрагентам");
	ЮТест.ОжидаетЧто(Свойства.НачалоПериода).Равно('20160101');
	ЮТест.ОжидаетЧто(Свойства.КонецПериода).Равно('20160331235959');
	ЮТест.ОжидаетЧто(Свойства.Группировка).ИмеетДлину(2);
	ЮТест.ОжидаетЧто(Свойства.Группировка[1].Поле).Равно("Документ");

	Отбор = Открытие.Параметры.ПользовательскиеНастройки.Элементы[0];
