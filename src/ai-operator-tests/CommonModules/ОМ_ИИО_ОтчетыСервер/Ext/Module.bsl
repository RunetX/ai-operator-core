#Область СлужебныеПроцедурыИФункции

// Возвращает аргументы run_report: «Продажи» за 1 квартал 2016 без показа формы.
//
// Параметры:
//  Дополнительно - Структура, Неопределено - Аргументы, которые добавляются к основным или заменяют их.
//
// Возвращаемое значение:
//  Структура - Аргументы run_report:
//   * report - Строка - Отчет.Продажи.
//   * period - Структура - from и to.
Функция Аргументы(Дополнительно = Неопределено)

	Аргументы = Новый Структура;
	Аргументы.Вставить("report", "Отчет.Продажи");
	Аргументы.Вставить("period", Новый Структура("from, to", "2016-01-01", "2016-03-31"));
	Если Дополнительно <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Дополнительно Цикл
			Аргументы.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

Функция Сформировать(Аргументы)

	Подготовленный = ИИО_Отчеты.ПодготовитьФормирование(Аргументы);
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный)).Равно(Ложь);
	Возврат ИИО_Отчеты.СформироватьОтчет(Подготовленный);

КонецФункции

// Возвращает оборот по кредиту счетов выручки за 1 квартал 2016 - источник отчета «Продажи».
//
// Параметры:
//  Покупатель - СправочникСсылка.Контрагенты, Неопределено - Отбор по покупателю; Неопределено - по всем.
//
// Возвращаемое значение:
//  Число
Функция ОборотВыручки(Покупатель = Неопределено)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Обороты.СуммаОборотКт), 0) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Выручка), , &УсловиеПокупателя, , ) КАК Обороты";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПокупателя",
		?(Покупатель = Неопределено, "", "КорСубконто1 = &Покупатель"));
	Запрос.УстановитьПараметр("Начало", '20160101');
	Запрос.УстановитьПараметр("Конец", '20160331235959');
	Запрос.УстановитьПараметр("Выручка", ПланыСчетов.Хозрасчетный.Выручка);
	Запрос.УстановитьПараметр("Покупатель", Покупатель);
	Возврат Запрос.Выполнить().Выгрузить()[0].Сумма;

КонецФункции

// Возвращает покупателя с наибольшей выручкой за 1 квартал 2016.
//
// Возвращаемое значение:
//  СправочникСсылка.Контрагенты
Функция КрупныйПокупатель()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Обороты.КорСубконто1 КАК Покупатель
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(&Начало, &Конец, , Счет В ИЕРАРХИИ (&Выручка), , , , ) КАК Обороты
	|ГДЕ
	|	Обороты.КорСубконто1 ССЫЛКА Справочник.Контрагенты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Обороты.СуммаОборотКт УБЫВ";
	Запрос.УстановитьПараметр("Начало", '20160101');
	Запрос.УстановитьПараметр("Конец", '20160331235959');
	Запрос.УстановитьПараметр("Выручка", ПланыСчетов.Хозрасчетный.Выручка);
	Возврат Запрос.Выполнить().Выгрузить()[0].Покупатель;

КонецФункции

Функция СуммаКолонки(Результат, Имя)

	Индекс = Неопределено;
	Для Номер = 0 По Результат.columns.ВГраница() Цикл
		Если Результат.columns[Номер].name = Имя Тогда
			Индекс = Номер;
		КонецЕсли;
	КонецЦикла;
	Сумма = 0;
	Для Каждого СтрокаОтчета Из Результат.rows Цикл
		Сумма = Сумма + СтрокаОтчета[Индекс];
	КонецЦикла;
	Возврат Сумма;

КонецФункции

Функция ИменаПолей(Описания)

	Имена = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Имена.Добавить(Описание.field);
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ЗначениеВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

#КонецОбласти
