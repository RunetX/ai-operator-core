#Область Тесты

Процедура СловаПоискаНормализуютсяИОбрезаютсяДоОсновы() Экспорт

	Слова = ИИО_Отчеты.СловаПоиска("Выручку по КОНТРАГЕНТАМ за 1 квартал, " + Символ(1105) + "лка");
	ЮТест.ОжидаетЧто(Слова).ИмеетДлину(4);
	ЮТест.ОжидаетЧто(Слова[0]).Равно("выруч");
	ЮТест.ОжидаетЧто(Слова[1]).Равно("контрагент");
	ЮТест.ОжидаетЧто(Слова[2]).Равно("кварт");
	ЮТест.ОжидаетЧто(Слова[3]).Равно("елка");

КонецПроцедуры

Процедура ВыручкаНаходитПродажиПоКонтрагентамПервыми() Экспорт

	Результат = ИИО_Отчеты.НайтиОтчеты(Новый Структура("text", "выручка по контрагентам за квартал"));

	ЮТест.ОжидаетЧто(Результат.reports[0].report).Равно("Отчет.Продажи");
	ЮТест.ОжидаетЧто(Результат.reports[0].variant).Равно("ПродажиПоКонтрагентам");
	ЮТест.ОжидаетЧто(Результат.reports[0].supported).Равно(Истина);
	// Описание отчета модель получает один раз, у следующих вариантов - только описание варианта.
	ЮТест.ОжидаетЧто(Результат.reports[0].description).Содержит("90.01");
	ЮТест.ОжидаетЧто(Результат.reports[1].description).НеСодержит("90.01");

КонецПроцедуры

Процедура БезТекстаВозвращаютсяТолькоПоддерживаемые() Экспорт

	Результат = ИИО_Отчеты.НайтиОтчеты(Новый Структура);

	ЮТест.ОжидаетЧто(Результат.reports.Количество() >= 5).Равно(Истина);
	Для Каждого Элемент Из Результат.reports Цикл
		ЮТест.ОжидаетЧто(Элемент.supported).Равно(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура НеподдерживаемыйВариантПомечен() Экспорт

	Результат = ИИО_Отчеты.НайтиОтчеты(Новый Структура("text", "сравнение продаж"));

	Найден = Ложь;
	Для Каждого Элемент Из Результат.reports Цикл
		Если Элемент.report = "Отчет.СравнениеПродаж" Тогда
			Найден = Истина;
			ЮТест.ОжидаетЧто(Элемент.supported).Равно(Ложь);
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Найден).Равно(Истина);

КонецПроцедуры

