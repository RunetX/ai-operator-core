КонецФункции

// Аргументы run_report: ведомость по счету за 1 квартал 2016 без показа формы.
//
// Параметры:
//  КодСчета - Строка, Неопределено - Отбор Счет; Неопределено - без отбора.
//  Дополнительно - Структура, Неопределено - Аргументы поверх основных.
//
// Возвращаемое значение:
//  см. Аргументы
Функция АргументыВедомости(КодСчета, Дополнительно = Неопределено)

	Аргументы = Аргументы(Дополнительно);
	Аргументы.Вставить("report", "Отчет.ОборотноСальдоваяВедомостьПоСчету");
	Если КодСчета <> Неопределено Тогда
		Отбор = Новый Структура("field, value", "Счет", КодСчета);
		Аргументы.Вставить("filters", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отбор));
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

// Аргументы ведомости с отбором Счет через in.
//
// Параметры:
//  Значения - Массив из Строка - Коды или ref счетов.
//
// Возвращаемое значение:
//  см. Аргументы
Функция АргументыСчетомВСписке(Значения)

	Аргументы = АргументыВедомости(Неопределено);
	Отбор = Новый Структура("field, op, value", "Счет", "in", Значения);
	Аргументы.Вставить("filters", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отбор));
	Возврат Аргументы;

КонецФункции

// Счет ведомости по коду: из подготовки отчета, как его найдет ИИ-оператор.
//
// Параметры:
//  КодСчета - Строка
//
// Возвращаемое значение:
//  ПланСчетовСсылка.Хозрасчетный
Функция СчетВедомости(КодСчета)

	Возврат ИИО_Отчеты.ПодготовитьФормирование(АргументыВедомости(КодСчета)).ОтборыПараметрами[0].Значение;

КонецФункции

// Сальдо и обороты счета за 1 квартал 2016 по регистру, свернутые до счета, как в итогах ведомости.
//
// Параметры:
//  КодСчета - Строка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Показатель ведомости, например СальдоНаКонецПериода.БУКонечныйОстатокДт.
//   * Значение - Число
Функция ОстаткиИОборотыСчета(КодСчета)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаНачальныйОстатокДт), 0) КАК НачальныйДт,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаНачальныйОстатокКт), 0) КАК НачальныйКт,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОборотДт), 0) КАК ОборотДт,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОборотКт), 0) КАК ОборотКт,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаКонечныйОстатокДт), 0) КАК КонечныйДт,
	|	ЕСТЬNULL(СУММА(Остатки.СуммаКонечныйОстатокКт), 0) КАК КонечныйКт
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(&Начало, &Конец, , , Счет В ИЕРАРХИИ (&Счет), , ) КАК Остатки";
	Запрос.УстановитьПараметр("Начало", '20160101');
	Запрос.УстановитьПараметр("Конец", '20160331235959');
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Хозрасчетный.НайтиПоКоду(КодСчета));
	Строка = Запрос.Выполнить().Выгрузить()[0];

	ИтогиСчета = Новый Соответствие;
	ИтогиСчета.Вставить("СальдоНаНачалоПериода.БУНачальныйОстатокДт", Строка.НачальныйДт);
	ИтогиСчета.Вставить("СальдоНаНачалоПериода.БУНачальныйОстатокКт", Строка.НачальныйКт);
	ИтогиСчета.Вставить("ОборотыЗаПериод.БУОборотДт", Строка.ОборотДт);
	ИтогиСчета.Вставить("ОборотыЗаПериод.БУОборотКт", Строка.ОборотКт);
	ИтогиСчета.Вставить("СальдоНаКонецПериода.БУКонечныйОстатокДт", Строка.КонечныйДт);
	ИтогиСчета.Вставить("СальдоНаКонецПериода.БУКонечныйОстатокКт", Строка.КонечныйКт);
	Возврат ИтогиСчета;

КонецФункции

Функция СуммаКолонки(Результат, Имя)

	Индекс = Неопределено;
	Для Номер = 0 По Результат.columns.ВГраница() Цикл
		Если Результат.columns[Номер].name = Имя Тогда
			Индекс = Номер;
		КонецЕсли;
	КонецЦикла;
	Сумма = 0;
	Для Каждого СтрокаОтчета Из Результат.rows Цикл
		Сумма = Сумма + ?(СтрокаОтчета[Индекс] = Неопределено, 0, СтрокаОтчета[Индекс]);
	КонецЦикла;
	Возврат Сумма;

КонецФункции

Функция ИменаПолей(Описания)

	Имена = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Имена.Добавить(Описание.field);
	КонецЦикла;
	Возврат Имена;

КонецФункции

#КонецОбласти
