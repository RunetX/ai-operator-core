		ЮТест.ОжидаетЧто(СтрокаОтчета[0].ref).Равно(ИИО_Ответ.СсылкаВСтроку(Покупатель));
		ЮТест.ОжидаетЧто(СтрокаОтчета[1].ref).НачинаетсяС("Документ.");
	КонецЦикла;
	ЮТест.ОжидаетЧто(СуммаКолонки(Результат, "Сумма")).Равно(ОборотВыручки(Покупатель));

