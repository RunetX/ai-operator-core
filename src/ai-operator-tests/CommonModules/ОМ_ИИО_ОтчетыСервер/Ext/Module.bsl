Процедура ИтогСовпадаетСОборотамиВыручки() Экспорт

	Результат = Сформировать(Аргументы(Новый Структура("rows", 200)));

	ЮТест.ОжидаетЧто(Результат.columns[0].name).Равно("Контрагент");
	ЮТест.ОжидаетЧто(Результат.totals.Получить("Сумма")).Равно(ОборотВыручки());
	ЮТест.ОжидаетЧто(Результат.row_count > 10).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.truncated).Равно(Ложь);
	ЮТест.ОжидаетЧто(СуммаКолонки(Результат, "Сумма")).Равно(ОборотВыручки());
	ЮТест.ОжидаетЧто(Результат.source.period.from).Равно("2016-01-01");
	ЮТест.ОжидаетЧто(Результат.source.description).Содержит("Продажи по контрагентам");

	Урезанный = Сформировать(Аргументы(Новый Структура("rows", 3)));
	ЮТест.ОжидаетЧто(Урезанный.rows).ИмеетДлину(3);
	ЮТест.ОжидаетЧто(Урезанный.truncated).Равно(Истина);
	ЮТест.ОжидаетЧто(Урезанный.totals.Получить("Сумма")).Равно(ОборотВыручки());

КонецПроцедуры

Процедура ОтборПоКонтрагентуСужаетОтчет() Экспорт

	Покупатель = КрупныйПокупатель();
	Отбор = Новый Структура("field, op, value", "Контрагент", "eq", ИИО_Ответ.СсылкаВСтроку(Покупатель));
	Результат = Сформировать(Аргументы(Новый Структура("filters",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Отбор))));

	ЮТест.ОжидаетЧто(Результат.rows).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Результат.rows[0][0].ref).Равно(ИИО_Ответ.СсылкаВСтроку(Покупатель));
	ЮТест.ОжидаетЧто(Результат.totals.Получить("Сумма")).Равно(ОборотВыручки(Покупатель));
	ЮТест.ОжидаетЧто(Результат.source.filters[0].value.ref).Равно(ИИО_Ответ.СсылкаВСтроку(Покупатель));

КонецПроцедуры

Процедура РасшифровкаДоДокументов() Экспорт

	Покупатель = КрупныйПокупатель();
	Параметры = Новый Структура;
	ОтборПокупателя = Новый Структура("field, value", "Контрагент", ИИО_Ответ.СсылкаВСтроку(Покупатель));
	Параметры.Вставить("filters", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОтборПокупателя));
	Параметры.Вставить("group_by", СтрРазделить("Контрагент,Документ", ","));
	Параметры.Вставить("rows", 200);
	Результат = Сформировать(Аргументы(Параметры));

	ЮТест.ОжидаетЧто(Результат.columns[1].name).Равно("Документ");
	ЮТест.ОжидаетЧто(Результат.rows.Количество() > 1).Равно(Истина);
	Для Каждого СтрокаОтчета Из Результат.rows Цикл
		ЮТест.ОжидаетЧто(СтрокаОтчета[0].ref).Равно(ИИО_Ответ.СсылкаВСтроку(Покупатель));
		ЮТест.ОжидаетЧто(СтрокаОтчета[1].ref).НачинаетсяС("Документ.");
	КонецЦикла;
	ЮТест.ОжидаетЧто(СуммаКолонки(Результат, "Сумма")).Равно(ОборотВыручки(Покупатель));

КонецПроцедуры

Процедура РозницаПодписанаКакВОтчете() Экспорт

	Результат = Сформировать(Аргументы(Новый Структура("rows", 200)));

	Розница = Неопределено;
	Для Каждого СтрокаОтчета Из Результат.rows Цикл
		Если Не СтрокаОтчета[0].Свойство("ref") Тогда
			Розница = СтрокаОтчета[0];
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Розница).Заполнено();
	ЮТест.ОжидаетЧто(Розница.presentation).Равно("Розничные покупатели");

