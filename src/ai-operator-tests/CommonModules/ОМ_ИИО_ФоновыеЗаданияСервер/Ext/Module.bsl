// Тесты решения об ожидании фонового задания модели, общего для канала MCP и канала бота:
// готово с wait_ms, лимит очереди до старта, таймаут от старта, срок хода и текст таймаута канала бота.
// Состояние задания и моменты времени задаются в тесте. Настоящее задание запускает только тест канала бота:
// он ждет его через ИИО_ФоновыеЗадания.Дождаться.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Решение об ожидании")
		.ДобавитьТест("ГотовыйОтветПолучаетВремяОжидания")
		.ДобавитьТест("ОшибкаЗаданияВозвращаетсяКакЕсть")
		.ДобавитьТест("ЛимитОчередиОтменяетНеНачатоеЗадание")
		.ДобавитьТест("ЛимитОчередиНеОтменяетНачатоеЗадание")
		.ДобавитьТест("ТаймаутОтсчитываетсяОтСтарта")
		.ДобавитьТест("ТаймаутОтчетаСоСвоимКодом")
		.ДобавитьТест("КаналБотаСообщаетВремяВызова")
		.ДобавитьТест("СрокХодаПрерываетОжидание")
		.ДобавитьТест("БотЖдетЗаданиеИСообщаетВремяВызова");

КонецПроцедуры

#Область Тесты

Процедура ГотовыйОтветПолучаетВремяОжидания() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 1000);
	Ответ = Новый Структура("rows, run_ms", Новый Массив, 300);

	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина, Ответ), 1500);

	ЮТест.ОжидаетЧто(Решение.Отменить).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Решение.Ответ.wait_ms, "время вызова за вычетом работы задания").Равно(200);
	ЮТест.ОжидаетЧто(Решение.Ответ).НеИмеетСвойства("run_ms");

КонецПроцедуры

Процедура ОшибкаЗаданияВозвращаетсяКакЕсть() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 0);
	Ошибка = ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", "Деление на 0");

	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина, Ошибка), 500);

	ЮТест.ОжидаетЧто(Решение.Отменить).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("INVALID_ARGUMENT");
	ЮТест.ОжидаетЧто(Решение.Ответ).НеИмеетСвойства("wait_ms");

КонецПроцедуры

Процедура ЛимитОчередиОтменяетНеНачатоеЗадание() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 0);

	ЮТест.ОжидаетЧто(ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 120000),
		"на границе лимита еще ждем").ЭтоНеопределено();
	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 120001);

	ЮТест.ОжидаетЧто(Решение.Отменить).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("NOT_READY");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.message)
		.Равно("Задание не начало выполняться за 120 с и отменено: база занята своими фоновыми заданиями.");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.hint).Содержит("Повтори через пару минут");

КонецПроцедуры

// Лимит очереди - только до старта: начатое задание с таймаутом больше лимита ждут дальше.
Процедура ЛимитОчередиНеОтменяетНачатоеЗадание() Экспорт

	Запуск = НовыйЗапуск("query");
	Запуск.ТаймаутСек = 300;
	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(Запуск, 0);
	ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина), 100000);

	ЮТест.ОжидаетЧто(ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 120001))
		.ЭтоНеопределено();

КонецПроцедуры

Процедура ТаймаутОтсчитываетсяОтСтарта() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 0);

	ЮТест.ОжидаетЧто(ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина), 100000))
		.ЭтоНеопределено();
	ЮТест.ОжидаетЧто(Ожидание.Старт, "старт отмечен при первой проверке, где задание начато").Равно(100000);
	ЮТест.ОжидаетЧто(ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 110000),
		"очередь после старта не считается, таймаут - на границе").ЭтоНеопределено();
	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 110001);

	ЮТест.ОжидаетЧто(Решение.Отменить).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("QUERY_TIMEOUT");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.message, "в канале MCP - таймаут задания")
		.Равно("Запрос не выполнился за 10 с и отменен.");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.hint).Содержит("Сузь отбор");
	ЮТест.ОжидаетЧто(Ожидание.Настройка.ОписаниеВыполнения).Равно("Запрос выполняется");

КонецПроцедуры

Процедура ТаймаутОтчетаСоСвоимКодом() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("report"), 0);
	ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина), 1000);

	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 11001);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("REPORT_TIMEOUT");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.message).Равно("Отчет не сформировался за 10 с и отменен.");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.hint).Содержит("Сузь период");
	ЮТест.ОжидаетЧто(Ожидание.Настройка.ОписаниеВыполнения).Равно("Отчет формируется");

КонецПроцедуры

Процедура КаналБотаСообщаетВремяВызова() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 0, Неопределено, Истина);
	ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Истина), 50000);

	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 60400);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("QUERY_TIMEOUT");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.message, "в канале бота - время от вызова, округленное")
		.Равно("Запрос не выполнился за 60 с и отменен.");

КонецПроцедуры

Процедура СрокХодаПрерываетОжидание() Экспорт

	Ожидание = ИИО_ФоновыеЗаданияКлиентСервер.НовоеОжидание(НовыйЗапуск("query"), 0, 30000, Истина);

	ЮТест.ОжидаетЧто(ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 30000))
		.ЭтоНеопределено();
	Решение = ИИО_ФоновыеЗаданияКлиентСервер.Решение(Ожидание, НовоеСостояние(Ложь), 30001);

	ЮТест.ОжидаетЧто(Решение.Отменить, "срок хода раньше лимита очереди").ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Решение.Ответ)).Равно("QUERY_TIMEOUT");
	ЮТест.ОжидаетЧто(Решение.Ответ.error.message).Равно("Запрос не выполнился за 30 с и отменен.");

КонецПроцедуры

// Канал бота ждет задание на сервере и сообщает время от вызова, а не таймаут задания: вызов начался 50 с назад,
// срок хода - через 1 с, задание (пауза 10 с) к сроку не завершается и отменяется.
Процедура БотЖдетЗаданиеИСообщаетВремяВызова() Экспорт

	Запуск = ИИО_ФоновыеЗадания.Запустить("ИИО_ФоновыеЗадания.Подождать", 10, "ИИ-оператор: тест ожидания", 7,
		"report");
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Ответ = ИИО_ФоновыеЗадания.Дождаться(Запуск, Сейчас - 50000, Сейчас + 1000);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.КодОшибки(Ответ)).Равно("REPORT_TIMEOUT");
	ЮТест.ОжидаетЧто(Ответ.error.message, "время от вызова, а не таймаут задания 7 с")
		.Содержит("не сформировался за 5");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Запуск задания, как его возвращает ИИО_ФоновыеЗадания.Запустить: таймаут 10 с, очередь 120 с.
//
// Параметры:
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ФоновыеЗадания.Запустить
Функция НовыйЗапуск(Вид)

	Возврат Новый Структура("ИдентификаторЗадания, АдресРезультата, ТаймаутСек, ОжиданиеОчередиСек, Вид, Ответ",
		Новый УникальныйИдентификатор, "", 10, 120, Вид, Неопределено);

КонецФункции

// Состояние задания, как его возвращает ИИО_ФоновыеЗаданияВызовСервера.СостояниеЗадания.
//
// Параметры:
//  Начат - Булево
//  Ответ - Структура, Неопределено - Ответ завершенного задания.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ФоновыеЗаданияВызовСервера.СостояниеЗадания
Функция НовоеСостояние(Начат, Ответ = Неопределено)

	Возврат Новый Структура("Начат, Ответ", Начат, Ответ);

КонецФункции

#КонецОбласти
