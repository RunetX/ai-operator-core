// Тесты серверных проверок формы «Состояние ИИ-оператора» (этап 3д, Р-2): на исправном стенде проверки ядра,
// прав и журнала - ок; выключенный уровень «Информация» дает ошибку с действием и включается обратно; пакет
// со старым ядром или другим уровнем API несовместим; ping сообщает журнал и пакеты. Поставляемые профили
// доступа ИИ-оператора (Р-3) создаются БСП, администратор включает пользователя в группу «ИИ-оператор».

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Состояние ИИ-оператора")
		.ДобавитьТест("НаИсправномСтендеЯдроПраваИЖурналВПорядке")
		.ДобавитьТест("ВыключенныйЖурналДаетОшибкуИВключается")
		.ДобавитьТест("ПакетТребуетЯдроНеСтаршеМинимальнойВерсии")
		.ДобавитьТест("PingСообщаетЖурналИПакеты")
		.ДобавитьТестовыйНабор("Профили доступа")
		.ДобавитьТест("ПоставляемыеПрофилиСРолямиИИОператора")
		.ДобавитьТест("ПользовательВключаетсяВГруппуИИОператор");

КонецПроцедуры

#Область Тесты

Процедура НаИсправномСтендеЯдроПраваИЖурналВПорядке() Экспорт

	Проверки = ПроверкиПоКоду(ИИО_Диагностика.Проверки());
	Группы = ИИО_Диагностика.Группы();
	Для Каждого КлючИЗначение Из Проверки Цикл
		Проверка = КлючИЗначение.Значение;
		ЮТест.ОжидаетЧто(СтрРазделить("ok,warning,error,skipped", ",").Найти(Проверка.Статус), Проверка.Код)
			.НеРавно(Неопределено);
		ЮТест.ОжидаетЧто(Группы.Свойство(Проверка.Группа), Проверка.Код).ЭтоИстина();
		ЮТест.ОжидаетЧто(Проверка.Текст, Проверка.Код).Заполнено();
	КонецЦикла;
	Для Каждого Код Из СтрРазделить("core.version,core.safe_mode,extensions.flags,rights.role,"
		+ "eventlog.info", ",") Цикл
		ЮТест.ОжидаетЧто(Проверки.Получить(Код), Код).Заполнено();
		ЮТест.ОжидаетЧто(Проверки.Получить(Код).Статус, Код).Равно("ok");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Проверки.Получить("core.version").Текст).Содержит(ИИО_Настройки.ВерсияРасширения());
	ЮТест.ОжидаетЧто(Проверки.Получить("masking.fulltext"), "masking.fulltext").Заполнено();

КонецПроцедуры

// Уровень журнала регистрации - настройка базы: тест возвращает ее, даже если упал.
Процедура ВыключенныйЖурналДаетОшибкуИВключается() Экспорт

	ИсходныеУровни = ПолучитьИспользованиеЖурналаРегистрации();
	// Набор уровней сплошной: без «Информации» остаются только ошибки и предупреждения.
	УровниБезИнформации = Новый Массив;
	УровниБезИнформации.Добавить(УровеньЖурналаРегистрации.Ошибка);
	УровниБезИнформации.Добавить(УровеньЖурналаРегистрации.Предупреждение);
	Попытка
		УстановитьИспользованиеЖурналаРегистрации(УровниБезИнформации);
		Проверка = ПроверкиПоКоду(ИИО_Диагностика.Проверки()).Получить("eventlog.info");
		ЮТест.ОжидаетЧто(Проверка.Статус).Равно("error");
		ЮТест.ОжидаетЧто(Проверка.Действие).Равно("enable_log");

		Результат = ИИО_Диагностика.ВключитьЖурнал();
		ЮТест.ОжидаетЧто(Результат.ok).ЭтоИстина();
		Проверка = ПроверкиПоКоду(ИИО_Диагностика.Проверки()).Получить("eventlog.info");
		ЮТест.ОжидаетЧто(Проверка.Статус).Равно("ok");
	Исключение
		УстановитьИспользованиеЖурналаРегистрации(ИсходныеУровни);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьИспользованиеЖурналаРегистрации(ИсходныеУровни);

КонецПроцедуры

Процедура ПакетТребуетЯдроНеСтаршеМинимальнойВерсии() Экспорт

	Сведения = Новый Структура("Расширение, Версия, МинимальнаяВерсияЯдра, ВерсияКонтрактаЯдра", "ИИОператор_Тест", "1.0.0.0",
		"0.1.15.0", 1);
	ЮТест.ОжидаетЧто(ИИО_Диагностика.ПроверкаВерсииПакета("package.test", Сведения, "0.1.15.0", 1).Статус).Равно("ok");
	ЮТест.ОжидаетЧто(ИИО_Диагностика.ПроверкаВерсииПакета("package.test", Сведения, "0.2.0.0", 1).Статус).Равно("ok");
	Проверка = ИИО_Диагностика.ПроверкаВерсииПакета("package.test", Сведения, "0.1.14.9", 1);
	ЮТест.ОжидаетЧто(Проверка.Статус).Равно("error");
	ЮТест.ОжидаетЧто(Проверка.Текст).Содержит("0.1.15.0").Содержит("0.1.14.9");

	// Другой уровень API несовместим и с новым ядром.
	Проверка = ИИО_Диагностика.ПроверкаВерсииПакета("package.test", Сведения, "0.2.0.0", 2);
	ЮТест.ОжидаетЧто(Проверка.Статус).Равно("error");
	ЮТест.ОжидаетЧто(Проверка.Текст).Содержит("API ядра 1").Содержит("API 2");

КонецПроцедуры

Процедура PingСообщаетЖурналИПакеты() Экспорт

	Сведения = ИИО_СведенияВызовСервера.Сведения();
	ЮТест.ОжидаетЧто(Сведения.event_log_info).Равно(ИИО_Журнал.ЖурналДействийВключен());
	ЮТест.ОжидаетЧто(Сведения.packages).ИмеетТип("Массив");
	Для Каждого Пакет Из Сведения.packages Цикл
		ЮТест.ОжидаетЧто(Пакет.name).Заполнено();
		ЮТест.ОжидаетЧто(Пакет.version).Заполнено();
	КонецЦикла;

КонецПроцедуры

// Профили создает БСП при заполнении параметров работы расширений - тот же вызов делает установщик.
Процедура ПоставляемыеПрофилиСРолямиИИОператора() Экспорт

	РегистрыСведений.ПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
	Профиль = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИИО_Права.ИдентификаторПрофиляИИОператор());
	ЮТест.ОжидаетЧто(Профиль, "профиль «ИИ-оператор»").Заполнено();
	Роли = РолиПрофиля(Профиль);
	ЮТест.ОжидаетЧто(Роли).Содержит("ИИО_ПользовательИИОператора");
	ЮТест.ОжидаетЧто(Роли).НеСодержит("ИИО_АдминистраторИИОператора");

	Профиль = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИИО_Права.ИдентификаторПрофиляАдминистратор());
	ЮТест.ОжидаетЧто(Профиль, "профиль «ИИ-оператор: администратор»").Заполнено();
	Роли = РолиПрофиля(Профиль);
	ЮТест.ОжидаетЧто(Роли).Содержит("ИИО_ПользовательИИОператора");
	ЮТест.ОжидаетЧто(Роли).Содержит("ИИО_АдминистраторИИОператора");

КонецПроцедуры

// Тестовый пользователь без пользователя ИБ: группа доступа хранит ссылку на элемент справочника.
Процедура ПользовательВключаетсяВГруппуИИОператор() Экспорт

	Объект = Справочники.Пользователи.СоздатьЭлемент();
	Объект.Наименование = "ИИО тест группы доступа " + Новый УникальныйИдентификатор;
	Объект.Записать();
	Пользователь = Объект.Ссылка;
	Если УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИИО_Права.ИдентификаторПрофиляИИОператор()) = Неопределено Тогда
		РегистрыСведений.ПараметрыРаботыВерсийРасширений.ОбновитьПараметрыРаботыРасширений();
	КонецЕсли;
	Попытка
		ЮТест.ОжидаетЧто(ИИО_Права.ВГруппеИИОператор(Пользователь)).ЭтоЛожь();
		Результат = ИИО_Права.ДобавитьВГруппуИИОператор(Пользователь);
		ЮТест.ОжидаетЧто(Результат.ok, Результат.error).ЭтоИстина();
		ЮТест.ОжидаетЧто(ИИО_Права.ВГруппеИИОператор(Пользователь)).ЭтоИстина();
	Исключение
		УдалитьТестовогоПользователя(Пользователь);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьТестовогоПользователя(Пользователь);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РолиПрофиля(Профиль)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РолиПрофиля.Роль.Имя КАК Имя
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК РолиПрофиля
	|ГДЕ
	|	РолиПрофиля.Ссылка = &Профиль";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Имя");

КонецФункции

// Убирает пользователя из групп доступа (личную группу упрощенной настройки прав - целиком) и удаляет его.
Процедура УдалитьТестовогоПользователя(Пользователь)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Участники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК Участники
	|ГДЕ
	|	Участники.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Группа = Выборка.Ссылка.ПолучитьОбъект();
		Группа.Заблокировать();
		Если Группа.Пользователь = Пользователь Тогда
			Группа.Удалить();
			Продолжить;
		КонецЕсли;
		Группа.Пользователи.Удалить(Группа.Пользователи.Найти(Пользователь, "Пользователь"));
		Группа.Записать();
	КонецЦикла;
	ОбъектПользователя = Пользователь.ПолучитьОбъект();
	ОбъектПользователя.Заблокировать();
	ОбъектПользователя.Удалить();

КонецПроцедуры

Функция ПроверкиПоКоду(Проверки)

	Результат = Новый Соответствие;
	Для Каждого Проверка Из Проверки Цикл
		Результат.Вставить(Проверка.Код, Проверка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
