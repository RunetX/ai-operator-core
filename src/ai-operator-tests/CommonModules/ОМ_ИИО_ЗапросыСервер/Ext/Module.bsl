Процедура НаименованиеЮрлицаОткрытоФизлицаСкрыто() Экспорт

	Текст = "ВЫБРАТЬ К.Наименование КАК Имя, К.ИНН КАК ИНН, ПРЕДСТАВЛЕНИЕ(К.Ссылка) КАК Представление
	|ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И К.ИНН <> """" И К.ЮридическоеФизическоеЛицо = &Вид";

	Физлица = ИИО_Запросы.ВыполнитьЗапрос(Подготовить(Текст, 1,
		Новый Структура("Вид", "Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо")));
	Юрлица = ИИО_Запросы.ВыполнитьЗапрос(Подготовить(Текст, 1,
		Новый Структура("Вид", "Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо")));

	Для Индекс = 0 По 2 Цикл
		ЮТест.ОжидаетЧто(Юрлица.rows[0][Индекс], "юрлицо, колонка " + Индекс).ИмеетТип("Строка");
		ЮТест.ОжидаетЧто(Физлица.rows[0][Индекс].pii, "физлицо, колонка " + Индекс).Равно(?(Индекс = 1, "ИНН", "ФИО"));
	КонецЦикла;

