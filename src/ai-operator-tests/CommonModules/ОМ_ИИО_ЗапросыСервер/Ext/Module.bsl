	ЮТест.ОжидаетЧто(СтрСоединить(Таблицы["Остатки"].params, ",")).Равно("Период,Условие");
	ЮТест.ОжидаетЧто(Таблицы["Обороты"].fields).Содержит("СуммаПриход").Содержит("СуммаРасход");
	ЮТест.ОжидаетЧто(Таблицы["ОстаткиИОбороты"].fields).Содержит("СуммаКонечныйОстаток");
	// Измерения уже есть в dimensions и в полях виртуальных таблиц не повторяются.
	ЮТест.ОжидаетЧто(Таблицы["Остатки"].fields).НеСодержит("Контрагент");
	ЮТест.ОжидаетЧто(Курсы.virtual_table_fields[0].fields).Содержит("Период").Содержит("Курс");

