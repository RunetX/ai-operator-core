#Область СлужебныеПроцедурыИФункции
Функция КодыПредупреждений(Подготовленный)

	Коды = Новый Массив;
	Для Каждого Предупреждение Из Подготовленный.Предупреждения Цикл
		Коды.Добавить(Предупреждение.code);
	КонецЦикла;
	Возврат СтрСоединить(Коды, ",");

КонецФункции

Функция Подсказка(Текст)

	Ответ = ИИО_Запросы.ПодготовитьЗапрос(Текст, Неопределено, 10);
	Если ИИО_ОтветКлиентСервер.КодОшибки(Ответ) <> "QUERY_SYNTAX" Тогда
		ВызватьИсключение "Ожидалась ошибка QUERY_SYNTAX: " + Текст;
	КонецЕсли;
	Возврат Ответ.error.hint;

КонецФункции

Функция ОбщаяПодсказкаКОшибке()

	Возврат НСтр("ru = 'Исправь запрос: место ошибки отмечено {(строка, колонка)} и маркером <<?>>. Точные имена объектов и полей дает describe_metadata.'");

КонецФункции

Функция Подготовить(Текст, Лимит, Параметры = Неопределено)

	Подготовленный = ИИО_Запросы.ПодготовитьЗапрос(Текст, Параметры, Лимит);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		ВызватьИсключение Подготовленный.error.message;
	КонецЕсли;
	Возврат Подготовленный;

КонецФункции

Функция ВидыПДн(Текст, Параметры = Неопределено)

	Возврат СтрСоединить(Подготовить(Текст, 10, Параметры).ВидыПДнКолонок, ",");

КонецФункции

Функция ТекстЗапросаСПараметрами()

	Возврат "ВЫБРАТЬ Р.Ссылка КАК Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р
	|ГДЕ Р.Дата МЕЖДУ &Начало И &Конец И (Р.Контрагент = &Контрагент ИЛИ Р.Контрагент В (&Список))";

КонецФункции

Функция Контрагент(ВидЛица)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И К.ЮридическоеФизическоеЛицо = &ВидЛица");
	Запрос.УстановитьПараметр("ВидЛица", ВидЛица);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("В демо-базе нет контрагента вида %1", ВидЛица);
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
