Процедура ПоляВиртуальныхТаблицВОписанииРегистра() Экспорт

	Описание = ИИО_Метаданные.Описать(Новый Структура("name", "РегистрНакопления.ПрочиеРасчеты"));
	Курсы = ИИО_Метаданные.Описать(Новый Структура("name", "РегистрСведений.КурсыВалют"));

	Таблицы = Новый Соответствие;
