#Область СлужебныеПроцедурыИФункции

// Колонки ответа для сборки файла: у первой есть заголовок, у остальных только имя, как в run_query.
//
// Возвращаемое значение:
//  Массив из Структура
Функция Колонки()

	Колонки = Новый Массив;
	Колонки.Добавить(Новый Структура("name, title, type", "Контрагент", "Покупатель", "Строка"));
	Колонки.Добавить(Новый Структура("name, type", "Сумма", "Число"));
	Колонки.Добавить(Новый Структура("name, type", "Дата", "Дата"));
	Возврат Колонки;

КонецФункции

Функция ЗначенияСтроки(Первое, Второе, Третье)

	Значения = Новый Массив;
	Значения.Добавить(Первое);
	Значения.Добавить(Второе);
	Значения.Добавить(Третье);
	Возврат Значения;

КонецФункции

// Весь текст XLSX одной строкой: лист, общие строки и остальные части распакованного файла.
// Файл распаковывается во временный каталог теста: ЧтениеZipФайла работает с файлом, а не с потоком.
//
// Параметры:
//  Данные - ДвоичныеДанные - Файл XLSX.
//
// Возвращаемое значение:
//  Строка
Функция СодержимоеXLSX(Данные)

	Путь = ПолучитьИмяВременногоФайла("xlsx");
	Данные.Записать(Путь);
	Каталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(Каталог);
	Чтение = Новый ЧтениеZipФайла(Путь);
	Чтение.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	Чтение.Закрыть();
	Тексты = Новый Массив;
	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.xml", Ложь) Цикл
		Текст = Новый ЧтениеТекста(Найденный.ПолноеИмя, КодировкаТекста.UTF8);
		Тексты.Добавить(Текст.Прочитать());
		Текст.Закрыть();
	КонецЦикла;
	УдалитьФайлы(Путь);
	УдалитьФайлы(Каталог);
	Возврат СтрСоединить(Тексты, Символы.ПС);

КонецФункции

#КонецОбласти
