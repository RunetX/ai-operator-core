#Область Тесты

Процедура ШапкаИЗначенияПопадаютВТаблицу() Экспорт

	Контрагент = ОМ_ИИО_ПоискСервер.Контрагент(Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	Строки = Новый Массив;
	Строки.Добавить(ЗначенияСтроки(ИИО_Ответ.ЗначениеСПДн("Иванов Иван Иванович", "ФИО"), 1234.56, '20160331'));
	Строки.Добавить(ЗначенияСтроки(Новый Структура("presentation", "Розничные покупатели"), 0, Неопределено));
	Строки.Добавить(ЗначенияСтроки(Контрагент.Ссылка, -5, '20160331120000'));
	Строки.Добавить(ЗначенияСтроки("Физлицо", 0, ИИО_Ответ.ЗначениеСПДн('19800512', "ДатаРождения")));
	Строки.Добавить(ЗначенияСтроки(ИИО_Ответ.ЗначениеСПДн("2016-03-31T12:00:00 перенос визита", "ПДн"), 0,
		Неопределено));

	Файл = ИИО_Файлы.НовыйФайл("Проверка", Колонки(), Строки);

	Документ = Файл.Документ;
	ЮТест.ОжидаетЧто(Файл.Строк).Равно(5);
	ЮТест.ОжидаетЧто(Документ.ВысотаТаблицы).Равно(6);
	// Заголовок колонки - title, а если его нет (run_query), имя колонки.
	ЮТест.ОжидаетЧто(Документ.Область(1, 1).Текст).Равно("Покупатель");
	ЮТест.ОжидаетЧто(Документ.Область(1, 2).Текст).Равно("Сумма");
	// В файл идет реальное значение поля с ПДн: файл уходит пользователю, а не модели.
	ЮТест.ОжидаетЧто(Документ.Область(2, 1).Текст).Равно("Иванов Иван Иванович");
	ЮТест.ОжидаетЧто(Документ.Область(2, 2).Значение).Равно(1234.56);
	ЮТест.ОжидаетЧто(Документ.Область(2, 2).СодержитЗначение).Равно(Истина);
	ЮТест.ОжидаетЧто(Документ.Область(2, 3).Значение).Равно('20160331');
	ЮТест.ОжидаетЧто(Документ.Область(3, 1).Текст).Равно("Розничные покупатели");
	ЮТест.ОжидаетЧто(Документ.Область(3, 3).Текст).Равно("");
	ЮТест.ОжидаетЧто(Документ.Область(4, 1).Текст).Равно(Строка(Контрагент.Ссылка));
	// Дата из поля с ПДн приходит строкой ISO (ее уже преобразовали для модели), а в файле снова дата.
	ЮТест.ОжидаетЧто(Документ.Область(5, 3).Значение).Равно('19800512');
	ЮТест.ОжидаетЧто(Документ.Область(5, 3).СодержитЗначение).Равно(Истина);
	// А текст поля с ПДн остается текстом целиком, даже если начинается отметкой времени.
	ЮТест.ОжидаетЧто(Документ.Область(6, 1).Текст).Равно("2016-03-31T12:00:00 перенос визита");

КонецПроцедуры

Процедура ИмяФайлаОчищаетсяИОграничивается() Экспорт

	// Имя файла - латиницей и цифрами (542 п. 4.1), русское название остается заголовком окна.
	Файл = ИИО_Файлы.НовыйФайл("Продажи: 1 кв/2016", Колонки(), Новый Массив);
	ЮТест.ОжидаетЧто(Файл.Заголовок).Равно("Продажи: 1 кв/2016");
	ЮТест.ОжидаетЧто(Файл.Имя).Содержит("2016");
	ЮТест.ОжидаетЧто(Файл.Имя).НеСодержит("кв");
	ЮТест.ОжидаетЧто(Файл.Имя).НеСодержит("/");
	ЮТест.ОжидаетЧто(Файл.Имя).НеСодержит(":");
	// Замененный символ рядом с пробелом не дает двойного пробела: «Prodazhi 1 kv 2016», а не «Prodazhi  1».
	ЮТест.ОжидаетЧто(Файл.Имя).НеСодержит("  ");
	ЮТест.ОжидаетЧто(СтрЗаканчиваетсяНа(Файл.Имя, ".xlsx")).Равно(Истина);
	// Название не просто вычищено, а транслитерировано: иначе от русских слов остались бы одни пробелы.
	ЮТест.ОжидаетЧто(Файл.Имя).Содержит("Prodazhi");
	ЮТест.ОжидаетЧто(Файл.Строк).Равно(0);

	Длинный = ИИО_Файлы.НовыйФайл(СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("a", 200), Колонки(),
		Новый Массив);
	ЮТест.ОжидаетЧто(СтрДлина(Длинный.Имя)).Равно(85);
	Безымянный = ИИО_Файлы.НовыйФайл("", Колонки(), Новый Массив);
	ЮТест.ОжидаетЧто(Безымянный.Имя).Равно("export.xlsx");
	ЮТест.ОжидаетЧто(Безымянный.Заголовок).Равно("export.xlsx");

КонецПроцедуры

Процедура ЧислоВФайлеОстаетсяЧислом() Экспорт

	Строки = Новый Массив;
	Строки.Добавить(ЗначенияСтроки("Покупатель", 1234.56, '20160331'));
	Строки.Добавить(ЗначенияСтроки("Физлицо", 0, ИИО_Ответ.ЗначениеСПДн('19800512', "ДатаРождения")));
	Данные = ИИО_Файлы.ДвоичныеДанныеXLSX(ИИО_Файлы.НовыйФайл("Проверка", Колонки(), Строки));

	// XLSX - это zip: помощник его распаковывает и на другом формате падает сам.
	Содержимое = СодержимоеXLSX(Данные);

	// Число лежит в ячейке числом, а не отформатированным текстом: только такое Excel сложит и отсортирует.
	ЮТест.ОжидаетЧто(Содержимое).Содержит("<v>1234.56</v>");
	ЮТест.ОжидаетЧто(Содержимое).НеСодержит("1 234,56");
	// Дату платформа выгружает в XLSX текстом, но по формату ячейки - без нулевого времени.
	ЮТест.ОжидаетЧто(Содержимое).Содержит("31.03.2016");
	ЮТест.ОжидаетЧто(Содержимое).НеСодержит("31.03.2016 0:00:00");
	// Дата из поля с ПДн тоже остается датой, а не техническим ISO-текстом для модели.
	ЮТест.ОжидаетЧто(Содержимое).Содержит("12.05.1980");
	ЮТест.ОжидаетЧто(Содержимое).НеСодержит("1980-05-12");
	ЮТест.ОжидаетЧто(Содержимое).Содержит("Покупатель");

КонецПроцедуры

Процедура ЗапросФайломОтдаетИмяБезСтрок() Экспорт

	Текст =
	"ВЫБРАТЬ
	|	Реализации.Ссылка КАК Ссылка,
	|	Реализации.Дата КАК Дата,
	|	Реализации.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации";
	Подготовленный = ИИО_Запросы.ПодготовитьЗапрос(Текст, Неопределено, 5, Истина);
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный)).Равно(Ложь);

	Результат = ИИО_Запросы.ВыполнитьЗапрос(Подготовленный);

	ЮТест.ОжидаетЧто(Результат).НеИмеетСвойства("rows");
	ЮТест.ОжидаетЧто(Результат.columns).ИмеетДлину(3);
	ЮТест.ОжидаетЧто(СтрЗаканчиваетсяНа(Результат.file.name, ".xlsx")).Равно(Истина);
	ЮТест.ОжидаетЧто(Результат.file.rows).Больше(0);
	// Сам файл лежит под русским ключом: его забирает канал, модели он не уходит.
	Файл = ИИО_ОтветКлиентСервер.ИзвлечьФайл(Результат);
	ЮТест.ОжидаетЧто(Файл.Заголовок).НачинаетсяС("Запрос ");
	ЮТест.ОжидаетЧто(Файл.Имя).Равно(Результат.file.name);
	ЮТест.ОжидаетЧто(Файл.Документ.ВысотаТаблицы).Равно(Файл.Строк + 1);
	ЮТест.ОжидаетЧто(Результат).НеИмеетСвойства("Файл");

КонецПроцедуры

Процедура ОтчетФайломУходитВФайлыХодаБезКнопки() Экспорт

	Аргументы = ОМ_ИИО_ОтчетыСервер.Аргументы(Новый Структура("file", Истина));
	// Лимит строк файла виден уже в подготовке - без построения отчета.
	Подготовленный = ИИО_Отчеты.ПодготовитьФормирование(Аргументы);
	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Подготовленный.Строк).Равно(ИИО_Файлы.ЛимитСтрок());
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();

	Ответ = ИИО_РеестрИнструментов.Вызвать("run_report", Аргументы, Контекст);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), ИИО_ОтветКлиентСервер.ВJSON(Ответ)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("rows");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("totals");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("Файл");
	ЮТест.ОжидаетЧто(Ответ.row_count).Больше(0);
	ЮТест.ОжидаетЧто(Ответ.file.rows).Равно(Ответ.row_count);
	// Имя файла - от варианта отчета и периода, как заголовок его окна.
	ЮТест.ОжидаетЧто(Ответ.file.name).Содержит("01.01.2016");
	ЮТест.ОжидаетЧто(Контекст.Файлы).ИмеетДлину(1);
	Файл = Контекст.Файлы[0];
	ЮТест.ОжидаетЧто(Файл.Имя).Равно(Ответ.file.name);
	ЮТест.ОжидаетЧто(Файл.Заголовок).Содержит("Продажи");
	ЮТест.ОжидаетЧто(Файл.Документ.ВысотаТаблицы).Равно(Файл.Строк + 1);
	// Файл заменяет кнопку «Открыть отчет»: пользователь просил файл, а не отчет на экране.
	ЮТест.ОжидаетЧто(Контекст.Кнопки).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("button");

КонецПроцедуры

Процедура ФайлХодаПопадаетВКонтекстБота() Экспорт

	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова();
	Текст =
	"ВЫБРАТЬ
	|	Реализации.Ссылка КАК Ссылка,
	|	Реализации.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации";
	Аргументы = Новый Структура("text, file", Текст, Истина);

	Ответ = ИИО_РеестрИнструментов.Вызвать("run_query", Аргументы, Контекст);

	ЮТест.ОжидаетЧто(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ), ИИО_ОтветКлиентСервер.ВJSON(Ответ)).Равно(Ложь);
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("rows");
	ЮТест.ОжидаетЧто(Ответ).НеИмеетСвойства("Файл");
	ЮТест.ОжидаетЧто(Контекст.Файлы).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Контекст.Файлы[0].Имя).Равно(Ответ.file.name);
	ЮТест.ОжидаетЧто(Контекст.Файлы[0].Строк).Равно(Ответ.file.rows);

КонецПроцедуры

