#Область СлужебныеПроцедурыИФункции

// Возвращает наименование и ИНН первого контрагента вида с заполненным ИНН.
//
// Параметры:
//  ВидЛица - ПеречислениеСсылка.ЮридическоеФизическоеЛицо
//
// Возвращаемое значение:
//  Структура:
//   * Наименование - Строка
//   * ИНН - Строка
Функция РеквизитыКонтрагента(ВидЛица)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 К.Наименование КАК Наименование, К.ИНН КАК ИНН ИЗ Справочник.Контрагенты КАК К
		|ГДЕ НЕ К.ЭтоГруппа И К.ЮридическоеФизическоеЛицо = &ВидЛица И К.ИНН <> """"");
	Запрос.УстановитьПараметр("ВидЛица", ВидЛица);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("В демо-базе нет контрагента вида %1 с ИНН", ВидЛица);
	КонецЕсли;
	Возврат Новый Структура("Наименование, ИНН", Выборка.Наименование, Выборка.ИНН);

КонецФункции

Функция ЗаписиРеестра()

	Набор = РегистрыСведений.ИИО_МаскируемыеПоля.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Возврат Набор.Выгрузить();

КонецФункции

// Возвращает записи реестра до теста: тест меняет общие настройки маскирования и должен их вернуть.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Выгрузка набора записей регистра ИИО_МаскируемыеПоля.
Функция СохранитьРеестр()

	Возврат ЗаписиРеестра();

КонецФункции

Процедура ВосстановитьРеестр(Записи)

	Набор = РегистрыСведений.ИИО_МаскируемыеПоля.СоздатьНаборЗаписей();
	Набор.Загрузить(Записи);
	Набор.Записать();

КонецПроцедуры

Функция СтрокиПреднастройки()

	Строки = Новый Массив;
	Для Каждого Строка Из ИИО_Маскирование.ПравилаДляНастройки() Цикл
		Если Строка.ЕстьВПреднастройке Тогда
			Строка.ВидПДн = Строка.ВидПреднастройки;
			Строка.Условие = Строка.УсловиеПреднастройки;
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;

КонецФункции

Функция Контрагент(ВидЛица)

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка ИЗ Справочник.Контрагенты КАК К
	|ГДЕ НЕ К.ЭтоГруппа И К.ЮридическоеФизическоеЛицо = &ВидЛица");
	Запрос.УстановитьПараметр("ВидЛица", ВидЛица);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон("В демо-базе нет контрагента вида %1", ВидЛица);
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти
