Процедура ЮрлицоОткрываетсяФизлицоСкрытоПоЗначению() Экспорт

	Юрлицо = РеквизитыКонтрагента(Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
	Физлицо = РеквизитыКонтрагента(Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо);
	ВидИмени = ИИО_Маскирование.ВидПДнПоля("Справочник.Контрагенты", "Наименование");
	ВидИНН = ИИО_Маскирование.ВидПДнПоля("Справочник.Контрагенты", "ИНН");
	Данные = Новый Структура;
	Данные.Вставить("company", ИИО_Ответ.ЗначениеСПДн(Юрлицо.Наименование, ВидИмени));
	Данные.Вставить("company_inn", ИИО_Ответ.ЗначениеСПДн(Юрлицо.ИНН, ВидИНН));
	Данные.Вставить("person", ИИО_Ответ.ЗначениеСПДн(Физлицо.Наименование, ВидИмени));
	Данные.Вставить("person_inn", ИИО_Ответ.ЗначениеСПДн(Физлицо.ИНН, ВидИНН));
	// Значения нет в поле объекта: по нему не понять, чье оно, поэтому оно скрыто.
	Данные.Вставить("glued", ИИО_Ответ.ЗначениеСПДн(Юрлицо.Наименование + "!", ВидИмени));

	Результат = ИИО_Ответ.ДанныеДляМодели(Данные);

	ЮТест.ОжидаетЧто(Результат.company).Равно(Юрлицо.Наименование);
	ЮТест.ОжидаетЧто(Результат.company_inn).Равно(Юрлицо.ИНН);
	ЮТест.ОжидаетЧто(Результат.person.pii).Равно("ФИО");
	ЮТест.ОжидаетЧто(Результат.person_inn.pii).Равно("ИНН");
	ЮТест.ОжидаетЧто(Результат.glued.pii).Равно("ФИО");

КонецПроцедуры

Процедура КонтекстПДнСодержитЛюдейИзРеквизитов() Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Р.Ссылка КАК Ссылка, Р.Ответственный КАК Ответственный
	|ИЗ Документ.РеализацияТоваровУслуг КАК Р ГДЕ Р.Ответственный <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Контекст = ИИО_Маскирование.КонтекстПДн(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Выборка.Ссылка));

	ЮТест.ОжидаетЧто(Контекст).Содержит(Пользователи.ТекущийПользователь());
	ЮТест.ОжидаетЧто(Контекст).Содержит(Выборка.Ответственный);
	ЮТест.ОжидаетЧто(ИИО_Маскирование.КонтекстПДн(Новый Массив)).ИмеетДлину(0);

КонецПроцедуры

Процедура РеестрМеняетПреднастройкуИХранитТолькоОтличия() Экспорт

	Сохраненные = СохранитьРеестр();
	Попытка
		Строки = ИИО_Маскирование.ПравилаДляНастройки();
		Для Каждого Строка Из Строки Цикл
			Если Строка.Объект = "Справочник.ФизическиеЛица" И Строка.Поле = "ИНН" Тогда
				Строка.ВидПДн = "";
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "Наименование", "ПДн", ""));

		Ошибки = ИИО_Маскирование.ЗаписатьПравила(Строки);
		Правила = ИИО_Маскирование.ДействующиеПравила();

		ЮТест.ОжидаетЧто(Ошибки).ИмеетДлину(0);
		ЮТест.ОжидаетЧто(ЗаписиРеестра().Количество()).Равно(2);
		ЮТест.ОжидаетЧто(Правила.Получить("Справочник.ФизическиеЛица").Поля.Получить("ИНН")).ЭтоНеопределено();
		ЮТест.ОжидаетЧто(Правила.Получить("Справочник.ФизическиеЛица").Поля.Получить("СтраховойНомерПФР"))
			.Равно("СНИЛС");
		ЮТест.ОжидаетЧто(Правила.Получить("Справочник.Номенклатура").Поля.Получить("Наименование")).Равно("ПДн");

		// Повторная запись действующих правил ничего не меняет, а строки преднастройки очищают регистр.
		Ошибки = ИИО_Маскирование.ЗаписатьПравила(ИИО_Маскирование.ПравилаДляНастройки());
		ЮТест.ОжидаетЧто(Ошибки).ИмеетДлину(0);
		ЮТест.ОжидаетЧто(ЗаписиРеестра().Количество()).Равно(2);
		ИИО_Маскирование.ЗаписатьПравила(СтрокиПреднастройки());
		ЮТест.ОжидаетЧто(ЗаписиРеестра().Количество()).Равно(0);
	Исключение
		ВосстановитьРеестр(Сохраненные);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьРеестр(Сохраненные);

КонецПроцедуры

Процедура ОшибкиПравилПеречисляютсяИНичегоНеЗаписывается() Экспорт

	Сохраненные = СохранитьРеестр();
	Попытка
		Строки = Новый Массив;
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.НетТакого", "Имя", "ФИО", ""));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "НетТакогоПоля", "ФИО", ""));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "", "ФИО", "Т.НетПоля = 1"));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "Артикул", "[ФИО#1]", ""));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "Код", "ПДн", "Т.Код = 1"));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "Наименование", "ПДн", ""));
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			"Справочник.Номенклатура", "Наименование", "ФИО", ""));

		Ошибки = ИИО_Маскирование.ЗаписатьПравила(Строки);

		ЮТест.ОжидаетЧто(Ошибки).ИмеетДлину(6);
		ЮТест.ОжидаетЧто(Ошибки[0]).Содержит("Справочник.НетТакого");
		ЮТест.ОжидаетЧто(Ошибки[1]).Содержит("НетТакогоПоля");
		ЮТест.ОжидаетЧто(Ошибки[5]).Содержит("уже есть");
		ЮТест.ОжидаетЧто(ЗаписиРеестра().Количество()).Равно(Сохраненные.Количество());
	Исключение
		ВосстановитьРеестр(Сохраненные);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьРеестр(Сохраненные);

