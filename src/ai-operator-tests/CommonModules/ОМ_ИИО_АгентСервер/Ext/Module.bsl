// Ответ run_query для признаков трудного ответа: одна строка и, если код задан, предупреждение 3в.
//
// Параметры:
//  КодПредупреждения - Строка - Пустая строка - ответ без предупреждений.
//
// Возвращаемое значение:
//  Структура
Функция ОтветЗапроса(КодПредупреждения)

	Ответ = Новый Структура("rows", Новый Массив);
	Если ЗначениеЗаполнено(КодПредупреждения) Тогда
		Предупреждения = Новый Массив;
		Предупреждения.Добавить(Новый Структура("code, message", КодПредупреждения, "Проверь, какой регистр нужен."));
		Ответ.Вставить("warnings", Предупреждения);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Запись журнала обмена хода в разговоре Ключ, сделанного не раньше Начало.
//
// Параметры:
//  Ключ - Строка - Ключ разговора.
//  Начало - Дата
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - см. ИИО_Журнал.ОбменСМоделью
Функция ЗаписьЖурнала(Ключ, Начало)

	Записи = ИИО_Журнал.ОбменСМоделью(Начало - 1, ТекущаяДатаСеанса() + 1, Ложь);
	Запись = Записи.Найти(Ключ, "Разговор");
	ЮТест.ОжидаетЧто(Запись, "ход записан в журнал обмена").Заполнено();
	Возврат Запись;

КонецФункции

// Запись журнала обмена без хода агента.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//  Период - Дата
//  Канал - Строка - bot или mcp.
//  Поля - Структура, Неопределено - Остальные ресурсы записи: Скрыто, Вопрос, Признаки.
//
// Возвращаемое значение:
//  Строка - Ключ записи.
Функция ЗаписатьОбменНапрямую(Пользователь, Период, Канал = "bot", Поля = Неопределено)

	Ключ = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.ИИО_ОбращенияКМодели.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.ДеньЗаписи = НачалоДня(Период);
	Запись.Ключ = Ключ;
	Запись.Автор = Пользователь;
	Запись.Канал = Канал;
	Если Поля <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Запись, Поля);
	КонецЕсли;
	Запись.Статус = "ok";
	Запись.Переписка = Новый ХранилищеЗначения("[]");
	УстановитьПривилегированныйРежим(Истина);
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ключ;

КонецФункции

// Маскированный вопрос записи журнала обмена: ИИО_Журнал.ОбменСМоделью его не выбирает.
//
// Параметры:
//  Ключ - Строка - Ключ записи.
//
// Возвращаемое значение:
//  Строка
Функция ВопросЗаписи(Ключ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Обмен.Вопрос КАК Вопрос
	|ИЗ
	|	РегистрСведений.ИИО_ОбращенияКМодели КАК Обмен
	|ГДЕ
	|	Обмен.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", Ключ);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "запись журнала").ЭтоИстина();
	Возврат Выборка.Вопрос;

КонецФункции

