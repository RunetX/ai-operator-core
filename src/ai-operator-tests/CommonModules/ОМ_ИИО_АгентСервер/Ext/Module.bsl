// Журнал хранит запрос ровно в том виде, в каком его видела модель: телефон - токеном, а не цифрами.
Процедура ЖурналХранитТоЧтоВиделаМодель() Экспорт

	УстановитьМодель(НедоступныйАдрес(), "test-model");
	Ключ = НовыйКлюч();
	Начало = ТекущаяДатаСеанса();

	ИИО_Агент.ВыполнитьХод(ИИО_Диалоги.Диалог(Ключ), "Перезвони по номеру 8 916 123-45-67 насчет отгрузки");

	Запись = ЗаписьЖурнала(Ключ, Начало);
	ЮТест.ОжидаетЧто(Запись.Канал).Равно("bot");
	ЮТест.ОжидаетЧто(Запись.Статус).Равно("model_unavailable");
	ЮТест.ОжидаетЧто(Запись.Модель).Равно("test-model");
	ЮТест.ОжидаетЧто(Запись.Скрыто).Равно("Телефон 1");
	Переписка = ИИО_Журнал.ПерепискаОбмена(Запись.Ключ);
	ЮТест.ОжидаетЧто(Переписка).Содержит("Перезвони по номеру [Телефон#1] насчет отгрузки");
	ЮТест.ОжидаетЧто(Переписка).НеСодержит("123-45-67");

КонецПроцедуры

Процедура СвоиЗаписиОтдельноОтЧужих() Экспорт

	Начало = ТекущаяДатаСеанса();
	Свой = ЗаписатьОбменНапрямую(Пользователи.ТекущийПользователь(), Начало);
	Чужой = ЗаписатьОбменНапрямую(ДругойПользователь(), Начало);

	Свои = ИИО_Журнал.ОбменСМоделью(Начало - 60, Начало + 60, Ложь);
	ЮТест.ОжидаетЧто(Свои.Найти(Свой, "Ключ")).Заполнено();
	ЮТест.ОжидаетЧто(Свои.Найти(Чужой, "Ключ")).НеЗаполнено();
	Если ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		Все = ИИО_Журнал.ОбменСМоделью(Начало - 60, Начало + 60, Истина);
		ЮТест.ОжидаетЧто(Все.Найти(Чужой, "Ключ")).Заполнено();
	КонецЕсли;

КонецПроцедуры

Процедура УстаревшийОбменУдаляется() Экспорт

	СрокДней = ИИО_Настройки.Значение("ИИО_СрокХраненияЖурналаОбменаДней");
	Устаревший = ЗаписатьОбменНапрямую(Пользователи.ТекущийПользователь(), ТекущаяДатаСеанса() - (СрокДней + 1) * 86400);
	Свежий = ЗаписатьОбменНапрямую(Пользователи.ТекущийПользователь(), ТекущаяДатаСеанса());

	ЮТест.ОжидаетЧто(ИИО_Журнал.УдалитьУстаревшийОбмен()).Больше(0);
	ЮТест.ОжидаетЧто(КоличествоЗаписейОбмена(Устаревший)).Равно(0);
	ЮТест.ОжидаетЧто(КоличествоЗаписейОбмена(Свежий)).Равно(1);

КонецПроцедуры

Процедура СводкаСчитаетРазныеТокены() Экспорт

	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
	Первый = ИИО_МаскированиеКлиентСервер.Замаскировать(Новый Структура("pii, value", "ФИО", "Тестов Тест"), Словарь);
	Второй = ИИО_МаскированиеКлиентСервер.Замаскировать(Новый Структура("pii, value", "ФИО", "Другов Друг"), Словарь);
	Телефон = ИИО_МаскированиеКлиентСервер.Замаскировать(Новый Структура("pii, value", "Телефон", "89161234567"), Словарь);
	Тексты = Новый Массив;
	// [ИНН#7] - пример из инструкций, в словаре его нет: он ничего не скрыл.
	Тексты.Добавить(Первый + " звонил " + Второй + " с " + Телефон + ", заявка [№ 12], пример [ИНН#7] и [ФИО#]");
	Тексты.Добавить("Повторно: " + Первый);
	Тексты.Добавить(Неопределено);

	ЮТест.ОжидаетЧто(ИИО_МаскированиеКлиентСервер.СводкаСкрытого(Тексты, Словарь)).Равно("ФИО 2, Телефон 1");

