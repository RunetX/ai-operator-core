// Запись журнала обмена хода в разговоре Ключ, сделанного не раньше Начало.
//
// Параметры:
//  Ключ - Строка - Ключ разговора.
//  Начало - Дата
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - см. ИИО_Журнал.ОбменСМоделью
Функция ЗаписьЖурнала(Ключ, Начало)

	Записи = ИИО_Журнал.ОбменСМоделью(Начало - 1, ТекущаяДатаСеанса() + 1, Ложь);
	Запись = Записи.Найти(Ключ, "Разговор");
	ЮТест.ОжидаетЧто(Запись, "ход записан в журнал обмена").Заполнено();
	Возврат Запись;

КонецФункции

Функция ЗаписатьОбменНапрямую(Пользователь, Период, Канал = "bot", Скрыто = "")

	Ключ = Строка(Новый УникальныйИдентификатор);
	Запись = РегистрыСведений.ИИО_ОбращенияКМодели.СоздатьМенеджерЗаписи();
	Запись.Период = Период;
	Запись.ДеньЗаписи = НачалоДня(Период);
	Запись.Ключ = Ключ;
	Запись.Автор = Пользователь;
	Запись.Канал = Канал;
	Запись.Скрыто = Скрыто;
	Запись.Статус = "ok";
	Запись.Переписка = Новый ХранилищеЗначения("[]");
	УстановитьПривилегированныйРежим(Истина);
	Запись.Записать();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Ключ;

КонецФункции

Функция КоличествоЗаписейОбмена(Ключ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.ИИО_ОбращенияКМодели КАК Обмен
	|ГДЕ
	|	Обмен.Ключ = &Ключ");
	Запрос.УстановитьПараметр("Ключ", Ключ);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Выборка.Следующий();
	Возврат Выборка.Количество;

КонецФункции

Функция ДругойПользователь()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Ссылка <> &Текущий");
	Запрос.УстановитьПараметр("Текущий", Пользователи.ТекущийПользователь());
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "в базе есть второй пользователь").ЭтоИстина();
	Возврат Выборка.Ссылка;

КонецФункции

