// Тесты агентного цикла канала бота (план 3а.3) и слоя модели в маскировании ввода
// без модели: разбор ответа, проверка адреса, ход без настроенной и при недоступной модели. Константы
// меняются в транзакции теста и откатываются. Ход с моделью - e2e tests/e2e/test_agent_server.py на моке.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Клиент модели")
		.ДобавитьТест("РассужденияУбираются")
		.ДобавитьТест("ЛокальныйАдресПроверяется")
		.ДобавитьТестовыйНабор("Ход агента")
		.ДобавитьТест("ХодБезМоделиОбъясняетНастройку").ВТранзакции()
		.ДобавитьТест("НедоступнаяМодельДаетПонятныйОтвет").ВТранзакции()
		.ДобавитьТестовыйНабор("Модель маскирования")
		.ДобавитьТест("НелокальнаяМодельМаскированияНеИспользуется").ВТранзакции()
		.ДобавитьТест("НедоступнаяМодельМаскированияЗаменяетсяЭвристикой").ВТранзакции();

КонецПроцедуры

#Область Тесты

Процедура РассужденияУбираются() Экспорт

	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.БезРассуждений("<think>посчитаю</think>Ответ: 5")).Равно("Ответ: 5");
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.БезРассуждений("А <think>1</think>Б<think>2</think> В")).Равно("А Б В");
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.БезРассуждений("Итог<think>не закрыто")).Равно("Итог");
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.БезРассуждений("Без рассуждений")).Равно("Без рассуждений");

КонецПроцедуры

Процедура ЛокальныйАдресПроверяется() Экспорт

	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("http://localhost:1234/v1")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("http://127.0.0.1:1234/v1")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("http://192.168.10.5/v1")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("http://172.20.0.7:8080")).ЭтоИстина();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("http://172.32.0.7")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("https://api.example.com/v1")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(ИИО_МодельHTTP.ЛокальныйАдрес("localhost:1234")).ЭтоЛожь();

КонецПроцедуры

Процедура ХодБезМоделиОбъясняетНастройку() Экспорт

	УстановитьМодель("", "");
	Диалог = ИИО_Диалоги.Диалог(НовыйКлюч());

	Результат = ИИО_Агент.ВыполнитьХод(Диалог, "Сколько заказов за вчера?");

	ЮТест.ОжидаетЧто(Результат.Статус).Равно("not_configured");
	ЮТест.ОжидаетЧто(Результат.Шаги).Равно(0);
	ЮТест.ОжидаетЧто(Результат.Ответ).Содержит("настройках ИИ-оператора");

КонецПроцедуры

Процедура НедоступнаяМодельДаетПонятныйОтвет() Экспорт

	УстановитьМодель(НедоступныйАдрес(), "test-model");
	Ключ = НовыйКлюч();
	Диалог = ИИО_Диалоги.Диалог(Ключ);

	Результат = ИИО_Агент.ВыполнитьХод(Диалог, "Позвони Абрамову насчет отгрузки");

	ЮТест.ОжидаетЧто(Результат.Статус).Равно("model_unavailable");
	ЮТест.ОжидаетЧто(Результат.Шаги).Равно(1);
	ЮТест.ОжидаетЧто(Результат.Ответ).Содержит("недоступна");
	// Неудачный ход не попадает в историю: следующий вопрос модель увидит без него.
	ЮТест.ОжидаетЧто(ИИО_Диалоги.Диалог(Ключ).История.Количество()).Равно(0);

КонецПроцедуры

Процедура НелокальнаяМодельМаскированияНеИспользуется() Экспорт

	Константы.ИИО_АдресМоделиМаскирования.Установить("https://api.example.com/v1");
	Константы.ИИО_ИмяМоделиМаскирования.Установить("test-model");
	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();

	Результат = ИИО_МаскированиеВвода.ЗамаскироватьВвод("Тимур с рампы сказал, что путевой лист у Ашота", Словарь);

	ЮТест.ОжидаетЧто(Результат.Проверка).Равно("эвристика");
	ЮТест.ОжидаетЧто(Результат.Текст).Равно("[ФИО#1] с рампы сказал, что путевой лист у [ФИО#2]");

КонецПроцедуры

Процедура НедоступнаяМодельМаскированияЗаменяетсяЭвристикой() Экспорт

	Константы.ИИО_АдресМоделиМаскирования.Установить(НедоступныйАдрес());
	Константы.ИИО_ИмяМоделиМаскирования.Установить("test-model");
	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();

	Результат = ИИО_МаскированиеВвода.ЗамаскироватьВвод("Тимур с рампы сказал, что путевой лист у Ашота", Словарь);

	ЮТест.ОжидаетЧто(Результат.Проверка).Равно("эвристика: модель не ответила");
	ЮТест.ОжидаетЧто(Результат.Текст).Равно("[ФИО#1] с рампы сказал, что путевой лист у [ФИО#2]");

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьМодель(Адрес, Имя)

	Константы.ИИО_АдресМодели.Установить(Адрес);
	Константы.ИИО_ИмяМодели.Установить(Имя);

КонецПроцедуры

// Адрес, по которому никто не слушает: порт 9 (discard) на этом компьютере. Соединение сразу отклоняется.
//
// Возвращаемое значение:
//  Строка
Функция НедоступныйАдрес()

	Возврат "http://localhost:9/v1";

КонецФункции

Функция НовыйКлюч()

	Возврат "test-agent-" + Строка(Новый УникальныйИдентификатор);

КонецФункции

#КонецОбласти
