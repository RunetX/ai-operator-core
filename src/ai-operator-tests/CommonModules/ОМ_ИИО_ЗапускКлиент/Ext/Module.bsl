// Тесты канала MCP на клиенте: список инструментов для транспорта, ответ infobase_info,
// отмена отложенного вызова клиентом MCP.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Список инструментов")
		.ДобавитьТест("ТранспортПолучаетВсеИнструментыРеестра")
		.ДобавитьТест("СведенияОБазеВФорматеСнимкаMCP")
		.ДобавитьТестовыйНабор("Отмена вызова")
		.ДобавитьТест("ОтменаОтложенногоВызоваСообщаетОбработчикуИЗакрываетВызов")
		.ДобавитьТест("ОтменаНеизвестногоИЗавершенногоВызоваНичегоНеДелает")
		.ДобавитьТест("ВызовБезИдентификатораНеОтменяется");

КонецПроцедуры

Процедура ПослеКаждогоТеста() Экспорт

	Реестр = ИИО_РеестрИнструментовКлиент.Инструменты();
	Реестр.Удалить(ИмяТестовогоИнструмента());
	ПараметрыПриложения.Удалить(ИмяПриемника());

КонецПроцедуры

// Обработчик тестового инструмента с отложенным ответом: запоминает вызов и подписывается на отмену.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Неопределено - Ответ отложен.
Функция ОтложенныйОбработчик(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Вызов = ПараметрыОбработчика.Вызов;
	Приемник().Вставить("Вызов", Вызов);
	Вызов.ОповещениеОбОтмене = Новый ОписаниеОповещения("ЗапомнитьОтмену", ОМ_ИИО_ЗапускКлиент);
	Возврат Неопределено;

КонецФункции

// Запоминает причину отмены, см. ИИО_РеестрИнструментовКлиент.Отменить.
//
// Параметры:
//  Причина - Строка
//  ДополнительныеПараметры - Неопределено
Процедура ЗапомнитьОтмену(Причина, ДополнительныеПараметры) Экспорт

	Приемник().Отмены.Добавить(Причина);

КонецПроцедуры

// Запоминает ответ, переданный вызывающему.
//
// Параметры:
//  Ответ - Структура
//  ДополнительныеПараметры - Неопределено
Процедура ЗапомнитьОтвет(Ответ, ДополнительныеПараметры) Экспорт

	Приемник().Ответы.Добавить(Ответ);

КонецПроцедуры

#Область Тесты

Процедура ТранспортПолучаетВсеИнструментыРеестра() Экспорт

	Описания = ИИО_ПровайдерMCPКлиент.ОписанияИнструментов();
	Реестр = ИИО_РеестрИнструментовКлиент.Инструменты();
	ЮТест.ОжидаетЧто(Описания.Количество()).Равно(Реестр.Количество());
	Имена = Новый Массив;
	Для Каждого Описание Из Описания Цикл
		Имена.Добавить(Описание.name);
		Инструмент = Реестр.Получить(Описание.name);
		ЮТест.ОжидаетЧто(Инструмент, Описание.name).Заполнено();
		ЮТест.ОжидаетЧто(Описание.description, Описание.name).Равно(Инструмент.Описание);
		ЮТест.ОжидаетЧто(Описание.inputSchema.type, Описание.name).Равно("object");
	КонецЦикла;
	ЮТест.ОжидаетЧто(Имена).Содержит("ping").Содержит("infobase_info").Содержит("perform");

КонецПроцедуры

// Описание и ключи ответа infobase_info зафиксированы снимком MCP: модель видит их неизменными.
Процедура СведенияОБазеВФорматеСнимкаMCP() Экспорт

	Описание = ИИО_РеестрИнструментовКлиент.Инструменты().Получить("infobase_info").Описание;
	ЮТест.ОжидаетЧто(Описание).Равно(
		"Возвращает сведения об информационной базе: версия платформы, конфигурации, расширения и др.");

	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать("infobase_info", Новый Структура,
		ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test"));
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЮТест.ОжидаетЧто(Ответ.Платформа.Версия).Равно(СистемнаяИнформация.ВерсияПриложения);
	ЮТест.ОжидаетЧто(Ответ.Платформа.ТипПлатформы).Равно(Строка(СистемнаяИнформация.ТипПлатформы));
	ЮТест.ОжидаетЧто(Ответ.Конфигурация.Имя).Равно("");
	ЮТест.ОжидаетЧто(Ответ.ВстроенныйЯзык).Равно("");
	ЮТест.ОжидаетЧто(Ответ.ФайловаяБаза).ИмеетТип("Булево");
	ЮТест.ОжидаетЧто(Ответ.Расширения.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.РасширенияДоступны).ЭтоЛожь();

КонецПроцедуры

Процедура ОтменаОтложенногоВызоваСообщаетОбработчикуИЗакрываетВызов() Экспорт

	ЗарегистрироватьТестовыйИнструмент();
	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать(ИмяТестовогоИнструмента(), Новый Структура, ПараметрыВызова("17"));
	ЮТест.ОжидаетЧто(Ответ).Равно(Неопределено);
	Вызов = Приемник().Вызов;
	ЮТест.ОжидаетЧто(Вызов.Завершен).ЭтоЛожь();

	ИИО_РеестрИнструментовКлиент.Отменить("test", "17", "client");
	ЮТест.ОжидаетЧто(Приемник().Отмены.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Приемник().Отмены[0]).Равно("client");
	ЮТест.ОжидаетЧто(Вызов.Завершен).ЭтоИстина();

	// Ответ после отмены вызывающему не уходит, повторная отмена ничего не делает.
	ИИО_РеестрИнструментовКлиент.Завершить(Вызов, Новый Структура("ok", Истина));
	ИИО_РеестрИнструментовКлиент.Отменить("test", "17", "client");
	ЮТест.ОжидаетЧто(Приемник().Ответы.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Приемник().Отмены.Количество()).Равно(1);

КонецПроцедуры

Процедура ОтменаНеизвестногоИЗавершенногоВызоваНичегоНеДелает() Экспорт

	ЗарегистрироватьТестовыйИнструмент();
	ИИО_РеестрИнструментовКлиент.Отменить("test", "нет-такого", "client");
	ИИО_РеестрИнструментовКлиент.Вызвать(ИмяТестовогоИнструмента(), Новый Структура, ПараметрыВызова("18"));
	Вызов = Приемник().Вызов;
	ИИО_РеестрИнструментовКлиент.Завершить(Вызов, Новый Структура("ok", Истина));
	ИИО_РеестрИнструментовКлиент.Отменить("test", "18", "client");
	ЮТест.ОжидаетЧто(Приемник().Ответы.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Приемник().Отмены.Количество()).Равно(0);

КонецПроцедуры

// Вызовы без идентификатора (журнал операций, кнопки бота) в учет отменяемых не попадают.
Процедура ВызовБезИдентификатораНеОтменяется() Экспорт

	ЗарегистрироватьТестовыйИнструмент();
	ИИО_РеестрИнструментовКлиент.Вызвать(ИмяТестовогоИнструмента(), Новый Структура, ПараметрыВызова(Неопределено));
	ИИО_РеестрИнструментовКлиент.Отменить("test", Неопределено, "client");
	ЮТест.ОжидаетЧто(Приемник().Отмены.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Приемник().Вызов.Завершен).ЭтоЛожь();
	ИИО_РеестрИнструментовКлиент.Завершить(Приемник().Вызов, Новый Структура("ok", Истина));
	ЮТест.ОжидаетЧто(Приемник().Ответы.Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьТестовыйИнструмент()

	Инструмент = ИИО_РеестрИнструментовКлиент.НовыйИнструмент(ИмяТестовогоИнструмента(),
		Новый ОписаниеОповещения("ОтложенныйОбработчик", ОМ_ИИО_ЗапускКлиент), , Истина);
	ИИО_РеестрИнструментовКлиент.Инструменты().Вставить(Инструмент.Имя, Инструмент);

КонецПроцедуры

Функция ПараметрыВызова(Идентификатор)

	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("test");
	ПараметрыВызова.Идентификатор = Идентификатор;
	ПараметрыВызова.ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗапомнитьОтвет", ОМ_ИИО_ЗапускКлиент);
	Возврат ПараметрыВызова;

КонецФункции

Функция Приемник()

	Приемник = ПараметрыПриложения.Получить(ИмяПриемника());
	Если Приемник = Неопределено Тогда
		Приемник = Новый Структура("Вызов, Отмены, Ответы", Неопределено, Новый Массив, Новый Массив);
		ПараметрыПриложения.Вставить(ИмяПриемника(), Приемник);
	КонецЕсли;
	Возврат Приемник;

КонецФункции

Функция ИмяПриемника()

	Возврат "ОМ_ИИО_ЗапускКлиент.Приемник";

КонецФункции

Функция ИмяТестовогоИнструмента()

	Возврат "test_deferred_cancel";

КонецФункции

#КонецОбласти
