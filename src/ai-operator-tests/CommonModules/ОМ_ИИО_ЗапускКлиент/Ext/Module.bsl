// Тесты запуска ИИ-оператора на клиенте: журнал client_mcp не выводит информационные сообщения в окна.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Запуск")
		.ДобавитьТест("ЖурналМспСПервойМинутыТолькоПредупрежденияИОшибки")
		.ДобавитьТест("НастройкаЖурналаМспНеВыключаетЕгоИФайл");

КонецПроцедуры

#Область Тесты

// Уровень ставит обработчик начала работы расширения - до того, как client_mcp зарегистрирует провайдеров.
Процедура ЖурналМспСПервойМинутыТолькоПредупрежденияИОшибки() Экспорт

	ЮТест.ОжидаетЧто(Мсп_ЛогированиеКлиент.ПараметрыЛогирования().УровеньЛога).Равно("warn");

КонецПроцедуры

Процедура НастройкаЖурналаМспНеВыключаетЕгоИФайл() Экспорт

	Параметры = Мсп_ЛогированиеКлиент.ПараметрыЛогирования();
	Было = Новый Структура("Логировать, ФайлЛога, УровеньЛога",
		Параметры.Логировать, Параметры.ФайлЛога, Параметры.УровеньЛога);
	Попытка
		Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Истина, "", "info");
		ИИО_СерверMCPКлиент.НастроитьЖурналMCP();
		Стало = Мсп_ЛогированиеКлиент.ПараметрыЛогирования();
		ЮТест.ОжидаетЧто(Стало.УровеньЛога).Равно("warn");
		ЮТест.ОжидаетЧто(Стало.Логировать).ЭтоИстина();
		ЮТест.ОжидаетЧто(Стало.ФайлЛога).Равно("");
	Исключение
		Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Было.Логировать, Было.ФайлЛога, Было.УровеньЛога);
		ВызватьИсключение;
	КонецПопытки;
	Мсп_ЛогированиеКлиент.УстановитьПараметрыЛогирования(Было.Логировать, Было.ФайлЛога, Было.УровеньЛога);

КонецПроцедуры

#КонецОбласти

#КонецОбласти
