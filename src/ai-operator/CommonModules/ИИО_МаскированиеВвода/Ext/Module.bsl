// Маскирование вопроса пользователя до отправки модели. Три слоя:
// 1. словарь диалога и шаблоны (ИИО_МаскированиеКлиентСервер.ЗамаскироватьТекст);
// 2. люди из базы: группа слов с заглавной буквы сверяется с объектами, у которых вид ПДн представления «ФИО».
//    Кандидатов дает полнотекстовый поиск платформы, а если он выключен - запрос по началу наименования;
//    каждого кандидата подтверждают формы склонения его ФИО. Человек из базы получает тот же токен,
//    что и ссылка на него в ответе инструмента;
// 3. эвристика для людей, которых в базе нет: инициалы, окончания фамилий, распространенные имена
//    (макет ИИО_ИменаЛюдей), прозвища по отчеству («Петрович»), слово после «водитель», «у» и т. п.;
//    адрес частного лица - «улица ... квартира N». Одно слово из макета ИИО_НазванияМест - город или техника,
//    а не человек.
// Списки ИИО_СловаМаскирования задают слова, которые скрываются всегда или не скрываются никогда.

#Область СлужебныйПрограммныйИнтерфейс

// Заменяет ПДн в тексте пользователя токенами словаря диалога.
//
// Параметры:
//  Текст - Строка - Вопрос пользователя.
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//  БезПолнотекстовогоПоиска - Булево - Искать людей только запросом, как при выключенном поиске:
//    для тестов и сравнения качества.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - Текст с токенами вместо ПДн.
//   * Замены - Массив из Структура - Что заменено, для проверки фразы и оценки качества:
//     ** Фрагмент - Строка - Исходный фрагмент текста.
//     ** Токен - Строка
//     ** Источник - Строка - «база», «эвристика», «список» или «словарь и шаблоны».
//   * ПоискВключен - Булево - Людей из базы искал полнотекстовый поиск, а не запрос по началу наименования.
//   * ПроверкаНеполная - Булево - Групп слов больше, чем проверяется по базе за один вызов: остальные
//     проверены только эвристикой.
//   * Проверка - Строка - Кто искал людей, которых нет в базе: «модель» (локальная модель маскирования),
//     «эвристика» (модель не задана) или «эвристика: модель не ответила».
Функция ЗамаскироватьВвод(Текст, Словарь, БезПолнотекстовогоПоиска = Ложь) Экспорт

	// Модель находит людей не из базы без ложных срабатываний эвристики, поэтому при ней эвристика выключена
	//. Исходный текст уходит только локальной модели.
	Модель = ИИО_МодельHTTP.ПараметрыМодели("маскирование");
	Если Модель.Настроена И Не ИИО_МодельHTTP.ЛокальныйАдрес(Модель.Адрес) Тогда
		ИИО_Журнал.ЗаписатьСобытие("МаскированиеВвода.Модель", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", НСтр("ru = 'Адрес модели маскирования не локальный: слой модели выключен.'")));
		Модель.Настроена = Ложь;
	КонецЕсли;
	Если Не Модель.Настроена Тогда
		Результат = ЗамаскироватьПравилами(Текст, Словарь, БезПолнотекстовогоПоиска, Истина);
		Результат.Вставить("Проверка", "эвристика");
		Возврат Результат;
	КонецЕсли;

	Результат = ЗамаскироватьПравилами(Текст, Словарь, БезПолнотекстовогоПоиска, Ложь);
	Люди = ЛюдиПоМодели(Результат.Текст, Модель);
	Если Люди = Неопределено Тогда
		Результат = ЗамаскироватьПравилами(Текст, Словарь, БезПолнотекстовогоПоиска, Истина);
		Результат.Вставить("Проверка", "эвристика: модель не ответила");
		Возврат Результат;
	КонецЕсли;
	Результат.Текст = ЗаменитьЛюдейМодели(Результат.Текст, Люди, Результат.Замены, Словарь);
	Результат.Вставить("Проверка", "модель");
	Возврат Результат;

КонецФункции

// Списки слов для формы настройки маскирования.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Слово - Строка
//   * ВидПДн - Строка - Вид ПДн, которым слово скрывается всегда, или пустая строка: не скрывать никогда.
Функция СловаДляНастройки() Экспорт

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СловаМаскирования.Слово КАК Слово,
	|	СловаМаскирования.ВидПДн КАК ВидПДн
	|ИЗ
	|	РегистрСведений.ИИО_СловаМаскирования КАК СловаМаскирования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Слово");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Слова = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Слова.Добавить(Новый Структура("Слово, ВидПДн", СокрЛП(Выборка.Слово), СокрЛП(Выборка.ВидПДн)));
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Проверяет списки слов из формы настройки, ничего не записывая.
//
// Параметры:
//  Строки - Массив из Структура - Слово, ВидПДн.
//
// Возвращаемое значение:
//  Массив из Строка - Ошибки проверки.
Функция ОшибкиСлов(Строки) Экспорт

	ВидыПДн = ИИО_Маскирование.ВидыПДн();
	Ошибки = Новый Массив;
	Ключи = Новый Соответствие;
	Для Индекс = 0 По Строки.ВГраница() Цикл
		Слово = СокрЛП(Строки[Индекс].Слово);
		Вид = СокрЛП(Строки[Индекс].ВидПДн);
		Ключ = НормализованноеСлово(Слово);
		Ошибка = "";
		Если Слово = "" Или СтрНайти(Слово, " ") > 0 Тогда
			Ошибка = НСтр("ru = 'нужно одно слово без пробелов.'");
		ИначеЕсли Вид <> "" И ВидыПДн.Найти(Вид) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'неизвестный вид ПДн «%1».'"), Вид);
		ИначеЕсли Ключи.Получить(Ключ) <> Неопределено Тогда
			Ошибка = НСтр("ru = 'это слово уже есть выше.'");
		КонецЕсли;
		Если Ошибка <> "" Тогда
			Ошибки.Добавить(СтрШаблон(НСтр("ru = 'Слово %1 (%2): %3'"), Формат(Индекс + 1, "ЧГ=0"), Слово, Ошибка));
		КонецЕсли;
		Ключи.Вставить(Ключ, Истина);
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

// Записывает списки слов из формы настройки, замещая прежние.
//
// Параметры:
//  Строки - Массив из Структура - Слово, ВидПДн.
//
// Возвращаемое значение:
//  Массив из Строка - Ошибки проверки, см. ОшибкиСлов. При ошибках ничего не записывается.
Функция ЗаписатьСлова(Строки) Экспорт

	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		ВызватьИсключение НСтр("ru = 'Списки слов маскирования меняет только администратор ИИ-оператора.'");
	КонецЕсли;
	Ошибки = ОшибкиСлов(Строки);
	Если Ошибки.Количество() > 0 Тогда
		Возврат Ошибки;
	КонецЕсли;
	Набор = РегистрыСведений.ИИО_СловаМаскирования.СоздатьНаборЗаписей();
	Для Каждого Строка Из Строки Цикл
		Запись = Набор.Добавить();
		Запись.Слово = СокрЛП(Строка.Слово);
		Запись.ВидПДн = СокрЛП(Строка.ВидПДн);
	КонецЦикла;
	// Набор без отбора замещает весь регистр.
	Набор.Записать();
	Возврат Ошибки;

КонецФункции

// Имена из макета ИИО_ИменаЛюдей. Для вызова используйте кэш сеанса ИИО_МаскированиеПовтИсп.ИменаЛюдей.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - Имя и его основа в нижнем регистре.
//   * Значение - Строка - «имя» или «слово», см. ВидИмени.
Функция ИменаЛюдей() Экспорт

	Имена = Новый Соответствие;
	Вид = "имя";
	Текст = ПолучитьОбщийМакет("ИИО_ИменаЛюдей").ПолучитьТекст();
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Строка = СокрЛП(Строка);
		Если Строка = "" Или СтрНачинаетсяС(Строка, "#") Тогда
			Продолжить;
		ИначеЕсли СтрНачинаетсяС(Строка, "[") Тогда
			Вид = "слово";
			Продолжить;
		КонецЕсли;
		Ключ = НормализованноеСлово(Строка);
		Имена.Вставить(Ключ, Вид);
		Основа = ОсноваИмени(Ключ);
		Если СтрДлина(Основа) > 3 Тогда
			Имена.Вставить(Основа, Вид);
			Продолжить;
		КонецЕсли;
		// Короткая основа совпадает с обычными словами («Вася» - «вас», «Надя» - «над», «Майя» - «май»):
		// вместо нее - падежные формы.
		Если Основа <> Ключ Тогда
			Для Каждого Окончание Из СтрРазделить("ы,и,е,у,ю,ой,ей,ою,ею", ",") Цикл
				Имена.Вставить(Основа + Окончание, Вид);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Имена);

КонецФункции

// Названия мест и техники из макета ИИО_НазванияМест. Для вызова используйте кэш сеанса
// ИИО_МаскированиеПовтИсп.НазванияМест.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - Название и его основа в нижнем регистре.
//   * Значение - Строка - «место», «фамилия» (город, совпадающий с фамилией) или «техника», см. ВидНазвания.
Функция НазванияМест() Экспорт

	Названия = Новый Соответствие;
	Вид = "место";
	Текст = ПолучитьОбщийМакет("ИИО_НазванияМест").ПолучитьТекст();
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Строка = СокрЛП(Строка);
		Если Строка = "" Или СтрНачинаетсяС(Строка, "#") Тогда
			Продолжить;
		ИначеЕсли СтрНачинаетсяС(Строка, "[") Тогда
			Вид = ?(СтрНайти(Строка, "техника") > 0, "техника", "фамилия");
			Продолжить;
		КонецЕсли;
		Ключ = НормализованноеСлово(Строка);
		Названия.Вставить(Ключ, Вид);
		// Падежные формы города-фамилии («Чехову») - те же, что у фамилии: сравнивается только название.
		Если Вид <> "фамилия" Тогда
			Названия.Вставить(ОсноваМеста(Ключ), Вид);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Названия);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Маскирование правилами: словарь и шаблоны, адреса частных лиц, люди из базы и, если задано, эвристика.
//
// Параметры:
//  Текст - Строка
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//  БезПолнотекстовогоПоиска - Булево
//  СЭвристикой - Булево - Искать людей не из базы эвристикой.
//
// Возвращаемое значение:
//  см. ЗамаскироватьВвод
Функция ЗамаскироватьПравилами(Текст, Словарь, БезПолнотекстовогоПоиска, СЭвристикой)

	Замены = Новый Массив;
	ТекстСлоя = ИИО_МаскированиеКлиентСервер.ЗамаскироватьТекст(Текст, Словарь);
	ДобавитьЗаменыСловаря(Замены, Текст, ТекстСлоя, Словарь);

	ПоискВключен = Не БезПолнотекстовогоПоиска И ПолнотекстовыйПоискВключен();
	Списки = СписокСлов();
	Слова = СловаТекста(ТекстСлоя, Словарь);
	Найденные = Новый Массив;
	Адреса = АдресаЛюдей(ТекстСлоя, Слова, Словарь);
	Для Каждого Находка Из Адреса.Находки Цикл
		Найденные.Добавить(Находка);
	КонецЦикла;
	Кэш = Новый Соответствие;
	Поисков = 0;
	ПроверкаНеполная = Ложь;
	Для Каждого Группа Из ГруппыСлов(Слова, Списки, Найденные, Словарь, Адреса.Слова) Цикл
		// «Из Иванова приехали», «Рейс Королев - Мытищи»: первое слово с заглавной только потому, что начинает
		// предложение, а за ним место. Не человек ни для базы, ни для эвристики.
		Если ЭтоМесто(Группа) Или ЕстьХвостГруппы(Группа) И ЭтоМесто(ГруппаБезПервогоСлова(Группа)) Тогда
			Продолжить;
		КонецЕсли;
		// База проверяется для первых групп, эвристика - для всех: длинный текст не пропускает имена молча.
		Токен = "";
		ГруппаИмени = Группа;
		Если Поисков < МаксимумПоисков() Тогда
			Поисков = Поисков + 1;
			Токен = ТокенЧеловекаИзБазы(Группа, ПоискВключен, Кэш, Словарь);
			// «Позвони Абрамову»: первое слово с заглавной только потому, что начинает предложение.
			Если Токен = "" И ЕстьХвостГруппы(Группа) Тогда
				Токен = ТокенЧеловекаИзБазы(ГруппаБезПервогоСлова(Группа), ПоискВключен, Кэш, Словарь);
				Если Токен <> "" Тогда
					ГруппаИмени = ГруппаБезПервогоСлова(Группа);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПроверкаНеполная = Истина;
		КонецЕсли;
		Источник = "база";
		Если Токен = "" Тогда
			ГруппаИмени = ГруппаДляЭвристики(Группа);
			Если СЭвристикой И Не ГруппаИмени.Строчная И ЭтоИмяПоПризнакам(ГруппаИмени) Тогда
				ТекстИмени = ТекстГруппы(ГруппаИмени, ТекстСлоя);
				Токен = ИИО_МаскированиеКлиентСервер.Токен("ФИО", "value:ФИО:" + ТекстИмени, ТекстИмени, Словарь);
				Источник = "эвристика";
			КонецЕсли;
		КонецЕсли;
		Если Токен <> "" Тогда
			Найденные.Добавить(НоваяНаходка(ГруппаИмени.Слова[0].Начало,
				ГруппаИмени.Слова[ГруппаИмени.Слова.ВГраница()].Конец, Токен, Источник));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура("Текст, Замены, ПоискВключен, ПроверкаНеполная",
		ЗаменитьНайденное(ТекстСлоя, Найденные, Замены), Замены, ПоискВключен, ПроверкаНеполная);
	Возврат Результат;

КонецФункции

#Область Слова

// Разбирает текст на слова вне токенов маскирования.
//
// Параметры:
//  Текст - Строка
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Число - Позиция первого символа.
//   * Конец - Число - Позиция последнего символа, у инициала - точки после буквы.
//   * Слово - Строка - Слово без точки инициала.
//   * Инициал - Булево - Заглавная буква с точкой.
//   * Заглавное - Булево - Слово начинается с заглавной буквы.
//   * НачалоПредложения - Булево - Слово первое в тексте, строке или после «.», «!», «?».
//   * ВКавычках - Булево - Слово внутри кавычек: обычно это название организации или товара.
//   * Перед - Строка - Символы между предыдущим словом и этим.
//   * Индекс - Число - Индекс слова в массиве.
Функция СловаТекста(Текст, Словарь)

	Слова = Новый Массив;
	Длина = СтрДлина(Текст);
	НачалоПредложения = Истина;
	ВКавычках = Ложь;
	КонецПредыдущего = 0;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		КонецТокена = КонецТокена(Текст, Позиция, Словарь);
		Если КонецТокена > 0 Тогда
			Позиция = КонецТокена + 1;
			НачалоПредложения = Ложь;
			Продолжить;
		КонецЕсли;
		Если Не ЭтоБуква(Символ) Тогда
			Если Символ = "." И ЭтоСокращение(Слова, Позиция) Тогда
				// «ул. Ленина», «г. Тула»: точка сокращения не начинает предложение.
				НачалоПредложения = Ложь;
			ИначеЕсли Символ = "." Или Символ = "!" Или Символ = "?" Или Символ = Символы.ПС Тогда
				НачалоПредложения = Истина;
			ИначеЕсли Символ = "«" Или Символ = """" И Не ВКавычках Тогда
				// Кавычка без пары (10" - дюймы) не прячет от проверки весь остаток текста.
				ВКавычках = СтрНайти(Текст, ?(Символ = "«", "»", """"), НаправлениеПоиска.СНачала, Позиция + 1) > 0;
			ИначеЕсли Символ = "»" Или Символ = """" Тогда
				ВКавычках = Ложь;
			КонецЕсли;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Начало = Позиция;
		Пока Позиция <= Длина И (ЭтоБуква(Сред(Текст, Позиция, 1))
			Или Сред(Текст, Позиция, 1) = "-" И ЭтоБуква(Сред(Текст, Позиция + 1, 1))) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Слово = Сред(Текст, Начало, Позиция - Начало);
		Заглавное = ЭтоЗаглавная(Лев(Слово, 1));
		Инициал = СтрДлина(Слово) = 1 И Заглавное И Сред(Текст, Позиция, 1) = ".";
		Если Инициал Тогда
			Позиция = Позиция + 1;
		КонецЕсли;
		Описание = Новый Структура("Начало, Конец, Слово, Инициал, Заглавное, НачалоПредложения, ВКавычках, Перед,
			|Индекс", Начало, Позиция - 1, Слово, Инициал, Заглавное, НачалоПредложения, ВКавычках,
			Сред(Текст, КонецПредыдущего + 1, Начало - КонецПредыдущего - 1), Слова.Количество());
		Слова.Добавить(Описание);
		КонецПредыдущего = Позиция - 1;
		НачалоПредложения = Ложь;
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Стоит ли точка в позиции сразу после короткого слова со строчной буквы: «ул.», «г.», «д.».
//
// Параметры:
//  Слова - см. СловаТекста
//  Позиция - Число - Позиция точки.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоСокращение(Слова, Позиция)

	Если Слова.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Последнее = Слова[Слова.ВГраница()];
	Возврат Последнее.Конец = Позиция - 1 И Не Последнее.Заглавное И СтрДлина(Последнее.Слово) <= 3;

КонецФункции

// Позиция «]» токена маскирования из словаря, который начинается в позиции, или 0.
// Скобки пользователя («[Петров Иван, заявка #12]») токеном не считаются и проверяются как текст.
//
// Параметры:
//  Текст - Строка
//  Позиция - Число
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Число
Функция КонецТокена(Текст, Позиция, Словарь)

	Если Сред(Текст, Позиция, 1) <> "[" Тогда
		Возврат 0;
	КонецЕсли;
	Конец = СтрНайти(Текст, "]", НаправлениеПоиска.СНачала, Позиция);
	Если Конец = 0 Или Словарь.Исходные.Получить(Сред(Текст, Позиция, Конец - Позиция + 1)) = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Конец;

КонецФункции

// Собирает группы подряд идущих слов с заглавной буквы и инициалов - кандидатов в ФИО.
// Слова из списков ИИО_СловаМаскирования в группы не входят: «всегда скрывать» сразу дают токен,
// «никогда не скрывать» пропускаются.
//
// Параметры:
//  Слова - см. СловаТекста
//  Списки - см. СписокСлов
//  Найденные - Массив из см. НоваяНаходка - Пополняется словами из списка «всегда скрывать».
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//  Занятые - Соответствие - Индексы слов, уже вошедших в найденный адрес.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Слова - Массив из см. СловаТекста
//   * Предыдущее - Строка - Предыдущее слово предложения в нижнем регистре или пустая строка.
//   * Предпредыдущее - Строка - Слово перед предыдущим: «диспетчер перевозчика Цой».
//   * Следующее - Строка - Слово того же предложения после группы в нижнем регистре или пустая строка.
//   * Строчная - Булево - Одно слово со строчной буквы и окончанием фамилии («напиши усорину»):
//     сверяется только с базой, эвристика его не скрывает.
//   * ПослеОрганизации - Булево - Последние два слова группы после «ООО», «ТК»: «ТК Деловые Линии Оксана
//     Петровна». Эвристика скрывает их, только если там есть имя или отчество.
Функция ГруппыСлов(Слова, Списки, Найденные, Словарь, Занятые)

	Группы = Новый Массив;
	Группа = Неопределено;
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Описание = Слова[Индекс];
		Если Занятые.Получить(Индекс) <> Неопределено Тогда
			Группа = Неопределено;
			Продолжить;
		КонецЕсли;
		Ключ = НормализованноеСлово(Описание.Слово);
		ВидПДн = Списки.Получить(Ключ);
		Если ВидПДн <> Неопределено Тогда
			Группа = Неопределено;
			Если ВидПДн <> "" Тогда
				Найденные.Добавить(НоваяНаходка(Описание.Начало, Описание.Конец, ИИО_МаскированиеКлиентСервер.Токен(
					ВидПДн, "value:" + ВидПДн + ":" + Ключ, Описание.Слово, Словарь), "список"));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Строчная = ЭтоСтрочнаяФамилия(Описание);
		Если Не МожетБытьЧастьюФИО(Описание) И Не Строчная Тогда
			Группа = Неопределено;
			Продолжить;
		КонецЕсли;
		// «М.Видео»: инициал, слитный со словом без окончания фамилии, - название, а не «И.Иванов».
		Если Группа <> Неопределено
			И Описание.Перед = ""
			И Не Описание.Инициал
			И Группа.Слова[Группа.Слова.ВГраница()].Инициал
			И Не ЕстьОкончаниеФамилии(Описание.Слово) Тогда
			Группа = Неопределено;
			Продолжить;
		КонецЕсли;
		Если Группа <> Неопределено И Не Строчная И Группа.Слова.Количество() < 4 И СокрЛП(Описание.Перед) = "" Тогда
			Группа.Слова.Добавить(Описание);
			Продолжить;
		КонецЕсли;
		Группа = НоваяГруппа(ПредыдущееСлово(Слова, Индекс, 1), ПредыдущееСлово(Слова, Индекс, 2), Строчная);
		Группа.Слова.Добавить(Описание);
		Группы.Добавить(Группа);
		Если Строчная Тогда
			Группа = Неопределено;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого Группа Из Группы Цикл
		Группа.Следующее = СледующееСлово(Слова, Группа.Слова[Группа.Слова.ВГраница()].Индекс);
		// «водитель с Ачинска Эркин Тойчубеков»: город перед именем в группу не входит.
		Если Группа.Слова.Количество() > 1
			И Не Группа.Слова[0].Инициал
			И ВидНазвания(Группа.Слова[0].Слово) <> ""
			И ЭтоПредлогМеста(Группа.Предыдущее) Тогда
			Группа = ГруппаБезПервогоСлова(Группа);
		КонецЕсли;
		Если Не ЕстьСловоБезИнициала(Группа) Тогда
			Продолжить;
		// «ТД Петрович» - организация, а «ТД00-000310 Яковлевой» - номер документа и человек.
		ИначеЕсли Не ЭтоОрганизация(Группа.Предыдущее) Или СокрЛП(Группа.Слова[0].Перед) <> "" Тогда
			Результат.Добавить(Группа);
		ИначеЕсли Группа.Слова.Количество() >= 3 Тогда
			Результат.Добавить(ХвостПослеОрганизации(Группа));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание группы слов, см. ГруппыСлов.
//
// Параметры:
//  Предыдущее - Строка
//  Предпредыдущее - Строка
//  Строчная - Булево
//
// Возвращаемое значение:
//  см. ГруппыСлов
Функция НоваяГруппа(Предыдущее, Предпредыдущее, Строчная)

	Возврат Новый Структура("Слова, Предыдущее, Предпредыдущее, Следующее, Строчная, ПослеОрганизации",
		Новый Массив, Предыдущее, Предпредыдущее, "", Строчная, Ложь);

КонецФункции

// Последние два слова группы после названия организации: само название скрывать не нужно.
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  см. ГруппыСлов
Функция ХвостПослеОрганизации(Группа)

	Последнее = Группа.Слова.ВГраница();
	Результат = НоваяГруппа(НормализованноеСлово(Группа.Слова[Последнее - 2].Слово), "", Ложь);
	Результат.ПослеОрганизации = Истина;
	Результат.Следующее = Группа.Следующее;
	Результат.Слова.Добавить(Группа.Слова[Последнее - 1]);
	Результат.Слова.Добавить(Группа.Слова[Последнее]);
	Возврат Результат;

КонецФункции

// Группа без первого слова: предыдущим словом становится отброшенное.
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  см. ГруппыСлов
Функция ГруппаБезПервогоСлова(Группа)

	Результат = НоваяГруппа(НормализованноеСлово(Группа.Слова[0].Слово), "", Ложь);
	Результат.Следующее = Группа.Следующее;
	Для Индекс = 1 По Группа.Слова.ВГраница() Цикл
		Результат.Слова.Добавить(Группа.Слова[Индекс]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Есть ли у группы в начале предложения хвост, который стоит проверить без первого слова.
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  Булево
Функция ЕстьХвостГруппы(Группа)

	Возврат Группа.Слова.Количество() > 1 И Группа.Слова[0].НачалоПредложения
		И ЕстьСловоБезИнициала(ГруппаБезПервогоСлова(Группа));

КонецФункции

// Группа, которую проверяет эвристика. Первое слово предложения отбрасывается, только если оно не похоже
// на фамилию, а остаток похож на имя: «Позвони Абрамову» - «Абрамову», но «Мамедова Лейла просит»
// и «Иванов Иван Иванович звонил» - целиком.
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  см. ГруппыСлов
Функция ГруппаДляЭвристики(Группа)

	Если Не ЕстьХвостГруппы(Группа) Или ЕстьОкончаниеФамилии(Группа.Слова[0].Слово) Тогда
		Возврат Группа;
	КонецЕсли;
	Хвост = ГруппаБезПервогоСлова(Группа);
	Возврат ?(ЭтоИмяПоПризнакам(Хвост), Хвост, Группа);

КонецФункции

// Фрагмент текста, который занимает группа слов.
//
// Параметры:
//  Группа - см. ГруппыСлов
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
Функция ТекстГруппы(Группа, Текст)

	Начало = Группа.Слова[0].Начало;
	Возврат Сред(Текст, Начало, Группа.Слова[Группа.Слова.ВГраница()].Конец - Начало + 1);

КонецФункции

// Слово того же предложения на Сдвиг слов раньше в нижнем регистре или пустая строка.
//
// Параметры:
//  Слова - см. СловаТекста
//  Индекс - Число - Индекс текущего слова.
//  Сдвиг - Число
//
// Возвращаемое значение:
//  Строка
Функция ПредыдущееСлово(Слова, Индекс, Сдвиг)

	Для Шаг = 0 По Сдвиг - 1 Цикл
		Если Индекс - Шаг <= 0 Или Слова[Индекс - Шаг].НачалоПредложения Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат НормализованноеСлово(Слова[Индекс - Сдвиг].Слово);

КонецФункции

// Слово того же предложения после слова с индексом в нижнем регистре или пустая строка.
//
// Параметры:
//  Слова - см. СловаТекста
//  Индекс - Число
//
// Возвращаемое значение:
//  Строка
Функция СледующееСлово(Слова, Индекс)

	Если Индекс >= Слова.ВГраница() Или Слова[Индекс + 1].НачалоПредложения Тогда
		Возврат "";
	КонецЕсли;
	Возврат НормализованноеСлово(Слова[Индекс + 1].Слово);

КонецФункции

Функция ЭтоСтрочнаяФамилия(Описание)

	Возврат Не Описание.Заглавное И Не Описание.ВКавычках И СтрДлина(Описание.Слово) >= 5
		И ЕстьОкончаниеФамилии(Описание.Слово);

КонецФункции

Функция МожетБытьЧастьюФИО(Описание)

	Если Описание.Инициал Тогда
		Возврат Истина;
	ИначеЕсли Не Описание.Заглавное Или Описание.ВКавычках Или СтрДлина(Описание.Слово) < 2 Тогда
		Возврат Ложь;
	ИначеЕсли ВРег(Описание.Слово) = Описание.Слово Тогда
		// Прописными пишут и аббревиатуры (ЭТрН, УПД, ИНН), и фамилии (ИВАНОВУ): фамилию выдает окончание.
		Возврат СтрДлина(Описание.Слово) >= 4 И ЕстьОкончаниеФамилии(Описание.Слово);
	КонецЕсли;
	Возврат Не ЕстьЗаглавнаяВнутри(Описание.Слово);

КонецФункции

Функция ЕстьСловоБезИнициала(Группа)

	Для Каждого Описание Из Группа.Слова Цикл
		Если Не Описание.Инициал Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Слово для сравнения: нижний регистр, буква с точками заменена на «е».
//
// Параметры:
//  Слово - Строка
//
// Возвращаемое значение:
//  Строка
Функция НормализованноеСлово(Слово)

	Возврат СтрЗаменить(НРег(Слово), Символ(1105), "е");

КонецФункции

Функция ЭтоБуква(Символ)

	Возврат Символ <> "" И ВРег(Символ) <> НРег(Символ);

КонецФункции

Функция ЭтоЗаглавная(Символ)

	Возврат ЭтоБуква(Символ) И ВРег(Символ) = Символ;

КонецФункции

Функция ЕстьЗаглавнаяВнутри(Слово)

	Для Позиция = 2 По СтрДлина(Слово) Цикл
		Символ = Сред(Слово, Позиция, 1);
		Если ЭтоЗаглавная(Символ) И Сред(Слово, Позиция - 1, 1) <> "-" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ЛюдиИзБазы

// Токен человека из базы, которого называет группа слов, или пустая строка.
// Один человек (одно ФИО, даже если он есть и физлицом, и пользователем), которого видит пользователь,
// получает токен ссылки. Несколько людей с совпавшими частями ФИО («Петрову» при пяти Петровых),
// человек, скрытый от пользователя правами, и неполный список кандидатов дают токен значения:
// исходным значением становятся только совпавшие части ФИО в именительном падеже.
//
// Параметры:
//  Группа - см. ГруппыСлов
//  ПоискВключен - Булево
//  Кэш - Соответствие - Формы склонения по представлению, см. ФормыФИО.
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Строка
Функция ТокенЧеловекаИзБазы(Группа, ПоискВключен, Кэш, Словарь)

	Объекты = ОбъектыСФИО();
	Если Объекты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Поиск = КандидатыГруппы(Группа, Объекты, ПоискВключен);
	Кандидаты = Поиск.Кандидаты;

	Подтвержденные = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Совпадение = СовпадениеФИО(Группа, Кандидат.Значение, Кэш);
		Если Совпадение <> Неопределено Тогда
			Подтвержденные.Вставить(Кандидат.Ключ, Новый Структура("Представление, Совпадение",
				Кандидат.Значение, Совпадение));
		КонецЕсли;
	КонецЦикла;
	Если Подтвержденные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	// Условие правила (контрагент или партнер - частное лицо) проверяет реестр маскирования с правами
	// пользователя. Объекты, которые он читать не может, проверить нельзя - они скрываются как ФИО.
	Ссылки = Новый Массив;
	Для Каждого КлючИЗначение Из Подтвержденные Цикл
		Если ПравоДоступа("Чтение", КлючИЗначение.Ключ.Метаданные()) Тогда
			Ссылки.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	ВидыПДн = ИИО_Маскирование.ВидыПДнСсылок(Ссылки);
	Для Каждого КлючИЗначение Из Подтвержденные Цикл
		Если Ссылки.Найти(КлючИЗначение.Ключ) = Неопределено Тогда
			ВидыПДн.Вставить(КлючИЗначение.Ключ, "ФИО");
		КонецЕсли;
	КонецЦикла;

	Люди = Новый Соответствие;
	ПервыйЧеловек = Неопределено;
	Для Каждого КлючИЗначение Из Подтвержденные Цикл
		Вид = ВидыПДн.Получить(КлючИЗначение.Ключ);
		Если Вид = Неопределено Или ИИО_Маскирование.ОсновнойВидПДн(Вид) <> "ФИО" Тогда
			Продолжить;
		КонецЕсли;
		Люди.Вставить(НормализованноеСлово(КлючИЗначение.Значение.Представление), КлючИЗначение);
		ПервыйЧеловек = КлючИЗначение;
	КонецЦикла;
	Если ПервыйЧеловек = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// Токен ссылки - только для одного человека, которого пользователь видит по своим правам: демаскирование
	// ответа покажет его полное ФИО. Иначе - токен значения из совпавших частей ФИО.
	Если Люди.Количество() = 1 И Не Поиск.Неполный И ДоступенПользователю(ПервыйЧеловек.Ключ) Тогда
		Возврат ИИО_МаскированиеКлиентСервер.Токен("ФИО", "ref:" + ИИО_Ответ.СсылкаВСтроку(ПервыйЧеловек.Ключ),
			ПервыйЧеловек.Значение.Представление, Словарь);
	КонецЕсли;
	Исходное = ПервыйЧеловек.Значение.Совпадение;
	Возврат ИИО_МаскированиеКлиентСервер.Токен("ФИО", "value:ФИО:" + Исходное, Исходное, Словарь);

КонецФункции

// Проверяет, что пользователь видит объект по своим правам, включая ограничения на уровне записей.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Булево
Функция ДоступенПользователю(Ссылка)

	ОбъектМетаданных = Ссылка.Метаданные();
	Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	%1 КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Ссылка", ОбъектМетаданных.ПолноеИмя()));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Объекты, представление ссылок на которые - ФИО по действующим правилам маскирования.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - Справочники.
Функция ОбъектыСФИО()

	Объекты = Новый Массив;
	Для Каждого КлючИЗначение Из ИИО_МаскированиеПовтИсп.Правила() Цикл
		Если ИИО_Маскирование.ОсновнойВидПДн(КлючИЗначение.Значение.ВидСсылки) <> "ФИО" Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(КлючИЗначение.Ключ);
		Если ОбъектМетаданных <> Неопределено И Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
			Объекты.Добавить(ОбъектМетаданных);
		КонецЕсли;
	КонецЦикла;
	Возврат Объекты;

КонецФункции

// Кандидаты для слов группы: ссылки и их представления. Слово, которое полнотекстовый поиск не нашел
// или нашел по неактуальному индексу, ищется еще и запросом: новый человек мог не попасть в индекс.
//
// Параметры:
//  Группа - см. ГруппыСлов
//  Объекты - Массив из ОбъектМетаданных
//  ПоискВключен - Булево
//
// Возвращаемое значение:
//  Структура:
//   * Кандидаты - Соответствие из КлючИЗначение - Ссылка и представление.
//   * Неполный - Булево - Поиск уперся в предел кандидатов: среди ненайденных может быть тезка.
Функция КандидатыГруппы(Группа, Объекты, ПоискВключен)

	Результат = Новый Структура("Кандидаты, Неполный", Новый Соответствие, Ложь);
	ИндексАктуален = ПоискВключен И ПолнотекстовыйПоиск.ИндексАктуален();
	Диапазоны = Новый Массив;
	Для Каждого Описание Из Группа.Слова Цикл
		Если Описание.Инициал Тогда
			Продолжить;
		КонецЕсли;
		Найдено = ?(ПоискВключен, ДобавитьКандидатовПоиском(Результат, Описание.Слово, Объекты), 0);
		Если Найдено = 0 Или Не ИндексАктуален Тогда
			Для Каждого Диапазон Из ДиапазоныНаименования(Описание.Слово) Цикл
				Диапазоны.Добавить(Диапазон);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Диапазоны.Количество() > 0 Тогда
		ДобавитьКандидатовЗапросом(Результат, Диапазоны, Объекты);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Ищет слово полнотекстовым поиском: само слово и его основу со звездочкой. Морфология платформы
// знает только словарные фамилии, а основа находит и редкие.
//
// Параметры:
//  Результат - см. КандидатыГруппы
//  Слово - Строка
//  Объекты - Массив из ОбъектМетаданных
//
// Возвращаемое значение:
//  Число - Сколько найдено; 0, если поиск не выполнился: тогда слово ищется запросом.
Функция ДобавитьКандидатовПоиском(Результат, Слово, Объекты)

	Основа = ОсноваСлова(Слово);
	// Слово в кавычках ищется как есть: «Или» и «Не» в начале фразы не станут операторами поиска.
	СтрокаПоиска = """" + ЧастьДоДефиса(Слово) + """";
	Если СтрДлина(Основа) >= 3 Тогда
		СтрокаПоиска = СтрокаПоиска + " | " + Основа + "*";
	КонецЕсли;
	Список = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, МаксимумКандидатов());
	Для Каждого ОбъектМетаданных Из Объекты Цикл
		Список.ОбластьПоиска.Добавить(ОбъектМетаданных);
	КонецЦикла;

	// Людей ищем среди всех, а не только видимых пользователю: имя скрытого правами человека - тоже ПДн.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Список.ПерваяЧасть();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		Информация = ИнформацияОбОшибке();
		ИИО_Журнал.ЗаписатьСобытие("МаскированиеВвода.Поиск", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация)));
		Возврат 0;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Если Список.ПолноеКоличество() > Список.Количество() Тогда
		Результат.Неполный = Истина;
	КонецЕсли;
	Для Индекс = 0 По Список.Количество() - 1 Цикл
		Элемент = Список.Получить(Индекс);
		Результат.Кандидаты.Вставить(Элемент.Значение, Строка(Элемент.Представление));
	КонецЦикла;
	Возврат Список.Количество();

КонецФункции

// Диапазоны наименования для поиска фамилии запросом. Наименование начинается с основы слова: «Чиркову» -
// от «Чирков» до «Чирковх» (последняя буква следующая). Короткая фамилия («Ли», «Юну» - «Юн») - первое слово
// наименования целиком: от «Ли » до «Ли!», иначе по началу «Ли» найдется слишком много чужих фамилий.
//
// Параметры:
//  Слово - Строка
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Строка
//   * Конец - Строка
Функция ДиапазоныНаименования(Слово)

	Диапазоны = Новый Массив;
	Основа = ОсноваСлова(Слово);
	Основа = ВРег(Лев(Основа, 1)) + НРег(Сред(Основа, 2));
	Если СтрДлина(Основа) >= 3 Тогда
		Диапазоны.Добавить(Новый Структура("Начало, Конец", Основа,
			Лев(Основа, СтрДлина(Основа) - 1) + Символ(КодСимвола(Прав(Основа, 1)) + 1)));
	КонецЕсли;
	Короткая = "";
	Если СтрДлина(Основа) <= 2 Тогда
		Короткая = Основа;
	ИначеЕсли СтрДлина(Основа) = 3 И СтрНайти("аяуюеиыо", НРег(Прав(Основа, 1))) > 0 Тогда
		Короткая = Лев(Основа, 2);
	КонецЕсли;
	Если Короткая <> "" Тогда
		Диапазоны.Добавить(Новый Структура("Начало, Конец", Короткая + " ", Короткая + "!"));
	КонецЕсли;
	Возврат Диапазоны;

КонецФункции

// Ищет людей по диапазонам наименования: запасной путь, когда полнотекстовый поиск выключен или не нашел слово.
// Находит фамилию (первое слово наименования) в любом падеже, имя без фамилии - нет. Диапазон
// «не меньше начала и меньше конца» идет по индексу наименования, в отличие от ПОДОБНО. Каждый диапазон
// и каждый справочник - отдельный запрос пакета, без ИЛИ.
//
// Параметры:
//  Результат - см. КандидатыГруппы
//  Диапазоны - см. ДиапазоныНаименования
//  Объекты - Массив из ОбъектМетаданных
Процедура ДобавитьКандидатовЗапросом(Результат, Диапазоны, Объекты)

	Запрос = Новый Запрос;
	Тексты = Новый Массив;
	Для Индекс = 0 По Диапазоны.ВГраница() Цикл
		Номер = Формат(Индекс, "ЧН=0; ЧГ=0");
		Запрос.УстановитьПараметр("Начало" + Номер, Диапазоны[Индекс].Начало);
		Запрос.УстановитьПараметр("Конец" + Номер, Диапазоны[Индекс].Конец);
		Для Каждого ОбъектМетаданных Из Объекты Цикл
			Если ОбъектМетаданных.ДлинаНаименования = 0 Тогда
				Продолжить;
			КонецЕсли;
			Тексты.Добавить(СтрШаблон(
				"ВЫБРАТЬ ПЕРВЫЕ %1
				|	Таблица.Ссылка КАК Ссылка,
				|	ПРЕДСТАВЛЕНИЕ(Таблица.Ссылка) КАК Представление
				|ИЗ
				|	%2 КАК Таблица
				|ГДЕ
				|	Таблица.Наименование >= &Начало%3
				|	И Таблица.Наименование < &Конец%3", Формат(МаксимумКандидатов(), "ЧГ=0"),
				ОбъектМетаданных.ПолноеИмя(), Номер));
		КонецЦикла;
	КонецЦикла;
	Если Тексты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос.Текст = СтрСоединить(Тексты, ";" + Символы.ПС);

	УстановитьПривилегированныйРежим(Истина);
	Результаты = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого РезультатЗапроса Из Результаты Цикл
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Количество() >= МаксимумКандидатов() Тогда
			Результат.Неполный = Истина;
		КонецЕсли;
		Пока Выборка.Следующий() Цикл
			Результат.Кандидаты.Вставить(Выборка.Ссылка, Выборка.Представление);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Сверяет группу слов с ФИО кандидата: каждое слово - форма своей части ФИО в каком-то падеже,
// каждый инициал - первая буква оставшейся части. Одно слово в начале предложения должно быть фамилией:
// «Вера» или «Роза» в начале фразы - еще не человек.
//
// Параметры:
//  Группа - см. ГруппыСлов
//  Представление - Строка - ФИО кандидата.
//  Кэш - Соответствие
//
// Возвращаемое значение:
//  Строка, Неопределено - Совпавшие части ФИО в именительном падеже («Петров») или Неопределено.
Функция СовпадениеФИО(Группа, Представление, Кэш)

	Формы = ФормыФИО(Представление, Кэш);
	Части = Формы[0];
	Занятые = Новый Соответствие;
	Совпавшие = Новый Массив;
	Для Каждого Описание Из Группа.Слова Цикл
		Если Описание.Инициал Тогда
			Продолжить;
		КонецЕсли;
		Индекс = ИндексЧасти(НормализованноеСлово(Описание.Слово), Формы, Занятые);
		Если Индекс = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Занятые.Вставить(Индекс, Истина);
		Совпавшие.Добавить(Индекс);
	КонецЦикла;
	Для Каждого Описание Из Группа.Слова Цикл
		Если Описание.Инициал И Не ЕстьЧастьНаБукву(НормализованноеСлово(Описание.Слово), Части, Занятые) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Группа.Слова.Количество() = 1 И Группа.Слова[0].НачалоПредложения И Совпавшие[0] <> 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИсходныеЧасти = СтрРазделить(СокрЛП(Представление), " ", Ложь);
	Результат = Новый Массив;
	Для Каждого Индекс Из Совпавшие Цикл
		Результат.Добавить(ИсходныеЧасти[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Результат, " ");

КонецФункции

Функция ИндексЧасти(Слово, Формы, Занятые)

	Для Каждого Падеж Из Формы Цикл
		Для Индекс = 0 По Падеж.ВГраница() Цикл
			Если Занятые.Получить(Индекс) = Неопределено И Падеж[Индекс] = Слово Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЕстьЧастьНаБукву(Буква, Части, Занятые)

	Для Индекс = 0 По Части.ВГраница() Цикл
		Если Занятые.Получить(Индекс) = Неопределено И Лев(Части[Индекс], 1) = Буква Тогда
			Занятые.Вставить(Индекс, Истина);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Формы ФИО по падежам: части в нижнем регистре. ФИО из двух-трех слов склоняет платформа,
// остальные представления сравниваются только в именительном падеже.
//
// Параметры:
//  Представление - Строка
//  Кэш - Соответствие - Пополняется.
//
// Возвращаемое значение:
//  Массив из Массив из Строка - Первый элемент - именительный падеж.
Функция ФормыФИО(Представление, Кэш)

	Формы = Кэш.Получить(Представление);
	Если Формы <> Неопределено Тогда
		Возврат Формы;
	КонецЕсли;
	Формы = Новый Массив;
	Части = ЧастиФИО(Представление);
	Формы.Добавить(Части);
	Если Части.Количество() >= 2 И Части.Количество() <= 3 Тогда
		Для Каждого Падеж Из СтрРазделить("Родительный,Дательный,Винительный,Творительный,Предложный", ",") Цикл
			Попытка
				Склонение = ПолучитьСклоненияСтроки(Представление, "Л=ru_RU", "ПД=" + Падеж)[0];
			Исключение
				// Платформа не склоняет строку: сравниваем по именительному падежу и оставляем след в журнале.
				Информация = ИнформацияОбОшибке();
				ИИО_Журнал.ЗаписатьСобытие("МаскированиеВвода.Склонение", УровеньЖурналаРегистрации.Предупреждение,
					Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация)));
				Прервать;
			КонецПопытки;
			ЧастиПадежа = ЧастиФИО(Склонение);
			Если ЧастиПадежа.Количество() = Части.Количество() Тогда
				Формы.Добавить(ЧастиПадежа);
			КонецЕсли;
		КонецЦикла;
		ДобавитьФормыНесклоняемых(Формы);
	КонецЕсли;
	Кэш.Вставить(Представление, Формы);
	Возврат Формы;

КонецФункции

// Добавляет мужские падежные формы частям на согласную, которые платформа не склоняет: «Юн Сергей» -
// «Юн Сергея», а говорят «у Юна», «Юну».
//
// Параметры:
//  Формы - см. ФормыФИО
Процедура ДобавитьФормыНесклоняемых(Формы)

	Части = Формы[0];
	Несклоняемые = Новый Массив;
	Для Индекс = 0 По Части.ВГраница() Цикл
		Часть = Части[Индекс];
		Если СтрНайти("аяоеуюыиэйь", Прав(Часть, 1)) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Склоняется = Ложь;
		Для Каждого Падеж Из Формы Цикл
			Склоняется = Склоняется Или Падеж[Индекс] <> Часть;
		КонецЦикла;
		Если Не Склоняется Тогда
			Несклоняемые.Добавить(Индекс);
		КонецЕсли;
	КонецЦикла;
	Если Несклоняемые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Окончание Из СтрРазделить("а,у,ом,е", ",") Цикл
		Падеж = Новый Массив(Новый ФиксированныйМассив(Части));
		Для Каждого Индекс Из Несклоняемые Цикл
			Падеж[Индекс] = Части[Индекс] + Окончание;
		КонецЦикла;
		Формы.Добавить(Падеж);
	КонецЦикла;

КонецПроцедуры

Функция ЧастиФИО(Представление)

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СокрЛП(Представление), " ", Ложь) Цикл
		Части.Добавить(НормализованноеСлово(Часть));
	КонецЦикла;
	Возврат Части;

КонецФункции

// Основа слова без падежного окончания для поиска по началу: «Чиркову» - «Чирков», «Тюренковой» - «Тюренков».
//
// Параметры:
//  Слово - Строка
//
// Возвращаемое значение:
//  Строка
Функция ОсноваСлова(Слово)

	Основа = ЧастьДоДефиса(Слово);
	Для Каждого Окончание Из СтрРазделить("ыми,ими,ого,его,ому,ему,ой,ей,ую,юю,ою,ею,ым,им,ом,ем,а,я,у,ю,е,ы,и",
		",") Цикл
		Длина = СтрДлина(Основа) - СтрДлина(Окончание);
		Если Длина >= 3 И НормализованноеСлово(Прав(Основа, СтрДлина(Окончание))) = Окончание Тогда
			Возврат Лев(Основа, Длина);
		КонецЕсли;
	КонецЦикла;
	Возврат Основа;

КонецФункции

Функция ЧастьДоДефиса(Слово)

	Позиция = СтрНайти(Слово, "-");
	Возврат ?(Позиция = 0, Слово, Лев(Слово, Позиция - 1));

КонецФункции

Функция ПолнотекстовыйПоискВключен()

	Возврат ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить;

КонецФункции

#КонецОбласти

#Область Эвристика

// Признаки человека, которого нет в базе: инициалы при слове, распространенное имя (ИИО_ИменаЛюдей),
// окончание фамилии или отчества у группы из двух-трех слов, слово после роли («водитель», «курьер»)
// или обращения («передай», «скажи»), одно слово с окончанием фамилии не в начале предложения.
// Окончания прилагательных (-ский, -ской) у одного слова без контекста не считаются: «Казанском складе».
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  Булево
Функция ЭтоИмяПоПризнакам(Группа)

	Слов = 0;
	ЕстьИнициал = Ложь;
	ЕстьОкончаниеФИО = Ложь;
	ЕстьОтчество = Ложь;
	ЕстьИмя = Ложь;
	Для Каждого Описание Из Группа.Слова Цикл
		Если Описание.Инициал Тогда
			ЕстьИнициал = Истина;
			Продолжить;
		КонецЕсли;
		Слов = Слов + 1;
		ЕстьОкончаниеФИО = ЕстьОкончаниеФИО Или ЕстьОкончаниеФамилии(Описание.Слово);
		ЕстьОтчество = ЕстьОтчество Или ЕстьОкончание(НормализованноеСлово(Описание.Слово), ОкончанияОтчеств());
		ВидИмени = ВидИмени(Описание.Слово);
		ЕстьИмя = ЕстьИмя Или ВидИмени = "имя"
			Или ВидИмени = "слово" И Не Описание.НачалоПредложения;
	КонецЦикла;

	Если Группа.ПослеОрганизации Тогда
		Возврат ЕстьИмя Или ЕстьОтчество;
	ИначеЕсли ЕстьИнициал Или ЕстьИмя
		Или Слов = 1 И (ЭтоРоль(Группа.Предыдущее) Или ЭтоРоль(Группа.Предпредыдущее)) Тогда
		Возврат Истина;
	ИначеЕсли Слов >= 2 Или ЭтоПредлогПередЧеловеком(Группа.Предыдущее) Тогда
		Возврат ЕстьОкончаниеФИО;
	КонецЕсли;
	// Отчество без имени - прозвище («Петрович опять встал»): обычным словом оно не бывает и в начале предложения.
	Слово = Группа.Слова[0];
	Ключ = НормализованноеСлово(Слово.Слово);
	Возврат ЕстьОкончание(Ключ, ОкончанияОтчеств() + "," + ОкончанияПрозвищ())
		Или Не Слово.НачалоПредложения И ЕстьОкончание(Ключ, ОкончанияФамилийСтрогие());

КонецФункции

// Место, а не человек:
// - одно слово после «в», «из», «под» или слова места («склад», «город»): «в Иванове» и «из Королева» - города,
//   хотя совпадают с формами фамилий из базы;
// - одно слово из макета ИИО_НазванияМест («рейс на Серпухов»), если перед ним нет роли, обращения
//   или предлога, после которого обычно стоит человек: «у Тулы» - редкость, «у Тулина» - нет;
// - город, совпадающий с фамилией, - только в именительном падеже после предлога места: «на Королев»;
// - марка машины из того же макета - всегда: «водителям Газелей»;
// - название из нескольких слов: «Сергиев Посад»;
// - название места рядом с другим названием места: «Королев - Мытищи», «из Серпухова и Королева»;
// - группа рядом со словом улицы: «Ворошиловский проспект», «ул. Маршала Жукова».
//
// Параметры:
//  Группа - см. ГруппыСлов
//
// Возвращаемое значение:
//  Булево
Функция ЭтоМесто(Группа)

	Предыдущее = Группа.Предыдущее;
	Если ЭтоУлица(Группа.Следующее) Или ЭтоУлица(Предыдущее) Тогда
		Возврат Истина;
	ИначеЕсли Группа.Слова.Количество() > 1 Тогда
		// «Сергиев Посад» - в макете через дефис.
		Части = Новый Массив;
		Для Каждого Описание Из Группа.Слова Цикл
			Части.Добавить(Описание.Слово);
		КонецЦикла;
		Возврат ВидНазвания(СтрСоединить(Части, "-")) = "место";
	КонецЕсли;
	ПослеСловаМеста = СтрНайти(
		",в,во,из,изо,до,под,подо,около,возле,г,город,города,городе,пос,поселок,село,ст,станция,область,обл,район,"
		+ "край,края,регион,ул,улица,улицу,улице,пр,проспект,склад,склада,складе,складу,склады,складов,складах,"
		+ "терминал,терминала,терминале,", "," + Предыдущее + ",") > 0;
	Вид = ВидНазвания(Группа.Слова[0].Слово);
	// Перечень мест: «Королев - Мытищи - Пушкино», «из Серпухова и Королева».
	СредиМест = ЭтоНазваниеМеста(Группа.Следующее) Или ЭтоНазваниеМеста(Предыдущее)
		Или (Предыдущее = "и" Или Предыдущее = "или") И ЭтоНазваниеМеста(Группа.Предпредыдущее);
	// Роль через слово («экспедитором, рейс Москва») место не отменяет: только роль прямо перед ним.
	Возврат ПослеСловаМеста Или Вид = "техника" Или Вид = "фамилия" И ЭтоПредлогМеста(Предыдущее)
		Или (Вид = "место" Или Вид = "фамилия") И СредиМест И Не ЭтоРоль(Предыдущее)
		Или Вид = "место" И Не ЭтоРоль(Предыдущее)
		И (ЭтоПредлогМеста(Предыдущее) Или Не ЭтоПредлогПередЧеловеком(Предыдущее));

КонецФункции

// Слово - название места из макета ИИО_НазванияМест (в том числе город, совпадающий с фамилией), не техника.
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре или пустая строка.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоНазваниеМеста(Слово)

	Если Слово = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = ВидНазвания(Слово);
	Возврат Вид = "место" Или Вид = "фамилия";

КонецФункции

// Предлог, после которого обычно стоит место: «на Серпухов», «с Ачинска», «по Бердску».
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоПредлогМеста(Слово)

	Возврат СтрНайти(",в,во,из,изо,на,с,со,по,до,под,около,возле,через,", "," + Слово + ",") > 0;

КонецФункции

// Слово улицы после ее названия: «Ворошиловский проспект», «Лесная улица».
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоУлица(Слово)

	Возврат Слово <> "" И СтрНайти(",ул,улица,улице,улицу,пр,просп,проспект,проспекте,пер,переулок,переулке,шоссе,"
		+ "бульвар,бульваре,набережная,набережной,проезд,проезде,тупик,аллея,", "," + Слово + ",") > 0;

КонецФункции

// Название места или техники из макета ИИО_НазванияМест в любом падеже.
//
// Параметры:
//  Слово - Строка
//
// Возвращаемое значение:
//  Строка - «место», «фамилия» (город, совпадающий с фамилией), «техника» или пустая строка.
Функция ВидНазвания(Слово)

	Названия = ИИО_МаскированиеПовтИсп.НазванияМест();
	Ключ = НормализованноеСлово(Слово);
	Вид = Названия.Получить(Ключ);
	Если Вид = Неопределено Тогда
		Вид = Названия.Получить(ОсноваМеста(Ключ));
	КонецЕсли;
	Возврат ?(Вид = Неопределено, "", Вид);

КонецФункции

// Основа названия места без падежного окончания: «ачинска» - «ачинск», «мытищах» - «мытищ», «тюмени» - «тюмен».
//
// Параметры:
//  Название - Строка - В нижнем регистре.
//
// Возвращаемое значение:
//  Строка
Функция ОсноваМеста(Название)

	Для Каждого Окончание Из СтрРазделить("ами,ями,ой,ей,ом,ем,ах,ях,ам,ям,ью,а,я,у,ю,е,и,ы,о,ь", ",") Цикл
		Длина = СтрДлина(Название) - СтрДлина(Окончание);
		Если Длина >= 3 И Прав(Название, СтрДлина(Окончание)) = Окончание Тогда
			Возврат Лев(Название, Длина);
		КонецЕсли;
	КонецЦикла;
	Возврат Название;

КонецФункции

// Слово-роль человека или обращение к нему: после него одно слово с заглавной - имя или фамилия.
// Роль сверяется по основе и падежному окончанию: «водителю», «кладовщица», но не «бухгалтерия».
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоРоль(Слово)

	Если Слово = "" Тогда
		Возврат Ложь;
	ИначеЕсли СтрНайти(",передай,скажи,позвони,перезвони,напиши,отправь,спроси,уточни,набери,напомни,сообщи,",
		"," + Слово + ",") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Окончания = ",,ь,я,ю,ем,е,и,ей,ям,ями,ях,а,у,ом,ы,ов,ам,ами,ах,";
	Для Каждого Основа Из СтрРазделить("водител,экспедитор,курьер,получател,менеджер,кладовщик,кладовщиц,логист,"
		+ "грузчик,директор,бухгалтер,кассир,представител,сотрудник,сотрудниц,господин,госпож,гражданин,гражданк,"
		+ "товарищ,ответственн,доверенн,коллег,диспетчер,покупател,физлиц", ",") Цикл
		Если СтрНачинаетсяС(Слово, Основа)
			И СтрНайти(Окончания, "," + Сред(Слово, СтрДлина(Основа) + 1) + ",") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Предлог, после которого слово с окончанием фамилии - скорее человек: «у Кравчука», «для Ольховской».
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоПредлогПередЧеловеком(Слово)

	Возврат СтрНайти(",у,к,ко,от,для,с,со,при,через,вместо,после,без,", "," + Слово + ",") > 0;

КонецФункции

Функция ЕстьОкончаниеФамилии(Слово)

	Возврат ЕстьОкончание(НормализованноеСлово(Слово), ОкончанияФамилийСтрогие() + ","
		+ "ский,ского,скому,ским,ском,ская,ской,скую,цкий,цкого,цкому,цким,цком,цкая,цкой,цкую");

КонецФункции

// Окончания фамилий и отчеств, которые не бывают у прилагательных.
//
// Возвращаемое значение:
//  Строка - Окончания через запятую.
Функция ОкончанияФамилийСтрогие()

	Возврат "ов,ова,ову,овым,ове,овой,ев,ева,еву,евым,еве,евой,ин,ина,ину,иным,ине,иной,ын,ына,ыну,ыным,ыне,ыной,"
		+ "енко,ук,ука,уку,уком,уке,юк,юка,юку,юком,юке,дзе,швили,ян,яна,яну,яном,яне,янц,янца,янцу,янцем,янце,"
		+ ОкончанияОтчеств() + "," + ОкончанияПрозвищ();

КонецФункции

// Окончания прозвищ по отчеству в разговорной форме: «Валерьич», «Палыч».
//
// Возвращаемое значение:
//  Строка - Окончания через запятую.
Функция ОкончанияПрозвищ()

	Возврат "ьич,ьича,ьичу,ьичем,ыч,ыча,ычу,ычем";

КонецФункции

Функция ОкончанияОтчеств()

	Возврат "ович,овича,овичу,овичем,овиче,евич,евича,евичу,евичем,евиче,овна,овны,овне,овну,овной,"
		+ "евна,евны,евне,евну,евной,ична,ичны,ичне,ичну,ичной";

КонецФункции

// Распространенное личное имя по макету ИИО_ИменаЛюдей, в том числе в косвенном падеже: «Мураду», «Анжелу».
//
// Параметры:
//  Слово - Строка
//
// Возвращаемое значение:
//  Строка - «имя», «слово» (имя, которое бывает обычным словом: «Вера», «Роза») или пустая строка.
Функция ВидИмени(Слово)

	Имена = ИИО_МаскированиеПовтИсп.ИменаЛюдей();
	Ключ = НормализованноеСлово(Слово);
	Вид = Имена.Получить(Ключ);
	Если Вид = Неопределено Тогда
		Вид = Имена.Получить(ОсноваИмени(ОсноваСлова(Ключ)));
	КонецЕсли;
	// Разговорная форма на -ка: «Оксанка», «Нинке» - от имен «Оксана», «Нина».
	Основа = ОсноваСлова(Ключ);
	Если Вид = Неопределено И СтрДлина(Основа) > 4 И Прав(Основа, 1) = "к" Тогда
		Вид = Имена.Получить(Лев(Основа, СтрДлина(Основа) - 1) + "а");
		Вид = ?(Вид = "имя", Вид, Неопределено);
	КонецЕсли;
	Возврат ?(Вид = Неопределено, "", Вид);

КонецФункции

// Основа имени для сравнения падежных форм: без конечной гласной, «ь» или «й» («анжела» - «анжел»,
// «мария» - «мари», «сергей» - «серге»). Короткие имена сравниваются целиком.
//
// Параметры:
//  Имя - Строка - В нижнем регистре.
//
// Возвращаемое значение:
//  Строка
Функция ОсноваИмени(Имя)

	Если СтрДлина(Имя) > 3 И СтрНайти("аяоеьй", Прав(Имя, 1)) > 0 Тогда
		Возврат Лев(Имя, СтрДлина(Имя) - 1);
	КонецЕсли;
	Возврат Имя;

КонецФункции

Функция ЕстьОкончание(Слово, Окончания)

	Для Каждого Окончание Из СтрРазделить(Окончания, ",", Ложь) Цикл
		Если СтрДлина(Слово) > СтрДлина(Окончание) + 1 И СтрЗаканчиваетсяНа(Слово, Окончание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоОрганизация(Предыдущее)

	Возврат СтрНайти(",ооо,оао,зао,пао,ао,нко,ано,фгуп,гуп,муп,тк,тд,", "," + Предыдущее + ",") > 0;

КонецФункции

#КонецОбласти

#Область Результат

// Находит адреса частных лиц: от названия улицы («ул.», «проспект», «шоссе») до номера квартиры.
// Адрес без квартиры - обычно адрес организации, склада или магазина - не скрывается.
//
// Параметры:
//  Текст - Строка
//  Слова - см. СловаТекста
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Структура:
//   * Находки - Массив из см. НоваяНаходка
//   * Слова - Соответствие - Индексы слов, вошедших в адреса.
Функция АдресаЛюдей(Текст, Слова, Словарь)

	Результат = Новый Структура("Находки, Слова", Новый Массив, Новый Соответствие);
	Улицы = ",ул,улица,улице,улицу,пр,просп,проспект,проспекте,пер,переулок,переулке,ш,шоссе,б-р,бульвар,бульваре,"
		+ "наб,набережная,набережной,пл,площадь,площади,мкр,микрорайон,микрорайоне,проезд,проезде,тупик,аллея,";
	Длина = СтрДлина(Текст);
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Если СтрНайти(",кв,квартира,", "," + НормализованноеСлово(Слова[Индекс].Слово) + ",") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Конец = Слова[Индекс].Конец + 1;
		Пока Конец <= Длина И СтрНайти(". ", Сред(Текст, Конец, 1)) > 0 Цикл
			Конец = Конец + 1;
		КонецЦикла;
		НачалоНомера = Конец;
		Пока Конец <= Длина И СтрНайти("0123456789", Сред(Текст, Конец, 1)) > 0 Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Если Конец = НачалоНомера Тогда
			Продолжить;
		КонецЕсли;
		// Название улицы ищется не дальше десяти слов назад: «ул. Профсоюзная, д. 104, кв. 58».
		Улица = Индекс - 1;
		Пока Улица >= Макс(0, Индекс - 10)
			И СтрНайти(Улицы, "," + НормализованноеСлово(Слова[Улица].Слово) + ",") = 0 Цикл
			Улица = Улица - 1;
		КонецЦикла;
		Если Улица < Макс(0, Индекс - 10) Тогда
			Продолжить;
		КонецЕсли;
		Начало = Слова[Улица].Начало;
		Фрагмент = Сред(Текст, Начало, Конец - Начало);
		Результат.Находки.Добавить(НоваяНаходка(Начало, Конец - 1, ИИО_МаскированиеКлиентСервер.Токен("Адрес",
			"value:Адрес:" + Фрагмент, Фрагмент, Словарь), "эвристика"));
		Для Номер = Улица По Индекс Цикл
			Результат.Слова.Вставить(Номер, Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание найденного фрагмента для замены.
//
// Параметры:
//  Начало - Число
//  Конец - Число
//  Токен - Строка
//  Источник - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Начало - Число
//   * Конец - Число
//   * Токен - Строка
//   * Источник - Строка
Функция НоваяНаходка(Начало, Конец, Токен, Источник)

	Возврат Новый Структура("Начало, Конец, Токен, Источник", Начало, Конец, Токен, Источник);

КонецФункции

// Заменяет найденные фрагменты токенами и дополняет описание замен.
//
// Параметры:
//  Текст - Строка
//  Найденные - Массив из см. НоваяНаходка
//  Замены - Массив из Структура - Пополняется: Фрагмент, Токен, Источник.
//
// Возвращаемое значение:
//  Строка
Функция ЗаменитьНайденное(Текст, Найденные, Замены)

	ПоНачалу = Новый СписокЗначений;
	Для Каждого Находка Из Найденные Цикл
		ПоНачалу.Добавить(Находка, Формат(Находка.Начало, "ЧЦ=10; ЧВН=; ЧГ=0"));
	КонецЦикла;
	ПоНачалу.СортироватьПоПредставлению();

	Результат = "";
	Хвост = 1;
	Для Каждого Элемент Из ПоНачалу Цикл
		Находка = Элемент.Значение;
		Если Находка.Начало < Хвост Тогда
			Продолжить;
		КонецЕсли;
		Фрагмент = Сред(Текст, Находка.Начало, Находка.Конец - Находка.Начало + 1);
		Результат = Результат + Сред(Текст, Хвост, Находка.Начало - Хвост) + Находка.Токен;
		Хвост = Находка.Конец + 1;
		Замены.Добавить(Новый Структура("Фрагмент, Токен, Источник", Фрагмент, Находка.Токен, Находка.Источник));
	КонецЦикла;
	Возврат Результат + Сред(Текст, Хвост);

КонецФункции

// Описывает токены, которые поставил первый слой (словарь диалога и шаблоны).
//
// Параметры:
//  Замены - Массив из Структура - Пополняется.
//  Исходный - Строка - Текст до первого слоя.
//  Замаскированный - Строка - Текст после первого слоя.
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
Процедура ДобавитьЗаменыСловаря(Замены, Исходный, Замаскированный, Словарь)

	Если Исходный = Замаскированный Тогда
		Возврат;
	КонецЕсли;
	Позиция = 1;
	Длина = СтрДлина(Замаскированный);
	Пока Позиция <= Длина Цикл
		Конец = КонецТокена(Замаскированный, Позиция, Словарь);
		Если Конец = 0 Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Токен = Сред(Замаскированный, Позиция, Конец - Позиция + 1);
		Исходное = Словарь.Исходные.Получить(Токен);
		Если Исходное <> Неопределено И СтрНайти(Исходный, Токен) = 0 Тогда
			Замены.Добавить(Новый Структура("Фрагмент, Токен, Источник", Строка(Исходное), Токен,
				"словарь и шаблоны"));
		КонецЕсли;
		Позиция = Конец + 1;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Модель

// Люди и домашние адреса, которые локальная модель нашла в тексте после правил (промпт - раздел masking
// макета ИИО_ОписанияАгента, замер - tests/e2e/eval_masking_ner.py).
//
// Параметры:
//  Текст - Строка - Текст с токенами вместо уже найденного.
//  Модель - см. ИИО_МодельHTTP.ПараметрыМодели
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - Строки как в тексте; Неопределено - модель не ответила.
Функция ЛюдиПоМодели(Текст, Модель)

	Промпт = ИИО_РеестрИнструментов.РазделыОписаний("ИИО_ОписанияАгента", "_ОписанияАгента").Получить("masking");
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "system", Промпт));
	Сообщения.Добавить(Новый Структура("role, content", "user", Текст));
	Схема = Новый Структура("type, properties, required", "object",
		Новый Структура("people", Новый Структура("type, items", "array", Новый Структура("type", "string"))),
		СтрРазделить("people", ","));
	Дополнительно = Новый Структура;
	Дополнительно.Вставить("temperature", 0);
	Дополнительно.Вставить("max_tokens", 400);
	// Рассуждение не нужно и в разы замедляет ответ.
	Дополнительно.Вставить("reasoning_effort", "none");
	Дополнительно.Вставить("response_format", Новый Структура("type, json_schema", "json_schema",
		Новый Структура("name, strict, schema", "people", Истина, Схема)));

	Ответ = ИИО_МодельHTTP.ЗапросЧата(Модель, Сообщения, , Дополнительно);
	Ошибка = Ответ.Ошибка;
	Если Ошибка = Неопределено Тогда
		Данные = ИИО_МодельHTTP.ИзJSON(Ответ.Сообщение.Получить("content"));
		Люди = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("people"), Неопределено);
		Если ТипЗнч(Люди) = Тип("Массив") Тогда
			Возврат Люди;
		КонецЕсли;
		ТекстОшибки = НСтр("ru = 'Ответ модели маскирования не по схеме.'");
		Ошибка = Новый Структура("Код, Текст, Подробно", "MODEL_ERROR", ТекстОшибки, ТекстОшибки);
	КонецЕсли;
	ИИО_Журнал.ЗаписатьСобытие("МаскированиеВвода.Модель", УровеньЖурналаРегистрации.Предупреждение,
		Новый Структура("code, error, duration_ms", Ошибка.Код, Ошибка.Подробно, Ответ.ДлительностьМс));
	Возврат Неопределено;

КонецФункции

// Заменяет найденное моделью токенами ФИО. Строка, которой нет в тексте, и метки токенов пропускаются;
// длинные строки заменяются первыми, чтобы «Иванов И.И.» не превратился в «[ФИО#1] И.И.». Одно слово
// из макета мест после предлога места («из Иванова приехали») - город, а не человек, его модель не скрывает.
//
// Параметры:
//  Текст - Строка
//  Люди - Массив из Строка
//  Замены - Массив из Структура - Пополняется: Фрагмент, Токен, Источник.
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Строка
Функция ЗаменитьЛюдейМодели(Текст, Люди, Замены, Словарь)

	ПоДлине = Новый СписокЗначений;
	Для Каждого Человек Из Люди Цикл
		Фрагмент = ?(ТипЗнч(Человек) = Тип("Строка"), СокрЛП(Человек), "");
		Если СтрДлина(Фрагмент) >= 2 И СтрНайти(Фрагмент, "[") = 0 И СтрНайти(Фрагмент, "]") = 0
			И Не МестоПослеПредлога(Текст, Фрагмент) Тогда
			ПоДлине.Добавить(Фрагмент, Формат(10000 - СтрДлина(Фрагмент), "ЧЦ=5; ЧВН=; ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	ПоДлине.СортироватьПоПредставлению();

	Результат = Текст;
	Для Каждого Элемент Из ПоДлине Цикл
		Фрагмент = Элемент.Значение;
		Токен = ИИО_МаскированиеКлиентСервер.Токен("ФИО", "value:ФИО:" + Фрагмент, Фрагмент, Словарь);
		Замененный = ЗаменитьЦелыеСлова(Результат, Фрагмент, Токен);
		Если Замененный <> Результат Тогда
			Результат = Замененный;
			Замены.Добавить(Новый Структура("Фрагмент, Токен, Источник", Фрагмент, Токен, "модель"));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Одно слово из макета мест, перед каждым вхождением которого в тексте стоит предлог места: «из Иванова»,
// «в Королеве». Предлоги «с», «на», «у» не годятся: после них часто стоит человек («у Ивановой»).
//
// Параметры:
//  Текст - Строка
//  Фрагмент - Строка - Строка, которую нашла модель.
//
// Возвращаемое значение:
//  Булево
Функция МестоПослеПредлога(Текст, Фрагмент)

	Если СтрНайти(Фрагмент, " ") > 0 Или Не ЭтоНазваниеМеста(НормализованноеСлово(Фрагмент)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Нижний = НРег(Текст);
	Искомое = НРег(Фрагмент);
	Позиция = СтрНайти(Нижний, Искомое);
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Пока Позиция > 0 Цикл
		Если СтрНайти(",из,изо,в,во,до,под,около,возле,", "," + СловоПеред(Нижний, Позиция) + ",") = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Следующая = СтрНайти(Сред(Нижний, Позиция + 1), Искомое);
		Позиция = ?(Следующая = 0, 0, Позиция + Следующая);
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Слово перед позицией в тексте (через пробелы) или пустая строка.
//
// Параметры:
//  Текст - Строка - Текст в нижнем регистре.
//  Позиция - Число
//
// Возвращаемое значение:
//  Строка
Функция СловоПеред(Текст, Позиция)

	Конец = Позиция - 1;
	Пока Конец > 0 И Сред(Текст, Конец, 1) = " " Цикл
		Конец = Конец - 1;
	КонецЦикла;
	Начало = Конец;
	Пока Начало > 0 И ЭтоБуква(Сред(Текст, Начало, 1)) Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Возврат Сред(Текст, Начало + 1, Конец - Начало);

КонецФункции

// Заменяет вхождения фрагмента, которые не являются частью другого слова: «Ян» в «Январе» не заменяется.
//
// Параметры:
//  Текст - Строка
//  Фрагмент - Строка
//  Замена - Строка
//
// Возвращаемое значение:
//  Строка
Функция ЗаменитьЦелыеСлова(Текст, Фрагмент, Замена)

	Результат = "";
	Хвост = Текст;
	Длина = СтрДлина(Фрагмент);
	Позиция = СтрНайти(Хвост, Фрагмент);
	Пока Позиция > 0 Цикл
		Перед = ?(Позиция > 1, Сред(Хвост, Позиция - 1, 1), "");
		После = Сред(Хвост, Позиция + Длина, 1);
		ЦелоеСлово = Не ЭтоБуква(Перед) И Не ЭтоБуква(После);
		Результат = Результат + Лев(Хвост, Позиция - 1) + ?(ЦелоеСлово, Замена, Фрагмент);
		Хвост = Сред(Хвост, Позиция + Длина);
		Позиция = СтрНайти(Хвост, Фрагмент);
	КонецЦикла;
	Возврат Результат + Хвост;

КонецФункции

#КонецОбласти

#Область Настройки

// Слова из списков администратора (регистр ИИО_СловаМаскирования).
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Слово в нижнем регистре.
//   * Значение - Строка - Вид ПДн, которым слово скрывается всегда, или пустая строка: не скрывать никогда.
Функция СписокСлов()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	СловаМаскирования.Слово КАК Слово,
	|	СловаМаскирования.ВидПДн КАК ВидПДн
	|ИЗ
	|	РегистрСведений.ИИО_СловаМаскирования КАК СловаМаскирования");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Слова = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Слова.Вставить(НормализованноеСлово(СокрЛП(Выборка.Слово)), СокрЛП(Выборка.ВидПДн));
	КонецЦикла;
	Возврат Слова;

КонецФункции

