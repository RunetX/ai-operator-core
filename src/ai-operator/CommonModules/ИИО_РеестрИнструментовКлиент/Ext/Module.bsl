// Ядро инструментов ИИ-оператора: реестр описаний и единая точка вызова.
// Не зависит от client_mcp: MCP-адаптер, рецепты и тесты вызывают ядро одинаково.

#Область ПрограммныйИнтерфейс

// Создает описание инструмента для реестра.
//
// Параметры:
//  Имя - Строка - Имя инструмента для модели, на английском.
//  Обработчик - ОписаниеОповещения - Функция(ПараметрыОбработчика, ДополнительныеПараметры), где
//    ПараметрыОбработчика - Структура с полями Аргументы и Вызов (см. НовыеПараметрыВызова).
//    Возвращает ответ для модели (Структура, Соответствие или ИИО_ОтветКлиентСервер.Ошибка)
//    либо Неопределено, если ответ отложен и будет передан позже в Завершить.
//  Схема - Структура, Неопределено - JSON Schema аргументов, см. СхемаОбъекта.
//  ОтложенныйОтвет - Булево - Инструмент завершает вызов позже через Завершить.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Описание - Строка - Заполняется из макета ИИО_ОписанияИнструментов при построении реестра.
//   * Схема - Структура
//   * Обработчик - ОписаниеОповещения
//   * ОтложенныйОтвет - Булево
Функция НовыйИнструмент(Имя, Обработчик, Схема = Неопределено, ОтложенныйОтвет = Ложь) Экспорт

	Инструмент = Новый Структура;
	Инструмент.Вставить("Имя", Имя);
	Инструмент.Вставить("Описание", "");
	Инструмент.Вставить("Схема", ?(Схема = Неопределено, СхемаОбъекта(Новый Структура), Схема));
	Инструмент.Вставить("Обработчик", Обработчик);
	Инструмент.Вставить("ОтложенныйОтвет", ОтложенныйОтвет);
	Возврат Инструмент;

КонецФункции

// JSON Schema объекта аргументов.
//
// Параметры:
//  Свойства - Структура - Свойства, см. СвойствоСхемы.
//  Обязательные - Строка - Имена обязательных свойств через запятую.
//
// Возвращаемое значение:
//  Структура
Функция СхемаОбъекта(Свойства, Обязательные = "") Экспорт

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Если ЗначениеЗаполнено(Обязательные) Тогда
		Схема.Вставить("required", СтрРазделить(СтрЗаменить(Обязательные, " ", ""), ","));
	КонецЕсли;
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

// Свойство JSON Schema.
//
// Параметры:
//  Тип - Строка - string, integer, number, boolean, object, array.
//  Описание - Строка - Описание свойства для модели.
//  ДопустимыеЗначения - Массив, Неопределено - Значения enum.
//
// Возвращаемое значение:
//  Структура
Функция СвойствоСхемы(Тип, Описание, ДопустимыеЗначения = Неопределено) Экспорт

	Свойство = Новый Структура("type, description", Тип, Описание);
	Если ДопустимыеЗначения <> Неопределено Тогда
		Свойство.Вставить("enum", ДопустимыеЗначения);
	КонецЕсли;
	Возврат Свойство;

КонецФункции

// Реестр инструментов сеанса. Строится один раз: встроенные инструменты, инструменты пакетов
// (см. ИИО_Пакеты) и описания из макетов. Сбой пакета не ломает ядро: инструменты пакета
// пропускаются, причина пишется в журнал регистрации.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Имя инструмента.
//   * Значение - см. НовыйИнструмент
Функция Инструменты() Экспорт

	Реестр = ПараметрыПриложения.Получить("ИИО.Инструменты");
	Если Реестр <> Неопределено Тогда
		Возврат Реестр;
	КонецЕсли;

	Описания = ИИО_РеестрИнструментовВызовСервера.ОписанияИнструментов();
	Список = Новый Массив;
	ИИО_ИнструментыКлиент.ПриРегистрацииИнструментов(Список);

	Реестр = Новый Соответствие;
	Для Каждого Инструмент Из Список Цикл
		// client_mcp молча перезаписывает дубликаты, поэтому уникальность имен контролирует ядро.
		Если Реестр.Получить(Инструмент.Имя) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Инструмент %1 зарегистрирован дважды.'"), Инструмент.Имя);
		КонецЕсли;
		Описание = Описания.Получить(Инструмент.Имя);
		Если Описание = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Нет описания инструмента %1 в макете ИИО_ОписанияИнструментов.'"), Инструмент.Имя);
		КонецЕсли;
		Инструмент.Описание = Описание;
		Реестр.Вставить(Инструмент.Имя, Инструмент);
	КонецЦикла;

	Для Каждого ИмяМодуля Из ИИО_РеестрИнструментовВызовСервера.МодулиПакетов() Цикл
		ДобавитьИнструментыПакета(Реестр, ИмяМодуля, Описания);
	КонецЦикла;

	ПараметрыПриложения.Вставить("ИИО.Инструменты", Реестр);
	Возврат Реестр;

КонецФункции

// Параметры вызова инструмента со стороны вызывающего (MCP-адаптер, рецепт, тест).
//
// Параметры:
//  Источник - Строка - mcp, recipe, test.
//
// Возвращаемое значение:
//  Структура:
//   * Источник - Строка
//   * ТокенПрогресса - Произвольный - progressToken клиента MCP, если передан.
//   * ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - Получает подготовленный ответ
//     отложенного вызова.
//   * ОповещениеОПрогрессе - ОписаниеОповещения, Неопределено - Получает Структуру
//     с полями Прогресс, Всего, Сообщение.
Функция НовыеПараметрыВызова(Источник) Экспорт

	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("Источник", Источник);
	ПараметрыВызова.Вставить("ТокенПрогресса", Неопределено);
	ПараметрыВызова.Вставить("ОповещениеОЗавершении", Неопределено);
	ПараметрыВызова.Вставить("ОповещениеОПрогрессе", Неопределено);
	Возврат ПараметрыВызова;

КонецФункции

// Единая точка вызова инструмента: обработчик, конвейер ответа, журнал.
//
// Параметры:
//  ИмяИнструмента - Строка - Имя инструмента.
//  Аргументы - Структура, Соответствие - Аргументы вызова.
//  ПараметрыВызова - см. НовыеПараметрыВызова
//
// Возвращаемое значение:
//  Структура, Соответствие - Подготовленный ответ для модели.
//  Неопределено - Ответ отложен и будет передан в ПараметрыВызова.ОповещениеОЗавершении.
Функция Вызвать(ИмяИнструмента, Аргументы, ПараметрыВызова) Экспорт

	Вызов = НовыйВызов(ИмяИнструмента, Аргументы, ПараметрыВызова);
	Если Не ДоступенИИОператор() Тогда
		Возврат ПодготовитьОтвет(Вызов, ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'У пользователя 1С нет роли «Пользователь ИИ-оператора».'"),
			НСтр("ru = 'Скажи пользователю попросить администратора 1С добавить роль в профиль его группы доступа.'")));
	КонецЕсли;
	Инструмент = Инструменты().Получить(ИмяИнструмента);
	Если Инструмент = Неопределено Тогда
		Возврат ПодготовитьОтвет(Вызов, ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'Инструмент %1 не найден.'"), ИмяИнструмента)));
	КонецЕсли;

	Попытка
		// Обработчик получает исходные значения вместо токенов; в журнал уходят аргументы как от модели.
		Ответ = ВыполнитьОбработкуОповещения(Инструмент.Обработчик,
			Новый Структура("Аргументы, Вызов", ИИО_МаскированиеКлиент.Демаскировать(Аргументы), Вызов));
	Исключение
		Возврат ПодготовитьОтвет(Вызов, ВнутренняяОшибка(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Ответ = Неопределено И Инструмент.ОтложенныйОтвет Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Ответ = Неопределено Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", НСтр("ru = 'Инструмент не вернул ответ.'"));
	КонецЕсли;
	Возврат ПодготовитьОтвет(Вызов, Ответ);

КонецФункции

// Завершает отложенный вызов. Повторное завершение игнорируется.
//
// Параметры:
//  Вызов - см. НовыйВызов
//  Ответ - Структура, Соответствие - Ответ инструмента.
Процедура Завершить(Вызов, Ответ) Экспорт

	Если Вызов.Завершен Тогда
		Возврат;
	КонецЕсли;
	Подготовленный = ПодготовитьОтвет(Вызов, Ответ);
	Если Вызов.ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(Вызов.ОповещениеОЗавершении, Подготовленный);
	КонецЕсли;

КонецПроцедуры

// Сообщает о прогрессе долгого вызова, если вызывающий его принимает.
//
// Параметры:
//  Вызов - см. НовыйВызов
//  Прогресс - Число - Выполнено.
//  Всего - Число, Неопределено - Всего.
//  Сообщение - Строка - Что происходит.
Процедура СообщитьПрогресс(Вызов, Прогресс, Всего = Неопределено, Сообщение = "") Экспорт

	Если Вызов.Завершен Или Вызов.ОповещениеОПрогрессе = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыполнитьОбработкуОповещения(Вызов.ОповещениеОПрогрессе,
		Новый Структура("Прогресс, Всего, Сообщение", Прогресс, Всего, Сообщение));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает состояние одного вызова инструмента.
//
// Параметры:
//  ИмяИнструмента - Строка - имя инструмента.
//  Аргументы - Структура, Соответствие - аргументы вызова от модели.
//  ПараметрыВызова - см. НовыеПараметрыВызова
//
// Возвращаемое значение:
//  Структура:
//   * Инструмент - Строка
//   * Аргументы - Структура, Соответствие
//   * Источник - Строка
//   * ТокенПрогресса - Произвольный
//   * ОповещениеОЗавершении - ОписаниеОповещения, Неопределено
//   * ОповещениеОПрогрессе - ОписаниеОповещения, Неопределено
//   * Начало - Число - Момент начала, мс.
//   * Завершен - Булево
Функция НовыйВызов(ИмяИнструмента, Аргументы, ПараметрыВызова)

	Вызов = Новый Структура;
	Вызов.Вставить("Инструмент", ИмяИнструмента);
	Вызов.Вставить("Аргументы", Аргументы);
	Вызов.Вставить("Источник", ПараметрыВызова.Источник);
	Вызов.Вставить("ТокенПрогресса", ПараметрыВызова.ТокенПрогресса);
	Вызов.Вставить("ОповещениеОЗавершении", ПараметрыВызова.ОповещениеОЗавершении);
	Вызов.Вставить("ОповещениеОПрогрессе", ПараметрыВызова.ОповещениеОПрогрессе);
	Вызов.Вставить("Начало", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Вызов.Вставить("Завершен", Ложь);
	Возврат Вызов;

КонецФункции

// Готовит ответ для модели. Конвейер ответа: маскирование ПДн, отметка о завершении
// и запись в журнал регистрации. Все, что уходит модели, проходит через эту точку.
//
// Параметры:
//  Вызов - см. НовыйВызов
//  Ответ - Структура, Соответствие - ответ инструмента или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
//
// Возвращаемое значение:
//  Структура, Соответствие - копия ответа с токенами вместо ПДн, см. ИИО_МаскированиеКлиент.Замаскировать.
Функция ПодготовитьОтвет(Вызов, Ответ)

	Вызов.Завершен = Истина;
	Замаскированный = ИИО_МаскированиеКлиент.Замаскировать(Ответ);
	ЗаписатьВЖурнал(Вызов, Замаскированный);
	Возврат Замаскированный;

КонецФункции

// Добавляет в реестр инструменты пакета.
// Инструменты пакета попадают в реестр только все вместе: конфликт имени или нет описания - пакет пропускается.
//
// Параметры:
//  Реестр - см. Инструменты
//  ИмяМодуля - Строка - имя клиентского модуля пакета, см. ИИО_РеестрИнструментовВызовСервера.МодулиПакетов.
//  Описания - см. ИИО_РеестрИнструментовВызовСервера.ОписанияИнструментов
Процедура ДобавитьИнструментыПакета(Реестр, ИмяМодуля, Описания)

	Список = Новый Массив;
	Попытка
		Модуль = ОбщегоНазначенияКлиент.ОбщийМодуль(ИмяМодуля);
		Модуль.ПриРегистрацииИнструментов(Список);
	Исключение
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого Инструмент Из Список Цикл
		Ошибка = "";
		Если Реестр.Получить(Инструмент.Имя) <> Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Инструмент %1 уже зарегистрирован ядром или другим пакетом.'"),
				Инструмент.Имя);
		ИначеЕсли Описания.Получить(Инструмент.Имя) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Нет описания инструмента %1 в макете пакета.'"), Инструмент.Имя);
		КонецЕсли;
		Если Ошибка <> "" Тогда
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля, Ошибка);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Инструмент Из Список Цикл
		Инструмент.Описание = Описания.Получить(Инструмент.Имя);
		Реестр.Вставить(Инструмент.Имя, Инструмент);
	КонецЦикла;

КонецПроцедуры

// Проверяет, может ли текущий пользователь работать с ИИ-оператором.
// Роль проверяется один раз за сеанс: смена ролей вступает в силу после перезапуска 1С.
//
// Возвращаемое значение:
//  Булево - Истина, если у пользователя роль пользователя или администратора ИИ-оператора либо полные права.
Функция ДоступенИИОператор()

	Доступен = ПараметрыПриложения.Получить("ИИО.Доступен");
	Если Доступен = Неопределено Тогда
		Доступен = ИИО_ПраваВызовСервера.ДоступенИИОператор();
		ПараметрыПриложения.Вставить("ИИО.Доступен", Доступен);
	КонецЕсли;
	Возврат Доступен;

КонецФункции

Функция ВнутренняяОшибка(Информация)

	Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	Ответ.error.Вставить("ПодробноеПредставление", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;

КонецФункции

Процедура ЗаписатьВЖурнал(Вызов, Ответ)

	Сведения = Новый Структура;
	Сведения.Вставить("tool", Вызов.Инструмент);
	Сведения.Вставить("source", Вызов.Источник);
	Сведения.Вставить("status", ?(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ),
		ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "ok"));
	Сведения.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Вызов.Начало);
	Сведения.Вставить("arguments", ИИО_ОтветКлиентСервер.Обрезать(ИИО_ОтветКлиентСервер.ВJSON(Вызов.Аргументы), 2000));

	ПодробноеПредставление = "";
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ)
		И Ответ.error.Свойство("ПодробноеПредставление", ПодробноеПредставление) Тогда
		// Подробности нужны только в журнале, модели уходит краткий текст.
		Ответ.error.Удалить("ПодробноеПредставление");
		Сведения.Вставить("details", ПодробноеПредставление);
	КонецЕсли;

	ИИО_ЖурналВызовСервера.ЗаписатьВызовИнструмента(Сведения);

КонецПроцедуры

#КонецОбласти
