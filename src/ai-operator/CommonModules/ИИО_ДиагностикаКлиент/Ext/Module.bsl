// Клиентские проверки формы «Состояние ИИ-оператора»: компонента транспорта на этом компьютере, токен доступа,
// MCP-сервер в этом сеансе (этап 3д, Р-2). Серверные проверки - ИИО_Диагностика.

#Область СлужебныйПрограммныйИнтерфейс

// Проверки подключения MCP-клиента.
//
// Параметры:
//  Порт - Число - Порт MCP-сервера из настроек.
//
// Возвращаемое значение:
//  Обещание - Результат Массив из см. ИИО_Диагностика.НоваяПроверка
Асинх Функция Проверки(Порт) Экспорт

	Проверки = Новый Массив;
	СистемаПоддерживается = ОбщегоНазначенияКлиент.ЭтоWindowsКлиент();
	Если Не СистемаПоддерживается Тогда
		ДобавитьПроверку(Проверки, "mcp.client", ЗаголовокКомпоненты(), "error",
			НСтр("ru = 'MCP-сервер ИИ-оператора работает только в тонком клиенте 1С для Windows.'"));
		Возврат Проверки;
	КонецЕсли;

	Компонента = Ждать ИИО_ТранспортMCPКлиент.КомпонентаБезУстановки();
	Если Компонента = Неопределено Тогда
		ДобавитьПроверку(Проверки, "mcp.addin", ЗаголовокКомпоненты(), "warning",
			НСтр("ru = 'Компонента еще не установлена на этом компьютере.'"),
			НСтр("ru = 'Нажмите «Запустить»: 1С предложит установить компоненту, это один раз на компьютер.'"), "start");
		ДобавитьПроверку(Проверки, "mcp.token", ЗаголовокТокена(), "skipped",
			НСтр("ru = 'Проверится после установки компоненты.'"));
	Иначе
		Состояние = Ждать ИИО_ТранспортMCPКлиент.СостояниеСервера();
		ДобавитьПроверку(Проверки, "mcp.addin", ЗаголовокКомпоненты(), "ok",
			СтрШаблон(НСтр("ru = 'Установлена, версия %1.'"), Состояние.version));
		ПроверитьТокен(Проверки, Ждать ИИО_ТранспортMCPКлиент.СостояниеТокена(Компонента));
	КонецЕсли;

	ПроверкиСервера = Ждать ПроверкиСервера(Порт, Компонента);
	Для Каждого Проверка Из ПроверкиСервера Цикл
		Проверки.Добавить(Проверка);
	КонецЦикла;
	Возврат Проверки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьТокен(Проверки, Токен)

	Если Токен = Неопределено Тогда
		ДобавитьПроверку(Проверки, "mcp.token", ЗаголовокТокена(), "error",
			НСтр("ru = 'Компонента не ответила.'"));
	ИначеЕсли Токен.exists Тогда
		Если Токен.source = "env" Тогда
			Источник = НСтр("ru = 'переменная окружения AI_OPERATOR_MCP_TOKEN'");
		Иначе
			Источник = Токен.path;
		КонецЕсли;
		ДобавитьПроверку(Проверки, "mcp.token", ЗаголовокТокена(), "ok",
			СтрШаблон(НСтр("ru = 'Есть: %1.'"), Источник));
	Иначе
		Текст = ?(ЗначениеЗаполнено(Токен.error), Токен.error, НСтр("ru = 'Токена нет: MCP-сервер не запустится.'"));
		ДобавитьПроверку(Проверки, "mcp.token", ЗаголовокТокена(), "error", Текст,
			НСтр("ru = 'Нажмите «Создать токен». Значение токена не показывается: клиенты читают его из файла.'"),
			"create_token");
	КонецЕсли;

КонецПроцедуры

// Сервер этого сеанса и самопроверка авторизации.
//
// Параметры:
//  Порт - Число
//  Компонента - ОбъектВнешнейКомпоненты, Неопределено
//
// Возвращаемое значение:
//  Обещание - Результат Массив из см. ИИО_Диагностика.НоваяПроверка
Асинх Функция ПроверкиСервера(Порт, Компонента)

	Проверки = Новый Массив;

	Заголовок = НСтр("ru = 'MCP-сервер в этом сеансе'");
	Состояние = Неопределено;
	Если Компонента <> Неопределено Тогда
		Состояние = Ждать ИИО_ТранспортMCPКлиент.СостояниеСервера();
	КонецЕсли;
	Адрес = СтрШаблон("http://127.0.0.1:%1/mcp", Формат(Порт, "ЧГ=0"));

	Если Состояние <> Неопределено И ТипЗнч(Состояние.running) = Тип("Булево") И Состояние.running Тогда
		ДобавитьПроверку(Проверки, "mcp.server", Заголовок, "ok",
			СтрШаблон(НСтр("ru = 'Работает: %1, подключено клиентов: %2.'"), Адрес,
				Формат(Состояние.sessions, "ЧН=0; ЧГ=0")));
		КодОтвета = ИИО_СерверMCPКлиент.КодОтветаБезТокена(Порт);
		Если КодОтвета = 401 Тогда
			ДобавитьПроверку(Проверки, "mcp.auth", НСтр("ru = 'Авторизация'"), "ok",
				НСтр("ru = 'Запрос без токена отклоняется.'"));
		Иначе
			ДобавитьПроверку(Проверки, "mcp.auth", НСтр("ru = 'Авторизация'"), "error",
				СтрШаблон(НСтр("ru = 'Запрос без токена получил ответ %1 вместо 401.'"), Формат(КодОтвета, "ЧН=0; ЧГ=0")),
				НСтр("ru = 'Остановите ИИ-оператор и запустите снова: при запуске он проверяет авторизацию.'"), "start");
		КонецЕсли;
		Возврат Проверки;
	КонецЕсли;

	// Сервер этого сеанса не работает. Если порт все равно отвечает, его занял другой сеанс 1С или другая программа.
	КодОтвета = ИИО_СерверMCPКлиент.КодОтветаБезТокена(Порт);
	Если КодОтвета <> 0 Тогда
		ДобавитьПроверку(Проверки, "mcp.server", Заголовок, "warning",
			СтрШаблон(НСтр("ru = 'Не запущен, а порт %1 занят: отвечает другой сеанс 1С или другая программа.'"),
				Формат(Порт, "ЧГ=0")),
			НСтр("ru = 'Остановите ИИ-оператор в другом окне 1С или задайте другой порт в «Настройках ИИ-оператора».'"));
	Иначе
		ДобавитьПроверку(Проверки, "mcp.server", Заголовок, "warning",
			НСтр("ru = 'Не запущен: MCP-клиент не подключится.'"),
			НСтр("ru = 'Нажмите «Запустить».'"), "start");
	КонецЕсли;
	Возврат Проверки;

КонецФункции

Процедура ДобавитьПроверку(Проверки, Код, Заголовок, Статус, Текст, Подсказка = "", Действие = "")

	Проверка = Новый Структура("Код, Группа, Заголовок, Статус, Текст, Подсказка, Действие",
		Код, "MCP", Заголовок, Статус, Текст, Подсказка, Действие);
	Проверки.Добавить(Проверка);

КонецПроцедуры

Функция ЗаголовокКомпоненты()

	Возврат НСтр("ru = 'Компонента MCP-транспорта'");

КонецФункции

Функция ЗаголовокТокена()

	Возврат НСтр("ru = 'Токен доступа'");

КонецФункции

#КонецОбласти
