// Инструмент describe_metadata: структура данных конфигурации без самих данных.

#Область СлужебныйПрограммныйИнтерфейс

// Описание метаданных для модели.
//
// Параметры:
//  Аргументы - Структура, Соответствие - name, kind, text, limit.
//
// Возвращаемое значение:
//  Структура - Список объектов или описание одного объекта, либо ошибка.
Функция Описать(Аргументы) Экспорт

	Имя = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "name", "");
	Вид = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "kind", "");
	Текст = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "text", "");
	Лимит = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit", ЛимитПоУмолчанию());

	Если ТипЗнч(Имя) <> Тип("Строка") Или ТипЗнч(Вид) <> Тип("Строка") Или ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Аргументы name, kind и text - строки.'"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат ОписаниеОбъекта(СокрЛП(Имя));
	КонецЕсли;

	Если ЗначениеЗаполнено(Вид) И ИИО_МетаданныеКлиентСервер.ВидыОбъектов().Найти(Вид) = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Неизвестный вид объектов %1.'"), Вид),
			СтрШаблон(НСтр("ru = 'Допустимые виды: %1.'"),
				СтрСоединить(ИИО_МетаданныеКлиентСервер.ВидыОбъектов(), ", ")));
	КонецЕсли;
	Если ТипЗнч(Лимит) <> Тип("Число") Или Лимит < 1 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Аргумент limit - положительное число.'"));
	КонецЕсли;

	Возврат СписокОбъектов(Вид, СокрЛП(Текст), Мин(Цел(Лимит), МаксимальныйЛимит()));

КонецФункции

// Ссылочный объект метаданных (справочник, документ и т.п.) по полному имени, имени или синониму
// для поиска данных (find_ref). Объект должен быть доступен пользователю на чтение.
//
// Параметры:
//  ИмяИлиСиноним - Строка - Справочник.Контрагенты, Контрагенты или синоним.
//
// Возвращаемое значение:
//  ОбъектМетаданных - Найденный объект.
//  Структура - Ошибка для модели: NOT_FOUND или AMBIGUOUS с кандидатами в candidates.
Функция СсылочныйОбъект(ИмяИлиСиноним) Экспорт

	Имя = СокрЛП(ИмяИлиСиноним);
	Виды = СсылочныеВиды();
	Если СтрНайти(Имя, ".") > 0 Тогда
		Объект = Метаданные.НайтиПоПолномуИмени(Имя);
		Если Объект <> Неопределено Тогда
			Вид = СтрРазделить(Объект.ПолноеИмя(), ".")[0];
			Если Виды.Найти(Вид) <> Неопределено И Не Устаревший(Объект.Имя) И ДоступенНаЧтение(Объект, Вид) Тогда
				Возврат Объект;
			КонецЕсли;
		КонецЕсли;
		Имя = СтрРазделить(Имя, ".")[СтрРазделить(Имя, ".").ВГраница()];
	КонецЕсли;

	Подходящие = Новый Массив;
	Точные = Новый Массив;
	Для Каждого Объект Из ПодходящиеОбъекты("", Имя) Цикл
		Если Виды.Найти(СтрРазделить(Объект.ПолноеИмя(), ".")[0]) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Подходящие.Добавить(Объект);
		Если СтепеньСовпадения(НРег(Объект.Имя), НРег(Объект.Синоним), НРег(Имя)) = 3 Тогда
			Точные.Добавить(Объект);
		КонецЕсли;
	КонецЦикла;

	Если Точные.Количество() = 1 Тогда
		Возврат Точные[0];
	ИначеЕсли Точные.Количество() = 0 И Подходящие.Количество() = 1 Тогда
		Возврат Подходящие[0];
	КонецЕсли;

	Кандидаты = Новый Массив;
	Для Каждого Объект Из ?(Точные.Количество() > 1, Точные, Подходящие) Цикл
		Если Кандидаты.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
		Кандидаты.Добавить(Элемент(Объект.ПолноеИмя(), Объект.Синоним));
	КонецЦикла;
	Если Кандидаты.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(
				НСтр("ru = 'Не найден справочник, документ или другой ссылочный объект «%1», доступный пользователю.'"),
				ИмяИлиСиноним),
			НСтр("ru = 'Укажи полное имя вида Справочник.Контрагенты. Найти объект можно через describe_metadata с аргументом text.'"));
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("AMBIGUOUS",
		СтрШаблон(НСтр("ru = 'Вид объектов «%1» неоднозначен.'"), ИмяИлиСиноним),
		НСтр("ru = 'Выбери полное имя из candidates и повтори вызов.'"),
		Новый Структура("candidates", Кандидаты));

КонецФункции

// Компактная запись типа для модели: Строка(100), Число(15,2), Дата, Справочник.Контрагенты,
// составные через «|», длинные составные - сводкой по видам объектов.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов
//
// Возвращаемое значение:
//  Строка
Функция ПредставлениеТипа(ОписаниеТипов) Экспорт

	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() > МаксимумТиповВПредставлении() Тогда
		Возврат СводкаСоставногоТипа(Типы);
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Тип Из Типы Цикл
		Если Тип = Тип("Строка") Тогда
			Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
			Части.Добавить(?(Длина = 0, "Строка", СтрШаблон("Строка(%1)", Формат(Длина, "ЧГ=0"))));
		ИначеЕсли Тип = Тип("Число") Тогда
			Квалификаторы = ОписаниеТипов.КвалификаторыЧисла;
			Части.Добавить(СтрШаблон("Число(%1,%2)", Формат(Квалификаторы.Разрядность, "ЧН=0; ЧГ=0"),
				Формат(Квалификаторы.РазрядностьДробнойЧасти, "ЧН=0; ЧГ=0")));
		ИначеЕсли Тип = Тип("Дата") Тогда
			СоставДаты = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
			Если СоставДаты = ЧастиДаты.Дата Тогда
				Части.Добавить("Дата");
			ИначеЕсли СоставДаты = ЧастиДаты.Время Тогда
				Части.Добавить("Время");
			Иначе
				Части.Добавить("ДатаВремя");
			КонецЕсли;
		ИначеЕсли Тип = Тип("Булево") Тогда
			Части.Добавить("Булево");
		Иначе
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
			Части.Добавить(?(ОбъектМетаданных = Неопределено, Строка(Тип), ОбъектМетаданных.ПолноеИмя()));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СписокОбъектов(Вид, Текст, Лимит)

	Объекты = Новый Массив;
	Всего = 0;
	Для Каждого Объект Из ПодходящиеОбъекты(Вид, Текст) Цикл
		Всего = Всего + 1;
		Если Объекты.Количество() < Лимит Тогда
			Объекты.Добавить(Элемент(Объект.ПолноеИмя(), Объект.Синоним));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("objects", Объекты);
	Результат.Вставить("total", Всего);
	Результат.Вставить("truncated", Всего > Объекты.Количество());
	Если Результат.truncated Тогда
		Результат.Вставить("hint", НСтр("ru = 'Сузьте список аргументами kind и text.'"));
	КонецЕсли;
	Результат.Вставить("source", Источник());
	Возврат Результат;

КонецФункции

// Возвращает объекты, доступные пользователю на чтение, с отбором по виду и части имени или синонима.
// Сначала точные совпадения, затем совпадения с начала, затем остальные.
//
// Параметры:
//  Вид - Строка - вид объектов, например Справочник; пустая строка - все виды.
//  Текст - Строка - часть имени или синонима; пустая строка - без отбора.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных
Функция ПодходящиеОбъекты(Вид, Текст)

	Отбор = НРег(Текст);
	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("Объект");
	Найденные.Колонки.Добавить("Совпадение", Новый ОписаниеТипов("Число"));
	Найденные.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Для Каждого ВидОбъектов Из ИИО_МетаданныеКлиентСервер.ВидыОбъектов() Цикл
		Если ЗначениеЗаполнено(Вид) И Вид <> ВидОбъектов Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Объект Из КоллекцияОбъектов(ВидОбъектов) Цикл
			Если Устаревший(Объект.Имя) Или Не ДоступенНаЧтение(Объект, ВидОбъектов) Тогда
				Продолжить;
			КонецЕсли;
			Совпадение = СтепеньСовпадения(НРег(Объект.Имя), НРег(Объект.Синоним), Отбор);
			Если Совпадение = 0 Тогда
				Продолжить;
			КонецЕсли;
			НайденныйОбъект = Найденные.Добавить();
			НайденныйОбъект.Объект = Объект;
			НайденныйОбъект.Совпадение = Совпадение;
			НайденныйОбъект.Порядок = Найденные.Количество();
		КонецЦикла;
	КонецЦикла;
	Найденные.Сортировать("Совпадение Убыв, Порядок");
	Возврат Найденные.ВыгрузитьКолонку("Объект");

КонецФункции

// Возвращает степень совпадения имени или синонима с отбором.
//
// Параметры:
//  Имя - Строка - имя объекта в нижнем регистре.
//  Синоним - Строка - синоним объекта в нижнем регистре.
//  Отбор - Строка - отбор в нижнем регистре; пустому отбору подходит любой объект.
//
// Возвращаемое значение:
//  Число - 3 - имя или синоним совпадают с отбором, 2 - начинаются с него, 1 - содержат, 0 - не подходят.
Функция СтепеньСовпадения(Имя, Синоним, Отбор)

	Если Не ЗначениеЗаполнено(Отбор) Тогда
		Возврат 1;
	ИначеЕсли Имя = Отбор Или Синоним = Отбор Тогда
		Возврат 3;
	ИначеЕсли СтрНачинаетсяС(Имя, Отбор) Или СтрНачинаетсяС(Синоним, Отбор) Тогда
		Возврат 2;
	ИначеЕсли СтрНайти(Имя, Отбор) > 0 Или СтрНайти(Синоним, Отбор) > 0 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ОписаниеОбъекта(Имя)

	Объект = Метаданные.НайтиПоПолномуИмени(Имя);
	Если Объект = Неопределено Или Устаревший(Объект.Имя) Тогда
		Возврат ОбъектНеНайден(Имя);
	КонецЕсли;
	Вид = СтрРазделить(Объект.ПолноеИмя(), ".")[0];
	Если ИИО_МетаданныеКлиентСервер.ВидыОбъектов().Найти(Вид) = Неопределено
		Или СтрРазделить(Объект.ПолноеИмя(), ".").Количество() > 2 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = '%1 не описывается: инструмент описывает только объекты с данными.'"),
				Объект.ПолноеИмя()),
			СтрШаблон(НСтр("ru = 'Допустимые виды: %1. Реквизит описывается в составе своего объекта.'"),
				СтрСоединить(ИИО_МетаданныеКлиентСервер.ВидыОбъектов(), ", ")));
	КонецЕсли;
	Если Не ДоступенНаЧтение(Объект, Вид) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			СтрШаблон(НСтр("ru = 'У пользователя нет права на чтение %1.'"), Объект.ПолноеИмя()));
	КонецЕсли;

	Результат = Элемент(Объект.ПолноеИмя(), Объект.Синоним);
	Результат.Вставить("kind", Вид);

	Если Вид = "Перечисление" Тогда
		Значения = Новый Массив;
		Для Каждого Значение Из Объект.ЗначенияПеречисления Цикл
			Значения.Добавить(Элемент(Значение.Имя, Значение.Синоним));
		КонецЦикла;
		Результат.Вставить("values", Значения);

	ИначеЕсли Вид = "Константа" Тогда
		Результат.Вставить("type", ПредставлениеТипа(Объект.Тип));

	ИначеЕсли Вид = "ЖурналДокументов" Тогда
		Результат.Вставить("standard_attributes", Реквизиты(Объект.СтандартныеРеквизиты));
		Графы = Новый Массив;
		Для Каждого Графа Из Объект.Графы Цикл
			Графы.Добавить(Элемент(Графа.Имя, Графа.Синоним));
		КонецЦикла;
		Результат.Вставить("columns", Графы);
		РегистрируемыеДокументы = Новый Массив;
		Для Каждого ОбъектДокумент Из Объект.РегистрируемыеДокументы Цикл
			РегистрируемыеДокументы.Добавить(ОбъектДокумент.ПолноеИмя());
		КонецЦикла;
		Результат.Вставить("documents", РегистрируемыеДокументы);

	ИначеЕсли СтрНачинаетсяС(Вид, "Регистр") Тогда
		Результат.Вставить("standard_attributes", Реквизиты(Объект.СтандартныеРеквизиты));
		Результат.Вставить("dimensions", Реквизиты(Объект.Измерения));
		Результат.Вставить("resources", Реквизиты(Объект.Ресурсы));
		Результат.Вставить("attributes", Реквизиты(Объект.Реквизиты));
		Результат.Вставить("virtual_tables", ВиртуальныеТаблицы(Объект, Вид));
		Если Вид = "РегистрБухгалтерии" Тогда
			Результат.Вставить("chart_of_accounts", Объект.ПланСчетов.ПолноеИмя());
			Результат.Вставить("max_ext_dimensions", Объект.ПланСчетов.МаксКоличествоСубконто);
		КонецЕсли;

	Иначе
		Результат.Вставить("standard_attributes", Реквизиты(Объект.СтандартныеРеквизиты));
		Результат.Вставить("attributes", Реквизиты(Объект.Реквизиты));
		ТабличныеЧасти = Новый Массив;
		Для Каждого ТабличнаяЧасть Из Объект.ТабличныеЧасти Цикл
			Если Устаревший(ТабличнаяЧасть.Имя) Тогда
				Продолжить;
			КонецЕсли;
			Описание = Элемент(ТабличнаяЧасть.Имя, ТабличнаяЧасть.Синоним);
			Описание.Вставить("attributes", Реквизиты(ТабличнаяЧасть.Реквизиты));
			ТабличныеЧасти.Добавить(Описание);
		КонецЦикла;
		Результат.Вставить("tabular_sections", ТабличныеЧасти);
		Если Вид = "Документ" Тогда
			// Регистры движений: сами движения модель читает run_query с отбором по Регистратор.
			Регистры = Новый Массив;
			Для Каждого Регистр Из Объект.Движения Цикл
				Если ПравоДоступа("Чтение", Регистр) Тогда
					Регистры.Добавить(Регистр.ПолноеИмя());
				КонецЕсли;
			КонецЦикла;
			Результат.Вставить("register_records", Регистры);
		КонецЕсли;
	КонецЕсли;

	Результат.Вставить("source", Источник());
	Возврат Результат;

КонецФункции

Функция ОбъектНеНайден(Имя)

	Части = СтрРазделить(Имя, ".");
	Кандидаты = Новый Массив;
	Для Каждого Объект Из ПодходящиеОбъекты("", Части[Части.ВГраница()]) Цикл
		Если Кандидаты.Количество() >= 10 Тогда
			Прервать;
		КонецЕсли;
		Кандидаты.Добавить(Объект.ПолноеИмя());
	КонецЦикла;

	Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
		СтрШаблон(НСтр("ru = 'Объект метаданных %1 не найден.'"), Имя),
		НСтр("ru = 'Укажите полное имя вида Справочник.Контрагенты: похожие объекты - в candidates, поиск - describe_metadata с аргументом text.'"),
		Новый Структура("candidates", Кандидаты));

КонецФункции

Функция Реквизиты(Коллекция)

	Результат = Новый Массив;
	Для Каждого Реквизит Из Коллекция Цикл
		Если Устаревший(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Описание = Элемент(Реквизит.Имя, Реквизит.Синоним);
		Описание.Вставить("type", ПредставлениеТипа(Реквизит.Тип));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВиртуальныеТаблицы(Объект, Вид)

	Если Вид = "РегистрСведений" Тогда
		Если Объект.ПериодичностьРегистраСведений
			= Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Возврат СтрРазделить("СрезПоследних,СрезПервых", ",");
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Если Объект.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Возврат СтрРазделить("Остатки,Обороты,ОстаткиИОбороты", ",");
		КонецЕсли;
		Возврат СтрРазделить("Обороты", ",");
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат СтрРазделить("Остатки,Обороты,ОстаткиИОбороты,ОборотыДтКт,ДвиженияССубконто", ",");
	КонецЕсли;
	Возврат Новый Массив;

КонецФункции

// Возвращает сводку составного типа по видам объектов.
// Длинные составные типы (регистратор, субконто) модели полезнее видеть сводкой по видам объектов.
//
// Параметры:
//  Типы - Массив из Тип
//
// Возвращаемое значение:
//  Строка - например «составной из 12 типов: Документ (10), Справочник (2)».
Функция СводкаСоставногоТипа(Типы)

	КоличествоПоВидам = Новый Соответствие;
	Виды = Новый Массив;
	Для Каждого Тип Из Типы Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Вид = ?(ОбъектМетаданных = Неопределено, Строка(Тип), СтрРазделить(ОбъектМетаданных.ПолноеИмя(), ".")[0]);
		Если КоличествоПоВидам.Получить(Вид) = Неопределено Тогда
			Виды.Добавить(Вид);
			КоличествоПоВидам.Вставить(Вид, 0);
		КонецЕсли;
		КоличествоПоВидам.Вставить(Вид, КоличествоПоВидам.Получить(Вид) + 1);
	КонецЦикла;

	Части = Новый Массив;
	Для Каждого Вид Из Виды Цикл
		Части.Добавить(СтрШаблон("%1 (%2)", Вид, Формат(КоличествоПоВидам.Получить(Вид), "ЧГ=0")));
	КонецЦикла;
	Возврат СтрШаблон(НСтр("ru = 'составной из %1 типов: %2'"), Формат(Типы.Количество(), "ЧГ=0"),
		СтрСоединить(Части, ", "));

КонецФункции

Функция МаксимумТиповВПредставлении()

	Возврат 10;

КонецФункции

Функция КоллекцияОбъектов(Вид)

	Если Вид = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли Вид = "ЖурналДокументов" Тогда
		Возврат Метаданные.ЖурналыДокументов;
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Метаданные.Перечисления;
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат Метаданные.ПланыВидовХарактеристик;
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Метаданные.ПланыСчетов;
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат Метаданные.ПланыВидовРасчета;
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	ИначеЕсли Вид = "РегистрНакопления" Тогда
		Возврат Метаданные.РегистрыНакопления;
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат Метаданные.РегистрыБухгалтерии;
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Возврат Метаданные.РегистрыРасчета;
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат Метаданные.БизнесПроцессы;
	ИначеЕсли Вид = "Задача" Тогда
		Возврат Метаданные.Задачи;
	ИначеЕсли Вид = "Константа" Тогда
		Возврат Метаданные.Константы;
	КонецЕсли;
	Возврат Новый Массив;

КонецФункции

Функция ДоступенНаЧтение(Объект, Вид)

	// У перечислений нет прав доступа: их значения видны всем.
	Возврат Вид = "Перечисление" Или ПравоДоступа("Чтение", Объект);

