Функция Элемент(Имя, Синоним)

	Описание = Новый Структура("name", Имя);
	Если ЗначениеЗаполнено(Синоним) И Синоним <> Имя Тогда
		Описание.Вставить("synonym", Синоним);
	КонецЕсли;
	Возврат Описание;

