#Область СлужебныйПрограммныйИнтерфейс

// Может ли текущий пользователь работать с ИИ-оператором. Право на запуск дают роли пользователя
// и администратора ИИ-оператора, роль ИИО_ПолныеПрава и полные права; роль ИИО_БазовыеПрава его не дает.
//
// Возвращаемое значение:
//  Булево
Функция ДоступенИИОператор() Экспорт

	Возврат ПравоДоступа("Просмотр", Метаданные.ОбщиеКоманды.ИИО_ЗапуститьИИОператор)
		Или Пользователи.ЭтоПолноправныйПользователь();

КонецФункции

// Включает текущего пользователя в группу доступа «ИИ-оператор»: так просит установщик параметром запуска
// ИИО_ДобавитьВГруппу. Только администратору: иначе любой пользователь мог бы выдать себе доступ.
//
// Возвращаемое значение:
//  Структура - ok и error, см. ИИО_Права.ДобавитьВГруппуИИОператор.
Функция ДобавитьВГруппуИИОператор() Экспорт

	ВыполнитьПроверкуПравДоступа("Администрирование", Метаданные);
	Возврат ИИО_Права.ДобавитьВГруппуИИОператор(Пользователи.АвторизованныйПользователь());

КонецФункции

#КонецОбласти
