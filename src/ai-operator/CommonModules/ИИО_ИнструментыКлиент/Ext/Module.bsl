// Встроенные инструменты ИИ-оператора в канале MCP: регистрация по определениям ИИО_ИнструментыКлиентСервер
// и клиентские обработчики. Описания для модели - в макете ИИО_ОписанияИнструментов.

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет встроенные инструменты в реестр ядра.
//
// Параметры:
//  Инструменты - Массив из см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент
//  ДействияПакетов - см. ИИО_ИнструментыКлиентСервер.Определения
Процедура ПриРегистрацииИнструментов(Инструменты, ДействияПакетов = Неопределено) Экспорт

	Для Каждого Определение Из ИИО_ИнструментыКлиентСервер.Определения(ДействияПакетов) Цикл
		Если Не ЗначениеЗаполнено(Определение.ОбработчикКлиента) Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Определение.ОбработчикКлиента, ".");
		Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент(Определение.Имя,
			Новый ОписаниеОповещения(Части[1], ОбщегоНазначенияКлиент.ОбщийМодуль(Части[0])),
			Определение.Схема, Определение.ОтложенныйОтвет));
	КонецЦикла;

КонецПроцедуры

// Обработчик инструмента ping.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Ping(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Сведения = ИИО_СведенияВызовСервера.Сведения();
	Сведения.Вставить("progress_token", ПараметрыОбработчика.Вызов.ТокенПрогресса <> Неопределено);
	Возврат Сведения;

КонецФункции

// Обработчик инструмента infobase_info. Инструмент раньше был встроен в client_mcp и остался в списке
// инструментов ради неизменности того, что видит модель: ответ тот же, что в тонком клиенте
// у client_mcp, - версия и тип платформы и признак файловой базы.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция СведенияОБазе(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("Платформа", Новый Структура("Версия, ТипПлатформы",
		СистемнаяИнформация.ВерсияПриложения, Строка(СистемнаяИнформация.ТипПлатформы)));
	Сведения.Вставить("Конфигурация", Новый Структура("Имя, Версия", "", ""));
	Сведения.Вставить("ВстроенныйЯзык", "");
	Сведения.Вставить("ФайловаяБаза", СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1);
	Сведения.Вставить("Расширения", Новый Массив);
	Сведения.Вставить("РасширенияДоступны", Ложь);
	Возврат Сведения;

КонецФункции

