// Встроенные инструменты ИИ-оператора. Описания для модели - в макете ИИО_ОписанияИнструментов.

#Область СлужебныйПрограммныйИнтерфейс

// Добавляет встроенные инструменты в реестр ядра.
//
// Параметры:
//  Инструменты - Массив из см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент
Процедура ПриРегистрацииИнструментов(Инструменты) Экспорт

	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("ping",
		Новый ОписаниеОповещения("Ping", ИИО_ИнструментыКлиент)));

	Свойства = Новый Структура;
	Свойства.Вставить("name", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Полное имя объекта метаданных, например Справочник.Контрагенты или Документ.РеализацияТоваровУслуг. "
		+ "Если не задано - список объектов."));
	Свойства.Вставить("kind", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Вид объектов для списка.", ИИО_МетаданныеКлиентСервер.ВидыОбъектов()));
	Свойства.Вставить("text", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Часть имени или синонима для отбора списка, без учета регистра."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько объектов вернуть в списке, по умолчанию 100, не больше 500."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("describe_metadata",
		Новый ОписаниеОповещения("ОписатьМетаданные", ИИО_ИнструментыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства)));

	Свойства = Новый Структура;
	Свойства.Вставить("text", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Текст запроса на языке запросов 1С. Можно пакет с ПОМЕСТИТЬ во временные таблицы: модель получает результат последней выборки."));
	Свойства.Вставить("params", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("object",
		"Значения параметров &Имя: {""Имя"": значение}. Даты в ISO 8601 (2025-01-31), ссылки строкой ref из ответов инструментов, списки массивами."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько строк вернуть, по умолчанию 50. Больше лимита, заданного администратором (обычно 200), не вернется."));
	Свойства.Вставить("timeout_sec", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Таймаут выполнения, с. Можно только сократить таймаут, заданный администратором (обычно 30)."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("run_query",
		Новый ОписаниеОповещения("ВыполнитьЗапрос", ИИО_ЗапросыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "text"), Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("kind", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Где искать: полное имя (Справочник.Контрагенты, Документ.РеализацияТоваровУслуг) или синоним (Контрагенты)."));
	Свойства.Вставить("text", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Что искать, как сказал пользователь: наименование или его часть, ИНН, код, номер документа."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько кандидатов вернуть, по умолчанию 10, не больше 50."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("find_ref",
		Новый ОписаниеОповещения("НайтиСсылку", ИИО_ИнструментыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "kind, text")));

	СвойствоСсылок = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Ссылки из ответов инструментов: строки ref (Документ.РеализацияТоваровУслуг:<УИД>) или объекты {""ref"": ...}.");
	СвойствоСсылок.Вставить("items", Новый Структура);
	Свойства = Новый Структура;
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("title", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Заголовок окна для пользователя, например «Реализации Рога и копыта за март 2016»."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("show_in_1c",
		Новый ОписаниеОповещения("ПоказатьВ1С", ИИО_ПоказКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "refs")));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Ссылка из ответа инструмента: строка ref или объект {""ref"": ...}."));
	Свойства.Вставить("view", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Что открыть: form - форму объекта (по умолчанию), related - структуру подчиненности, movements - движения документа.",
		СтрРазделить("form,related,movements", ",")));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("open_object",
		Новый ОписаниеОповещения("ОткрытьОбъект", ИИО_ПоказКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "ref")));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Документ: строка ref из ответа инструмента или объект {""ref"": ...}."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько оснований и сколько подчиненных вернуть, по умолчанию 20, не больше 100."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("related_objects",
		Новый ОписаниеОповещения("СвязанныеОбъекты", ИИО_ИнструментыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "ref")));

	Свойства = Новый Структура;
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("form", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"id печатной формы из ответа print_documents без form, например ТОРГ12."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("print_documents",
		Новый ОписаниеОповещения("Напечатать", ИИО_ПоказКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "refs")));

	Свойства = Новый Структура;
	Свойства.Вставить("text", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Слова из вопроса пользователя: выручка, продажи, задолженность, остатки. Без text - все поддерживаемые отчеты."));
	Свойства.Вставить("report", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Полное имя отчета, например Отчет.Продажи: вернуть его варианты, поля отборов и строк, показатели."));
	Свойства.Вставить("limit", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько вариантов вернуть, по умолчанию 20, не больше 100."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("list_reports",
		Новый ОписаниеОповещения("НайтиОтчеты", ИИО_ОтчетыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства)));

	СвойствоОтборов = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Отборы: [{""field"": ""Контрагент"", ""op"": ""eq"", ""value"": ""Справочник.Контрагенты:<УИД>""}]. "
		+ "op: eq, ne, in, not_in, in_hierarchy. Для in - массив значений. Ссылки - ref из ответов инструментов.");
	СвойствоОтборов.Вставить("items", Новый Структура("type", "object"));
	СвойствоГруппировок = ИИО_РеестрИнструментовКлиент.СвойствоСхемы("array",
		"Поля строк отчета вместо полей варианта, например [""Контрагент"", ""Документ""] - расшифровка до документов.");
	СвойствоГруппировок.Вставить("items", Новый Структура("type", "string"));
	Свойства = Новый Структура;
	Свойства.Вставить("report", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Полное имя отчета из list_reports, например Отчет.Продажи."));
	Свойства.Вставить("variant", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Ключ варианта из list_reports. По умолчанию - первый вариант отчета."));
	Свойства.Вставить("period", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("object",
		"Период: {""from"": ""2016-01-01"", ""to"": ""2016-03-31""} или {""preset"": ""prev_quarter""}. "
		+ "Пресеты: today, this_week, this_month, prev_month, this_quarter, prev_quarter, this_year, prev_year. По умолчанию - текущий месяц."));
	Свойства.Вставить("filters", СвойствоОтборов);
	Свойства.Вставить("group_by", СвойствоГруппировок);
	Свойства.Вставить("rows", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Сколько строк вернуть, по умолчанию 50. Больше лимита, заданного администратором (обычно 200), не вернется."));
	Свойства.Вставить("show", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("boolean",
		"Открыть отчет пользователю в 1С с теми же настройками, по умолчанию true."));
	Свойства.Вставить("timeout_sec", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("integer",
		"Таймаут формирования, с. Можно только сократить таймаут, заданный администратором (обычно 30)."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("run_report",
		Новый ОписаниеОповещения("СформироватьОтчет", ИИО_ОтчетыКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "report"), Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("action", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Действие: post - провести документы, unpost - отменить проведение.", СтрРазделить("post,unpost", ",")));
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("dry_run", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("boolean",
		"Только проверить и показать план в 1С, ничего не меняя. Ответ приходит сразу, без подтверждения."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("perform",
		Новый ОписаниеОповещения("ВыполнитьДействие", ИИО_ДействияКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "action, refs"), Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("batch_id", ИИО_РеестрИнструментовКлиент.СвойствоСхемы("string",
		"Идентификатор пакета из ответа perform."));
	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("undo",
		Новый ОписаниеОповещения("Откатить", ИИО_ДействияКлиент),
		ИИО_РеестрИнструментовКлиент.СхемаОбъекта(Свойства, "batch_id"), Истина));

	Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент("close_forms",
		Новый ОписаниеОповещения("ЗакрытьФормы", ИИО_ФормыКлиент)));

КонецПроцедуры

// Обработчик инструмента ping.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция Ping(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Сведения = ИИО_СведенияВызовСервера.Сведения();
	Сведения.Вставить("progress_token", ПараметрыОбработчика.Вызов.ТокенПрогресса <> Неопределено);
	Возврат Сведения;

КонецФункции

// Обработчик инструмента describe_metadata.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция ОписатьМетаданные(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИО_МетаданныеВызовСервера.Описать(ПараметрыОбработчика.Аргументы);

КонецФункции

// Обработчик инструмента find_ref.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция НайтиСсылку(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИО_ПоискВызовСервера.НайтиСсылки(ПараметрыОбработчика.Аргументы);

КонецФункции

// Обработчик инструмента related_objects.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция СвязанныеОбъекты(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИО_СвязиВызовСервера.СвязанныеОбъекты(ПараметрыОбработчика.Аргументы);

КонецФункции

#КонецОбласти
