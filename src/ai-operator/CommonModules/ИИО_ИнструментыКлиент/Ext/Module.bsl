// Обработчик инструмента explain_error. Без ref проверяется документ из активного окна пользователя:
// форма документа или текущая строка списка документов.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция РазобратьОшибку(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Аргументы = ПараметрыОбработчика.Аргументы;
	Если ЗначениеЗаполнено(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "ref")) Тогда
		Возврат ИИО_РазборОшибокВызовСервера.РазобратьОшибку(Аргументы);
	КонецЕсли;
	Окно = АктивноеОкно();
	Для Каждого Форма Из ?(Окно = Неопределено, Новый Массив, Окно.Содержимое) Цикл
		Ссылка = СсылкаФормы(Форма);
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат ИИО_РазборОшибокВызовСервера.РазобратьОшибку(Аргументы, Ссылка, Форма.Модифицированность);
		КонецЕсли;
	КонецЦикла;
	Возврат ИИО_РазборОшибокВызовСервера.РазобратьОшибку(Аргументы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект формы или текущая строка ее основного списка. Вид объекта проверяет сервер.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
// Возвращаемое значение:
//  Произвольный - Ссылка или Неопределено.
Функция СсылкаФормы(Форма)

	// Свойства читаются через структуры: реквизита Объект нет у списков, а Ссылки - у объекта отчета и обработки.
	Реквизиты = Новый Структура("Объект");
	ЗаполнитьЗначенияСвойств(Реквизиты, Форма);
	Поля = Новый Структура("Ссылка");
	// Реквизит Объект бывает и не данными объекта (например, у форм начальной страницы).
	Если ТипЗнч(Реквизиты.Объект) = Тип("ДанныеФормыСтруктура") Тогда
		ЗаполнитьЗначенияСвойств(Поля, Реквизиты.Объект);
	КонецЕсли;
	Если Поля.Ссылка = Неопределено И Форма.Элементы.Найти("Список") <> Неопределено Тогда
		Поля.Ссылка = Форма.Элементы.Список.ТекущаяСтрока;
	КонецЕсли;
	Возврат Поля.Ссылка;

КонецФункции

#КонецОбласти
