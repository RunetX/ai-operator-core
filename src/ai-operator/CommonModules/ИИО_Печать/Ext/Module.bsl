// Инструмент print_documents: печатные формы из меню «Печать» штатного списка.
// Модель получает только названия форм и итог; содержимое печатных форм остается в 1С: в нем ПДн,
// которые маскирование по ссылкам и полям не видит.

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет ссылки и печатную форму.
//
// Параметры:
//  Аргументы - Структура, Соответствие - refs, form.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * Ответ - Структура, Неопределено - Ответ модели без печати, если form не задан:
//       hint, kind, count, forms, not_found.
//   * Показ - Структура - Для печати: см. ИИО_Показ.ПодготовитьПоказ.
//   * ПечатнаяФорма - Структура - Для печати: id и name.
Функция ПодготовитьПечать(Знач Аргументы) Экспорт

	Ссылки = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "refs");
	Если ТипЗнч(Ссылки) = Тип("Массив") И Ссылки.Количество() > МаксимумСсылок() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Слишком много документов: %1, можно не больше %2.'"),
				Формат(Ссылки.Количество(), "ЧГ=0"), Формат(МаксимумСсылок(), "ЧГ=0")),
			НСтр("ru = 'Печатай частями.'"));
	КонецЕсли;
	Показ = ИИО_Показ.ПодготовитьПоказ(Новый Структура("refs", Ссылки));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Показ) Тогда
		Возврат Показ;
	ИначеЕсли Показ.Виды.Количество() > 1 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Печать - для объектов одного вида, а переданы: %1.'"),
				СтрСоединить(Показ.Виды, ", ")),
			НСтр("ru = 'Вызови print_documents отдельно для каждого вида.'"));
	КонецЕсли;

	Вид = Показ.Виды[0];
	Формы = ПечатныеФормы(Вид);
	Если Формы.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'У «%1» нет печатных форм, доступных пользователю.'"),
				Метаданные.НайтиПоПолномуИмени(Вид).Представление()));
	КонецЕсли;

	Выбранная = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "form", "");
	Если Не ЗначениеЗаполнено(Выбранная) Тогда
		// Подсказка первой: без нее Gemma 4 отвечала «выберите форму в открывшемся окне», хотя окна нет.
		Ответ = Новый Структура("hint, kind, count, forms",
			НСтр("ru = 'Пользователю ничего не открыто: это список форм для тебя. Выбери id по словам пользователя и вызови print_documents с form; если подходят несколько - спроси в чате, какую печатать.'"),
			Вид, Показ.Ссылки.Количество(), Формы);
		Если Показ.НеНайдено > 0 Тогда
			Ответ.Вставить("not_found", Показ.НеНайдено);
		КонецЕсли;
		Возврат Новый Структура("Ответ", Ответ);
	КонецЕсли;

	ПечатнаяФорма = НайтиФорму(Формы, Строка(Выбранная));
	Если ПечатнаяФорма = Неопределено Тогда
		Доступные = Новый Массив;
		Для Каждого Форма Из Формы Цикл
			Доступные.Добавить(СтрШаблон("%1 (%2)", Форма.id, Форма.name));
		КонецЦикла;
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Нет печатной формы «%1».'"), ИИО_ОтветКлиентСервер.Обрезать(Строка(Выбранная), 100)),
			СтрШаблон(НСтр("ru = 'Передай id одной из форм: %1.'"),
				ИИО_ОтветКлиентСервер.Обрезать(СтрСоединить(Доступные, ", "), 800)));
	КонецЕсли;
	Возврат Новый Структура("Ответ, Показ, ПечатнаяФорма", Неопределено, Показ, ПечатнаяФорма);

КонецФункции

// Печатные формы, которые пользователь видит в меню «Печать» основной формы списка.
// Команды получаются в сеансе пользователя: права на связанные объекты проверяет код конфигурации,
// который их добавляет. Отключенные администратором и скрытые функциональными опциями пропускаются.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя вида объектов.
//
// Возвращаемое значение:
//  Массив из Структура - id (идентификатор команды) и name (представление).
Функция ПечатныеФормы(ПолноеИмя) Экспорт

	Формы = Новый Массив;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено
		Или Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		Возврат Формы;
	КонецЕсли;
	// Свойство читается через структуру: у видов объектов без форм списка его нет.
	Свойства = Новый Структура("ОсновнаяФормаСписка");
	ЗаполнитьЗначенияСвойств(Свойства, ОбъектМетаданных);
	ФормаСписка = Свойства.ОсновнаяФормаСписка;
	Если ФормаСписка = Неопределено Тогда
		Возврат Формы;
	КонецЕсли;

	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	Команды = МодульУправлениеПечатью.КомандыПечатиФормы(ФормаСписка.ПолноеИмя());
	Пропуск = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Отключена,СкрытаФункциональнымиОпциями,КомандаПоУмолчанию", ",") Цикл
		Если Команды.Колонки.Найти(Имя) <> Неопределено Тогда
			Пропуск.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Добавленные = Новый Соответствие;
	Для Каждого Команда Из Команды Цикл
		Пропустить = Не ЗначениеЗаполнено(Команда.Идентификатор)
			Или Добавленные.Получить(Команда.Идентификатор) <> Неопределено;
		Для Каждого Имя Из Пропуск Цикл
			Пропустить = Пропустить Или Команда[Имя] = Истина;
		КонецЦикла;
		Если Пропустить Тогда
			Продолжить;
		КонецЕсли;
		Добавленные.Вставить(Команда.Идентификатор, Истина);
		Формы.Добавить(Новый Структура("id, name", Команда.Идентификатор, Команда.Представление));
	КонецЦикла;
	Возврат Формы;

КонецФункции

// Имя команды печати в форме по таблице подключенных команд БСП (ПараметрыПодключаемыхКоманд.АдресТаблицыКоманд).
//
// Параметры:
//  АдресТаблицыКоманд - Строка - Адрес во временном хранилище.
//  Идентификатор - Строка - Идентификатор команды печати.
//
// Возвращаемое значение:
//  Строка - Имя команды формы или пустая строка, если команды нет.
Функция ИмяКомандыВФорме(АдресТаблицыКоманд, Идентификатор) Экспорт

	Если ТипЗнч(АдресТаблицыКоманд) <> Тип("Строка") Или Не ЭтоАдресВременногоХранилища(АдресТаблицыКоманд) Тогда
		Возврат "";
	КонецЕсли;
	Команды = ПолучитьИзВременногоХранилища(АдресТаблицыКоманд);
	Если ТипЗнч(Команды) <> Тип("ТаблицаЗначений") Или Команды.Колонки.Найти("ИмяВФорме") = Неопределено
		Или Команды.Колонки.Найти("Вид") = Неопределено Или Команды.Колонки.Найти("Идентификатор") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Команда Из Команды.НайтиСтроки(Новый Структура("Вид, Идентификатор", "Печать", Идентификатор)) Цикл
		Возврат Команда.ИмяВФорме;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает печатную форму по id или, если модель передала название, по name без учета регистра.
//
// Параметры:
//  Формы - см. ПечатныеФормы
//  Выбранная - Строка - id или название печатной формы от модели.
//
// Возвращаемое значение:
//  - Структура - найденная печатная форма: id и name.
//  - Неопределено - если такой формы нет.
Функция НайтиФорму(Формы, Выбранная)

	Для Каждого Форма Из Формы Цикл
		Если Форма.id = Выбранная Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Форма Из Формы Цикл
		Если НРег(Форма.id) = НРег(Выбранная) Или НРег(Форма.name) = НРег(Выбранная) Тогда
			Возврат Форма;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция МаксимумСсылок()

	Возврат 200;

КонецФункции

#КонецОбласти
