// MCP-транспорт ИИ-оператора: своя внешняя компонента из общего макета ИИО_ТранспортMCP.
// Компонента держит сервер MCP на 127.0.0.1 и сама проверяет токен. Вызов инструмента приходит внешним
// событием с номером вызова, данные вызова ядро забирает методом ВзятьВызов, а ответ, ошибку и прогресс
// отдает методами компоненты. Компонента вызывается только асинхронно: синхронные вызовы внешних компонент
// в конфигурации могут быть запрещены.

#Область СлужебныйПрограммныйИнтерфейс

// Запускает сервер MCP: передает компоненте сведения о сервере и инструменты, затем открывает порт.
//
// Параметры:
//  Порт - Число - Порт на 127.0.0.1.
//  ТаймаутСек - Число - Сколько сервер ждет ответа на вызов инструмента.
//  Сведения - Структура - name, version, title, description, instructions для initialize.
//  Инструменты - Массив из Структура - name, description, inputSchema для tools/list.
//
// Возвращаемое значение:
//  Обещание - Результат Структура:
//   * ok - Булево
//   * code - Строка - Код ошибки: NO_TOKEN, PORT_BUSY, ADDIN_FAILED, UNSUPPORTED_CLIENT и другие.
//   * error - Строка - Текст ошибки.
Асинх Функция Запустить(Порт, ТаймаутСек, Сведения, Инструменты) Экспорт

	// Компонента собрана только для Windows: в других клиентах подключать и предлагать установить нечего.
	СистемаПоддерживается = ОбщегоНазначенияКлиент.ЭтоWindowsКлиент();
	Если Не СистемаПоддерживается Тогда
		Возврат НовыйРезультат("UNSUPPORTED_CLIENT",
			НСтр("ru = 'MCP-сервер ИИ-оператора работает только в тонком клиенте 1С для Windows.'"));
	КонецЕсли;
	Подключение = Ждать ПодключеннаяКомпонента(Истина);
	Компонента = Подключение.Компонента;
	Если Компонента = Неопределено Тогда
		Пояснение = НСтр("ru = 'Не удалось подключить внешнюю компоненту MCP-транспорта.'");
		Если ЗначениеЗаполнено(Подключение.ТекстОшибки) Тогда
			Пояснение = Пояснение + Символы.ПС + Подключение.ТекстОшибки;
		КонецЕсли;
		Возврат НовыйРезультат("ADDIN_FAILED", Пояснение);
	КонецЕсли;
	ТекстСведений = ИИО_ОтветКлиентСервер.ВJSON(Сведения);
	Результат = РезультатКомпоненты(Ждать Компонента.УстановитьИнформациюОСервереАсинх(ТекстСведений));
	Если Результат.ok Тогда
		ТекстИнструментов = ИИО_ОтветКлиентСервер.ВJSON(Инструменты);
		Результат = РезультатКомпоненты(Ждать Компонента.УстановитьИнструментыАсинх(ТекстИнструментов));
	КонецЕсли;
	Если Результат.ok Тогда
		// Пустой список Origins: браузерам разрешены только localhost и 127.0.0.1.
		Результат = РезультатКомпоненты(Ждать Компонента.ЗапуститьАсинх(Порт, "", ТаймаутСек));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Останавливает сервер MCP: ждущие вызовы получают ошибку, порт освобождается.
//
// Возвращаемое значение:
//  Обещание - Результат Булево: Истина, если сервер работал.
Асинх Функция Остановить() Экспорт

	Компонента = Компонента();
	Если Компонента = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Результат = Ждать Компонента.ОстановитьАсинх();
	Возврат ТипЗнч(Результат.Значение) = Тип("Булево") И Результат.Значение;

КонецФункции

// Состояние сервера для диагностики: работает ли, порт, источник токена, число сессий и ждущих вызовов.
//
// Возвращаемое значение:
//  Обещание - Результат Структура или Неопределено, если компонента не подключалась.
Асинх Функция СостояниеСервера() Экспорт

	Компонента = Компонента();
	Если Компонента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Ждать Компонента.СостояниеАсинх();
	Возврат ИзJSON(Результат.Значение);

КонецФункции

// Подключает компоненту для формы «Состояние ИИ-оператора», не предлагая установку: форма только смотрит.
//
// Возвращаемое значение:
//  Обещание - Результат ВнешняяКомпонента или Неопределено, если компонента не установлена на этом компьютере.
Асинх Функция КомпонентаБезУстановки() Экспорт

	Подключение = Ждать ПодключеннаяКомпонента(Ложь);
	Возврат Подключение.Компонента;

КонецФункции

// Есть ли токен доступа и откуда он читается. Значение токена компонента не отдает.
//
// Параметры:
//  Компонента - ОбъектВнешнейКомпоненты - см. КомпонентаБезУстановки.
//
// Возвращаемое значение:
//  Обещание - Результат Структура: exists, source (env, env_file, file), path, error.
Асинх Функция СостояниеТокена(Компонента) Экспорт

	Результат = Ждать Компонента.СостояниеТокенаАсинх();
	Возврат ИзJSON(Результат.Значение);

КонецФункции

// Создает новый токен доступа в файле профиля пользователя. Сервер, запущенный раньше, примет его после
// перезапуска.
//
// Параметры:
//  Компонента - ОбъектВнешнейКомпоненты
//  Перезаписать - Булево - Заменить существующий токен: у настроенных клиентов старый перестанет работать.
//
// Возвращаемое значение:
//  Обещание - Результат Структура: ok, code (EXISTS, IO), error, path, active.
Асинх Функция СоздатьТокен(Компонента, Перезаписать) Экспорт

	Результат = Ждать Компонента.СоздатьТокенАсинх(Перезаписать);
	Возврат ИзJSON(Результат.Значение);

КонецФункции

// Пишет скрипты для настроек MCP-клиентов: заголовок авторизации для Claude Code и мост для Claude Desktop
// и LM Studio. Токен в настройки клиентов не попадает.
//
// Параметры:
//  Компонента - ОбъектВнешнейКомпоненты
//  Порт - Число
//
// Возвращаемое значение:
//  Обещание - Результат Структура: ok, headersHelper, bridge, error.
Асинх Функция ПодготовитьФайлыКлиентов(Компонента, Порт) Экспорт

	Результат = Ждать Компонента.ПодготовитьФайлыКлиентовАсинх(Порт);
	Возврат ИзJSON(Результат.Значение);

КонецФункции

// Обрабатывает внешнее событие компоненты. Вызывается из модуля управляемого приложения для всех внешних
// событий, поэтому события других компонент пропускаются.
//
// Параметры:
//  Источник - Строка
//  Событие - Строка - TOOL_CALL или CANCELLED.
//  Данные - Строка - JSON с callId и, для отмены, reason.
Процедура ОбработатьВнешнееСобытие(Источник, Событие, Данные) Экспорт

	Если Источник <> ИсточникСобытий() Тогда
		Возврат;
	КонецЕсли;
	Сведения = ИзJSON(Данные);
	Если Сведения = Неопределено Или Не Сведения.Свойство("callId") Тогда
		Возврат;
	КонецЕсли;
	Если Событие = "TOOL_CALL" Тогда
		ВызватьИнструмент(Сведения.callId);
	ИначеЕсли Событие = "CANCELLED" Тогда
		ИИО_ПровайдерMCPКлиент.ОтменитьВызов(Сведения.callId,
			?(Сведения.Свойство("reason"), Сведения.reason, "client"));
	КонецЕсли;

КонецПроцедуры

// Передает клиенту MCP ответ инструмента.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты.
//  Текст - Строка - Текст ответа для модели.
Асинх Процедура ОтправитьОтвет(Идентификатор, Текст) Экспорт

	Компонента = Компонента();
	Если Компонента <> Неопределено Тогда
		Ждать Компонента.ОтправитьОтветАсинх(Идентификатор, Текст);
	КонецЕсли;

КонецПроцедуры

// Передает клиенту MCP ошибку JSON-RPC: сбой, который модель исправить не может.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты.
//  Код - Число - Код ошибки JSON-RPC.
//  Сообщение - Строка
Асинх Процедура ОтправитьОшибку(Идентификатор, Код, Сообщение) Экспорт

	Компонента = Компонента();
	Если Компонента <> Неопределено Тогда
		Ждать Компонента.ОтправитьОшибкуАсинх(Идентификатор, Код, Сообщение);
	КонецЕсли;

КонецПроцедуры

// Передает клиенту MCP прогресс долгого вызова. Компонента отправляет его, только если клиент передал
// progressToken, и отбрасывает значения, которые не больше прошлого.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты.
//  Прогресс - Число
//  Всего - Число, Неопределено
//  Сообщение - Строка
Асинх Процедура УведомитьОПрогрессе(Идентификатор, Прогресс, Всего, Сообщение) Экспорт

	Компонента = Компонента();
	Если Компонента <> Неопределено Тогда
		Ждать Компонента.УведомитьОПрогрессеАсинх(Идентификатор, Прогресс, Всего, Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Забирает данные вызова у компоненты и передает его ядру. Пустые данные - вызов уже отменен или истек.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты.
Асинх Процедура ВызватьИнструмент(Идентификатор)

	Компонента = Компонента();
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Результат = Ждать Компонента.ВзятьВызовАсинх(Идентификатор);
	Вызов = ИзJSON(Результат.Значение);
	Если Вызов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ИИО_ПровайдерMCPКлиент.ВызватьИнструмент(Идентификатор, Вызов.name, Вызов.arguments, Вызов.progressToken);
	Исключение
		// Сбой до реестра инструментов (разбор аргументов, адаптер): клиент получает ошибку вместо ожидания
		// до таймаута, администратор - подробности в журнале.
		СведенияОбОшибке = ИнформацияОбОшибке();
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуТранспорта(ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке));
		ОтправитьОшибку(Идентификатор, -32000,
			"INTERNAL: " + ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(СведенияОбОшибке));
	КонецПопытки;

КонецПроцедуры

// Подключает компоненту из макета расширения один раз за сеанс. При первом запуске на компьютере БСП
// спрашивает пользователя об установке с пояснением, зачем компонента нужна.
//
// Параметры:
//  ПредлагатьУстановку - Булево - Ложь: только подключить уже установленную компоненту.
//
// Возвращаемое значение:
//  Обещание - Результат Структура:
//   * Компонента - ОбъектВнешнейКомпоненты, Неопределено - Неопределено, если подключить не удалось.
//   * ТекстОшибки - Строка - Причина; пустая, если пользователь отказался от установки.
Асинх Функция ПодключеннаяКомпонента(ПредлагатьУстановку)

	Результат = Новый Структура("Компонента, ТекстОшибки", Компонента(), "");
	Если Результат.Компонента <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Параметры = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
	Параметры.ТекстПояснения = НСтр("ru = 'Для работы ИИ-оператора с MCP-клиентами (Claude, LM Studio и другими) нужна внешняя компонента «MCP-транспорт ИИ-оператора». Без нее ИИ-оператор не запустится.'");
	Параметры.ИдентификаторыСозданияОбъектов.Добавить(ИмяКлассаКомпоненты());
	Параметры.ПредложитьУстановить = ПредлагатьУстановку;
	// В процессе клиента: так проверены задержка событий и остановка сервера.
	Параметры.Изолированно = Ложь;
	Подключение = Ждать ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакетаАсинх(ИмяКомпоненты(),
		"ОбщийМакет.ИИО_ТранспортMCP", Параметры);
	Если Не Подключение.Подключено Тогда
		Результат.ТекстОшибки = Подключение.ОписаниеОшибки;
		Если ЗначениеЗаполнено(Подключение.ОписаниеОшибки) Тогда
			ИИО_ЖурналВызовСервера.ЗаписатьЗапускСервера(Новый Структура("status, message", "ADDIN_FAILED",
				Подключение.ОписаниеОшибки));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	// Пока ждали подключения, объект мог создать другой вызов: запуск по параметру и форма состояния
	// подключают компоненту одновременно. Объект в сеансе один: вытесненный объект освобождается
	// и останавливает свой сервер.
	Подключенная = Компонента();
	Если Подключенная <> Неопределено Тогда
		Результат.Компонента = Подключенная;
		Возврат Результат;
	КонецЕсли;
	Результат.Компонента = Подключение.ПодключаемыйМодуль.Получить(ИмяКлассаКомпоненты());
	ПараметрыПриложения.Вставить(ИмяПараметраКомпоненты(), Результат.Компонента);
	Возврат Результат;

КонецФункции

Функция Компонента()

	Возврат ПараметрыПриложения.Получить(ИмяПараметраКомпоненты());

КонецФункции

Функция ИмяПараметраКомпоненты()

	Возврат "ИИО.ТранспортMCP";

КонецФункции

Функция ИмяКомпоненты()

	Возврат "AiOperatorMcp";

КонецФункции

Функция ИмяКлассаКомпоненты()

	Возврат "Transport";

КонецФункции

Функция ИсточникСобытий()

	Возврат "AiOperatorMcp";

КонецФункции

// Результат метода компоненты: JSON вида {"ok": true} или {"ok": false, "code": ..., "error": ...}.
//
// Параметры:
//  РезультатВызова - Произвольный - Результат асинхронного вызова метода компоненты.
//
// Возвращаемое значение:
//  Структура - ok, code, error.
Функция РезультатКомпоненты(РезультатВызова)

	Данные = ИзJSON(РезультатВызова.Значение);
	Если Данные = Неопределено Тогда
		Возврат НовыйРезультат("ADDIN_FAILED", НСтр("ru = 'Компонента MCP-транспорта вернула неожиданный ответ.'"));
	КонецЕсли;
	Результат = НовыйРезультат("", "");
	ЗаполнитьЗначенияСвойств(Результат, Данные);
	Возврат Результат;

КонецФункции

Функция НовыйРезультат(Код, ТекстОшибки)

	Возврат Новый Структура("ok, code, error", Не ЗначениеЗаполнено(Код), Код, ТекстОшибки);

КонецФункции

// Разбирает JSON компоненты. Объекты - в структуры, как их ждут обработчики инструментов; объект
// с ключом, который не может быть именем свойства структуры, остается соответствием.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Структура, Массив, Строка, Число, Булево, Неопределено - Неопределено, если текст пуст или не JSON.
Функция ИзJSON(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = ИИО_ОтветКлиентСервер.ИзJSON(Текст);
	Исключение
		// Компонента всегда отдает JSON: сбой разбора - ошибка версии компоненты, вызывающий получает
		// Неопределено и завершает работу штатно, а причина остается в журнале. Текст не пишется: в нем ПДн.
		Данные = Неопределено;
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуТранспорта(СтрШаблон("Ответ компоненты не JSON (%1 символов): %2",
			Формат(СтрДлина(Текст), "ЧГ=0"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат ВСтруктуры(Данные);

КонецФункции

Функция ВСтруктуры(Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ВСтруктуры(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	ВсеКлючиИмена = Истина;
	Для Каждого Элемент Из Значение Цикл
		Если Не ЭтоИмяСвойства(Элемент.Ключ) Тогда
			ВсеКлючиИмена = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Результат = ?(ВсеКлючиИмена, Новый Структура, Новый Соответствие);
	Для Каждого Элемент Из Значение Цикл
		Результат.Вставить(Элемент.Ключ, ВСтруктуры(Элемент.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет, может ли строка быть именем свойства структуры: буква или «_», затем буквы, цифры, «_».
//
// Параметры:
//  Ключ - Строка
//
// Возвращаемое значение:
//  Булево
Функция ЭтоИмяСвойства(Ключ)

	Если ТипЗнч(Ключ) <> Тип("Строка") Или ПустаяСтрока(Ключ) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Ключ) Цикл
		Символ = Сред(Ключ, Номер, 1);
		// У буквы верхний и нижний регистр различаются, у цифр и знаков - нет.
		ЭтоБуква = ВРег(Символ) <> НРег(Символ);
		ЭтоЦифра = СтрНайти("0123456789", Символ) > 0;
		Если Не (ЭтоБуква Или Символ = "_" Или Номер > 1 И ЭтоЦифра) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
