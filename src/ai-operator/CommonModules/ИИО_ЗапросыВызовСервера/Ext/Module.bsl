// Серверная часть инструмента run_query: проверка аргументов и запуск фонового задания.

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет аргументы и запускает запрос в фоновом задании.
//
// Параметры:
//  Аргументы - Структура, Соответствие - text, params, limit, timeout_sec.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели (см. ИИО_ОтветКлиентСервер.Ошибка) или см. ИИО_ФоновыеЗадания.Запустить
Функция НачатьВыполнение(Знач Аргументы) Экспорт

	Текст = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "text", "");
	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не задан текст запроса text.'"));
	КонецЕсли;
	МаксимумСтрок = ИИО_Настройки.Значение("ИИО_ЛимитСтрок");
	Лимит = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit"),
		Мин(ЛимитПоУмолчанию(), МаксимумСтрок), МаксимумСтрок);
	МаксимальныйТаймаут = ИИО_Настройки.Значение("ИИО_ТаймаутЗапросаСек");
	Таймаут = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "timeout_sec"),
		МаксимальныйТаймаут, МаксимальныйТаймаут);

	Подготовленный = ИИО_Запросы.ПодготовитьЗапрос(Текст, ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "params"), Лимит);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		Возврат Подготовленный;
	КонецЕсли;

	Возврат ИИО_ФоновыеЗадания.Запустить("ИИО_Запросы.ВыполнитьЗапрос", Подготовленный,
		НСтр("ru = 'ИИ-оператор: запрос'"), Таймаут, "query");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛимитПоУмолчанию()

	Возврат 50;

КонецФункции

#КонецОбласти
