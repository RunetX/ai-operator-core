// Инструменты show_in_1c, open_object и print_documents: показ объектов пользователю в его сеансе 1С.
// Модель получает только сведения о том, что открыто; пользователь видит реальные данные в штатных формах.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента show_in_1c. Объекты одного вида открываются в штатной форме списка с отбором
// «Ссылка в списке», разных видов - в общей форме ИИО_СписокОбъектов.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы (refs, title) и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - opened, form, count, kinds, not_found или ошибка.
Функция ПоказатьВ1С(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Показ = ИИО_ПоказВызовСервера.ПодготовитьПоказ(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Показ) Тогда
		Возврат Показ;
	КонецЕсли;

	Форма = ОткрытьСписок(Показ);
	ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор открыл список'"), ,
		СтрШаблон(НСтр("ru = 'Объектов: %1'"), Формат(Показ.Ссылки.Количество(), "ЧГ=0")));

	Ответ = Новый Структура;
	Ответ.Вставить("opened", Форма <> Неопределено);
	Ответ.Вставить("form", Показ.ИмяФормы);
	Ответ.Вставить("count", Показ.Ссылки.Количество());
	Ответ.Вставить("kinds", Показ.Виды);
	Если Показ.НеНайдено > 0 Тогда
		Ответ.Вставить("not_found", Показ.НеНайдено);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Обработчик инструмента open_object: открывает форму объекта, структуру подчиненности или движения документа.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы (ref, view) и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - opened, object и view или ошибка.
Функция ОткрытьОбъект(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Открытие = ИИО_ПоказВызовСервера.ПодготовитьОткрытие(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Открытие) Тогда
		Возврат Открытие;
	КонецЕсли;
	// Формы открываются так, чтобы close_forms мог их закрыть. Форма объекта уникальна по ключу, остальные -
	// по объекту, как у штатных команд. Если форму объекта открыть нельзя - штатный показ значения.
	Форма = Неопределено;
	Если Открытие.Вид = "form" Тогда
		Попытка
			Форма = ОткрытьФорму(Открытие.ИмяФормы, Открытие.ПараметрыФормы);
		Исключение
			ПоказатьЗначение(, Открытие.Ссылка);
		КонецПопытки;
	Иначе
		Форма = ОткрытьФорму(Открытие.ИмяФормы, Открытие.ПараметрыФормы, , Открытие.Ссылка);
	КонецЕсли;
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	Возврат Новый Структура("opened, object, view", Форма <> Неопределено Или Открытие.Вид = "form",
		Открытие.Объект, Открытие.Вид);

КонецФункции

// Обработчик инструмента print_documents. Без form - печатные формы вида. С form - штатный список с отбором
// по документам и команда из его меню «Печать» тем же путем, что и кнопка меню: обработчики печати
// конфигурации получают настоящую форму списка, вопросы вроде «Провести и продолжить?» задает штатный диалог.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы (refs, form) и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - hint, kind, count, forms (без form) или opened, form, print_form, count;
//    not_found - если есть; или ошибка.
Функция Напечатать(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Печать = ИИО_ПечатьВызовСервера.ПодготовитьПечать(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Печать) Тогда
		Возврат Печать;
	ИначеЕсли Печать.Ответ <> Неопределено Тогда
		Возврат Печать.Ответ;
	КонецЕсли;

	Форма = ОткрытьСписок(Печать.Показ);
	Команда = Неопределено;
	Если Форма <> Неопределено Тогда
		// Реквизит читается через структуру: в форме списка может не быть подключаемых команд БСП.
		АдресТаблицыКоманд = Неопределено;
		Реквизиты = Новый Структура("ПараметрыПодключаемыхКоманд");
		ЗаполнитьЗначенияСвойств(Реквизиты, Форма);
		Если Реквизиты.ПараметрыПодключаемыхКоманд <> Неопределено Тогда
			ПараметрыКоманд = Новый Структура("АдресТаблицыКоманд");
			ЗаполнитьЗначенияСвойств(ПараметрыКоманд, Реквизиты.ПараметрыПодключаемыхКоманд);
			АдресТаблицыКоманд = ПараметрыКоманд.АдресТаблицыКоманд;
		КонецЕсли;
		ИмяКоманды = ИИО_ПечатьВызовСервера.ИмяКомандыВФорме(АдресТаблицыКоманд, Печать.ПечатнаяФорма.id);
		Команда = ?(ПустаяСтрока(ИмяКоманды), Неопределено, Форма.Команды.Найти(ИмяКоманды));
	КонецЕсли;
	Если Команда = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'В меню «Печать» списка нет формы «%1».'"), Печать.ПечатнаяФорма.name),
			НСтр("ru = 'Список документов открыт: скажи пользователю, что форму можно выбрать в меню «Печать» самому.'"));
	КонецЕсли;
	// Команда выполняется из обработчика ожидания, как после нажатия кнопки: внутри обработки запроса MCP
	// обработчики, которые сразу открывают свою форму (комплект и конверт в БП), ее не открывают.
	ПараметрыПриложения.Вставить(ИмяОтложеннойПечати(), Новый Структура("Форма, Команда, Ссылки",
		Форма, Команда, Печать.Показ.Ссылки));
	ПодключитьОбработчикОжидания("ИИО_ВыполнитьОтложеннуюПечать", 0.1, Истина);
	ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор открыл печать'"), ,
		СтрШаблон(НСтр("ru = '%1, документов: %2'"), Печать.ПечатнаяФорма.name,
			Формат(Печать.Показ.Ссылки.Количество(), "ЧГ=0")));

	Ответ = Новый Структура;
	Ответ.Вставить("opened", Истина);
	Ответ.Вставить("form", Печать.Показ.ИмяФормы);
	Ответ.Вставить("print_form", Печать.ПечатнаяФорма);
	Ответ.Вставить("count", Печать.Показ.Ссылки.Количество());
	Если Печать.Показ.НеНайдено > 0 Тогда
		Ответ.Вставить("not_found", Печать.Показ.НеНайдено);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Выполняет команду печати, отложенную print_documents: из обработчика ожидания ИИО_ВыполнитьОтложеннуюПечать.
Процедура ВыполнитьОтложеннуюПечать() Экспорт

	Печать = ПараметрыПриложения.Получить(ИмяОтложеннойПечати());
	ПараметрыПриложения.Удалить(ИмяОтложеннойПечати());
	Если Печать = Неопределено Или Не Печать.Форма.Открыта() Тогда
		Возврат;
	КонецЕсли;
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(Печать.Форма, Печать.Команда, Печать.Ссылки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяОтложеннойПечати()

	Возврат "ИИО.ОтложеннаяПечать";

КонецФункции

// Открывает объекты списком: одного вида - в штатной форме списка с отбором «Ссылка в списке»,
// разных видов - в общей форме ИИО_СписокОбъектов.
//
// Параметры:
//  Показ - Структура - См. ИИО_ПоказВызовСервера.ПодготовитьПоказ.
//
// Возвращаемое значение:
//  ФормаКлиентскогоПриложения, Неопределено
Функция ОткрытьСписок(Показ)

	Если Показ.Виды.Количество() = 1 Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Ссылка", Показ.Ссылки));
		// БП в начале сеанса открывает список через промежуточную форму ожидания и только потом сам список:
		// заголовок и вид достались бы промежуточной форме, а close_forms не нашел бы список.
		// Параметр БП отключает ожидание; другие конфигурации его не знают, платформа его пропускает.
		ПараметрыФормы.Вставить("ОтключитьОжиданиеПриОткрытииФорм", Истина);
	Иначе
		ПараметрыФормы = Новый Структура("Ссылки, Заголовок", Показ.Ссылки, Показ.Заголовок);
	КонецЕсли;
	// Уникальность: иначе уже открытый список активируется без нового отбора.
	Форма = ОткрытьФорму(Показ.ИмяФормы, ПараметрыФормы, , Новый УникальныйИдентификатор);
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	Если Форма <> Неопределено И ЗначениеЗаполнено(Показ.Заголовок) Тогда
		Форма.АвтоЗаголовок = Ложь;
		Форма.Заголовок = Показ.Заголовок;
	КонецЕсли;
	ПоказатьБезИерархии(Форма);
	Возврат Форма;

КонецФункции

// Иерархический справочник открывается деревом: с отбором по ссылкам пользователь увидел бы группы,
// а найденные элементы - только раскрыв их. Таблица «Список» штатной формы переключается в плоский список.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено - открытая форма списка.
Процедура ПоказатьБезИерархии(Форма)

	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Форма.Элементы.Найти("Список");
	Если ТипЗнч(Таблица) = Тип("ТаблицаФормы") И Таблица.Отображение <> ОтображениеТаблицы.Список Тогда
		Таблица.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
