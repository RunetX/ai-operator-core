// Серверная часть инструментов list_reports и run_report.

#Область СлужебныйПрограммныйИнтерфейс

// Варианты отчетов по словам или сведения об одном отчете, см. ИИО_Отчеты.НайтиОтчеты.
//
// Параметры:
//  Аргументы - Структура, Соответствие - text, report, limit.
//
// Возвращаемое значение:
//  Структура
Функция НайтиОтчеты(Знач Аргументы) Экспорт

	Возврат ИИО_Отчеты.НайтиОтчеты(Аргументы);

КонецФункции

// Проверяет аргументы run_report и запускает формирование отчета в фоновом задании.
//
// Параметры:
//  Аргументы - Структура, Соответствие - report, variant, period, filters, group_by, rows, show, timeout_sec.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или см. ИИО_ФоновыеЗадания.Запустить, дополненная полем
//   * Открытие - см. ИИО_Отчеты.ПараметрыОткрытияФормы, Неопределено - Если отчет не нужно показывать.
Функция НачатьФормирование(Знач Аргументы) Экспорт

	Запуск = ИИО_Отчеты.НачатьФормирование(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Запуск) Тогда
		Возврат Запуск;
	КонецЕсли;
	Показать = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "show", Истина) <> Ложь;
	Запуск.Вставить("Открытие", ?(Показать, ИИО_Отчеты.ПараметрыОткрытияФормы(Запуск.Подготовленный), Неопределено));
	Запуск.Удалить("Подготовленный");
	Возврат Запуск;

КонецФункции

// Проверяет аргументы run_report и возвращает параметры открытия формы отчета без формирования данных
// для модели: кнопка «Открыть отчет» в канале бота, данные модель уже получила на сервере.
//
// Параметры:
//  Аргументы - Структура, Соответствие - report, variant, period, filters, group_by.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или см. ИИО_Отчеты.ПараметрыОткрытияФормы
Функция ПараметрыОткрытия(Знач Аргументы) Экспорт

	Подготовленный = ИИО_Отчеты.ПодготовитьФормирование(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		Возврат Подготовленный;
	КонецЕсли;
	Возврат ИИО_Отчеты.ПараметрыОткрытияФормы(Подготовленный);

КонецФункции

#КонецОбласти
