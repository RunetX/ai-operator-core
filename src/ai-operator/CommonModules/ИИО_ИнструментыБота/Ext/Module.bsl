// Серверные обработчики встроенных инструментов канала бота. Работа та же, что в канале MCP,
// но без клиента: запрос ждется синхронно, а вместо открытия форм и предпросмотра добавляются кнопки.

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет инструмент канала бота.
//
// Параметры:
//  ИмяИнструмента - Строка - Инструмент с признаком ВБоте, см. ИИО_ИнструментыКлиентСервер.Определения.
//  Аргументы - Структура, Соответствие - Аргументы без токенов.
//  Вызов - Структура:
//   * Инструмент - Строка
//   * Аргументы - Структура, Соответствие - Аргументы как от модели, с токенами.
//   * Источник - Строка
//   * Начало - Число - Момент начала вызова, мс.
//   * Контекст - см. ИИО_РеестрИнструментов.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура, Соответствие - Ответ для модели до маскирования.
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы, Вызов) Экспорт

	Если ИмяИнструмента = "describe_metadata" Тогда
		Возврат ИИО_Метаданные.Описать(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_ref" Тогда
		Возврат ИИО_Поиск.НайтиСсылки(Аргументы);
	ИначеЕсли ИмяИнструмента = "related_objects" Тогда
		Возврат ИИО_Связи.СвязанныеОбъекты(Аргументы);
	ИначеЕсли ИмяИнструмента = "run_query" Тогда
		Возврат ВыполнитьЗапрос(Аргументы, Вызов);
	ИначеЕсли ИмяИнструмента = "open_object" Тогда
		Возврат ОткрытьОбъект(Аргументы, Вызов);
	ИначеЕсли ИмяИнструмента = "show_in_1c" Тогда
		Возврат ПоказатьВ1С(Аргументы, Вызов);
	ИначеЕсли ИмяИнструмента = "perform" Тогда
		Возврат ВыполнитьДействие(Аргументы, Вызов);
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
		СтрШаблон(НСтр("ru = 'Инструмент %1 не найден.'"), ИмяИнструмента));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// run_query: тот же запуск, что в канале MCP, и синхронное ожидание с таймаутом и сроком хода.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы инструмента без токенов.
//  Вызов - см. ВыполнитьИнструмент
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ВыполнитьЗапрос(Аргументы, Вызов)

	Запуск = ИИО_ЗапросыВызовСервера.НачатьВыполнение(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Запуск) Тогда
		Возврат Запуск;
	КонецЕсли;
	Настройка = Новый Структура("КодТаймаута, ТекстТаймаута, ПодсказкаТаймаута", "QUERY_TIMEOUT",
		НСтр("ru = 'Запрос не выполнился за %1 с и отменен.'"),
		НСтр("ru = 'Сузь отбор (период, организация, контрагент) или воспользуйся отчетом. База освобождается после отмены до минуты, поэтому сразу не повторяй.'"));
	Возврат ИИО_ФоновыеЗадания.Дождаться(Запуск, Вызов.Начало, Настройка, Вызов.Контекст.СрокМс);

КонецФункции

// open_object: проверки и выбор формы - как в канале MCP, но форма не открывается, а предлагается кнопкой.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы инструмента без токенов.
//  Вызов - см. ВыполнитьИнструмент
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ОткрытьОбъект(Аргументы, Вызов)

	Открытие = ИИО_ПоказВызовСервера.ПодготовитьОткрытие(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Открытие) Тогда
		Возврат Открытие;
	КонецЕсли;
	Заголовки = Новый Структура("form, related, movements", НСтр("ru = 'Открыть'"),
		НСтр("ru = 'Связанные документы'"), НСтр("ru = 'Движения'"));
	Вызов.Контекст.Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка("open", Заголовки[Открытие.Вид], "open_object",
		Новый Структура("ref, view", ИИО_Ответ.СсылкаВСтроку(Открытие.Ссылка), Открытие.Вид)));
	Возврат Новый Структура("button, object, view", Истина, Открытие.Объект, Открытие.Вид);

КонецФункции

// show_in_1c: список предлагается кнопкой. В кнопку уходит не больше МаксимумСсылокКнопки() ссылок:
// ее данные хранит сервис взаимодействия.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы инструмента без токенов.
//  Вызов - см. ВыполнитьИнструмент
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ПоказатьВ1С(Аргументы, Вызов)

	Показ = ИИО_ПоказВызовСервера.ПодготовитьПоказ(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Показ) Тогда
		Возврат Показ;
	КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого Ссылка Из Показ.Ссылки Цикл
		Если Ссылки.Количество() = МаксимумСсылокКнопки() Тогда
			Прервать;
		КонецЕсли;
		Ссылки.Добавить(ИИО_Ответ.СсылкаВСтроку(Ссылка));
	КонецЦикла;
	Вызов.Контекст.Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка("show", НСтр("ru = 'Показать список'"),
		"show_in_1c", Новый Структура("refs, title", Ссылки, Показ.Заголовок)));

	Ответ = Новый Структура;
	Ответ.Вставить("button", Истина);
	Ответ.Вставить("count", Показ.Ссылки.Количество());
	Ответ.Вставить("kinds", Показ.Виды);
	Если Ссылки.Количество() < Показ.Ссылки.Количество() Тогда
		Ответ.Вставить("button_count", Ссылки.Количество());
	КонецЕсли;
	Если Показ.НеНайдено > 0 Тогда
		Ответ.Вставить("not_found", Показ.НеНайдено);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// perform: в канале бота только пробный запуск, что бы ни передала модель. Если есть что менять -
// кнопка «Предпросмотр»: план строится заново в клиенте нажавшего, «Выполнить» нажимает человек.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы инструмента без токенов.
//  Вызов - см. ВыполнитьИнструмент
//
// Возвращаемое значение:
//  Структура - Ответ для модели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ВыполнитьДействие(Аргументы, Вызов)

	Пробные = Новый Структура;
	Пробные.Вставить("action", ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "action", ""));
	Пробные.Вставить("refs", ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "refs"));
	Пробные.Вставить("dry_run", Истина);
	Подготовленный = ИИО_Действия.ПодготовитьДействие(Пробные, Вызов.Источник);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		Возврат Подготовленный;
	КонецЕсли;

	Ответ = Подготовленный.Ответ;
	Ссылки = Новый Массив;
	Для Каждого Элемент Из Ответ.objects Цикл
		Ссылки.Добавить(Элемент.object.ref);
	КонецЦикла;
	Если Ответ.summary.will_change > 0 Тогда
		Вызов.Контекст.Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка("preview", НСтр("ru = 'Предпросмотр'"),
			"perform", Новый Структура("action, refs, dry_run", Пробные.action, Ссылки, Ложь)));
		Ответ.Вставить("button", Истина);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Сколько ссылок уходит в данные кнопки «Показать список».
//
// Возвращаемое значение:
//  Число
Функция МаксимумСсылокКнопки()

	Возврат 100;

КонецФункции

#КонецОбласти
