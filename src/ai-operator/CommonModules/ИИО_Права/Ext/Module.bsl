// Права на действия ИИ-оператора: разрешения администратора в регистре ИИО_РазрешенияДействий
// и права платформы на объекты. Функции принимают пользователя параметром, чтобы их можно было проверить тестами.

#Область СлужебныйПрограммныйИнтерфейс

// Разрешено ли действие пользователю в регистре ИИО_РазрешенияДействий. Запись на пользователя важнее записей
// на его группы; среди групп достаточно одной с разрешением. Нет записей - действие запрещено.
//
// Параметры:
//  Действие - Строка - Код действия: post, unpost или действие пакета (см. РазрешаемыеДействия).
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - По умолчанию текущий пользователь.
//
// Возвращаемое значение:
//  Булево
Функция ДействиеРазрешено(Действие, Пользователь = Неопределено) Экспорт

	Действия = Новый Массив;
	Действия.Добавить(Действие);
	Возврат РазрешенныеДействия(Действия, Пользователь).Количество() > 0;

КонецФункции

// Какие из действий разрешены пользователю: правило то же, что у ДействиеРазрешено, но одним запросом
// на все действия.
//
// Параметры:
//  Действия - Массив из Строка - Коды действий.
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - По умолчанию текущий пользователь.
//
// Возвращаемое значение:
//  Массив из Строка - Коды разрешенных действий.
Функция РазрешенныеДействия(Действия, Пользователь = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;

	// Настройки читаются в привилегированном режиме: у пользователя нет прав на регистр разрешений
	// и составы групп пользователей.
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Пользователь КАК Пользователь
	|ПОМЕСТИТЬ ВТПользовательИГруппы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставыГрупп.ГруппаПользователей
	|ИЗ
	|	РегистрСведений.СоставыГруппПользователей КАК СоставыГрупп
	|ГДЕ
	|	СоставыГрупп.Пользователь = &Пользователь
	|	И СоставыГрупп.Используется
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Разрешения.Действие КАК Действие,
	|	Разрешения.Разрешено КАК Разрешено,
	|	ВЫБОР
	|		КОГДА Разрешения.Пользователь = &Пользователь
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	РегистрСведений.ИИО_РазрешенияДействий КАК Разрешения
	|ГДЕ
	|	Разрешения.Пользователь В
	|			(ВЫБРАТЬ
	|				ПользовательИГруппы.Пользователь
	|			ИЗ
	|				ВТПользовательИГруппы КАК ПользовательИГруппы)
	|	И Разрешения.Действие В (&Действия)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Действие,
	|	Порядок,
	|	Разрешено УБЫВ";
	Запрос.УстановитьПараметр("Действия", Действия);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	// Решает первая запись каждого действия: запись на пользователя, иначе разрешающая запись группы.
	Разрешенные = Новый Массив;
	ПредыдущееДействие = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Действие = ПредыдущееДействие Тогда
			Продолжить;
		КонецЕсли;
		ПредыдущееДействие = Выборка.Действие;
		Если Выборка.Разрешено Тогда
			Разрешенные.Добавить(Выборка.Действие);
		КонецЕсли;
	КонецЦикла;
	Возврат Разрешенные;

КонецФункции

// Ошибка для модели, если пользователь не может выполнить действие над объектами этих видов:
// нет разрешения администратора ИИ-оператора или права платформы.
//
// Параметры:
//  Описание - см. ИИО_Действия.НовоеДействие
//  ОбъектыМетаданных - Массив из ОбъектМетаданных
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - По умолчанию текущий пользователь.
//  ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - Для проверки прав платформы,
//    по умолчанию текущий пользователь.
//
// Возвращаемое значение:
//  Структура - Ошибка ACTION_DENIED.
//  Неопределено - Действие доступно.
Функция ОшибкаДоступаКДействию(Описание, ОбъектыМетаданных, Пользователь = Неопределено,
	ПользовательИБ = Неопределено) Экспорт

	Если Не ДействиеРазрешено(Описание.Код, Пользователь) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			СтрШаблон(НСтр("ru = 'Действие «%1» (%2) не разрешено этому пользователю в настройках ИИ-оператора.'"),
				Описание.Представление, Описание.Код),
			НСтр("ru = 'Скажи пользователю, что разрешение выдает администратор 1С: раздел «ИИ-оператор» → «Разрешения действий ИИ-оператора». Не пытайся выполнить изменение другим способом.'"));
	КонецЕсли;

	Для Каждого ОбъектМетаданных Из ОбъектыМетаданных Цикл
		Если ПользовательИБ = Неопределено Тогда
			ЕстьПраво = ПравоДоступа(Описание.Право, ОбъектМетаданных);
		Иначе
			ЕстьПраво = ПравоДоступа(Описание.Право, ОбъектМетаданных, ПользовательИБ);
		КонецЕсли;
		Если Не ЕстьПраво Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
				СтрШаблон(НСтр("ru = 'У пользователя нет права «%1» для «%2».'"),
					Описание.ПредставлениеПрава, ОбъектМетаданных.Представление()),
				НСтр("ru = 'Скажи пользователю, что права выдает администратор 1С в профиле группы доступа. Не пытайся выполнить изменение другим способом.'"));
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Действия, которые администратор ИИ-оператора может разрешить в регистре ИИО_РазрешенияДействий: действия ядра
// (ИИО_Действия) и действия пакетов (ПриРегистрацииРазрешений, см. ИИО_Пакеты). Код пакета, совпавший с уже
// зарегистрированным, пропускается: пакет не может подменить действие ядра. Сбой пакета пишется в журнал регистрации.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Код действия.
//   * Значение - Строка - Представление для администратора.
Функция РазрешаемыеДействия() Экспорт

	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из ИИО_Действия.Действия() Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение.Представление);
	КонецЦикла;
	Для Каждого ИмяМодуля Из ИИО_Пакеты.СерверныеМодули() Цикл
		Разрешения = Новый Соответствие;
		Попытка
			ОбщегоНазначения.ОбщийМодуль(ИмяМодуля).ПриРегистрацииРазрешений(Разрешения);
		Исключение
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Продолжить;
		КонецПопытки;
		Для Каждого КлючИЗначение Из Разрешения Цикл
			Если Результат.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
				ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
					СтрШаблон(НСтр("ru = 'Действие %1 уже зарегистрировано ядром или другим пакетом.'"),
						КлючИЗначение.Ключ));
				Продолжить;
			КонецЕсли;
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Может ли пользователь информационной базы работать с ИИ-оператором: правило то же, что у
// ИИО_ПраваВызовСервера.ДоступенИИОператор, но для любого пользователя. Личный бот канала есть
// только у тех, кому доступен ИИ-оператор. Права другого пользователя проверяются в привилегированном режиме.
//
// Параметры:
//  ПользовательИБ - ПользовательИнформационнойБазы
//
// Возвращаемое значение:
//  Булево
Функция ДоступенИИОператорПользователю(ПользовательИБ) Экспорт

	Возврат ПравоДоступа("Просмотр", Метаданные.ОбщиеКоманды.ИИО_ЗапуститьИИОператор, ПользовательИБ)
		Или Пользователи.ЭтоПолноправныйПользователь(ПользовательИБ);

КонецФункции

// Администратор ИИ-оператора видит пакеты всех пользователей и откатывает любые пакеты. Признак - право
// изменять разрешения действий: его дают роли администратора ИИ-оператора и ИИО_ПолныеПрава.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоАдминистраторИИОператора() Экспорт

	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ИИО_РазрешенияДействий)
		Или Пользователи.ЭтоПолноправныйПользователь();

КонецФункции

// Поставляемые профили групп доступа ИИ-оператора, см. УправлениеДоступомПереопределяемый.
// Видов доступа у профилей нет: тогда БСП умеет включать пользователя в основную группу профиля.
//
// Параметры:
//  ОписанияПрофилей - Массив из см. УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа
Процедура ПриЗаполненииПоставляемыхПрофилейГруппДоступа(ОписанияПрофилей) Экспорт

	Профиль = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	Профиль.Имя = "ИИО_ИИОператор";
	Профиль.Идентификатор = ИдентификаторПрофиляИИОператор();
	Профиль.Наименование = НСтр("ru = 'ИИ-оператор'");
	Профиль.Описание = НСтр("ru = 'Работа с ИИ-оператором: MCP-клиент на компьютере пользователя и бот в обсуждениях. Добавляется к основному профилю пользователя.'");
	Профиль.Роли.Добавить("ИИО_ПользовательИИОператора");
	ОписанияПрофилей.Добавить(Профиль);

	Профиль = УправлениеДоступом.НовоеОписаниеПрофиляГруппДоступа();
	Профиль.Имя = "ИИО_АдминистраторИИОператора";
	Профиль.Идентификатор = ИдентификаторПрофиляАдминистратор();
	Профиль.Наименование = НСтр("ru = 'ИИ-оператор: администратор'");
	Профиль.Описание = НСтр("ru = 'Настройки ИИ-оператора, разрешения действий, журнал обращений к модели всех пользователей.'");
	Профиль.Роли.Добавить("ИИО_ПользовательИИОператора");
	Профиль.Роли.Добавить("ИИО_АдминистраторИИОператора");
	ОписанияПрофилей.Добавить(Профиль);

КонецПроцедуры

// Идентификатор поставляемого профиля «ИИ-оператор».
//
// Возвращаемое значение:
//  Строка
Функция ИдентификаторПрофиляИИОператор() Экспорт

	Возврат "d7140ead-3afc-4f7c-a8c0-4880a3b5f51b";

КонецФункции

// Идентификатор поставляемого профиля «ИИ-оператор: администратор».
//
// Возвращаемое значение:
//  Строка
Функция ИдентификаторПрофиляАдминистратор() Экспорт

	Возврат "ed003d0d-19e2-4dc2-a9a7-2f92cc82895e";

КонецФункции

// Включает пользователя в группу доступа поставляемого профиля «ИИ-оператор» (установщик, Р-3). Профиль
// берется из описаний сеанса, поэтому вызывается после перезапуска, когда расширение ядра подключено.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * error - Строка
Функция ДобавитьВГруппуИИОператор(Пользователь) Экспорт

	Результат = Новый Структура("ok, error", Ложь, "");
	Попытка
		// Служебная процедура БСП: публичная ВключитьПрофильПользователю работает только при упрощенной
		// настройке прав, а в ЗУП и полной УТ она полная.
		УправлениеДоступомСлужебный.ВключитьПользователяВГруппуДоступа(Пользователь, ИдентификаторПрофиляИИОператор());
	Исключение
		Информация = ИнформацияОбОшибке();
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПрав(ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Результат.error = Строка(ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
		Возврат Результат;
	КонецПопытки;
	Результат.ok = ВГруппеИИОператор(Пользователь);
	Если Не Результат.ok Тогда
		Результат.error = НСтр("ru = 'Группа доступа «ИИ-оператор» не найдена: профиль еще не создан.'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Входит ли пользователь в группу доступа с профилем «ИИ-оператор». Для администратора: группы доступа читает он.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Булево
Функция ВГруппеИИОператор(Пользователь) Экспорт

	Профиль = УправлениеДоступом.ПоставляемыйПрофильПоИдентификатору(ИдентификаторПрофиляИИОператор());
	Если Профиль = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ВГруппе
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК Участники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа КАК Группы
	|		ПО Участники.Ссылка = Группы.Ссылка
	|ГДЕ
	|	Группы.Профиль = &Профиль
	|	И НЕ Группы.ПометкаУдаления
	|	И Участники.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Профиль", Профиль);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти
