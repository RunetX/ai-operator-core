// Проверки состояния ИИ-оператора на сервере для формы «Состояние ИИ-оператора» (этап 3д, Р-2).
// Проверка - данные: код, группа, статус, что не так и как исправить, необязательное действие формы.
// Пакеты и бот добавляют свои проверки модулем <Префикс>_СостояниеПакета в подсистеме пакета.
// Тексты проверок не содержат персональных данных и токена: их копируют в отчет для поддержки.

#Область ПрограммныйИнтерфейс

// Добавляет проверку в список. Для модулей <Префикс>_СостояниеПакета пакетов.
//
// Параметры:
//  Проверки - Массив из см. НоваяПроверка
//  Код - Строка - Уникальный код проверки, например kedo.extension.
//  Группа - Строка - Группа, см. Группы.
//  Заголовок - Строка - Что проверяется.
//  Статус - Строка - ok, warning, error или skipped.
//  Текст - Строка - Результат: что найдено.
//  Подсказка - Строка - Как исправить, если статус не ok.
//
// Возвращаемое значение:
//  см. НоваяПроверка - Действие формы задается в возвращенной проверке: start, create_token, test_model,
//    enable_log или <Модуль пакета>.<код>:<представление>.
Функция ДобавитьПроверку(Проверки, Код, Группа, Заголовок, Статус, Текст, Подсказка = "") Экспорт

	Проверка = НоваяПроверка(Код, Группа, Заголовок);
	Проверка.Статус = Статус;
	Проверка.Текст = Текст;
	Проверка.Подсказка = Подсказка;
	Проверки.Добавить(Проверка);
	Возврат Проверка;

КонецФункции

// Описание проверки.
//
// Параметры:
//  Код - Строка
//  Группа - Строка
//  Заголовок - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка
//   * Группа - Строка
//   * Заголовок - Строка
//   * Статус - Строка - ok, warning, error, skipped.
//   * Текст - Строка
//   * Подсказка - Строка
//   * Действие - Строка
Функция НоваяПроверка(Код, Группа, Заголовок) Экспорт

	Возврат Новый Структура("Код, Группа, Заголовок, Статус, Текст, Подсказка, Действие",
		Код, Группа, Заголовок, "skipped", "", "", "");

КонецФункции

// Группы проверок в порядке показа.
//
// Возвращаемое значение:
//  Структура - Ключ - имя группы, значение - представление.
Функция Группы() Экспорт

	Группы = Новый Структура;
	Группы.Вставить("Установка", НСтр("ru = 'Установка'"));
	Группы.Вставить("Права", НСтр("ru = 'Права'"));
	Группы.Вставить("Журнал", НСтр("ru = 'Журнал регистрации'"));
	Группы.Вставить("MCP", НСтр("ru = 'Подключение MCP-клиента'"));
	Группы.Вставить("Модель", НСтр("ru = 'Модель'"));
	Группы.Вставить("Маскирование", НСтр("ru = 'Маскирование персональных данных'"));
	Группы.Вставить("Пакеты", НСтр("ru = 'Пакеты и бот'"));
	Возврат Группы;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Серверные проверки: установка, права, журнал, модель, маскирование, пакеты и бот.
// Клиентские проверки (компонента, токен, сервер в сеансе) - в ИИО_ДиагностикаКлиент.
//
// Возвращаемое значение:
//  Массив из см. НоваяПроверка
Функция Проверки() Экспорт

	Проверки = Новый Массив;
	Администратор = ИИО_Права.ЭтоАдминистраторИИОператора();
	ПроверитьЯдро(Проверки);
	ПроверитьРасширения(Проверки, Администратор);
	ПроверитьПрава(Проверки, Администратор);
	ПроверитьЖурнал(Проверки, Администратор);
	ПроверитьМодели(Проверки);
	ПроверитьМаскирование(Проверки);
	ПроверитьПакеты(Проверки);
	Возврат Проверки;

КонецФункции

// Включает запись уровня «Информация» в журнале регистрации: без нее действия ИИ-оператора отказывают.
// Только для администратора ИИ-оператора.
//
// Возвращаемое значение:
//  Структура - ok и error.
Функция ВключитьЖурнал() Экспорт

	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		Возврат Новый Структура("ok, error", Ложь, НСтр("ru = 'Включить журнал может администратор ИИ-оператора.'"));
	КонецЕсли;
	// Платформа принимает только сплошной набор уровней: от «Ошибки» до самого подробного. Примечания
	// остаются, если уже писались.
	УстановитьПривилегированныйРежим(Истина);
	ИсходныеУровни = ПолучитьИспользованиеЖурналаРегистрации();
	Уровни = Новый Массив;
	Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
	Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);
	Уровни.Добавить(УровеньЖурналаРегистрации.Информация);
	Если ИсходныеУровни.Найти(УровеньЖурналаРегистрации.Примечание) <> Неопределено Тогда
		Уровни.Добавить(УровеньЖурналаРегистрации.Примечание);
	КонецЕсли;
	УстановитьИспользованиеЖурналаРегистрации(Уровни);
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Новый Структура("ok, error", ИИО_Журнал.ЖурналДействийВключен(), "");

КонецФункции

// Короткий запрос к модели агента: доступна ли она и сколько отвечает. Данных базы в запросе нет.
//
// Параметры:
//  Назначение - Строка - агент или маскирование.
//
// Возвращаемое значение:
//  см. НоваяПроверка
Функция ПроверитьМодель(Назначение) Экспорт

	Код = ?(Назначение = "маскирование", "model.masking", "model.agent");
	Проверка = НоваяПроверка(Код, "Модель", ЗаголовокМодели(Назначение));
	Параметры = ИИО_МодельHTTP.ПараметрыМодели(Назначение);
	Если Не Параметры.Настроена Тогда
		Проверка.Статус = "warning";
		Проверка.Текст = НСтр("ru = 'Адрес или имя модели не заданы.'");
		Проверка.Подсказка = НСтр("ru = 'Задайте модель в «Настройках ИИ-оператора».'");
		Возврат Проверка;
	КонецЕсли;
	Параметры.ТаймаутСек = Мин(Параметры.ТаймаутСек, 30);
	Сообщения = Новый Массив;
	Сообщения.Добавить(Новый Структура("role, content", "user", "Ответь одним словом: ok"));
	Ответ = ИИО_МодельHTTP.ЗапросЧата(Параметры, Сообщения, , Новый Структура("max_tokens", 8));
	Если Ответ.Ошибка = Неопределено Тогда
		Проверка.Статус = "ok";
		Проверка.Текст = СтрШаблон(НСтр("ru = '%1 отвечает за %2 мс.'"), Параметры.Модель,
			Формат(Ответ.ДлительностьМс, "ЧН=0; ЧГ=0"));
	Иначе
		Проверка.Статус = "error";
		Проверка.Текст = СтрШаблон(НСтр("ru = '%1: %2'"), Параметры.Модель, Ответ.Ошибка.Текст);
		Проверка.Подсказка = НСтр("ru = 'Проверьте, что сервер модели запущен и адрес в «Настройках ИИ-оператора» верный.'");
	КонецЕсли;
	Проверка.Действие = "test_model";
	Возврат Проверка;

КонецФункции

// Совместим ли пакет с ядром: уровень API пакетов тот же, а ядро не старше минимальной версии пакета.
//
// Параметры:
//  Код - Строка - Код проверки.
//  Сведения - Структура - Расширение, Версия, МинимальнаяВерсияЯдра, ВерсияКонтрактаЯдра.
//  ВерсияЯдра - Строка
//  ВерсияКонтракта - Число - Уровень API пакетов ядра, см. ИИО_Настройки.ВерсияКонтрактаПакетов.
//
// Возвращаемое значение:
//  см. НоваяПроверка
Функция ПроверкаВерсииПакета(Код, Сведения, ВерсияЯдра, ВерсияКонтракта) Экспорт

	Проверка = НоваяПроверка(Код, "Пакеты", Сведения.Расширение);
	Если Сведения.ВерсияКонтрактаЯдра <> ВерсияКонтракта Тогда
		Проверка.Статус = "error";
		Проверка.Текст = СтрШаблон(НСтр("ru = 'Версия %1 написана для API ядра %2, ядро %3 предоставляет API %4.'"),
			Сведения.Версия, Сведения.ВерсияКонтрактаЯдра, ВерсияЯдра, ВерсияКонтракта);
		Проверка.Подсказка = НСтр("ru = 'Установите совместимые версии ядра и пакета установочной обработкой.'");
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияЯдра, Сведения.МинимальнаяВерсияЯдра) < 0 Тогда
		Проверка.Статус = "error";
		Проверка.Текст = СтрШаблон(НСтр("ru = 'Версия %1 требует ядро %2 или новее, установлено %3.'"), Сведения.Версия,
			Сведения.МинимальнаяВерсияЯдра, ВерсияЯдра);
		Проверка.Подсказка = НСтр("ru = 'Обновите расширение «ИИОператор» из релиза ядра.'");
	Иначе
		Проверка.Статус = "ok";
		Проверка.Текст = СтрШаблон(НСтр("ru = 'Версия %1, совместима с ядром %2.'"), Сведения.Версия, ВерсияЯдра);
	КонецЕсли;
	Возврат Проверка;

КонецФункции

// Сведения о пакетах для инструмента ping: имя расширения и версия.
//
// Возвращаемое значение:
//  Массив из Структура - name, version.
Функция ПакетыДляPing() Экспорт

	Результат = Новый Массив;
	Для Каждого ИмяМодуля Из ИИО_Пакеты.СерверныеМодулиСОкончанием("_СостояниеПакета") Цикл
		Сведения = СведенияПакета(ИмяМодуля);
		Если Сведения <> Неопределено Тогда
			Результат.Добавить(Новый Структура("name, version", Сведения.Расширение, Сведения.Версия));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьЯдро(Проверки)

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ДобавитьПроверку(Проверки, "core.version", "Установка", НСтр("ru = 'Ядро ИИ-оператора'"), "ok",
		СтрШаблон(НСтр("ru = 'ИИОператор %1, платформа %2.'"), ИИО_Настройки.ВерсияРасширения(),
			СистемнаяИнформация.ВерсияПриложения));

	Сведения = ИИО_СведенияВызовСервера.Сведения();
	Если Сведения.safe_mode Или Не Сведения.privileged_mode_available Тогда
		ДобавитьПроверку(Проверки, "core.safe_mode", "Установка", НСтр("ru = 'Безопасный режим ядра'"), "error",
			НСтр("ru = 'Расширение «ИИОператор» работает в безопасном режиме: журнал операций и компонента транспорта недоступны.'"),
			ПодсказкаФлагов("ИИОператор"));
	Иначе
		ДобавитьПроверку(Проверки, "core.safe_mode", "Установка", НСтр("ru = 'Безопасный режим ядра'"), "ok",
			НСтр("ru = 'Выключен.'"));
	КонецЕсли;

КонецПроцедуры

// Флаги «Безопасный режим» и «Защита от опасных действий» всех расширений ИИ-оператора. Список расширений
// читается только с административными правами, поэтому проверка - для администратора ИИ-оператора.
//
// Параметры:
//  Проверки - Массив из см. НоваяПроверка
//  Администратор - Булево - Пользователь - администратор ИИ-оператора.
Процедура ПроверитьРасширения(Проверки, Администратор)

	Заголовок = НСтр("ru = 'Флаги расширений ИИ-оператора'");
	Если Не Администратор Тогда
		ДобавитьПроверку(Проверки, "extensions.flags", "Установка", Заголовок, "skipped",
			НСтр("ru = 'Видно администратору ИИ-оператора.'"));
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Расширения = РасширенияКонфигурации.Получить();
	УстановитьПривилегированныйРежим(Ложь);
	Проблемы = Новый Массив;
	Найдено = Новый Массив;
	Для Каждого Расширение Из Расширения Цикл
		Если Не СтрНачинаетсяС(Расширение.Имя, "ИИОператор") Или СтрЗаканчиваетсяНа(Расширение.Имя, "_Тесты") Тогда
			Продолжить;
		КонецЕсли;
		Найдено.Добавить(СтрШаблон("%1 %2", Расширение.Имя, Расширение.Версия));
		ЗащитаВключена = Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
		Если Расширение.БезопасныйРежим <> Ложь Или ЗащитаВключена Тогда
			Проблемы.Добавить(Расширение.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Проблемы.Количество() > 0 Тогда
		ДобавитьПроверку(Проверки, "extensions.flags", "Установка", Заголовок, "error",
			СтрШаблон(НСтр("ru = 'Безопасный режим или защита от опасных действий включены: %1.'"),
				СтрСоединить(Проблемы, ", ")),
			ПодсказкаФлагов(СтрСоединить(Проблемы, ", ")));
	Иначе
		ДобавитьПроверку(Проверки, "extensions.flags", "Установка", Заголовок, "ok",
			СтрШаблон(НСтр("ru = 'Флаги сняты: %1.'"), СтрСоединить(Найдено, ", ")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПрава(Проверки, Администратор)

	Если ИИО_ПраваВызовСервера.ДоступенИИОператор() Тогда
		ДобавитьПроверку(Проверки, "rights.role", "Права", НСтр("ru = 'Доступ к ИИ-оператору'"), "ok",
			?(Администратор, НСтр("ru = 'Есть, с правами администратора ИИ-оператора.'"), НСтр("ru = 'Есть.'")));
	Иначе
		ДобавитьПроверку(Проверки, "rights.role", "Права", НСтр("ru = 'Доступ к ИИ-оператору'"), "error",
			НСтр("ru = 'У пользователя нет роли «Пользователь ИИ-оператора».'"),
			НСтр("ru = 'Попросите администратора добавить роль в профиль вашей группы доступа.'"));
		Возврат;
	КонецЕсли;

	Действия = ИИО_Права.РазрешаемыеДействия();
	Коды = Новый Массив;
	Для Каждого КлючИЗначение Из Действия Цикл
		Коды.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Разрешено = Новый Массив;
	Для Каждого Код Из ИИО_Права.РазрешенныеДействия(Коды) Цикл
		Разрешено.Добавить(Действия.Получить(Код));
	КонецЦикла;
	Заголовок = НСтр("ru = 'Разрешенные действия'");
	Если Разрешено.Количество() = 0 Тогда
		ДобавитьПроверку(Проверки, "rights.actions", "Права", Заголовок, "warning",
			НСтр("ru = 'Ни одно действие не разрешено: ИИ-оператор только читает данные.'"),
			НСтр("ru = 'Чтобы проводить документы через ИИ-оператор, администратор разрешает действия в «Разрешениях действий ИИ-оператора».'"));
	Иначе
		ДобавитьПроверку(Проверки, "rights.actions", "Права", Заголовок, "ok",
			СтрШаблон(НСтр("ru = 'Разрешено %1 из %2: %3.'"), Разрешено.Количество(), Действия.Количество(),
				СтрСоединить(Разрешено, ", ")));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЖурнал(Проверки, Администратор)

	Заголовок = НСтр("ru = 'Уровень «Информация»'");
	Если ИИО_Журнал.ЖурналДействийВключен() Тогда
		ДобавитьПроверку(Проверки, "eventlog.info", "Журнал", Заголовок, "ok", НСтр("ru = 'Пишется.'"));
	Иначе
		Проверка = ДобавитьПроверку(Проверки, "eventlog.info", "Журнал", Заголовок, "error",
			НСтр("ru = 'Журнал регистрации не пишет события уровня «Информация»: действия ИИ-оператора недоступны.'"),
			?(Администратор, НСтр("ru = 'Нажмите «Включить».'"),
				НСтр("ru = 'Попросите администратора включить уровень «Информация» в настройках журнала регистрации.'")));
		Проверка.Действие = ?(Администратор, "enable_log", "");
	КонецЕсли;

КонецПроцедуры

// Модели проверяются только на заполненность: запрос к модели - по кнопке, см. ПроверитьМодель.
Процедура ПроверитьМодели(Проверки)

	Для Каждого Назначение Из СтрРазделить("агент,маскирование", ",") Цикл
		Код = ?(Назначение = "маскирование", "model.masking", "model.agent");
		Параметры = ИИО_МодельHTTP.ПараметрыМодели(Назначение);
		Если Параметры.Настроена Тогда
			Проверка = ДобавитьПроверку(Проверки, Код, "Модель", ЗаголовокМодели(Назначение), "ok",
				СтрШаблон(НСтр("ru = '%1, %2. Проверить связь - кнопкой.'"), Параметры.Модель, Параметры.Адрес));
			Проверка.Действие = "test_model";
		ИначеЕсли Назначение = "маскирование" Тогда
			ДобавитьПроверку(Проверки, Код, "Модель", ЗаголовокМодели(Назначение), "warning",
				НСтр("ru = 'Не задана: людей не из базы ищут только правила.'"),
				НСтр("ru = 'Задайте локальную модель маскирования в «Настройках ИИ-оператора».'"));
		Иначе
			ДобавитьПроверку(Проверки, Код, "Модель", ЗаголовокМодели(Назначение), "skipped",
				НСтр("ru = 'Не задана. Нужна только боту в обсуждениях, MCP-клиент приходит со своей моделью.'"));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьМаскирование(Проверки)

	Строгий = ИИО_Настройки.Значение("ИИО_СтрогийРежимМаскирования") = Истина;
	ДобавитьПроверку(Проверки, "masking.strict", "Маскирование", НСтр("ru = 'Строгий режим'"), "ok",
		?(Строгий, НСтр("ru = 'Включен: скрыты и данные контрагентов-юрлиц.'"),
			НСтр("ru = 'Выключен: скрыты люди, ИНН физлиц, СНИЛС, паспорта, телефоны и почта.'")));
	Заголовок = НСтр("ru = 'Полнотекстовый поиск'");
	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда
		ДобавитьПроверку(Проверки, "masking.fulltext", "Маскирование", Заголовок, "ok",
			НСтр("ru = 'Включен: людей из базы находит полнотекстовый поиск.'"));
	Иначе
		ДобавитьПроверку(Проверки, "masking.fulltext", "Маскирование", Заголовок, "warning",
			НСтр("ru = 'Выключен: люди из базы находятся только по фамилии.'"),
			НСтр("ru = 'Включите полнотекстовый поиск в настройках программы.'"));
	КонецЕсли;

КонецПроцедуры

// Пакеты: версия, совместимость с ядром и собственные проверки модуля <Префикс>_СостояниеПакета.
// Сбой модуля пакета не ломает форму: проверка получает статус error, причина - в журнале регистрации.
//
// Параметры:
//  Проверки - Массив из см. НоваяПроверка
Процедура ПроверитьПакеты(Проверки)

	Модули = ИИО_Пакеты.СерверныеМодулиСОкончанием("_СостояниеПакета");
	Если Модули.Количество() = 0 Тогда
		ДобавитьПроверку(Проверки, "packages", "Пакеты", НСтр("ru = 'Пакеты'"), "skipped",
			НСтр("ru = 'Пакеты не установлены.'"));
		Возврат;
	КонецЕсли;
	ВерсияЯдра = ИИО_Настройки.ВерсияРасширения();
	Для Каждого ИмяМодуля Из Модули Цикл
		Сведения = СведенияПакета(ИмяМодуля);
		Код = "package." + НРег(СтрЗаменить(ИмяМодуля, "_СостояниеПакета", ""));
		Если ЗначениеЗаполнено(Сведения.ТекстОшибки) Тогда
			ДобавитьПроверку(Проверки, Код, "Пакеты", ИмяМодуля, "error",
				СтрШаблон(НСтр("ru = 'Модуль пакета не ответил: %1'"), Сведения.ТекстОшибки),
				НСтр("ru = 'Подробности - в журнале регистрации.'"));
			Продолжить;
		КонецЕсли;
		Проверки.Добавить(ПроверкаВерсииПакета(Код, Сведения, ВерсияЯдра, ИИО_Настройки.ВерсияКонтрактаПакетов()));
		Попытка
			ОбщегоНазначения.ОбщийМодуль(ИмяМодуля).ПриСбореПроверок(Проверки);
		Исключение
			Информация = ИнформацияОбОшибке();
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
			ДобавитьПроверку(Проверки, Код + ".checks", "Пакеты", Сведения.Расширение, "error",
				СтрШаблон(НСтр("ru = 'Проверки пакета завершились ошибкой: %1'"),
					ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация)),
				НСтр("ru = 'Подробности - в журнале регистрации.'"));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Версии пакета из его модуля <Префикс>_СостояниеПакета.
//
// Параметры:
//  ИмяМодуля - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Расширение - Строка
//   * Версия - Строка
//   * МинимальнаяВерсияЯдра - Строка
//   * ВерсияКонтрактаЯдра - Число
//   * ТекстОшибки - Строка - Заполнен, если модуль не ответил; подробности записаны в журнал регистрации.
Функция СведенияПакета(ИмяМодуля)

	Сведения = Новый Структура("Расширение, Версия, МинимальнаяВерсияЯдра, ВерсияКонтрактаЯдра, ТекстОшибки",
		"", "", "", 0, "");
	Модуль = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля);
	Попытка
		Сведения.Расширение = Модуль.ИмяРасширения();
		Сведения.Версия = Модуль.ВерсияПакета();
		Сведения.МинимальнаяВерсияЯдра = Модуль.МинимальнаяВерсияЯдра();
		Сведения.ВерсияКонтрактаЯдра = Модуль.ВерсияКонтрактаЯдра();
	Исключение
		Информация = ИнформацияОбОшибке();
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		Сведения.ТекстОшибки = Строка(ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	КонецПопытки;
	Возврат Сведения;

КонецФункции

// Заголовок проверки модели.
//
// Параметры:
//  Назначение - Строка - агент или маскирование.
//
// Возвращаемое значение:
//  Строка
Функция ЗаголовокМодели(Назначение)

	Возврат ?(Назначение = "маскирование", НСтр("ru = 'Модель маскирования'"), НСтр("ru = 'Модель бота'"));

КонецФункции

// Как снять флаги расширения.
//
// Параметры:
//  Расширения - Строка - Имена расширений через запятую.
//
// Возвращаемое значение:
//  Строка
Функция ПодсказкаФлагов(Расширения)

	Возврат СтрШаблон(
		НСтр("ru = 'В конфигураторе («Конфигурация → Расширения конфигурации») у расширения %1 снимите флажки «Безопасный режим» и «Защита от опасных действий».'"),
		Расширения);

КонецФункции

#КонецОбласти
