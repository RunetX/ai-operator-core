#Область СлужебныйПрограммныйИнтерфейс

// Действующие правила маскирования на время сеанса: преднастройка с изменениями из регистра
// ИИО_МаскируемыеПоля. Форма настройки сбрасывает кэш своего сеанса после записи, остальные сеансы видят
// изменения после перезапуска.
//
// Возвращаемое значение:
//  см. ИИО_Маскирование.ДействующиеПравила
Функция Правила() Экспорт

	Возврат ИИО_Маскирование.ДействующиеПравила();

КонецФункции

// Распространенные личные имена для маскирования вопроса пользователя на время сеанса.
//
// Возвращаемое значение:
//  см. ИИО_МаскированиеВвода.ИменаЛюдей
Функция ИменаЛюдей() Экспорт

	Возврат ИИО_МаскированиеВвода.ИменаЛюдей();

КонецФункции

// Названия мест и техники для маскирования вопроса пользователя на время сеанса.
//
// Возвращаемое значение:
//  см. ИИО_МаскированиеВвода.НазванияМест
Функция НазванияМест() Экспорт

	Возврат ИИО_МаскированиеВвода.НазванияМест();

КонецФункции

#КонецОбласти
