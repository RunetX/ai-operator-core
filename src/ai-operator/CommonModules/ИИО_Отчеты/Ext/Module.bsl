Функция ПериодПоПресету(Пресет, ТекущаяДата)

	Если Пресет = "today" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоДня(ТекущаяДата), КонецДня(ТекущаяДата));
	ИначеЕсли Пресет = "this_week" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоНедели(ТекущаяДата), КонецНедели(ТекущаяДата));
	ИначеЕсли Пресет = "this_month" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоМесяца(ТекущаяДата), КонецМесяца(ТекущаяДата));
	ИначеЕсли Пресет = "prev_month" Тогда
		Дата = ДобавитьМесяц(ТекущаяДата, -1);
		Возврат Новый Структура("Начало, Конец", НачалоМесяца(Дата), КонецМесяца(Дата));
	ИначеЕсли Пресет = "this_quarter" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоКвартала(ТекущаяДата), КонецКвартала(ТекущаяДата));
	ИначеЕсли Пресет = "prev_quarter" Тогда
		Дата = ДобавитьМесяц(ТекущаяДата, -3);
		Возврат Новый Структура("Начало, Конец", НачалоКвартала(Дата), КонецКвартала(Дата));
	ИначеЕсли Пресет = "this_year" Тогда
		Возврат Новый Структура("Начало, Конец", НачалоГода(ТекущаяДата), КонецГода(ТекущаяДата));
	ИначеЕсли Пресет = "prev_year" Тогда
		Дата = ДобавитьМесяц(ТекущаяДата, -12);
		Возврат Новый Структура("Начало, Конец", НачалоГода(Дата), КонецГода(Дата));
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
		СтрШаблон(НСтр("ru = 'Неизвестный пресет периода %1.'"), Пресет), ПодсказкаПоПериоду());

