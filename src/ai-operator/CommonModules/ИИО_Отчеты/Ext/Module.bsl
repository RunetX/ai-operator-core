// Преобразует значение отбора от модели в значение 1С по типу поля: ссылки - строкой ref или {"ref": ...},
// даты - ISO 8601.
//
// Параметры:
//  Значение - Строка, Число, Булево, Структура, Соответствие, Неопределено - Значение отбора от модели.
//  ДоступноеПоле - ДоступноеПолеКомпоновкиДанных - Поле отбора отчета.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Дата, Строка, Число, Булево - Значение 1С, подходящее к типу поля.
//  Структура - Ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ЗначениеПоТипуПоля(Значение, ДоступноеПоле)

	Типы = ДоступноеПоле.ТипЗначения;
	Идентификатор = Значение;
	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Значение, "ref");
	КонецЕсли;
	Если ЕстьСсылочныйТип(Типы) Тогда
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Идентификатор);
		Если Ссылка <> Неопределено И Типы.СодержитТип(ТипЗнч(Ссылка)) Тогда
			Возврат Ссылка;
		КонецЕсли;
		Если Ссылка <> Неопределено Или Не ПримитивноеЗначениеПодходит(Идентификатор, Типы) Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Отбор по полю %1 ждет ссылку типа %2.'"), ДоступноеПоле.Поле,
					ИИО_Метаданные.ПредставлениеТипа(Типы)),
				НСтр("ru = 'Найди объект через find_ref и передай его ref.'"));
		КонецЕсли;
	КонецЕсли;
	Если Типы.СодержитТип(Тип("Дата")) И ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Дата = ДатаИзАргумента(Идентификатор);
		Если Дата <> Неопределено Тогда
			Возврат Дата;
		КонецЕсли;
	КонецЕсли;
	Если ПримитивноеЗначениеПодходит(Идентификатор, Типы) Тогда
		Возврат Идентификатор;
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
		СтрШаблон(НСтр("ru = 'Значение отбора по полю %1 не подходит к типу %2.'"), ДоступноеПоле.Поле,
			ИИО_Метаданные.ПредставлениеТипа(Типы)),
		ПодсказкаПоОтборам());

КонецФункции

Функция ЕстьСсылочныйТип(Типы)

	Для Каждого Тип Из Типы.Типы() Цикл
		Если ОбщегоНазначения.ЭтоСсылка(Тип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПримитивноеЗначениеПодходит(Значение, Типы)

	Тип = ТипЗнч(Значение);
	Возврат (Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Булево")) И Типы.СодержитТип(Тип);

КонецФункции

// Возвращает поля строк отчета: из аргумента group_by или по варианту.
//
// Параметры:
//  Значение - Массив из Строка, Строка, Неопределено - Значение аргумента group_by.
//  ПоУмолчанию - ФиксированныйМассив из Строка - Поля строк варианта из каталога.
//  Компоновщик - КомпоновщикНастроекКомпоновкиДанных - Компоновщик варианта отчета.
//
// Возвращаемое значение:
//  Массив из Строка - Пути к полям строк.
//  Структура - Ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция РазобратьГруппировки(Значение, ПоУмолчанию, Компоновщик)

	Если Значение = Неопределено Тогда
		Возврат Новый Массив(ПоУмолчанию);
	КонецЕсли;
	Поля = ?(ТипЗнч(Значение) = Тип("Массив"), Значение, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Значение));
	Если Поля.Количество() = 0 Или Поля.Количество() > МаксимумГруппировок() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'group_by должен содержать от 1 до %1 полей.'"), МаксимумГруппировок()),
			НСтр("ru = 'Например [""Контрагент"", ""Документ""].'"));
	КонецЕсли;

	ДоступныеПоля = Компоновщик.Настройки.ДоступныеПоляГруппировок;
	Группировки = Новый Массив;
	Для Каждого Поле Из Поля Цикл
		ДоступноеПоле = ?(ТипЗнч(Поле) = Тип("Строка") И Не ПустаяСтрока(Поле),
			ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Поле)), Неопределено);
		Если ДоступноеПоле = Неопределено Или ДоступноеПоле.Папка Или ДоступноеПоле.Ресурс Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'По полю «%1» строки отчета не построить.'"), Поле),
				СтрШаблон(НСтр("ru = 'Поля строк: %1.'"), ИменаПолей(ДоступныеПоля)));
		КонецЕсли;
		Группировки.Добавить(Строка(ДоступноеПоле.Поле));
	КонецЦикла;
	Возврат Группировки;

КонецФункции

Функция ИменаПолей(ДоступныеПоля)

	Имена = Новый Массив;
	Для Каждого ДоступноеПоле Из ДоступныеПоля.Элементы Цикл
		Если Не ДоступноеПоле.Папка И Не ДоступноеПоле.Ресурс Тогда
			Имена.Добавить(Строка(ДоступноеПоле.Поле));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ЗаголовокПоля(ДоступныеПоля, Поле)

	ДоступноеПоле = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Поле));
	Возврат ?(ДоступноеПоле = Неопределено, Поле, ДоступноеПоле.Заголовок);

КонецФункции

// Возвращает source ответа: что сформировано. В описание не попадают значения отборов - они могут содержать ПДн
// и передаются отдельно, где маскируются по типу.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//  Компоновщик - КомпоновщикНастроекКомпоновкиДанных - Компоновщик варианта отчета, для заголовков полей.
//
// Возвращаемое значение:
//  Структура:
//   * report - Строка - Полное имя отчета.
//   * variant - Строка - Ключ варианта.
//   * name - Строка - Наименование варианта.
//   * period - Структура - from и to в формате yyyy-MM-dd.
//   * filters - Массив из Структура - field, op, value.
//   * group_by - Массив из Строка - Поля строк.
//   * description - Строка - Описание для модели без значений отборов.
Функция ИсточникДляМодели(Подготовленный, Компоновщик)

	Отборы = Новый Массив;
	Если Подготовленный.Организация <> Неопределено Тогда
		Отборы.Добавить(Новый Структура("field, op, value", "Организация", "eq", Подготовленный.Организация));
	КонецЕсли;
	Для Каждого Отбор Из Подготовленный.Отборы Цикл
		Отборы.Добавить(Новый Структура("field, op, value", Отбор.Поле, Отбор.Оп, Отбор.Значение));
	КонецЦикла;

	Поля = Новый Массив;
	Для Каждого Отбор Из Отборы Цикл
		Поля.Добавить(ЗаголовокПоля(Компоновщик.Настройки.ДоступныеПоляОтбора, Отбор.field));
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого Поле Из Подготовленный.Группировки Цикл
		Строки.Добавить(ЗаголовокПоля(Компоновщик.Настройки.ДоступныеПоляГруппировок, Поле));
	КонецЦикла;
	Описание = СтрШаблон(НСтр("ru = 'Отчет «%1» %2; строки: %3'"), Подготовленный.НаименованиеВарианта,
		ПериодДляОписания(Подготовленный), СтрСоединить(Строки, ", "));
	Если Поля.Количество() > 0 Тогда
		Описание = Описание + СтрШаблон(НСтр("ru = '; отбор: %1'"), СтрСоединить(Поля, ", "));
	КонецЕсли;

	Источник = Новый Структура;
	Источник.Вставить("report", Подготовленный.ПолноеИмя);
	Источник.Вставить("variant", Подготовленный.Вариант);
	Источник.Вставить("name", Подготовленный.НаименованиеВарианта);
	Если Подготовленный.ВидПериода = "date" Тогда
		Источник.Вставить("period", Новый Структура("date", Формат(Подготовленный.КонецПериода, "ДФ=yyyy-MM-dd")));
	Иначе
		Источник.Вставить("period", Новый Структура("from, to", Формат(Подготовленный.НачалоПериода, "ДФ=yyyy-MM-dd"),
			Формат(Подготовленный.КонецПериода, "ДФ=yyyy-MM-dd")));
	КонецЕсли;
	Источник.Вставить("filters", Отборы);
	Источник.Вставить("group_by", Подготовленный.Группировки);
	Источник.Вставить("description", Описание);
	Возврат Источник;

КонецФункции

// Период отчета для описания и заголовка: «за 01.01.2016 - 31.03.2016» или «на 31.03.2016».
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Строка
Функция ПериодДляОписания(Подготовленный)

	Если Подготовленный.ВидПериода = "date" Тогда
		Возврат СтрШаблон(НСтр("ru = 'на %1'"), Формат(Подготовленный.КонецПериода, "ДФ=dd.MM.yyyy"));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'за %1 - %2'"), Формат(Подготовленный.НачалоПериода, "ДФ=dd.MM.yyyy"),
		Формат(Подготовленный.КонецПериода, "ДФ=dd.MM.yyyy"));

КонецФункции

Функция ПериодПоУмолчанию(ВидПериода)

	Возврат ?(ВидПериода = "date", "today", "this_month");

КонецФункции

#КонецОбласти

#Область Формирование

// Формирует бухгалтерский отчет БП так же, как БухгалтерскиеОтчетыВызовСервера.ПодготовитьОтчет,
// но с выводом в дерево значений: структура «таблица + диаграммы» заменяется цепочкой группировок
// под общим итогом.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Структура:
//   * Дерево - ДеревоЗначений
//   * Уровни - Массив из Массив из Строка - Поля строк по уровням вложенности.
//   * Показатели - Массив из Строка - Выбранные показатели.
//   * Компоновщик - КомпоновщикНастроекКомпоновкиДанных - Для типов и заголовков полей.
Функция ДеревоБухгалтерскогоОтчета(Подготовленный)

	Менеджер = Отчеты[Подготовленный.ИмяОтчета];
	// Модуль есть только в БП: прямая ссылка не даст модулю скомпилироваться в ЗУП и УТ.
	ПараметрыИсполнения = ОбщегоНазначения.ОбщийМодуль("БухгалтерскиеОтчеты").ПараметрыИсполненияОтчета(
		Подготовленный.ИмяОтчета);
	Если ЗначениеПараметраИсполнения(ПараметрыИсполнения, "ИспользоватьПередВыводомЭлементаРезультата", Ложь) Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Отчет %1 обрабатывает элементы результата при выводе: в коллекцию его не вывести.'"),
			Подготовленный.ПолноеИмя);
	КонецЕсли;
	Схема = Менеджер.ПолучитьМакет("СхемаКомпоновкиДанных");
	ПараметрыОтчета = ПараметрыБухгалтерскогоОтчета(Подготовленный, Схема);

	// Привилегированный режим - как в форме отчета БП: инициализация в нем, если так задано в параметрах
	// исполнения отчета, а вывод - по праву пользователя на данные бухгалтерии. Выключается в конце функции.
	ИнициализацияВПривилегированномРежиме = ЗначениеПараметраИсполнения(ПараметрыИсполнения,
		"ИнициализацияВПривилегированномРежиме", Ложь);
	Если ИнициализацияВПривилегированномРежиме Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.ЗагрузитьНастройки(ПараметрыОтчета.НастройкиКомпоновкиДанных);
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Если ЗначениеПараметраИсполнения(ПараметрыИсполнения, "ИспользоватьПередКомпоновкойМакета", Ложь) Тогда
		Менеджер.ПередКомпоновкойМакета(ПараметрыОтчета, Схема, Компоновщик);
	КонецЕсли;
	Компоновщик.Восстановить();
	Настройки = Компоновщик.ПолучитьНастройки();
	Сформированный = СтруктураДляКоллекции(Настройки, Схема, Подготовленный.Группировки);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , ,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Если ЗначениеПараметраИсполнения(ПараметрыИсполнения, "ИспользоватьПослеКомпоновкиМакета", Ложь) Тогда
		Менеджер.ПослеКомпоновкиМакета(ПараметрыОтчета, Макет);
	КонецЕсли;
	ВнешниеНаборыДанных = Неопределено;
	Если ЗначениеПараметраИсполнения(ПараметрыИсполнения, "ИспользоватьВнешниеНаборыДанных", Ложь) Тогда
		ВнешниеНаборыДанных = Менеджер.ПолучитьВнешниеНаборыДанных(ПараметрыОтчета, Макет);
	КонецЕсли;
	МенеджерВременныхТаблиц = Неопределено;
	Если ЗначениеПараметраИсполнения(ПараметрыИсполнения, "ИспользоватьВременныеТаблицыЗапроса", Ложь) Тогда
		МенеджерВременныхТаблиц = Менеджер.МенеджерВременныхТаблицОтчета(ПараметрыОтчета, Макет);
	КонецЕсли;

	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет, ВнешниеНаборыДанных, , Истина, , МенеджерВременныхТаблиц);
	Дерево = Новый ДеревоЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Дерево);
	ВыводВПривилегированномРежиме = ЗначениеПараметраИсполнения(ПараметрыИсполнения,
		"ИспользоватьПривилегированныйРежим", Истина);
	Если ВыводВПривилегированномРежиме Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	ПроцессорВывода.Вывести(Процессор);
	Если ВыводВПривилегированномРежиме Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Если ИнициализацияВПривилегированномРежиме Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	Сформированный.Вставить("Дерево", Дерево);
	Сформированный.Вставить("Компоновщик", Компоновщик);
	Возврат Сформированный;

КонецФункции

// Возвращает параметры отчета для БухгалтерскиеОтчеты: как их собирает форма отчета перед формированием.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//  Схема - СхемаКомпоновкиДанных - Схема отчета.
//
// Возвращаемое значение:
//  Структура - Пустые параметры менеджера отчета (ПустыеПараметрыКомпоновкиОтчета), заполненные
//    периодом, организацией, параметрами варианта, группировками, отборами и настройками компоновки.
Функция ПараметрыБухгалтерскогоОтчета(Подготовленный, Схема)

	ПараметрыОтчета = Отчеты[Подготовленный.ИмяОтчета].ПустыеПараметрыКомпоновкиОтчета();
	ПараметрыОтчета.НачалоПериода = Подготовленный.НачалоПериода;
	ПараметрыОтчета.КонецПериода = Подготовленный.КонецПериода;
	Если Подготовленный.Организация <> Неопределено Тогда
		ПараметрыОтчета.Организация = Подготовленный.Организация;
	КонецЕсли;
	Для Каждого Параметр Из Подготовленный.Параметры Цикл
		ПараметрыОтчета.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	Группировка = Новый ТаблицаЗначений;
	Группировка.Колонки.Добавить("Использование");
	Группировка.Колонки.Добавить("Поле");
	Группировка.Колонки.Добавить("Представление");
	Группировка.Колонки.Добавить("ТипГруппировки");
	Для Каждого Поле Из Подготовленный.Группировки Цикл
		СтрокаГруппировки = Группировка.Добавить();
		СтрокаГруппировки.Использование = Истина;
		СтрокаГруппировки.Поле = Поле;
		СтрокаГруппировки.Представление = Поле;
		СтрокаГруппировки.ТипГруппировки = 0;
	КонецЦикла;
	ПараметрыОтчета.Вставить("Группировка", Группировка);
	ДополнительныеПоля = Новый ТаблицаЗначений;
	ДополнительныеПоля.Колонки.Добавить("Использование");
	ДополнительныеПоля.Колонки.Добавить("Поле");
	ДополнительныеПоля.Колонки.Добавить("Представление");
	ПараметрыОтчета.Вставить("ДополнительныеПоля", ДополнительныеПоля);

	ПараметрыОтчета.Вставить("ВыводитьЗаголовок", Ложь);
	ПараметрыОтчета.Вставить("ВыводитьПодвал", Ложь);
	ПараметрыОтчета.Вставить("ВыводитьДиаграмму", Ложь);
	ПараметрыОтчета.Вставить("РежимРасшифровки", Ложь);
	ПараметрыОтчета.Вставить("КлючТекущегоВарианта", Подготовленный.Вариант);
	ПараметрыОтчета.Вставить("ИдентификаторОтчета", Подготовленный.ИмяОтчета);
	ПараметрыОтчета.Вставить("СхемаКомпоновкиДанных", Схема);

	Настройки = Схема.ВариантыНастроек.Найти(Подготовленный.Вариант).Настройки;
	ДобавитьОтборы(Настройки.Отбор, Подготовленный.Отборы);
	ПараметрыОтчета.Вставить("НастройкиКомпоновкиДанных", Настройки);
	Возврат ПараметрыОтчета;

КонецФункции

Процедура ДобавитьОтборы(Отбор, Отборы)

	Для Каждого Описание Из Отборы Цикл
		Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Описание.Поле);
		Элемент.ВидСравнения = ВидСравнения(Описание.Оп);
		Если ТипЗнч(Описание.Значение) = Тип("Массив") Тогда
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Описание.Значение);
			Элемент.ПравоеЗначение = Список;
		Иначе
			Элемент.ПравоеЗначение = Описание.Значение;
		КонецЕсли;
		Элемент.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

// Заменяет структуру настроек цепочкой группировок под общим итогом.
// Группировки и их отборы (например, «Сумма не равна 0») берутся из строк таблицы, которую построил
// менеджер отчета; показатели - из выбора таблицы. Общий итог - группировка по вычисляемому полю
// с постоянным значением: при выводе в коллекцию общие итоги отдельной строкой не выводятся.
//
// Параметры:
//  Настройки - НастройкиКомпоновкиДанных - Настройки, построенные менеджером отчета; меняются на месте.
//  Схема - СхемаКомпоновкиДанных - В схему добавляется вычисляемое поле общего итога.
//  Группировки - Массив из Строка - Поля строк, если в настройках нет таблицы.
//
// Возвращаемое значение:
//  Структура:
//   * Уровни - Массив из Массив из Строка - Поля строк по уровням вложенности.
//   * Показатели - Массив из Строка
Функция СтруктураДляКоллекции(Настройки, Схема, Группировки)

	Таблица = Неопределено;
	Для Каждого ЭлементСтруктуры Из Настройки.Структура Цикл
		Если ТипЗнч(ЭлементСтруктуры) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Таблица = ЭлементСтруктуры;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Цепочка = Новый Массив;
	Показатели = Новый Массив;
	Если Таблица <> Неопределено Тогда
		ЭлементЦепочки = ?(Таблица.Строки.Количество() > 0, Таблица.Строки[0], Неопределено);
		Пока ЭлементЦепочки <> Неопределено Цикл
			Цепочка.Добавить(ЭлементЦепочки);
			ЭлементЦепочки = ?(ЭлементЦепочки.Структура.Количество() > 0, ЭлементЦепочки.Структура[0], Неопределено);
		КонецЦикла;
		Для Каждого ВыбранноеПоле Из Таблица.Выбор.Элементы Цикл
			Если ТипЗнч(ВыбранноеПоле) = Тип("ВыбранноеПолеКомпоновкиДанных") И ВыбранноеПоле.Использование Тогда
				Показатели.Добавить(Строка(ВыбранноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого ВыбранноеПоле Из Настройки.Выбор.Элементы Цикл
			Если ТипЗнч(ВыбранноеПоле) = Тип("ВыбранноеПолеКомпоновкиДанных") И ВыбранноеПоле.Использование Тогда
				Показатели.Добавить(Строка(ВыбранноеПоле.Поле));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Настройки.Структура.Очистить();
	Настройки.Выбор.Элементы.Очистить();
	Для Каждого Показатель Из Показатели Цикл
		ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(Показатель);
		ВыбранноеПоле.Использование = Истина;
	КонецЦикла;

	ПолеИтога = Схема.ВычисляемыеПоля.Добавить();
	ПолеИтога.ПутьКДанным = ИмяПоляИтога();
	ПолеИтога.Выражение = "1";
	Родитель = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДобавитьПолеГруппировки(Родитель, ИмяПоляИтога(), ТипГруппировкиКомпоновкиДанных.Элементы);
	Родитель.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	Уровни = Новый Массив;
	Если Цепочка.Количество() > 0 Тогда
		Для Каждого ГруппировкаТаблицы Из Цепочка Цикл
			Группа = Родитель.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
			ПоляУровня = Новый Массив;
			Для Каждого ПолеГруппировки Из ГруппировкаТаблицы.ПоляГруппировки.Элементы Цикл
				Если ТипЗнч(ПолеГруппировки) = Тип("ПолеГруппировкиКомпоновкиДанных")
					И ПолеГруппировки.Использование Тогда
					ДобавитьПолеГруппировки(Группа, Строка(ПолеГруппировки.Поле), ПолеГруппировки.ТипГруппировки);
					ПоляУровня.Добавить(Строка(ПолеГруппировки.Поле));
				КонецЕсли;
			КонецЦикла;
			Для Каждого ЭлементОтбора Из ГруппировкаТаблицы.Отбор.Элементы Цикл
				Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") И ЭлементОтбора.Использование Тогда
					Копия = Группа.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					Копия.ЛевоеЗначение = ЭлементОтбора.ЛевоеЗначение;
					Копия.ВидСравнения = ЭлементОтбора.ВидСравнения;
					Копия.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
					Копия.Использование = Истина;
				КонецЕсли;
			КонецЦикла;
			ЗавершитьГруппу(Группа);
			Уровни.Добавить(ПоляУровня);
			Родитель = Группа;
		КонецЦикла;
	Иначе
		ДобавитьЦепочкуГруппировок(Родитель, Группировки);
		Для Каждого Поле Из Группировки Цикл
			Уровни.Добавить(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Поле));
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Уровни, Показатели", Уровни, Показатели);

КонецФункции

// Добавляет вложенные группировки по полям строк: каждая следующая - внутри предыдущей, без иерархии.
//
// Параметры:
//  Родитель - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - Куда добавить первую группировку.
//  Поля - Массив из Строка - Поля строк по уровням.
Процедура ДобавитьЦепочкуГруппировок(Родитель, Поля)

	Владелец = Родитель;
	Для Каждого Поле Из Поля Цикл
		Группа = Владелец.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ДобавитьПолеГруппировки(Группа, Поле, ТипГруппировкиКомпоновкиДанных.Элементы);
		ЗавершитьГруппу(Группа);
		Владелец = Группа;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПолеГруппировки(Группа, Поле, ТипГруппировки)

	ПолеГруппировки = Группа.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(Поле);
	ПолеГруппировки.ТипГруппировки = ТипГруппировки;
	ПолеГруппировки.Использование = Истина;

КонецПроцедуры

Процедура ЗавершитьГруппу(Группа)

	Группа.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группа.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));

КонецПроцедуры

Функция ЗначениеПараметраИсполнения(ПараметрыИсполнения, Имя, ПоУмолчанию)

	Значение = Неопределено;
	Если ТипЗнч(ПараметрыИсполнения) = Тип("Структура") И ПараметрыИсполнения.Свойство(Имя, Значение)
		И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;

КонецФункции

// Формирует отчет на основной схеме компоновки так же, как его форма: отчет сам компонует результат
// в табличный документ (его ПриКомпоновкеРезультата подставляет текст запроса и параметры), а строки
// и итоги для модели берутся из данных расшифровки ячеек. Структура варианта заменяется цепочкой
// группировок по полям строк: строки считает тот же запрос отчета, общий итог совпадает с формой.
// Отчет формируется с правами пользователя, без привилегированного режима.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  см. РезультатДляМодели
Функция РезультатОтчетаСКД(Подготовленный)

	Отчет = Отчеты[Подготовленный.ИмяОтчета].Создать();
	Настройки = НастройкиОтчетаСКД(Отчет.СхемаКомпоновкиДанных, Подготовленный);
	Настройки.Структура.Очистить();
	ДобавитьЦепочкуГруппировок(Настройки, Подготовленный.Группировки);
	// Вариант может не выводить общий итог (например, задолженность клиентов): итоги для модели считает компоновка.
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов",
		РасположениеИтоговКомпоновкиДанных.Конец);
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	// Ключ варианта отчеты БСП читают из дополнительных свойств, как при формировании из формы.
	Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("КлючВарианта",
		Подготовленный.Вариант);

	Документ = Новый ТабличныйДокумент;
	ДанныеРасшифровки = Новый ДанныеРасшифровкиКомпоновкиДанных;
	Отчет.СкомпоноватьРезультат(Документ, ДанныеРасшифровки);
	Возврат РезультатСКДДляМодели(Документ, ДанныеРасшифровки, Подготовленный,
		Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора);

КонецФункции

// Настройки варианта отчета skd с периодом, параметрами из каталога и отборами.
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - Основная схема отчета; настройки варианта меняются на месте.
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  НастройкиКомпоновкиДанных
Функция НастройкиОтчетаСКД(Схема, Подготовленный)

	Настройки = Схема.ВариантыНастроек.Найти(Подготовленный.Вариант).Настройки;
	Если Подготовленный.ВидПериода = "date" Тогда
		ЗначениеПериода = Подготовленный.КонецПериода;
	Иначе
		ЗначениеПериода = Новый СтандартныйПериод(Подготовленный.НачалоПериода, Подготовленный.КонецПериода);
	КонецЕсли;
	УстановитьПараметрОтчета(Настройки, Подготовленный.ПараметрПериода, ЗначениеПериода);
	Для Каждого Параметр Из Подготовленный.Параметры Цикл
		УстановитьПараметрОтчета(Настройки, Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	ДобавитьОтборы(Настройки.Отбор, Подготовленный.Отборы);
	Возврат Настройки;

КонецФункции

Процедура УстановитьПараметрОтчета(Настройки, Имя, Значение)

	ЗначениеПараметра = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных(Имя));
	Если ЗначениеПараметра = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В отчете нет параметра %1, заданного в макете ИИО_КаталогОтчетов.'"),
			Имя);
	КонецЕсли;
	ЗначениеПараметра.Значение = Значение;
	ЗначениеПараметра.Использование = Истина;

КонецПроцедуры

// Параметры общей формы отчета БСП: вариант, период пользовательской настройкой, отборы по полям верхнего уровня
// со сравнением eq и in - параметром Отбор. Строки отчет показывает по своему варианту.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Структура - КлючВарианта, ПользовательскиеНастройки, СформироватьПриОткрытии и, если есть отборы, Отбор.
Функция ПараметрыФормыОтчетаСКД(Подготовленный)

	Схема = СхемаОтчета(Подготовленный.ИмяОтчета, Подготовленный.Адаптер);
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(НастройкиОтчетаСКД(Схема, Подготовленный));

	ПараметрыФормы = Новый Структура("КлючВарианта, ПользовательскиеНастройки, СформироватьПриОткрытии",
		Подготовленный.Вариант, Компоновщик.ПользовательскиеНастройки, Истина);
	Отбор = Новый Структура;
	Для Каждого Описание Из Подготовленный.Отборы Цикл
		Если СтрНайти(Описание.Поле, ".") > 0 Тогда
			Продолжить;
		ИначеЕсли Описание.Оп = "eq" Тогда
			Отбор.Вставить(Описание.Поле, Описание.Значение);
		ИначеЕсли Описание.Оп = "in" Тогда
			Список = Новый СписокЗначений;
			Список.ЗагрузитьЗначения(Описание.Значение);
			Отбор.Вставить(Описание.Поле, Список);
		КонецЕсли;
	КонецЦикла;
	Если Отбор.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("Отбор", Отбор);
	КонецЕсли;
	Возврат ПараметрыФормы;

КонецФункции

#КонецОбласти

#Область ОтветМодели

// Возвращает строки нижнего уровня со значениями всех полей строк, итоги и описание колонок.
//
// Параметры:
//  Сформированный - см. ДеревоБухгалтерскогоОтчета
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Структура:
//   * report - Строка - Полное имя отчета.
//   * variant - Строка - Ключ варианта.
//   * columns - Массив из Структура - name, title, type: сначала поля строк, затем показатели.
//   * rows - Массив из Массив - Строки нижнего уровня, не больше Подготовленный.Строк.
//   * totals - Соответствие - Итоги показателей: имя показателя и значение.
//   * row_count - Число - Всего строк нижнего уровня.
//   * truncated - Булево - Истина, если вернулись не все строки.
Функция РезультатДляМодели(Сформированный, Подготовленный)

	Дерево = Сформированный.Дерево;
	ДоступныеПоля = Сформированный.Компоновщик.Настройки.ДоступныеПоляВыбора;

	Колонки = Новый Массив;
	Уровни = Новый Массив;
	Для Каждого ПоляУровня Из Сформированный.Уровни Цикл
		ОписанияУровня = Новый Массив;
		Для Каждого Поле Из ПоляУровня Цикл
			ОписанияУровня.Добавить(ОписаниеКолонки(Дерево, ДоступныеПоля, Поле, Колонки,
				Подготовленный.ПустыеЗначения.Получить(Поле)));
		КонецЦикла;
		Уровни.Добавить(ОписанияУровня);
	КонецЦикла;
	ЧислоПолейСтрок = Колонки.Количество();
	Показатели = Новый Массив;
	Для Каждого Поле Из Сформированный.Показатели Цикл
		Показатели.Добавить(ОписаниеКолонки(Дерево, ДоступныеПоля, Поле, Колонки, Неопределено));
	КонецЦикла;

	Контекст = Новый Структура;
	Контекст.Вставить("Уровни", Уровни);
	Контекст.Вставить("Показатели", Показатели);
	Контекст.Вставить("ЧислоПолейСтрок", ЧислоПолейСтрок);
	Контекст.Вставить("Лимит", Подготовленный.Строк);
	Контекст.Вставить("Строки", Новый Массив);
	Контекст.Вставить("Всего", 0);

	Итоги = Новый Соответствие;
	Если Дерево.Строки.Количество() > 0 Тогда
		СтрокаИтога = Дерево.Строки[0];
		Для Каждого Показатель Из Показатели Цикл
			Итоги.Вставить(Показатель.Имя, ЗначениеКолонки(СтрокаИтога, Показатель));
		КонецЦикла;
		Если Уровни.Количество() > 0 Тогда
			СобратьСтроки(СтрокаИтога.Строки, 0, Новый Массив, Контекст);
		КонецЕсли;
	Иначе
		Для Каждого Показатель Из Показатели Цикл
			Итоги.Вставить(Показатель.Имя, 0);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("report", Подготовленный.ПолноеИмя);
	Результат.Вставить("variant", Подготовленный.Вариант);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Контекст.Строки);
	Результат.Вставить("totals", Итоги);
	Результат.Вставить("row_count", Контекст.Всего);
	Результат.Вставить("truncated", Контекст.Всего > Контекст.Строки.Количество());
	Возврат Результат;

КонецФункции

// Строки и итоги отчета skd по данным расшифровки. Для каждой строки табличного документа значения полей строк
// берутся из элементов расшифровки ячеек и их родителей, показатели - из полей ячеек. Строки нижнего уровня -
// те, где известны все поля строк; общий итог - строка с показателями без полей строк. Показатель, который отчет
// вычисляет при выводе (например, рентабельность), в расшифровке пуст: его число берется из текста ячейки.
//
// Параметры:
//  Документ - ТабличныйДокумент - Результат отчета.
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных
//  Подготовленный - см. ПодготовитьФормирование
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - Поля выбора отчета.
//
// Возвращаемое значение:
//  см. РезультатДляМодели
Функция РезультатСКДДляМодели(Документ, ДанныеРасшифровки, Подготовленный, ДоступныеПоля)

	Колонки = Новый Массив;
	ПоляСтрок = Новый Массив;
	Для Каждого Поле Из Подготовленный.Группировки Цикл
		ПоляСтрок.Добавить(ОписаниеПоля(ДоступныеПоля, Поле, Колонки, Подготовленный.ПустыеЗначения.Получить(Поле)));
	КонецЦикла;

	ИменаПоказателей = Новый Массив;
	СтрокаИтога = Неопределено;
	Нижние = Новый Массив;
	Всего = 0;
	Для НомерСтроки = 1 По Документ.ВысотаТаблицы Цикл
		СтрокаОтчета = СтрокаОтчетаСКД(Документ, ДанныеРасшифровки, НомерСтроки, Подготовленный.Группировки);
		Если СтрокаОтчета.Показатели.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Показатель Из СтрокаОтчета.Показатели Цикл
			Если ИменаПоказателей.Найти(Показатель.Имя) = Неопределено Тогда
				ИменаПоказателей.Добавить(Показатель.Имя);
			КонецЕсли;
		КонецЦикла;
		Уровень = СтрокаОтчета.Группы.Количество();
		Если Уровень = 0 И СтрокаИтога = Неопределено Тогда
			СтрокаИтога = СтрокаОтчета;
		ИначеЕсли Уровень = ПоляСтрок.Количество() Тогда
			Всего = Всего + 1;
			Если Нижние.Количество() < Подготовленный.Строк Тогда
				Нижние.Добавить(СтрокаОтчета);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Показатели = Новый Массив;
	Для Каждого Имя Из ИменаПоказателей Цикл
		Показатели.Добавить(ОписаниеПоля(ДоступныеПоля, Имя, Колонки, Неопределено));
	КонецЦикла;
	Строки = Новый Массив;
	Для Каждого СтрокаОтчета Из Нижние Цикл
		Значения = Новый Массив;
		Для Каждого ОписаниеПоляСтрок Из ПоляСтрок Цикл
			Значения.Добавить(ЗначениеДляМодели(СтрокаОтчета.Группы.Получить(ОписаниеПоляСтрок.Имя), ОписаниеПоляСтрок,
				СтрокаОтчета.Тексты.Получить(ОписаниеПоляСтрок.Имя)));
		КонецЦикла;
		Для Каждого Показатель Из Показатели Цикл
			Значения.Добавить(ЗначениеДляМодели(ЗначениеПоказателя(СтрокаОтчета, Показатель.Имя), Показатель));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;
	Итоги = Новый Соответствие;
	Для Каждого Показатель Из Показатели Цикл
		Итоги.Вставить(Показатель.Имя, ?(СтрокаИтога = Неопределено, 0,
			ЗначениеДляМодели(ЗначениеПоказателя(СтрокаИтога, Показатель.Имя), Показатель)));
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("report", Подготовленный.ПолноеИмя);
	Результат.Вставить("variant", Подготовленный.Вариант);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("totals", Итоги);
	Результат.Вставить("row_count", Всего);
	Результат.Вставить("truncated", Всего > Строки.Количество());
	Возврат Результат;

КонецФункции

// Значения одной строки табличного документа отчета skd по расшифровке ее ячеек.
//
// Параметры:
//  Документ - ТабличныйДокумент
//  ДанныеРасшифровки - ДанныеРасшифровкиКомпоновкиДанных
//  НомерСтроки - Число
//  ИменаПолейСтрок - Массив из Строка - Поля строк отчета.
//
// Возвращаемое значение:
//  Структура:
//   * Группы - Соответствие - Поле строк и его значение, если строка относится к этой группировке.
//   * Тексты - Соответствие - Поле строк и текст его ячейки: подпись пустого значения, как ее выводит отчет.
//   * Показатели - Массив из Структура - Имя и Значение показателей в порядке колонок.
Функция СтрокаОтчетаСКД(Документ, ДанныеРасшифровки, НомерСтроки, ИменаПолейСтрок)

	СтрокаОтчета = Новый Структура("Группы, Тексты, Показатели", Новый Соответствие, Новый Соответствие,
		Новый Массив);
	Для НомерКолонки = 1 По Документ.ШиринаТаблицы Цикл
		Область = Документ.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
		Если ТипЗнч(Область.Расшифровка) <> Тип("ИдентификаторРасшифровкиКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Элемент = ДанныеРасшифровки.Элементы[Область.Расшифровка];
		Если ТипЗнч(Элемент) <> Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьПоляРодителей(Элемент, ИменаПолейСтрок, СтрокаОтчета.Группы);
		Для Каждого ЗначениеПоля Из Элемент.ПолучитьПоля() Цикл
			Если ИменаПолейСтрок.Найти(ЗначениеПоля.Поле) <> Неопределено Тогда
				СтрокаОтчета.Группы.Вставить(ЗначениеПоля.Поле, ЗначениеПоля.Значение);
				СтрокаОтчета.Тексты.Вставить(ЗначениеПоля.Поле, Область.Текст);
			ИначеЕсли ЗначениеПоказателя(СтрокаОтчета, ЗначениеПоля.Поле) = Неопределено Тогда
				Значение = ?(ЗначениеПоля.Значение = Null, ЧислоИзТекста(Область.Текст), ЗначениеПоля.Значение);
				СтрокаОтчета.Показатели.Добавить(Новый Структура("Имя, Значение", ЗначениеПоля.Поле, Значение));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат СтрокаОтчета;

КонецФункции

Процедура ДобавитьПоляРодителей(Элемент, ИменаПолейСтрок, Группы)

	Для Каждого Родитель Из Элемент.ПолучитьРодителей() Цикл
		Если ТипЗнч(Родитель) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
			Для Каждого ЗначениеПоля Из Родитель.ПолучитьПоля() Цикл
				Если ИменаПолейСтрок.Найти(ЗначениеПоля.Поле) <> Неопределено Тогда
					Группы.Вставить(ЗначениеПоля.Поле, ЗначениеПоля.Значение);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		ДобавитьПоляРодителей(Родитель, ИменаПолейСтрок, Группы);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеПоказателя(СтрокаОтчета, Имя)

	Для Каждого Показатель Из СтрокаОтчета.Показатели Цикл
		Если Показатель.Имя = Имя Тогда
			Возврат Показатель.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Число из текста ячейки отчета: «1 234,56», «-12,5». В ячейке показателя может быть только число,
// поэтому текст, который числом не является, модели не передается.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Число, Неопределено
Функция ЧислоИзТекста(Текст)

	Очищенный = СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), Символы.НПП, ""), ",", ".");
	Цифры = СтрЗаменить(?(СтрНачинаетсяС(Очищенный, "-"), Сред(Очищенный, 2), Очищенный), ".", "");
	Если ПустаяСтрока(Цифры) Или Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Цифры)
		Или СтрЧислоВхождений(Очищенный, ".") > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеЧисла = Новый ОписаниеТипов("Число");
	Возврат ОписаниеЧисла.ПривестиЗначение(Очищенный);

КонецФункции

// Возвращает описание колонки ответа: колонка дерева, вид ПДн значения, подпись пустого значения.
// Заголовок и тип для модели добавляет в Колонки.
//
// Параметры:
//  Дерево - ДеревоЗначений - Результат отчета.
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - Поля выбора отчета.
//  Поле - Строка - Путь к полю.
//  Колонки - Массив из Структура - Колонки ответа модели, пополняется: name, title, type.
//  ПустоеЗначение - Строка, Неопределено - Подпись пустого значения поля строк из каталога.
//
// Возвращаемое значение:
//  см. ОписаниеПоля
Функция ОписаниеКолонки(Дерево, ДоступныеПоля, Поле, Колонки, ПустоеЗначение)

	Описание = ОписаниеПоля(ДоступныеПоля, Поле, Колонки, ПустоеЗначение);
	// Имена колонок дерева процессор вывода строит из пути к полю без точек.
	КолонкаДерева = Дерево.Колонки.Найти(СтрЗаменить(Поле, ".", ""));
	Если КолонкаДерева = Неопределено Тогда
		Для Каждого Колонка Из Дерево.Колонки Цикл
			Если Колонка.Заголовок = Описание.Заголовок Тогда
				КолонкаДерева = Колонка;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Описание.Колонка = ?(КолонкаДерева = Неопределено, Неопределено, КолонкаДерева.Имя);
	Возврат Описание;

КонецФункции

// Возвращает описание поля ответа: заголовок, вид ПДн значения, подпись пустого значения.
// Заголовок и тип для модели добавляет в Колонки.
//
// Параметры:
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - Поля выбора отчета.
//  Поле - Строка - Путь к полю.
//  Колонки - Массив из Структура - Колонки ответа модели, пополняется: name, title, type.
//  ПустоеЗначение - Строка, Неопределено - Подпись пустого значения поля строк из каталога.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - Путь к полю.
//   * Заголовок - Строка
//   * Колонка - Строка, Неопределено - Имя колонки дерева бухгалтерского отчета; Неопределено, если ее нет.
//   * ВидПДн - Строка - Вид ПДн, см. ВидПДнПоля.
//   * ПустоеЗначение - Строка, Неопределено - Подпись пустого значения.
Функция ОписаниеПоля(ДоступныеПоля, Поле, Колонки, ПустоеЗначение)

	ДоступноеПоле = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Поле));
	Заголовок = ?(ДоступноеПоле = Неопределено, Поле, ДоступноеПоле.Заголовок);
	Колонки.Добавить(Новый Структура("name, title, type", Поле, Заголовок,
		?(ДоступноеПоле = Неопределено, "", ИИО_Метаданные.ПредставлениеТипа(ДоступноеПоле.ТипЗначения))));
	Возврат Новый Структура("Имя, Заголовок, Колонка, ВидПДн, ПустоеЗначение", Поле, Заголовок, Неопределено,
		ВидПДнПоля(ДоступныеПоля, Поле), ПустоеЗначение);

КонецФункции

Процедура СобратьСтроки(СтрокиДерева, НомерУровня, Значения, Контекст)

	Уровень = Контекст.Уровни[НомерУровня];
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ЗначенияСтроки = Новый Массив;
		Для Каждого Значение Из Значения Цикл
			ЗначенияСтроки.Добавить(Значение);
		КонецЦикла;
		Для Каждого ОписаниеКолонки Из Уровень Цикл
			ЗначенияСтроки.Добавить(ЗначениеКолонки(СтрокаДерева, ОписаниеКолонки));
		КонецЦикла;
		Если НомерУровня < Контекст.Уровни.ВГраница() И СтрокаДерева.Строки.Количество() > 0 Тогда
			СобратьСтроки(СтрокаДерева.Строки, НомерУровня + 1, ЗначенияСтроки, Контекст);
			Продолжить;
		КонецЕсли;
		Контекст.Всего = Контекст.Всего + 1;
		Если Контекст.Строки.Количество() >= Контекст.Лимит Тогда
			Продолжить;
		КонецЕсли;
		Пока ЗначенияСтроки.Количество() < Контекст.ЧислоПолейСтрок Цикл
			ЗначенияСтроки.Добавить(Неопределено);
		КонецЦикла;
		Для Каждого Показатель Из Контекст.Показатели Цикл
			ЗначенияСтроки.Добавить(ЗначениеКолонки(СтрокаДерева, Показатель));
		КонецЦикла;
		Контекст.Строки.Добавить(ЗначенияСтроки);
	КонецЦикла;

КонецПроцедуры

// Возвращает значение колонки для модели: строки и даты полей с ПДн помечаются для клиентского ядра,
// ссылки маскирует ИИО_Ответ по виду объекта. Пустое значение поля строк получает подпись из каталога,
// как в самом отчете (например, «Розничные покупатели»).
//
// Параметры:
//  СтрокаДерева - СтрокаДереваЗначений - Строка результата отчета.
//  ОписаниеКолонки - см. ОписаниеКолонки
//
// Возвращаемое значение:
//  Произвольный - Значение колонки; Неопределено, если колонки нет, см. ЗначениеДляМодели.
Функция ЗначениеКолонки(СтрокаДерева, ОписаниеКолонки)

	Если ОписаниеКолонки.Колонка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗначениеДляМодели(СтрокаДерева[ОписаниеКолонки.Колонка], ОписаниеКолонки);

КонецФункции

// Возвращает значение поля для модели: строки и даты полей с ПДн помечаются для клиентского ядра,
// ссылки маскирует ИИО_Ответ по виду объекта. Пустое значение поля строк получает подпись из каталога
// или из ячейки отчета, как в самом отчете (например, «Розничные покупатели»).
//
// Параметры:
//  Значение - Произвольный - Значение поля в результате отчета.
//  ОписаниеПоля - см. ОписаниеПоля
//  ТекстЯчейки - Строка, Неопределено - Текст ячейки поля строк в табличном документе отчета skd.
//
// Возвращаемое значение:
//  Произвольный - Значение; Структура {"presentation"} для пустого значения с подписью,
//    значение с пометкой ПДн (см. ИИО_Ответ.ЗначениеСПДн) или Неопределено, если значение Null.
Функция ЗначениеДляМодели(Значение, ОписаниеПоля, ТекстЯчейки = Неопределено)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Если ОписаниеПоля.ПустоеЗначение <> Неопределено Тогда
			Возврат Новый Структура("presentation", ОписаниеПоля.ПустоеЗначение);
		ИначеЕсли ЗначениеЗаполнено(ТекстЯчейки) Тогда
			Возврат Новый Структура("presentation", ТекстЯчейки);
		КонецЕсли;
	КонецЕсли;
	Если Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеПоля.ВидПДн) И ЗначениеЗаполнено(Значение)
		И (ТипЗнч(Значение) = Тип("Строка") Или ТипЗнч(Значение) = Тип("Дата")) Тогда
		Возврат ИИО_Ответ.ЗначениеСПДн(Значение, ОписаниеПоля.ВидПДн);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Возвращает вид ПДн поля отчета по пути к данным. Ссылки маскируются построчно по виду объекта,
// числа и булевы значения не маскируются. Реквизит ссылки проверяется по реестру маскируемых полей.
// Строковое поле верхнего уровня не проследить до объекта, поэтому оно считается ПДн;
// дата верхнего уровня - это период отчета, ее не маскируем.
//
// Параметры:
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - Поля выбора отчета.
//  Поле - Строка - Путь к полю, например Контрагент.ИНН.
//
// Возвращаемое значение:
//  Строка - Вид ПДн или пустая строка, если поле не маскируется.
Функция ВидПДнПоля(ДоступныеПоля, Поле)

	ДоступноеПоле = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Поле));
	Если ДоступноеПоле = Неопределено Тогда
		Возврат ВидПДнНеизвестногоПоля();
	КонецЕсли;
	Типы = ДоступноеПоле.ТипЗначения;
	ЕстьСтрока = Типы.СодержитТип(Тип("Строка"));
	Если Не ЕстьСтрока И Не Типы.СодержитТип(Тип("Дата")) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(Поле, ".");
	Если Части.Количество() = 1 Тогда
		Возврат ?(ЕстьСтрока, ВидПДнНеизвестногоПоля(), "");
	КонецЕсли;
	ИмяРеквизита = Части[Части.ВГраница()];
	Части.Удалить(Части.ВГраница());
	ПолеВладельца = ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(СтрСоединить(Части, ".")));
	Если ПолеВладельца = Неопределено Тогда
		Возврат ВидПДнНеизвестногоПоля();
	КонецЕсли;
	ВидПДн = "";
	Для Каждого Тип Из ПолеВладельца.ТипЗначения.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных <> Неопределено Тогда
			ВидПДн = ИИО_Маскирование.ОбъединитьВидыПДн(ВидПДн,
				ИИО_Маскирование.ВидПДнПоля(ОбъектМетаданных.ПолноеИмя(), ИмяРеквизита));
		КонецЕсли;
	КонецЦикла;
	Возврат ВидПДн;

КонецФункции

Функция ВидПДнНеизвестногоПоля()

	Возврат "ПДн";

КонецФункции

#КонецОбласти

