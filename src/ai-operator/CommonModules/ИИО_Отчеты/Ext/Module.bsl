	КонецЦикла;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
		СтрШаблон(НСтр("ru = 'У отчета нет поддерживаемого варианта %1.'"), Ключ),
		СтрШаблон(НСтр("ru = 'Варианты: %1.'"), СтрСоединить(Ключи, ", ")));

