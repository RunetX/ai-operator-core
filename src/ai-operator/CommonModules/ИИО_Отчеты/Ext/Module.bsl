// Возвращает дату из строки ISO 8601 (2016-01-31 или 2016-01-31T00:00:00).
//
// Параметры:
//  Значение - Строка, Дата, Произвольный - Значение аргумента от модели.
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если значение не является датой.
Функция ДатаИзАргумента(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) = 10 Тогда
		Текст = Текст + "T00:00:00";
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Лев(Текст, 19));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Разбирает отборы из аргумента filters: поле должно быть среди полей отбора отчета, значение - подходить по типу.
//
// Параметры:
//  Значение - Массив из Структура, Массив из Соответствие, Неопределено - Значение аргумента filters:
//    объекты {field, op, value}. Значение другого типа дает ошибку для модели.
//  Компоновщик - КомпоновщикНастроекКомпоновкиДанных - Компоновщик варианта отчета.
//
// Возвращаемое значение:
//  Массив из Структура - Отборы:
//   * Поле - Строка - Путь к полю отбора.
//   * Оп - Строка - Код сравнения, см. КодСравнения.
//   * Значение - Произвольный - Значение или массив значений по типу поля, см. ЗначениеПоТипуПоля.
//  Структура - Ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция РазобратьОтборы(Значение, Компоновщик)

	Отборы = Новый Массив;
	Если Значение = Неопределено Тогда
		Возврат Отборы;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'filters должен быть массивом объектов {field, op, value}.'"), ПодсказкаПоОтборам());
	КонецЕсли;

	ДоступныеПоля = Компоновщик.Настройки.ДоступныеПоляОтбора;
	Для Каждого Описание Из Значение Цикл
		Поле = Строка(ИИО_ОтветКлиентСервер.Аргумент(Описание, "field", ""));
		ДоступноеПоле = ?(ПустаяСтрока(Поле), Неопределено, ДоступныеПоля.НайтиПоле(Новый ПолеКомпоновкиДанных(Поле)));
		Если ДоступноеПоле = Неопределено Или ДоступноеПоле.Папка Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'В отчете нет поля отбора «%1».'"), Поле),
				СтрШаблон(НСтр("ru = 'Поля отбора: %1.'"), ИменаПолей(ДоступныеПоля)));
		КонецЕсли;

		ЗначениеОтбора = ИИО_ОтветКлиентСервер.Аргумент(Описание, "value");
		Оп = КодСравнения(ИИО_ОтветКлиентСервер.Аргумент(Описание, "op", ""), ЗначениеОтбора);
		Если Оп = Неопределено Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Неизвестный вид сравнения в отборе по полю %1.'"), Поле), ПодсказкаПоОтборам());
		КонецЕсли;
		Если Оп = "in" Или Оп = "not_in" Тогда
			Значения = ?(ТипЗнч(ЗначениеОтбора) = Тип("Массив"), ЗначениеОтбора,
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеОтбора));
			Преобразованные = Новый Массив;
			Для Каждого Элемент Из Значения Цикл
				Преобразованный = ЗначениеПоТипуПоля(Элемент, ДоступноеПоле);
				Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Преобразованный) Тогда
					Возврат Преобразованный;
				КонецЕсли;
				Преобразованные.Добавить(Преобразованный);
			КонецЦикла;
			ЗначениеОтбора = Преобразованные;
		Иначе
			ЗначениеОтбора = ЗначениеПоТипуПоля(ЗначениеОтбора, ДоступноеПоле);
			Если ИИО_ОтветКлиентСервер.ЭтоОшибка(ЗначениеОтбора) Тогда
				Возврат ЗначениеОтбора;
			КонецЕсли;
		КонецЕсли;
		Отборы.Добавить(Новый Структура("Поле, Оп, Значение", Поле, Оп, ЗначениеОтбора));
	КонецЦикла;
	Возврат Отборы;

КонецФункции

Функция КодСравнения(Оп, Значение)

	Код = НРег(СокрЛП(Строка(Оп)));
	Если Код = "" Тогда
		Возврат ?(ТипЗнч(Значение) = Тип("Массив"), "in", "eq");
	ИначеЕсли Код = "=" Тогда
		Возврат "eq";
	ИначеЕсли Код = "<>" Или Код = "!=" Тогда
		Возврат "ne";
	ИначеЕсли СтрРазделить("eq,ne,in,not_in,in_hierarchy", ",").Найти(Код) <> Неопределено Тогда
		Возврат Код;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ВидСравнения(Оп)

	Если Оп = "ne" Тогда
		Возврат ВидСравненияКомпоновкиДанных.НеРавно;
	ИначеЕсли Оп = "in" Тогда
		Возврат ВидСравненияКомпоновкиДанных.ВСписке;
	ИначеЕсли Оп = "not_in" Тогда
		Возврат ВидСравненияКомпоновкиДанных.НеВСписке;
	ИначеЕсли Оп = "in_hierarchy" Тогда
		Возврат ВидСравненияКомпоновкиДанных.ВИерархии;
	КонецЕсли;
	Возврат ВидСравненияКомпоновкиДанных.Равно;

