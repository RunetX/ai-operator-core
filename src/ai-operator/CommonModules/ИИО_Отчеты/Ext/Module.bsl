// Штатные отчеты для модели: поиск вариантов (list_reports) и формирование (run_report).
// Отчет формируется тем же путем, что и в его форме, а модель получает значения со ссылками: цифры совпадают
// с тем, что видит пользователь, а ПДн маскируются по типу. Поддерживаемые отчеты и способ
// их формирования (адаптер) перечислены в макете ИИО_КаталогОтчетов: бухгалтерские отчеты БП выводятся
// в дерево значений, отчеты на основной схеме компоновки (УТ) формируют себя сами,
// а строки и итоги берутся из данных расшифровки.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик list_reports: варианты отчетов по словам или сведения об одном отчете.
//
// Параметры:
//  Аргументы - Структура, Соответствие - text, report, limit.
//
// Возвращаемое значение:
//  Структура - reports и truncated, сведения об отчете (см. СведенияОбОтчете) или ошибка.
Функция НайтиОтчеты(Знач Аргументы) Экспорт

	ПолноеИмя = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "report", "");
	Если ЗначениеЗаполнено(ПолноеИмя) Тогда
		Возврат СведенияОбОтчете(ПолноеИмя);
	КонецЕсли;

	Слова = СловаПоиска(Строка(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "text", "")));
	Лимит = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit"),
		ЛимитПоУмолчанию(), МаксимальныйЛимит());

	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("ПолноеИмя");
	Найденные.Колонки.Добавить("Вариант");
	Найденные.Колонки.Добавить("Наименование");
	Найденные.Колонки.Добавить("Описание");
	Найденные.Колонки.Добавить("ОписаниеОтчета");
	Найденные.Колонки.Добавить("Поддерживается");
	Найденные.Колонки.Добавить("Оценка");

	Доступные = ВариантыОтчетов.ОтчетыТекущегоПользователя();
	ДобавитьПоддерживаемые(Найденные, Слова, Доступные);
	// Без слов - только поддерживаемые: иначе модель получит сотни вариантов, данные которых получить нельзя.
	Если Слова.Количество() > 0 Тогда
		ДобавитьВариантыБСП(Найденные, Слова, Доступные);
	КонецЕсли;
	Найденные.Сортировать("Поддерживается Убыв, Оценка Убыв, Наименование");

	Список = Новый Массив;
	ЕстьПоддерживаемые = Ложь;
	ОписанныеОтчеты = Новый Соответствие;
	Для Каждого Найденный Из Найденные Цикл
		Если Список.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Элемент = Новый Структура("report, variant, name", Найденный.ПолноеИмя, Найденный.Вариант,
			Найденный.Наименование);
		// Описание отчета общее для его вариантов: модель получает его один раз, дальше - только описание варианта.
		Описание = ?(ОписанныеОтчеты.Получить(Найденный.ПолноеИмя) = Неопределено,
			СокрЛП(Найденный.ОписаниеОтчета + " " + Найденный.Описание), Найденный.Описание);
		ОписанныеОтчеты.Вставить(Найденный.ПолноеИмя, Истина);
		Если ЗначениеЗаполнено(Описание) Тогда
			Элемент.Вставить("description", ИИО_ОтветКлиентСервер.Обрезать(Описание, 300));
		КонецЕсли;
		Элемент.Вставить("supported", Найденный.Поддерживается);
		ЕстьПоддерживаемые = ЕстьПоддерживаемые Или Найденный.Поддерживается;
		Список.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура("reports, truncated", Список, Найденные.Количество() > Лимит);
	Если Список.Количество() = 0 Тогда
		Результат.Вставить("hint", НСтр("ru = 'Отчетов не найдено. Попробуй другие слова (выручка, продажи, задолженность, остатки) или вызови без text: вернутся все поддерживаемые отчеты.'"));
	ИначеЕсли Не ЕстьПоддерживаемые Тогда
		Результат.Вставить("hint", НСтр("ru = 'Среди найденных нет поддерживаемых (supported: true): их данные run_report не получит. Используй run_query.'"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет аргументы run_report и готовит формирование отчета.
//
// Параметры:
//  Аргументы - Структура, Соответствие - report, variant, period, filters, group_by, rows.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или подготовленный отчет:
//   * ПолноеИмя - Строка
//   * ИмяОтчета - Строка
//   * Адаптер - Строка - accounting или skd, см. ИИО_ОтчетыПовтИсп.Каталог.
//   * ПараметрПериода - Строка - Параметр отчета skd, в который передается период.
//   * ВидПериода - Строка - standard или date: отчету на дату передается конец периода.
//   * Вариант - Строка - Ключ варианта.
//   * НаименованиеВарианта - Строка
//   * Параметры - Соответствие - Параметры отчета из каталога.
//   * ПустыеЗначения - Соответствие - Подписи пустых значений полей строк из каталога.
//   * НачалоПериода - Дата
//   * КонецПериода - Дата
//   * Организация - СправочникСсылка.Организации, Неопределено - Отбор по организации параметром
//     бухгалтерского отчета; у отчетов skd организация - обычный отбор.
//   * Отборы - Массив из Структура - Поле, Оп, Значение.
//   * Группировки - Массив из Строка - Поля строк.
//   * Строк - Число - Сколько строк вернуть модели.
//   * Источник - Структура - source ответа.
Функция ПодготовитьФормирование(Знач Аргументы) Экспорт

	Описание = ПоддерживаемыйОтчет(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "report", ""));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Описание) Тогда
		Возврат Описание;
	КонецЕсли;
	Вариант = ВариантКаталога(Описание, ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "variant", ""));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Вариант) Тогда
		Возврат Вариант;
	КонецЕсли;
	Схема = СхемаОтчета(Описание.ИмяОтчета, Описание.Адаптер);
	Компоновщик = КомпоновщикВарианта(Схема, Вариант.Ключ);

	ЗначениеПериода = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "period");
	// Отчету на дату достаточно to: начало периода он не использует.
	Если Описание.ВидПериода = "date" И (ТипЗнч(ЗначениеПериода) = Тип("Структура")
		Или ТипЗнч(ЗначениеПериода) = Тип("Соответствие"))
		И ИИО_ОтветКлиентСервер.Аргумент(ЗначениеПериода, "from") = Неопределено
		И ИИО_ОтветКлиентСервер.Аргумент(ЗначениеПериода, "to") <> Неопределено Тогда
		ДатаОтчета = ИИО_ОтветКлиентСервер.Аргумент(ЗначениеПериода, "to");
		ЗначениеПериода = Новый Структура("from, to", ДатаОтчета, ДатаОтчета);
	КонецЕсли;
	Период = ПериодОтчета(ЗначениеПериода, , ПериодПоУмолчанию(Описание.ВидПериода));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Период) Тогда
		Возврат Период;
	КонецЕсли;
	Отборы = РазобратьОтборы(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "filters"), Компоновщик);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Отборы) Тогда
		Возврат Отборы;
	КонецЕсли;
	Группировки = РазобратьГруппировки(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "group_by"), Вариант.Группировки,
		Компоновщик);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Группировки) Тогда
		Возврат Группировки;
	КонецЕсли;

	// Организацию бухгалтерский отчет принимает параметром, как в своей форме: так же добавляются
	// обособленные подразделения и отбор по доступным организациям.
	Организация = Неопределено;
	ОтборОрганизации = Неопределено;
	Для Каждого Отбор Из Отборы Цикл
		Если Описание.Адаптер = "accounting" И Отбор.Поле = "Организация" И Отбор.Оп = "eq" Тогда
			ОтборОрганизации = Отбор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ОтборОрганизации <> Неопределено Тогда
		Организация = ОтборОрганизации.Значение;
		Отборы.Удалить(Отборы.Найти(ОтборОрганизации));
	КонецЕсли;

	МаксимумСтрок = ИИО_Настройки.Значение("ИИО_ЛимитСтрок");
	Подготовленный = Новый Структура;
	Подготовленный.Вставить("ПолноеИмя", "Отчет." + Описание.ИмяОтчета);
	Подготовленный.Вставить("ИмяОтчета", Описание.ИмяОтчета);
	Подготовленный.Вставить("Адаптер", Описание.Адаптер);
	Подготовленный.Вставить("ПараметрПериода", Описание.ПараметрПериода);
	Подготовленный.Вставить("ВидПериода", Описание.ВидПериода);
	Подготовленный.Вставить("Вариант", Вариант.Ключ);
	Подготовленный.Вставить("НаименованиеВарианта", НаименованиеВарианта(Схема, Вариант.Ключ));
	Подготовленный.Вставить("Параметры", Новый Соответствие);
	Для Каждого Параметр Из Вариант.Параметры Цикл
		Подготовленный.Параметры.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Подготовленный.Вставить("ПустыеЗначения", Новый Соответствие);
	Для Каждого ПустоеЗначение Из Описание.ПустыеЗначения Цикл
		Подготовленный.ПустыеЗначения.Вставить(ПустоеЗначение.Ключ, ПустоеЗначение.Значение);
	КонецЦикла;
	Подготовленный.Вставить("НачалоПериода", Период.Начало);
	Подготовленный.Вставить("КонецПериода", Период.Конец);
	Подготовленный.Вставить("Организация", Организация);
	Подготовленный.Вставить("Отборы", Отборы);
	Подготовленный.Вставить("Группировки", Группировки);
	Подготовленный.Вставить("Строк",
		ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "rows"),
			Мин(СтрокПоУмолчанию(), МаксимумСтрок), МаксимумСтрок));
	Подготовленный.Вставить("Источник", ИсточникДляМодели(Подготовленный, Компоновщик));
	Возврат Подготовленный;

КонецФункции

// Проверяет аргументы run_report и запускает формирование отчета в фоновом задании. Вызывается сервером
// канала бота и модулем ИИО_ОтчетыВызовСервера для канала MCP.
//
// Параметры:
//  Аргументы - Структура, Соответствие - report, variant, period, filters, group_by, rows, timeout_sec.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или см. ИИО_ФоновыеЗадания.Запустить, дополненная полем
//   * Подготовленный - см. ПодготовитьФормирование
Функция НачатьФормирование(Знач Аргументы) Экспорт

	Подготовленный = ПодготовитьФормирование(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		Возврат Подготовленный;
	КонецЕсли;
	МаксимальныйТаймаут = ИИО_Настройки.Значение("ИИО_ТаймаутЗапросаСек");
	Таймаут = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "timeout_sec"),
		МаксимальныйТаймаут, МаксимальныйТаймаут);
	Запуск = ИИО_ФоновыеЗадания.Запустить("ИИО_Отчеты.СформироватьОтчет", Подготовленный,
		НСтр("ru = 'ИИ-оператор: отчет'"), Таймаут, "report");
	Запуск.Вставить("Подготовленный", Подготовленный);
	Возврат Запуск;

КонецФункции

// Формирует отчет в фоновом задании и готовит ответ модели.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Структура:
//   * report - Строка
//   * variant - Строка
//   * columns - Массив из Структура - name, title, type: сначала поля строк, затем показатели.
//   * rows - Массив из Массив - Строки нижнего уровня со значениями всех полей строк, не больше Строк.
//   * totals - Структура - Итоги показателей по всему отчету.
//   * row_count - Число - Всего строк нижнего уровня.
//   * truncated - Булево
//   * report_ms - Число - Время формирования.
//   * run_ms - Число - Время работы задания.
//   * source - Структура
Функция СформироватьОтчет(Знач Подготовленный) Экспорт

	// Клиент отсчитывает таймаут от фактического старта задания, а не от постановки в очередь.
	ДлительныеОперации.СообщитьПрогресс(, "started");
	НачалоЗадания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Если Подготовленный.Адаптер = "skd" Тогда
		Результат = РезультатОтчетаСКД(Подготовленный);
		ВремяОтчета = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗадания;
	Иначе
		Сформированный = ДеревоБухгалтерскогоОтчета(Подготовленный);
		ВремяОтчета = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗадания;
		Результат = РезультатДляМодели(Сформированный, Подготовленный);
	КонецЕсли;
	Результат.Вставить("report_ms", ВремяОтчета);
	Результат.Вставить("source", Подготовленный.Источник);
	Результат = ИИО_Ответ.ДанныеДляМодели(Результат);
	Результат.Вставить("run_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗадания);
	Возврат Результат;

КонецФункции

// Параметры открытия формы отчета с теми же настройками и формированием при открытии.
// Бухгалтерский отчет БП открывается как расшифровка вида 2: форма загружает переданные
// пользовательские настройки, реквизиты отчета и таблицу группировок.
// Отчет skd открывается в своем варианте: период - пользовательской настройкой, отборы - параметром формы Отбор.
//
// Параметры:
//  Подготовленный - см. ПодготовитьФормирование
//
// Возвращаемое значение:
//  Структура:
//   * ИмяФормы - Строка
//   * Параметры - Структура - Параметры формы.
//   * Заголовок - Строка - Что открыто, для оповещения пользователя.
Функция ПараметрыОткрытияФормы(Знач Подготовленный) Экспорт

	МетаданныеОтчета = Метаданные.Отчеты[Подготовленный.ИмяОтчета];
	// Основной формой отчета УТ бывает общая форма БСП: по ее имени форма открывается без отчета, поэтому
	// открывается форма по умолчанию самого отчета.
	ОсновнаяФорма = МетаданныеОтчета.ОсновнаяФорма;
	ИмяФормы = ?(ОсновнаяФорма <> Неопределено И МетаданныеОтчета.Формы.Содержит(ОсновнаяФорма),
		ОсновнаяФорма.ПолноеИмя(), Подготовленный.ПолноеИмя + ".Форма");
	Заголовок = СтрШаблон("%1, %2", Подготовленный.НаименованиеВарианта, ПериодДляОписания(Подготовленный));
	Если Подготовленный.Адаптер = "skd" Тогда
		Возврат Новый Структура("ИмяФормы, Параметры, Заголовок", ИмяФормы,
			ПараметрыФормыОтчетаСКД(Подготовленный), Заголовок);
	КонецЕсли;

	Схема = СхемаОтчета(Подготовленный.ИмяОтчета, Подготовленный.Адаптер);
	Компоновщик = КомпоновщикВарианта(Схема, Подготовленный.Вариант);

	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	Свойства = ПользовательскиеНастройки.ДополнительныеСвойства;
	Свойства.Вставить("КлючВарианта", Подготовленный.Вариант);
	Свойства.Вставить("НачалоПериода", Подготовленный.НачалоПериода);
	Свойства.Вставить("КонецПериода", Подготовленный.КонецПериода);
	Если Подготовленный.Организация <> Неопределено Тогда
		Свойства.Вставить("Организация", Подготовленный.Организация);
	КонецЕсли;
	Для Каждого Параметр Из Подготовленный.Параметры Цикл
		Свойства.Вставить(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	Свойства.Вставить("ОчищатьТаблицуГруппировок", Истина);
	Группировка = Новый Массив;
	Для Каждого Поле Из Подготовленный.Группировки Цикл
		Группировка.Добавить(Новый Структура("Использование, Поле, Представление, ТипГруппировки",
			Истина, Поле, ЗаголовокПоля(Компоновщик.Настройки.ДоступныеПоляГруппировок, Поле), 0));
	КонецЦикла;
	Свойства.Вставить("Группировка", Группировка);

	Если Подготовленный.Отборы.Количество() > 0 Тогда
		Отбор = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
		Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
		ДобавитьОтборы(Отбор, Подготовленный.Отборы);
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ВидРасшифровки, ПользовательскиеНастройки, СформироватьПриОткрытии",
		2, ПользовательскиеНастройки, Истина);
	Возврат Новый Структура("ИмяФормы, Параметры, Заголовок", ИмяФормы, ПараметрыФормы, Заголовок);

КонецФункции

// Нормализованные слова для поиска отчетов: нижний регистр, «е» как «е», без коротких слов,
// длинные слова обрезаются до основы, чтобы «выручку» находила «выручка».
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Массив из Строка
Функция СловаПоиска(Текст) Экспорт

	Нормализованный = СтрЗаменить(НРег(Текст), Символ(1105), "е");
	Разделители = " ,.;:!?""'«»()[]{}/\-+*=<>№#";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		Нормализованный = СтрЗаменить(Нормализованный, Сред(Разделители, Индекс, 1), " ");
	КонецЦикла;

	Слова = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Нормализованный, " ", Ложь) Цикл
		Если СтрДлина(Слово) < 3 Тогда
			Продолжить;
		КонецЕсли;
		Основа = ?(СтрДлина(Слово) > 5, Лев(Слово, Макс(5, СтрДлина(Слово) - 2)), Слово);
		Если Слова.Найти(Основа) = Неопределено Тогда
			Слова.Добавить(Основа);
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;

КонецФункции

// Период отчета из аргумента period.
//
// Параметры:
//  Значение - Структура, Соответствие, Строка, Неопределено - {from, to}, {preset} или имя пресета.
//  ТекущаяДата - Дата, Неопределено - Дата, от которой считаются пресеты; по умолчанию дата сеанса.
//  ПоУмолчанию - Строка - Пресет, если период не задан.
//
// Возвращаемое значение:
//  Структура - Ошибка или Начало и Конец (Дата).
Функция ПериодОтчета(Значение, ТекущаяДата = Неопределено, ПоУмолчанию = "this_month") Экспорт

	Если ТекущаяДата = Неопределено Тогда
		ТекущаяДата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Значение = ПоУмолчанию;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Значение = Новый Структура("preset", Значение);
	КонецЕсли;

	Пресет = ИИО_ОтветКлиентСервер.Аргумент(Значение, "preset", "");
	Если ЗначениеЗаполнено(Пресет) Тогда
		Возврат ПериодПоПресету(Пресет, ТекущаяДата);
	КонецЕсли;

	Начало = ДатаИзАргумента(ИИО_ОтветКлиентСервер.Аргумент(Значение, "from"));
	Конец = ДатаИзАргумента(ИИО_ОтветКлиентСервер.Аргумент(Значение, "to"));
	Если Начало = Неопределено Или Конец = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'Период задан неверно: нужны from и to в формате 2016-01-31 или preset.'"),
			ПодсказкаПоПериоду());
	КонецЕсли;
	Если Начало > Конец Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'Начало периода позже конца.'"), ПодсказкаПоПериоду());
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", НачалоДня(Начало), КонецДня(Конец));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Поиск

Процедура ДобавитьПоддерживаемые(Найденные, Слова, Доступные)

	Для Каждого КлючИЗначение Из ИИО_ОтчетыПовтИсп.Каталог() Цикл
		Описание = КлючИЗначение.Значение;
		Если Не ОтчетДоступен(Описание.ИмяОтчета, Доступные) Тогда
			Продолжить;
		КонецЕсли;
		Схема = СхемаОтчета(Описание.ИмяОтчета, Описание.Адаптер);
		Синоним = Метаданные.Отчеты[Описание.ИмяОтчета].Представление();
		Для Каждого Вариант Из Описание.Варианты Цикл
			Наименование = НаименованиеВарианта(Схема, Вариант.Ключ);
			ОписаниеВарианта = СокрЛП(Описание.Описание + " " + Вариант.Описание);
			Оценка = ОценкаСовпадения(Слова,
				Наименование + " " + Синоним + " " + ОписаниеВарианта + " " + Описание.КлючевыеСлова);
			Если Слова.Количество() > 0 И Оценка = 0 Тогда
				Продолжить;
			КонецЕсли;
			Найденный = Найденные.Добавить();
			Найденный.ПолноеИмя = КлючИЗначение.Ключ;
			Найденный.Вариант = Вариант.Ключ;
			Найденный.Наименование = Наименование;
			Найденный.Описание = Вариант.Описание;
			Найденный.ОписаниеОтчета = Описание.Описание;
			Найденный.Поддерживается = Истина;
			Найденный.Оценка = Оценка;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Добавляет варианты отчетов из справочника БСП, доступные пользователю. Данные таких отчетов модель не получает,
// но видит, что отчет есть: это подсказка, что вопрос лучше решить отчетом, а не запросом.
//
// Параметры:
//  Найденные - ТаблицаЗначений - Найденные варианты, пополняется; колонки см. НайтиОтчеты.
//  Слова - Массив из Строка - Слова поиска, см. СловаПоиска.
//  Доступные - см. ВариантыОтчетов.ОтчетыТекущегоПользователя
Процедура ДобавитьВариантыБСП(Найденные, Слова, Доступные)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВариантыОтчетов.Наименование КАК Наименование,
	|	ВариантыОтчетов.КлючВарианта КАК КлючВарианта,
	|	ВЫРАЗИТЬ(ВариантыОтчетов.Отчет КАК Справочник.ИдентификаторыОбъектовМетаданных).ПолноеИмя КАК ПолноеИмя,
	|	ВЫРАЗИТЬ(ВариантыОтчетов.Отчет КАК Справочник.ИдентификаторыОбъектовМетаданных).Синоним КАК Синоним,
	|	ВариантыОтчетов.Описание КАК Описание
	|ИЗ
	|	Справочник.ВариантыОтчетов КАК ВариантыОтчетов
	|ГДЕ
	|	ВариантыОтчетов.Отчет В (&Отчеты)
	|	И ВариантыОтчетов.Отчет ССЫЛКА Справочник.ИдентификаторыОбъектовМетаданных
	|	И НЕ ВариантыОтчетов.ПометкаУдаления
	|	И ВариантыОтчетов.КлючВарианта <> """"
	|	И (НЕ ВариантыОтчетов.ТолькоДляАвтора
	|			ИЛИ ВариантыОтчетов.Автор = &Автор)";
	Запрос.УстановитьПараметр("Отчеты", Доступные);
	Запрос.УстановитьПараметр("Автор", Пользователи.АвторизованныйПользователь());
	Выборка = Запрос.Выполнить().Выбрать();

	Каталог = ИИО_ОтчетыПовтИсп.Каталог();
	Пока Выборка.Следующий() Цикл
		Если Каталог.Получить(Выборка.ПолноеИмя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Оценка = ОценкаСовпадения(Слова, Выборка.Наименование + " " + Выборка.Синоним + " " + Выборка.Описание);
		Если Оценка = 0 Тогда
			Продолжить;
		КонецЕсли;
		Найденный = Найденные.Добавить();
		Найденный.ПолноеИмя = Выборка.ПолноеИмя;
		Найденный.Вариант = Выборка.КлючВарианта;
		Найденный.Наименование = Выборка.Наименование;
		Найденный.Описание = Выборка.Описание;
		Найденный.ОписаниеОтчета = "";
		Найденный.Поддерживается = Ложь;
		Найденный.Оценка = Оценка;
	КонецЦикла;

КонецПроцедуры

// Возвращает, сколько слов поиска встречается в тексте.
//
// Параметры:
//  Слова - Массив из Строка - Слова поиска, см. СловаПоиска.
//  Текст - Строка - Наименование, синоним и описание варианта.
//
// Возвращаемое значение:
//  Число - Количество найденных слов.
Функция ОценкаСовпадения(Слова, Текст)

	Нормализованный = СтрЗаменить(НРег(Текст), Символ(1105), "е");
	Оценка = 0;
	Для Каждого Слово Из Слова Цикл
		Если СтрНайти(Нормализованный, Слово) > 0 Тогда
			Оценка = Оценка + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Оценка;

КонецФункции

// Возвращает сведения о поддерживаемом отчете: варианты, поля отборов и строк, показатели.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя отчета, например Отчет.Продажи.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка, или сведения об отчете:
//   * report - Строка - Полное имя отчета.
//   * name - Строка - Представление отчета.
//   * supported - Булево - Ложь, если данные отчета получить нельзя.
//   * hint - Строка - Подсказка модели, если отчет не поддерживается.
//   * description - Строка - Описание отчета из каталога.
//   * variants - Массив из Структура - variant, name, description, group_by.
//   * period - Структура - default, presets; у отчета на дату - еще kind: date и hint.
//   * filters - см. ОписанияПолей
//   * group_by - см. ОписанияПолей
//   * resources - см. ОписанияПолей
Функция СведенияОбОтчете(ПолноеИмя)

	ИмяОтчета = ИмяОтчета(ПолноеИмя);
	Если Метаданные.Отчеты.Найти(ИмяОтчета) = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'Отчет %1 не найден.'"), ПолноеИмя),
			НСтр("ru = 'Возьми полное имя отчета из ответа list_reports, например Отчет.Продажи.'"));
	КонецЕсли;
	Описание = ИИО_ОтчетыПовтИсп.Каталог().Получить("Отчет." + ИмяОтчета);
	Если Описание = Неопределено Тогда
		Возврат Новый Структура("report, name, supported, hint", "Отчет." + ИмяОтчета,
			Метаданные.Отчеты[ИмяОтчета].Представление(), Ложь,
			НСтр("ru = 'Данные этого отчета ИИ-оператор получить не умеет. Используй run_query.'"));
	КонецЕсли;
	Если Не ОтчетДоступен(ИмяОтчета, ВариантыОтчетов.ОтчетыТекущегоПользователя()) Тогда
		Возврат ОтчетНедоступен(ИмяОтчета);
	КонецЕсли;

	Схема = СхемаОтчета(ИмяОтчета, Описание.Адаптер);
	Варианты = Новый Массив;
	Для Каждого Вариант Из Описание.Варианты Цикл
		ОписаниеВарианта = Новый Структура("variant, name", Вариант.Ключ, НаименованиеВарианта(Схема, Вариант.Ключ));
		Если ЗначениеЗаполнено(Вариант.Описание) Тогда
			ОписаниеВарианта.Вставить("description", Вариант.Описание);
		КонецЕсли;
		ОписаниеВарианта.Вставить("group_by", Новый Массив(Вариант.Группировки));
		Варианты.Добавить(ОписаниеВарианта);
	КонецЦикла;

	Настройки = КомпоновщикВарианта(Схема, Описание.Варианты[0].Ключ).Настройки;
	Сведения = Новый Структура;
	Сведения.Вставить("report", "Отчет." + ИмяОтчета);
	Сведения.Вставить("name", Метаданные.Отчеты[ИмяОтчета].Представление());
	Сведения.Вставить("description", Описание.Описание);
	Сведения.Вставить("supported", Истина);
	Сведения.Вставить("variants", Варианты);
	Период = Новый Структура("default, presets", ПериодПоУмолчанию(Описание.ВидПериода), ПресетыПериода());
	Если Описание.ВидПериода = "date" Тогда
		Период.Вставить("kind", "date");
		Период.Вставить("hint", НСтр("ru = 'Отчет на дату: берется конец периода, например {""to"": ""2016-03-31""} или {""preset"": ""today""}.'"));
	КонецЕсли;
	Сведения.Вставить("period", Период);
	Сведения.Вставить("filters", ОписанияПолей(Настройки.ДоступныеПоляОтбора, Ложь, Настройки.ДоступныеПоляВыбора));
	Сведения.Вставить("group_by", ОписанияПолей(Настройки.ДоступныеПоляГруппировок, Ложь));
	Сведения.Вставить("resources", ОписанияПолей(Настройки.ДоступныеПоляВыбора, Истина));
	Возврат Сведения;

КонецФункции

// Возвращает поля верхнего уровня: имя, заголовок и тип. Показатели отчета (ресурсы) в полях отбора
// не нужны модели: отбор по сумме в отчете не делают.
//
// Параметры:
//  ДоступныеПоля - ДоступныеПоляКомпоновкиДанных - Поля отбора, группировок или выбора.
//  ТолькоРесурсы - Булево - Истина - только показатели, Ложь - только поля, которые не являются показателями.
//  ПоляВыбора - ДоступныеПоляКомпоновкиДанных, Неопределено - Поля выбора: поле, которое в них является
//    показателем, пропускается.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * field - Строка - Путь к полю.
//   * title - Строка - Заголовок поля.
//   * type - Строка - Представление типа, см. ИИО_Метаданные.ПредставлениеТипа.
Функция ОписанияПолей(ДоступныеПоля, ТолькоРесурсы, ПоляВыбора = Неопределено)

	Описания = Новый Массив;
	Для Каждого ДоступноеПоле Из ДоступныеПоля.Элементы Цикл
		Если ДоступноеПоле.Папка Или ДоступноеПоле.Ресурс <> ТолькоРесурсы Тогда
			Продолжить;
		КонецЕсли;
		ПолеВыбора = ?(ПоляВыбора = Неопределено, Неопределено, ПоляВыбора.НайтиПоле(ДоступноеПоле.Поле));
		Если ПолеВыбора <> Неопределено И ПолеВыбора.Ресурс Тогда
			Продолжить;
		КонецЕсли;
		Описания.Добавить(Новый Структура("field, title, type", Строка(ДоступноеПоле.Поле), ДоступноеПоле.Заголовок,
			ИИО_Метаданные.ПредставлениеТипа(ДоступноеПоле.ТипЗначения)));
	КонецЦикла;
	Возврат Описания;

КонецФункции

#КонецОбласти

#Область Подготовка

// Возвращает описание поддерживаемого отчета из каталога, если он доступен пользователю.
//
// Параметры:
//  ПолноеИмя - Произвольный - Значение аргумента report: ожидается полное имя отчета, например Отчет.Продажи.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
//  ФиксированнаяСтруктура - Описание отчета, значение элемента ИИО_ОтчетыПовтИсп.Каталог.
Функция ПоддерживаемыйОтчет(ПолноеИмя)

	Если ТипЗнч(ПолноеИмя) <> Тип("Строка") Или ПустаяСтрока(ПолноеИмя) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не задан отчет report.'"),
			НСтр("ru = 'Найди отчет через list_reports и передай его report, например Отчет.Продажи.'"));
	КонецЕсли;
	ИмяОтчета = ИмяОтчета(ПолноеИмя);
	Описание = ИИО_ОтчетыПовтИсп.Каталог().Получить("Отчет." + ИмяОтчета);
	Если Описание = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'Отчет %1 не поддерживается для получения данных.'"), ПолноеИмя),
			НСтр("ru = 'Поддерживаемые отчеты вернет list_reports без text. Для остальных вопросов используй run_query.'"));
	КонецЕсли;
	Если Не ОтчетДоступен(ИмяОтчета, ВариантыОтчетов.ОтчетыТекущегоПользователя()) Тогда
		Возврат ОтчетНедоступен(ИмяОтчета);
	КонецЕсли;
	Возврат Описание;

КонецФункции

Функция ВариантКаталога(Описание, Ключ)

	Если Не ЗначениеЗаполнено(Ключ) Тогда
		Возврат Описание.Варианты[0];
	КонецЕсли;
	Ключи = Новый Массив;
	Для Каждого Вариант Из Описание.Варианты Цикл
		Если Вариант.Ключ = Ключ Тогда
			Возврат Вариант;
		КонецЕсли;
