// Настройки ИИ-оператора: константы ИИО_* и значения по умолчанию для незаполненных.

#Область СлужебныйПрограммныйИнтерфейс

// Значение настройки. Для незаполненной константы - значение по умолчанию.
//
// Параметры:
//  Имя - Строка - Имя константы, см. ЗначенияПоУмолчанию.
//
// Возвращаемое значение:
//  Число, Строка
Функция Значение(Имя) Экспорт

	Значение = Константы[Имя].Получить();
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ЗначенияПоУмолчанию()[Имя]);

КонецФункции

// Параметры запуска MCP-сервера для команды «Запустить ИИ-оператор».
//
// Возвращаемое значение:
//  Структура:
//   * Порт - Число
//   * ТаймаутСек - Число
//   * Имя, Версия, Заголовок, Описание, Инструкции - Строка - Сведения о сервере для initialize.
Функция ПараметрыЗапуска() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Порт", Значение("ИИО_ПортMCP"));
	Параметры.Вставить("ТаймаутСек", Значение("ИИО_ТаймаутСервераСек"));
	Параметры.Вставить("Имя", "1c-ai-operator");
	Параметры.Вставить("Версия", ВерсияРасширения());
	Параметры.Вставить("Заголовок", НСтр("ru = 'ИИ-оператор 1С'"));
	Параметры.Вставить("Описание", СтрШаблон(
		НСтр("ru = 'Инструменты для работы с информационной базой %1 %2 в сеансе пользователя'"),
		Метаданные.Синоним, Метаданные.Версия));
	Инструкции = ИИО_РеестрИнструментовВызовСервера.ОписанияИнструментов().Получить("instructions");
	Параметры.Вставить("Инструкции", ?(Инструкции = Неопределено, "", Инструкции));
	Возврат Параметры;

КонецФункции

// Версия расширения ИИОператор. Совпадает со свойством «Версия» в Configuration.xml:
// РасширенияКонфигурации.Получить требует административных прав, которых у пользователя нет.
//
// Возвращаемое значение:
//  Строка
Функция ВерсияРасширения() Экспорт

	Возврат "0.1.16.0";

КонецФункции

// Уровень контракта ядра с пакетами: модуль <Префикс>_СостояниеПакета, регистрация инструментов и действий.
// Растет только при несовместимом изменении контракта. Пакет объявляет свой уровень функцией ВерсияКонтрактаЯдра,
// установщик сверяет его по manifest.json релиза, форма состояния - по модулю пакета.
//
// Возвращаемое значение:
//  Число
Функция ВерсияКонтрактаПакетов() Экспорт

	Возврат 1;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначенияПоУмолчанию()

	Значения = Новый Структура;
	Значения.Вставить("ИИО_ПортMCP", 9874);
	Значения.Вставить("ИИО_ТаймаутСервераСек", 900);
	Значения.Вставить("ИИО_ТаймаутЗапросаСек", 30);
	Значения.Вставить("ИИО_ЛимитСтрок", 200);
	Значения.Вставить("ИИО_СрокПредпросмотраСек", 120);
	Значения.Вставить("ИИО_ОжиданиеОчередиСек", 120);
	Значения.Вставить("ИИО_МаксДлинаЗапроса", 20000);
	Значения.Вставить("ИИО_ЛимитОбъектовДействия", 200);
	Значения.Вставить("ИИО_СрокХраненияДиалоговЧас", 24);
	Значения.Вставить("ИИО_СрокХраненияЖурналаОбменаДней", 90);
	Значения.Вставить("ИИО_СтрогийРежимМаскирования", Ложь);
	Значения.Вставить("ИИО_АдресМодели", "");
	Значения.Вставить("ИИО_ИмяМодели", "");
	Значения.Вставить("ИИО_ТаймаутМоделиСек", 180);
	Значения.Вставить("ИИО_ШагиАгента", 8);
	Значения.Вставить("ИИО_ДлинаИстории", 20);
	Значения.Вставить("ИИО_АдресМоделиМаскирования", "");
	Значения.Вставить("ИИО_ИмяМоделиМаскирования", "");
	Возврат Значения;

КонецФункции

#КонецОбласти
