// Инструмент related_objects: документы-основания и подчиненные документы одного уровня.
// Состав связей - критерий отбора СвязанныеДокументы БСП, по нему строит дерево штатная «Структура подчиненности».
// Если критерия в конфигурации нет (ЗУП), связи ищутся по реквизитам документов со ссылкой на документ.

#Область СлужебныйПрограммныйИнтерфейс

// Связанные документы одного уровня.
//
// Параметры:
//  Аргументы - Структура, Соответствие - ref, limit.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * object - Структура - Документ {ref, presentation}.
//   * parents - Массив из Структура - Документы из реквизитов объекта: object, via, date, posted, deleted.
//   * children - Массив из Структура - Документы, которые ссылаются на объект, в том же виде.
//   * truncated - Булево - Показаны не все основания или подчиненные.
//   * source - Структура - object и method: откуда взяты связи.
Функция СвязанныеОбъекты(Знач Аргументы) Экспорт

	Открытие = ИИО_Показ.ПодготовитьОткрытие(
		Новый Структура("ref", ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "ref")));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Открытие) Тогда
		Возврат Открытие;
	КонецЕсли;
	Ссылка = Открытие.Ссылка;
	Если Не Метаданные.Документы.Содержит(Ссылка.Метаданные()) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Связи ищутся только у документов, а %1 - не документ.'"),
				Ссылка.Метаданные().ПолноеИмя()),
			НСтр("ru = 'Документы по справочнику найди запросом run_query с отбором по его реквизиту.'"));
	КонецЕсли;
	Лимит = ИИО_ОтветКлиентСервер.ЦелыйАргумент(Аргументы, "limit", ЛимитПоУмолчанию(), МаксимальныйЛимит());

	Критерий = Метаданные.КритерииОтбора.Найти("СвязанныеДокументы");
	Состав = СоставСвязей(Критерий);
	Основания = Основания(Ссылка, Состав);
	Подчиненные = Подчиненные(Ссылка, Состав, Лимит);

	Результат = Новый Структура;
	Результат.Вставить("object", Ссылка);
	Результат.Вставить("parents", ОписанияДокументов(Основания, Лимит));
	Результат.Вставить("children", ОписанияДокументов(Подчиненные, Лимит));
	Результат.Вставить("truncated", Основания.Количество() > Лимит Или Подчиненные.Количество() > Лимит);
	Результат.Вставить("source", Новый Структура("object, method", Ссылка.Метаданные().ПолноеИмя(),
		?(Критерий = Неопределено, НСтр("ru = 'ссылки на документы в реквизитах документов'"),
			НСтр("ru = 'критерий отбора «Связанные документы», как в «Структуре подчиненности»'"))));
	Возврат ИИО_Ответ.ДанныеДляМодели(Результат);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реквизиты шапки и табличных частей документов, через которые документы связаны.
//
// Параметры:
//  Критерий - ОбъектМетаданных, Неопределено - Критерий отбора СвязанныеДокументы;
//    Неопределено, если его нет в конфигурации.
//
// Возвращаемое значение:
//  Массив из ОбъектМетаданных - Реквизиты документов.
Функция СоставСвязей(Критерий)

	Состав = Новый Массив;
	Если Критерий <> Неопределено Тогда
		Для Каждого Реквизит Из Критерий.Состав Цикл
			Если Метаданные.Документы.Содержит(ДокументРеквизита(Реквизит)) Тогда
				Состав.Добавить(Реквизит);
			КонецЕсли;
		КонецЦикла;
		Возврат Состав;
	КонецЕсли;

	ТипыДокументов = Документы.ТипВсеСсылки();
	Для Каждого Документ Из Метаданные.Документы Цикл
		ДобавитьСсылкиНаДокументы(Состав, Документ.Реквизиты, ТипыДокументов);
		Для Каждого ТабличнаяЧасть Из Документ.ТабличныеЧасти Цикл
			ДобавитьСсылкиНаДокументы(Состав, ТабличнаяЧасть.Реквизиты, ТипыДокументов);
		КонецЦикла;
	КонецЦикла;
	Возврат Состав;

КонецФункции

Процедура ДобавитьСсылкиНаДокументы(Состав, Реквизиты, ТипыДокументов)

	Для Каждого Реквизит Из Реквизиты Цикл
		Для Каждого Тип Из Реквизит.Тип.Типы() Цикл
			Если ТипыДокументов.СодержитТип(Тип) Тогда
				Состав.Добавить(Реквизит);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Документы из реквизитов объекта, входящих в состав связей.
//
// Параметры:
//  Ссылка - ДокументСсылка
//  Состав - см. СоставСвязей
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Через.
Функция Основания(Ссылка, Состав)

	ОбъектМетаданных = Ссылка.Метаданные();
	ПоТаблицам = Новый Соответствие;
	Таблицы = Новый Массив;
	Для Каждого Реквизит Из Состав Цикл
		Если ДокументРеквизита(Реквизит) <> ОбъектМетаданных Тогда
			Продолжить;
		КонецЕсли;
		ИмяТаблицы = ИмяТаблицыРеквизита(Реквизит);
		Если ПоТаблицам.Получить(ИмяТаблицы) = Неопределено Тогда
			ПоТаблицам.Вставить(ИмяТаблицы, Новый Массив);
			Таблицы.Добавить(ИмяТаблицы);
		КонецЕсли;
		ПоТаблицам.Получить(ИмяТаблицы).Добавить(Реквизит);
	КонецЦикла;

	Найденные = НоваяТаблицаСвязей();
	ТипыДокументов = Документы.ТипВсеСсылки();
	Для Каждого ИмяТаблицы Из Таблицы Цикл
		Поля = Новый Массив;
		Для Каждого Реквизит Из ПоТаблицам.Получить(ИмяТаблицы) Цикл
			Поля.Добавить("ДанныеОбъекта." + Реквизит.Имя + " КАК " + Реквизит.Имя);
		КонецЦикла;
		// Объект уже проверен на чтение с учетом RLS: читаются только его собственные реквизиты.
		Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК ДанныеОбъекта ГДЕ ДанныеОбъекта.Ссылка = &Ссылка",
			СтрСоединить(Поля, ", "), ИмяТаблицы));
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого Реквизит Из ПоТаблицам.Получить(ИмяТаблицы) Цикл
				Значение = Выборка[Реквизит.Имя];
				Если Не ЗначениеЗаполнено(Значение) Или Значение = Ссылка
					Или Не ТипыДокументов.СодержитТип(ТипЗнч(Значение)) Тогда
					Продолжить;
				КонецЕсли;
				Если Найденные.Найти(Значение, "Ссылка") = Неопределено Тогда
					Строка = Найденные.Добавить();
					Строка.Ссылка = Значение;
					Строка.Через = ПутьРеквизита(Реквизит);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат ДоступныеДокументы(Найденные);

КонецФункции

// Документы, реквизит которых из состава связей ссылается на объект. Из каждой таблицы - не больше Лимит + 1.
//
// Параметры:
//  Ссылка - ДокументСсылка
//  Состав - см. СоставСвязей
//  Лимит - Число - Сколько документов показать модели.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Ссылка, Через, Дата, Проведен, ПометкаУдаления.
Функция Подчиненные(Ссылка, Состав, Лимит)

	Части = Новый Массив;
	Для Каждого Реквизит Из Состав Цикл
		Если Не Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
			Продолжить;
		КонецЕсли;
		Документ = ДокументРеквизита(Реквизит);
		Если Не ПравоДоступа("Чтение", Документ) Или Не ПравоДоступа("Просмотр", Документ) Тогда
			Продолжить;
		КонецЕсли;
		ИмяТаблицы = ИмяТаблицыРеквизита(Реквизит);
		ЭтоШапка = ИмяТаблицы = Документ.ПолноеИмя();
		// РАЗРЕШЕННЫЕ в объединении указывается только в первом запросе и действует на весь запрос.
		Части.Добавить(СтрШаблон("ВЫБРАТЬ %1РАЗЛИЧНЫЕ ПЕРВЫЕ %2
			|	Подчиненные.Ссылка КАК Ссылка, %3Дата КАК Дата, %3Проведен КАК Проведен, %3ПометкаУдаления КАК ПометкаУдаления,
			|	ВЫРАЗИТЬ(""%4"" КАК СТРОКА(200)) КАК Через
			|ИЗ %5 КАК Подчиненные
			|ГДЕ Подчиненные.%6 = &Ссылка И Подчиненные.Ссылка <> &Ссылка",
			?(Части.Количество() = 0, "РАЗРЕШЕННЫЕ ", ""), Формат(Лимит + 1, "ЧГ=0"),
			?(ЭтоШапка, "Подчиненные.", "Подчиненные.Ссылка."),
			ПутьРеквизита(Реквизит), ИмяТаблицы, Реквизит.Имя));
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Возврат НоваяТаблицаСвязей();
	КонецЕсли;

	Запрос = Новый Запрос(СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Найденные = Запрос.Выполнить().Выгрузить();
	Найденные.Сортировать("Дата, Через");
	// Документ, связанный через несколько реквизитов, показывается один раз - по первому.
	Результат = НоваяТаблицаСвязей();
	Показанные = Новый Соответствие;
	Для Каждого Строка Из Найденные Цикл
		Если Показанные.Получить(Строка.Ссылка) = Неопределено Тогда
			Показанные.Вставить(Строка.Ссылка, Истина);
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оставляет документы, которые пользователь может прочитать (RLS) и просмотреть, и добавляет их дату и состояние.
//
// Параметры:
//  Найденные - ТаблицаЗначений - Найденные документы, колонки см. НоваяТаблицаСвязей.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Доступные документы, отсортированные по дате, колонки см. НоваяТаблицаСвязей.
Функция ДоступныеДокументы(Найденные)

	ПоВидам = Новый Соответствие;
	Виды = Новый Массив;
	Для Каждого Строка Из Найденные Цикл
		Документ = Строка.Ссылка.Метаданные();
		Если Не ПравоДоступа("Чтение", Документ) Или Не ПравоДоступа("Просмотр", Документ) Тогда
			Продолжить;
		КонецЕсли;
		Если ПоВидам.Получить(Документ.ПолноеИмя()) = Неопределено Тогда
			ПоВидам.Вставить(Документ.ПолноеИмя(), Новый Массив);
			Виды.Добавить(Документ.ПолноеИмя());
		КонецЕсли;
		ПоВидам.Получить(Документ.ПолноеИмя()).Добавить(Строка.Ссылка);
	КонецЦикла;

	Результат = НоваяТаблицаСвязей();
	Для Каждого ПолноеИмя Из Виды Цикл
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ Документы.Ссылка КАК Ссылка, Документы.Дата КАК Дата, Документы.Проведен КАК Проведен,
			|	Документы.ПометкаУдаления КАК ПометкаУдаления
			|ИЗ %1 КАК Документы ГДЕ Документы.Ссылка В (&Ссылки)", ПолноеИмя));
		Запрос.УстановитьПараметр("Ссылки", ПоВидам.Получить(ПолноеИмя));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строка = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Выборка);
			Строка.Через = Найденные.Найти(Выборка.Ссылка, "Ссылка").Через;
		КонецЦикла;
	КонецЦикла;
	Результат.Сортировать("Дата, Через");
	Возврат Результат;

КонецФункции

Функция ОписанияДокументов(Таблица, Лимит)

	Описания = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Если Описания.Количество() >= Лимит Тогда
			Прервать;
		КонецЕсли;
		Описание = Новый Структура("object, via, date, posted",
			Строка.Ссылка, Строка.Через, Строка.Дата, Строка.Проведен);
		Если Строка.ПометкаУдаления Тогда
			Описание.Вставить("deleted", Истина);
		КонецЕсли;
		Описания.Добавить(Описание);
	КонецЦикла;
	Возврат Описания;

КонецФункции

Функция НоваяТаблицаСвязей()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ссылка", Документы.ТипВсеСсылки());
	Таблица.Колонки.Добавить("Через", Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;

КонецФункции

// Документ, которому принадлежит реквизит шапки или табличной части.
//
// Параметры:
//  Реквизит - ОбъектМетаданных - Реквизит шапки или табличной части.
//
// Возвращаемое значение:
//  ОбъектМетаданных - Документ; для реквизита другого объекта - не документ, это проверяет вызывающий код.
Функция ДокументРеквизита(Реквизит)

	Владелец = Реквизит.Родитель();
	Если Метаданные.Документы.Содержит(Владелец) Тогда
		Возврат Владелец;
	КонецЕсли;
	Возврат Владелец.Родитель();

КонецФункции

// Таблица запроса: Документ.Имя для реквизита шапки, Документ.Имя.ТабличнаяЧасть для реквизита табличной части.
//
// Параметры:
//  Реквизит - ОбъектМетаданных - Реквизит шапки или табличной части документа.
//
// Возвращаемое значение:
//  Строка
Функция ИмяТаблицыРеквизита(Реквизит)

	Владелец = Реквизит.Родитель();
	Если Метаданные.Документы.Содержит(Владелец) Тогда
		Возврат Владелец.ПолноеИмя();
	КонецЕсли;
	Возврат Владелец.Родитель().ПолноеИмя() + "." + Владелец.Имя;

КонецФункции

// Реквизит связи для модели: ДокументОснование или Товары.ДокументОприходования.
//
// Параметры:
//  Реквизит - ОбъектМетаданных - Реквизит шапки или табличной части документа.
//
// Возвращаемое значение:
//  Строка
Функция ПутьРеквизита(Реквизит)

	Владелец = Реквизит.Родитель();
	Если Метаданные.Документы.Содержит(Владелец) Тогда
		Возврат Реквизит.Имя;
	КонецЕсли;
	Возврат Владелец.Имя + "." + Реквизит.Имя;

КонецФункции

Функция ЛимитПоУмолчанию()

	Возврат 20;

КонецФункции

Функция МаксимальныйЛимит()

	Возврат 100;

КонецФункции

#КонецОбласти
