// Токены маскирования ПДн. Словарь хранится только в памяти клиентского сеанса:
// одно и то же значение в пределах сеанса всегда получает один и тот же токен вида [ФИО#3].

#Область СлужебныйПрограммныйИнтерфейс

// Заменяет ПДн в ответе токенами в два прохода.
// 1. Помеченное сервером: ссылка {"ref", "presentation", "pii"} сохраняет ref, а представление заменяется токеном;
//    значение {"pii", "value"} заменяется токеном целиком. Ключ pii_context - ПДн, которые могут встретиться
//    в тексте ответа (например, в ошибке проведения): они только пополняют словарь и модели не уходят.
// 2. Свободный текст в любых строках, кроме ref: значения из словаря сеанса (ФИО еще и в виде «Фамилия И.О.»)
//    и шаблоны - ИНН из 12 цифр, телефон, СНИЛС, паспорт, email.
//
// Параметры:
//  Данные - Произвольный - Ответ инструмента.
//
// Возвращаемое значение:
//  Произвольный - Копия данных с токенами вместо ПДн.
Функция Замаскировать(Данные) Экспорт

	Результат = ЗаменитьПомеченное(Данные);
	Строки = Новый Массив;
	СобратьСтроки(Результат, Строки);
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Замены = ЗаменыСловаря(СтрСоединить(Строки, Символы.ПС));
	Возврат ЗамаскироватьТексты(Результат, Замены);

КонецФункции

// Заменяет ПДн токенами в одной строке: значения из словаря сеанса и шаблоны.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
Функция ЗамаскироватьТекст(Текст) Экспорт

	Возврат ЗамаскироватьТексты(Текст, ЗаменыСловаря(Текст));

КонецФункции

// Заменяет токены в аргументах от модели исходными значениями, в том числе внутри строк.
//
// Параметры:
//  Данные - Произвольный - Аргументы вызова.
//
// Возвращаемое значение:
//  Произвольный - Копия аргументов без токенов.
Функция Демаскировать(Данные) Экспорт

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Строка") Тогда
		Возврат ДемаскироватьСтроку(Данные);
	ИначеЕсли Тип = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, Демаскировать(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, Демаскировать(КлючИЗначение.Значение));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(Демаскировать(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Данные;

КонецФункции

// Очищает словарь токенов сеанса. Токены, выданные модели раньше, перестают раскрываться.
Процедура Сбросить() Экспорт

	ПараметрыПриложения.Удалить(ИмяСловаря());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Помеченное

Функция ЗаменитьПомеченное(Данные)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Структура") Тогда
		Если Данные.Свойство("pii") Тогда
			Возврат ЗамаскироватьПомеченное(Данные.pii, Данные);
		КонецЕсли;
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Данные Цикл
			Значение = ЗаменитьПомеченное(КлючИЗначение.Значение);
			Если НРег(КлючИЗначение.Ключ) <> КлючКонтекста() Тогда
				Результат.Вставить(КлючИЗначение.Ключ, Значение);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Соответствие") Тогда
		Если Данные.Получить("pii") <> Неопределено Тогда
			Возврат ЗамаскироватьПомеченное(Данные.Получить("pii"), СтруктураИзСоответствия(Данные));
		КонецЕсли;
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Данные Цикл
			Значение = ЗаменитьПомеченное(КлючИЗначение.Значение);
			Если НРег(КлючИЗначение.Ключ) <> КлючКонтекста() Тогда
				Результат.Вставить(КлючИЗначение.Ключ, Значение);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(ЗаменитьПомеченное(Элемент));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ЗамаскироватьПомеченное(ВидПДн, Поля)

	Если Поля.Свойство("presentation") И Поля.Свойство("ref") Тогда
		Результат = Новый Структура("ref, presentation", Поля.ref,
			Токен(ВидПДн, "ref:" + Поля.ref, Строка(Поля.presentation)));
		Возврат Результат;
	КонецЕсли;
	Значение = Неопределено;
	Поля.Свойство("value", Значение);
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Токен(ВидПДн, "value:" + ВидПДн + ":" + Строка(Значение), Значение);

КонецФункции

Функция СтруктураИзСоответствия(Данные)

	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Данные Цикл
		Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючКонтекста()

	Возврат "pii_context";

КонецФункции

#КонецОбласти

#Область СвободныйТекст

// Собирает строки ответа, кроме идентификаторов ссылок.
//
// Параметры:
//  Данные - Произвольный - ответ инструмента или его часть: строка, структура, соответствие, массив.
//  Строки - Массив из Строка - найденные строки, пополняется.
Процедура СобратьСтроки(Данные, Строки)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Строка") Тогда
		Строки.Добавить(Данные);
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Данные Цикл
			Если НРег(КлючИЗначение.Ключ) <> "ref" Тогда
				СобратьСтроки(КлючИЗначение.Значение, Строки);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Для Каждого Элемент Из Данные Цикл
			СобратьСтроки(Элемент, Строки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ЗамаскироватьТексты(Данные, Замены)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Строка") Тогда
		Возврат ЗамаскироватьСтроку(Данные, Замены);
	ИначеЕсли Тип = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ?(НРег(КлючИЗначение.Ключ) = "ref", КлючИЗначение.Значение,
				ЗамаскироватьТексты(КлючИЗначение.Значение, Замены)));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, ?(НРег(КлючИЗначение.Ключ) = "ref", КлючИЗначение.Значение,
				ЗамаскироватьТексты(КлючИЗначение.Значение, Замены)));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(ЗамаскироватьТексты(Элемент, Замены));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	Возврат Данные;

КонецФункции

Функция ЗамаскироватьСтроку(Текст, Замены)

	// Токен целиком уже замаскирован.
	Если Словарь().Исходные.Получить(Текст) <> Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Результат = Текст;
	Для Каждого Замена Из Замены Цикл
		Если СтрНайти(Результат, Замена.Искомое) > 0 Тогда
			Результат = ЗаменитьЦелыеВхождения(Результат, Замена.Искомое, Замена.Токен);
		КонецЕсли;
	КонецЦикла;
	Возврат ЗаменитьШаблоны(Результат);

КонецФункции

// Возвращает варианты значений из словаря сеанса, которые встречаются в тексте, от длинных к коротким:
// длинное значение («Иванов Иван Иванович») заменяется раньше своей части («Иванов»).
//
// Параметры:
//  Текст - Строка - текст, в котором ищутся значения.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Искомое - Строка
//   * Токен - Строка
//   * ПервоеСлово - Строка
Функция ЗаменыСловаря(Текст)

	Слова = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить(Текст, РазделителиСлов(), Ложь) Цикл
		Слова.Вставить(Слово, Истина);
	КонецЦикла;
	ПоДлине = Новый Соответствие;
	НаибольшаяДлина = 0;
	Для Каждого Вариант Из Словарь().Варианты Цикл
		Если Слова.Получить(Вариант.ПервоеСлово) = Неопределено Или СтрНайти(Текст, Вариант.Искомое) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Длина = СтрДлина(Вариант.Искомое);
		Группа = ПоДлине.Получить(Длина);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			ПоДлине.Вставить(Длина, Группа);
		КонецЕсли;
		Группа.Добавить(Вариант);
		НаибольшаяДлина = Макс(НаибольшаяДлина, Длина);
	КонецЦикла;

	Замены = Новый Массив;
	Длина = НаибольшаяДлина;
	Пока Длина > 0 Цикл
		Группа = ПоДлине.Получить(Длина);
		Если Группа <> Неопределено Тогда
			Для Каждого Вариант Из Группа Цикл
				Замены.Добавить(Вариант);
			КонецЦикла;
		КонецЕсли;
		Длина = Длина - 1;
	КонецЦикла;
	Возврат Замены;

КонецФункции

// Заменяет вхождения, не являющиеся частью другого слова: «Иванов» не заменяется в «Ивановка».
//
// Параметры:
//  Текст - Строка
//  Искомое - Строка
//  Замена - Строка - токен, которым заменяется вхождение.
//
// Возвращаемое значение:
//  Строка - текст после замены.
Функция ЗаменитьЦелыеВхождения(Текст, Искомое, Замена)

	ДлинаТекста = СтрДлина(Текст);
	ДлинаИскомого = СтрДлина(Искомое);
	ПроверятьНачало = ЭтоБукваИлиЦифра(Лев(Искомое, 1));
	ПроверятьКонец = ЭтоБукваИлиЦифра(Прав(Искомое, 1));
	Результат = "";
	Хвост = 1;
	Позиция = СтрНайти(Текст, Искомое);
	Пока Позиция > 0 Цикл
		Конец = Позиция + ДлинаИскомого - 1;
		Если (Не ПроверятьНачало Или Позиция = 1 Или Не ЭтоБукваИлиЦифра(Сред(Текст, Позиция - 1, 1)))
			И (Не ПроверятьКонец Или Конец = ДлинаТекста Или Не ЭтоБукваИлиЦифра(Сред(Текст, Конец + 1, 1))) Тогда
			Результат = Результат + Сред(Текст, Хвост, Позиция - Хвост) + Замена;
			Хвост = Конец + 1;
			Позиция = Конец;
		КонецЕсли;
		Если Позиция >= ДлинаТекста Тогда
			Прервать;
		КонецЕсли;
		Позиция = СтрНайти(Текст, Искомое, НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;
	Возврат ?(Хвост = 1, Текст, Результат + Сред(Текст, Хвост));

КонецФункции

// Возвращает варианты значения для поиска в тексте: само значение,
// а для ФИО еще «Фамилия И.О.», «И.О. Фамилия» и фамилия.
//
// Параметры:
//  ВидПДн - Строка - вид ПДн, например ФИО.
//  Исходное - Произвольный - исходное значение: варианты строятся только для строки.
//
// Возвращаемое значение:
//  Массив из Строка - варианты длиной от 4 символов без повторов.
Функция ВариантыЗначения(ВидПДн, Исходное)

	Варианты = Новый Массив;
	Если ТипЗнч(Исходное) <> Тип("Строка") Тогда
		Возврат Варианты;
	КонецЕсли;
	Значение = СокрЛП(Исходное);
	ДобавитьВариант(Варианты, Значение);
	Слова = СтрРазделить(Значение, " ", Ложь);
	Если ВидПДн <> "ФИО" Или Слова.Количество() < 2 Или Слова.Количество() > 3 Тогда
		Возврат Варианты;
	КонецЕсли;
	Для Каждого Слово Из Слова Цикл
		Если Не ЭтоБуква(Лев(Слово, 1)) Тогда
			Возврат Варианты;
		КонецЕсли;
	КонецЦикла;
	Фамилия = Слова[0];
	Инициалы = Лев(Слова[1], 1) + ".";
	ИнициалыСПробелом = Инициалы;
	Если Слова.Количество() = 3 Тогда
		Инициалы = Инициалы + Лев(Слова[2], 1) + ".";
		ИнициалыСПробелом = ИнициалыСПробелом + " " + Лев(Слова[2], 1) + ".";
	КонецЕсли;
	ДобавитьВариант(Варианты, Фамилия + " " + Инициалы);
	ДобавитьВариант(Варианты, Фамилия + " " + ИнициалыСПробелом);
	ДобавитьВариант(Варианты, Инициалы + " " + Фамилия);
	ДобавитьВариант(Варианты, ИнициалыСПробелом + " " + Фамилия);
	ДобавитьВариант(Варианты, Фамилия);
	Возврат Варианты;

КонецФункции

Процедура ДобавитьВариант(Варианты, Вариант)

	Если СтрДлина(Вариант) >= 4 И Варианты.Найти(Вариант) = Неопределено Тогда
		Варианты.Добавить(Вариант);
	КонецЕсли;

КонецПроцедуры

Функция РазделителиСлов()

	Возврат " ,.;:!?()[]{}""'«»/\|<>+=*&^%$#@~`-" + Символ(8211) + Символ(8212)
		+ Символы.ПС + Символы.ВК + Символы.Таб + Символы.НПП;

КонецФункции

#КонецОбласти

#Область Шаблоны

// Заменяет токенами адреса почты и номера с ПДн в свободном тексте.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка - текст с токенами вместо ПДн.
Функция ЗаменитьШаблоны(Текст)

	Если СтрНайти(Текст, "@") > 0 Тогда
		Текст = ЗаменитьАдресаПочты(Текст);
	КонецЕсли;
	Если ЕстьЦифры(Текст) Тогда
		Текст = ЗаменитьНомера(Текст);
	КонецЕсли;
	Возврат Текст;

КонецФункции

Функция ЗаменитьАдресаПочты(Текст)

	Длина = СтрДлина(Текст);
	Результат = "";
	Хвост = 1;
	Позиция = СтрНайти(Текст, "@");
	Пока Позиция > 0 Цикл
		Начало = Позиция;
		Пока Начало > Хвост И ЭтоСимволАдреса(Сред(Текст, Начало - 1, 1)) Цикл
			Начало = Начало - 1;
		КонецЦикла;
		Конец = Позиция;
		Пока Конец < Длина И ЭтоСимволАдреса(Сред(Текст, Конец + 1, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		// Точка после адреса - конец предложения, а не часть домена.
		Пока Конец > Позиция И Сред(Текст, Конец, 1) = "." Цикл
			Конец = Конец - 1;
		КонецЦикла;
		Если Начало < Позиция И СтрНайти(Сред(Текст, Позиция + 2, Конец - Позиция - 1), ".") > 0 Тогда
			Адрес = Сред(Текст, Начало, Конец - Начало + 1);
			Результат = Результат + Сред(Текст, Хвост, Начало - Хвост)
				+ Токен("Email", "value:Email:" + НРег(Адрес), Адрес);
			Хвост = Конец + 1;
		КонецЕсли;
		Следующая = Макс(Конец, Позиция) + 1;
		Позиция = ?(Следующая > Длина, 0, СтрНайти(Текст, "@", НаправлениеПоиска.СНачала, Следующая));
	КонецЦикла;
	Возврат ?(Хвост = 1, Текст, Результат + Сред(Текст, Хвост));

КонецФункции

// Заменяет токенами номера с ПДн в тексте.
// Последовательности цифр с разделителями (пробел, дефис, скобки) проверяются как телефон, СНИЛС, паспорт
// или ИНН физлица. ИНН из 10 цифр принадлежит юрлицу и остается открытым. УИД ссылок и пакетов пропускается.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка - текст с токенами вместо номеров с ПДн.
Функция ЗаменитьНомера(Текст)

	Длина = СтрДлина(Текст);
	Результат = "";
	Хвост = 1;
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЭтоНачалоУИД(Текст, Позиция, Длина) Тогда
			Позиция = Позиция + 36;
			Продолжить;
		КонецЕсли;
		Если Не ЭтоЦифра(Символ) И Не (Символ = "+" И Позиция < Длина И ЭтоЦифра(Сред(Текст, Позиция + 1, 1))) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Группы = ГруппыЦифр(Текст, Позиция, Длина);
		Для Каждого Совпадение Из СовпаденияНомера(Текст, Позиция, Группы) Цикл
			Исходное = Сред(Текст, Совпадение.Начало, Совпадение.Конец - Совпадение.Начало + 1);
			Результат = Результат + Сред(Текст, Хвост, Совпадение.Начало - Хвост)
				+ Токен(Совпадение.Вид, "value:" + Совпадение.Вид + ":" + Исходное, Исходное);
			Хвост = Совпадение.Конец + 1;
		КонецЦикла;
		Позиция = Группы[Группы.ВГраница()].Конец + 1;
	КонецЦикла;
	Возврат ?(Хвост = 1, Текст, Результат + Сред(Текст, Хвост));

КонецФункции

// Возвращает группы цифр, разделенные одним-двумя символами из « -()», начиная с позиции (цифра или «+»).
//
// Параметры:
//  Текст - Строка
//  Начало - Число - позиция первой цифры или знака «+».
//  Длина - Число - длина текста.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Число
//   * Конец - Число
//   * Цифры - Строка
Функция ГруппыЦифр(Текст, Начало, Длина)

	Группы = Новый Массив;
	Позиция = ?(Сред(Текст, Начало, 1) = "+", Начало + 1, Начало);
	Пока Истина Цикл
		НачалоГруппы = Позиция;
		Пока Позиция <= Длина И ЭтоЦифра(Сред(Текст, Позиция, 1)) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Группы.Добавить(Новый Структура("Начало, Конец, Цифры", НачалоГруппы, Позиция - 1,
			Сред(Текст, НачалоГруппы, Позиция - НачалоГруппы)));
		Разделителей = 0;
		Пока Разделителей < 2 И Позиция + Разделителей <= Длина
			И СтрНайти(РазделителиНомера(), Сред(Текст, Позиция + Разделителей, 1)) > 0 Цикл
			Разделителей = Разделителей + 1;
		КонецЦикла;
		Если Разделителей = 0 Или Позиция + Разделителей > Длина
			Или Не ЭтоЦифра(Сред(Текст, Позиция + Разделителей, 1)) Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + Разделителей;
	КонецЦикла;
	Возврат Группы;

КонецФункции

// Возвращает совпадения с ПДн: номер целиком или, если целиком он не похож на ПДн, отдельные группы.
// «ИНН 500100732259 770101001» склеивается в одну последовательность, но ИНН физлица в ней все равно находится.
//
// Параметры:
//  Текст - Строка
//  Начало - Число - позиция начала номера (цифра или «+»).
//  Группы - см. ГруппыЦифр
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Начало - Число - позиция первого символа совпадения.
//   * Конец - Число - позиция последнего символа совпадения.
//   * Вид - Строка - вид ПДн, см. ВидНомера.
Функция СовпаденияНомера(Текст, Начало, Группы)

	Совпадения = Новый Массив;
	Цифры = "";
	Длины = Новый Массив;
	ТолькоПробелы = Истина;
	Для Индекс = 0 По Группы.ВГраница() Цикл
		Цифры = Цифры + Группы[Индекс].Цифры;
		Длины.Добавить(СтрДлина(Группы[Индекс].Цифры));
		Если Индекс > 0 Тогда
			Разделитель = Сред(Текст, Группы[Индекс - 1].Конец + 1,
				Группы[Индекс].Начало - Группы[Индекс - 1].Конец - 1);
			ТолькоПробелы = ТолькоПробелы И СокрЛП(СтрЗаменить(Разделитель, Символы.НПП, " ")) = "";
		КонецЕсли;
	КонецЦикла;
	Конец = Группы[Группы.ВГраница()].Конец;
	ЕстьПлюс = (Сред(Текст, Начало, 1) = "+");
	ЕстьСкобка = СтрНайти(Сред(Текст, Начало, Конец - Начало + 1), "(") > 0
		Или (Начало > 1 И Сред(Текст, Начало - 1, 1) = "(");

	Вид = ВидНомера(Цифры, Длины, ЕстьПлюс, ЕстьСкобка, ТолькоПробелы);
	Если Вид <> "" Тогда
		Совпадения.Добавить(Новый Структура("Начало, Конец, Вид", Начало, Конец, Вид));
		Возврат Совпадения;
	КонецЕсли;
	Если Группы.Количество() > 1 Тогда
		Для Каждого Группа Из Группы Цикл
			Вид = ВидНомера(Группа.Цифры, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СтрДлина(Группа.Цифры)),
				Ложь, Ложь, Истина);
			Если Вид <> "" Тогда
				Совпадения.Добавить(Новый Структура("Начало, Конец, Вид", Группа.Начало, Группа.Конец, Вид));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Совпадения;

КонецФункции

// Возвращает вид ПДн номера по числу цифр и их группировке.
// Номера с «00» в начале - служебные (номера документов, коды): ИНН, паспорт и телефон так не начинаются.
//
// Параметры:
//  Цифры - Строка - все цифры номера подряд.
//  Длины - Массив из Число - число цифр в каждой группе.
//  ЕстьПлюс - Булево - номер начинается с «+».
//  ЕстьСкобка - Булево - в номере или перед ним есть «(».
//  ТолькоПробелы - Булево - группы разделены только пробелами.
//
// Возвращаемое значение:
//  Строка - ИНН, СНИЛС, Паспорт, Телефон или пустая строка, если номер не похож на ПДн.
Функция ВидНомера(Цифры, Длины, ЕстьПлюс, ЕстьСкобка, ТолькоПробелы)

	Количество = СтрДлина(Цифры);
	Форма = СтрСоединить(Длины, "-");
	Первая = Лев(Цифры, 1);
	Если Лев(Цифры, 2) = "00" Тогда
		Возврат "";
	ИначеЕсли ЕстьПлюс Тогда
		Возврат ?(Количество >= 11 И Количество <= 13, "Телефон", "");
	ИначеЕсли Количество = 12 И Длины.Количество() = 1 Тогда
		Возврат "ИНН";
	ИначеЕсли Количество = 11 Тогда
		Если Форма = "3-3-3-2" Тогда
			Возврат "СНИЛС";
		ИначеЕсли Длины.Количество() = 1 Тогда
			Возврат ?(Первая = "7" Или Первая = "8", "Телефон", "СНИЛС");
		ИначеЕсли (Первая = "7" Или Первая = "8") И Не ГруппыПоТри(Длины) Тогда
			Возврат "Телефон";
		КонецЕсли;
	ИначеЕсли Количество = 10 Тогда
		Если ЕстьСкобка Или Форма = "3-3-2-2" Тогда
			Возврат "Телефон";
		ИначеЕсли ТолькоПробелы И (Форма = "2-2-6" Или Форма = "4-6") Тогда
			Возврат "Паспорт";
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

// Проверяет группировку суммы по разрядам («78 901 234 567»): все группы после первой из трех цифр.
//
// Параметры:
//  Длины - Массив из Число - число цифр в каждой группе.
//
// Возвращаемое значение:
//  Булево - Истина, если групп больше одной и все группы после первой из трех цифр.
Функция ГруппыПоТри(Длины)

	Для Индекс = 1 По Длины.ВГраница() Цикл
		Если Длины[Индекс] <> 3 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Длины.Количество() > 1;

КонецФункции

Функция ЭтоНачалоУИД(Текст, Позиция, Длина)

	Если Позиция + 35 > Длина Или СтрНайти(ШестнадцатеричныеЦифры(), Сред(Текст, Позиция, 1)) = 0 Тогда
		Возврат Ложь;
	ИначеЕсли Позиция > 1 И ЭтоБукваИлиЦифра(Сред(Текст, Позиция - 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Смещение = 0 По 35 Цикл
		Символ = Сред(Текст, Позиция + Смещение, 1);
		Если Смещение = 8 Или Смещение = 13 Или Смещение = 18 Или Смещение = 23 Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли СтрНайти(ШестнадцатеричныеЦифры(), Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ЕстьЦифры(Текст)

	Для Цифра = 0 По 9 Цикл
		Если СтрНайти(Текст, Строка(Цифра)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат Символ <> "" И СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоБуква(Символ)

	Возврат ВРег(Символ) <> НРег(Символ);

КонецФункции

Функция ЭтоБукваИлиЦифра(Символ)

	Возврат ЭтоБуква(Символ) Или ЭтоЦифра(Символ);

КонецФункции

Функция ЭтоСимволАдреса(Символ)

	Возврат ЭтоБукваИлиЦифра(Символ) Или (Символ <> "" И СтрНайти("._%+-", Символ) > 0);

КонецФункции

Функция РазделителиНомера()

	Возврат " -()" + Символы.НПП;

КонецФункции

Функция ШестнадцатеричныеЦифры()

	Возврат "0123456789abcdefABCDEF";

КонецФункции

#КонецОбласти

#Область Словарь

// Возвращает токен для значения: один и тот же ключ в сеансе всегда дает один и тот же токен.
// Ссылка и строка с ее представлением (Контрагент и Контрагент.Наименование) получают общий токен,
// чтобы модель видела одного человека, а не двух.
//
// Параметры:
//  ВидПДн - Строка - вид ПДн, например ФИО или ИНН.
//  Ключ - Строка - ключ значения в словаре: "ref:" + ссылка или "value:" + вид + ":" + значение.
//  Исходное - Произвольный - исходное значение, которое вернет демаскирование токена.
//
// Возвращаемое значение:
//  Строка - токен вида [ФИО#3].
Функция Токен(ВидПДн, Ключ, Исходное)

	СловарьСеанса = Словарь();
	ВыданныйТокен = СловарьСеанса.ПоКлючу.Получить(Ключ);
	Если ВыданныйТокен <> Неопределено Тогда
		Возврат ВыданныйТокен;
	КонецЕсли;
	КлючЗначения = "value:" + ВидПДн + ":" + Строка(Исходное);
	ВыданныйТокен = СловарьСеанса.ПоКлючу.Получить(КлючЗначения);
	Если ВыданныйТокен <> Неопределено Тогда
		СловарьСеанса.ПоКлючу.Вставить(Ключ, ВыданныйТокен);
		Возврат ВыданныйТокен;
	КонецЕсли;

	Номер = ?(СловарьСеанса.Счетчики.Получить(ВидПДн) = Неопределено, 0, СловарьСеанса.Счетчики.Получить(ВидПДн)) + 1;
	СловарьСеанса.Счетчики.Вставить(ВидПДн, Номер);
	ВыданныйТокен = СтрШаблон("[%1#%2]", ВидПДн, Формат(Номер, "ЧГ=0"));
	СловарьСеанса.ПоКлючу.Вставить(Ключ, ВыданныйТокен);
	СловарьСеанса.ПоКлючу.Вставить(КлючЗначения, ВыданныйТокен);
	СловарьСеанса.Исходные.Вставить(ВыданныйТокен, Исходное);
	Для Каждого Вариант Из ВариантыЗначения(ВидПДн, Исходное) Цикл
		Слова = СтрРазделить(Вариант, РазделителиСлов(), Ложь);
		Если Слова.Количество() > 0 Тогда
			СловарьСеанса.Варианты.Добавить(Новый Структура("Искомое, Токен, ПервоеСлово",
				Вариант, ВыданныйТокен, Слова[0]));
		КонецЕсли;
	КонецЦикла;
	Возврат ВыданныйТокен;

КонецФункции

Функция ДемаскироватьСтроку(Текст)

	Если СтрНайти(Текст, "[") = 0 Или СтрНайти(Текст, "#") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Исходные = Словарь().Исходные;

	// Токен целиком: возвращаем исходное значение с его типом (например, дату рождения).
	Исходное = Исходные.Получить(Текст);
	Если Исходное <> Неопределено Тогда
		Возврат Исходное;
	КонецЕсли;

	Результат = "";
	Остаток = Текст;
	Начало = СтрНайти(Остаток, "[");
	Пока Начало > 0 Цикл
		Конец = СтрНайти(Остаток, "]", , Начало);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Кандидат = Сред(Остаток, Начало, Конец - Начало + 1);
		Исходное = Исходные.Получить(Кандидат);
		Результат = Результат + Лев(Остаток, Начало - 1) + ?(Исходное = Неопределено, Кандидат, Строка(Исходное));
		Остаток = Сред(Остаток, Конец + 1);
		Начало = СтрНайти(Остаток, "[");
	КонецЦикла;
	Возврат Результат + Остаток;

КонецФункции

// Словарь токенов сеанса.
//
// Возвращаемое значение:
//  Структура:
//   * ПоКлючу - Соответствие - Ключ значения и токен.
//   * Исходные - Соответствие - Токен и исходное значение.
//   * Счетчики - Соответствие - Вид ПДн и последний номер токена.
//   * Варианты - Массив из Структура - Строки для поиска в свободном тексте: Искомое, Токен, ПервоеСлово.
Функция Словарь()

	СловарьСеанса = ПараметрыПриложения.Получить(ИмяСловаря());
	Если СловарьСеанса = Неопределено Тогда
		СловарьСеанса = Новый Структура("ПоКлючу, Исходные, Счетчики, Варианты",
			Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Массив);
		ПараметрыПриложения.Вставить(ИмяСловаря(), СловарьСеанса);
	КонецЕсли;
	Возврат СловарьСеанса;

КонецФункции

Функция ИмяСловаря()

	Возврат "ИИО.СловарьМаскирования";

КонецФункции

#КонецОбласти

#КонецОбласти
