// Токены маскирования ПДн канала MCP. Словарь хранится только в памяти клиентского сеанса:
// одно и то же значение в пределах сеанса всегда получает один и тот же токен вида [ФИО#3].
// Алгоритм - в ИИО_МаскированиеКлиентСервер.

#Область СлужебныйПрограммныйИнтерфейс

// Заменяет ПДн в ответе токенами словаря сеанса, см. ИИО_МаскированиеКлиентСервер.Замаскировать.
//
// Параметры:
//  Данные - Произвольный - Ответ инструмента.
//
// Возвращаемое значение:
//  Произвольный - Копия данных с токенами вместо ПДн.
Функция Замаскировать(Данные) Экспорт

	Возврат ИИО_МаскированиеКлиентСервер.Замаскировать(Данные, Словарь());

КонецФункции

// Заменяет ПДн токенами в одной строке: значения из словаря сеанса и шаблоны.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
Функция ЗамаскироватьТекст(Текст) Экспорт

	Возврат ИИО_МаскированиеКлиентСервер.ЗамаскироватьТекст(Текст, Словарь());

КонецФункции

// Заменяет токены в аргументах от модели исходными значениями, в том числе внутри строк.
//
// Параметры:
//  Данные - Произвольный - Аргументы вызова.
//
// Возвращаемое значение:
//  Произвольный - Копия аргументов без токенов.
Функция Демаскировать(Данные) Экспорт

	Возврат ИИО_МаскированиеКлиентСервер.Демаскировать(Данные, Словарь());

КонецФункции

// Очищает словарь токенов сеанса. Токены, выданные модели раньше, перестают раскрываться.
Процедура Сбросить() Экспорт

	ПараметрыПриложения.Удалить(ИмяСловаря());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Словарь токенов сеанса.
//
// Возвращаемое значение:
//  см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
Функция Словарь()

	СловарьСеанса = ПараметрыПриложения.Получить(ИмяСловаря());
	Если СловарьСеанса = Неопределено Тогда
		СловарьСеанса = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
		ПараметрыПриложения.Вставить(ИмяСловаря(), СловарьСеанса);
	КонецЕсли;
	Возврат СловарьСеанса;

КонецФункции

Функция ИмяСловаря()

	Возврат "ИИО.СловарьМаскирования";

КонецФункции

#КонецОбласти
