// Инструмент run_query: проверка и доработка запроса модели, выполнение в фоне, ответ для модели.

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет запрос модели и готовит его к выполнению.
// Во все выборки пакета добавляется РАЗРЕШЕННЫЕ, в каждую часть итоговой выборки - ПЕРВЫЕ Лимит+1.
// Для каждой колонки итоговой выборки определяется вид ПДн по полям, из которых она получена.
//
// Параметры:
//  Текст - Строка - Текст запроса от модели.
//  ЗначенияПараметров - Структура, Соответствие, Неопределено - Значения параметров из JSON.
//  Лимит - Число - Сколько строк вернуть модели.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели (см. ИИО_ОтветКлиентСервер.Ошибка) или подготовленный запрос:
//   * Текст - Строка - Текст запроса для выполнения.
//   * Параметры - Соответствие из КлючИЗначение - Имя параметра и значение 1С.
//   * ИндексРезультата - Число - Индекс запроса пакета, результат которого получает модель.
//   * ВидыПДнКолонок - Массив из Строка - Вид ПДн колонки результата или пустая строка.
//   * Лимит - Число
//   * ТекстМодели - Строка - Исходный текст для source.
//   * Предупреждения - Массив из Структура - code и message признаков тихой ошибки, см. ДобавитьПредупреждения
Функция ПодготовитьЗапрос(Знач Текст, Знач ЗначенияПараметров, Знач Лимит) Экспорт

	МаксимальнаяДлина = ИИО_Настройки.Значение("ИИО_МаксДлинаЗапроса");
	Если СтрДлина(Текст) > МаксимальнаяДлина Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Текст запроса длиннее %1 символов.'"), Формат(МаксимальнаяДлина, "ЧГ=0")),
			НСтр("ru = 'Упрости запрос или раздели задачу на несколько запросов.'"));
	КонецЕсли;

	Схема = Новый СхемаЗапроса;
	Попытка
		Схема.УстановитьТекстЗапроса(Текст);
	Исключение
		// Модели нужен технический текст платформы с местом ошибки {(строка, колонка)} и маркером <<?>>:
		// по нему она исправляет свой запрос. Сообщение для пользователя эти подробности скрывает.
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Подсказка = НСтр("ru = 'Исправь запрос: место ошибки отмечено {(строка, колонка)} и маркером <<?>>. Точные имена объектов и полей дает describe_metadata.'");
		Уточнение = ПодсказкаКОшибке(Текст);
		Возврат ИИО_ОтветКлиентСервер.Ошибка("QUERY_SYNTAX", ТекстОшибки,
			?(ПустаяСтрока(Уточнение), Подсказка, Уточнение + " " + Подсказка));
	КонецПопытки;

	Предупреждения = Новый Массив;
	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		Если ТипЗнч(ЗапросПакета) = Тип("ЗапросВыбораСхемыЗапроса") Тогда
			ДобавитьПредупреждения(Предупреждения, ЗапросПакета, Текст);
		КонецЕсли;
	КонецЦикла;

	ИндексРезультата = Неопределено;
	ВидыРезультата = Неопределено;
	ИтоговаяВыборка = Неопределено;
	ВременныеТаблицы = Новый Соответствие;
	Индекс = -1;
	Для Каждого ЗапросПакета Из Схема.ПакетЗапросов Цикл
		Индекс = Индекс + 1;
		// Кроме выборок в пакете бывает только УНИЧТОЖИТЬ для временных таблиц: язык запросов данные не меняет.
		Если ТипЗнч(ЗапросПакета) <> Тип("ЗапросВыбораСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		ЗапросПакета.ВыбиратьРазрешенные = Истина;
		ВидыКолонок = ВидыПДнКолонок(ЗапросПакета, ВременныеТаблицы);
		Если ЗначениеЗаполнено(ЗапросПакета.ТаблицаДляПомещения) Тогда
			ВременныеТаблицы.Вставить(НРег(ЗапросПакета.ТаблицаДляПомещения),
				ВидыПоИменамКолонок(ЗапросПакета, ВидыКолонок));
		Иначе
			ИндексРезультата = Индекс;
			ВидыРезультата = ВидыКолонок;
			ИтоговаяВыборка = ЗапросПакета;
		КонецЕсли;
	КонецЦикла;

	Если ИтоговаяВыборка = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'В запросе нет выборки, результат которой можно вернуть: все выборки помещаются во временные таблицы.'"),
			НСтр("ru = 'Добавь в конец пакета выборку без ПОМЕСТИТЬ.'"));
	КонецЕсли;

	// ПЕРВЫЕ в объединении действует только на свою часть, поэтому ограничение ставится на каждую часть.
	Для Каждого Оператор Из ИтоговаяВыборка.Операторы Цикл
		Если Оператор.КоличествоПолучаемыхЗаписей = Неопределено
			Или Оператор.КоличествоПолучаемыхЗаписей > Лимит + 1 Тогда
			Оператор.КоличествоПолучаемыхЗаписей = Лимит + 1;
		КонецЕсли;
	КонецЦикла;

	ТекстЗапроса = Схема.ПолучитьТекстЗапроса();
	Параметры = ПараметрыЗапроса(ТекстЗапроса, ЗначенияПараметров);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Параметры) Тогда
		Возврат Параметры;
	КонецЕсли;

	Подготовленный = Новый Структура;
	Подготовленный.Вставить("Текст", ТекстЗапроса);
	Подготовленный.Вставить("Параметры", Параметры);
	Подготовленный.Вставить("ИндексРезультата", ИндексРезультата);
	Подготовленный.Вставить("ВидыПДнКолонок", ВидыРезультата);
	Подготовленный.Вставить("Лимит", Лимит);
	Подготовленный.Вставить("ТекстМодели", Текст);
	Подготовленный.Вставить("Предупреждения", Предупреждения);
	Возврат Подготовленный;

КонецФункции

// Выполняет подготовленный запрос и собирает ответ для модели. Вызывается в фоновом задании.
//
// Параметры:
//  Подготовленный - см. ПодготовитьЗапрос
//
// Возвращаемое значение:
//  Структура:
//   * columns - Массив из Структура - name и type колонок.
//   * rows - Массив из Массив - Строки результата, не больше лимита.
//   * truncated - Булево - Строк больше лимита.
//   * query_ms - Число - Время выполнения запроса.
//   * run_ms - Число - Время работы задания: запрос и подготовка ответа.
//   * source - Структура - query: текст запроса модели.
//   * warnings - Массив из Структура - code и message, если запрос похож на тихую ошибку (план 3в.6).
Функция ВыполнитьЗапрос(Знач Подготовленный) Экспорт

	// Клиент отсчитывает таймаут от фактического старта задания, а не от постановки в очередь.
	ДлительныеОперации.СообщитьПрогресс(, "started");
	НачалоЗадания = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Выгрузка = ВыгрузкаВБезопасномРежиме(Подготовленный);
	ВремяЗапроса = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗадания;

	Колонки = Новый Массив;
	Для Каждого Колонка Из Выгрузка.Колонки Цикл
		Колонки.Добавить(Новый Структура("name, type", Колонка.Имя,
			ИИО_Метаданные.ПредставлениеТипа(Новый ОписаниеТипов(Колонка.ТипЗначения, , "Null"))));
	КонецЦикла;

	ВидыПДн = Подготовленный.ВидыПДнКолонок;
	ЧислоКолонок = Выгрузка.Колонки.Количество();
	Строки = Новый Массив;
	Для Каждого СтрокаВыгрузки Из Выгрузка Цикл
		Если Строки.Количество() >= Подготовленный.Лимит Тогда
			Прервать;
		КонецЕсли;
		Значения = Новый Массив;
		Для ИндексКолонки = 0 По ЧислоКолонок - 1 Цикл
			Значения.Добавить(ЗначениеКолонки(СтрокаВыгрузки[ИндексКолонки], ВидыПДн[ИндексКолонки]));
		КонецЦикла;
		Строки.Добавить(Значения);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("truncated", Выгрузка.Количество() > Подготовленный.Лимит);
	Результат.Вставить("query_ms", ВремяЗапроса);
	Результат.Вставить("source", Новый Структура("query", Подготовленный.ТекстМодели));
	Результат = ИИО_Ответ.ДанныеДляМодели(Результат);
	// В предупреждениях только имена таблиц и полей и литералы запроса модели - маскировать нечего.
	Если Подготовленный.Предупреждения.Количество() > 0 Тогда
		Результат.Вставить("warnings", Подготовленный.Предупреждения);
	КонецЕсли;
	Результат.Вставить("run_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗадания);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Выполнение

// Выполняет подготовленный запрос в безопасном режиме и возвращает результат итоговой выборки.
// Безопасный режим действует до выхода из функции, в которой установлен, поэтому запрос выполняется отдельно
// от подготовки ответа.
//
// Параметры:
//  Подготовленный - см. ПодготовитьЗапрос
//
// Возвращаемое значение:
//  ТаблицаЗначений - выгрузка результата запроса пакета с индексом ИндексРезультата.
Функция ВыгрузкаВБезопасномРежиме(Подготовленный)

	УстановитьБезопасныйРежим(Истина);
	Запрос = Новый Запрос(Подготовленный.Текст);
	Для Каждого КлючИЗначение Из Подготовленный.Параметры Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Запрос.ВыполнитьПакет()[Подготовленный.ИндексРезультата].Выгрузить();

КонецФункции

// Возвращает значение колонки для ответа модели.
// Значение колонки с ПДн помечается для клиентского ядра, которое заменит его токеном.
// Ссылки маскирует ИИО_Ответ по виду объекта, числа и булевы значения ПДн не считаются.
//
// Параметры:
//  Значение - Произвольный - значение колонки результата запроса.
//  ВидПДн - Строка - вид ПДн колонки или пустая строка.
//
// Возвращаемое значение:
//  - Произвольный - исходное значение, если колонка без ПДн или значение не строка и не дата.
//  - Структура - значение с пометкой ПДн, см. ИИО_Ответ.ЗначениеСПДн
Функция ЗначениеКолонки(Значение, ВидПДн)

	Если Не ЗначениеЗаполнено(ВидПДн) Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Строка") Или Тип = Тип("Дата") Тогда
		Возврат ИИО_Ответ.ЗначениеСПДн(Значение, ВидПДн);
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область Параметры

// Возвращает значения параметров запроса из JSON: ссылки строкой ПолноеИмя:УИД или {"ref": ...},
// даты ISO 8601, списки массивами.
//
// Параметры:
//  ТекстЗапроса - Строка - текст запроса, параметры которого заполняются.
//  ЗначенияПараметров - Структура, Соответствие, Неопределено - значения параметров из JSON.
//
// Возвращаемое значение:
//  - Соответствие из КлючИЗначение - имя параметра и значение 1С.
//  - Структура - ошибка для модели, см. ИИО_ОтветКлиентСервер.Ошибка
Функция ПараметрыЗапроса(ТекстЗапроса, ЗначенияПараметров)

	Переданные = Новый Соответствие;
	Если ТипЗнч(ЗначенияПараметров) = Тип("Структура") Или ТипЗнч(ЗначенияПараметров) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из ЗначенияПараметров Цикл
			Имя = КлючИЗначение.Ключ;
			Если СтрНачинаетсяС(Имя, "&") Тогда
				Имя = Сред(Имя, 2);
			КонецЕсли;
			Переданные.Вставить(НРег(Имя), КлючИЗначение.Значение);
		КонецЦикла;
	ИначеЕсли ЗначенияПараметров <> Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'params должен быть объектом: имя параметра без & и значение.'"));
	КонецЕсли;

	Параметры = Новый Соответствие;
	НеЗаданы = Новый Массив;
	Запрос = Новый Запрос(ТекстЗапроса);
	Для Каждого ОписаниеПараметра Из Запрос.НайтиПараметры() Цикл
		Если Переданные.Получить(НРег(ОписаниеПараметра.Имя)) = Неопределено Тогда
			ПредставлениеТипа = ИИО_Метаданные.ПредставлениеТипа(ОписаниеПараметра.ТипЗначения);
			НеЗаданы.Добавить("&" + ОписаниеПараметра.Имя
				+ ?(ПустаяСтрока(ПредставлениеТипа), "", " (" + ПредставлениеТипа + ")"));
			Продолжить;
		КонецЕсли;
		Попытка
			Значение = ЗначениеПараметра(Переданные.Получить(НРег(ОписаниеПараметра.Имя)),
				ОписаниеПараметра.ТипЗначения);
		Исключение
			// Технический текст платформы - для модели, чтобы она исправила значение параметра.
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(НСтр("ru = 'Параметр &%1: %2'"), ОписаниеПараметра.Имя,
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке())),
				НСтр("ru = 'Даты передавай в ISO 8601 (2025-01-31), ссылки - строкой ref из ответов инструментов, списки - массивами.'"));
		КонецПопытки;
		Параметры.Вставить(ОписаниеПараметра.Имя, Значение);
	КонецЦикла;

	Если НеЗаданы.Количество() > 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Не заданы параметры запроса: %1.'"), СтрСоединить(НеЗаданы, ", ")),
			НСтр("ru = 'Передай значения в params: {""Имя"": значение}, без &.'"));
	КонецЕсли;
	Возврат Параметры;

КонецФункции

Функция ЗначениеПараметра(Значение, ТипЗначения)

	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Массив") Тогда
		Список = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеПараметра(Элемент, ТипЗначения));
		КонецЦикла;
		Возврат Список;
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		// Ссылка в виде, в котором ее вернул инструмент: {"ref": ..., "presentation": ...}.
		Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Значение, "ref");
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Идентификатор);
		Если Ссылка = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'объект без ref не является ссылкой'");
		КонецЕсли;
		Возврат Ссылка;
	ИначеЕсли Тип = Тип("Строка") Тогда
		Ссылка = ИИО_Ответ.СсылкаИзСтроки(Значение);
		Если Ссылка <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
		// Тип параметра платформа выводит из выражения, где он используется; если вывести не смогла, типов нет.
		ТипНеизвестен = (ТипЗначения.Типы().Количество() = 0);
		Если ТипНеизвестен Или ТипЗначения.СодержитТип(Тип("Строка")) Тогда
			Возврат ?(ТипНеизвестен И ЭтоДатаISO(Значение), ДатаISO(Значение), Значение);
		ИначеЕсли ТипЗначения.СодержитТип(Тип("Дата")) И ЭтоДатаISO(Значение) Тогда
			Возврат ДатаISO(Значение);
		КонецЕсли;
		ВызватьИсключение СтрШаблон(НСтр("ru = 'ожидается %1'"), ИИО_Метаданные.ПредставлениеТипа(ТипЗначения));
	ИначеЕсли Значение = Неопределено Тогда
		Возврат Null;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Проверяет, что строка - дата в формате ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс.
//
// Параметры:
//  Строка - Строка - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина, если строка соответствует одному из этих форматов.
Функция ЭтоДатаISO(Строка)

	Длина = СтрДлина(Строка);
	Если Длина <> 10 И Длина <> 19 Тогда
		Возврат Ложь;
	КонецЕсли;
	Шаблон = Лев("0000-00-00T00:00:00", Длина);
	Для Позиция = 1 По Длина Цикл
		СимволШаблона = Сред(Шаблон, Позиция, 1);
		Символ = Сред(Строка, Позиция, 1);
		Если СимволШаблона = "0" Тогда
			Если СтрНайти("0123456789", Символ) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Символ <> СимволШаблона Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ДатаISO(Строка)

	Возврат XMLЗначение(Тип("Дата"), ?(СтрДлина(Строка) = 10, Строка + "T00:00:00", Строка));

КонецФункции

#КонецОбласти

#Область ПДнКолонок

// Возвращает вид ПДн каждой колонки выборки: по всем полям, из которых колонка получена
// во всех частях объединения.
//
// Параметры:
//  ЗапросВыбора - ЗапросВыбораСхемыЗапроса
//  ВременныеТаблицы - Соответствие из КлючИЗначение - виды ПДн колонок временных таблиц пакета:
//   * Ключ - Строка - имя временной таблицы в нижнем регистре.
//   * Значение - см. ВидыПоИменамКолонок
//
// Возвращаемое значение:
//  Массив из Строка - вид ПДн колонки или пустая строка, в порядке колонок выборки.
Функция ВидыПДнКолонок(ЗапросВыбора, ВременныеТаблицы)

	Виды = Новый Массив;
	Операторы = ЗапросВыбора.Операторы;
	Для Каждого Колонка Из ЗапросВыбора.Колонки Цикл
		Вид = "";
		Для ИндексОператора = 0 По Колонка.Поля.Количество() - 1 Цикл
			Выражение = Колонка.Поля.Получить(ИндексОператора);
			Если Выражение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Вид = ИИО_Маскирование.ОбъединитьВидыПДн(Вид,
				ВидПДнВыражения(Строка(Выражение), Операторы.Получить(ИндексОператора), ВременныеТаблицы));
		КонецЦикла;
		Виды.Добавить(Вид);
	КонецЦикла;
	Возврат Виды;

КонецФункции

Функция ВидыПоИменамКолонок(ЗапросВыбора, Виды)

	Результат = Новый Соответствие;
	Индекс = 0;
	Для Каждого Колонка Из ЗапросВыбора.Колонки Цикл
		Результат.Вставить(НРег(Колонка.Псевдоним), Виды[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает вид ПДн выражения поля выборки.
// Выражение содержит ПДн, если любая его цепочка «Псевдоним.Поле…» ведет к полю с ПДн
// или к ссылке на объект с ПДн (например, ПРЕДСТАВЛЕНИЕ(Т.Контрагент)).
//
// Параметры:
//  Выражение - Строка - текст выражения.
//  Оператор - ОператорВыбратьСхемыЗапроса - часть объединения, в которой вычисляется выражение.
//  ВременныеТаблицы - Соответствие из КлючИЗначение - виды ПДн колонок временных таблиц, см. ВидыПДнКолонок.
//
// Возвращаемое значение:
//  Строка - вид ПДн или пустая строка.
Функция ВидПДнВыражения(Выражение, Оператор, ВременныеТаблицы)

	Вид = "";
	Для Каждого Цепочка Из ЦепочкиПолей(Выражение) Цикл
		Если Цепочка.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Источник = ИсточникПоПсевдониму(Оператор, Цепочка[0]);
		// Цепочка не от источника - это тип в ВЫРАЗИТЬ или значение в ЗНАЧЕНИЕ(), а не поле.
		Если Источник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид = ИИО_Маскирование.ОбъединитьВидыПДн(Вид, ВидПДнЦепочки(Источник, Цепочка, ВременныеТаблицы));
	КонецЦикла;
	Возврат Вид;

КонецФункции

Функция ИсточникПоПсевдониму(Оператор, Псевдоним)

	Для Каждого ИсточникОператора Из Оператор.Источники Цикл
		Если НРег(ИсточникОператора.Источник.Псевдоним) = НРег(Псевдоним) Тогда
			Возврат ИсточникОператора.Источник;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Проходит цепочку по доступным полям источника и возвращает вид ПДн, к которому она ведет.
// Для составных ссылок (субконто, регистратор) поле проверяется во всех объектах типа.
// Поле, которое не удалось найти, считается ПДн.
//
// Параметры:
//  Источник - ТаблицаСхемыЗапроса, ВременнаяТаблицаСхемыЗапроса, ВложенныйЗапросСхемыЗапроса - источник,
//    к которому относится первый элемент цепочки.
//  Цепочка - Массив из Строка - псевдоним источника и имена полей, см. ЦепочкиПолей.
//  ВременныеТаблицы - Соответствие из КлючИЗначение - виды ПДн колонок временных таблиц, см. ВидыПДнКолонок.
//
// Возвращаемое значение:
//  Строка - вид ПДн или пустая строка.
Функция ВидПДнЦепочки(Источник, Цепочка, ВременныеТаблицы)

	ВидыКолонок = Неопределено;
	Владельцы = Новый Массив;
	Если ТипЗнч(Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
		ВидыКолонок = ВидыПоИменамКолонок(Источник.Запрос, ВидыПДнКолонок(Источник.Запрос, ВременныеТаблицы));
	ИначеЕсли СтрНайти(Источник.ИмяТаблицы, ".") = 0 Тогда
		ВидыКолонок = ВременныеТаблицы.Получить(НРег(Источник.ИмяТаблицы));
		Если ВидыКолонок = Неопределено Тогда
			Возврат ВидПДнНеизвестногоПоля();
		КонецЕсли;
	Иначе
		Владельцы.Добавить(ОбъектПравилМаскирования(Источник.ИмяТаблицы));
	КонецЕсли;

	Поля = Источник.ДоступныеПоля;
	Для Номер = 1 По Цепочка.ВГраница() Цикл
		Поле = Поля.Найти(Цепочка[Номер]);
		Если Поле = Неопределено Тогда
			Возврат ВидПДнНеизвестногоПоля();
		КонецЕсли;
		Если Номер = 1 И ВидыКолонок <> Неопределено Тогда
			Вид = ВидыКолонок.Получить(НРег(Цепочка[Номер]));
			// Колонка-ссылка помечена видом ПДн своего объекта; при разыменовании важен вид поля объекта.
			Если Номер < Цепочка.ВГраница() И ОбъектыТипа(Поле.ТипЗначения).Количество() > 0 Тогда
				Вид = "";
			КонецЕсли;
		Иначе
			Вид = ВидПДнПоляВладельцев(Владельцы, Цепочка[Номер]);
		КонецЕсли;
		Если ЗначениеЗаполнено(Вид) Тогда
			Возврат Вид;
		КонецЕсли;
		Владельцы = ОбъектыТипа(Поле.ТипЗначения);
		Поля = Поле.Поля;
	КонецЦикла;

	// Цепочка закончилась ссылкой. Значение-ссылку замаскирует ИИО_Ответ по виду объекта с учетом условия,
	// а строку из ПРЕДСТАВЛЕНИЕ() - вид ПДн колонки.
	Вид = "";
	Для Каждого Владелец Из Владельцы Цикл
		Вид = ИИО_Маскирование.ОбъединитьВидыПДн(Вид, ИИО_Маскирование.ВидПДнСсылки(Владелец));
	КонецЦикла;
	Возврат Вид;

КонецФункции

// Возвращает вид ПДн поля по всем объектам составного типа (субконто, регистратор).
//
// Параметры:
//  Владельцы - Массив из Строка - полные имена объектов метаданных, например Справочник.Контрагенты.
//  ИмяПоля - Строка
//
// Возвращаемое значение:
//  Строка - вид ПДн или пустая строка.
Функция ВидПДнПоляВладельцев(Владельцы, ИмяПоля)

	Вид = "";
	Для Каждого Владелец Из Владельцы Цикл
		ВидПоля = ИИО_Маскирование.ВидПДнПоля(Владелец, ИмяПоля);
		Если Не ЗначениеЗаполнено(ВидПоля) И НРег(ИмяПоля) = "представление" Тогда
			ВидПоля = ИИО_Маскирование.ВидПДнСсылки(Владелец);
		КонецЕсли;
		Вид = ИИО_Маскирование.ОбъединитьВидыПДн(Вид, ВидПоля);
	КонецЦикла;
	Возврат Вид;

КонецФункции

// Возвращает полные имена объектов метаданных ссылочных типов из описания типов.
//
// Параметры:
//  ОписаниеТипов - ОписаниеТипов
//
// Возвращаемое значение:
//  Массив из Строка - полные имена объектов метаданных.
Функция ОбъектыТипа(ОписаниеТипов)

	Объекты = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных <> Неопределено Тогда
			Объекты.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат Объекты;

КонецФункции

// Возвращает имя объекта, по которому ищутся правила маскирования таблицы запроса.
// Правила маскирования заданы для объекта: у виртуальной таблицы регистра (СрезПоследних, Остатки)
// поля те же, что у регистра. Табличные части объектов остаются отдельными таблицами.
//
// Параметры:
//  ИмяТаблицы - Строка - имя таблицы источника запроса, например РегистрСведений.Имя.СрезПоследних.
//
// Возвращаемое значение:
//  Строка - полное имя регистра для его виртуальной таблицы, иначе исходное имя таблицы.
Функция ОбъектПравилМаскирования(ИмяТаблицы)

	Части = СтрРазделить(ИмяТаблицы, ".");
	Если Части.Количество() > 2 И СтрНачинаетсяС(Части[0], "Регистр") Тогда
		Возврат Части[0] + "." + Части[1];
	КонецЕсли;
	Возврат ИмяТаблицы;

КонецФункции

Функция ВидПДнНеизвестногоПоля()

	Возврат "ПДн";

КонецФункции

// Цепочки идентификаторов через точку: Т.Контрагент.ИНН -> [Т, Контрагент, ИНН].
// Строковые литералы, параметры (&Имя) и числа пропускаются.
//
// Параметры:
//  Выражение - Строка - текст выражения языка запросов.
//
// Возвращаемое значение:
//  Массив из Массив из Строка
Функция ЦепочкиПолей(Выражение)

	Цепочки = Новый Массив;
	Цепочка = Неопределено;
	Идентификатор = "";
	ВСтроке = Ложь;
	ЭтоПараметр = Ложь;
	Продолжение = Ложь;
	Длина = СтрДлина(Выражение);
	Для Позиция = 1 По Длина + 1 Цикл
		Символ = ?(Позиция > Длина, " ", Сред(Выражение, Позиция, 1));
		Если ВСтроке Тогда
			ВСтроке = (Символ <> """");
			Продолжить;
		КонецЕсли;
		Если ЭтоСимволИдентификатора(Символ) Тогда
			Идентификатор = Идентификатор + Символ;
			Продолжить;
		КонецЕсли;

		Если Идентификатор <> "" Тогда
			Если ЭтоПараметр Или СтрНайти("0123456789", Лев(Идентификатор, 1)) > 0 Тогда
				Цепочка = Неопределено;
			ИначеЕсли Продолжение И Цепочка <> Неопределено Тогда
				Цепочка.Добавить(Идентификатор);
			Иначе
				Цепочка = Новый Массив;
				Цепочка.Добавить(Идентификатор);
				Цепочки.Добавить(Цепочка);
			КонецЕсли;
			Идентификатор = "";
			ЭтоПараметр = Ложь;
		КонецЕсли;

		Продолжение = (Символ = "." И Цепочка <> Неопределено);
		Если Не Продолжение Тогда
			Цепочка = Неопределено;
		КонецЕсли;
		ВСтроке = (Символ = """");
		ЭтоПараметр = (Символ = "&");
	КонецЦикла;
	Возврат Цепочки;

КонецФункции

Функция ЭтоСимволИдентификатора(Символ)

	Возврат СтрНайти("_0123456789", Символ) > 0 Или ВРег(Символ) <> НРег(Символ);

КонецФункции

#КонецОбласти

#Область ТихиеОшибки

// Добавляет предупреждения о признаках тихой ошибки в выборке и ее вложенных запросах (план 3в.6):
// такой запрос выполняется, но возвращает правдоподобный неверный результат.
//
// Параметры:
//  Предупреждения - Массив из Структура - code и message, дополняется.
//  ЗапросВыбора - ЗапросВыбораСхемыЗапроса
//  Текст - Строка - текст запроса модели.
Процедура ДобавитьПредупреждения(Предупреждения, ЗапросВыбора, Текст)

	Для Каждого Оператор Из ЗапросВыбора.Операторы Цикл
		Выражения = ВыраженияОператора(Оператор);
		ПроверитьАгрегатФизическойТаблицы(Предупреждения, Оператор, Выражения, Текст);
		ПроверитьСравнениеСоСтрокой(Предупреждения, Оператор, Выражения);
		ПроверитьУстаревшийРегистр(Предупреждения, Оператор);
		Для Каждого ИсточникОператора Из Оператор.Источники Цикл
			Если ТипЗнч(ИсточникОператора.Источник) = Тип("ВложенныйЗапросСхемыЗапроса") Тогда
				ДобавитьПредупреждения(Предупреждения, ИсточникОператора.Источник.Запрос, Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Возвращает тексты выражений оператора: выбираемые поля, условия отбора и соединений.
//
// Параметры:
//  Оператор - ОператорВыбратьСхемыЗапроса
//
// Возвращаемое значение:
//  Массив из Строка
Функция ВыраженияОператора(Оператор)

	Выражения = Новый Массив;
	Для Каждого Выражение Из Оператор.ВыбираемыеПоля Цикл
		Выражения.Добавить(Строка(Выражение));
	КонецЦикла;
	Для Каждого Выражение Из Оператор.Отбор Цикл
		Выражения.Добавить(Строка(Выражение));
	КонецЦикла;
	Для Каждого ИсточникОператора Из Оператор.Источники Цикл
		Для Каждого Соединение Из ИсточникОператора.Соединения Цикл
			Выражения.Добавить(Строка(Соединение.Условие));
		КонецЦикла;
	КонецЦикла;
	Возврат Выражения;

КонецФункции

// PHYSICAL_REGISTER_SUM: агрегат по ресурсу физической таблицы регистра остатков. В ней приход и расход
// оба положительные, знак хранится в ВидДвижения, поэтому сумма завышена. Запрос, где упомянуты ВидДвижения
// или Регистратор, читает движения осознанно и не проверяется.
//
// Параметры:
//  Предупреждения - Массив из Структура - дополняется.
//  Оператор - ОператорВыбратьСхемыЗапроса
//  Выражения - Массив из Строка - см. ВыраженияОператора
//  Текст - Строка - текст запроса модели.
Процедура ПроверитьАгрегатФизическойТаблицы(Предупреждения, Оператор, Выражения, Текст)

	Если ЕстьИмя(Лексемы(Текст), "ВидДвижения,RecordType,Регистратор,Recorder") Тогда
		Возврат;
	КонецЕсли;
	ВидОстатки = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	Для Каждого ИсточникОператора Из Оператор.Источники Цикл
		Источник = ИсточникОператора.Источник;
		Если ТипЗнч(Источник) <> Тип("ТаблицаСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		Регистр = Метаданные.НайтиПоПолномуИмени(Источник.ИмяТаблицы);
		Если Регистр = Неопределено
			Или Не Метаданные.РегистрыНакопления.Содержит(Регистр)
			Или Регистр.ВидРегистра <> ВидОстатки Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ресурс Из Регистр.Ресурсы Цикл
			Если Не ЕстьАгрегатПоПолю(Выражения, Источник.Псевдоним + "." + Ресурс.Имя) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПредупреждение(Предупреждения, "PHYSICAL_REGISTER_SUM", СтрШаблон(
				НСтр("ru = 'Агрегат по ресурсу %1 физической таблицы %2: приход и расход в ней оба положительные, знак хранится в ВидДвижения, поэтому сумма завышена. Остаток бери из %2.Остатки (поле %1Остаток), обороты - из %2.Обороты.'"),
				Ресурс.Имя, Регистр.ПолноеИмя()));
			Прервать;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьАгрегатПоПолю(Выражения, Поле)

	Агрегаты = СтрРазделить("СУММА,SUM,СРЕДНЕЕ,AVG", ",");
	Для Каждого Выражение Из Выражения Цикл
		Лексемы = Лексемы(Выражение);
		ЕстьАгрегат = Ложь;
		ЕстьПоле = Ложь;
		Для Каждого Лексема Из Лексемы Цикл
			Если Лексема.Вид <> "имя" Тогда
				Продолжить;
			КонецЕсли;
			ЕстьАгрегат = ЕстьАгрегат Или Агрегаты.Найти(ВРег(Лексема.Значение)) <> Неопределено;
			ЕстьПоле = ЕстьПоле Или НРег(Лексема.Значение) = НРег(Поле);
		КонецЦикла;
		Если ЕстьАгрегат И ЕстьПоле Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// REF_VS_STRING: поле-ссылка, перечисление или вид движения сравнивается со строковым литералом.
// Такое сравнение не выполняется никогда, и запрос молча возвращает не те строки.
//
// Параметры:
//  Предупреждения - Массив из Структура - дополняется.
//  Оператор - ОператорВыбратьСхемыЗапроса
//  Выражения - Массив из Строка - см. ВыраженияОператора
Процедура ПроверитьСравнениеСоСтрокой(Предупреждения, Оператор, Выражения)

	Для Каждого Выражение Из Выражения Цикл
		Лексемы = Лексемы(Выражение);
		Для Индекс = 1 По Лексемы.ВГраница() - 1 Цикл
			Знак = Лексемы[Индекс];
			Если Знак.Вид <> "знак" Или (Знак.Значение <> "=" И Знак.Значение <> "<>") Тогда
				Продолжить;
			КонецЕсли;
			Поле = Лексемы[Индекс - 1];
			Литерал = Лексемы[Индекс + 1];
			Если Поле.Вид = "строка" Тогда
				Поле = Лексемы[Индекс + 1];
				Литерал = Лексемы[Индекс - 1];
			КонецЕсли;
			Если Поле.Вид <> "имя" Или Литерал.Вид <> "строка" Или Не ЭтоСсылочноеПоле(Оператор, Поле.Значение) Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПредупреждение(Предупреждения, "REF_VS_STRING", СтрШаблон(
				НСтр("ru = '%1 сравнивается со строкой %2: ссылка, перечисление или вид движения со строкой не равны никогда. Сравнивай с ЗНАЧЕНИЕ(Перечисление.Имя.Значение), ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) или параметром со ссылкой из find_ref.'"),
				Поле.Значение, Литерал.Значение));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// STALE_REGISTER: запрос читает регистр, у версии которого (ЦеныНоменклатуры и ЦеныНоменклатуры25)
// последняя запись заметно новее. Старый регистр не пустой, поэтому запрос молча возвращает устаревшие данные.
//
// Параметры:
//  Предупреждения - Массив из Структура - дополняется.
//  Оператор - ОператорВыбратьСхемыЗапроса
Процедура ПроверитьУстаревшийРегистр(Предупреждения, Оператор)

	Для Каждого ИсточникОператора Из Оператор.Источники Цикл
		Источник = ИсточникОператора.Источник;
		Если ТипЗнч(Источник) <> Тип("ТаблицаСхемыЗапроса") Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Источник.ИмяТаблицы, ".");
		Если Части.Количество() < 2 Или ВидыТаблицРегистров().Найти(НРег(Части[0])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Регистр = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
		Дата = ?(Регистр = Неопределено, Неопределено, ИИО_Метаданные.ДатаПоследнейЗаписи(Регистр));
		Если Дата = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Версия Из ИИО_Метаданные.ВерсииРегистра(Регистр) Цикл
			ДатаВерсии = ИИО_Метаданные.ДатаПоследнейЗаписи(Версия);
			Если ДатаВерсии = Неопределено Или ДатаВерсии - Дата < ЗаметнаяРазницаДатСек() Тогда
				Продолжить;
			КонецЕсли;
			ДобавитьПредупреждение(Предупреждения, "STALE_REGISTER", СтрШаблон(
				НСтр("ru = 'Последняя запись %1 - %2, а у его версии %3 - %4: данные, скорее всего, ведутся в нем. Проверь, какой регистр нужен.'"),
				Регистр.ПолноеИмя(), ДатаДляМодели(Дата), Версия.ПолноеИмя(), ДатаДляМодели(ДатаВерсии)));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЗаметнаяРазницаДатСек()

	Возврат 90 * 86400;

КонецФункции

Функция ДатаДляМодели(Дата)

	Возврат ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДФ=yyyy-MM-dd"), НСтр("ru = 'записей нет'"));

КонецФункции

// Проверяет, что цепочка «Псевдоним.Поле…» ведет к полю ссылочного типа без строки в составе типа.
//
// Параметры:
//  Оператор - ОператорВыбратьСхемыЗапроса
//  Цепочка - Строка - например Т.ВидДвижения или Т.Контрагент.ВидКонтрагента.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоСсылочноеПоле(Оператор, Цепочка)

	Части = СтрРазделить(Цепочка, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Источник = ИсточникПоПсевдониму(Оператор, Части[0]);
	Если Источник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Поля = Источник.ДоступныеПоля;
	Поле = Неопределено;
	Для Номер = 1 По Части.ВГраница() Цикл
		Поле = Поля.Найти(Части[Номер]);
		Если Поле = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Поля = Поле.Поля;
	КонецЦикла;

	ТипЗначения = Поле.ТипЗначения;
	Если ТипЗначения.СодержитТип(Тип("Строка")) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТипЗначения.СодержитТип(Тип("ВидДвиженияНакопления"))
		Или ТипЗначения.СодержитТип(Тип("ВидДвиженияБухгалтерии"))
		Или ОбъектыТипа(ТипЗначения).Количество() > 0;

КонецФункции

Процедура ДобавитьПредупреждение(Предупреждения, Код, Сообщение)

	Для Каждого Предупреждение Из Предупреждения Цикл
		Если Предупреждение.message = Сообщение Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Предупреждения.Добавить(Новый Структура("code, message", Код, Сообщение));

КонецПроцедуры

// Подсказка к синтаксической ошибке запроса (план 3в.7) по разбору текста запроса модели, а не текста
// исключения платформы (499 п. 3.1): слово SQL вместо слова языка 1С, вызов метода, ключевое слово в псевдониме,
// поле таблицы регистра без нужного суффикса. Ничего не узнано - пустая строка.
//
// Параметры:
//  Текст - Строка - текст запроса модели.
//
// Возвращаемое значение:
//  Строка
Функция ПодсказкаКОшибке(Текст)

	Подсказки = Новый Массив;
	Лексемы = Лексемы(Текст);
	Замены = ЗаменыСловSQL();
	Последняя = Лексемы.ВГраница();
	Для Индекс = 0 По Последняя Цикл
		Лексема = Лексемы[Индекс];
		Если Лексема.Вид <> "имя" Тогда
			Продолжить;
		КонецЕсли;
		Слово = ВРег(Лексема.Значение);
		Следующее = ?(Индекс < Последняя, ВРег(Лексемы[Индекс + 1].Значение), "");
		Подсказка = "";
		Если ЭтоСловоSQL(Слово, Следующее) Тогда
			Подсказка = Замены[Слово];
		ИначеЕсли ЭтоВызовМетода(Лексемы, Индекс) Тогда
			Подсказка = НСтр("ru = 'Методов в языке запросов нет: представление ссылки - ПРЕДСТАВЛЕНИЕ(Поле), реквизит - через точку без скобок.'");
		ИначеЕсли (Слово = "КАК" Или Слово = "AS") И КлючевыеСлова().Найти(Следующее) <> Неопределено Тогда
			Подсказка = СтрШаблон(
				НСтр("ru = '%1 - ключевое слово языка запросов и не может быть псевдонимом: назови иначе, например по смыслу поля.'"),
				Лексемы[Индекс + 1].Значение);
		КонецЕсли;
		Если ЗначениеЗаполнено(Подсказка) И Подсказки.Найти(Подсказка) = Неопределено Тогда
			Подсказки.Добавить(Подсказка);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Подсказка Из ПодсказкиКПолямРегистров(Лексемы) Цикл
		Если Подсказки.Найти(Подсказка) = Неопределено Тогда
			Подсказки.Добавить(Подсказка);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Подсказки, " ");

КонецФункции

// Проверяет, что слово - слово SQL, которого нет в языке запросов 1С, в своей обычной конструкции:
// СРЕДН( и ДЛИНА( - функции, ПОРЯДОК ПО - сортировка. Поле или псевдоним с таким именем подсказку не получают.
//
// Параметры:
//  Слово - Строка - слово в верхнем регистре.
//  Следующее - Строка - следующая лексема в верхнем регистре.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоСловоSQL(Слово, Следующее)

	Если Слово = "СРЕДН" Или Слово = "ДЛИНА" Тогда
		Возврат Следующее = "(";
	ИначеЕсли Слово = "ПОРЯДОК" Или Слово = "СОРТИРОВАТЬ" Тогда
		Возврат Следующее = "ПО";
	КонецЕсли;
	Возврат Слово = "ИМЕЯ" Или Слово = "ЛИМИТ" Или Слово = "LIMIT";

КонецФункции

// Проверяет, что имя с точкой - вызов метода: Т.Ссылка.Представление(). Виртуальная таблица регистра
// с параметрами (РегистрНакопления.Имя.Остатки(&Дата)) вызовом не считается.
//
// Параметры:
//  Лексемы - см. Лексемы
//  Индекс - Число - индекс лексемы-имени.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоВызовМетода(Лексемы, Индекс)

	Имя = Лексемы[Индекс].Значение;
	Если СтрНайти(Имя, ".") = 0 Или Индекс + 2 > Лексемы.ВГраница() Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = НРег(СтрРазделить(Имя, ".")[0]);
	Возврат Лексемы[Индекс + 1].Значение = "(" И Лексемы[Индекс + 2].Значение = ")"
		И ВидыТаблицРегистров().Найти(Вид) = Неопределено;

КонецФункции

// Подсказки к полям, которых у таблицы нет: ресурс без суффикса у виртуальной таблицы регистра
// (О.ВНаличии у Остатки), ресурс с суффиксом у физической (Т.ВНаличииОстаток), Наименование у перечисления.
//
// Параметры:
//  Лексемы - см. Лексемы
//
// Возвращаемое значение:
//  Массив из Строка
Функция ПодсказкиКПолямРегистров(Лексемы)

	Подсказки = Новый Массив;
	Таблицы = ТаблицыПоПсевдонимам(Лексемы);
	Если Таблицы.Количество() = 0 Тогда
		Возврат Подсказки;
	КонецЕсли;
	Для Каждого Лексема Из Лексемы Цикл
		Части = СтрРазделить(Лексема.Значение, ".");
		Если Лексема.Вид <> "имя" Или Части.Количество() <> 2 Тогда
			Продолжить;
		КонецЕсли;
		Таблица = Таблицы[НРег(Части[0])];
		Если Таблица = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Подсказка = ПодсказкаКПолюРегистра(Таблица, Части[1]);
		Если ЗначениеЗаполнено(Подсказка) И Подсказки.Найти(Подсказка) = Неопределено Тогда
			Подсказки.Добавить(Подсказка);
		КонецЕсли;
	КонецЦикла;
	Возврат Подсказки;

КонецФункции

// Подсказка к полю таблицы регистра или перечисления, если такого поля у таблицы нет.
//
// Параметры:
//  Таблица - Строка - имя таблицы из текста запроса, например РегистрНакопления.Имя.Остатки.
//  ИмяПоля - Строка
//
// Возвращаемое значение:
//  Строка - подсказка или пустая строка.
Функция ПодсказкаКПолюРегистра(Таблица, ИмяПоля)

	Части = СтрРазделить(Таблица, ".");
	Если ВидыПеречислений().Найти(НРег(Части[0])) <> Неопределено Тогда
		Если НРег(ИмяПоля) <> "наименование" И НРег(ИмяПоля) <> "description" Тогда
			Возврат "";
		КонецЕсли;
		Возврат НСтр("ru = 'У перечисления нет поля Наименование: текст значения - ПРЕДСТАВЛЕНИЕ(Поле), а с самим перечислением соединять не нужно.'");
	КонецЕсли;
	Регистр = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
	Если Регистр = Неопределено Или Не Метаданные.РегистрыНакопления.Содержит(Регистр) Тогда
		Возврат "";
	КонецЕсли;

	Если Части.Количество() = 3 Тогда
		Поля = ИИО_Метаданные.ПоляВиртуальнойТаблицы(Регистр.ПолноеИмя(), Части[2]);
		Если Поля.Количество() = 0
			Или ЕстьИмяВКоллекции(Поля, ИмяПоля)
			Или Регистр.Измерения.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'У %1 нет поля %2. Ее поля, кроме измерений: %3.'"),
			Таблица, ИмяПоля, СтрСоединить(Поля, ", "));
	КонецЕсли;

	Для Каждого Ресурс Из Регистр.Ресурсы Цикл
		Если СтрНачинаетсяС(НРег(ИмяПоля), НРег(Ресурс.Имя)) И СтрДлина(ИмяПоля) > СтрДлина(Ресурс.Имя)
			И Регистр.Реквизиты.Найти(ИмяПоля) = Неопределено И Регистр.Ресурсы.Найти(ИмяПоля) = Неопределено Тогда
			Возврат СтрШаблон(
				НСтр("ru = 'Поля с суффиксами Остаток, Приход, Расход и Оборот есть только у виртуальных таблиц: %1.Остатки, %1.Обороты.'"),
				Регистр.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЕстьИмяВКоллекции(Имена, Имя)

	Для Каждого Элемент Из Имена Цикл
		Если НРег(Элемент) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Таблицы регистров и перечислений из текста запроса по псевдонимам:
// «РегистрНакопления.Имя.Остатки(...) КАК Псевдоним», «Перечисление.Имя КАК Псевдоним».
//
// Параметры:
//  Лексемы - см. Лексемы
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - псевдоним в нижнем регистре.
//   * Значение - Строка - имя таблицы, например РегистрНакопления.Имя.Остатки.
Функция ТаблицыПоПсевдонимам(Лексемы)

	Таблицы = Новый Соответствие;
	Виды = ВидыТаблицРегистров();
	Для Каждого Вид Из ВидыПеречислений() Цикл
		Виды.Добавить(Вид);
	КонецЦикла;
	Последняя = Лексемы.ВГраница();
	Для Индекс = 0 По Последняя Цикл
		Лексема = Лексемы[Индекс];
		Части = СтрРазделить(Лексема.Значение, ".");
		Если Лексема.Вид <> "имя" Или Части.Количество() < 2 Или Виды.Найти(НРег(Части[0])) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Следующая = Индекс + 1;
		Если Следующая <= Последняя И Лексемы[Следующая].Значение = "(" Тогда
			Следующая = ЗакрывающаяСкобка(Лексемы, Следующая) + 1;
		КонецЕсли;
		Слово = ?(Следующая <= Последняя, ВРег(Лексемы[Следующая].Значение), "");
		Если Слово = "КАК" Или Слово = "AS" Тогда
			Следующая = Следующая + 1;
		КонецЕсли;
		Если Следующая <= Последняя И Лексемы[Следующая].Вид = "имя" Тогда
			Таблицы.Вставить(НРег(Лексемы[Следующая].Значение), Лексема.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Таблицы;

КонецФункции

Функция ВидыТаблицРегистров()

	Возврат СтрРазделить("регистрнакопления,регистрсведений,регистрбухгалтерии,регистррасчета,"
		+ "accumulationregister,informationregister,accountingregister,calculationregister", ",");

КонецФункции

Функция ВидыПеречислений()

	Возврат СтрРазделить("перечисление,enum", ",");

КонецФункции

Функция ЗакрывающаяСкобка(Лексемы, Открывающая)

	Глубина = 0;
	Для Индекс = Открывающая По Лексемы.ВГраница() Цикл
		Значение = Лексемы[Индекс].Значение;
		Если Значение = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Значение = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Индекс;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Лексемы.ВГраница();

КонецФункции

// Слова SQL и других языков, которых нет в языке запросов 1С, и подсказки к ним. В английском варианте
// языка запросов AVG, HAVING и ORDER BY есть, поэтому в списке только русские слова и LIMIT.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - слово в верхнем регистре.
//   * Значение - Строка - подсказка.
Функция ЗаменыСловSQL()

	Замены = Новый Соответствие;
	Замены.Вставить("СРЕДН", НСтр("ru = 'Среднее в языке запросов 1С - СРЕДНЕЕ(Поле).'"));
	Замены.Вставить("ДЛИНА", НСтр("ru = 'Длина строки в языке запросов 1С - ДЛИНАСТРОКИ(Поле).'"));
	Замены.Вставить("ИМЕЯ", НСтр("ru = 'Условие на группу в языке запросов 1С - ИМЕЮЩИЕ.'"));
	Замены.Вставить("ПОРЯДОК", НСтр("ru = 'Сортировка в языке запросов 1С - УПОРЯДОЧИТЬ ПО.'"));
	Замены.Вставить("СОРТИРОВАТЬ", НСтр("ru = 'Сортировка в языке запросов 1С - УПОРЯДОЧИТЬ ПО.'"));
	Подсказка = НСтр("ru = 'Число строк ограничивается в начале выборки: ВЫБРАТЬ ПЕРВЫЕ 10.'");
	Замены.Вставить("ЛИМИТ", Подсказка);
	Замены.Вставить("LIMIT", Подсказка);
	Возврат Замены;

КонецФункции

// Ключевые слова, которые платформа не принимает псевдонимом (проверено на 8.3.27).
//
// Возвращаемое значение:
//  Массив из Строка - слова в верхнем регистре.
Функция КлючевыеСлова()

	Возврат СтрРазделить("NULL,АВТОУПОРЯДОЧИВАНИЕ,В,ВНУТРЕННЕЕ,ВОЗР,ВЫБОР,ВЫРАЗИТЬ,ГДЕ,ДЛЯ,ЕСТЬ,И,ИЗ,ИЛИ,"
		+ "ИНАЧЕ,ИСТИНА,КАК,КОГДА,ЛОЖЬ,МЕЖДУ,НЕ,НЕОПРЕДЕЛЕНО,ОБЩИЕ,ПЕРВЫЕ,ПО,ПОДОБНО,ПОМЕСТИТЬ,"
		+ "ПРЕДСТАВЛЕНИЕ,РАЗЛИЧНЫЕ,РАЗРЕШЕННЫЕ,СПЕЦСИМВОЛ,ССЫЛКА,ТОГДА,УБЫВ,"
		+ "AND,AS,BY,CASE,ELSE,FROM,IN,IS,NOT,OR,THEN,WHEN,WHERE", ",");

КонецФункции

// Лексемы текста запроса: имена вместе с точками (Т.Контрагент.ИНН) и числа - вид «имя», строковые
// литералы с кавычками - «строка», остальные символы и знаки <>, <=, >= - «знак». Пробелы и комментарии
// пропускаются.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Вид - Строка - имя, строка или знак.
//   * Значение - Строка
Функция Лексемы(Текст)

	Лексемы = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = """" Тогда
			Конец = КонецЛитерала(Текст, Позиция, Длина);
			Вид = "строка";
		ИначеЕсли Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Конец = СтрНайти(Текст, Символы.ПС, , Позиция);
			Позиция = ?(Конец = 0, Длина, Конец) + 1;
			Продолжить;
		ИначеЕсли ЭтоСимволИдентификатора(Символ) Тогда
			Конец = КонецИмени(Текст, Позиция, Длина);
			Вид = "имя";
		ИначеЕсли ПустаяСтрока(Символ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		Иначе
			Пара = Сред(Текст, Позиция, 2);
			Конец = ?(Пара = "<>" Или Пара = "<=" Или Пара = ">=", Позиция + 1, Позиция);
			Вид = "знак";
		КонецЕсли;
		Лексемы.Добавить(Новый Структура("Вид, Значение", Вид, Сред(Текст, Позиция, Конец - Позиция + 1)));
		Позиция = Конец + 1;
	КонецЦикла;
	Возврат Лексемы;

КонецФункции

// Позиция закрывающей кавычки строкового литерала; кавычка внутри литерала удвоена.
//
// Параметры:
//  Текст - Строка
//  Начало - Число - позиция открывающей кавычки.
//  Длина - Число - длина текста.
//
// Возвращаемое значение:
//  Число
Функция КонецЛитерала(Текст, Начало, Длина)

	Позиция = Начало + 1;
	Пока Позиция <= Длина Цикл
		Если Сред(Текст, Позиция, 1) <> """" Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Сред(Текст, Позиция + 1, 1) = """" Тогда
			Позиция = Позиция + 2;
		Иначе
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Длина;

КонецФункции

// Позиция последнего символа имени вместе с точками: Т.Контрагент.ИНН.
//
// Параметры:
//  Текст - Строка
//  Начало - Число - позиция первого символа имени.
//  Длина - Число - длина текста.
//
// Возвращаемое значение:
//  Число
Функция КонецИмени(Текст, Начало, Длина)

	Позиция = Начало;
	Пока Позиция < Длина Цикл
		Следующий = Сред(Текст, Позиция + 1, 1);
		Если ЭтоСимволИдентификатора(Следующий) Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Следующий = "." И ЭтоСимволИдентификатора(Сред(Текст, Позиция + 2, 1)) Тогда
			Позиция = Позиция + 2;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Позиция;

КонецФункции

// Проверяет, есть ли среди имен лексем (или частей имен через точку) одно из слов.
//
// Параметры:
//  Лексемы - см. Лексемы
//  Слова - Строка - слова через запятую.
//
// Возвращаемое значение:
//  Булево
Функция ЕстьИмя(Лексемы, Слова)

	Искомые = СтрРазделить(НРег(Слова), ",");
	Для Каждого Лексема Из Лексемы Цикл
		Если Лексема.Вид <> "имя" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из СтрРазделить(НРег(Лексема.Значение), ".") Цикл
			Если Искомые.Найти(Часть) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#КонецОбласти
