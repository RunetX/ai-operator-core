// Обработчик действий post и unpost: проведение и отмена проведения документов.
// Интерфейс обработчика действия, который вызывает ИИО_Действия: Применимо, Состояния, Состояние,
// ПредставлениеСостояния, Изменение, Проверки, ВыполнитьДействие, ОбратноеДействие.

#Область СлужебныйПрограммныйИнтерфейс

// Применимо ли действие к объектам этого вида.
//
// Параметры:
//  Действие - Строка - Код действия.
//  ОбъектМетаданных - ОбъектМетаданных
//
// Возвращаемое значение:
//  Булево - Истина для проводимых документов.
Функция Применимо(Действие, ОбъектМетаданных) Экспорт

	Возврат Метаданные.Документы.Содержит(ОбъектМетаданных)
		И ОбъектМетаданных.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;

КонецФункции

// Текущие состояния документов одного вида для плана. Документы, недоступные пользователю, не возвращаются.
//
// Параметры:
//  ПолноеИмя - Строка - Документ.Имя.
//  Ссылки - Массив из ДокументСсылка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка
//   * Значение - Структура - см. Состояние.
Функция Состояния(ПолноеИмя, Ссылки) Экспорт

	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.Проведен КАК Проведен,
		|	Документы.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	%1 КАК Документы
		|ГДЕ
		|	Документы.Ссылка В (&Ссылки)", ПолноеИмя));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Состояния = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Состояния.Вставить(Выборка.Ссылка, НовоеСостояние(Выборка.Проведен, Выборка.ПометкаУдаления));
	КонецЦикла;
	Возврат Состояния;

КонецФункции

// Состояние документа для данных отката. Хранится в JSON, поэтому только простые значения.
//
// Параметры:
//  Объект - ДокументОбъект
//
// Возвращаемое значение:
//  Структура:
//   * posted - Булево
//   * deleted - Булево
Функция СостояниеОбъекта(Объект) Экспорт

	Возврат НовоеСостояние(Объект.Проведен, Объект.ПометкаУдаления);

КонецФункции

// Представление состояния для пользователя.
//
// Параметры:
//  Состояние - см. Состояние
//
// Возвращаемое значение:
//  Строка
Функция ПредставлениеСостояния(Состояние) Экспорт

	Если Состояние.deleted Тогда
		Возврат НСтр("ru = 'Помечен на удаление'");
	КонецЕсли;
	Возврат ?(Состояние.posted, НСтр("ru = 'Проведен'"), НСтр("ru = 'Не проведен'"));

КонецФункции

// Что изменит действие в документе с этим состоянием.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Состояние - см. Состояние
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - post, repost, unpost или none.
//   * Представление - Строка - Для формы предпросмотра.
//   * Выполнять - Булево - Ложь, если менять нечего.
//   * Обратимо - Булево - Можно ли откатить изменение.
Функция Изменение(Действие, Состояние) Экспорт

	Если Действие = "post" И Состояние.posted Тогда
		Возврат НовоеИзменение("repost", НСтр("ru = 'Будет перепроведен: откатить нельзя'"), Истина, Ложь);
	ИначеЕсли Действие = "post" Тогда
		Возврат НовоеИзменение("post", НСтр("ru = 'Будет проведен'"), Истина, Истина);
	ИначеЕсли Действие = "unpost" И Состояние.posted Тогда
		Возврат НовоеИзменение("unpost", НСтр("ru = 'Будет отменено проведение'"), Истина, Истина);
	КонецЕсли;
	Возврат НовоеИзменение("none", НСтр("ru = 'Без изменений: документ не проведен'"), Ложь, Истина);

КонецФункции

// Проверки документа перед действием, кроме общих (блокировка, дата запрета), которые выполняет ИИО_Действия.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Ссылка - ДокументСсылка
//  Состояние - см. Состояние
//  Ошибки - Массив из Строка - Что помешает действию.
//  Предупреждения - Массив из Строка - Что стоит знать пользователю.
Процедура Проверки(Действие, Ссылка, Состояние, Ошибки, Предупреждения) Экспорт

	Если Действие <> "post" Тогда
		Возврат;
	КонецЕсли;
	Если Состояние.deleted Тогда
		Ошибки.Добавить(НСтр("ru = 'Документ помечен на удаление: провести его нельзя.'"));
		Возврат;
	КонецЕсли;
	Если Состояние.posted Тогда
		Предупреждения.Добавить(
			НСтр("ru = 'Документ уже проведен: движения будут сформированы заново, прежние не сохраняются.'"));
	КонецЕсли;

	Объект = Ссылка.ПолучитьОбъект();
	ПолучитьСообщенияПользователю(Истина);
	Если Не Объект.ПроверитьЗаполнение() Тогда
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Ошибки.Добавить(СокрЛП(Сообщение.Текст));
		КонецЦикла;
		Если Ошибки.Количество() = 0 Тогда
			Ошибки.Добавить(НСтр("ru = 'Документ не прошел проверку заполнения.'"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Выполняет действие над документом. Вызывается в транзакции; ошибка вызывает исключение,
// а сообщения документа ИИО_Действия собирает через ПолучитьСообщенияПользователю.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Объект - ДокументОбъект - Заблокированный документ.
Процедура ВыполнитьДействие(Действие, Объект) Экспорт

	Если Действие = "post" Тогда
		Если Объект.ПометкаУдаления Тогда
			ВызватьИсключение НСтр("ru = 'Документ помечен на удаление: провести его нельзя.'");
		КонецЕсли;
		// Как при интерактивном проведении: сначала проверка заполнения, затем запись с проведением.
		Если Не Объект.ПроверитьЗаполнение() Тогда
			ВызватьИсключение НСтр("ru = 'Документ не прошел проверку заполнения.'");
		КонецЕсли;
		Объект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения(Объект));
	ИначеЕсли Действие = "unpost" Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Обработчик проведения не выполняет действие %1.'"), Действие);
	КонецЕсли;

КонецПроцедуры

// Обратное действие для отката изменения.
//
// Параметры:
//  Действие - Строка - Код выполненного действия.
//  СостояниеДо - Структура - Состояние документа до изменения, см. Состояние.
//
// Возвращаемое значение:
//  Структура:
//   * Действие - Строка - Код обратного действия или пустая строка, если откатить нельзя.
//   * Причина - Строка - Почему откатить нельзя.
Функция ОбратноеДействие(Действие, СостояниеДо) Экспорт

	БылПроведен = ТипЗнч(СостояниеДо) = Тип("Структура") И СостояниеДо.Свойство("posted") И СостояниеДо.posted = Истина;
	Если Действие = "post" И Не БылПроведен Тогда
		Возврат Новый Структура("Действие, Причина", "unpost", "");
	ИначеЕсли Действие = "post" Тогда
		Возврат Новый Структура("Действие, Причина", "",
			НСтр("ru = 'Перепроведение не откатывается: прежние движения документа не сохраняются.'"));
	ИначеЕсли Действие = "unpost" И БылПроведен Тогда
		Возврат Новый Структура("Действие, Причина", "post", "");
	КонецЕсли;
	Возврат Новый Структура("Действие, Причина", "", НСтр("ru = 'Документ не менялся.'"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеСостояние(Проведен, ПометкаУдаления)

	Возврат Новый Структура("posted, deleted", Проведен, ПометкаУдаления);

КонецФункции

Функция НовоеИзменение(Код, Представление, Выполнять, Обратимо)

	Возврат Новый Структура("Код, Представление, Выполнять, Обратимо", Код, Представление, Выполнять, Обратимо);

КонецФункции

// Возвращает режим проведения как при интерактивном проведении: оперативный - для документа текущего дня,
// если вид документа допускает оперативное проведение.
//
// Параметры:
//  Объект - ДокументОбъект - проводимый документ.
//
// Возвращаемое значение:
//  РежимПроведенияДокумента - Оперативный или Неоперативный.
Функция РежимПроведения(Объект)

	Если Объект.Метаданные().ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить
		И НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДатаСеанса()) Тогда
		Возврат РежимПроведенияДокумента.Оперативный;
	КонецЕсли;
	Возврат РежимПроведенияДокумента.Неоперативный;

КонецФункции

#КонецОбласти
