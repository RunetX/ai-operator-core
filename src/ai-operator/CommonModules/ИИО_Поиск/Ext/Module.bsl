#Область СоставПолей

// Какие поля есть у объекта: от этого зависят условия поиска, реквизиты кандидатов и признак точного совпадения.
//
// Параметры:
//  Объект - ОбъектМетаданных - Ссылочный объект, в котором идет поиск.
//
// Возвращаемое значение:
//  Структура - Имя поля и Булево; НомерСтрокой - номер строкового типа, ЭтоГруппа - у объекта есть группы.
Функция СоставПолей(Объект)

	Состав = Новый Структура(
		"Наименование, НаименованиеПолное, Код, ИНН, КПП, Номер, НомерСтрокой, Дата, Проведен, ЭтоГруппа",
		Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	Вид = СтрРазделить(Объект.ПолноеИмя(), ".")[0];
	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Или Вид = "ПланСчетов" Или Вид = "ПланВидовРасчета" Тогда
		Состав.Наименование = Объект.ДлинаНаименования > 0;
		Состав.Код = Объект.ДлинаКода > 0;
	ИначеЕсли Вид = "Документ" Или Вид = "БизнесПроцесс" Или Вид = "Задача" Тогда
		Состав.Номер = Объект.ДлинаНомера > 0;
		Если Вид = "Документ" Тогда
			Состав.НомерСтрокой = Объект.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка;
		ИначеЕсли Вид = "Задача" Тогда
			Состав.НомерСтрокой = Объект.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераЗадачи.Строка;
		Иначе
			Состав.НомерСтрокой = Объект.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераБизнесПроцесса.Строка;
		КонецЕсли;
		Состав.Дата = Истина;
		Если Вид = "Задача" Тогда
			Состав.Наименование = Объект.ДлинаНаименования > 0;
		КонецЕсли;
	КонецЕсли;
	Если Вид = "Документ" Тогда
		Состав.Проведен = Объект.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить;
	КонецЕсли;
	Если Вид = "Справочник" Тогда
		Состав.ЭтоГруппа = Объект.Иерархический
			И Объект.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Состав.ЭтоГруппа = Объект.Иерархический;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("НаименованиеПолное,ИНН,КПП", ",") Цикл
		Реквизит = Объект.Реквизиты.Найти(Имя);
		Состав[Имя] = Реквизит <> Неопределено И Реквизит.Тип.СодержитТип(Тип("Строка"));
	КонецЦикла;
	Возврат Состав;

КонецФункции

