// Инструмент find_ref: поиск объекта по тексту, как его ищет пользователь.
// Сначала штатный ввод по строке (ПолучитьДанныеВыбора: поля и способ поиска из метаданных, полнотекстовый поиск,
// обработчики конфигурации), затем поиск по словам наименования без кавычек и организационно-правовых форм.

#Область СлужебныйПрограммныйИнтерфейс

// Ищет объекты вида kind по тексту.
//
// Параметры:
//  Аргументы - Структура, Соответствие - kind, text, limit.
//
// Возвращаемое значение:
//  Структура - Кандидаты или ошибка для модели:
//   * kind - Строка - Полное имя объекта метаданных.
//   * candidates - Массив из Структура - object ({ref, presentation}), match (exact или partial), code, inn, kpp,
//     full_name, number, date, posted, deleted - те, что есть у объекта.
//   * truncated - Булево
//   * hint - Строка - Что делать модели, если кандидатов нет или выбор неоднозначен.
//   * source - Структура
Функция НайтиСсылки(Аргументы) Экспорт

	Вид = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "kind", "");
	Текст = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "text", "");
	Лимит = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "limit", ЛимитПоУмолчанию());
	Если ТипЗнч(Вид) <> Тип("Строка") Или ПустаяСтрока(Вид)
		Или ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			НСтр("ru = 'Нужны kind (вид объектов, например Справочник.Контрагенты) и text (что искать).'"));
	КонецЕсли;
	Лимит = ?(ТипЗнч(Лимит) = Тип("Число") И Лимит >= 1, Мин(Цел(Лимит), МаксимальныйЛимит()), ЛимитПоУмолчанию());

	Объект = ИИО_Метаданные.СсылочныйОбъект(Вид);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Объект) Тогда
		Возврат Объект;
	КонецЕсли;

	Текст = СокрЛП(Текст);
	Поля = СоставПолей(Объект);
	Ссылки = Новый Массив;
	ДобавитьДанныеВыбора(Ссылки, Объект, Текст);
	Нормализованный = НормализованнаяСтрока(Текст);
	Если Нормализованный <> НРег(Текст) И ЗначениеЗаполнено(Нормализованный) Тогда
		ДобавитьДанныеВыбора(Ссылки, Объект, Нормализованный);
	КонецЕсли;
	// Кандидатов с запасом: часть отсеют права, группы и сортировка точных совпадений вперед.
	Слова = ЗначимыеСлова(Текст);
	ДобавитьНайденныеПоСловам(Ссылки, Объект, Поля, Текст, Слова, Лимит * 5);
	// Слово в другой форме («Суприма», «Бара Дионис») ищется по основе, только если в исходной форме ничего нет.
	Основы = ОсновыСлов(Слова);
	ПоОсновам = Ссылки.Количество() = 0 И СтрСоединить(Основы, " ") <> СтрСоединить(Слова, " ");
	Если ПоОсновам Тогда
		ДобавитьНайденныеПоСловам(Ссылки, Объект, Поля, "", Основы, Лимит * 5);
	КонецЕсли;

	Кандидаты = ОписанияКандидатов(Ссылки, Объект, Поля, Текст);
	Точных = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Точных = Точных + ?(Кандидат.match = "exact", 1, 0);
	КонецЦикла;
	Всего = Кандидаты.Количество();
	Пока Кандидаты.Количество() > Лимит Цикл
		Кандидаты.Удалить(Кандидаты.ВГраница());
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("kind", Объект.ПолноеИмя());
	Результат.Вставить("candidates", Кандидаты);
	Результат.Вставить("truncated", Всего > Кандидаты.Количество());
	Подсказка = Подсказка(Всего, Точных);
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Результат.Вставить("hint", Подсказка);
	КонецЕсли;
	Результат.Вставить("source", Новый Структура("object, method", Объект.ПолноеИмя(), ?(ПоОсновам,
		НСтр("ru = 'ввод по строке 1С и поиск по основам слов наименования'"),
		НСтр("ru = 'ввод по строке 1С и поиск по словам наименования'"))));
	Возврат ИИО_Ответ.ДанныеДляМодели(Результат);

КонецФункции

// Строка для сравнения наименований: нижний регистр, «е» как «е», без кавычек, знаков
// и организационно-правовых форм, слова через один пробел.
//
// Параметры:
//  Исходная - Строка
//
// Возвращаемое значение:
//  Строка
Функция НормализованнаяСтрока(Исходная) Экспорт

	Возврат СтрСоединить(ЗначимыеСлова(Исходная), " ");

КонецФункции

// Основа слова для поиска в другой падежной форме: без одного окончания, основа не короче трех букв.
// Слова с цифрами не меняются.
//
// Параметры:
//  Слово - Строка - В нижнем регистре, «е» заменена на «е».
//
// Возвращаемое значение:
//  Строка
Функция ОсноваСлова(Слово) Экспорт

	Если СтрДлина(Слово) < 4 Или ИИО_МаскированиеКлиентСервер.ЕстьЦифры(Слово) Тогда
		Возврат Слово;
	КонецЕсли;
	Для Каждого Окончание Из Окончания() Цикл
		Длина = СтрДлина(Слово) - СтрДлина(Окончание);
		Если Длина >= 3 И Прав(Слово, СтрДлина(Окончание)) = Окончание Тогда
			Возврат Лев(Слово, Длина);
		КонецЕсли;
	КонецЦикла;
	Возврат Слово;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Поиск

// Добавляет ссылки штатного ввода по строке. Результат зависит от настроек объекта: поля поиска,
// «начало строки» или «любая часть», полнотекстовый поиск, обработчик ОбработкаПолученияДанныхВыбора в конфигурации.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка - Найденные ссылки, дополняются без повторов.
//  Объект - ОбъектМетаданных - Ссылочный объект, в котором идет поиск.
//  Текст - Строка - Строка поиска.
Процедура ДобавитьДанныеВыбора(Ссылки, Объект, Текст)

	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Объект.ПолноеИмя());
	Попытка
		ДанныеВыбора = Менеджер.ПолучитьДанныеВыбора(Новый Структура("СтрокаПоиска", Текст));
	Исключение
		// Обработчик конфигурации может ждать своих параметров выбора - тогда остается поиск по словам.
		Возврат;
	КонецПопытки;
	Для Каждого ЭлементВыбора Из ДанныеВыбора Цикл
		Значение = ЭлементВыбора.Значение;
		Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Значение") Тогда
			Значение = Значение.Значение;
		КонецЕсли;
		// Кроме ссылок обработчики добавляют строки вроде «Создать: …».
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) И Ссылки.Найти(Значение) = Неопределено Тогда
			Ссылки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Все слова в наименовании (или номере) в любом месте; текст, похожий на ИНН, - точно по ИНН.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка - Найденные ссылки, дополняются без повторов.
//  Объект - ОбъектМетаданных - Ссылочный объект, в котором идет поиск.
//  Поля - см. СоставПолей
//  Текст - Строка - Текст для поиска по ИНН; пустая строка - без поиска по ИНН.
//  Слова - Массив из Строка - Слова или основы слов, учитываются первые пять.
//  Количество - Число - Наибольшее число ссылок в выборке запроса.
Процедура ДобавитьНайденныеПоСловам(Ссылки, Объект, Поля, Текст, Слова, Количество)

	ПоляПоиска = Новый Массив;
	Если Поля.Наименование Тогда
		ПоляПоиска.Добавить("Объекты.Наименование");
	КонецЕсли;
	Если Поля.НаименованиеПолное Тогда
		ПоляПоиска.Добавить("Объекты.НаименованиеПолное");
	КонецЕсли;
	Если Поля.Номер И Поля.НомерСтрокой Тогда
		ПоляПоиска.Добавить("Объекты.Номер");
	КонецЕсли;

	Запрос = Новый Запрос;
	Условия = Новый Массив;
	Если ПоляПоиска.Количество() > 0 Тогда
		Для Индекс = 0 По Мин(Слова.ВГраница(), 4) Цикл
			Если СтрДлина(Слова[Индекс]) < 2 Тогда
				Продолжить;
			КонецЕсли;
			ИмяПараметра = "Слово" + Формат(Индекс, "ЧН=0; ЧГ=0");
			Запрос.УстановитьПараметр(ИмяПараметра, "%" + ШаблонСлова(Слова[Индекс]) + "%");
			ПоПолям = Новый Массив;
			Для Каждого Поле Из ПоляПоиска Цикл
				ПоПолям.Добавить(СтрШаблон("%1 ПОДОБНО &%2", Поле, ИмяПараметра));
			КонецЦикла;
			Условия.Добавить("(" + СтрСоединить(ПоПолям, " ИЛИ ") + ")");
		КонецЦикла;
	КонецЕсли;
	Условие = СтрСоединить(Условия, " И ");
	Если Поля.ИНН И ЭтоИНН(Текст) Тогда
		Запрос.УстановитьПараметр("ИНН", Текст);
		Условие = ?(ПустаяСтрока(Условие), "Объекты.ИНН = &ИНН", "(" + Условие + ") ИЛИ Объекты.ИНН = &ИНН");
	КонецЕсли;
	Если ПустаяСтрока(Условие) Тогда
		Возврат;
	КонецЕсли;
	Если Поля.ЭтоГруппа Тогда
		Условие = "НЕ Объекты.ЭтоГруппа И (" + Условие + ")";
	КонецЕсли;

	Запрос.Текст = СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ %1 Объекты.Ссылка КАК Ссылка ИЗ %2 КАК Объекты ГДЕ %3",
		Формат(Количество, "ЧГ=0"), Объект.ПолноеИмя(), Условие);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Ссылки.Найти(Выборка.Ссылка) = Неопределено Тогда
			Ссылки.Добавить(Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Слово для ПОДОБНО: «е» в тексте может быть «е» в наименовании. Слова состоят только из букв и цифр,
// поэтому спецсимволы ПОДОБНО в них не встречаются.
//
// Параметры:
//  Слово - Строка - Слово в нижнем регистре.
//
// Возвращаемое значение:
//  Строка - Шаблон для ПОДОБНО без обрамляющих «%».
Функция ШаблонСлова(Слово)

	Возврат СтрЗаменить(Слово, "е", "[е" + Символ(1105) + "Е" + Символ(1025) + "]");

КонецФункции

Функция ЭтоИНН(Текст)

	Возврат (СтрДлина(Текст) = 10 Или СтрДлина(Текст) = 12) И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Текст);

КонецФункции

#КонецОбласти

#Область Кандидаты

// Реквизиты кандидатов, которые пользователь может прочитать, без групп. Точные совпадения - первыми.
// ИНН и полное наименование объектов с ПДн (физлиц, контрагентов-физлиц) помечаются построчно.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка - Найденные ссылки.
//  Объект - ОбъектМетаданных - Ссылочный объект, в котором идет поиск.
//  Поля - см. СоставПолей
//  Текст - Строка - Текст поиска от модели.
//
// Возвращаемое значение:
//  Массив из Структура - Кандидаты; ключи, кроме object и match, есть только у заполненных полей:
//   * object - ЛюбаяСсылка
//   * match - Строка - exact или partial.
//   * code - Строка, Число
//   * number - Строка, Число
//   * date - Дата
//   * posted - Булево
//   * inn - Строка, Структура - Для объекта с ПДн - значение с видом ПДн, см. ИИО_Ответ.ЗначениеСПДн.
//   * kpp - Строка
//   * full_name - Строка, Структура - Если отличается от наименования; для объекта с ПДн - как inn.
//   * deleted - Булево - Только у помеченных на удаление.
Функция ОписанияКандидатов(Ссылки, Объект, Поля, Текст)

	Кандидаты = Новый Массив;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Кандидаты;
	КонецЕсли;

	ПоляЗапроса = Новый Массив;
	ПоляЗапроса.Добавить("Объекты.Ссылка КАК Ссылка");
	ПоляЗапроса.Добавить("Объекты.ПометкаУдаления КАК ПометкаУдаления");
	Для Каждого Имя Из СтрРазделить("Наименование,НаименованиеПолное,Код,ИНН,КПП,Номер,Дата,Проведен", ",") Цикл
		Если Поля[Имя] Тогда
			ПоляЗапроса.Добавить(СтрШаблон("Объекты.%1 КАК %1", Имя));
		КонецЕсли;
	КонецЦикла;
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ %1 ИЗ %2 КАК Объекты ГДЕ Объекты.Ссылка В (&Ссылки)%3",
		СтрСоединить(ПоляЗапроса, ", "), Объект.ПолноеИмя(), ?(Поля.ЭтоГруппа, " И НЕ Объекты.ЭтоГруппа", "")));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Строки = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеОбъекта = Новый Структура;
		Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
			ДанныеОбъекта.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);
		КонецЦикла;
		Строки.Вставить(Выборка.Ссылка, ДанныеОбъекта);
	КонецЦикла;

	ВидыПДн = ИИО_Маскирование.ВидыПДнСсылок(Ссылки);
	ПолноеИмя = Объект.ПолноеИмя();
	ТекстНорм = НормализованнаяСтрока(Текст);
	Точные = Новый Массив;
	Частичные = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		ДанныеОбъекта = Строки.Получить(Ссылка);
		Если ДанныеОбъекта = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Точное = ТочноеСовпадение(ДанныеОбъекта, Поля, ТекстНорм, Текст);
		Кандидат = Новый Структура("object, match", Ссылка, ?(Точное, "exact", "partial"));
		ДобавитьПоле(Кандидат, "code", ДанныеОбъекта, "Код", Поля);
		ДобавитьПоле(Кандидат, "number", ДанныеОбъекта, "Номер", Поля);
		ДобавитьПоле(Кандидат, "date", ДанныеОбъекта, "Дата", Поля);
		ДобавитьПоле(Кандидат, "posted", ДанныеОбъекта, "Проведен", Поля);
		ЕстьПДн = ВидыПДн.Получить(Ссылка) <> Неопределено;
		Если Поля.ИНН И ЗначениеЗаполнено(ДанныеОбъекта.ИНН) Тогда
			Кандидат.Вставить("inn", ЗначениеПоля(ДанныеОбъекта.ИНН, ЕстьПДн, ПолноеИмя, "ИНН", "ИНН"));
		КонецЕсли;
		ДобавитьПоле(Кандидат, "kpp", ДанныеОбъекта, "КПП", Поля);
		Если Поля.НаименованиеПолное И ЗначениеЗаполнено(ДанныеОбъекта.НаименованиеПолное)
			И (Не Поля.Наименование
				Или НормализованнаяСтрока(ДанныеОбъекта.НаименованиеПолное)
					<> НормализованнаяСтрока(ДанныеОбъекта.Наименование)) Тогда
			Кандидат.Вставить("full_name", ЗначениеПоля(ДанныеОбъекта.НаименованиеПолное, ЕстьПДн, ПолноеИмя,
				"НаименованиеПолное", ВидыПДн.Получить(Ссылка)));
		КонецЕсли;
		Если ДанныеОбъекта.ПометкаУдаления Тогда
			Кандидат.Вставить("deleted", Истина);
		КонецЕсли;
		Если Точное Тогда
			Точные.Добавить(Кандидат);
		Иначе
			Частичные.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Кандидат Из Частичные Цикл
		Точные.Добавить(Кандидат);
	КонецЦикла;
	Возврат Точные;

КонецФункции

Процедура ДобавитьПоле(Кандидат, Ключ, ДанныеОбъекта, Имя, Поля)

	Если Поля[Имя] И ЗначениеЗаполнено(ДанныеОбъекта[Имя]) Тогда
		Кандидат.Вставить(Ключ, ДанныеОбъекта[Имя]);
	КонецЕсли;

КонецПроцедуры

// Поле объекта с ПДн помечается видом из реестра, клиентское ядро заменит его токеном.
//
// Параметры:
//  Значение - Строка - Значение поля.
//  ЕстьПДн - Булево - У ссылки есть вид ПДн.
//  ПолноеИмя - Строка - Полное имя объекта метаданных.
//  ИмяПоля - Строка - Имя реквизита.
//  ВидПоУмолчанию - Строка - Вид ПДн, если у поля в реестре вида нет.
//
// Возвращаемое значение:
//  - Строка - Значение как есть, если у объекта нет ПДн.
//  - Структура - Значение с видом ПДн, см. ИИО_Ответ.ЗначениеСПДн.
Функция ЗначениеПоля(Значение, ЕстьПДн, ПолноеИмя, ИмяПоля, ВидПоУмолчанию)

	Если Не ЕстьПДн Тогда
		Возврат Значение;
	КонецЕсли;
	// Ссылка уже проверена построчно, поэтому условие объекта здесь не нужно.
	Вид = ИИО_Маскирование.ОсновнойВидПДн(ИИО_Маскирование.ВидПДнПоля(ПолноеИмя, ИмяПоля));
	Возврат ИИО_Ответ.ЗначениеСПДн(Значение, ?(ЗначениеЗаполнено(Вид), Вид, ВидПоУмолчанию));

КонецФункции

// Точное совпадение: наименование без кавычек и ОПФ, ИНН, код или номер документа без префикса и нулей.
//
// Параметры:
//  ДанныеОбъекта - Структура - Поля объекта из запроса ОписанияКандидатов.
//  Поля - см. СоставПолей
//  ТекстНорм - Строка - Текст поиска, см. НормализованнаяСтрока.
//  Текст - Строка - Текст поиска как есть.
//
// Возвращаемое значение:
//  Булево
Функция ТочноеСовпадение(ДанныеОбъекта, Поля, ТекстНорм, Текст)

	Если Поля.Наименование И НормализованнаяСтрока(ДанныеОбъекта.Наименование) = ТекстНорм Тогда
		Возврат Истина;
	ИначеЕсли Поля.НаименованиеПолное И НормализованнаяСтрока(ДанныеОбъекта.НаименованиеПолное) = ТекстНорм Тогда
		Возврат Истина;
	ИначеЕсли Поля.ИНН И СокрЛП(ДанныеОбъекта.ИНН) = Текст Тогда
		Возврат Истина;
	ИначеЕсли Поля.Код И НРег(СокрЛП(СтрокаЗначения(ДанныеОбъекта.Код))) = НРег(Текст) Тогда
		Возврат Истина;
	ИначеЕсли Поля.Номер И ЗначениеЗаполнено(ЧислоНомера(Текст))
		И ЧислоНомера(ДанныеОбъекта.Номер) = ЧислоНомера(Текст) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Последняя группа цифр номера без ведущих нулей: «0000-000123», «БП-000123» и «123» дают «123».
//
// Параметры:
//  Номер - Строка, Число - Номер документа или текст поиска.
//
// Возвращаемое значение:
//  Строка - Цифры номера; пустая строка, если цифр нет.
Функция ЧислоНомера(Номер)

	Текст = СтрокаЗначения(Номер);
	Группы = Новый Массив;
	Группа = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Группа = Группа + Символ;
		ИначеЕсли Группа <> "" Тогда
			Группы.Добавить(Группа);
			Группа = "";
		КонецЕсли;
	КонецЦикла;
	Если Группа <> "" Тогда
		Группы.Добавить(Группа);
	КонецЕсли;
	Если Группы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Последняя = Группы[Группы.ВГраница()];
	Пока СтрДлина(Последняя) > 1 И Лев(Последняя, 1) = "0" Цикл
		Последняя = Сред(Последняя, 2);
	КонецЦикла;
	Возврат Последняя;

КонецФункции

Функция СтрокаЗначения(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0"), Строка(Значение));

КонецФункции

Функция Подсказка(Всего, Точных)

	Если Всего = 0 Тогда
		Возврат НСтр("ru = 'Ничего не найдено. Проверь написание, попробуй часть наименования, ИНН или код; вид объекта уточни через describe_metadata.'");
	ИначеЕсли Точных > 1 Тогда
		Возврат НСтр("ru = 'Несколько точных совпадений (возможно, дубли). Спроси пользователя, какой объект нужен, показав отличия: ИНН, код, полное наименование.'");
	ИначеЕсли Точных = 0 И Всего > 1 Тогда
		Возврат НСтр("ru = 'Точного совпадения нет. Не выбирай сам и не бери всех, даже при общем ИНН: перечисли пользователю варианты с отличиями (ИНН, КПП, код) и спроси, какой нужен или нужны все.'");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Нормализация

Функция ЗначимыеСлова(Исходная)

	Формы = ОрганизационноПравовыеФормы();
	Слова = Новый Массив;
	Слово = "";
	Текст = СтрЗаменить(НРег(Исходная), Символ(1105), "е") + " ";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Или ВРег(Символ) <> НРег(Символ) Тогда
			Слово = Слово + Символ;
		ИначеЕсли Слово <> "" Тогда
			Если Формы.Найти(Слово) = Неопределено Тогда
				Слова.Добавить(Слово);
			КонецЕсли;
			Слово = "";
		КонецЕсли;
	КонецЦикла;
	Возврат Слова;

КонецФункции

Функция ОрганизационноПравовыеФормы()

	Возврат СтрРазделить("ооо,оао,зао,пао,нао,ао,ип,тоо,чп,пбоюл,ано,нко,гуп,муп,фгуп,гбу,мбу,фгбу,кфх", ",");

КонецФункции

Функция ОсновыСлов(Слова)

	Основы = Новый Массив;
	Для Каждого Слово Из Слова Цикл
		Основы.Добавить(ОсноваСлова(Слово));
	КонецЦикла;
	Возврат Основы;

КонецФункции

// Окончания существительных, прилагательных и фамилий, длинные - первыми.
//
// Возвращаемое значение:
//  Массив из Строка
Функция Окончания()

	Возврат СтрРазделить(
		"ами,ями,ого,его,ому,ему,ыми,ими,ов,ев,ей,ой,ам,ям,ах,ях,ом,ем,ую,юю,ая,яя,ое,ее,ые,ие,ых,их,ым,им,"
		+ "а,я,у,ю,ы,и,е,о", ",");

КонецФункции

