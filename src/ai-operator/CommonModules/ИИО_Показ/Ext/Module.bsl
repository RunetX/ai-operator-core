// Инструменты show_in_1c и open_object: разбор ссылок от модели, проверка прав, выбор формы.
// Показываются только объекты, которые пользователь может прочитать и просмотреть.

#Область СлужебныйПрограммныйИнтерфейс

// Готовит показ объектов списком.
//
// Параметры:
//  Аргументы - Структура, Соответствие - refs, title.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или сведения для открытия формы:
//   * Ссылки - Массив из ЛюбаяСсылка - Найденные объекты, доступные пользователю.
//   * Виды - Массив из Строка - Полные имена объектов метаданных.
//   * ИмяФормы - Строка - Форма списка вида или общая форма ИИО_СписокОбъектов для разных видов.
//   * НеНайдено - Число - Сколько ссылок не найдено или недоступно.
//   * Заголовок - Строка
Функция ПодготовитьПоказ(Знач Аргументы) Экспорт

	// Количество проверяется до разбора: тысячи ссылок не разбираются.
	Идентификаторы = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "refs");
	Если ТипЗнч(Идентификаторы) = Тип("Массив") И Идентификаторы.Количество() > МаксимумСсылок() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Слишком много ссылок: %1, можно не больше %2.'"),
				Формат(Идентификаторы.Количество(), "ЧГ=0"), Формат(МаксимумСсылок(), "ЧГ=0")),
			НСтр("ru = 'Сузь отбор или покажи объекты частями.'"));
	КонецЕсли;
	Разбор = ИИО_Ответ.РазобратьСсылки(Идентификаторы, Истина);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Разбор) Тогда
		Возврат Разбор;
	КонецЕсли;
	Ссылки = Разбор.Ссылки;

	Доступные = ДоступныеОбъекты(Ссылки);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Доступные) Тогда
		Возврат Доступные;
	КонецЕсли;
	Если Доступные.Ссылки.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			НСтр("ru = 'Объекты не найдены или недоступны пользователю.'"),
			НСтр("ru = 'Проверь, что ссылки взяты из ответов инструментов этого сеанса.'"));
	КонецЕсли;

	Заголовок = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "title", "");
	Показ = Новый Структура;
	Показ.Вставить("Ссылки", Доступные.Ссылки);
	Показ.Вставить("Виды", Доступные.Виды);
	Показ.Вставить("ИмяФормы", ?(Доступные.Виды.Количество() = 1, Доступные.Виды[0] + ".ФормаСписка",
		"ОбщаяФорма.ИИО_СписокОбъектов"));
	Показ.Вставить("НеНайдено", Ссылки.Количество() - Доступные.Ссылки.Количество());
	Показ.Вставить("Заголовок", ИИО_ОтветКлиентСервер.Обрезать(СокрЛП(Строка(Заголовок)), 150));
	Возврат Показ;

КонецФункции

// Готовит открытие формы одного объекта или его штатного представления.
//
// Параметры:
//  Аргументы - Структура, Соответствие - ref и view: form - форма объекта (по умолчанию), related - структура
//   подчиненности, movements - движения документа.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или:
//   * Ссылка - ЛюбаяСсылка
//   * Объект - Структура - Ссылка для ответа модели: {ref, presentation}.
//   * Вид - Строка - view.
//   * ИмяФормы - Строка
//   * ПараметрыФормы - Структура
Функция ПодготовитьОткрытие(Знач Аргументы) Экспорт

	// Перечисления не открываются: у них нет форм объектов.
	Ссылка = ИИО_Ответ.СсылкаАргумента(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "ref"));
	Если Ссылка = Неопределено Или Метаданные.Перечисления.Содержит(Ссылка.Метаданные()) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не распознана ссылка ref.'"),
			ИИО_Ответ.ПодсказкаПоСсылкам());
	КонецЕсли;
	Доступные = ДоступныеОбъекты(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Доступные) Тогда
		Возврат Доступные;
	ИначеЕсли Доступные.Ссылки.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND", НСтр("ru = 'Объект не найден или недоступен пользователю.'"));
	КонецЕсли;
	Вид = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "view", "form");
	Форма = ФормаПредставления(Ссылка, Вид);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Форма) Тогда
		Возврат Форма;
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Объект, Вид, ИмяФормы, ПараметрыФормы", Ссылка, ИИО_Ответ.ДанныеДляМодели(Ссылка),
		Вид, Форма.ИмяФормы, Форма.ПараметрыФормы);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Существующие объекты, которые пользователь может прочитать (с учетом RLS) и просмотреть в форме.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  Структура - Ссылки и Виды или ошибка ACTION_DENIED, если к виду объектов нет права просмотра.
Функция ДоступныеОбъекты(Ссылки)

	ПоВидам = Новый Соответствие;
	Виды = Новый Массив;
	Для Каждого Ссылка Из Ссылки Цикл
		ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
		Если ПоВидам.Получить(ПолноеИмя) = Неопределено Тогда
			ПоВидам.Вставить(ПолноеИмя, Новый Массив);
			Виды.Добавить(ПолноеИмя);
		КонецЕсли;
		ПоВидам.Получить(ПолноеИмя).Добавить(Ссылка);
	КонецЦикла;

	Доступные = Новый Массив;
	ВидыДоступных = Новый Массив;
	Для Каждого ПолноеИмя Из Виды Цикл
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Или Не ПравоДоступа("Просмотр", ОбъектМетаданных) Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
				СтрШаблон(НСтр("ru = 'У пользователя нет права просматривать «%1».'"),
					ОбъектМетаданных.Представление()),
				НСтр("ru = 'Скажи пользователю, что показать эти объекты нельзя, и не обходи ограничение.'"));
		КонецЕсли;
		Запрос = Новый Запрос(СтрШаблон(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ Объекты.Ссылка КАК Ссылка ИЗ %1 КАК Объекты ГДЕ Объекты.Ссылка В (&Ссылки)",
			ПолноеИмя));
		Запрос.УстановитьПараметр("Ссылки", ПоВидам.Получить(ПолноеИмя));
		Найденные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если Найденные.Количество() > 0 Тогда
			ВидыДоступных.Добавить(ПолноеИмя);
		КонецЕсли;
		Для Каждого Ссылка Из Найденные Цикл
			Доступные.Добавить(Ссылка);
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Ссылки, Виды", Доступные, ВидыДоступных);

КонецФункции

// Штатная форма для view: форма объекта, «Структура подчиненности» БСП или движения документа -
// обработка «Корректировка движений» в БП, отчет БСП «Движения документа» в УТ и ЗУП.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//  Вид - Строка - view: form, related или movements.
//
// Возвращаемое значение:
//  Структура - ИмяФормы и ПараметрыФормы или ошибка для модели.
Функция ФормаПредставления(Ссылка, Вид)

	ОбъектМетаданных = Ссылка.Метаданные();
	Если Вид = "form" Тогда
		Возврат Новый Структура("ИмяФормы, ПараметрыФормы", ОбъектМетаданных.ПолноеИмя() + ".ФормаОбъекта",
			Новый Структура("Ключ", Ссылка));

	ИначеЕсли Вид = "related" Тогда
		Форма = Метаданные.ОбщиеФормы.Найти("СвязанныеДокументы");
		Критерий = Метаданные.КритерииОтбора.Найти("СвязанныеДокументы");
		Если Форма <> Неопределено И ПравоДоступа("Просмотр", Форма)
			И (Критерий = Неопределено Или Критерий.Тип.СодержитТип(ТипЗнч(Ссылка))) Тогда
			Возврат Новый Структура("ИмяФормы, ПараметрыФормы", "ОбщаяФорма.СвязанныеДокументы",
				Новый Структура("ОбъектОтбора", Ссылка));
		КонецЕсли;
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			НСтр("ru = 'Структура подчиненности для этого объекта недоступна: ее нет в конфигурации, у пользователя нет права или вид объекта в нее не входит.'"),
			НСтр("ru = 'Получи связи через related_objects и покажи документы через show_in_1c.'"));

	ИначеЕсли Вид = "movements" Тогда
		Если Не Метаданные.Документы.Содержит(ОбъектМетаданных) Или ОбъектМетаданных.Движения.Количество() = 0 Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
				СтрШаблон(
					НСтр("ru = 'У %1 нет движений: движения бывают только у документов, которые пишут в регистры.'"),
					ОбъектМетаданных.ПолноеИмя()));
		КонецЕсли;
		Обработка = Метаданные.Обработки.Найти("КорректировкаДвижений");
		Если Обработка <> Неопределено И ПравоДоступа("Просмотр", Обработка) Тогда
			Возврат Новый Структура("ИмяФормы, ПараметрыФормы", "Обработка.КорректировкаДвижений.Форма",
				Новый Структура("ДокументДвижений", Ссылка));
		КонецЕсли;
		Отчет = Метаданные.Отчеты.Найти("ДвиженияДокумента");
		Если Отчет <> Неопределено И ПравоДоступа("Просмотр", Отчет) Тогда
			Возврат Новый Структура("ИмяФормы, ПараметрыФормы", "Отчет.ДвиженияДокумента.Форма",
				Новый Структура("ДокументВладелец, СформироватьПриОткрытии", Ссылка, Истина));
		КонецЕсли;
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			НСтр("ru = 'Формы движений документа нет в конфигурации или у пользователя нет права ее открыть.'"),
			НСтр("ru = 'Регистры движений есть в describe_metadata (register_records), сами движения читай run_query с отбором по Регистратор.'"));
	КонецЕсли;

	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
		СтрШаблон(НСтр("ru = 'Неизвестный view «%1».'"), ИИО_ОтветКлиентСервер.Обрезать(Строка(Вид), 50)),
		НСтр("ru = 'Допустимые значения: form, related, movements.'"));

КонецФункции

Функция МаксимумСсылок()

	Возврат 1000;

КонецФункции

#КонецОбласти
