#Область ПрограммныйИнтерфейс

// Ответ инструмента с ошибкой, которую модель может обработать сама.
// Возвращается обычным результатом: Claude Desktop не показывает модели текст JSON-RPC error.
//
// Параметры:
//  Код - Строка - Код из перечня ядра: QUERY_SYNTAX, QUERY_TIMEOUT, REPORT_TIMEOUT, NOT_READY, ACTION_DENIED,
//    NOT_FOUND, AMBIGUOUS, INVALID_ARGUMENT, INTERNAL.
//  Текст - Строка, ФорматированнаяСтрока - Что не так. Текст исключения платформа может вернуть
//    форматированной строкой (СообщениеОбОшибкеДляПользователя): в ответ уходит ее текст, иначе JSON не запишется.
//  Подсказка - Строка - Что сделать модели или пользователю.
//  Дополнительно - Структура, Неопределено - Дополнительные поля ошибки (например, candidates).
//
// Возвращаемое значение:
//  Структура:
//   * error - Структура:
//     ** code - Строка
//     ** message - Строка
//     ** hint - Строка - Если задана подсказка.
Функция Ошибка(Код, Текст, Подсказка = "", Дополнительно = Неопределено) Экспорт

	ОписаниеОшибки = Новый Структура("code, message", Код, Строка(Текст));
	Если ЗначениеЗаполнено(Подсказка) Тогда
		ОписаниеОшибки.Вставить("hint", Подсказка);
	КонецЕсли;
	Если Дополнительно <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Дополнительно Цикл
			ОписаниеОшибки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("error", ОписаниеОшибки);

КонецФункции

// Проверяет, что ответ инструмента содержит ошибку.
//
// Параметры:
//  Ответ - Произвольный - Ответ инструмента.
//
// Возвращаемое значение:
//  Булево
Функция ЭтоОшибка(Ответ) Экспорт

	Возврат ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("error");

КонецФункции

// Код ошибки ответа или пустая строка, если ответ без ошибки.
//
// Параметры:
//  Ответ - Произвольный - Ответ инструмента.
//
// Возвращаемое значение:
//  Строка
Функция КодОшибки(Ответ) Экспорт

	Если Не ЭтоОшибка(Ответ) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ответ.error.code;

КонецФункции

// Текст ошибки для показа человеку в формах 1С. Подсказка ошибки адресована модели и не показывается;
// причины пропущенных объектов (skipped) сводятся в одну строку на причину с числом объектов.
//
// Параметры:
//  Ответ - Структура - Ответ инструмента с ошибкой, см. Ошибка.
//
// Возвращаемое значение:
//  Строка
Функция ТекстОшибкиДляПользователя(Ответ) Экспорт

	ОписаниеОшибки = Ответ.error;
	Строки = Новый Массив;
	Строки.Добавить(ОписаниеОшибки.message);

	Пропущенные = Неопределено;
	ОписаниеОшибки.Свойство("skipped", Пропущенные);
	Если ТипЗнч(Пропущенные) <> Тип("Массив") Тогда
		Возврат Строки[0];
	КонецЕсли;
	Причины = Новый Массив;
	Количество = Новый Соответствие;
	Для Каждого Пропущенный Из Пропущенные Цикл
		Причина = Аргумент(Пропущенный, "reason", "");
		Если Не ЗначениеЗаполнено(Причина) Тогда
			Продолжить;
		КонецЕсли;
		Если Количество[Причина] = Неопределено Тогда
			Причины.Добавить(Причина);
			Количество.Вставить(Причина, 0);
		КонецЕсли;
		Количество.Вставить(Причина, Количество[Причина] + 1);
	КонецЦикла;
	Для Каждого Причина Из Причины Цикл
		Строки.Добавить(СтрШаблон(НСтр("ru = '%1 Объектов: %2.'"), Причина, Количество[Причина]));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Значение аргумента вызова инструмента. Аргументы приходят из JSON как Структура или Соответствие.
//
// Параметры:
//  Аргументы - Структура, Соответствие, Неопределено - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  ЗначениеПоУмолчанию - Произвольный - Значение, если аргумент не передан или равен null.
//
// Возвращаемое значение:
//  Произвольный
Функция Аргумент(Аргументы, Имя, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Целое число из аргумента в пределах 1..Максимум.
//
// Параметры:
//  Значение - Произвольный - Значение аргумента.
//  ПоУмолчанию - Число - Для незаданного, нецелого или меньшего 1 значения.
//  Максимум - Число
//
// Возвращаемое значение:
//  Число
Функция ЦелоеВПределах(Значение, ПоУмолчанию, Максимум) Экспорт

	Если ТипЗнч(Значение) <> Тип("Число") Или Значение < 1 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Цел(Значение), Максимум);

КонецФункции

// Целое число из аргумента вызова в пределах 1..Максимум, см. Аргумент и ЦелоеВПределах.
//
// Параметры:
//  Аргументы - Структура, Соответствие, Неопределено - Аргументы вызова.
//  Имя - Строка - Имя аргумента.
//  ПоУмолчанию - Число - Для незаданного, нецелого или меньшего 1 значения.
//  Максимум - Число
//
// Возвращаемое значение:
//  Число
Функция ЦелыйАргумент(Аргументы, Имя, ПоУмолчанию, Максимум) Экспорт

	Возврат ЦелоеВПределах(Аргумент(Аргументы, Имя), ПоУмолчанию, Максимум);

КонецФункции

// Дата из значения аргумента: строки ISO 8601 (2016-01-31 или 2016-01-31T00:00:00) или даты.
//
// Параметры:
//  Значение - Строка, Дата, Произвольный - Значение аргумента от модели.
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если значение не является датой.
Функция ДатаАргумента(Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) = 10 Тогда
		Текст = Текст + "T00:00:00";
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Лев(Текст, 19));
	Исключение
		// Не дата: что ответить модели, решает вызывающий.
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Сериализует значение в компактный JSON, даты - в ISO 8601.
//
// Параметры:
//  Значение - Произвольный - Структура, Соответствие, Массив или примитивное значение.
//
// Возвращаемое значение:
//  Строка
Функция ВJSON(Значение) Экспорт

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;
	ЗаписатьJSON(Запись, Значение, Настройки);
	Возврат Запись.Закрыть();

КонецФункции

// Разбирает JSON. Текст не JSON - исключение: что с ним делать, решает вызывающий.
//
// Параметры:
//  Текст - Строка - JSON для разбора.
//  ВСоответствие - Булево - Истина - объекты в соответствия. Ложь - в структуры, ключи должны быть
//   допустимыми именами свойств.
//
// Возвращаемое значение:
//  Соответствие, Структура, Массив, Строка, Число, Булево, Неопределено
Функция ИзJSON(Текст, ВСоответствие = Истина) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, ВСоответствие);
	Чтение.Закрыть();
	Возврат Значение;

КонецФункции

// Обрезает строку до заданной длины с пометкой об обрезке.
//
// Параметры:
//  Текст - Строка - Исходная строка.
//  МаксимальнаяДлина - Число - Предельная длина.
//
// Возвращаемое значение:
//  Строка
Функция Обрезать(Текст, МаксимальнаяДлина) Экспорт

	Если СтрДлина(Текст) <= МаксимальнаяДлина Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, МаксимальнаяДлина) + "…";

КонецФункции

#КонецОбласти
