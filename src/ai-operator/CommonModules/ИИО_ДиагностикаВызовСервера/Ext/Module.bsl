// Вызовы сервера формы «Состояние ИИ-оператора», см. ИИО_Диагностика.

#Область СлужебныйПрограммныйИнтерфейс

// Серверные проверки, см. ИИО_Диагностика.Проверки.
//
// Возвращаемое значение:
//  Массив из см. ИИО_Диагностика.НоваяПроверка
Функция Проверки() Экспорт

	Возврат ИИО_Диагностика.Проверки();

КонецФункции

// Включает уровень «Информация» в журнале регистрации, см. ИИО_Диагностика.ВключитьЖурнал.
// Свежие проверки возвращаются сразу, чтобы форма не вызывала сервер второй раз.
//
// Возвращаемое значение:
//  Структура:
//   * ok - Булево
//   * error - Строка
//   * Проверки - Массив из см. ИИО_Диагностика.НоваяПроверка
Функция ВключитьЖурнал() Экспорт

	Результат = ИИО_Диагностика.ВключитьЖурнал();
	Результат.Вставить("Проверки", ИИО_Диагностика.Проверки());
	Возврат Результат;

КонецФункции

// Тестовый запрос к модели, см. ИИО_Диагностика.ПроверитьМодель.
//
// Параметры:
//  Назначение - Строка - агент или маскирование.
//
// Возвращаемое значение:
//  см. ИИО_Диагностика.НоваяПроверка
Функция ПроверитьМодель(Знач Назначение) Экспорт

	Возврат ИИО_Диагностика.ПроверитьМодель(Назначение);

КонецФункции

// Действие проверки пакета: <Префикс>_СостояниеПакета.<код>. Вызывается только модуль установленного пакета.
//
// Параметры:
//  Действие - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка - Итог для пользователя.
//   * Проверки - Массив из см. ИИО_Диагностика.НоваяПроверка - Проверки после действия.
Функция ВыполнитьДействиеПакета(Знач Действие) Экспорт

	Части = СтрРазделить(Действие, ".");
	Если Части.Количество() <> 2
		Или ИИО_Пакеты.СерверныеМодулиСОкончанием("_СостояниеПакета").Найти(Части[0]) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестное действие проверки: %1.'"), Действие);
	КонецЕсли;
	Текст = ОбщегоНазначения.ОбщийМодуль(Части[0]).ВыполнитьДействие(Части[1]);
	Возврат Новый Структура("Текст, Проверки", Текст, ИИО_Диагностика.Проверки());

КонецФункции

#КонецОбласти
