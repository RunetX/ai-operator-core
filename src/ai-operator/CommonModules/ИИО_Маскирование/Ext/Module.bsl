// Возвращает изменения администратора из регистра ИИО_МаскируемыеПоля.
// Читаются в привилегированном режиме: правила нужны каждому пользователю ИИ-оператора.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Объект - Строка - Полное имя объекта метаданных.
//   * Поле - Строка - Имя поля или пустая строка для правила объекта.
//   * ВидПДн - Строка - Вид ПДн или пустая строка.
//   * Условие - Строка - Условие запроса с псевдонимом Т или пустая строка.
Функция ЗаписиРегистра()

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МаскируемыеПоля.Объект КАК Объект,
	|	МаскируемыеПоля.Поле КАК Поле,
	|	МаскируемыеПоля.ВидПДн КАК ВидПДн,
	|	МаскируемыеПоля.Условие КАК Условие
	|ИЗ
	|	РегистрСведений.ИИО_МаскируемыеПоля КАК МаскируемыеПоля");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Записи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Записи.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			СокрЛП(Выборка.Объект), СокрЛП(Выборка.Поле), СокрЛП(Выборка.ВидПДн), СокрЛП(Выборка.Условие)));
	КонецЦикла;
	Возврат Записи;

КонецФункции

Функция ДобавитьСтрокуНастройки(Строки, Объект, Поле, Вид, Условие, ЕстьВПреднастройке)

	СтрокаНастройки = Новый Структура(
		"Объект, Поле, ВидПДн, Условие, ВидПреднастройки, УсловиеПреднастройки, ЕстьВПреднастройке",
		Объект, Поле, Вид, Условие, Вид, Условие, ЕстьВПреднастройке);
	Строки.Вставить(Объект + "|" + Поле, СтрокаНастройки);
	Возврат СтрокаНастройки;

КонецФункции

Функция СовпадаетСПреднастройкой(Преднастройка, Объект, Поле, Вид, Условие)

	Правило = Преднастройка.Получить(Объект);
	Если Правило = Неопределено Тогда
		// Пустое правило без преднастройки ничего не меняет.
		Возврат Вид = "" И Условие = "";
	ИначеЕсли Поле = "" Тогда
		Возврат Правило.ВидСсылки = Вид И Правило.Условие = Условие;
	КонецЕсли;
	ВидПреднастройки = Правило.Поля.Получить(Поле);
	Возврат ?(ВидПреднастройки = Неопределено, Вид = "", ВидПреднастройки = Вид);

КонецФункции

// Проверяет правило маскирования из формы настройки.
// Псевдоним таблицы Т в запросах с условием ПДн - часть формата условий: в преднастройке и регистре
// ИИО_МаскируемыеПоля условия записаны как Т.Поле. Поэтому он не заменяется более осмысленным (стандарт 758).
//
// Параметры:
//  Объект - Строка - Полное имя объекта метаданных, в том числе табличной части.
//  Поле - Строка - Имя поля или пустая строка для правила объекта.
//  Вид - Строка - Вид ПДн или пустая строка, если маскирование отключается.
//  Условие - Строка - Условие запроса с псевдонимом Т или пустая строка.
//
// Возвращаемое значение:
//  Строка - Текст ошибки для пользователя или пустая строка, если правило корректно.
Функция ОшибкаПравила(Объект, Поле, Вид, Условие)

	Если МетаданныеПоИмени(Объект) = Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'объект «%1» не найден: нужно полное имя, например Справочник.Контрагенты.'"),
			Объект);
	ИначеЕсли СтрДлина(Вид) > 50 Или СтрНайти(Вид, "|") > 0 Или СтрНайти(Вид, "#") > 0
		Или СтрНайти(Вид, "[") > 0 Или СтрНайти(Вид, "]") > 0 Тогда
		Возврат НСтр("ru = 'вид ПДн - короткое слово без символов | # [ ], например ФИО.'");
	ИначеЕсли Поле <> "" И Условие <> "" Тогда
		Возврат НСтр("ru = 'условие задается в строке объекта с пустым полем и действует на все его поля.'");
	ИначеЕсли Поле <> "" И Не ЗапросВыполняется(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 Т.%1 ИЗ %2 КАК Т", Поле, Объект)) Тогда
		Возврат СтрШаблон(НСтр("ru = 'у объекта нет поля «%1».'"), Поле);
	ИначеЕсли Условие <> ""
		И Не ЗапросВыполняется(СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 1 1 ИЗ %1 КАК Т ГДЕ %2", Объект, Условие)) Тогда
		Возврат НСтр("ru = 'условие не выполняется как запрос: нужно выражение языка запросов с псевдонимом Т,
			|например Т.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо).'");
	КонецЕсли;
	Возврат "";

КонецФункции

// Проверяет поле и условие выполнением запроса в привилегированном режиме: права администратора
// на сам объект не должны влиять на проверку.
//
// Параметры:
//  Текст - Строка - Текст проверочного запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если запрос выполнился без ошибки.
Функция ЗапросВыполняется(Текст)

	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос(Текст);
	Попытка
		Запрос.Выполнить();
		Выполняется = Истина;
	Исключение
		Выполняется = Ложь;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Выполняется;

КонецФункции

#КонецОбласти

Процедура ДобавитьКонтекстТаблицы(Контекст, ПолноеИмяОбъекта, ИмяТаблицы, Реквизиты, Ссылки)

	Поля = Новый Соответствие;
	Для Каждого Реквизит Из Реквизиты Цикл
		Вид = ВидПДнПоля(ПолноеИмяОбъекта, Реквизит.Имя);
		Если ЗначениеЗаполнено(Вид) Или ЕстьСсылкиСПДн(Реквизит.Тип) Тогда
			Поля.Вставить(Реквизит.Имя, Вид);
		КонецЕсли;
	КонецЦикла;
	Если Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВыбираемыеПоля = Новый Массив;
	Для Каждого КлючИЗначение Из Поля Цикл
		ВыбираемыеПоля.Добавить(СтрШаблон("Объекты.%1 КАК %1", КлючИЗначение.Ключ));
	КонецЦикла;
	Запрос = Новый Запрос(СтрШаблон("ВЫБРАТЬ %1 ИЗ %2 КАК Объекты ГДЕ Объекты.Ссылка В (&Ссылки)",
		СтрСоединить(ВыбираемыеПоля, ", "), ИмяТаблицы));
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого КлючИЗначение Из Поля Цикл
			Значение = Выборка[КлючИЗначение.Ключ];
			Если Не ЗначениеЗаполнено(Значение) Тогда
				Продолжить;
			ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
				Контекст.Добавить(Новый Структура("pii, value", КлючИЗначение.Значение, Значение));
			ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение))
				И ЗначениеЗаполнено(ВидПДнСсылки(Значение.Метаданные().ПолноеИмя()))
				И Контекст.Найти(Значение) = Неопределено Тогда
				Контекст.Добавить(Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСсылкиСПДн(ОписаниеТипов)

	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных <> Неопределено И ЗначениеЗаполнено(ВидПДнСсылки(ОбъектМетаданных.ПолноеИмя())) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Возвращает объект метаданных по полному имени, в том числе табличную часть:
// Справочник.Контрагенты.КонтактнаяИнформация.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта или табличной части.
//
// Возвращаемое значение:
//  ОбъектМетаданных, Неопределено - Неопределено, если объект не найден.
Функция МетаданныеПоИмени(ПолноеИмя)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Части = СтрРазделить(ПолноеИмя, ".");
	Если ОбъектМетаданных = Неопределено И Части.Количество() = 3 Тогда
		Владелец = Метаданные.НайтиПоПолномуИмени(Части[0] + "." + Части[1]);
		Попытка
			ОбъектМетаданных = ?(Владелец = Неопределено, Неопределено, Владелец.ТабличныеЧасти.Найти(Части[2]));
		Исключение
			// У владельца нет табличных частей (регистр).
			ОбъектМетаданных = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат ОбъектМетаданных;

КонецФункции

Функция УсловныйВидПДн(Вид, ПолноеИмяОбъекта, ИмяПоля)

	Возврат СтрШаблон("%1|%2|%3", Вид, ПолноеИмяОбъекта, ИмяПоля);

КонецФункции

Функция ЭтоУсловныйВид(Вид)

	Возврат СтрНайти(Вид, "|") > 0;

КонецФункции

Процедура СобратьУсловныеПометки(Данные, Пометки)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Данные Цикл
			ДобавитьУсловнуюПометку(Данные, КлючИЗначение.Ключ, КлючИЗначение.Значение, Пометки);
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Тогда
		Для Индекс = 0 По Данные.ВГраница() Цикл
			ДобавитьУсловнуюПометку(Данные, Индекс, Данные[Индекс], Пометки);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Добавляет пометку {"pii", "value"} с условным видом в список проверки или обходит вложенные данные.
// Строковое значение с условным видом ждет проверки по значению, у остальных типов остается основной вид.
//
// Параметры:
//  Контейнер - Структура, Соответствие, Массив - Коллекция, в которой лежит значение.
//  Ключ - Произвольный - Ключ структуры или соответствия либо индекс массива.
//  Значение - Произвольный - Проверяемое значение.
//  Пометки - Массив из Структура - Собранные пометки, пополняется:
//   * Контейнер - Структура, Соответствие, Массив
//   * Ключ - Произвольный
//   * Вид - Строка - Условный вид ПДн.
//   * Значение - Строка
Процедура ДобавитьУсловнуюПометку(Контейнер, Ключ, Значение, Пометки)

	Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("pii") И Значение.Свойство("value")
		И ЭтоУсловныйВид(Значение.pii) Тогда
		Если ТипЗнч(Значение.value) = Тип("Строка") Тогда
			Пометки.Добавить(Новый Структура("Контейнер, Ключ, Вид, Значение",
				Контейнер, Ключ, Значение.pii, Значение.value));
		Иначе
			Значение.pii = ОсновнойВидПДн(Значение.pii);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	СобратьУсловныеПометки(Значение, Пометки);

КонецПроцедуры

// Возвращает значения поля, которые встречаются только у объектов, не подходящих под условие ПДн.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта с условием ПДн.
//  ИмяПоля - Строка - Имя строкового поля объекта.
//  Значения - Массив из Строка - Значения условных пометок этого вида.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Открытое значение.
//   * Значение - Булево - Истина.
Функция ОткрытыеЗначения(ПолноеИмя, ИмяПоля, Значения)

	Открытые = Новый Соответствие;
	Правило = ИИО_МаскированиеПовтИсп.Правила().Получить(ПолноеИмя);
	ДлинаПоля = ДлинаСтроковогоПоля(ПолноеИмя, ИмяПоля);
	Если Правило = Неопределено Или Не ЗначениеЗаполнено(Правило.Условие) Или ДлинаПоля = Неопределено Тогда
		Возврат Открытые;
	КонецЕсли;
	// Строку неограниченной длины нельзя сравнивать и группировать, поэтому она приводится к ограниченной.
	// Псевдоним Т - из формата условий ПДн, см. ОшибкаПравила.
	Поле = ?(ДлинаПоля = 0, СтрШаблон("ВЫРАЗИТЬ(Т.%1 КАК СТРОКА(1024))", ИмяПоля), "Т." + ИмяПоля);

	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ
		|	%1 КАК Значение,
		|	МАКСИМУМ(ВЫБОР КОГДА %3 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ) КАК ЕстьПДн
		|ИЗ
		|	%2 КАК Т
		|ГДЕ
		|	%1 В (&Значения)
		|СГРУППИРОВАТЬ ПО
		|	%1", Поле, ПолноеИмя, Правило.Условие));
	Запрос.УстановитьПараметр("Значения", Значения);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЕстьПДн = 0 Тогда
			Открытые.Вставить(Выборка.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Открытые;

КонецФункции

// Возвращает длину строкового поля объекта.
//
// Параметры:
//  ПолноеИмя - Строка - Полное имя объекта или табличной части.
//  ИмяПоля - Строка - Имя реквизита или стандартного реквизита.
//
// Возвращаемое значение:
//  Число, Неопределено - 0 - неограниченная длина, Неопределено - поля нет или оно не только строковое.
Функция ДлинаСтроковогоПоля(ПолноеИмя, ИмяПоля)

	ОбъектМетаданных = МетаданныеПоИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипПоля = Неопределено;
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяПоля);
	Если Реквизит <> Неопределено Тогда
		ТипПоля = Реквизит.Тип;
	Иначе
		Для Каждого СтандартныйРеквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
			Если СтандартныйРеквизит.Имя = ИмяПоля Тогда
				ТипПоля = СтандартныйРеквизит.Тип;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ТипПоля = Неопределено Или ТипПоля.Типы().Количество() <> 1 Или Не ТипПоля.СодержитТип(Тип("Строка")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТипПоля.КвалификаторыСтроки.Длина;

КонецФункции

Функция СсылкиПоОбъектам(Ссылки)

	Группы = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		Если Не ЗначениеЗаполнено(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
		Группа = Группы.Получить(ПолноеИмя);
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(ПолноеИмя, Группа);
		КонецЕсли;
		Если Группа.Найти(Ссылка) = Неопределено Тогда
			Группа.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Группы;

КонецФункции

// Ссылки, для которых условие ПДн точно не выполняется. Запрос с РАЗРЕШЕННЫЕ:
// ссылки, которые пользователь не может прочитать, в результат не попадут и будут замаскированы.
// Псевдоним Т - из формата условий ПДн, см. ОшибкаПравила.
Функция СсылкиБезПДн(ПолноеИмя, Условие, Ссылки)

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ Т.Ссылка КАК Ссылка ИЗ %1 КАК Т ГДЕ Т.Ссылка В (&Ссылки) И НЕ (%2)",
		ПолноеИмя, Условие);
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
