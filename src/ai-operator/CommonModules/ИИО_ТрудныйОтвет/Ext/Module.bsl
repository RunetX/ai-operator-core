// Трудный ответ канала бота - тот, для которого готового способа ответить не нашлось («честный отказ»).
// По его признакам к ответу добавляется одна строка «цифру стоит перепроверить», а маскированный вопрос, шаги
// и признаки идут в журнал обмена с моделью: администратор видит список таких вопросов с частотой - каких
// готовых способов не хватает. Признаки накапливает ход агента (ИИО_Агент), здесь - что именно считается
// трудным и какой повтор вызова отклоняется.

#Область СлужебныйПрограммныйИнтерфейс

// Пустые признаки хода: их дополняют УчестьВызов, УчестьПовтор и УчестьИтоговыйШаг.
//
// Возвращаемое значение:
//  Структура:
//   * Ошибки - Массив из Строка - Коды ошибок инструментов (QUERY_SYNTAX и т. п.), каждый по одному разу.
//   * Предупреждения - Массив из Строка - Коды предупреждений run_query, каждый по одному разу.
//   * Повторов - Число - Сколько повторов вызова отклонено за ход.
//   * ИтоговыйШаг - Булево - Ход закончился ответом по уже собранным данным.
//   * ЕстьЗапрос - Булево - Данные для ответа собраны run_query.
//   * ГотовыйСпособ - Булево - Ход опирался на готовый инструмент: штатный отчет, разбор ошибки
//     или инструмент пакета.
//   * Выполненные - Соответствие из КлючИЗначение - Вызовы хода, повтор которых отклоняется: ключ -
//     см. КлючВызова, значение - Истина.
Функция НовыеПризнаки() Экспорт

	Признаки = Новый Структура("Ошибки, Предупреждения, Выполненные", Новый Массив, Новый Массив, Новый Соответствие);
	Признаки.Вставить("Повторов", 0);
	Признаки.Вставить("ИтоговыйШаг", Ложь);
	Признаки.Вставить("ЕстьЗапрос", Ложь);
	Признаки.Вставить("ГотовыйСпособ", Ложь);
	Возврат Признаки;

КонецФункции

// Ключ вызова инструмента для отказа в повторе: имя с аргументами.
//
// Параметры:
//  Имя - Строка - Имя инструмента.
//  Аргументы - Соответствие - Аргументы вызова от модели.
//
// Возвращаемое значение:
//  Строка
Функция КлючВызова(Имя, Аргументы) Экспорт

	Возврат Имя + " " + ИИО_ОтветКлиентСервер.ВJSON(Аргументы);

КонецФункции

// Проверяет, был ли за ход вызов с тем же ключом, повтор которого отклоняется: его результат будет тем же.
//
// Параметры:
//  Признаки - см. НовыеПризнаки
//  КлючВызова - см. КлючВызова
//
// Возвращаемое значение:
//  Булево
Функция ЭтоПовтор(Признаки, КлючВызова) Экспорт

	Возврат Признаки.Выполненные.Получить(КлючВызова) <> Неопределено;

КонецФункции

// Учитывает в признаках выполненный вызов: ошибку, предупреждения, то, чем собран ответ, и сам вызов
// для отказа в повторе.
//
// Параметры:
//  Признаки - см. НовыеПризнаки
//  Инструмент - Структура, Неопределено - Инструмент из реестра хода, см. ИИО_РеестрИнструментов.НовыйКонтекстВызова;
//    Неопределено - инструмента с таким именем нет или в вызове нет имени.
//  Ответ - Структура, Соответствие - Ответ инструмента, как он уходит модели.
//  КлючВызова - Строка - см. КлючВызова; пустая строка - вызов не запоминается.
Процедура УчестьВызов(Признаки, Инструмент, Ответ, КлючВызова = "") Экспорт

	// Временная ошибка (фоновое задание отменено) повтор не запрещает: следующий такой вызов может дать ответ.
	Если ЗначениеЗаполнено(КлючВызова) И ИИО_ОтветКлиентСервер.КодОшибки(Ответ) <> "NOT_READY" Тогда
		Признаки.Выполненные.Вставить(КлючВызова, Истина);
	КонецЕсли;
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) Тогда
		ДобавитьКод(Признаки.Ошибки, ИИО_ОтветКлиентСервер.КодОшибки(Ответ));
		Возврат;
	ИначеЕсли Инструмент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Инструмент.Имя = "run_query" Тогда
		Признаки.ЕстьЗапрос = Истина;
		Для Каждого Код Из КодыПредупреждений(Ответ) Цикл
			ДобавитьКод(Признаки.Предупреждения, Код);
		КонецЦикла;
	КонецЕсли;
	// Инструмент пакета (вертикали) - рецепт под задачу: его ответ тоже готовый.
	Признаки.ГотовыйСпособ = Признаки.ГотовыйСпособ Или ЗначениеЗаполнено(Инструмент.Модуль)
		Или ГотовыеИнструментыЯдра().Найти(Инструмент.Имя) <> Неопределено;

КонецПроцедуры

// Учитывает отклоненный повтор вызова инструмента с теми же аргументами.
//
// Параметры:
//  Признаки - см. НовыеПризнаки
Процедура УчестьПовтор(Признаки) Экспорт

	Признаки.Повторов = Признаки.Повторов + 1;

КонецПроцедуры

// Отмечает, что ход закончился итоговым шагом - ответом по уже собранным данным.
//
// Параметры:
//  Признаки - см. НовыеПризнаки
Процедура УчестьИтоговыйШаг(Признаки) Экспорт

	Признаки.ИтоговыйШаг = Истина;

КонецПроцедуры

// Коды признаков трудного ответа. Пустой массив - ход обычный: строка о перепроверке не нужна и в список
// недостающих рецептов ход не попадает.
//
// Ход, который опирался на готовый инструмент (штатный отчет, разбор ошибки, инструмент пакета), трудным
// не считается: его цифры совпадают с тем, что видит пользователь в форме, а строка о перепроверке на простом
// ответе только раздражает.
//
// Параметры:
//  Признаки - см. НовыеПризнаки
//  Шагов - Число - Сколько раз вызвана модель за ход.
//  РазрешеноШагов - Число - Лимит шагов хода (настройка ИИО_ШагиАгента): порог - его половина.
//
// Возвращаемое значение:
//  Массив из Строка - Коды: query_only, steps, repeat, summary, error:QUERY_SYNTAX, warning:STALE_REGISTER.
Функция Коды(Признаки, Шагов, РазрешеноШагов) Экспорт

	Коды = Новый Массив;
	Если Признаки.ГотовыйСпособ Тогда
		Возврат Коды;
	КонецЕсли;
	Если Признаки.ЕстьЗапрос Тогда
		Коды.Добавить("query_only");
	КонецЕсли;
	Если Признаки.ИтоговыйШаг Тогда
		Коды.Добавить("summary");
	КонецЕсли;
	Если Признаки.Повторов > 0 Тогда
		Коды.Добавить("repeat");
	КонецЕсли;
	Если Шагов * 2 > РазрешеноШагов Тогда
		Коды.Добавить("steps");
	КонецЕсли;
	Для Каждого Код Из Признаки.Ошибки Цикл
		Коды.Добавить("error:" + Код);
	КонецЦикла;
	Для Каждого Код Из Признаки.Предупреждения Цикл
		Коды.Добавить("warning:" + Код);
	КонецЦикла;
	Возврат Коды;

КонецФункции

// Строка, которая добавляется к ответу трудного хода. Пользователь должен понимать, что цифру ИИ-оператор
// собрал сам, а не взял из штатного отчета.
//
// Возвращаемое значение:
//  Строка
Функция СтрокаОПерепроверке() Экспорт

	Возврат НСтр("ru = 'Готового способа ответить на такой вопрос нет: цифру стоит перепроверить.'");

КонецФункции

// Служебная строка итогового шага: модель отвечает по собранным данным, инструментов в этом запросе нет.
//
// Возвращаемое значение:
//  Строка
Функция ЗаданиеИтоговогоШага() Экспорт

	Возврат НСтр("ru = 'Инструментов больше нет. Ответь по уже полученным данным: что удалось выяснить, что выяснить не удалось и какого уточнения не хватает.'");

КонецФункции

// Ответ модели на повтор вызова инструмента с теми же аргументами в одном ходе: вызов не выполняется.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ОтветКлиентСервер.Ошибка
Функция ОшибкаПовтора() Экспорт

	Возврат ИИО_ОтветКлиентСервер.Ошибка("REPEATED_CALL",
		НСтр("ru = 'Такой вызов с теми же аргументами в этом ходе уже был: результат будет тем же.'"),
		НСтр("ru = 'Не повторяй вызов. Измени аргументы, возьми другой инструмент или ответь по собранным данным.'"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инструменты ядра, ответ которых готов: штатный отчет и разбор ошибки проведения. Остальное (запрос,
// метаданные, поиск) модель складывает в ответ сама.
//
// Возвращаемое значение:
//  Массив из Строка
Функция ГотовыеИнструментыЯдра()

	Возврат СтрРазделить("run_report,explain_error", ",");

КонецФункции

// Коды предупреждений ответа run_query о признаках тихой ошибки.
//
// Параметры:
//  Ответ - Структура, Соответствие
//
// Возвращаемое значение:
//  Массив из Строка
Функция КодыПредупреждений(Ответ)

	Коды = Новый Массив;
	Список = ИИО_ОтветКлиентСервер.Аргумент(Ответ, "warnings");
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Коды;
	КонецЕсли;
	Для Каждого Предупреждение Из Список Цикл
		Код = ИИО_ОтветКлиентСервер.Аргумент(Предупреждение, "code");
		Если ТипЗнч(Код) = Тип("Строка") Тогда
			Коды.Добавить(Код);
		КонецЕсли;
	КонецЦикла;
	Возврат Коды;

КонецФункции

// Добавляет код, если его еще нет и список не перебрал предел: признаки пишутся в журнал одной строкой.
//
// Параметры:
//  Коды - Массив из Строка
//  Код - Строка, Произвольный
Процедура ДобавитьКод(Коды, Код)

	Если ТипЗнч(Код) = Тип("Строка") И ЗначениеЗаполнено(Код)
		И Коды.Найти(Код) = Неопределено И Коды.Количество() < МаксимумКодов() Тогда
		Коды.Добавить(Код);
	КонецЕсли;

КонецПроцедуры

Функция МаксимумКодов()

	Возврат 5;

КонецФункции

#КонецОбласти
