// Фоновые задания модели: запуск через БСП ДлительныеОперации и разбор результата.
// Общие для run_query и run_report. Модуль только серверный: запускать произвольные функции с клиента нельзя.

#Область СлужебныйПрограммныйИнтерфейс

// Запускает серверную функцию в фоновом задании.
//
// Параметры:
//  ИмяФункции - Строка - Экспортная функция серверного модуля, получает Параметр и возвращает ответ для модели.
//  Параметр - Произвольный - Подготовленные данные задания.
//  Наименование - Строка - Наименование фонового задания.
//  ТаймаутСек - Число - Сколько задание может выполняться после старта.
//  Вид - Строка - query или report: от вида зависят подсказки в ошибках.
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗадания - УникальныйИдентификатор
//   * АдресРезультата - Строка
//   * ТаймаутСек - Число
//   * ОжиданиеОчередиСек - Число - Сколько ждать старта задания.
//   * Вид - Строка
//   * Ответ - Структура, Неопределено - Ответ, если задание завершилось сразу.
Функция Запустить(ИмяФункции, Параметр, Наименование, ТаймаутСек, Вид) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;
	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Параметр);

	Запуск = Новый Структура;
	Запуск.Вставить("ИдентификаторЗадания", Операция.ИдентификаторЗадания);
	Запуск.Вставить("АдресРезультата", Операция.АдресРезультата);
	Запуск.Вставить("ТаймаутСек", ТаймаутСек);
	Запуск.Вставить("ОжиданиеОчередиСек", ИИО_Настройки.Значение("ИИО_ОжиданиеОчередиСек"));
	Запуск.Вставить("Вид", Вид);
	Запуск.Вставить("Ответ", ОтветЗавершеннойОперации(Операция.Статус, Операция.КраткоеПредставлениеОшибки,
		Операция.АдресРезультата, Вид));
	Возврат Запуск;

КонецФункции

// Ответ для модели по завершенной операции.
//
// Параметры:
//  Статус - Строка - Статус операции БСП: Выполняется, Выполнено, Ошибка, Отменено.
//  ТекстОшибки - Строка
//  АдресРезультата - Строка
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ответ или Неопределено, если задание еще выполняется.
Функция ОтветЗавершеннойОперации(Статус, ТекстОшибки, АдресРезультата, Вид) Экспорт

	Если Статус = "Выполнено" Тогда
		Ответ = ПолучитьИзВременногоХранилища(АдресРезультата);
		Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
			Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL",
				НСтр("ru = 'Результат задания не найден во временном хранилище.'"));
		КонецЕсли;
		Возврат Ответ;
	ИначеЕсли Статус = "Ошибка" Тогда
		Возврат ОшибкаВыполнения(ТекстОшибки, Вид);
	ИначеЕсли Статус = "Отменено" Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY", НСтр("ru = 'Фоновое задание отменено.'"),
			НСтр("ru = 'Повтори вызов.'"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ошибки при выполнении, а не при подготовке: деление на ноль, несовпадение типов, нет права на данные.
//
// Параметры:
//  ТекстОшибки - Строка - Краткое представление ошибки фонового задания.
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура - Ошибка ACTION_DENIED или INVALID_ARGUMENT для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ОшибкаВыполнения(ТекстОшибки, Вид)

	Если СтрНайти(НРег(ТекстОшибки), "недостаточно прав") > 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED", ТекстОшибки,
			НСтр("ru = 'У пользователя 1С нет права читать часть данных. Не обходи ограничение: скажи пользователю, каких данных не хватает.'"));
	КонецЕсли;
	Если Вид = "report" Тогда
		Подсказка = НСтр("ru = 'Отчет не сформировался. Проверь отборы и период; если ошибка повторится, открой отчет пользователю или используй run_query.'");
	Иначе
		Подсказка =
			НСтр("ru = 'Запрос разобран, но при выполнении произошла ошибка. Проверь выражения и значения параметров.'");
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", ТекстОшибки, Подсказка);

КонецФункции

#КонецОбласти
