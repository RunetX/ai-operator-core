// Фоновые задания модели: запуск через БСП ДлительныеОперации и разбор результата.
// Общие для run_query и run_report. Модуль только серверный: запускать произвольные функции с клиента нельзя.

#Область СлужебныйПрограммныйИнтерфейс

// Запускает серверную функцию в фоновом задании.
//
// Параметры:
//  ИмяФункции - Строка - Экспортная функция серверного модуля, получает Параметр и возвращает ответ для модели.
//  Параметр - Произвольный - Подготовленные данные задания.
//  Наименование - Строка - Наименование фонового задания.
//  ТаймаутСек - Число - Сколько задание может выполняться после старта.
//  Вид - Строка - query или report: от вида зависят подсказки в ошибках.
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗадания - УникальныйИдентификатор
//   * АдресРезультата - Строка
//   * ТаймаутСек - Число
//   * ОжиданиеОчередиСек - Число - Сколько ждать старта задания.
//   * Вид - Строка
//   * Ответ - Структура, Неопределено - Ответ, если задание завершилось сразу.
Функция Запустить(ИмяФункции, Параметр, Наименование, ТаймаутСек, Вид) Экспорт

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = Наименование;
	Операция = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, ИмяФункции, Параметр);

	Запуск = Новый Структура;
	Запуск.Вставить("ИдентификаторЗадания", Операция.ИдентификаторЗадания);
	Запуск.Вставить("АдресРезультата", Операция.АдресРезультата);
	Запуск.Вставить("ТаймаутСек", ТаймаутСек);
	Запуск.Вставить("ОжиданиеОчередиСек", ИИО_Настройки.Значение("ИИО_ОжиданиеОчередиСек"));
	Запуск.Вставить("Вид", Вид);
	Запуск.Вставить("Ответ", ОтветЗавершеннойОперации(Операция.Статус, Операция.КраткоеПредставлениеОшибки,
		Операция.АдресРезультата, Вид));
	Возврат Запуск;

КонецФункции

// Ответ для модели по завершенной операции.
//
// Параметры:
//  Статус - Строка - Статус операции БСП: Выполняется, Выполнено, Ошибка, Отменено.
//  ТекстОшибки - Строка
//  АдресРезультата - Строка
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ответ или Неопределено, если задание еще выполняется.
Функция ОтветЗавершеннойОперации(Статус, ТекстОшибки, АдресРезультата, Вид) Экспорт

	Если Статус = "Выполнено" Тогда
		Ответ = ПолучитьИзВременногоХранилища(АдресРезультата);
		Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
			Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL",
				НСтр("ru = 'Результат задания не найден во временном хранилище.'"));
		КонецЕсли;
		Возврат Ответ;
	ИначеЕсли Статус = "Ошибка" Тогда
		Возврат ОшибкаВыполнения(ТекстОшибки, Вид);
	ИначеЕсли Статус = "Отменено" Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY", НСтр("ru = 'Фоновое задание отменено.'"),
			НСтр("ru = 'Повтори вызов.'"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Синхронно ждет задание, запущенное Запустить, по тем же правилам, что клиентское ожидание
// канала MCP (ИИО_ФоновыеЗаданияКлиент): лимит очереди до старта, таймаут после старта, отмена.
// Для канала бота: ход агента выполняется на сервере и ждет ответа инструмента.
//
// Параметры:
//  Запуск - см. Запустить
//  Начало - Число - Момент вызова инструмента, мс.
//  Настройка - Структура - КодТаймаута, ТекстТаймаута (с %1 - секунды), ПодсказкаТаймаута.
//  СрокМс - Число, Неопределено - Момент, позже которого не ждать (срок хода агента).
//
// Возвращаемое значение:
//  Структура - Ответ для модели: wait_ms вместо run_ms, как в канале MCP.
Функция Дождаться(Запуск, Начало, Настройка, СрокМс = Неопределено) Экспорт

	Если Запуск.Ответ <> Неопределено Тогда
		Возврат ОтветСОжиданием(Запуск.Ответ, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	КонецЕсли;
	Старт = Неопределено;
	Пока Истина Цикл
		Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Запуск.ИдентификаторЗадания);
		Если Задание <> Неопределено Тогда
			Попытка
				Задание.ОжидатьЗавершенияВыполнения(1);
			Исключение
				// Задание завершилось с ошибкой или ожидание истекло: состояние читается ниже.
			КонецПопытки;
		КонецЕсли;
		Состояние = ИИО_ФоновыеЗаданияВызовСервера.СостояниеЗадания(Запуск.ИдентификаторЗадания,
			Запуск.АдресРезультата, Старт = Неопределено, Запуск.Вид);
		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Если Состояние.Ответ <> Неопределено Тогда
			Возврат ОтветСОжиданием(Состояние.Ответ, Сейчас - Начало);
		КонецЕсли;
		Если Задание = Неопределено Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", НСтр("ru = 'Фоновое задание не найдено.'"));
		КонецЕсли;
		Если Старт = Неопределено И Состояние.Начат Тогда
			Старт = Сейчас;
		КонецЕсли;
		Если Старт = Неопределено И Сейчас - Начало > Запуск.ОжиданиеОчередиСек * 1000 Тогда
			ДлительныеОперации.ОтменитьВыполнениеЗадания(Запуск.ИдентификаторЗадания);
			Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
				СтрШаблон(
					НСтр("ru = 'Задание не начало выполняться за %1 с и отменено: база занята своими фоновыми заданиями.'"),
					Формат(Запуск.ОжиданиеОчередиСек, "ЧГ=0")),
				НСтр("ru = 'Повтори через пару минут. Так бывает в первые минуты после запуска 1С и во время регламентных заданий.'"));
		КонецЕсли;
		Если Старт <> Неопределено И Сейчас - Старт > Запуск.ТаймаутСек * 1000
			Или СрокМс <> Неопределено И Сейчас > СрокМс Тогда
			ДлительныеОперации.ОтменитьВыполнениеЗадания(Запуск.ИдентификаторЗадания);
			Возврат ИИО_ОтветКлиентСервер.Ошибка(Настройка.КодТаймаута,
				СтрШаблон(Настройка.ТекстТаймаута, Формат(Окр((Сейчас - Начало) / 1000), "ЧН=0; ЧГ=0")),
				Настройка.ПодсказкаТаймаута);
		КонецЕсли;
	КонецЦикла;

КонецФункции

// Ждет на сервере. Функции ожидания на сервере нет: фоновое задание ждет завершения самого себя с таймаутом.
// Вне фонового задания (вызов с клиента, внешнее соединение) так подождать нельзя.
//
// Параметры:
//  Секунд - Число
//
// Возвращаемое значение:
//  Булево - Ложь, если вызов не в фоновом задании или ожидание прервалось раньше срока.
Функция Подождать(Секунд) Экспорт

	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если Задание = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Задание.ОжидатьЗавершенияВыполнения(Секунд);
	Исключение
		// Ожидание самого себя истекает по таймауту исключением: это и есть пауза. Другой отказ платформы
		// прерывает ожидание раньше срока, он пишется в журнал.
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало >= Секунд * 1000 Тогда
			Возврат Истина;
		КонецЕсли;
		ИИО_Журнал.ЗаписатьСобытие("ФоновоеЗадание.Ожидание", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Время работы задания заменяется временем ожидания в очереди: все время вызова за вычетом работы задания.
//
// Параметры:
//  Ответ - Структура - Ответ задания или ошибка для модели.
//  ПрошлоМс - Число - Время от вызова инструмента, мс.
//
// Возвращаемое значение:
//  Структура - Ответ с wait_ms вместо run_ms; ошибка - как есть.
Функция ОтветСОжиданием(Ответ, ПрошлоМс)

	Если Не ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) И ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("run_ms") Тогда
		Ответ.Вставить("wait_ms", Макс(0, ПрошлоМс - Ответ.run_ms));
		Ответ.Удалить("run_ms");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Ошибки при выполнении, а не при подготовке: деление на ноль, несовпадение типов, нет права на данные.
//
// Параметры:
//  ТекстОшибки - Строка - Краткое представление ошибки фонового задания.
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура - Ошибка ACTION_DENIED или INVALID_ARGUMENT для модели, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ОшибкаВыполнения(ТекстОшибки, Вид)

	Если СтрНайти(НРег(ТекстОшибки), "недостаточно прав") > 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED", ТекстОшибки,
			НСтр("ru = 'У пользователя 1С нет права читать часть данных. Не обходи ограничение: скажи пользователю, каких данных не хватает.'"));
	КонецЕсли;
	Если Вид = "report" Тогда
		Подсказка = НСтр("ru = 'Отчет не сформировался. Проверь отборы и период; если ошибка повторится, открой отчет пользователю или используй run_query.'");
	Иначе
		Подсказка =
			НСтр("ru = 'Запрос разобран, но при выполнении произошла ошибка. Проверь выражения и значения параметров.'");
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", ТекстОшибки, Подсказка);

КонецФункции

#КонецОбласти
