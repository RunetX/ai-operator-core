	Определения.Добавить(НовоеОпределение("describe_metadata", СхемаОбъекта(Свойства),
		"ИИО_ИнструментыКлиент.ВыполнитьНаСервере", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Текст запроса на языке запросов 1С. Можно пакет с ПОМЕСТИТЬ во временные таблицы: "
		+ "модель получает результат последней выборки."));
	Свойства.Вставить("params", СвойствоСхемы("object",
		"Значения параметров &Имя: {""Имя"": значение}. Даты в ISO 8601 (2025-01-31), "
		+ "ссылки строкой ref из ответов инструментов, списки массивами."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько строк вернуть, по умолчанию 50. Больше лимита, заданного администратором (обычно 200), не вернется."));
	Свойства.Вставить("timeout_sec", СвойствоСхемы("integer",
		"Таймаут выполнения, с. Можно только сократить таймаут, заданный администратором (обычно 30)."));
	Определения.Добавить(НовоеОпределение("run_query", СхемаОбъекта(Свойства, "text"),
		"ИИО_ЗапросыКлиент.ВыполнитьЗапрос", Истина, Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("kind", СвойствоСхемы("string",
		"Где искать: полное имя (Справочник.Контрагенты, Документ.РеализацияТоваровУслуг) или синоним (Контрагенты)."));
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Что искать, как сказал пользователь: наименование или его часть, ИНН, код, номер документа."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько кандидатов вернуть, по умолчанию 10, не больше 50."));
	Определения.Добавить(НовоеОпределение("find_ref", СхемаОбъекта(Свойства, "kind, text"),
		"ИИО_ИнструментыКлиент.ВыполнитьНаСервере", , Истина));

	СвойствоСсылок = СвойствоСсылок();
	Свойства = Новый Структура;
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("title", СвойствоСхемы("string",
		"Заголовок окна для пользователя, например «Реализации Рога и копыта за март 2016»."));
	Определения.Добавить(НовоеОпределение("show_in_1c", СхемаОбъекта(Свойства, "refs"),
