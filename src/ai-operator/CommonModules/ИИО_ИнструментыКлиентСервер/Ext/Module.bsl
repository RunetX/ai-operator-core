	Определения.Добавить(НовоеОпределение("close_forms", Неопределено, "ИИО_ФормыКлиент.ЗакрытьФормы"));

	Возврат Определения;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Ответ ACTION_DENIED: у пользователя нет роли ИИ-оператора.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ОтветКлиентСервер.Ошибка
Функция ОшибкаНетРоли() Экспорт

	Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
		НСтр("ru = 'У пользователя 1С нет роли «Пользователь ИИ-оператора».'"),
		НСтр("ru = 'Скажи пользователю попросить администратора 1С добавить роль в профиль его группы доступа.'"));

КонецФункции

// Ответ NOT_FOUND: инструмента нет в реестре канала.
//
// Параметры:
//  ИмяИнструмента - Строка
//
// Возвращаемое значение:
//  Структура - см. ИИО_ОтветКлиентСервер.Ошибка
Функция ОшибкаНетИнструмента(ИмяИнструмента) Экспорт

	Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
		СтрШаблон(НСтр("ru = 'Инструмент %1 не найден.'"), ИмяИнструмента));

КонецФункции

// Ответ INTERNAL на исключение в обработчике инструмента. Подробности - только для журнала,
// см. ПодготовитьОтвет.
//
// Параметры:
//  Информация - ИнформацияОбОшибке
//
// Возвращаемое значение:
//  Структура - см. ИИО_ОтветКлиентСервер.Ошибка
Функция ВнутренняяОшибка(Информация) Экспорт

	Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	Ответ.error.Вставить("ПодробноеПредставление", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;

КонецФункции

// Ответ обработчика инструмента: если обработчик ничего не вернул - ошибка INTERNAL.
//
// Параметры:
//  Ответ - Структура, Соответствие, Неопределено - Что вернул обработчик.
//
// Возвращаемое значение:
//  Структура, Соответствие
Функция ОтветОбработчика(Ответ) Экспорт

	Если Ответ = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", НСтр("ru = 'Инструмент не вернул ответ.'"));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Готовит ответ для модели: маскирует ПДн словарем канала и пишет вызов в журнал регистрации, а при заданном
// разговоре - еще и в журнал обмена с моделью: аргументы, как их прислала модель, и ответ, как он
// уходит модели, - с токенами вместо ПДн. Все, что уходит модели, проходит через эту точку.
// Выполняется там, где живет словарь (клиент канала MCP, сервер канала бота): словарь с реальными значениями
// никуда не передается, сводку скрытого считает этот же контекст.
//
// Параметры:
//  Вызов - Структура - Вызов инструмента:
//   * Инструмент - Строка
//   * Источник - Строка - mcp, bot, journal, test.
//   * Начало - Число - Момент начала вызова, мс.
//   * Аргументы - Структура, Соответствие - Аргументы как от модели.
//  Ответ - Структура, Соответствие - Ответ инструмента или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//  Разговор - Строка, Неопределено - Ключ разговора журнала обмена; Неопределено - в журнал обмена не писать.
//
// Возвращаемое значение:
//  Структура, Соответствие - Копия ответа с токенами вместо ПДн.
Функция ПодготовитьОтвет(Вызов, Ответ, Словарь, Разговор = Неопределено) Экспорт

	Замаскированный = ИИО_МаскированиеКлиентСервер.Замаскировать(Ответ, Словарь);
	Сведения = СведенияДляЖурнала(Вызов, Замаскированный);
	Обмен = Неопределено;
	Если Разговор <> Неопределено Тогда
		ТекстОтвета = ИИО_ОтветКлиентСервер.ВJSON(Замаскированный);
		ОписаниеФункции = Новый Структура("name, arguments", Вызов.Инструмент,
			ИИО_ОтветКлиентСервер.ВJSON(Вызов.Аргументы));
		ВызовМодели = Новый Структура("type, function", "function", ОписаниеФункции);
		Переписка = Новый Массив;
		Переписка.Добавить(Новый Структура("role, content, tool_calls", "assistant", "",
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВызовМодели)));
		Переписка.Добавить(Новый Структура("role, content", "tool", ТекстОтвета));
		Обмен = Новый Структура("Разговор, Скрыто, Переписка", Разговор,
			ИИО_МаскированиеКлиентСервер.СводкаСкрытого(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТекстОтвета),
				Словарь),
			ИИО_ОтветКлиентСервер.ВJSON(Переписка));
	КонецЕсли;
	ИИО_ЖурналВызовСервера.ЗаписатьВызовИнструмента(Сведения, Обмен);
	Возврат Замаскированный;

КонецФункции

// Проверяет инструменты пакета перед добавлением в реестр канала: инструменты пакета попадают в реестр только
// все вместе, поэтому конфликт имени или отсутствие описания у одного пропускает весь пакет. Причина пишется
// в журнал регистрации.
//
// Параметры:
//  ИмяМодуля - Строка - Модуль пакета, который зарегистрировал инструменты.
//  Реестр - Соответствие из КлючИЗначение - Реестр канала: ключ - имя инструмента.
//  Инструменты - Массив из Структура - Инструменты пакета с полем Имя.
//  Описания - Соответствие из КлючИЗначение - Описания инструментов: ключ - имя.
//
// Возвращаемое значение:
//  Булево - Истина, если инструменты пакета можно добавить в реестр.
Функция ИнструментыПакетаДопустимы(ИмяМодуля, Реестр, Инструменты, Описания) Экспорт

	Для Каждого Инструмент Из Инструменты Цикл
		Ошибка = "";
		Если Реестр.Получить(Инструмент.Имя) <> Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Инструмент %1 уже зарегистрирован ядром или другим пакетом.'"),
				Инструмент.Имя);
		ИначеЕсли Описания.Получить(Инструмент.Имя) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Нет описания инструмента %1 в макете пакета.'"), Инструмент.Имя);
		КонецЕсли;
		Если Ошибка <> "" Тогда
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля, Ошибка);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сведения о вызове инструмента для журнала регистрации. Подробное представление ошибки переносится
// из ответа в сведения: модели уходит краткий текст.
//
// Параметры:
//  Вызов - см. ПодготовитьОтвет
//  Ответ - Структура, Соответствие - Замаскированный ответ; из ошибки удаляется ПодробноеПредставление.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ЖурналВызовСервера.ЗаписатьВызовИнструмента
Функция СведенияДляЖурнала(Вызов, Ответ)

	Сведения = Новый Структура;
	Сведения.Вставить("tool", Вызов.Инструмент);
	Сведения.Вставить("source", Вызов.Источник);
	Сведения.Вставить("status", ?(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ),
		ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "ok"));
	Сведения.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Вызов.Начало);
	Сведения.Вставить("arguments", ИИО_ОтветКлиентСервер.Обрезать(ИИО_ОтветКлиентСервер.ВJSON(Вызов.Аргументы), 2000));

	ПодробноеПредставление = "";
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ)
		И Ответ.error.Свойство("ПодробноеПредставление", ПодробноеПредставление) Тогда
		Ответ.error.Удалить("ПодробноеПредставление");
		Сведения.Вставить("details", ПодробноеПредставление);
	КонецЕсли;
	Возврат Сведения;

КонецФункции

// Свойство action инструмента perform: действия ядра и действия пакетов.
//
// Параметры:
//  ДействияПакетов - см. Определения
//
// Возвращаемое значение:
//  Структура - см. СвойствоСхемы
Функция СвойствоДействия(ДействияПакетов)

	Коды = СтрРазделить("post,unpost", ",");
	Пояснения = Новый Массив;
	Пояснения.Добавить("post - провести документы, unpost - отменить проведение");
	Если ДействияПакетов <> Неопределено Тогда
		Для Каждого Описание Из ДействияПакетов Цикл
			Коды.Добавить(Описание.Код);
			Пояснения.Добавить(Описание.Код + " - " + НРег(Лев(Описание.Представление, 1))
				+ Сред(Описание.Представление, 2));
		КонецЦикла;
	КонецЕсли;
	Возврат СвойствоСхемы("string", "Действие: " + СтрСоединить(Пояснения, ", ") + ".", Коды);

КонецФункции

Функция СвойствоСсылок()

	Свойство = СвойствоСхемы("array",
		"Ссылки из ответов инструментов: строки ref (Документ.РеализацияТоваровУслуг:<УИД>) "
		+ "или объекты {""ref"": ...}.");
	Свойство.Вставить("items", Новый Структура);
	Возврат Свойство;

КонецФункции

#КонецОбласти
