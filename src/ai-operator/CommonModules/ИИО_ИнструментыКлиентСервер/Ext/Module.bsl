// Определения встроенных инструментов ИИ-оператора: имя, схема аргументов, обработчики каналов.
// Из них строятся клиентский реестр канала MCP (ИИО_РеестрИнструментовКлиент) и серверный реестр
// канала бота (ИИО_РеестрИнструментов). Описания для модели - в макете ИИО_ОписанияИнструментов.

#Область ПрограммныйИнтерфейс

// Создает определение инструмента.
//
// Параметры:
//  Имя - Строка - Имя инструмента для модели, на английском.
//  Схема - Структура, Неопределено - JSON Schema аргументов, см. СхемаОбъекта; Неопределено - без аргументов.
//  ОбработчикКлиента - Строка - "Модуль.Функция" клиентского обработчика канала MCP,
//    см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент; пустая строка - инструмента нет в канале MCP.
//  ОтложенныйОтвет - Булево - Клиентский обработчик завершает вызов позже.
//  ВБоте - Булево - Инструмент есть в канале бота: его выполняет сервер, см. ИИО_ИнструментыБота.ВыполнитьИнструмент.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка
//   * Схема - Структура
//   * ОбработчикКлиента - Строка
//   * ОтложенныйОтвет - Булево
//   * ВБоте - Булево
Функция НовоеОпределение(Имя, Схема, ОбработчикКлиента, ОтложенныйОтвет = Ложь, ВБоте = Ложь) Экспорт

	Определение = Новый Структура;
	Определение.Вставить("Имя", Имя);
	Определение.Вставить("Схема", ?(Схема = Неопределено, СхемаОбъекта(Новый Структура), Схема));
	Определение.Вставить("ОбработчикКлиента", ОбработчикКлиента);
	Определение.Вставить("ОтложенныйОтвет", ОтложенныйОтвет);
	Определение.Вставить("ВБоте", ВБоте);
	Возврат Определение;

КонецФункции

// JSON Schema объекта аргументов.
//
// Параметры:
//  Свойства - Структура - Свойства, см. СвойствоСхемы.
//  Обязательные - Строка - Имена обязательных свойств через запятую.
//
// Возвращаемое значение:
//  Структура
Функция СхемаОбъекта(Свойства, Обязательные = "") Экспорт

	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Если ЗначениеЗаполнено(Обязательные) Тогда
		Схема.Вставить("required", СтрРазделить(СтрЗаменить(Обязательные, " ", ""), ","));
	КонецЕсли;
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

// Свойство JSON Schema.
//
// Параметры:
//  Тип - Строка - string, integer, number, boolean, object, array.
//  Описание - Строка - Описание свойства для модели.
//  ДопустимыеЗначения - Массив, Неопределено - Значения enum.
//
// Возвращаемое значение:
//  Структура
Функция СвойствоСхемы(Тип, Описание, ДопустимыеЗначения = Неопределено) Экспорт

	Свойство = Новый Структура("type, description", Тип, Описание);
	Если ДопустимыеЗначения <> Неопределено Тогда
		Свойство.Вставить("enum", ДопустимыеЗначения);
	КонецЕсли;
	Возврат Свойство;

КонецФункции

// Определения встроенных инструментов в порядке регистрации.
//
// Параметры:
//  ДействияПакетов - Массив из Структура, Неопределено - Действия пакетов для схемы perform:
//    поля Код и Представление, см. ИИО_Действия.ДействияПакетов.
//
// Возвращаемое значение:
//  Массив из см. НовоеОпределение
Функция Определения(ДействияПакетов = Неопределено) Экспорт

	Определения = Новый Массив;

	Определения.Добавить(НовоеОпределение("ping", Неопределено, "ИИО_ИнструментыКлиент.Ping"));

	Свойства = Новый Структура;
	Свойства.Вставить("name", СвойствоСхемы("string",
		"Полное имя объекта метаданных, например Справочник.Контрагенты или Документ.РеализацияТоваровУслуг. "
		+ "Если не задано - список объектов."));
	Свойства.Вставить("kind", СвойствоСхемы("string",
		"Вид объектов для списка.", ИИО_МетаданныеКлиентСервер.ВидыОбъектов()));
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Часть имени или синонима для отбора списка, без учета регистра."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько объектов вернуть в списке, по умолчанию 100, не больше 500."));
	Определения.Добавить(НовоеОпределение("describe_metadata", СхемаОбъекта(Свойства),
		"ИИО_ИнструментыКлиент.ОписатьМетаданные", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Текст запроса на языке запросов 1С. Можно пакет с ПОМЕСТИТЬ во временные таблицы: "
		+ "модель получает результат последней выборки."));
	Свойства.Вставить("params", СвойствоСхемы("object",
		"Значения параметров &Имя: {""Имя"": значение}. Даты в ISO 8601 (2025-01-31), "
		+ "ссылки строкой ref из ответов инструментов, списки массивами."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько строк вернуть, по умолчанию 50. Больше лимита, заданного администратором (обычно 200), не вернется."));
	Свойства.Вставить("timeout_sec", СвойствоСхемы("integer",
		"Таймаут выполнения, с. Можно только сократить таймаут, заданный администратором (обычно 30)."));
	Определения.Добавить(НовоеОпределение("run_query", СхемаОбъекта(Свойства, "text"),
		"ИИО_ЗапросыКлиент.ВыполнитьЗапрос", Истина, Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("kind", СвойствоСхемы("string",
		"Где искать: полное имя (Справочник.Контрагенты, Документ.РеализацияТоваровУслуг) или синоним (Контрагенты)."));
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Что искать, как сказал пользователь: наименование или его часть, ИНН, код, номер документа."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько кандидатов вернуть, по умолчанию 10, не больше 50."));
	Определения.Добавить(НовоеОпределение("find_ref", СхемаОбъекта(Свойства, "kind, text"),
		"ИИО_ИнструментыКлиент.НайтиСсылку", , Истина));

	СвойствоСсылок = СвойствоСсылок();
	Свойства = Новый Структура;
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("title", СвойствоСхемы("string",
		"Заголовок окна для пользователя, например «Реализации Рога и копыта за март 2016»."));
	Определения.Добавить(НовоеОпределение("show_in_1c", СхемаОбъекта(Свойства, "refs"),
		"ИИО_ПоказКлиент.ПоказатьВ1С", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", СвойствоСхемы("string",
		"Ссылка из ответа инструмента: строка ref или объект {""ref"": ...}."));
	Свойства.Вставить("view", СвойствоСхемы("string",
		"Что открыть: form - форму объекта (по умолчанию), related - структуру подчиненности, "
		+ "movements - движения документа.",
		СтрРазделить("form,related,movements", ",")));
	Определения.Добавить(НовоеОпределение("open_object", СхемаОбъекта(Свойства, "ref"),
		"ИИО_ПоказКлиент.ОткрытьОбъект", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", СвойствоСхемы("string",
		"Документ: строка ref из ответа инструмента или объект {""ref"": ...}."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько оснований и сколько подчиненных вернуть, по умолчанию 20, не больше 100."));
	Определения.Добавить(НовоеОпределение("related_objects", СхемаОбъекта(Свойства, "ref"),
		"ИИО_ИнструментыКлиент.СвязанныеОбъекты", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("ref", СвойствоСхемы("string",
		"Документ: строка ref из ответа инструмента или объект {""ref"": ...}. "
		+ "Без ref - документ из активного окна 1С пользователя."));
	Свойства.Вставить("minutes", СвойствоСхемы("integer",
		"За сколько последних минут смотреть ошибки пользователя в журнале регистрации, "
		+ "по умолчанию 15, не больше 60."));
	Определения.Добавить(НовоеОпределение("explain_error", СхемаОбъекта(Свойства),
		"ИИО_ИнструментыКлиент.РазобратьОшибку", , Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("form", СвойствоСхемы("string",
		"id печатной формы из ответа print_documents без form, например ТОРГ12."));
	Определения.Добавить(НовоеОпределение("print_documents", СхемаОбъекта(Свойства, "refs"),
		"ИИО_ПоказКлиент.Напечатать"));

	Свойства = Новый Структура;
	Свойства.Вставить("text", СвойствоСхемы("string",
		"Слова из вопроса пользователя: выручка, продажи, задолженность, остатки. "
		+ "Без text - все поддерживаемые отчеты."));
	Свойства.Вставить("report", СвойствоСхемы("string",
		"Полное имя отчета, например Отчет.Продажи: вернуть его варианты, поля отборов и строк, показатели."));
	Свойства.Вставить("limit", СвойствоСхемы("integer",
		"Сколько вариантов вернуть, по умолчанию 20, не больше 100."));
	Определения.Добавить(НовоеОпределение("list_reports", СхемаОбъекта(Свойства),
		"ИИО_ОтчетыКлиент.НайтиОтчеты", , Истина));

	СвойствоОтборов = СвойствоСхемы("array",
		"Отборы: [{""field"": ""Контрагент"", ""op"": ""eq"", ""value"": ""Справочник.Контрагенты:<УИД>""}]. "
		+ "op: eq, ne, in, not_in, in_hierarchy. Для in - массив значений. Ссылки - ref из ответов инструментов.");
	СвойствоОтборов.Вставить("items", Новый Структура("type", "object"));
	СвойствоГруппировок = СвойствоСхемы("array",
		"Поля строк отчета вместо полей варианта, например [""Контрагент"", ""Документ""] - "
		+ "расшифровка до документов.");
	СвойствоГруппировок.Вставить("items", Новый Структура("type", "string"));
	Свойства = Новый Структура;
	Свойства.Вставить("report", СвойствоСхемы("string",
		"Полное имя отчета из list_reports, например Отчет.Продажи."));
	Свойства.Вставить("variant", СвойствоСхемы("string",
		"Ключ варианта из list_reports. По умолчанию - первый вариант отчета."));
	Свойства.Вставить("period", СвойствоСхемы("object",
		"Период: {""from"": ""2016-01-01"", ""to"": ""2016-03-31""} или {""preset"": ""prev_quarter""}. "
		+ "Пресеты: today, this_week, this_month, prev_month, this_quarter, prev_quarter, this_year, prev_year. "
		+ "По умолчанию - текущий месяц."));
	Свойства.Вставить("filters", СвойствоОтборов);
	Свойства.Вставить("group_by", СвойствоГруппировок);
	Свойства.Вставить("rows", СвойствоСхемы("integer",
		"Сколько строк вернуть, по умолчанию 50. Больше лимита, заданного администратором (обычно 200), не вернется."));
	Свойства.Вставить("show", СвойствоСхемы("boolean",
		"Открыть отчет пользователю в 1С с теми же настройками, по умолчанию true."));
	Свойства.Вставить("timeout_sec", СвойствоСхемы("integer",
		"Таймаут формирования, с. Можно только сократить таймаут, заданный администратором (обычно 30)."));
	Определения.Добавить(НовоеОпределение("run_report", СхемаОбъекта(Свойства, "report"),
		"ИИО_ОтчетыКлиент.СформироватьОтчет", Истина, Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("action", СвойствоДействия(ДействияПакетов));
	Свойства.Вставить("refs", СвойствоСсылок);
	Свойства.Вставить("dry_run", СвойствоСхемы("boolean",
		"Только проверить и показать план в 1С, ничего не меняя. Ответ приходит сразу, без подтверждения."));
	Определения.Добавить(НовоеОпределение("perform", СхемаОбъекта(Свойства, "action, refs"),
		"ИИО_ДействияКлиент.ВыполнитьДействие", Истина, Истина));

	Свойства = Новый Структура;
	Свойства.Вставить("batch_id", СвойствоСхемы("string",
		"Идентификатор пакета из ответа perform."));
	Определения.Добавить(НовоеОпределение("undo", СхемаОбъекта(Свойства, "batch_id"),
		"ИИО_ДействияКлиент.Откатить", Истина));

	Определения.Добавить(НовоеОпределение("close_forms", Неопределено, "ИИО_ФормыКлиент.ЗакрытьФормы"));

	Возврат Определения;

КонецФункции

// Сведения о вызове инструмента для журнала регистрации. Одинаковы для каналов MCP и бота.
// Подробное представление ошибки переносится из ответа в сведения: модели уходит краткий текст.
//
// Параметры:
//  Инструмент - Строка - Имя инструмента.
//  Источник - Строка - mcp, bot, recipe, test.
//  Начало - Число - Момент начала вызова, мс.
//  Аргументы - Структура, Соответствие - Аргументы как от модели.
//  Ответ - Структура, Соответствие - Замаскированный ответ; из ошибки удаляется ПодробноеПредставление.
//
// Возвращаемое значение:
//  Структура - см. ИИО_ЖурналВызовСервера.ЗаписатьВызовИнструмента
Функция СведенияДляЖурнала(Инструмент, Источник, Начало, Аргументы, Ответ) Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("tool", Инструмент);
	Сведения.Вставить("source", Источник);
	Сведения.Вставить("status", ?(ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ),
		ИИО_ОтветКлиентСервер.КодОшибки(Ответ), "ok"));
	Сведения.Вставить("duration_ms", ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);
	Сведения.Вставить("arguments", ИИО_ОтветКлиентСервер.Обрезать(ИИО_ОтветКлиентСервер.ВJSON(Аргументы), 2000));

	ПодробноеПредставление = "";
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ)
		И Ответ.error.Свойство("ПодробноеПредставление", ПодробноеПредставление) Тогда
		Ответ.error.Удалить("ПодробноеПредставление");
		Сведения.Вставить("details", ПодробноеПредставление);
	КонецЕсли;
	Возврат Сведения;

КонецФункции

// Ответ INTERNAL на исключение в обработчике инструмента. Подробности - только для журнала,
// см. СведенияДляЖурнала.
//
// Параметры:
//  Информация - ИнформацияОбОшибке
//
// Возвращаемое значение:
//  Структура - см. ИИО_ОтветКлиентСервер.Ошибка
Функция ВнутренняяОшибка(Информация) Экспорт

	Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация));
	Ответ.error.Вставить("ПодробноеПредставление", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свойство action инструмента perform: действия ядра и действия пакетов.
//
// Параметры:
//  ДействияПакетов - см. Определения
//
// Возвращаемое значение:
//  Структура - см. СвойствоСхемы
Функция СвойствоДействия(ДействияПакетов)

	Коды = СтрРазделить("post,unpost", ",");
	Пояснения = Новый Массив;
	Пояснения.Добавить("post - провести документы, unpost - отменить проведение");
	Если ДействияПакетов <> Неопределено Тогда
		Для Каждого Описание Из ДействияПакетов Цикл
			Коды.Добавить(Описание.Код);
			Пояснения.Добавить(Описание.Код + " - " + НРег(Лев(Описание.Представление, 1))
				+ Сред(Описание.Представление, 2));
		КонецЦикла;
	КонецЕсли;
	Возврат СвойствоСхемы("string", "Действие: " + СтрСоединить(Пояснения, ", ") + ".", Коды);

КонецФункции

Функция СвойствоСсылок()

	Свойство = СвойствоСхемы("array",
		"Ссылки из ответов инструментов: строки ref (Документ.РеализацияТоваровУслуг:<УИД>) "
		+ "или объекты {""ref"": ...}.");
	Свойство.Вставить("items", Новый Структура);
	Возврат Свойство;

КонецФункции

#КонецОбласти
