// Ход агента канала бота: вопрос пользователя -> маскирование ввода -> цикл
// «модель - инструменты» через серверный реестр -> ответ. Модель видит только маскированный текст;
// словарь и маскированная история живут в диалоге. Пользователь получает ответ с реальными значениями.
//
// Ход всегда старается оставить пользователю ответ: повтор вызова
// с теми же аргументами не выполняется, а на последнем шаге, при двух повторах или когда до срока осталось
// меньше одного вызова модели, идет итоговый шаг - запрос без инструментов «ответь по собранным данным».
// Если срок съели инструменты, итоговый шаг все равно идет: ход превышает срок на один вызов модели.
// Признаки трудного хода (ИИО_ТрудныйОтвет) дают строку о перепроверке в ответе и запись в журнале обмена.

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет ход агента: отвечает на вопрос пользователя в диалоге и записывает диалог.
//
// Параметры:
//  Диалог - см. ИИО_Диалоги.Диалог
//  Вопрос - Строка - Текст пользователя как есть.
//  Документ - ЛюбаяСсылка, Неопределено - Объект, в обсуждении которого задан вопрос.
//  СрокМс - Число, Неопределено - Момент (ТекущаяУниверсальнаяДатаВМиллисекундах), к которому ход должен
//    закончиться; итоговый шаг по собранным данным может выйти за срок на один вызов модели.
//
// Возвращаемое значение:
//  Структура:
//   * Ответ - Строка - Ответ пользователю с реальными значениями вместо токенов.
//   * Кнопки - Массив из см. ИИО_РеестрИнструментов.НоваяКнопка
//   * Файлы - Массив из Структура - Файлы хода, см. ИИО_Файлы.НовыйФайл: канал приложит их к ответу.
//   * Статус - Строка - ok, not_configured, model_unavailable, model_error, step_limit, deadline.
//   * Шаги - Число - Сколько раз вызвана модель.
//   * ПроверкаВвода - Строка - Каким путем искались люди в вопросе, см. ИИО_МаскированиеВвода.ЗамаскироватьВвод.
//   * Признаки - Строка - Коды признаков трудного ответа через пробел, см. ИИО_ТрудныйОтвет.Коды;
//     пустая строка - готовый способ ответить нашелся.
Функция ВыполнитьХод(Диалог, Вопрос, Документ = Неопределено, СрокМс = Неопределено) Экспорт

	Результат = Новый Структура("Ответ, Кнопки, Файлы, Статус, Шаги, ПроверкаВвода, Признаки", "", Новый Массив,
		Новый Массив, "ok", 0, "", "");
	Параметры = ИИО_МодельHTTP.ПараметрыМодели();
	Параметры.СрокМс = СрокМс;
	Если Не Параметры.Настроена Тогда
		Результат.Статус = "not_configured";
		Результат.Ответ = ТекстСтатуса(Результат.Статус);
		Возврат Результат;
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Ввод = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Вопрос, Диалог.Словарь);
	Результат.ПроверкаВвода = Ввод.Проверка;
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова(Диалог.Словарь, СрокМс);
	Результат.Кнопки = Контекст.Кнопки;
	Результат.Файлы = Контекст.Файлы;
	Инструменты = ИнструментыМодели(Контекст);
	Сообщения = Новый Массив;
	Сообщения.Добавить(НовоеСообщение("system", СистемныйТекст(Документ, Диалог.Словарь)));
	Для Каждого Сообщение Из Диалог.История Цикл
		Сообщения.Добавить(Сообщение);
	КонецЦикла;
	Сообщения.Добавить(НовоеСообщение("user", Ввод.Текст));
	НачалоХода = Сообщения.ВГраница();

	Сведения = Новый Структура("status, model, steps, tool_calls", "", Параметры.Модель, 0, 0);
	Сведения.Вставить("duration_ms", 0);
	Сведения.Вставить("model_ms", 0);
	Сведения.Вставить("prompt_tokens", 0);
	Сведения.Вставить("completion_tokens", 0);
	Сведения.Вставить("input_check", Ввод.Проверка);
	ОтветМодели = "";
	Признаки = ИИО_ТрудныйОтвет.НовыеПризнаки();
	ОценкаВызоваМс = 0;
	Шагов = ИИО_Настройки.Значение("ИИО_ШагиАгента");
	Для Шаг = 1 По Шагов Цикл
		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
		// Срок мягкий: если инструменты уже вызывались (долгий отчет съел срок), идет итоговый шаг по собранному.
		Если СрокМс <> Неопределено И Сейчас >= СрокМс И Сведения.tool_calls = 0 Тогда
			Результат.Статус = "deadline";
			Прервать;
		КонецЕсли;
		Повод = ПоводИтоговогоШага(Шаг, Шагов, Признаки.Повторов, СрокМс, Сейчас, ОценкаВызоваМс);
		Если Повод <> "" Тогда
			Сообщения.Добавить(НовоеСообщение("user", ИИО_ТрудныйОтвет.ЗаданиеИтоговогоШага()));
			ИИО_ТрудныйОтвет.УчестьИтоговыйШаг(Признаки);
			Сведения.Вставить("summary", Повод);
		КонецЕсли;
		Ответ = ИИО_МодельHTTP.ЗапросЧата(Параметры, Сообщения, ?(Повод = "", Инструменты, Неопределено));
		Сведения.steps = Шаг;
		Сведения.model_ms = Сведения.model_ms + Ответ.ДлительностьМс;
		Если Ответ.ДлительностьМс > ОценкаВызоваМс Тогда
			ОценкаВызоваМс = Ответ.ДлительностьМс;
		КонецЕсли;
		УчестьИспользование(Сведения, Ответ.Использование);
		Если Ответ.Ошибка <> Неопределено Тогда
			Результат.Статус = ?(Ответ.Ошибка.Код = "MODEL_UNAVAILABLE", "model_unavailable", "model_error");
			Сведения.Вставить("error", Ответ.Ошибка.Подробно);
			Прервать;
		КонецЕсли;
		Вызовы = Ответ.Сообщение.Получить("tool_calls");
		Если Повод <> "" Или ТипЗнч(Вызовы) <> Тип("Массив") Или Вызовы.Количество() = 0 Тогда
			ОтветМодели = Ответ.Сообщение.Получить("content");
			// Итоговый шаг без текста ответа не дал: пользователь получает текст статуса.
			Если Повод <> "" И Не ЗначениеЗаполнено(ОтветМодели) Тогда
				Результат.Статус = ?(Повод = "deadline", "deadline", "step_limit");
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Сообщения.Добавить(Новый Структура("role, content, tool_calls", "assistant",
			Ответ.Сообщение.Получить("content"), Вызовы));
		Для Каждого Вызов Из Вызовы Цикл
			Сведения.tool_calls = Сведения.tool_calls + 1;
			Сообщения.Добавить(ВыполнитьВызов(Вызов, Контекст, Признаки));
		КонецЦикла;
	КонецЦикла;
	Результат.Шаги = Сведения.steps;
	Сведения.status = Результат.Статус;
	Сведения.duration_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	КодыПризнаков = ИИО_ТрудныйОтвет.Коды(Признаки, Результат.Шаги, Шагов);
	Результат.Признаки = СтрСоединить(КодыПризнаков, " ");
	Сведения.Вставить("hard", Результат.Признаки);

	Если Результат.Статус = "ok" Тогда
		Диалог.История.Добавить(НовоеСообщение("user", Ввод.Текст));
		Диалог.История.Добавить(НовоеСообщение("assistant", ОтветМодели));
		ОбрезатьИсторию(Диалог.История);
		Результат.Ответ = ИИО_МаскированиеКлиентСервер.Демаскировать(ОтветМодели, Диалог.Словарь);
		// Строка о перепроверке уходит пользователю, но не в историю: иначе модель начнет повторять ее сама.
		Если КодыПризнаков.Количество() > 0 Тогда
			Результат.Ответ = Результат.Ответ + Символы.ПС + ИИО_ТрудныйОтвет.СтрокаОПерепроверке();
		КонецЕсли;
	Иначе
		Результат.Ответ = ТекстСтатуса(Результат.Статус);
	КонецЕсли;
	ИИО_Диалоги.Записать(Диалог);
	Итог = Новый Структура("ОтветМодели, Вопрос, Признаки", ?(Результат.Статус = "ok", ОтветМодели, Неопределено),
		Ввод.Текст, Результат.Признаки);
	ЗаписатьВЖурналОбмена(Диалог, Документ, Параметры, Сведения, Сообщения, НачалоХода, Итог);
	ИИО_Журнал.ЗаписатьСобытие("ВызовМодели", ?(Результат.Статус = "ok", УровеньЖурналаРегистрации.Информация,
		УровеньЖурналаРегистрации.Предупреждение), Сведения);
	Возврат Результат;

КонецФункции

// Служебная строка о границе учетных данных: без нее в пустой или старой базе модель тратит шаги
// на доказательство, что данных нет, и считает «сегодня» по случайной поздней записи. В историю диалога строка
// не пишется: она считается перед каждым ходом.
//
// Параметры:
//  Граница - Дата, Неопределено - см. ИИО_Метаданные.ГраницаУчетныхДанных
//
// Возвращаемое значение:
//  Строка - Пустая строка, если границу посчитать не удалось.
Функция СтрокаГраницыДанных(Граница) Экспорт

	Если Граница = Неопределено Тогда
		Возврат "";
	ИначеЕсли Не ЗначениеЗаполнено(Граница) Тогда
		// Пустую выборку дает и ограничение доступа на уровне записей: «учет не велся» здесь было бы неправдой.
		Возврат НСтр("ru = 'В регистрах учета, доступных пользователю, нет записей. Не ищи цифры учета, скажи пользователю, что данных нет или к ним нет доступа.'");
	КонецЕсли;
	Возврат СтрШаблон(
		НСтр("ru = 'Учетные данные заканчиваются %1: записей позже этой даты в базе нет. Считай последние данные на эту дату, а не на сегодня.'"),
		Формат(Граница, "ДФ=yyyy-MM-dd"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инструменты реестра хода в формате function tools.
//
// Параметры:
//  Контекст - см. ИИО_РеестрИнструментов.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Массив из Структура
Функция ИнструментыМодели(Контекст)

	Инструменты = Новый Массив;
	Для Каждого КлючИЗначение Из Контекст.Инструменты Цикл
		Инструмент = КлючИЗначение.Значение;
		Схема = Инструмент.Схема;
		Если Схема = Неопределено Тогда
			Схема = Новый Структура("type, properties", "object", Новый Структура);
		КонецЕсли;
		Инструменты.Добавить(Новый Структура("type, function", "function",
			Новый Структура("name, description, parameters", Инструмент.Имя, Инструмент.Описание, Схема)));
	КонецЦикла;
	Возврат Инструменты;

КонецФункции

// Повод пойти итоговым шагом - запросом без инструментов, в котором модель отвечает по уже собранным данным.
// Иначе собранное за ход пропадает, а пользователь получает только текст статуса.
//
// LM Studio принимает ли tool_choice: none, проверить не удалось (модель загружает автор), поэтому итоговый шаг
// идет запросом без tools: так работает любой OpenAI-совместимый сервер.
//
// Параметры:
//  Шаг - Число - Номер шага хода.
//  Шагов - Число - Лимит шагов (настройка ИИО_ШагиАгента).
//  Повторов - Число - Сколько повторов вызова отклонено.
//  СрокМс - Число, Неопределено - Срок хода.
//  Сейчас - Число - Текущий момент, мс.
//  ОценкаВызоваМс - Число - Самый долгий вызов модели за ход; 0 - модель еще не отвечала.
//
// Возвращаемое значение:
//  Строка - limit - последний разрешенный шаг, repeat - модель зацикливается, deadline - до срока осталось
//    меньше одного вызова модели; пустая строка - обычный шаг с инструментами.
Функция ПоводИтоговогоШага(Шаг, Шагов, Повторов, СрокМс, Сейчас, ОценкаВызоваМс)

	Если Шаг = Шагов Тогда
		Возврат "limit";
	ИначеЕсли Повторов >= ПовторовДоИтоговогоШага() Тогда
		Возврат "repeat";
	ИначеЕсли СрокМс <> Неопределено И ОценкаВызоваМс > 0 И Сейчас + ОценкаВызоваМс >= СрокМс Тогда
		Возврат "deadline";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПовторовДоИтоговогоШага()

	Возврат 2;

КонецФункции

// Системное сообщение: инструкции канала (макет ИИО_ОписанияАгента и макеты пакетов), текущая дата,
// граница учетных данных и документ обсуждения - маскированно.
//
// Параметры:
//  Документ - ЛюбаяСсылка, Неопределено
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Строка
Функция СистемныйТекст(Документ, Словарь)

	Разделы = ИИО_РеестрИнструментов.РазделыОписаний("ИИО_ОписанияАгента", "_ОписанияАгента");
	Инструкции = Разделы.Получить("instructions");
	Части = Новый Массив;
	Части.Добавить(?(Инструкции = Неопределено, "", Инструкции));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Сегодня в 1С: %1.'"), Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd")));
	Граница = СтрокаГраницыДанных(ИИО_Метаданные.ГраницаУчетныхДанных());
	Если Граница <> "" Тогда
		Части.Добавить(Граница);
	КонецЕсли;
	Если ЗначениеЗаполнено(Документ) Тогда
		Данные = ИИО_МаскированиеКлиентСервер.Замаскировать(ИИО_Ответ.ДанныеДляМодели(Документ), Словарь);
		Части.Добавить(НСтр("ru = 'Разговор идет в обсуждении объекта 1С:'") + " " + ИИО_ОтветКлиентСервер.ВJSON(Данные));
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Выполняет вызов инструмента от модели через серверный реестр. Повтор вызова с теми же аргументами в одном
// ходе не выполняется: модели уходит ошибка REPEATED_CALL, иначе зацикленная модель тратит на один и тот же
// вызов все шаги.
//
// Параметры:
//  Вызов - Соответствие - Элемент tool_calls: id, function (name, arguments).
//  Контекст - см. ИИО_РеестрИнструментов.НовыйКонтекстВызова
//  Признаки - см. ИИО_ТрудныйОтвет.НовыеПризнаки - Дополняется по ответу инструмента.
//
// Возвращаемое значение:
//  Структура - Сообщение role = tool с ответом инструмента в JSON.
Функция ВыполнитьВызов(Вызов, Контекст, Признаки)

	ОписаниеФункции = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
	Идентификатор = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("id"), "");
	Если ТипЗнч(ОписаниеФункции) <> Тип("Соответствие") Тогда
		ОписаниеФункции = Новый Соответствие;
	КонецЕсли;
	Имя = ОписаниеФункции.Получить("name");
	ТекстАргументов = ОписаниеФункции.Получить("arguments");
	Аргументы = Новый Соответствие;
	Если ЗначениеЗаполнено(ТекстАргументов) Тогда
		Аргументы = ИИО_МодельHTTP.ИзJSON(ТекстАргументов);
	КонецЕсли;
	Повтор = Ложь;
	Инструмент = Неопределено;
	КлючВызова = "";
	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'В вызове нет имени инструмента.'"));
	ИначеЕсли ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Аргументы вызова - не объект JSON.'"),
			НСтр("ru = 'Передай аргументы объектом JSON по схеме инструмента.'"));
	Иначе
		КлючВызова = ИИО_ТрудныйОтвет.КлючВызова(Имя, Аргументы);
		Повтор = ИИО_ТрудныйОтвет.ЭтоПовтор(Признаки, КлючВызова);
		Если Повтор Тогда
			Ответ = ИИО_ТрудныйОтвет.ОшибкаПовтора();
		Иначе
			Инструмент = Контекст.Инструменты.Получить(Имя);
			Ответ = ИИО_РеестрИнструментов.Вызвать(Имя, Аргументы, Контекст);
		КонецЕсли;
	КонецЕсли;
	Если Повтор Тогда
		ИИО_ТрудныйОтвет.УчестьПовтор(Признаки);
	Иначе
		ИИО_ТрудныйОтвет.УчестьВызов(Признаки, Инструмент, Ответ, КлючВызова);
	КонецЕсли;
	Текст = ИИО_ОтветКлиентСервер.Обрезать(ИИО_ОтветКлиентСервер.ВJSON(Ответ), МаксимумОтветаИнструмента());
	Возврат Новый Структура("role, tool_call_id, content", "tool", ?(ТипЗнч(Идентификатор) = Тип("Строка"),
		Идентификатор, ""), Текст);

КонецФункции

// Пишет ход в журнал обмена с моделью: сообщения ровно в том виде, в каком их видела модель
// в последнем запросе хода, и ее ответ. Сбой журнала не лишает пользователя ответа: он пишется
// в журнал регистрации.
//
// Параметры:
//  Диалог - см. ИИО_Диалоги.Диалог
//  Документ - ЛюбаяСсылка, Неопределено
//  Параметры - см. ИИО_МодельHTTP.ПараметрыМодели
//  Сведения - Структура - Сведения события ВызовМодели.
//  Сообщения - Массив из Структура - Сообщения последнего запроса к модели.
//  НачалоХода - Число - Индекс вопроса пользователя в Сообщения: между системным текстом и им - история.
//  Итог - Структура - Чем кончился ход:
//   * ОтветМодели - Строка, Неопределено - Ответ модели, если ход удался.
//   * Вопрос - Строка - Маскированный вопрос пользователя: по нему администратор видит список трудных
//     вопросов с частотой.
//   * Признаки - Строка - Коды признаков трудного ответа, см. ИИО_ТрудныйОтвет.Коды.
Процедура ЗаписатьВЖурналОбмена(Диалог, Документ, Параметры, Сведения, Сообщения, НачалоХода, Итог)

	Переписка = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Переписка.Добавить(Сообщение);
	КонецЦикла;
	Если Итог.ОтветМодели <> Неопределено Тогда
		Переписка.Добавить(НовоеСообщение("assistant", Итог.ОтветМодели));
	КонецЕсли;
	// Сводка скрытого - по этому ходу: история уже учтена в записях прежних ходов.
	Тексты = Новый Массив;
	Для Индекс = 0 По Переписка.ВГраница() Цикл
		Если Индекс = 0 Или Индекс >= НачалоХода Тогда
			Тексты.Добавить(Переписка[Индекс].content);
		КонецЕсли;
	КонецЦикла;

	Запись = ИИО_Журнал.НовыеСведенияОбмена();
	Запись.Канал = "bot";
	Запись.Разговор = Диалог.Ключ;
	Запись.Объект = Документ;
	Запись.Модель = Параметры.Модель;
	Запись.Адрес = Параметры.Адрес;
	Запись.Статус = Сведения.status;
	Запись.Шаги = Сведения.steps;
	Запись.ВызововИнструментов = Сведения.tool_calls;
	Запись.ТокеныЗапроса = Сведения.prompt_tokens;
	Запись.ТокеныОтвета = Сведения.completion_tokens;
	Запись.ДлительностьМс = Сведения.duration_ms;
	Запись.ПроверкаВвода = Сведения.input_check;
	Запись.Вопрос = ИИО_ОтветКлиентСервер.Обрезать(Итог.Вопрос, МаксимумВопросаВЖурнале());
	Запись.Признаки = Итог.Признаки;
	Запись.Скрыто = ИИО_МаскированиеКлиентСервер.СводкаСкрытого(Тексты, Диалог.Словарь);
	Запись.Переписка = ИИО_ОтветКлиентСервер.ВJSON(Переписка);
	Попытка
		ИИО_Журнал.ЗаписатьОбменСМоделью(Запись);
	Исключение
		ИИО_Журнал.ЗаписатьСобытие("ЖурналОбмена.Запись", УровеньЖурналаРегистрации.Ошибка,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

Функция НовоеСообщение(Роль, Текст)

	Возврат Новый Структура("role, content", Роль, Текст);

КонецФункции

Процедура УчестьИспользование(Сведения, Использование)

	Для Каждого Поле Из СтрРазделить("prompt_tokens,completion_tokens", ",") Цикл
		Значение = Использование.Получить(Поле);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Сведения[Поле] = Сведения[Поле] + Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Оставляет в истории последние сообщения по настройке ИИО_ДлинаИстории.
//
// Параметры:
//  История - Массив из Структура
Процедура ОбрезатьИсторию(История)

	Длина = ИИО_Настройки.Значение("ИИО_ДлинаИстории");
	Пока История.Количество() > Длина Цикл
		История.Удалить(0);
	КонецЦикла;

КонецПроцедуры

// Ответ пользователю, когда ход не дал ответа модели.
//
// Параметры:
//  Статус - Строка
//
// Возвращаемое значение:
//  Строка
Функция ТекстСтатуса(Статус)

	Если Статус = "not_configured" Тогда
		Возврат НСтр("ru = 'ИИ-оператор не подключен к модели. Администратор указывает адрес и имя модели в настройках ИИ-оператора.'");
	ИначеЕсли Статус = "model_unavailable" Тогда
		Возврат НСтр("ru = 'Модель сейчас недоступна. Попробуйте позже, а если повторяется - сообщите администратору.'");
	ИначеЕсли Статус = "model_error" Тогда
		Возврат НСтр("ru = 'Модель вернула ошибку. Попробуйте переформулировать вопрос, а если повторяется - сообщите администратору.'");
	ИначеЕсли Статус = "deadline" Тогда
		Возврат НСтр("ru = 'Не успел ответить за отведенное время. Попробуйте задать вопрос короче или по частям.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Не разобрался за отведенное число шагов. Уточните вопрос: что именно и по какому объекту нужно.'");

КонецФункции

Функция МаксимумОтветаИнструмента()

	Возврат 30000;

КонецФункции

// Предел длины вопроса в журнале обмена: с пометкой об обрезке получается ровно 500 символов - длина ресурса
// регистра. Вопрос целиком остается в переписке.
//
// Возвращаемое значение:
//  Число
Функция МаксимумВопросаВЖурнале()

	Возврат 499;

КонецФункции

#КонецОбласти
