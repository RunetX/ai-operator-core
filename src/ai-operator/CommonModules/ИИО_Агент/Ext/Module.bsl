// Ход агента канала бота: вопрос пользователя -> маскирование ввода -> цикл
// «модель - инструменты» через серверный реестр -> ответ. Модель видит только маскированный текст;
// словарь и маскированная история живут в диалоге. Пользователь получает ответ с реальными значениями.

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет ход агента: отвечает на вопрос пользователя в диалоге и записывает диалог.
//
// Параметры:
//  Диалог - см. ИИО_Диалоги.Диалог
//  Вопрос - Строка - Текст пользователя как есть.
//  Документ - ЛюбаяСсылка, Неопределено - Объект, в обсуждении которого задан вопрос.
//  СрокМс - Число, Неопределено - Момент (ТекущаяУниверсальнаяДатаВМиллисекундах), к которому ход должен
//    закончиться.
//
// Возвращаемое значение:
//  Структура:
//   * Ответ - Строка - Ответ пользователю с реальными значениями вместо токенов.
//   * Кнопки - Массив из см. ИИО_РеестрИнструментов.НоваяКнопка
//   * Статус - Строка - ok, not_configured, model_unavailable, model_error, step_limit, deadline.
//   * Шаги - Число - Сколько раз вызвана модель.
//   * ПроверкаВвода - Строка - Каким путем искались люди в вопросе, см. ИИО_МаскированиеВвода.ЗамаскироватьВвод.
Функция ВыполнитьХод(Диалог, Вопрос, Документ = Неопределено, СрокМс = Неопределено) Экспорт

	Результат = Новый Структура("Ответ, Кнопки, Статус, Шаги, ПроверкаВвода", "", Новый Массив, "ok", 0, "");
	Параметры = ИИО_МодельHTTP.ПараметрыМодели();
	Параметры.СрокМс = СрокМс;
	Если Не Параметры.Настроена Тогда
		Результат.Статус = "not_configured";
		Результат.Ответ = ТекстСтатуса(Результат.Статус);
		Возврат Результат;
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Ввод = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Вопрос, Диалог.Словарь);
	Результат.ПроверкаВвода = Ввод.Проверка;
	Контекст = ИИО_РеестрИнструментов.НовыйКонтекстВызова(Диалог.Словарь, СрокМс);
	Результат.Кнопки = Контекст.Кнопки;
	Инструменты = ИнструментыМодели(Контекст);
	Сообщения = Новый Массив;
	Сообщения.Добавить(НовоеСообщение("system", СистемныйТекст(Документ, Диалог.Словарь)));
	Для Каждого Сообщение Из Диалог.История Цикл
		Сообщения.Добавить(Сообщение);
	КонецЦикла;
	Сообщения.Добавить(НовоеСообщение("user", Ввод.Текст));

	Сведения = Новый Структура("status, model, steps, tool_calls", "", Параметры.Модель, 0, 0);
	Сведения.Вставить("duration_ms", 0);
	Сведения.Вставить("model_ms", 0);
	Сведения.Вставить("prompt_tokens", 0);
	Сведения.Вставить("completion_tokens", 0);
	Сведения.Вставить("input_check", Ввод.Проверка);
	ОтветМодели = "";
	Шагов = ИИО_Настройки.Значение("ИИО_ШагиАгента");
	Для Шаг = 1 По Шагов Цикл
		Если СрокМс <> Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() >= СрокМс Тогда
			Результат.Статус = "deadline";
			Прервать;
		КонецЕсли;
		Ответ = ИИО_МодельHTTP.ЗапросЧата(Параметры, Сообщения, Инструменты);
		Сведения.steps = Шаг;
		Сведения.model_ms = Сведения.model_ms + Ответ.ДлительностьМс;
		УчестьИспользование(Сведения, Ответ.Использование);
		Если Ответ.Ошибка <> Неопределено Тогда
			Результат.Статус = ?(Ответ.Ошибка.Код = "MODEL_UNAVAILABLE", "model_unavailable", "model_error");
			Сведения.Вставить("error", Ответ.Ошибка.Подробно);
			Прервать;
		КонецЕсли;
		Вызовы = Ответ.Сообщение.Получить("tool_calls");
		Если ТипЗнч(Вызовы) <> Тип("Массив") Или Вызовы.Количество() = 0 Тогда
			ОтветМодели = Ответ.Сообщение.Получить("content");
			Прервать;
		КонецЕсли;
		Сообщения.Добавить(Новый Структура("role, content, tool_calls", "assistant",
			Ответ.Сообщение.Получить("content"), Вызовы));
		Для Каждого Вызов Из Вызовы Цикл
			Сведения.tool_calls = Сведения.tool_calls + 1;
			Сообщения.Добавить(ВыполнитьВызов(Вызов, Контекст));
		КонецЦикла;
		Если Шаг = Шагов Тогда
			Результат.Статус = "step_limit";
		КонецЕсли;
	КонецЦикла;
	Результат.Шаги = Сведения.steps;
	Сведения.status = Результат.Статус;
	Сведения.duration_ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Если Результат.Статус = "ok" Тогда
		Диалог.История.Добавить(НовоеСообщение("user", Ввод.Текст));
		Диалог.История.Добавить(НовоеСообщение("assistant", ОтветМодели));
		ОбрезатьИсторию(Диалог.История);
		Результат.Ответ = ИИО_МаскированиеКлиентСервер.Демаскировать(ОтветМодели, Диалог.Словарь);
	Иначе
		Результат.Ответ = ТекстСтатуса(Результат.Статус);
	КонецЕсли;
	ИИО_Диалоги.Записать(Диалог);
	ИИО_Журнал.ЗаписатьСобытие("ВызовМодели", ?(Результат.Статус = "ok", УровеньЖурналаРегистрации.Информация,
		УровеньЖурналаРегистрации.Предупреждение), Сведения);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инструменты реестра хода в формате function tools.
//
// Параметры:
//  Контекст - см. ИИО_РеестрИнструментов.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Массив из Структура
Функция ИнструментыМодели(Контекст)

	Инструменты = Новый Массив;
	Для Каждого КлючИЗначение Из Контекст.Инструменты Цикл
		Инструмент = КлючИЗначение.Значение;
		Схема = Инструмент.Схема;
		Если Схема = Неопределено Тогда
			Схема = Новый Структура("type, properties", "object", Новый Структура);
		КонецЕсли;
		Инструменты.Добавить(Новый Структура("type, function", "function",
			Новый Структура("name, description, parameters", Инструмент.Имя, Инструмент.Описание, Схема)));
	КонецЦикла;
	Возврат Инструменты;

КонецФункции

// Системное сообщение: инструкции канала (макет ИИО_ОписанияАгента и макеты пакетов), текущая дата
// и документ обсуждения - маскированно.
//
// Параметры:
//  Документ - ЛюбаяСсылка, Неопределено
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//
// Возвращаемое значение:
//  Строка
Функция СистемныйТекст(Документ, Словарь)

	Разделы = ИИО_РеестрИнструментов.РазделыОписаний("ИИО_ОписанияАгента", "_ОписанияАгента");
	Инструкции = Разделы.Получить("instructions");
	Части = Новый Массив;
	Части.Добавить(?(Инструкции = Неопределено, "", Инструкции));
	Части.Добавить(СтрШаблон(НСтр("ru = 'Сегодня в 1С: %1.'"), Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd")));
	Если ЗначениеЗаполнено(Документ) Тогда
		Данные = ИИО_МаскированиеКлиентСервер.Замаскировать(ИИО_Ответ.ДанныеДляМодели(Документ), Словарь);
		Части.Добавить(НСтр("ru = 'Разговор идет в обсуждении объекта 1С:'") + " " + ИИО_ОтветКлиентСервер.ВJSON(Данные));
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);

КонецФункции

// Выполняет вызов инструмента от модели через серверный реестр.
//
// Параметры:
//  Вызов - Соответствие - Элемент tool_calls: id, function (name, arguments).
//  Контекст - см. ИИО_РеестрИнструментов.НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура - Сообщение role = tool с ответом инструмента в JSON.
Функция ВыполнитьВызов(Вызов, Контекст)

	ОписаниеФункции = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
	Идентификатор = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("id"), "");
	Если ТипЗнч(ОписаниеФункции) <> Тип("Соответствие") Тогда
		ОписаниеФункции = Новый Соответствие;
	КонецЕсли;
	Имя = ОписаниеФункции.Получить("name");
	ТекстАргументов = ОписаниеФункции.Получить("arguments");
	Аргументы = Новый Соответствие;
	Если ЗначениеЗаполнено(ТекстАргументов) Тогда
		Аргументы = ИИО_МодельHTTP.ИзJSON(ТекстАргументов);
	КонецЕсли;
	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'В вызове нет имени инструмента.'"));
	ИначеЕсли ТипЗнч(Аргументы) <> Тип("Соответствие") Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Аргументы вызова - не объект JSON.'"),
			НСтр("ru = 'Передай аргументы объектом JSON по схеме инструмента.'"));
	Иначе
		Ответ = ИИО_РеестрИнструментов.Вызвать(Имя, Аргументы, Контекст);
	КонецЕсли;
	Текст = ИИО_ОтветКлиентСервер.Обрезать(ИИО_ОтветКлиентСервер.ВJSON(Ответ), МаксимумОтветаИнструмента());
	Возврат Новый Структура("role, tool_call_id, content", "tool", ?(ТипЗнч(Идентификатор) = Тип("Строка"),
		Идентификатор, ""), Текст);

КонецФункции

Функция НовоеСообщение(Роль, Текст)

	Возврат Новый Структура("role, content", Роль, Текст);

КонецФункции

Процедура УчестьИспользование(Сведения, Использование)

	Для Каждого Поле Из СтрРазделить("prompt_tokens,completion_tokens", ",") Цикл
		Значение = Использование.Получить(Поле);
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Сведения[Поле] = Сведения[Поле] + Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Оставляет в истории последние сообщения по настройке ИИО_ДлинаИстории.
//
// Параметры:
//  История - Массив из Структура
Процедура ОбрезатьИсторию(История)

	Длина = ИИО_Настройки.Значение("ИИО_ДлинаИстории");
	Пока История.Количество() > Длина Цикл
		История.Удалить(0);
	КонецЦикла;

КонецПроцедуры

// Ответ пользователю, когда ход не дал ответа модели.
//
// Параметры:
//  Статус - Строка
//
// Возвращаемое значение:
//  Строка
Функция ТекстСтатуса(Статус)

	Если Статус = "not_configured" Тогда
		Возврат НСтр("ru = 'ИИ-оператор не подключен к модели. Администратор указывает адрес и имя модели в настройках ИИ-оператора.'");
	ИначеЕсли Статус = "model_unavailable" Тогда
		Возврат НСтр("ru = 'Модель сейчас недоступна. Попробуйте позже, а если повторяется - сообщите администратору.'");
	ИначеЕсли Статус = "model_error" Тогда
		Возврат НСтр("ru = 'Модель вернула ошибку. Попробуйте переформулировать вопрос, а если повторяется - сообщите администратору.'");
	ИначеЕсли Статус = "deadline" Тогда
		Возврат НСтр("ru = 'Не успел ответить за отведенное время. Попробуйте задать вопрос короче или по частям.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Не разобрался за отведенное число шагов. Уточните вопрос: что именно и по какому объекту нужно.'");

КонецФункции

Функция МаксимумОтветаИнструмента()

	Возврат 30000;

КонецФункции

#КонецОбласти
