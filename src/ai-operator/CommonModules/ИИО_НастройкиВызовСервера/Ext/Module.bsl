#Область СлужебныйПрограммныйИнтерфейс

// См. ИИО_Настройки.ПараметрыЗапуска.
Функция ПараметрыЗапуска() Экспорт

	Возврат ИИО_Настройки.ПараметрыЗапуска();

КонецФункции

// Сколько ждать действия пользователя в форме, после закрытия которой вызов получит ответ, с.
// На 30 с меньше таймаута MCP-сервера: ответ должен уйти раньше, чем сервер оборвет вызов.
//
// Возвращаемое значение:
//  Число
Функция СрокОжиданияФормыСек() Экспорт

	Возврат Макс(30, ИИО_Настройки.Значение("ИИО_ТаймаутСервераСек") - 30);

КонецФункции

#КонецОбласти
