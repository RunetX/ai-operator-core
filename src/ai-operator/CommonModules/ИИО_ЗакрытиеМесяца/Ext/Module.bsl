// Запрос с параметрами месяца и организации.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Текст - Строка - Текст запроса.
//
// Возвращаемое значение:
//  Запрос
Функция НовыйЗапрос(Контекст, Текст)

	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Организация", Контекст.Организация);
	Запрос.УстановитьПараметр("Начало", Контекст.Начало);
	Запрос.УстановитьПараметр("Конец", Контекст.Конец);
	Запрос.УстановитьПараметр("Граница", Новый Граница(Контекст.Конец, ВидГраницы.Включая));
	Возврат Запрос;

КонецФункции

// Счета проверок по кодам: из соответствия контекста, без запроса.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Коды - Строка - Коды через запятую.
//
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.Хозрасчетный
Функция Счета(Контекст, Коды)

	Результат = Новый Массив;
	Для Каждого Код Из СтрРазделить(Коды, ",") Цикл
		Счет = Контекст.Счета.Получить(Код);
		Если Счет <> Неопределено Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Счета всех проверок одним запросом: ключ - код, значение - ссылка.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка
//   * Значение - ПланСчетовСсылка.Хозрасчетный
Функция СчетыПроверок()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.Код КАК Код
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Счета
		|ГДЕ
		|	Счета.Код В (&Коды)");
	Коды = СтрРазделить("19,60.01,60.02,62.01,62.02,68.02,90,91,41,10,43,20,23,25,26,44", ",");
	Запрос.УстановитьПараметр("Коды", Коды);
	Счета = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	// Без счета проверка молча прошла бы: пустой отбор по счетам ничего не находит.
	Если Счета.Количество() < Коды.Количество() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В плане счетов найдено %1 счетов проверки закрытия месяца из %2.'"),
			Счета.Количество(), Коды.Количество());
	КонецЕсли;
	Возврат Счета;

КонецФункции

// Дата последней проводки организации не позже даты: граница данных.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  НеПозже - Дата
//
// Возвращаемое значение:
//  Дата - Пустая, если проводок нет.
Функция ПоследняяПроводка(Организация, НеПозже)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Проводки.Период КАК Период
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
		|ГДЕ
		|	Проводки.Период <= &НеПозже
		|	И Проводки.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Проводки.Период УБЫВ");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НеПозже", НеПозже);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Период, Дата(1, 1, 1));

КонецФункции

// Дата последней проведенной выписки банка организации: если выписки загружены не до конца месяца,
// закрывать его рано.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если выписок нет или они недоступны пользователю.
Функция ПоследняяВыписка(Организация)

	Если Не ПравоДоступа("Чтение", Метаданные.Документы.ПоступлениеНаРасчетныйСчет)
		Или Не ПравоДоступа("Чтение", Метаданные.Документы.СписаниеСРасчетногоСчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(Выписки.Дата) КАК Дата
		|ИЗ
		|	(ВЫБРАТЬ
		|		Поступления.Дата КАК Дата
		|	ИЗ
		|		Документ.ПоступлениеНаРасчетныйСчет КАК Поступления
		|	ГДЕ
		|		Поступления.Организация = &Организация
		|		И Поступления.Проведен
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Списания.Дата
		|	ИЗ
		|		Документ.СписаниеСРасчетногоСчета КАК Списания
		|	ГДЕ
		|		Списания.Организация = &Организация
		|		И Списания.Проведен) КАК Выписки");
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Дата), Выборка.Дата, Неопределено);

КонецФункции

