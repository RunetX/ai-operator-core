// Дата последней проводки организации не позже даты: граница данных.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  НеПозже - Дата
//
// Возвращаемое значение:
//  Дата - Пустая, если проводок нет.
Функция ПоследняяПроводка(Организация, НеПозже)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Проводки.Период КАК Период
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный КАК Проводки
		|ГДЕ
		|	Проводки.Период <= &НеПозже
		|	И Проводки.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	Проводки.Период УБЫВ");
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НеПозже", НеПозже);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Период, Дата(1, 1, 1));

КонецФункции

// Дата последней проведенной выписки банка организации: если выписки загружены не до конца месяца,
// закрывать его рано.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если выписок нет или они недоступны пользователю.
Функция ПоследняяВыписка(Организация)

	Если Не ПравоДоступа("Чтение", Метаданные.Документы.ПоступлениеНаРасчетныйСчет)
		Или Не ПравоДоступа("Чтение", Метаданные.Документы.СписаниеСРасчетногоСчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(Выписки.Дата) КАК Дата
		|ИЗ
		|	(ВЫБРАТЬ
		|		Поступления.Дата КАК Дата
		|	ИЗ
		|		Документ.ПоступлениеНаРасчетныйСчет КАК Поступления
		|	ГДЕ
		|		Поступления.Организация = &Организация
		|		И Поступления.Проведен
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Списания.Дата
		|	ИЗ
		|		Документ.СписаниеСРасчетногоСчета КАК Списания
		|	ГДЕ
		|		Списания.Организация = &Организация
		|		И Списания.Проведен) КАК Выписки");
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Дата), Выборка.Дата, Неопределено);

