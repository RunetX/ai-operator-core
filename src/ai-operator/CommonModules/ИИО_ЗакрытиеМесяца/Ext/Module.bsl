// Запрос с параметрами месяца и организации.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Текст - Строка - Текст запроса.
//
// Возвращаемое значение:
//  Запрос
Функция НовыйЗапрос(Контекст, Текст)

	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Организация", Контекст.Организация);
	Запрос.УстановитьПараметр("Начало", Контекст.Начало);
	Запрос.УстановитьПараметр("Конец", Контекст.Конец);
	Запрос.УстановитьПараметр("Граница", Новый Граница(Контекст.Конец, ВидГраницы.Включая));
	Возврат Запрос;

КонецФункции

// Счета проверок по кодам: из соответствия контекста, без запроса.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Коды - Строка - Коды через запятую.
//
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.Хозрасчетный
Функция Счета(Контекст, Коды)

	Результат = Новый Массив;
	Для Каждого Код Из СтрРазделить(Коды, ",") Цикл
		Счет = Контекст.Счета.Получить(Код);
		Если Счет <> Неопределено Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Счета всех проверок одним запросом: ключ - код, значение - ссылка.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка
//   * Значение - ПланСчетовСсылка.Хозрасчетный
Функция СчетыПроверок()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Счета.Ссылка КАК Ссылка,
		|	Счета.Код КАК Код
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Счета
		|ГДЕ
		|	Счета.Код В (&Коды)");
	Коды = СтрРазделить("19,60.01,60.02,62.01,62.02,68.02,90,90.01,91,41,10,43,20,23,25,26,44,40", ",");
	Запрос.УстановитьПараметр("Коды", Коды);
	Счета = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета.Вставить(СокрЛП(Выборка.Код), Выборка.Ссылка);
	КонецЦикла;
	// Без счета проверка молча прошла бы: пустой отбор по счетам ничего не находит.
	Если Счета.Количество() < Коды.Количество() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В плане счетов найдено %1 счетов проверки закрытия месяца из %2.'"),
			Счета.Количество(), Коды.Количество());
	КонецЕсли;
	Возврат Счета;

КонецФункции

// Учетная политика организации на конец месяца из настроек учета затрат: роли счетов, правила распределения
// косвенных затрат и способ учета НЗП.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если настроек учета затрат нет или их нельзя читать:
//   * Роли - ТаблицаЗначений - Счет, КосвенныеЗатраты: заполненные роли счетов.
//   * Распределение - ТаблицаЗначений - Счет, Подразделение, База (представление), Проверка (см. ПравилаСтроки):
//     правила без статьи затрат, без филиала или с филиалом проверяемой организации (правило филиала действует
//     только в нем), по коду счета и порядку строк - первым идет основной набор.
//   * НЗП - ТаблицаЗначений - Счет, Вариант (представление), ПоИнвентаризации, ПоПродукции.
Функция ПолитикаЗатрат(Контекст)

	Регистр = Метаданные.РегистрыСведений.Найти("УчетнаяПолитика");
	Настройки = Метаданные.Справочники.Найти("НастройкиУчетаЗатрат");
	Если Регистр = Неопределено
		Или Настройки = Неопределено
		Или Не ПравоДоступа("Чтение", Регистр)
		Или Не ПравоДоступа("Чтение", Настройки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Политика.НастройкиУчетаЗатрат КАК Настройки
		|ПОМЕСТИТЬ ВТНастройки
		|ИЗ
		|	РегистрСведений.УчетнаяПолитика.СрезПоследних(&Конец, Организация = &Организация) КАК Политика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РолиСчетов.Счет КАК Счет,
		|	ВЫБОР
		|		КОГДА РолиСчетов.Роль = ЗНАЧЕНИЕ(Перечисление.РолиСчетовЗатрат.КосвенныеЗатраты)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК КосвенныеЗатраты
		|ИЗ
		|	Справочник.НастройкиУчетаЗатрат.ПланСчетов КАК РолиСчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНастройки КАК ВТНастройки
		|		ПО РолиСчетов.Ссылка = ВТНастройки.Настройки
		|ГДЕ
		|	РолиСчетов.Роль <> ЗНАЧЕНИЕ(Перечисление.РолиСчетовЗатрат.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	РолиСчетов.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Распределение.Счет КАК Счет,
		|	Распределение.Подразделение КАК Подразделение,
		|	ПРЕДСТАВЛЕНИЕ(Распределение.БазаРаспределения) КАК База,
		|	ВЫБОР
		|		КОГДА Распределение.БазаРаспределения В (
		|				ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхРасходов.Выручка),
		|				ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхРасходов.ВыручкаОтРеализацииУслуг))
		|			ТОГДА ""Выручка""
		|		КОГДА Распределение.БазаРаспределения =
		|				ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхРасходов.ПрямыеЗатраты)
		|			ТОГДА ""ПрямыеЗатраты""
		|		КОГДА Распределение.БазаРаспределения В (
		|				ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхРасходов.ОбъемВыпуска),
		|				ЗНАЧЕНИЕ(Перечисление.БазыРаспределенияКосвенныхРасходов.ПлановаяСебестоимость))
		|			ТОГДА ""Выпуск""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Проверка
		|ИЗ
		|	Справочник.НастройкиУчетаЗатрат.Распределение КАК Распределение
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНастройки КАК ВТНастройки
		|		ПО Распределение.Ссылка = ВТНастройки.Настройки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный КАК Счета
		|		ПО Распределение.Счет = Счета.Ссылка
		|ГДЕ
		|	Распределение.Филиал В (ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка), &Организация)
		|	И Распределение.СтатьяЗатрат = ЗНАЧЕНИЕ(Справочник.СтатьиЗатрат.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счета.Код,
		|	Распределение.НомерСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НЗП.Счет КАК Счет,
		|	ПРЕДСТАВЛЕНИЕ(НЗП.ВариантУчета) КАК Вариант,
		|	ВЫБОР
		|		КОГДА НЗП.ВариантУчета =
		|			ЗНАЧЕНИЕ(Перечисление.ВариантыУчетаНезавершенногоПроизводства.ВедетсяПоРезультатамИнвентаризации)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ПоИнвентаризации,
		|	ВЫБОР
		|		КОГДА Разрезы.Ссылка ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ПоПродукции
		|ИЗ
		|	Справочник.НастройкиУчетаЗатрат.НезавершенноеПроизводство КАК НЗП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТНастройки КАК ВТНастройки
		|		ПО НЗП.Ссылка = ВТНастройки.Настройки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиУчетаЗатрат.РазрезыУчетаНезавершенногоПроизводства КАК Разрезы
		|		ПО НЗП.Ссылка = Разрезы.Ссылка
		|			И НЗП.Счет = Разрезы.Счет
		|			И (Разрезы.ВидАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.Продукция))
		|
		|УПОРЯДОЧИТЬ ПО
		|	НЗП.НомерСтроки");
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Новый Структура("Роли, Распределение, НЗП", Результаты[1].Выгрузить(), Результаты[2].Выгрузить(),
		Результаты[3].Выгрузить());

