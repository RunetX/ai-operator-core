// Инструмент month_close_check: что мешает закрыть месяц в БП. Проверки детерминированные, ответ
// компактный: коды, числа, суммы и ссылки до limit. Исправляет пользователь, проведение - perform с предпросмотром.
// Окно проверки - месяц последней проводки организации (граница данных), а не текущая дата.

#Область СлужебныйПрограммныйИнтерфейс

// Инструмент есть только в БП: проверки опираются на ее план счетов и документы.
//
// Возвращаемое значение:
//  Булево
Функция Поддерживается() Экспорт

	Возврат СтрНачинаетсяС(Метаданные.Имя, "БухгалтерияПредприятия")
		И Метаданные.РегистрыБухгалтерии.Найти("Хозрасчетный") <> Неопределено;

КонецФункции

// Проверка закрытия месяца по организации.
//
// Параметры:
//  Аргументы - Структура, Соответствие - organization, month, limit.
//  Кнопки - Массив, Неопределено - Кнопки ответа бота (см. ИИО_РеестрИнструментов.НоваяКнопка);
//    Неопределено - канал MCP, кнопок нет.
//  ПользовательИБ - ПользовательИнформационнойБазы, Неопределено - Чьи права «Проведение» проверяются для actions,
//    для тестов; по умолчанию текущий пользователь.
//
// Возвращаемое значение:
//  Структура - Ответ для модели после ИИО_Ответ.ДанныеДляМодели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка:
//   * organization - СправочникСсылка.Организации
//   * month - Строка - ГГГГ-ММ.
//   * last_entry - Дата - Последняя проводка организации.
//   * last_bank_statement - Дата - Последняя проведенная выписка банка.
//   * result - Строка - ok, problems или no_data.
//   * problems - Массив из Структура - Проверки с находками: code, count, amount, text, items (первые до limit).
//   * passed - Массив из Строка - Коды пройденных проверок.
//   * skipped - Массив из Структура - Непроверенное: code, reason.
//   * actions - Массив из Структура - Исправления через perform: action, refs.
//   * action_denied - Строка - Почему часть непроведенных документов или все не предлагаются к проведению.
//   * button - Булево - В боте под ответом есть кнопки предпросмотра и списков.
//   * pii_context - Массив - Люди из реквизитов документов с ошибками обмена, см. ИИО_Маскирование.КонтекстПДн.
Функция Проверить(Аргументы, Кнопки = Неопределено, ПользовательИБ = Неопределено) Экспорт

	Если Не Поддерживается() Или Не ПравоДоступа("Чтение", Метаданные.РегистрыБухгалтерии.Хозрасчетный) Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'Пользователю недоступны проводки бухгалтерского учета.'"),
			НСтр("ru = 'Скажи пользователю, что проверку закрытия месяца может выполнить бухгалтер с доступом к проводкам.'"));
	КонецЕсли;
	Организация = Организация(Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Организация) Тогда
		Возврат Организация;
	КонецЕсли;
	ПоследняяПроводка = ПоследняяПроводка(Организация, '39991231');
	Месяц = МесяцПроверки(Аргументы, ПоследняяПроводка);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Месяц) Тогда
		Возврат Месяц;
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("organization", Организация);
	Ответ.Вставить("month", Формат(Месяц, "ДФ=yyyy-MM"));
	Ответ.Вставить("last_entry", ПоследняяПроводка);
	Ответ.Вставить("last_bank_statement", ПоследняяВыписка(Организация));
	ПроводкаМесяца = ПоследняяПроводка(Организация, КонецМесяца(Месяц));
	Если Не ЗначениеЗаполнено(ПроводкаМесяца) Или ПроводкаМесяца < Месяц Тогда
		Ответ.Вставить("result", "no_data");
		Ответ.Вставить("text", НСтр("ru = 'За месяц у организации нет проводок: проверять нечего, это не значит, что месяц закрыт. Где кончаются данные - в last_entry.'"));
		Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);
	КонецЕсли;

	Контекст = НовыйКонтекст(Организация, Месяц,
		ИИО_ОтветКлиентСервер.ЦелыйАргумент(Аргументы, "limit", ЛимитПоУмолчанию(), МаксимальныйЛимит()));
	Контекст.Политика = ПолитикаЗатрат(Контекст);
	ЗакрытиеВыполнено = ПроверитьЗакрытие(Контекст);
	ПроверитьНепроведенные(Контекст);
	ПроверитьСчетаФактуры(Контекст, "SALES_WITHOUT_INVOICE", "РеализацияТоваровУслуг", "СчетФактураВыданный",
		"СчетКт", "68.02");
	ПроверитьСчетаФактуры(Контекст, "PURCHASES_WITHOUT_INVOICE", "ПоступлениеТоваровУслуг", "СчетФактураПолученный",
		"СчетДт", "19");
	ПроверитьОстатки(Контекст, "VAT_19_BALANCE", "19", "Остатки.СуммаОстаток > 0");
	ПроверитьАвансы(Контекст, "ADVANCES_ISSUED", "60.01", "60.02", -1);
	ПроверитьАвансы(Контекст, "ADVANCES_RECEIVED", "62.01", "62.02", 1);
	ПроверитьОстатки(Контекст, "NEGATIVE_STOCK", "41,10,43",
		"(Остатки.СуммаОстаток < 0 ИЛИ ЕСТЬNULL(Остатки.КоличествоОстаток, 0) < 0)");
	ПроверитьОстатки(Контекст, "STOCK_SUM_WITHOUT_QUANTITY", "41,10,43",
		"Остатки.Счет.Количественный И ЕСТЬNULL(Остатки.КоличествоОстаток, 0) = 0 И Остатки.СуммаОстаток > 0");
	ПроверитьПродукциюПриНЗП(Контекст);
	Если ЗакрытиеВыполнено Тогда
		ПроверитьОстатки(Контекст, "COST_BALANCES", "20,23,25,26,44", "Остатки.СуммаОстаток <> 0");
		ПроверитьСальдо9091(Контекст);
	Иначе
		Причина = НСтр("ru = 'Проверяется после закрытия месяца: до него остаток - норма.'");
		Пропустить(Контекст, "COST_BALANCES", Причина);
		Пропустить(Контекст, "BALANCE_90_91", Причина);
	КонецЕсли;
	ПроверитьОбмен(Контекст);

	Ответ.Вставить("result", ?(Контекст.Находки.Количество() = 0, "ok", "problems"));
	Ответ.Вставить("problems", Контекст.Находки);
	Ответ.Вставить("passed", Контекст.Пройдены);
	Если Контекст.Пропущены.Количество() > 0 Тогда
		Ответ.Вставить("skipped", Контекст.Пропущены);
	КонецЕсли;
	Если ДобавитьИсправления(Ответ, Контекст, Кнопки, ПользовательИБ) Тогда
		Ответ.Вставить("button", Истина);
		Ответ.Вставить("hint", НСтр("ru = 'Перескажи problems по text и action_denied, если он есть, своими словами, не добавляя причин от себя. Кнопки под ответом уже добавлены: не вызывай для них show_in_1c и perform.'"));
	Иначе
		Ответ.Вставить("hint", НСтр("ru = 'Перескажи problems по text и action_denied, если он есть, своими словами, не добавляя причин от себя. Списки покажи через show_in_1c, непроведенные документы проводятся через perform: пользователь подтверждает это в предпросмотре.'"));
	КонецЕсли;
	// Тексты ошибок обмена могут называть людей из реквизитов документов: клиентское ядро заменит их токенами.
	Если Контекст.ОбъектыОбмена.Количество() > 0 Тогда
		Ответ.Вставить("pii_context", ИИО_Маскирование.КонтекстПДн(Контекст.ОбъектыОбмена));
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Аргументы

// Организация из аргумента organization; без него - единственная организация базы.
//
// Параметры:
//  Аргументы - см. Проверить
//
// Возвращаемое значение:
//  СправочникСсылка.Организации, Структура - Организация или ошибка для модели.
Функция Организация(Аргументы)

	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "organization");
	Подсказка = НСтр("ru = 'Передай в organization ref организации из find_ref (вид Справочник.Организации).'");
	Ссылка = Неопределено;
	Если Значение <> Неопределено Тогда
		Ссылка = ИИО_Ответ.СсылкаАргумента(Значение);
		Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Организации") Тогда
			Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'organization - не организация.'"),
				Подсказка);
		КонецЕсли;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 21
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И &Отбор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	Запрос = Новый Запрос(СтрЗаменить(ТекстЗапроса, "&Отбор",
		?(Значение = Неопределено, "ИСТИНА", "Организации.Ссылка = &Ссылка")));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Организации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Организации.Количество() = 1 Тогда
		Возврат Организации[0];
	ИначеЕсли Организации.Количество() = 0 Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			НСтр("ru = 'Организация не найдена или недоступна пользователю.'"), Подсказка);
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("AMBIGUOUS", НСтр("ru = 'В базе несколько организаций.'"),
		НСтр("ru = 'Спроси пользователя, какую организацию проверить, и передай ее ref в organization.'"),
		Новый Структура("candidates", ИИО_Ответ.ДанныеДляМодели(Организации)));

КонецФункции

// Начало проверяемого месяца из аргумента month (ГГГГ-ММ); без него - месяц последней проводки.
//
// Параметры:
//  Аргументы - см. Проверить
//  ПоследняяПроводка - Дата
//
// Возвращаемое значение:
//  Дата, Структура - Начало месяца или ошибка для модели.
Функция МесяцПроверки(Аргументы, ПоследняяПроводка)

	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "month");
	Если Значение = Неопределено Тогда
		Возврат НачалоМесяца(ПоследняяПроводка);
	КонецЕсли;
	Дата = ИИО_ОтветКлиентСервер.ДатаАргумента(Строка(Значение) + "-01");
	Если Дата = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'Месяц %1 не распознан.'"), Значение),
			НСтр("ru = 'Передай month в виде ГГГГ-ММ, например 2016-03, или не передавай: тогда проверится месяц последней проводки.'"));
	КонецЕсли;
	Возврат НачалоМесяца(Дата);

КонецФункции

#КонецОбласти

#Область Проверки

// Операция «Закрытие счетов 90, 91» за месяц выполнена. Ее нет - месяц не закрыт.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//
// Возвращаемое значение:
//  Булево
Функция ПроверитьЗакрытие(Контекст)

	Если Не ПравоДоступа("Чтение", Метаданные.Документы.РегламентнаяОперация) Тогда
		Пропустить(Контекст, "CLOSING_NOT_DONE", ПричинаНетПрава());
		Возврат Ложь;
	КонецЕсли;
	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Операции.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РегламентнаяОперация КАК Операции
		|ГДЕ
		|	Операции.Дата МЕЖДУ &Начало И &Конец
		|	И Операции.Организация = &Организация
		|	И Операции.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыРегламентныхОпераций.ЗакрытиеСчетов90_91)
		|	И Операции.Состояние = ЗНАЧЕНИЕ(Перечисление.ВидыСостоянийРегламентныхОпераций.Выполнено)
		|	И НЕ Операции.ПометкаУдаления");
	Выполнено = Не Запрос.Выполнить().Пустой();
	ДобавитьИтог(Контекст, "CLOSING_NOT_DONE", ?(Выполнено, 0, 1));
	Возврат Выполнено;

КонецФункции

// Непроведенные документы месяца, которые делают проводки, кроме регламентных операций: их закрытие месяца
// записывает без проведения. Документы, которые perform post не проводит («Операция», введенная вручную, пишет
// проводки при записи и непроведенной выглядит всегда), тоже не берутся.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
Процедура ПроверитьНепроведенные(Контекст)

	ТекстЧасти =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата
	|ИЗ
	|	&ТаблицаДокументов КАК Документы
	|ГДЕ
	|	Документы.Дата МЕЖДУ &Начало И &Конец
	|	И Документы.Организация = &Организация
	|	И НЕ Документы.Проведен
	|	И НЕ Документы.ПометкаУдаления";
	Хозрасчетный = Метаданные.РегистрыБухгалтерии.Хозрасчетный;
	Части = Новый Массив;
	Для Каждого Документ Из Метаданные.Документы Цикл
		Если Документ = Метаданные.Документы.РегламентнаяОперация
			Или Не ИИО_ДействияПроведение.Применимо("post", Документ)
			Или Не Документ.Движения.Содержит(Хозрасчетный)
			Или Документ.Реквизиты.Найти("Организация") = Неопределено
			Или Не ПравоДоступа("Чтение", Документ) Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрЗаменить(ТекстЧасти, "&ТаблицаДокументов ", Документ.ПолноеИмя() + " ");
		// РАЗРЕШЕННЫЕ в объединении указывается только в первом запросе и действует на весь запрос.
		Если Части.Количество() > 0 Тогда
			Текст = СтрЗаменить(Текст, "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
		КонецЕсли;
		Части.Добавить(Текст);
	КонецЦикла;
	Если Части.Количество() = 0 Тогда
		Пропустить(Контекст, "UNPOSTED_DOCUMENTS", ПричинаНетПрава());
		Возврат;
	КонецЕсли;

	Запрос = НовыйЗапрос(Контекст, СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Дата");
	Найденные = Запрос.Выполнить().Выгрузить();
	Контекст.Непроведенные = ПервыеСсылки(Контекст, Найденные);
	ДобавитьИтог(Контекст, "UNPOSTED_DOCUMENTS", Найденные.Количество(), , Контекст.Непроведенные);

КонецПроцедуры

// Проведенные документы месяца с НДС в проводках, на которые не выписан счет-фактура.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Код - Строка - Код проверки.
//  ИмяДокумента - Строка - Документ реализации или поступления.
//  ИмяСчетаФактуры - Строка - Счет-фактура с табличной частью ДокументыОснования.
//  ПолеСчета - Строка - СчетДт или СчетКт: сторона проводки по счету НДС.
//  КодСчета - Строка - Счет НДС: 68.02 у реализации, 19 у поступления.
Процедура ПроверитьСчетаФактуры(Контекст, Код, ИмяДокумента, ИмяСчетаФактуры, ПолеСчета, КодСчета)

	Если Не ПравоДоступа("Чтение", Метаданные.Документы[ИмяДокумента])
		Или Не ПравоДоступа("Чтение", Метаданные.Документы[ИмяСчетаФактуры]) Тогда
		Пропустить(Контекст, Код, ПричинаНетПрава());
		Возврат;
	КонецЕсли;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.Дата КАК Дата,
	|	Документы.СуммаДокумента КАК Сумма
	|ИЗ
	|	&Документ КАК Документы
	|ГДЕ
	|	Документы.Дата МЕЖДУ &Начало И &Конец
	|	И Документы.Организация = &Организация
	|	И Документы.Проведен
	|	И Документы.Ссылка В
	|			(ВЫБРАТЬ
	|				Проводки.Регистратор КАК Регистратор
	|			ИЗ
	|				РегистрБухгалтерии.Хозрасчетный КАК Проводки
	|			ГДЕ
	|				Проводки.Период МЕЖДУ &Начало И &Конец
	|				И Проводки.Организация = &Организация
	|				И &ПолеСчета В ИЕРАРХИИ (&Счета))
	|	И НЕ Документы.Ссылка В
	|				(ВЫБРАТЬ
	|					Основания.ДокументОснование КАК ДокументОснование
	|				ИЗ
	|					&Основания КАК Основания
	|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ &СчетФактура КАК СчетаФактуры
	|						ПО Основания.Ссылка = СчетаФактуры.Ссылка
	|				ГДЕ
	|					СчетаФактуры.Дата >= &Начало
	|					И НЕ СчетаФактуры.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Документ ", "Документ." + ИмяДокумента + " ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Основания ", "Документ." + ИмяСчетаФактуры + ".ДокументыОснования ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СчетФактура ", "Документ." + ИмяСчетаФактуры + " ");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСчета", "Проводки." + ПолеСчета);
	Запрос = НовыйЗапрос(Контекст, ТекстЗапроса);
	Запрос.УстановитьПараметр("Счета", Счета(Контекст, КодСчета));
	Найденные = Запрос.Выполнить().Выгрузить();
	ДобавитьИтог(Контекст, Код, Найденные.Количество(), Найденные.Итог("Сумма"), ПервыеСсылки(Контекст, Найденные));

КонецПроцедуры

// Остатки счетов на конец месяца по подразделению и субконто, отобранные условием.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Код - Строка - Код проверки.
//  КодыСчетов - Строка - Коды счетов через запятую, с субсчетами.
//  Условие - Строка - Условие на поля виртуальной таблицы Остатки.
Процедура ПроверитьОстатки(Контекст, Код, КодыСчетов, Условие)

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(
	|			&Граница,
	|			Счет В ИЕРАРХИИ (&Счета),
	|			,
	|			Организация = &Организация) КАК Остатки
	|ГДЕ
	|	&Условие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТОстатки.Счет КАК Счет,
	|	СчетаОстатков.Код КАК КодСчета,
	|	СчетаОстатков.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ВТОстатки.Подразделение КАК Подразделение,
	|	ВТОстатки.Субконто1 КАК Субконто1,
	|	ВТОстатки.Субконто2 КАК Субконто2,
	|	ВТОстатки.Субконто3 КАК Субконто3,
	|	ВТОстатки.Сумма КАК Сумма,
	|	ВТОстатки.Количество КАК Количество
	|ИЗ
	|	ВТОстатки КАК ВТОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный КАК СчетаОстатков
	|		ПО ВТОстатки.Счет = СчетаОстатков.Ссылка";
	Запрос = НовыйЗапрос(Контекст, СтрЗаменить(ТекстЗапроса, "&Условие", Условие));
	Запрос.УстановитьПараметр("Счета", Счета(Контекст, КодыСчетов));
	Остатки = Запрос.Выполнить().Выгрузить();
	Остатки.Колонки.Добавить("Порядок", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Остатки Цикл
		Строка.Порядок = Макс(Строка.Сумма, -Строка.Сумма);
	КонецЦикла;
	Остатки.Сортировать("Порядок Убыв");

	Элементы = Новый Массив;
	Отобранные = Новый Массив;
	Для Каждого Строка Из Остатки Цикл
		Если Элементы.Количество() = Контекст.Лимит Тогда
			Прервать;
		КонецЕсли;
		Отобранные.Добавить(Строка);
		Аналитика = Новый Массив;
		Для Каждого Поле Из СтрРазделить("Субконто1,Субконто2,Субконто3", ",") Цикл
			Если ЗначениеЗаполнено(Строка[Поле]) Тогда
				Аналитика.Добавить(Строка[Поле]);
			КонецЕсли;
		КонецЦикла;
		Элемент = Новый Структура("account, analytics, amount", Строка.КодСчета, Аналитика, Строка.Сумма);
		Если ЗначениеЗаполнено(Строка.Подразделение) Тогда
			Элемент.Вставить("department", Строка.Подразделение);
		КонецЕсли;
		Если Строка.Количество <> 0 Тогда
			Элемент.Вставить("quantity", Строка.Количество);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;
	// Без строк запросы оборотов и баз не нужны.
	Если Отобранные.Количество() > 0 Тогда
		Строки = Остатки.Скопировать(Отобранные);
		Если Код = "COST_BALANCES" Тогда
			РасшифроватьЗатраты(Контекст, Строки, Элементы);
		ИначеЕсли Код = "NEGATIVE_STOCK" Тогда
			РасшифроватьМинусы(Контекст, Строки, Элементы);
		ИначеЕсли Код = "STOCK_SUM_WITHOUT_QUANTITY" Тогда
			ДобавитьДокументыСтрок(Контекст, Строки, Элементы, Истина);
		КонецЕсли;
	КонецЕсли;
	ДобавитьИтог(Контекст, Код, Остатки.Количество(), Остатки.Итог("Сумма"), Элементы);
	Если Код = "NEGATIVE_STOCK" И Остатки.Количество() > 0 И СписаниеБезОстатковРазрешено() Тогда
		Контекст.Находки[Контекст.Находки.ВГраница()].Вставить("allow_negative_stock", Истина);
	КонецЕсли;

КонецПроцедуры

// Документы месяца, давшие сумму строки, крупные первыми: по Дт, а у кредитового остатка - по Кт.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Строки - ТаблицаЗначений - Отобранные строки остатков в порядке Элементы, см. ПроверитьОстатки.
//  Элементы - Массив из Структура - items находки, дополняются на месте: documents.
//  ПоПозициям - Булево - Обороты читаются только по первому субконто строк: у 41, 10 и 43 оно ведется
//    с остатками и у строки есть, а у 25, 26 и 44 - только оборотами и в строке остатка пустое.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - Обороты строк за месяц:
//   * Ключ - Число - Номер строки.
//   * Значение - Структура - Дт, Кт: суммы оборотов.
Функция ДобавитьДокументыСтрок(Контекст, Строки, Элементы, ПоПозициям = Ложь)

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Обороты.Счет КАК Счет,
	|	Обороты.Подразделение КАК Подразделение,
	|	Обороты.Субконто1 КАК Субконто1,
	|	Обороты.Субконто2 КАК Субконто2,
	|	Обороты.Субконто3 КАК Субконто3,
	|	Обороты.Регистратор КАК Ссылка,
	|	Обороты.СуммаОборотДт КАК Дт,
	|	Обороты.СуммаОборотКт КАК Кт
	|ПОМЕСТИТЬ ВТОбороты
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Обороты(
	|			&Начало,
	|			&Конец,
	|			Регистратор,
	|			Счет В (&СчетаСтрок),
	|			,
	|			Организация = &Организация
	|				И &ОтборПозиций) КАК Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТСтроки.Номер КАК Номер,
	|	Обороты.Ссылка КАК Ссылка,
	|	СУММА(Обороты.Дт) КАК Дт,
	|	СУММА(Обороты.Кт) КАК Кт,
	|	СУММА(ВЫБОР
	|			КОГДА ВТСтроки.Сумма < 0
	|				ТОГДА Обороты.Кт
	|			ИНАЧЕ Обороты.Дт
	|		КОНЕЦ) КАК Оборот
	|ИЗ
	|	ВТСтроки КАК ВТСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбороты КАК Обороты
	|		ПО &СоединениеСтрок
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТСтроки.Номер,
	|	Обороты.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Оборот УБЫВ";
	Обороты = ОборотыСтрок(Контекст, Строки, СтрЗаменить(ТекстЗапроса, "&ОтборПозиций",
		?(ПоПозициям, "Субконто1 В (&Субконто1Строк)", "ИСТИНА")));
	Итоги = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Итог = Новый Структура("Дт, Кт", 0, 0);
		Ссылки = Новый Массив;
		Для Каждого Оборот Из Обороты.НайтиСтроки(Новый Структура("Номер", Строка.Номер)) Цикл
			Итог.Дт = Итог.Дт + Оборот.Дт;
			Итог.Кт = Итог.Кт + Оборот.Кт;
			Если Оборот.Оборот > 0 И Ссылки.Количество() < ДокументовВСтроке(Контекст) Тогда
				Ссылки.Добавить(Оборот.Ссылка);
			КонецЕсли;
		КонецЦикла;
		Элементы[Строка.Номер].Вставить("documents", Ссылки);
		Итоги.Вставить(Строка.Номер, Итог);
	КонецЦикла;
	Возврат Итоги;

КонецФункции

// Остаток затрат до документов и причины: документы месяца, давшие затраты по строке, крупные первыми, и почему
// закрытие их не списало - по оборотам строки за месяц.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Строки - ТаблицаЗначений - Отобранные строки остатков в порядке Элементы, см. ПроверитьОстатки.
//  Элементы - Массив из Структура - items находки, дополняются на месте: documents, reason, policy.
Процедура РасшифроватьЗатраты(Контекст, Строки, Элементы)

	Обороты = ДобавитьДокументыСтрок(Контекст, Строки, Элементы);
	Базы = БазыМесяца(Контекст, Строки);
	Для Каждого Строка Из Строки Цикл
		Элемент = Элементы[Строка.Номер];
		Правила = ПравилаСтроки(Контекст, Строка);
		Политика = Новый Структура;
		Если Правила.Распределяется <> Неопределено Тогда
			Политика.Вставить("distributed", Правила.Распределяется);
		КонецЕсли;
		Если Правила.Базы.Количество() > 0 Тогда
			Политика.Вставить("allocation", Правила.Базы);
		КонецЕсли;
		Если ЗначениеЗаполнено(Правила.НЗП) Тогда
			Политика.Вставить("wip", Правила.НЗП);
		КонецЕсли;
		Если Политика.Количество() > 0 Тогда
			Элемент.Вставить("policy", Политика);
		КонецЕсли;
		Элемент.Вставить("reason", ПричинаОстатка(Строка, Обороты[Строка.Номер], Правила, Базы));
	КонецЦикла;

КонецПроцедуры

// Почему закрытие не списало остаток строки: по оборотам месяца, учетной политике и данным баз распределения.
//
// Параметры:
//  Строка - СтрокаТаблицыЗначений - Строка остатка, см. ПроверитьОстатки.
//  Обороты - Структура - Дт, Кт строки за месяц, см. ДобавитьДокументыСтрок.
//  Правила - см. ПравилаСтроки
//  Базы - см. БазыМесяца
//
// Возвращаемое значение:
//  Строка - Код причины.
Функция ПричинаОстатка(Строка, Обороты, Правила, Базы)

	Если Строка.УчетПоПодразделениям И Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
		Возврат "NO_DEPARTMENT";
	ИначеЕсли Строка.Сумма < 0 Тогда
		Возврат "OVER_WRITTEN_OFF";
	ИначеЕсли Обороты.Дт = 0 И Обороты.Кт = 0 Тогда
		Возврат "FROM_PREVIOUS_MONTHS";
	ИначеЕсли Обороты.Кт <> 0 Тогда
		Возврат "PARTLY_WRITTEN_OFF";
	ИначеЕсли СтрНачинаетсяС(Строка.КодСчета, "20") Или СтрНачинаетсяС(Строка.КодСчета, "23") Тогда
		// Производство закрывается по выручке и выпуску номенклатурной группы. Строка без группы (20.02 - по
		// номенклатуре давальца) по выручке группы не проверить.
		Если ТипЗнч(Строка.Субконто1) <> Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
			Возврат "unknown";
		КонецЕсли;
		Возврат ?(Базы.Группы.Получить(Строка.Субконто1) = Неопределено, "NO_BASE", "unknown");
	КонецЕсли;
	// Косвенные затраты: базы распределения из учетной политики. Нет базы - только если все базы строки проверены
	// по данным месяца и данных нет; у счета, который закрывается целиком, баз нет, и базой его остаток не объяснить.
	Для Каждого Проверка Из Правила.Проверки Цикл
		Если Не ЗначениеЗаполнено(Проверка) Или Базы[Проверка] Тогда
			Возврат "unknown";
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Правила.Проверки.Количество() > 0, "NO_BASE", "unknown");

КонецФункции

// Правила учетной политики для строки остатка, как их применяет закрытие месяца БП:
// - распределяется ли счет: по роли счета в настройках, без роли - по умолчанию (25 - косвенные затраты,
//   26 и 44 закрываются целиком);
// - базы распределения: правила счета, а без них - основной набор, правила первого счета с правилами; правило
//   подразделения строки заменяет общее правило счета; правила чужого филиала и отдельных статей затрат
//   к строке остатка, где статьи нет, не относятся (отобраны в ПолитикаЗатрат);
// - способ учета НЗП счета. Правило счета-группы действует на субсчета.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  СтрокаОстатка - СтрокаТаблицыЗначений - Строка остатка, см. ПроверитьОстатки.
//
// Возвращаемое значение:
//  Структура:
//   * Распределяется - Булево, Неопределено - Неопределено у 20 и 23, у 26 с ролью «Косвенные затраты» с 2021 года
//     и без учетной политики.
//   * Базы - Массив из Строка - Представления баз распределения.
//   * Проверки - Массив из Строка - По базе: Выручка, ПрямыеЗатраты, Выпуск или пустая - по данным не проверяется.
//   * НЗП - Строка - Способ учета НЗП, пустая - правила нет.
Функция ПравилаСтроки(Контекст, СтрокаОстатка)

	Правила = Новый Структура("Распределяется, Базы, Проверки, НЗП", Неопределено, Новый Массив, Новый Массив, "");
	Политика = Контекст.Политика;
	Если Политика = Неопределено Тогда
		Возврат Правила;
	КонецЕсли;
	Для Каждого Правило Из Политика.НЗП Цикл
		Если ЭтоСчетПравила(СтрокаОстатка.Счет, Правило.Счет) Тогда
			Правила.НЗП = Правило.Вариант;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// Основной набор правил распределения - для косвенных затрат, у счетов производства его не показываем.
	Если СтрНачинаетсяС(СтрокаОстатка.КодСчета, "20") Или СтрНачинаетсяС(СтрокаОстатка.КодСчета, "23") Тогда
		Возврат Правила;
	КонецЕсли;
	Правила.Распределяется = СтрНачинаетсяС(СтрокаОстатка.КодСчета, "25");
	Для Каждого Роль Из Политика.Роли Цикл
		Если ЭтоСчетПравила(СтрокаОстатка.Счет, Роль.Счет) Тогда
			Правила.Распределяется = Роль.КосвенныеЗатраты;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// С 2021 года (ФСБУ 5) базовая БП закрывает 26 целиком и при роли «Косвенные затраты», а в КОРП роль может
	// действовать: распределяется ли счет, не определить.
	Если Правила.Распределяется И СтрНачинаетсяС(СтрокаОстатка.КодСчета, "26") И Контекст.Начало >= '20210101' Тогда
		Правила.Распределяется = Неопределено;
		Возврат Правила;
	КонецЕсли;
	Если Не Правила.Распределяется Тогда
		Возврат Правила;
	КонецЕсли;
	Набор = ПравилаСчета(Политика.Распределение, СтрокаОстатка.Счет);
	Если Набор.Количество() = 0 И Политика.Распределение.Количество() > 0 Тогда
		Набор = ПравилаСчета(Политика.Распределение, Политика.Распределение[0].Счет);
	КонецЕсли;
	Свои = Новый Массив;
	Общие = Новый Массив;
	Для Каждого Правило Из Набор Цикл
		Если Не ЗначениеЗаполнено(Правило.Подразделение) Тогда
			Общие.Добавить(Правило);
		ИначеЕсли Правило.Подразделение = СтрокаОстатка.Подразделение Тогда
			Свои.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Правило Из ?(Свои.Количество() > 0, Свои, Общие) Цикл
		Если Правила.Базы.Найти(Правило.База) = Неопределено Тогда
			Правила.Базы.Добавить(Правило.База);
			Правила.Проверки.Добавить(Правило.Проверка);
		КонецЕсли;
	КонецЦикла;
	Возврат Правила;

КонецФункции

// Правила распределения счета (и его счета-группы) из правил учетной политики.
//
// Параметры:
//  Распределение - ТаблицаЗначений - см. ПолитикаЗатрат
//  Счет - ПланСчетовСсылка.Хозрасчетный
//
// Возвращаемое значение:
//  Массив из СтрокаТаблицыЗначений
Функция ПравилаСчета(Распределение, Счет)

	Правила = Новый Массив;
	Для Каждого Правило Из Распределение Цикл
		Если ЭтоСчетПравила(Счет, Правило.Счет) Тогда
			Правила.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Правила;

КонецФункции

Функция ЭтоСчетПравила(Счет, СчетПравила)

	Возврат Счет = СчетПравила Или Счет.ПринадлежитЭлементу(СчетПравила);

КонецФункции

// Данные месяца, по которым проверяются базы распределения: выручка (Кт 90.01), прямые затраты (Дт 20), выпуск
// (Дт 40 и 43 с Кт 20) по организации и выручка по номенклатурным группам строк.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Строки - ТаблицаЗначений - Отобранные строки остатков, см. ПроверитьОстатки.
//
// Возвращаемое значение:
//  Структура:
//   * Группы - Соответствие из КлючИЗначение - Номенклатурные группы строк с выручкой: ключ - группа.
//   * Выручка - Булево
//   * ПрямыеЗатраты - Булево
//   * Выпуск - Булево
Функция БазыМесяца(Контекст, Строки)

	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Выручка.Субконто1 КАК Группа
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&Начало,
		|			&Конец,
		|			,
		|			Счет В ИЕРАРХИИ (&Выручка),
		|			&ВидыГрупп,
		|			Организация = &Организация
		|				И Субконто1 В (&Группы)) КАК Выручка
		|ГДЕ
		|	Выручка.СуммаОборотКт > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""Выручка"" КАК База,
		|	ЕСТЬNULL(Обороты.СуммаОборотКт, 0) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&Начало,
		|			&Конец,
		|			,
		|			Счет В ИЕРАРХИИ (&Выручка),
		|			,
		|			Организация = &Организация) КАК Обороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""ПрямыеЗатраты"",
		|	ЕСТЬNULL(Обороты.СуммаОборотДт, 0)
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&Начало,
		|			&Конец,
		|			,
		|			Счет В ИЕРАРХИИ (&Производство),
		|			,
		|			Организация = &Организация) КАК Обороты
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Выпуск"",
		|	ЕСТЬNULL(Выпуск.СуммаОборот, 0)
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОборотыДтКт(
		|			&Начало,
		|			&Конец,
		|			,
		|			СчетДт В ИЕРАРХИИ (&Выпуск),
		|			,
		|			СчетКт В ИЕРАРХИИ (&Производство),
		|			,
		|			Организация = &Организация) КАК Выпуск");
	Запрос.УстановитьПараметр("Выручка", Счета(Контекст, "90.01"));
	Запрос.УстановитьПараметр("Производство", Счета(Контекст, "20"));
	Запрос.УстановитьПараметр("Выпуск", Счета(Контекст, "40,43"));
	Запрос.УстановитьПараметр("ВидыГрупп", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ВидСубконто("НоменклатурныеГруппы")));
	Запрос.УстановитьПараметр("Группы", Строки.ВыгрузитьКолонку("Субконто1"));
	Результаты = Запрос.ВыполнитьПакет();
	Базы = Новый Структура("Группы, Выручка, ПрямыеЗатраты, Выпуск", Новый Соответствие, Ложь, Ложь, Ложь);
	Для Каждого Группа Из Результаты[0].Выгрузить().ВыгрузитьКолонку("Группа") Цикл
		Базы.Группы.Вставить(Группа, Истина);
	КонецЦикла;
	Для Каждого Оборот Из Результаты[1].Выгрузить() Цикл
		Базы[Оборот.База] = Базы[Оборот.База] Или Оборот.Сумма > 0;
	КонецЦикла;
	Возврат Базы;

КонецФункции

// Затраты на 20 и 23 с субконто «Продукция» при НЗП по результатам инвентаризации: незавершенное производство они
// не формируют, закрытие списывает их целиком, даже без выручки.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
Процедура ПроверитьПродукциюПриНЗП(Контекст)

	Код = "PRODUCT_COSTS_WITH_WIP_INVENTORY";
	Если Контекст.Политика = Неопределено Тогда
		Пропустить(Контекст, Код, ПричинаНетПрава());
		Возврат;
	КонецЕсли;
	СчетаНЗП = Новый Массив;
	// С «Продукцией» в разрезах НЗП инвентаризация оценивает НЗП по продукции, и такие затраты НЗП формируют.
	Для Каждого Правило Из Контекст.Политика.НЗП Цикл
		Если Правило.ПоИнвентаризации И Не Правило.ПоПродукции Тогда
			СчетаНЗП.Добавить(Правило.Счет);
		КонецЕсли;
	КонецЦикла;
	Если СчетаНЗП.Количество() = 0 Тогда
		ДобавитьИтог(Контекст, Код, 0);
		Возврат;
	КонецЕсли;
	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Обороты.Регистратор КАК Ссылка,
		|	СУММА(Обороты.СуммаОборотДт) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&Начало,
		|			&Конец,
		|			Регистратор,
		|			Счет В ИЕРАРХИИ (&СчетаНЗП),
		|			&ВидыПродукции,
		|			Организация = &Организация
		|				И Субконто1 <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Обороты
		|ГДЕ
		|	Обороты.СуммаОборотДт > 0
		|
		|СГРУППИРОВАТЬ ПО
		|	Обороты.Регистратор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Сумма УБЫВ");
	Запрос.УстановитьПараметр("СчетаНЗП", СчетаНЗП);
	Запрос.УстановитьПараметр("ВидыПродукции", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВидСубконто("Продукция")));
	Найденные = Запрос.Выполнить().Выгрузить();
	ДобавитьИтог(Контекст, Код, Найденные.Количество(), Найденные.Итог("Сумма"), ПервыеСсылки(Контекст, Найденные));

КонецПроцедуры

// Минус до документа: после какого документа месяца остаток ушел в минус и так остался, и поступления позже него.
// Минус по количеству ищется по количеству, суммовой - по сумме.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Строки - ТаблицаЗначений - Отобранные строки остатков в порядке Элементы, см. ПроверитьОстатки.
//  Элементы - Массив из Структура - items находки, дополняются на месте: went_negative, receipts_after,
//    negative_before_month.
Процедура РасшифроватьМинусы(Контекст, Строки, Элементы)

	// Остатки по регистраторам считаются только по позициям строк: первое субконто 41, 10 и 43 ведется с остатками,
	// у строки оно есть.
	Обороты = ОборотыСтрок(Контекст, Строки,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Обороты.Счет КАК Счет,
		|	Обороты.Подразделение КАК Подразделение,
		|	Обороты.Субконто1 КАК Субконто1,
		|	Обороты.Субконто2 КАК Субконто2,
		|	Обороты.Субконто3 КАК Субконто3,
		|	Обороты.Регистратор КАК Ссылка,
		|	Обороты.Период КАК Период,
		|	ЕСТЬNULL(Обороты.КоличествоНачальныйОстаток, 0) КАК КоличествоНачало,
		|	ЕСТЬNULL(Обороты.КоличествоКонечныйОстаток, 0) КАК КоличествоКонец,
		|	ЕСТЬNULL(Обороты.КоличествоОборотДт, 0) КАК КоличествоДт,
		|	Обороты.СуммаНачальныйОстаток КАК СуммаНачало,
		|	Обороты.СуммаКонечныйОстаток КАК СуммаКонец,
		|	Обороты.СуммаОборотДт КАК СуммаДт
		|ПОМЕСТИТЬ ВТОбороты
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.ОстаткиИОбороты(
		|			&Начало,
		|			&Конец,
		|			Регистратор,
		|			,
		|			Счет В (&СчетаСтрок),
		|			,
		|			Организация = &Организация
		|				И Субконто1 В (&Субконто1Строк)) КАК Обороты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСтроки.Номер КАК Номер,
		|	Обороты.Ссылка КАК Ссылка,
		|	Обороты.Период КАК Период,
		|	Обороты.КоличествоНачало КАК КоличествоНачало,
		|	Обороты.КоличествоКонец КАК КоличествоКонец,
		|	Обороты.КоличествоДт КАК КоличествоДт,
		|	Обороты.СуммаНачало КАК СуммаНачало,
		|	Обороты.СуммаКонец КАК СуммаКонец,
		|	Обороты.СуммаДт КАК СуммаДт
		|ИЗ
		|	ВТСтроки КАК ВТСтроки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОбороты КАК Обороты
		|		ПО &СоединениеСтрок
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	Ссылка");
	Для Каждого Строка Из Строки Цикл
		Элемент = Элементы[Строка.Номер];
		Поле = ?(Строка.Количество < 0, "Количество", "Сумма");
		ПоСтроке = Обороты.НайтиСтроки(Новый Структура("Номер", Строка.Номер));
		// Остаток на конец не нулевой, и без движений в месяце таблица отдает строку остатка. Пустой выборка бывает,
		// только если данные изменились между запросами остатков и оборотов: строка остается без расшифровки.
		Если ПоСтроке.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Минус на начало первой строки пришел из прошлых месяцев.
		Если ПоСтроке[0][Поле + "Начало"] < 0 Тогда
			Элемент.Вставить("negative_before_month", Истина);
		КонецЕсли;
		УшелВМинус = Неопределено;
		Поступления = Новый Массив;
		Для Каждого Оборот Из ПоСтроке Цикл
			Если Оборот[Поле + "Начало"] >= 0 И Оборот[Поле + "Конец"] < 0 Тогда
				УшелВМинус = Оборот.Ссылка;
				Поступления.Очистить();
			ИначеЕсли УшелВМинус <> Неопределено
				И Оборот[Поле + "Дт"] > 0
				И Поступления.Количество() < ДокументовВСтроке(Контекст) Тогда
				Поступления.Добавить(Оборот.Ссылка);
			КонецЕсли;
		КонецЦикла;
		Если УшелВМинус <> Неопределено Тогда
			Элемент.Вставить("went_negative", УшелВМинус);
			Элемент.Вставить("receipts_after", Поступления);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Обороты месяца по отобранным строкам остатков: строки помещаются во временную таблицу ВТСтроки с колонкой Номер -
// индексом в Элементы. Текст запроса помещает обороты виртуальной таблицы во временную таблицу ВТОбороты с полями
// аналитики строки и соединяет ее с ВТСтроки условием &СоединениеСтрок: с виртуальной таблицей напрямую не соединяется.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Строки - ТаблицаЗначений - Колонки Счет, Подразделение, Субконто1-3; получает колонку Номер.
//  ТекстЗапроса - Строка - Пакет: ВТОбороты, затем обороты с колонкой Номер.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Результат запроса.
Функция ОборотыСтрок(Контекст, Строки, ТекстЗапроса)

	Строки.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Строки Цикл
		Строка.Номер = Строки.Индекс(Строка);
	КонецЦикла;
	// Поле строки NULL - вид субконто только с оборотами (статьи затрат), его нет у счета или счет без учета
	// по подразделениям: такое поле строку не отбирает, NULL с обеих сторон считается совпадением.
	Соединение = "ВТСтроки.Счет = Обороты.Счет";
	Для Каждого Поле Из СтрРазделить("Подразделение,Субконто1,Субконто2,Субконто3", ",") Цикл
		Соединение = Соединение + СтрШаблон("
		|			И (ЕСТЬNULL(ВТСтроки.%1, ЕСТЬNULL(Обороты.%1, 0)) = ЕСТЬNULL(Обороты.%1, 0))", Поле);
	КонецЦикла;
	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ
		|	Строки.Номер КАК Номер,
		|	Строки.Счет КАК Счет,
		|	Строки.Подразделение КАК Подразделение,
		|	Строки.Субконто1 КАК Субконто1,
		|	Строки.Субконто2 КАК Субконто2,
		|	Строки.Субконто3 КАК Субконто3,
		|	Строки.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТСтроки
		|ИЗ
		|	&Строки КАК Строки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + СтрЗаменить(ТекстЗапроса, "&СоединениеСтрок", Соединение));
	Запрос.УстановитьПараметр("Строки", Строки);
	Запрос.УстановитьПараметр("СчетаСтрок", Строки.ВыгрузитьКолонку("Счет"));
	Запрос.УстановитьПараметр("Субконто1Строк", Строки.ВыгрузитьКолонку("Субконто1"));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Договоры, по которым на конец месяца одновременно есть долг и аванс: аванс не зачтен.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Код - Строка - Код проверки.
//  СчетДолга - Строка - Код счета расчетов: 60.01, 62.01.
//  СчетАванса - Строка - Код счета авансов: 60.02, 62.02.
//  Знак - Число - 1, если долг - дебетовое сальдо (покупатели), -1 - кредитовое (поставщики).
Процедура ПроверитьАвансы(Контекст, Код, СчетДолга, СчетАванса, Знак)

	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Расчеты.Контрагент КАК Контрагент,
		|	Расчеты.Договор КАК Договор,
		|	СУММА(Расчеты.Долг) КАК Долг,
		|	СУММА(Расчеты.Аванс) КАК Аванс
		|ИЗ
		|	(ВЫБРАТЬ
		|		Долги.Субконто1 КАК Контрагент,
		|		Долги.Субконто2 КАК Договор,
		|		&ЗнакДолга * Долги.СуммаОстаток КАК Долг,
		|		0 КАК Аванс
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.Остатки(
		|				&Граница,
		|				Счет В ИЕРАРХИИ (&СчетДолга),
		|				,
		|				Организация = &Организация) КАК Долги
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Авансы.Субконто1,
		|		Авансы.Субконто2,
		|		0,
		|		&ЗнакАванса * Авансы.СуммаОстаток
		|	ИЗ
		|		РегистрБухгалтерии.Хозрасчетный.Остатки(
		|				&Граница,
		|				Счет В ИЕРАРХИИ (&СчетАванса),
		|				,
		|				Организация = &Организация) КАК Авансы) КАК Расчеты
		|
		|СГРУППИРОВАТЬ ПО
		|	Расчеты.Контрагент,
		|	Расчеты.Договор
		|
		|ИМЕЮЩИЕ
		|	СУММА(Расчеты.Долг) > 0
		|	И СУММА(Расчеты.Аванс) > 0");
	Запрос.УстановитьПараметр("СчетДолга", Счета(Контекст, СчетДолга));
	Запрос.УстановитьПараметр("СчетАванса", Счета(Контекст, СчетАванса));
	Запрос.УстановитьПараметр("ЗнакДолга", Знак);
	Запрос.УстановитьПараметр("ЗнакАванса", -Знак);
	Договоры = Запрос.Выполнить().Выгрузить();
	Договоры.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Для Каждого Строка Из Договоры Цикл
		Строка.Сумма = Мин(Строка.Долг, Строка.Аванс);
	КонецЦикла;
	Договоры.Сортировать("Сумма Убыв");

	Элементы = Новый Массив;
	Для Каждого Строка Из Договоры Цикл
		Если Элементы.Количество() = Контекст.Лимит Тогда
			Прервать;
		КонецЕсли;
		Элементы.Добавить(Новый Структура("counterparty, contract, debt, advance", Строка.Контрагент, Строка.Договор,
			Строка.Долг, Строка.Аванс));
	КонецЦикла;
	ДобавитьИтог(Контекст, Код, Договоры.Количество(), Договоры.Итог("Сумма"), Элементы);

КонецПроцедуры

// Сальдо счетов 90 и 91 на конец месяца: после закрытия месяца оно нулевое.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
Процедура ПроверитьСальдо9091(Контекст)

	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""90"" КАК Счет,
		|	СУММА(Продажи.СуммаОстаток) КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Граница,
		|			Счет В ИЕРАРХИИ (&Счет90),
		|			,
		|			Организация = &Организация) КАК Продажи
		|
		|ИМЕЮЩИЕ
		|	СУММА(Продажи.СуммаОстаток) <> 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""91"",
		|	СУММА(Прочие.СуммаОстаток)
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Остатки(
		|			&Граница,
		|			Счет В ИЕРАРХИИ (&Счет91),
		|			,
		|			Организация = &Организация) КАК Прочие
		|
		|ИМЕЮЩИЕ
		|	СУММА(Прочие.СуммаОстаток) <> 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Счет");
	Запрос.УстановитьПараметр("Счет90", Счета(Контекст, "90"));
	Запрос.УстановитьПараметр("Счет91", Счета(Контекст, "91"));
	Сальдо = Запрос.Выполнить().Выгрузить();
	Элементы = Новый Массив;
	Для Каждого Строка Из Сальдо Цикл
		Элементы.Добавить(Новый Структура("account, amount", Строка.Счет, Строка.Сумма));
	КонецЦикла;
	ДобавитьИтог(Контекст, "BALANCE_90_91", Сальдо.Количество(), , Элементы);

КонецПроцедуры

// Документы месяца, которые не провелись при загрузке обменом: предупреждения синхронизации БСП, сведенные
// по тексту причины. Организацию проблемного объекта регистр не хранит, поэтому - по всем организациям.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
Процедура ПроверитьОбмен(Контекст)

	Регистр = Метаданные.РегистрыСведений.Найти("РезультатыОбменаДанными");
	Если Регистр = Неопределено Тогда
		Возврат;
	ИначеЕсли Не ПравоДоступа("Чтение", Регистр) Тогда
		Пропустить(Контекст, "EXCHANGE_NOT_POSTED", ПричинаНетПрава());
		Возврат;
	КонецЕсли;
	Запрос = НовыйЗапрос(Контекст,
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Результаты.ПроблемныйОбъект КАК Ссылка,
		|	Результаты.ДатаДокумента КАК Дата,
		|	Результаты.Причина КАК Причина
		|ИЗ
		|	РегистрСведений.РезультатыОбменаДанными КАК Результаты
		|ГДЕ
		|	Результаты.ТипПроблемы = ЗНАЧЕНИЕ(Перечисление.ТипыПроблемОбменаДанными.НепроведенныйДокумент)
		|	И НЕ Результаты.Пропущена
		|	И Результаты.ДатаДокумента МЕЖДУ &Начало И &Конец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата");
	Найденные = Запрос.Выполнить().Выгрузить();
	// Регистр читается без ограничения по записям, а документы - с ним: недоступные пользователю не показываются,
	// и люди из их реквизитов в pii_context не читаются.
	Доступные = ИИО_Права.ДоступныеСсылки(Найденные.ВыгрузитьКолонку("Ссылка"));
	Количество = 0;
	ПоПричинам = Новый Соответствие;
	Элементы = Новый Массив;
	Для Каждого Строка Из Найденные Цикл
		Если Доступные.Получить(Строка.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Количество = Количество + 1;
		Причина = ИИО_ОтветКлиентСервер.Обрезать(СокрЛП(Строка.Причина), 300);
		Элемент = ПоПричинам.Получить(Причина);
		Если Элемент = Неопределено И Элементы.Количество() = Контекст.Лимит Тогда
			Продолжить;
		ИначеЕсли Элемент = Неопределено Тогда
			Элемент = Новый Структура("reason, count, objects", Причина, 0, Новый Массив);
			ПоПричинам.Вставить(Причина, Элемент);
			Элементы.Добавить(Элемент);
		КонецЕсли;
		Элемент.count = Элемент.count + 1;
		Если Элемент.objects.Количество() < Контекст.Лимит Тогда
			Элемент.objects.Добавить(Строка.Ссылка);
			Контекст.ОбъектыОбмена.Добавить(Строка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	ДобавитьИтог(Контекст, "EXCHANGE_NOT_POSTED", Количество, , Элементы);

КонецПроцедуры

#КонецОбласти

#Область Ответ

// Состояние проверки: параметры запросов и итоги проверок.
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Месяц - Дата - Начало месяца.
//  Лимит - Число - Сколько элементов в каждой проверке.
//
// Возвращаемое значение:
//  Структура:
//   * Организация - СправочникСсылка.Организации
//   * Начало - Дата
//   * Конец - Дата
//   * Лимит - Число
//   * Находки - Массив из Структура - problems ответа.
//   * Пройдены - Массив из Строка - passed ответа.
//   * Пропущены - Массив из Структура - skipped ответа.
//   * Непроведенные - Массив из ДокументСсылка - Документы для perform post.
//   * ОбъектыОбмена - Массив из ЛюбаяСсылка - Документы, чьи ошибки обмена есть в ответе: по ним pii_context.
//   * Счета - см. СчетыПроверок
//   * Политика - см. ПолитикаЗатрат
Функция НовыйКонтекст(Организация, Месяц, Лимит)

	Контекст = Новый Структура;
	Контекст.Вставить("Счета", СчетыПроверок());
	Контекст.Вставить("Политика", Неопределено);
	Контекст.Вставить("Организация", Организация);
	Контекст.Вставить("Начало", Месяц);
	Контекст.Вставить("Конец", КонецМесяца(Месяц));
	Контекст.Вставить("Лимит", Лимит);
	Контекст.Вставить("Находки", Новый Массив);
	Контекст.Вставить("Пройдены", Новый Массив);
	Контекст.Вставить("Пропущены", Новый Массив);
	Контекст.Вставить("Непроведенные", Новый Массив);
	Контекст.Вставить("ОбъектыОбмена", Новый Массив);
	Возврат Контекст;

КонецФункции

// Итог проверки: без находок - в passed, иначе в problems с текстом для модели.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Код - Строка - Код проверки.
//  Количество - Число - Сколько найдено.
//  Сумма - Число, Неопределено - Сумма находок, если она есть.
//  Элементы - Массив, Неопределено - Первые находки, не больше Контекст.Лимит.
Процедура ДобавитьИтог(Контекст, Код, Количество, Сумма = Неопределено, Элементы = Неопределено)

	Если Количество = 0 Тогда
		Контекст.Пройдены.Добавить(Код);
		Возврат;
	КонецЕсли;
	Находка = Новый Структура("code, count", Код, Количество);
	Если Сумма <> Неопределено Тогда
		Находка.Вставить("amount", Сумма);
	КонецЕсли;
	Находка.Вставить("text", ТекстПроверки(Код));
	Если Элементы <> Неопределено Тогда
		Находка.Вставить("items", Элементы);
	КонецЕсли;
	Контекст.Находки.Добавить(Находка);

КонецПроцедуры

Процедура Пропустить(Контекст, Код, Причина)

	Контекст.Пропущены.Добавить(Новый Структура("code, reason", Код, Причина));

КонецПроцедуры

// Первые документы найденных, не больше лимита.
//
// Параметры:
//  Контекст - см. НовыйКонтекст
//  Найденные - ТаблицаЗначений - С колонкой Ссылка.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка
Функция ПервыеСсылки(Контекст, Найденные)

	Ссылки = Новый Массив;
	Для Каждого Строка Из Найденные Цикл
		Если Ссылки.Количество() = Контекст.Лимит Тогда
			Прервать;
		КонецЕсли;
		Ссылки.Добавить(Строка.Ссылка);
	КонецЦикла;
	Возврат Ссылки;

КонецФункции

// Исправления, которые делаются действием: непроведенные документы тех видов, которые пользователь может провести, -
// perform post. В боте - кнопки «Предпросмотр» и «Показать список» под ответом. Остальные непроведенные остаются
// в списке, а action_denied называет точную причину: нет разрешения ИИ-оператора или права на эти виды.
//
// Параметры:
//  Ответ - Структура - Ответ инструмента, меняется на месте.
//  Контекст - см. НовыйКонтекст
//  Кнопки - см. Проверить
//  ПользовательИБ - см. Проверить
//
// Возвращаемое значение:
//  Булево - Под ответом бота добавлены кнопки.
Функция ДобавитьИсправления(Ответ, Контекст, Кнопки, ПользовательИБ)

	КнопокБыло = ?(Кнопки = Неопределено, 0, Кнопки.Количество());
	Если Контекст.Непроведенные.Количество() > 0 Тогда
		Проводимые = ИИО_Права.ДоступныеДляДействия("post", Контекст.Непроведенные, ПользовательИБ);
		Если Проводимые.Количество() > 0 Тогда
			Ответ.Вставить("actions", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				Новый Структура("action, refs", "post", Проводимые)));
			ДобавитьКнопку(Кнопки, "preview", НСтр("ru = 'Предпросмотр проведения'"), "perform",
				Новый Структура("action, refs, dry_run", "post", Проводимые, Ложь));
		КонецЕсли;
		Если Проводимые.Количество() < Контекст.Непроведенные.Количество() Тогда
			Отказ = ИИО_Права.ОшибкаДоступаКДействию(ИИО_Действия.Действия().Получить("post"),
				ИИО_Действия.ВидыОбъектов(Контекст.Непроведенные), , ПользовательИБ);
			Ответ.Вставить("action_denied", Отказ.error.message + " " + Отказ.error.hint);
		КонецЕсли;
	КонецЕсли;
	Заголовки = Новый Структура;
	Заголовки.Вставить("UNPOSTED_DOCUMENTS", НСтр("ru = 'Непроведенные документы'"));
	Заголовки.Вставить("SALES_WITHOUT_INVOICE", НСтр("ru = 'Реализации без счетов-фактур'"));
	Заголовки.Вставить("PURCHASES_WITHOUT_INVOICE", НСтр("ru = 'Поступления без счетов-фактур'"));
	Для Каждого Находка Из Контекст.Находки Цикл
		Если Заголовки.Свойство(Находка.code) Тогда
			ДобавитьКнопку(Кнопки, "show", Заголовки[Находка.code], "show_in_1c",
				Новый Структура("refs, title", Находка.items, Заголовки[Находка.code]));
		КонецЕсли;
	КонецЦикла;
	Возврат Кнопки <> Неопределено И Кнопки.Количество() > КнопокБыло;

КонецФункции

Процедура ДобавитьКнопку(Кнопки, Вид, Заголовок, Инструмент, Аргументы)

	Если Кнопки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого Ссылка Из Аргументы.refs Цикл
		Ссылки.Добавить(ИИО_Ответ.СсылкаВСтроку(Ссылка));
	КонецЦикла;
	Аргументы.refs = Ссылки;
	Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка(Вид, Заголовок, Инструмент, Аргументы));

КонецПроцедуры

// Текст находки для пересказа моделью: что значит и что сделать.
//
// Параметры:
//  Код - Строка - Код проверки.
//
// Возвращаемое значение:
//  Строка
Функция ТекстПроверки(Код)

	Тексты = Новый Соответствие;
	Тексты.Вставить("CLOSING_NOT_DONE", НСтр("ru = 'Закрытие месяца не выполнено: нет выполненной операции «Закрытие счетов 90, 91». Сделать: исправить остальные находки и выполнить обработку «Закрытие месяца».'"));
	Тексты.Вставить("UNPOSTED_DOCUMENTS", НСтр("ru = 'В месяце есть непроведенные документы: их суммы не попали в учет. Сделать: провести (действие post) или пометить на удаление лишние.'"));
	Тексты.Вставить("SALES_WITHOUT_INVOICE", НСтр("ru = 'Реализации с НДС без счета-фактуры: НДС начислен, а в книгу продаж они не попадут. Сделать: выписать счета-фактуры (обработка «Регистрация счетов-фактур» или из документа).'"));
	Тексты.Вставить("PURCHASES_WITHOUT_INVOICE", НСтр("ru = 'Поступления с НДС без полученного счета-фактуры: НДС висит на 19 и не принимается к вычету. Сделать: зарегистрировать счета-фактуры поставщиков.'"));
	Тексты.Вставить("VAT_19_BALANCE", НСтр("ru = 'Остаток на счете 19 на конец месяца: НДС не принят к вычету. Бывает нормой (счет-фактура еще не пришел), иначе - сформировать записи книги покупок.'"));
	Тексты.Вставить("ADVANCES_ISSUED", НСтр("ru = 'По договорам с поставщиками одновременно долг (60.01) и аванс (60.02): аванс не зачтен. Сделать: перепровести поступления или зачесть аванс документом «Корректировка долга».'"));
	Тексты.Вставить("ADVANCES_RECEIVED", НСтр("ru = 'По договорам с покупателями одновременно долг (62.01) и аванс (62.02): аванс не зачтен. Сделать: перепровести реализации или зачесть аванс документом «Корректировка долга».'"));
	Тексты.Вставить("NEGATIVE_STOCK", НСтр("ru = 'Отрицательные остатки на 41, 10 или 43 на конец месяца: списано больше, чем поступило. went_negative - документ, после которого остаток ушел в минус и не вернулся; receipts_after - поступления позже него: если они есть, поступление проведено позже списания. negative_before_month - минус пришел из прошлых месяцев. allow_negative_stock - в настройках проведения разрешено списание запасов без остатков, минус при проведении не останавливается. Сделать: проверить даты, позиции и склады в этих документах.'"));
	Тексты.Вставить("STOCK_SUM_WITHOUT_QUANTITY", НСтр("ru = 'На 41, 10 или 43 на конец месяца есть стоимость без количества: товара нет, а сумма осталась (например, допрасходы отнесены к уже проданной партии). Закрытие месяца спишет эту сумму в расходы. documents - документы месяца, давшие сумму. Сделать: проверить, к какой позиции и партии отнесены расходы.'"));
	Тексты.Вставить("PRODUCT_COSTS_WITH_WIP_INVENTORY", НСтр("ru = 'Затраты на 20 или 23 с субконто «Продукция», а незавершенное производство в учетной политике ведется по результатам инвентаризации без «Продукции» в разрезах НЗП: такие затраты НЗП не формируют, и закрытие спишет их целиком, даже без выручки. items - документы месяца. Сделать: убрать «Продукцию» в этих документах или сменить способ учета НЗП.'"));
	Тексты.Вставить("COST_BALANCES", НСтр("ru = 'После закрытия месяца остались затраты на 20, 23, 25, 26 или 44. documents - документы месяца, давшие сумму строки, крупные первыми. policy - учетная политика строки: distributed - распределяется ли счет (false - закрывается целиком, у 26 и 44 так по умолчанию), allocation - базы распределения, wip - способ учета НЗП. reason: NO_DEPARTMENT - затраты без подразделения на счете с учетом по подразделениям, сделать: указать подразделение в документах; OVER_WRITTEN_OFF - списано больше, чем было затрат (кредитовый остаток), documents - документы с Кт: обычно документы изменены после закрытия - повторить закрытие; FROM_PREVIOUS_MONTHS - оборотов за месяц нет, остаток пришел из прошлых месяцев: проверить месяц, где он появился; PARTLY_WRITTEN_OFF - списана часть: для 25, 26 и 44 обычно документы внесены или изменены после закрытия - повторить закрытие, на 20 и 23 это незавершенное производство, если оно оценено; NO_BASE - ничего не списано, и базы нет по данным месяца: для 20 и 23 нет выручки по номенклатурной группе строки, для 25, 26 и 44, которые распределяются, нет выручки, прямых затрат или выпуска по базе из policy; unknown - ничего не списано, а база есть, ее не проверить по данным или счет закрывается целиком: если счет закрывается целиком (distributed false) или документы внесены после закрытия - повторить закрытие, иначе проверить базу распределения; у 26 с 2021 года без distributed - повторить закрытие, а если остаток остался, проверить базу распределения (в КОРП роль «Косвенные затраты» может действовать).'"));
	Тексты.Вставить("BALANCE_90_91", НСтр("ru = 'Сальдо счета 90 или 91 после закрытия не нулевое: закрытие выполнено до последних изменений. Сделать: повторить закрытие месяца.'"));
	Тексты.Вставить("EXCHANGE_NOT_POSTED", НСтр("ru = 'Документы месяца не провелись при загрузке обменом (по всем организациям). Сделать: открыть документы, исправить причину и провести.'"));
