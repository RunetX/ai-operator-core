#Область СлужебныйПрограммныйИнтерфейс

// Поддерживаемые отчеты текущей конфигурации из макета ИИО_КаталогОтчетов.
// Отчеты, которых нет в конфигурации, пропускаются.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие из КлючИЗначение:
//   * Ключ - Строка - Полное имя отчета, например Отчет.Продажи.
//   * Значение - ФиксированнаяСтруктура:
//     ** ИмяОтчета - Строка
//     ** Адаптер - Строка - accounting.
//     ** Описание - Строка
//     ** КлючевыеСлова - Строка
//     ** Параметры - ФиксированноеСоответствие - Параметры отчета по умолчанию.
//     ** ПустыеЗначения - ФиксированноеСоответствие - Поле строк и подпись его пустого значения.
//     ** Варианты - ФиксированныйМассив из ФиксированнаяСтруктура:
//       *** Ключ - Строка
//       *** Группировки - ФиксированныйМассив из Строка
//       *** Параметры - ФиксированноеСоответствие - Параметры отчета с учетом варианта.
//       *** Описание - Строка
Функция Каталог() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьОбщийМакет("ИИО_КаталогОтчетов").ПолучитьТекст());
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Каталог = Новый Соответствие;
	ОтчетыКонфигурации = Данные.Получить(Метаданные.Имя);
	Если ОтчетыКонфигурации = Неопределено Тогда
		Возврат Новый ФиксированноеСоответствие(Каталог);
	КонецЕсли;

	Для Каждого КлючИЗначение Из ОтчетыКонфигурации Цикл
		ИмяОтчета = СтрЗаменить(КлючИЗначение.Ключ, "Отчет.", "");
		Если Метаданные.Отчеты.Найти(ИмяОтчета) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Описание = КлючИЗначение.Значение;
		Параметры = ЗначениеИлиПустоеСоответствие(Описание.Получить("params"));

		Варианты = Новый Массив;
		Для Каждого ОписаниеВарианта Из Описание.Получить("variants") Цикл
			ПараметрыВарианта = Новый Соответствие;
			Для Каждого Параметр Из Параметры Цикл
				ПараметрыВарианта.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
			Для Каждого Параметр Из ЗначениеИлиПустоеСоответствие(ОписаниеВарианта.Получить("params")) Цикл
				ПараметрыВарианта.Вставить(Параметр.Ключ, Параметр.Значение);
			КонецЦикла;
			Варианты.Добавить(Новый ФиксированнаяСтруктура("Ключ, Группировки, Параметры, Описание",
				ОписаниеВарианта.Получить("key"),
				Новый ФиксированныйМассив(ОписаниеВарианта.Получить("group_by")),
				Новый ФиксированноеСоответствие(ПараметрыВарианта),
				Строка(ОписаниеВарианта.Получить("description"))));
		КонецЦикла;

		Каталог.Вставить(КлючИЗначение.Ключ, Новый ФиксированнаяСтруктура(
			"ИмяОтчета, Адаптер, Описание, КлючевыеСлова, Параметры, ПустыеЗначения, Варианты",
			ИмяОтчета,
			Описание.Получить("adapter"),
			Строка(Описание.Получить("description")),
			Строка(Описание.Получить("keywords")),
			Новый ФиксированноеСоответствие(Параметры),
			Новый ФиксированноеСоответствие(ЗначениеИлиПустоеСоответствие(Описание.Получить("empty_values"))),
			Новый ФиксированныйМассив(Варианты)));
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Каталог);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеИлиПустоеСоответствие(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие);

КонецФункции

#КонецОбласти
