// Фоновые задания модели на клиенте: отложенный ответ, таймаут от фактического старта задания
// и отдельный лимит ожидания очереди. В сеансе выполняется не больше одного задания модели: запроса или отчета.

#Область СлужебныйПрограммныйИнтерфейс

// Ошибка для модели, если новое задание сейчас запускать нельзя.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ошибка NOT_READY или Неопределено, если запускать можно.
Функция ОшибкаЗанятости() Экспорт

	Если АктивноеЗадание() <> Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY", НСтр("ru = 'Предыдущий запрос или отчет еще выполняется.'"),
			НСтр("ru = 'Дождись его результата: запросы и отчеты в сеансе выполняются по одному.'"));
	КонецЕсли;
	Если БазаЗавершаетОтмененноеЗадание() Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
			НСтр("ru = 'База еще завершает запрос или отчет, отмененный по таймауту.'"),
			НСтр("ru = 'Подожди около минуты. Повторяй не тот же вызов, а с суженным отбором или периодом.'"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Как ждать задание и что сообщить модели по таймауту.
//
// Параметры:
//  КодТаймаута - Строка - Код ошибки по таймауту: QUERY_TIMEOUT, REPORT_TIMEOUT.
//  ТекстТаймаута - Строка - Шаблон текста ошибки, %1 - таймаут в секундах.
//  ПодсказкаТаймаута - Строка
//  ОписаниеВыполнения - Строка - Сообщение прогресса, пока задание выполняется.
//
// Возвращаемое значение:
//  Структура:
//   * КодТаймаута - Строка
//   * ТекстТаймаута - Строка
//   * ПодсказкаТаймаута - Строка
//   * ОписаниеВыполнения - Строка
//   * ПослеУспеха - ОписаниеОповещения, Неопределено - Функция(Ответ, ДополнительныеПараметры), которая
//     получает ответ успешно завершенного задания и возвращает ответ для модели.
Функция НоваяНастройкаОжидания(КодТаймаута, ТекстТаймаута, ПодсказкаТаймаута, ОписаниеВыполнения) Экспорт

	Настройка = Новый Структура;
	Настройка.Вставить("КодТаймаута", КодТаймаута);
	Настройка.Вставить("ТекстТаймаута", ТекстТаймаута);
	Настройка.Вставить("ПодсказкаТаймаута", ПодсказкаТаймаута);
	Настройка.Вставить("ОписаниеВыполнения", ОписаниеВыполнения);
	Настройка.Вставить("ПослеУспеха", Неопределено);
	Возврат Настройка;

КонецФункции

// Ждет задание, запущенное ИИО_ФоновыеЗадания.Запустить, и завершает вызов по готовности,
// по таймауту или по лимиту очереди.
//
// Параметры:
//  Вызов - см. ИИО_РеестрИнструментовКлиент.НовыйВызов
//  Запуск - см. ИИО_ФоновыеЗадания.Запустить
//  Начало - Число - Момент вызова инструмента, мс.
//  Настройка - см. НоваяНастройкаОжидания
//
// Возвращаемое значение:
//  Структура - Ответ, если задание завершилось сразу.
//  Неопределено - Ответ придет в вызов после завершения задания.
Функция Ожидать(Вызов, Запуск, Начало, Настройка) Экспорт

	Если Запуск.Ответ <> Неопределено Тогда
		Возврат ГотовыйОтвет(Запуск.Ответ, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, Настройка);
	КонецЕсли;

	Активное = Новый Структура;
	Активное.Вставить("Вызов", Вызов);
	Активное.Вставить("ИдентификаторЗадания", Запуск.ИдентификаторЗадания);
	Активное.Вставить("АдресРезультата", Запуск.АдресРезультата);
	Активное.Вставить("ТаймаутСек", Запуск.ТаймаутСек);
	Активное.Вставить("ОжиданиеОчередиСек", Запуск.ОжиданиеОчередиСек);
	Активное.Вставить("Вид", Запуск.Вид);
	Активное.Вставить("Начало", Начало);
	Активное.Вставить("Старт", Неопределено);
	Активное.Вставить("Настройка", Настройка);
	ПараметрыПриложения.Вставить(ИмяАктивногоЗадания(), Активное);
	Вызов.ОповещениеОбОтмене = Новый ОписаниеОповещения("ПриОтменеВызова", ИИО_ФоновыеЗаданияКлиент,
		Запуск.ИдентификаторЗадания);
	// Обработчик ожидания из общего модуля подключается с интервалом не меньше 1 с.
	ПодключитьОбработчикОжидания("ИИО_ПроверитьФоновоеЗадание", 1, Ложь);
	Возврат Неопределено;

КонецФункции

// Проверяет активное задание: завершает вызов по готовности, по таймауту или по лимиту очереди.
// Вызывается обработчиком ожидания из ИИО_Глобальный.
Процедура Проверить() Экспорт

	Активное = АктивноеЗадание();
	Если Активное = Неопределено Тогда
		ОтключитьОбработчикОжидания("ИИО_ПроверитьФоновоеЗадание");
		Возврат;
	КонецЕсли;

	Попытка
		Состояние = ИИО_ФоновыеЗаданияВызовСервера.СостояниеЗадания(Активное.ИдентификаторЗадания,
			Активное.АдресРезультата, Активное.Старт = Неопределено, Активное.Вид);
	Исключение
		Завершить(Активное, ИИО_ОтветКлиентСервер.Ошибка("INTERNAL",
			ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке())));
		Возврат;
	КонецПопытки;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Активное.Старт = Неопределено И Состояние.Начат Тогда
		Активное.Старт = Сейчас;
	КонецЕсли;
	Настройка = Активное.Настройка;

	Если Состояние.Ответ <> Неопределено Тогда
		// Задание сначала снимается с учета: после успеха может открыться форма, а вызов должен завершиться.
		СнятьСУчета();
		Завершить(Активное, ГотовыйОтвет(Состояние.Ответ, Сейчас - Активное.Начало, Настройка));

	ИначеЕсли Активное.Старт = Неопределено И Сейчас - Активное.Начало > Активное.ОжиданиеОчередиСек * 1000 Тогда
		Отменить(Активное);
		Завершить(Активное, ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
			СтрШаблон(
				НСтр("ru = 'Задание не начало выполняться за %1 с и отменено: база занята своими фоновыми заданиями.'"),
				Формат(Активное.ОжиданиеОчередиСек, "ЧГ=0")),
			НСтр("ru = 'Повтори через пару минут. Так бывает в первые минуты после запуска 1С и во время регламентных заданий.'")));

	ИначеЕсли Активное.Старт <> Неопределено И Сейчас - Активное.Старт > Активное.ТаймаутСек * 1000 Тогда
		Отменить(Активное);
		Завершить(Активное, ИИО_ОтветКлиентСервер.Ошибка(Настройка.КодТаймаута,
			СтрШаблон(Настройка.ТекстТаймаута, Формат(Активное.ТаймаутСек, "ЧГ=0")), Настройка.ПодсказкаТаймаута));

	Иначе
		СообщитьПрогресс(Активное, Сейчас);
	КонецЕсли;

КонецПроцедуры

// Клиент MCP отменил вызов, который ждет задание: задание отменяется, следующий запрос получит NOT_READY,
// пока база не завершит отмененное задание.
//
// Параметры:
//  Причина - Строка - client или timeout, см. ИИО_РеестрИнструментовКлиент.Отменить.
//  ИдентификаторЗадания - УникальныйИдентификатор
Процедура ПриОтменеВызова(Причина, ИдентификаторЗадания) Экспорт

	Активное = АктивноеЗадание();
	Если Активное = Неопределено Или Активное.ИдентификаторЗадания <> ИдентификаторЗадания Тогда
		Возврат;
	КонецЕсли;
	Отменить(Активное);
	СнятьСУчета();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прогресс MCP должен только расти, поэтому отсчитывается от вызова, а срок пересчитывается после старта задания.
//
// Параметры:
//  Активное - см. АктивноеЗадание
//  Сейчас - Число - Текущий момент, мс.
Процедура СообщитьПрогресс(Активное, Сейчас)

	ПрошлоСек = Цел((Сейчас - Активное.Начало) / 1000);
	Если Активное.Старт = Неопределено Тогда
		ИИО_РеестрИнструментовКлиент.СообщитьПрогресс(Активное.Вызов, ПрошлоСек,
			Активное.ОжиданиеОчередиСек + Активное.ТаймаутСек,
			НСтр("ru = 'Ожидание очереди фоновых заданий 1С'"));
	Иначе
		ИИО_РеестрИнструментовКлиент.СообщитьПрогресс(Активное.Вызов, ПрошлоСек,
			Цел((Активное.Старт - Активное.Начало) / 1000) + Активное.ТаймаутСек,
			Активное.Настройка.ОписаниеВыполнения);
	КонецЕсли;

КонецПроцедуры

Процедура Отменить(Активное)

	ИИО_ФоновыеЗаданияВызовСервера.Отменить(Активное.ИдентификаторЗадания);
	ПараметрыПриложения.Вставить(ИмяОтмененногоЗадания(), Активное.ИдентификаторЗадания);

КонецПроцедуры

Процедура Завершить(Активное, Ответ)

	СнятьСУчета();
	ИИО_РеестрИнструментовКлиент.Завершить(Активное.Вызов, Ответ);

КонецПроцедуры

Процедура СнятьСУчета()

	ПараметрыПриложения.Удалить(ИмяАктивногоЗадания());
	ОтключитьОбработчикОжидания("ИИО_ПроверитьФоновоеЗадание");

КонецПроцедуры

// Ответ завершенного задания: обработка после успеха и время ожидания в очереди.
//
// Параметры:
//  Ответ - Структура - Ответ задания или ошибка для модели.
//  ПрошлоМс - Число - Время от вызова инструмента, мс.
//  Настройка - см. НоваяНастройкаОжидания
//
// Возвращаемое значение:
//  Структура - Ответ для модели: ошибка - как есть, иначе с wait_ms вместо run_ms и после обработки ПослеУспеха.
Функция ГотовыйОтвет(Ответ, ПрошлоМс, Настройка)

	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) Тогда
		Возврат Ответ;
	КонецЕсли;
	Если Ответ.Свойство("run_ms") Тогда
		// Время ожидания в очереди - все время вызова за вычетом работы задания.
		Ответ.Вставить("wait_ms", Макс(0, ПрошлоМс - Ответ.run_ms));
		Ответ.Удалить("run_ms");
	КонецЕсли;
	Если Настройка.ПослеУспеха <> Неопределено Тогда
		Ответ = ВыполнитьОбработкуОповещения(Настройка.ПослеУспеха, Ответ);
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// После отмены по таймауту задание в файловой базе завершается не сразу и держит очередь.
//
// Возвращаемое значение:
//  Булево - Истина, если задание, отмененное по таймауту, еще выполняется.
Функция БазаЗавершаетОтмененноеЗадание()

	ИдентификаторЗадания = ПараметрыПриложения.Получить(ИмяОтмененногоЗадания());
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ИИО_ФоновыеЗаданияВызовСервера.ЗаданиеВыполняется(ИдентификаторЗадания) Тогда
		Возврат Истина;
	КонецЕсли;
	ПараметрыПриложения.Удалить(ИмяОтмененногоЗадания());
	Возврат Ложь;

КонецФункции

// Выполняющееся задание модели.
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Вызов - см. ИИО_РеестрИнструментовКлиент.НовыйВызов
//   * ИдентификаторЗадания - УникальныйИдентификатор
//   * АдресРезультата - Строка
//   * ТаймаутСек - Число
//   * ОжиданиеОчередиСек - Число
//   * Вид - Строка
//   * Начало - Число - Момент вызова, мс.
//   * Старт - Число, Неопределено - Момент, когда стало известно о старте задания, мс.
//   * Настройка - см. НоваяНастройкаОжидания
Функция АктивноеЗадание()

	Возврат ПараметрыПриложения.Получить(ИмяАктивногоЗадания());

КонецФункции

Функция ИмяАктивногоЗадания()

	Возврат "ИИО.АктивноеЗадание";

КонецФункции

Функция ИмяОтмененногоЗадания()

	Возврат "ИИО.ОтмененноеЗадание";

КонецФункции

#КонецОбласти
