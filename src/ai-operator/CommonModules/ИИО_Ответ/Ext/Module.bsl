// Преобразование данных 1С в ответ для модели: ссылки, даты, пометки ПДн.

#Область СлужебныйПрограммныйИнтерфейс

// Преобразует данные со значениями 1С в JSON-совместимые.
// Ссылки - {"ref": "ПолноеИмя:УИД", "presentation": ...}; у ссылок с ПДн добавляется "pii": <вид>,
// по которому клиентское ядро заменит представление токеном. Перечисления - {"ref": "Перечисление.Имя.Значение"}.
// Даты - ISO 8601. Пометки значений с условным видом ПДн (наименование, ИНН контрагента) проверяются по значению:
// значения юрлиц открываются.
//
// Параметры:
//  Данные - Произвольный - Структура, Соответствие, Массив или значение.
//
// Возвращаемое значение:
//  Произвольный
Функция ДанныеДляМодели(Данные) Экспорт

	Ссылки = Новый Массив;
	СобратьСсылки(Данные, Ссылки);
	ВидыПДн = ИИО_Маскирование.ВидыПДнСсылок(Ссылки);
	Результат = Преобразовать(Данные, ВидыПДн);
	ИИО_Маскирование.РазрешитьУсловныеПометки(Результат);
	Возврат Результат;

КонецФункции

// Значение с ПДн известного вида, например из поля с ПДн в результате запроса.
// Клиентское ядро заменит его токеном целиком.
//
// Параметры:
//  Значение - Строка, Число, Дата - Значение поля.
//  ВидПДн - Строка - Вид ПДн.
//
// Возвращаемое значение:
//  Структура - {"pii": <вид>, "value": <значение>}.
Функция ЗначениеСПДн(Значение, ВидПДн) Экспорт

	Возврат Новый Структура("pii, value", ВидПДн, Преобразовать(Значение, Новый Соответствие));

КонецФункции

// Строковый идентификатор ссылки для модели.
//
// Параметры:
//  Ссылка - ЛюбаяСсылка
//
// Возвращаемое значение:
//  Строка - ПолноеИмя:УИД, для перечислений - Перечисление.Имя.Значение.
Функция СсылкаВСтроку(Ссылка) Экспорт

	ОбъектМетаданных = Ссылка.Метаданные();
	Если Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		Возврат ОбъектМетаданных.ПолноеИмя() + "." + XMLСтрока(Ссылка);
	КонецЕсли;
	Возврат ОбъектМетаданных.ПолноеИмя() + ":" + XMLСтрока(Ссылка);

КонецФункции

// Ссылка по строковому идентификатору от модели.
//
// Параметры:
//  Идентификатор - Строка - См. СсылкаВСтроку.
//
// Возвращаемое значение:
//  ЛюбаяСсылка, Неопределено - Неопределено, если строка не является идентификатором ссылки.
Функция СсылкаИзСтроки(Идентификатор) Экспорт

	Если ТипЗнч(Идентификатор) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Идентификатор, ":");
	Попытка
		Если Части.Количество() = 2 Тогда
			Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(Части[0]);
			Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Части[1]));
		КонецЕсли;
		ЧастиИмени = СтрРазделить(Идентификатор, ".");
		Если ЧастиИмени.Количество() = 3 И ЧастиИмени[0] = "Перечисление" Тогда
			Возврат Перечисления[ЧастиИмени[1]][ЧастиИмени[2]];
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СобратьСсылки(Данные, Ссылки)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Структура") Или Тип = Тип("ФиксированнаяСтруктура")
		Или Тип = Тип("Соответствие") Или Тип = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого КлючИЗначение Из Данные Цикл
			СобратьСсылки(КлючИЗначение.Значение, Ссылки);
		КонецЦикла;
	ИначеЕсли Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Тогда
		Для Каждого Элемент Из Данные Цикл
			СобратьСсылки(Элемент, Ссылки);
		КонецЦикла;
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(Тип) Тогда
		Ссылки.Добавить(Данные);
	КонецЕсли;

КонецПроцедуры

Функция Преобразовать(Данные, ВидыПДн)

	Тип = ТипЗнч(Данные);
	Если Тип = Тип("Структура") Или Тип = Тип("ФиксированнаяСтруктура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, Преобразовать(КлючИЗначение.Значение, ВидыПДн));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Соответствие") Или Тип = Тип("ФиксированноеСоответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючИЗначение Из Данные Цикл
			Результат.Вставить(КлючИЗначение.Ключ, Преобразовать(КлючИЗначение.Значение, ВидыПДн));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Массив") Или Тип = Тип("ФиксированныйМассив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Данные Цикл
			Результат.Добавить(Преобразовать(Элемент, ВидыПДн));
		КонецЦикла;
		Возврат Результат;
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат ?(Данные = '00010101', Неопределено, XMLСтрока(Данные));
	ИначеЕсли Тип = Тип("Строка") Или Тип = Тип("Число") Или Тип = Тип("Булево") Тогда
		Возврат Данные;
	ИначеЕсли Данные = Неопределено Или Данные = Null Тогда
		Возврат Неопределено;
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(Тип) Тогда
		Возврат СсылкаДляМодели(Данные, ВидыПДн);
	КонецЕсли;
	Возврат Строка(Данные);

КонецФункции

Функция СсылкаДляМодели(Ссылка, ВидыПДн)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура("ref, presentation", СсылкаВСтроку(Ссылка), Строка(Ссылка));
	ВидПДн = ВидыПДн.Получить(Ссылка);
	Если ВидПДн <> Неопределено Тогда
		Результат.Вставить("pii", ВидПДн);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
