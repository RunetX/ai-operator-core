// Состояние и отмена фоновых заданий модели для клиентского ядра.

#Область СлужебныйПрограммныйИнтерфейс

// Состояние фонового задания.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
//  АдресРезультата - Строка
//  ПроверитьСтарт - Булево - Прочитать сообщение задания о старте.
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура:
//   * Начат - Булево - Задание стартовало (прочитано сообщение о старте или задание завершено).
//   * Ответ - Структура, Неопределено - Ответ, если задание завершено.
Функция СостояниеЗадания(Знач ИдентификаторЗадания, Знач АдресРезультата, Знач ПроверитьСтарт, Знач Вид) Экспорт

	Операция = ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания);
	Состояние = Новый Структура("Начат, Ответ", Истина,
		ИИО_ФоновыеЗадания.ОтветЗавершеннойОперации(Операция.Статус, Операция.КраткоеПредставлениеОшибки,
			АдресРезультата, Вид));
	Если Состояние.Ответ = Неопределено Тогда
		Состояние.Начат = ПроверитьСтарт И ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторЗадания) <> Неопределено;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

// Выполняется ли еще фоновое задание: после отмены задание в файловой базе завершается не сразу.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Булево
Функция ЗаданиеВыполняется(Знач ИдентификаторЗадания) Экспорт

	Возврат ДлительныеОперации.ОперацияВыполнена(ИдентификаторЗадания).Статус = "Выполняется";

КонецФункции

// Отменяет фоновое задание.
//
// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
Процедура Отменить(Знач ИдентификаторЗадания) Экспорт

	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);

КонецПроцедуры

#КонецОбласти
