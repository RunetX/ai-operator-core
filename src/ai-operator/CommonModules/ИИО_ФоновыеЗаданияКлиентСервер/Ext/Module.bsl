// Ожидание фоновых заданий модели: одно решение по очереди и таймаутам для канала MCP
// (обработчик ожидания ИИО_ФоновыеЗаданияКлиент) и канала бота (синхронное ИИО_ФоновыеЗадания.Дождаться).

#Область СлужебныйПрограммныйИнтерфейс

// Ожидание задания, запущенного ИИО_ФоновыеЗадания.Запустить.
//
// Параметры:
//  Запуск - см. ИИО_ФоновыеЗадания.Запустить
//  Начало - Число - Момент вызова инструмента, мс.
//  СрокМс - Число, Неопределено - Момент, позже которого не ждать (срок хода агента).
//  ВремяВызоваВТексте - Булево - В тексте таймаута время от вызова, а не таймаут задания: так сообщает канал бота.
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторЗадания - УникальныйИдентификатор
//   * АдресРезультата - Строка
//   * ТаймаутСек - Число
//   * ОжиданиеОчередиСек - Число
//   * Вид - Строка
//   * Начало - Число - Момент вызова, мс.
//   * Старт - Число, Неопределено - Момент, когда стало известно о старте задания, мс.
//   * СрокМс - Число, Неопределено
//   * ВремяВызоваВТексте - Булево
//   * Настройка - см. НастройкаОжидания
Функция НовоеОжидание(Запуск, Начало, СрокМс = Неопределено, ВремяВызоваВТексте = Ложь) Экспорт

	Ожидание = Новый Структура;
	Ожидание.Вставить("ИдентификаторЗадания", Запуск.ИдентификаторЗадания);
	Ожидание.Вставить("АдресРезультата", Запуск.АдресРезультата);
	Ожидание.Вставить("ТаймаутСек", Запуск.ТаймаутСек);
	Ожидание.Вставить("ОжиданиеОчередиСек", Запуск.ОжиданиеОчередиСек);
	Ожидание.Вставить("Вид", Запуск.Вид);
	Ожидание.Вставить("Начало", Начало);
	Ожидание.Вставить("Старт", Неопределено);
	Ожидание.Вставить("СрокМс", СрокМс);
	Ожидание.Вставить("ВремяВызоваВТексте", ВремяВызоваВТексте);
	Ожидание.Вставить("Настройка", НастройкаОжидания(Запуск.Вид));
	Возврат Ожидание;

КонецФункции

// Решение по очередной проверке задания: готово, истек лимит очереди, истек таймаут выполнения или ждать дальше.
// Отмечает в Ожидание.Старт момент, когда стало известно о старте задания.
//
// Параметры:
//  Ожидание - см. НовоеОжидание
//  Состояние - см. ИИО_ФоновыеЗаданияВызовСервера.СостояниеЗадания
//  Сейчас - Число - Текущий момент, мс.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если ждать дальше, иначе:
//   * Ответ - Структура - Ответ задания с wait_ms вместо run_ms или ошибка для модели.
//   * Отменить - Булево - Задание надо отменить: истек лимит очереди или таймаут.
Функция Решение(Ожидание, Состояние, Сейчас) Экспорт

	Если Ожидание.Старт = Неопределено И Состояние.Начат Тогда
		Ожидание.Старт = Сейчас;
	КонецЕсли;

	Если Состояние.Ответ <> Неопределено Тогда
		Возврат Новый Структура("Ответ, Отменить", ОтветСОжиданием(Состояние.Ответ, Сейчас - Ожидание.Начало), Ложь);
	КонецЕсли;

	Если Ожидание.Старт = Неопределено И Сейчас - Ожидание.Начало > Ожидание.ОжиданиеОчередиСек * 1000 Тогда
		Ошибка = ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
			СтрШаблон(
				НСтр("ru = 'Задание не начало выполняться за %1 с и отменено: база занята своими фоновыми заданиями.'"),
				Формат(Ожидание.ОжиданиеОчередиСек, "ЧГ=0")),
			НСтр("ru = 'Повтори через пару минут. Так бывает в первые минуты после запуска 1С и во время регламентных заданий.'"));
		Возврат Новый Структура("Ответ, Отменить", Ошибка, Истина);
	КонецЕсли;

	Если Ожидание.Старт <> Неопределено И Сейчас - Ожидание.Старт > Ожидание.ТаймаутСек * 1000
		Или Ожидание.СрокМс <> Неопределено И Сейчас > Ожидание.СрокМс Тогда
		Если Ожидание.ВремяВызоваВТексте Тогда
			Секунды = Формат(Окр((Сейчас - Ожидание.Начало) / 1000), "ЧН=0; ЧГ=0");
		Иначе
			Секунды = Формат(Ожидание.ТаймаутСек, "ЧГ=0");
		КонецЕсли;
		Настройка = Ожидание.Настройка;
		Ошибка = ИИО_ОтветКлиентСервер.Ошибка(Настройка.КодТаймаута, СтрШаблон(Настройка.ТекстТаймаута, Секунды),
			Настройка.ПодсказкаТаймаута);
		Возврат Новый Структура("Ответ, Отменить", Ошибка, Истина);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Время работы задания заменяется временем ожидания в очереди: все время вызова за вычетом работы задания.
//
// Параметры:
//  Ответ - Структура - Ответ задания или ошибка для модели.
//  ПрошлоМс - Число - Время от вызова инструмента, мс.
//
// Возвращаемое значение:
//  Структура - Ответ с wait_ms вместо run_ms; ошибка - как есть.
Функция ОтветСОжиданием(Ответ, ПрошлоМс) Экспорт

	Если Не ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) И ТипЗнч(Ответ) = Тип("Структура") И Ответ.Свойство("run_ms") Тогда
		Ответ.Вставить("wait_ms", Макс(0, ПрошлоМс - Ответ.run_ms));
		Ответ.Удалить("run_ms");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Что сообщить модели по таймауту и в прогрессе: задается один раз на вид задания.
//
// Параметры:
//  Вид - Строка - query или report.
//
// Возвращаемое значение:
//  Структура:
//   * КодТаймаута - Строка - QUERY_TIMEOUT или REPORT_TIMEOUT.
//   * ТекстТаймаута - Строка - Шаблон текста ошибки, %1 - секунды.
//   * ПодсказкаТаймаута - Строка
//   * ОписаниеВыполнения - Строка - Сообщение прогресса, пока задание выполняется.
Функция НастройкаОжидания(Вид)

	Настройка = Новый Структура("КодТаймаута, ТекстТаймаута, ПодсказкаТаймаута, ОписаниеВыполнения");
	Если Вид = "report" Тогда
		Настройка.КодТаймаута = "REPORT_TIMEOUT";
		Настройка.ТекстТаймаута = НСтр("ru = 'Отчет не сформировался за %1 с и отменен.'");
		Настройка.ПодсказкаТаймаута =
			НСтр("ru = 'Сузь период или добавь отбор (организация, контрагент). База освобождается после отмены до минуты, поэтому сразу не повторяй.'");
		Настройка.ОписаниеВыполнения = НСтр("ru = 'Отчет формируется'");
	Иначе
		Настройка.КодТаймаута = "QUERY_TIMEOUT";
		Настройка.ТекстТаймаута = НСтр("ru = 'Запрос не выполнился за %1 с и отменен.'");
		Настройка.ПодсказкаТаймаута =
			НСтр("ru = 'Сузь отбор (период, организация, контрагент) или воспользуйся отчетом. База освобождается после отмены до минуты, поэтому сразу не повторяй.'");
		Настройка.ОписаниеВыполнения = НСтр("ru = 'Запрос выполняется'");
	КонецЕсли;
	Возврат Настройка;

КонецФункции

#КонецОбласти
