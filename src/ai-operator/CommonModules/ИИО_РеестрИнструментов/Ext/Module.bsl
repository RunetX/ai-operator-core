// Серверный реестр инструментов канала бота: тот же конвейер, что у клиентского реестра MCP
// (ИИО_РеестрИнструментовКлиент), но словарь маскирования - в контексте хода, а формы не открываются:
// вместо них обработчики добавляют кнопки, которые нажимает человек в своем клиенте.

#Область ПрограммныйИнтерфейс

// Контекст хода агента: реестр, словарь маскирования, кнопки для ответа и срок хода.
//
// Параметры:
//  Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь, Неопределено - Словарь диалога;
//    Неопределено - новый пустой словарь.
//  СрокМс - Число, Неопределено - Момент (ТекущаяУниверсальнаяДатаВМиллисекундах), к которому ход
//    должен закончиться: ограничивает ожидание run_query.
//  Источник - Строка - Источник вызовов для журнала.
//
// Возвращаемое значение:
//  Структура:
//   * Источник - Строка
//   * Словарь - см. ИИО_МаскированиеКлиентСервер.НовыйСловарь
//   * Кнопки - Массив из см. НоваяКнопка - Кнопки, добавленные инструментами за ход.
//   * СрокМс - Число, Неопределено
//   * Инструменты - Соответствие из КлючИЗначение - Реестр хода: ключ - имя инструмента,
//     значение - Структура с полями Имя, Описание, Схема, Модуль (модуль пакета или пустая строка для ядра).
Функция НовыйКонтекстВызова(Словарь = Неопределено, СрокМс = Неопределено, Источник = "bot") Экспорт

	Контекст = Новый Структура;
	Контекст.Вставить("Источник", Источник);
	Контекст.Вставить("Словарь", ?(Словарь = Неопределено, ИИО_МаскированиеКлиентСервер.НовыйСловарь(), Словарь));
	Контекст.Вставить("Кнопки", Новый Массив);
	Контекст.Вставить("СрокМс", СрокМс);
	Контекст.Вставить("Инструменты", ИнструментыБота());
	Возврат Контекст;

КонецФункции

// Единая точка вызова инструмента в канале бота: роль, демаскирование аргументов, обработчик,
// маскирование ответа, журнал. Все, что уходит модели, проходит через эту точку.
//
// Параметры:
//  ИмяИнструмента - Строка
//  Аргументы - Структура, Соответствие - Аргументы от модели, с токенами.
//  Контекст - см. НовыйКонтекстВызова
//
// Возвращаемое значение:
//  Структура, Соответствие - Ответ для модели с токенами вместо ПДн.
Функция Вызвать(ИмяИнструмента, Аргументы, Контекст) Экспорт

	Вызов = Новый Структура("Инструмент, Аргументы, Источник, Начало, Контекст", ИмяИнструмента, Аргументы,
		Контекст.Источник, ТекущаяУниверсальнаяДатаВМиллисекундах(), Контекст);

	// Роль проверяется при каждом вызове: сеанс бота короткий, а пользователь - владелец бота.
	Если Не ИИО_ПраваВызовСервера.ДоступенИИОператор() Тогда
		Возврат ПодготовитьОтвет(Вызов, ИИО_ОтветКлиентСервер.Ошибка("ACTION_DENIED",
			НСтр("ru = 'У пользователя 1С нет роли «Пользователь ИИ-оператора».'"),
			НСтр("ru = 'Скажи пользователю попросить администратора 1С добавить роль в профиль его группы доступа.'")));
	КонецЕсли;
	Если Контекст.Инструменты.Получить(ИмяИнструмента) = Неопределено Тогда
		Возврат ПодготовитьОтвет(Вызов, ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
			СтрШаблон(НСтр("ru = 'Инструмент %1 не найден.'"), ИмяИнструмента)));
	КонецЕсли;

	ИмяМодуля = Контекст.Инструменты.Получить(ИмяИнструмента).Модуль;
	Попытка
		// Обработчик получает исходные значения вместо токенов; в журнал уходят аргументы как от модели.
		ИсходныеАргументы = ИИО_МаскированиеКлиентСервер.Демаскировать(Аргументы, Контекст.Словарь);
		Если ЗначениеЗаполнено(ИмяМодуля) Тогда
			Ответ = ОбщегоНазначения.ОбщийМодуль(ИмяМодуля).ВыполнитьИнструмент(ИмяИнструмента, ИсходныеАргументы,
				Вызов);
		Иначе
			Ответ = ИИО_ИнструментыБота.ВыполнитьИнструмент(ИмяИнструмента, ИсходныеАргументы, Вызов);
		КонецЕсли;
	Исключение
		Возврат ПодготовитьОтвет(Вызов, ИИО_ИнструментыКлиентСервер.ВнутренняяОшибка(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Ответ = Неопределено Тогда
		Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", НСтр("ru = 'Инструмент не вернул ответ.'"));
	КонецЕсли;
	Возврат ПодготовитьОтвет(Вызов, Ответ);

КонецФункции

// Кнопка под ответом бота. Ее нажимает человек: канал вызывает инструмент через клиентский реестр
// (ИИО_РеестрИнструментовКлиент.Вызвать) с правами нажавшего, «Выполнить» в предпросмотре - тоже человек.
// Данные кнопки не маскируются: они уходят человеку, а не модели.
//
// Параметры:
//  Вид - Строка - open, show или preview.
//  Заголовок - Строка - Текст кнопки.
//  Инструмент - Строка - Что вызвать в клиенте: open_object, show_in_1c, perform.
//  Аргументы - Структура - Аргументы инструмента: строки ref, числа, булево, массивы строк.
//
// Возвращаемое значение:
//  Структура:
//   * Вид - Строка
//   * Заголовок - Строка
//   * Инструмент - Строка
//   * Аргументы - Структура
Функция НоваяКнопка(Вид, Заголовок, Инструмент, Аргументы) Экспорт

	Возврат Новый Структура("Вид, Заголовок, Инструмент, Аргументы", Вид, Заголовок, Инструмент, Аргументы);

КонецФункции

// Разделы текстового макета ядра и одноименных макетов пакетов (см. ИИО_Пакеты) - описания инструментов
// и инструкции агента. Раздел начинается строкой «## <имя>»; раздел instructions пакета
// дописывается к инструкциям ядра, остальные заменяют одноименные.
//
// Параметры:
//  ИмяМакета - Строка - Общий макет ядра, например ИИО_ОписанияИнструментов.
//  Окончание - Строка - Окончание имени макетов пакетов, например _ОписанияИнструментов.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Имя раздела.
//   * Значение - Строка - Текст раздела.
Функция РазделыОписаний(ИмяМакета, Окончание) Экспорт

	Разделы = Новый Соответствие;
	РазобратьОписания(ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст(), Разделы);
	Для Каждого ИмяМакетаПакета Из ИИО_Пакеты.Макеты(Окончание) Цикл
		РазобратьОписания(ПолучитьОбщийМакет(ИмяМакетаПакета).ПолучитьТекст(), Разделы);
	КонецЦикла;
	Возврат Разделы;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реестр канала бота: встроенные инструменты с признаком ВБоте, инструменты пакетов из модулей
// <Префикс>_ИнструментыБота (см. ИИО_Пакеты) и описания из макетов. Сбой пакета не ломает ядро:
// инструменты пакета пропускаются, причина пишется в журнал регистрации.
//
// Возвращаемое значение:
//  Соответствие - см. НовыйКонтекстВызова
Функция ИнструментыБота()

	Описания = ИИО_РеестрИнструментовВызовСервера.ОписанияИнструментов();
	Реестр = Новый Соответствие;
	Для Каждого Определение Из ИИО_ИнструментыКлиентСервер.Определения(ИИО_Действия.ДействияПакетов()) Цикл
		Если Не Определение.ВБоте Тогда
			Продолжить;
		КонецЕсли;
		Описание = Описания.Получить(Определение.Имя);
		Если Описание = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Нет описания инструмента %1 в макете ИИО_ОписанияИнструментов.'"), Определение.Имя);
		КонецЕсли;
		Реестр.Вставить(Определение.Имя, НовыйИнструментРеестра(Определение, Описание, ""));
	КонецЦикла;

	Для Каждого ИмяМодуля Из ИИО_Пакеты.СерверныеМодулиСОкончанием("_ИнструментыБота") Цикл
		ДобавитьИнструментыПакета(Реестр, ИмяМодуля, Описания);
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Добавляет в реестр инструменты пакета: все вместе или ни одного, как в клиентском реестре
// (см. ИИО_РеестрИнструментовКлиент.Инструменты).
//
// Параметры:
//  Реестр - см. ИнструментыБота
//  ИмяМодуля - Строка - Серверный модуль пакета <Префикс>_ИнструментыБота.
//  Описания - см. ИИО_РеестрИнструментовВызовСервера.ОписанияИнструментов
Процедура ДобавитьИнструментыПакета(Реестр, ИмяМодуля, Описания)

	Определения = Новый Массив;
	Попытка
		ОбщегоНазначения.ОбщийМодуль(ИмяМодуля).ПриРегистрацииИнструментов(Определения);
	Исключение
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Для Каждого Определение Из Определения Цикл
		Ошибка = "";
		Если Реестр.Получить(Определение.Имя) <> Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Инструмент %1 уже зарегистрирован ядром или другим пакетом.'"),
				Определение.Имя);
		ИначеЕсли Описания.Получить(Определение.Имя) = Неопределено Тогда
			Ошибка = СтрШаблон(НСтр("ru = 'Нет описания инструмента %1 в макете пакета.'"), Определение.Имя);
		КонецЕсли;
		Если Ошибка <> "" Тогда
			ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета(ИмяМодуля, Ошибка);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Определение Из Определения Цикл
		Реестр.Вставить(Определение.Имя, НовыйИнструментРеестра(Определение, Описания.Получить(Определение.Имя),
			ИмяМодуля));
	КонецЦикла;

КонецПроцедуры

Функция НовыйИнструментРеестра(Определение, Описание, ИмяМодуля)

	Возврат Новый Структура("Имя, Описание, Схема, Модуль", Определение.Имя, Описание, Определение.Схема, ИмяМодуля);

КонецФункции

Процедура РазобратьОписания(Текст, Разделы)

	ИмяРаздела = "";
	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Строка = СокрП(СтрЗаменить(Строка, Символы.ВК, ""));
		Если СтрНачинаетсяС(Строка, "## ") Тогда
			ДобавитьРаздел(Разделы, ИмяРаздела, Строки);
			ИмяРаздела = СокрЛП(Сред(Строка, 4));
			Строки = Новый Массив;
		ИначеЕсли ЗначениеЗаполнено(ИмяРаздела) Тогда
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	ДобавитьРаздел(Разделы, ИмяРаздела, Строки);

КонецПроцедуры

Процедура ДобавитьРаздел(Разделы, ИмяРаздела, Строки)

	Если Не ЗначениеЗаполнено(ИмяРаздела) Тогда
		Возврат;
	КонецЕсли;
	Текст = СокрЛП(СтрСоединить(Строки, Символы.ПС));
	Имеющийся = Разделы.Получить(ИмяРаздела);
	Если ИмяРаздела = "instructions" И ЗначениеЗаполнено(Имеющийся) Тогда
		Текст = Имеющийся + Символы.ПС + Символы.ПС + Текст;
	КонецЕсли;
	Разделы.Вставить(ИмяРаздела, Текст);

КонецПроцедуры

Функция ПодготовитьОтвет(Вызов, Ответ)

	Замаскированный = ИИО_МаскированиеКлиентСервер.Замаскировать(Ответ, Вызов.Контекст.Словарь);
	ИИО_ЖурналВызовСервера.ЗаписатьВызовИнструмента(ИИО_ИнструментыКлиентСервер.СведенияДляЖурнала(
		Вызов.Инструмент, Вызов.Источник, Вызов.Начало, Вызов.Аргументы, Замаскированный));
	Возврат Замаскированный;

КонецФункции

#КонецОбласти
