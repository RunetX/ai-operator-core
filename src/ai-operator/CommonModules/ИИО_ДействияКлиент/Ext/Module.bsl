// Инструменты perform и undo на клиенте: план на сервере, предпросмотр в 1С, отложенный ответ модели.
// Модель получает итог только после решения пользователя в форме предпросмотра или по истечении ее срока.
// Одновременно ждет подтверждения не больше одного пакета.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента perform.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы (action, refs, dry_run) и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - План для dry_run или ошибка.
//  Неопределено - Ответ придет после решения пользователя в предпросмотре.
Функция ВыполнитьДействие(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	ПробныйЗапуск = ИИО_ОтветКлиентСервер.Аргумент(ПараметрыОбработчика.Аргументы, "dry_run", Ложь) = Истина;
	Если Не ПробныйЗапуск Тогда
		Ошибка = ОшибкаЗанятости();
		Если Ошибка <> Неопределено Тогда
			Возврат Ошибка;
		КонецЕсли;
	КонецЕсли;
	Подготовленный = ИИО_ДействияВызовСервера.ПодготовитьДействие(ПараметрыОбработчика.Аргументы,
		ПараметрыОбработчика.Вызов.Источник);
	Возврат ОткрытьПредпросмотр(ПараметрыОбработчика.Вызов, Подготовленный);

КонецФункции

// Обработчик инструмента undo.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы (batch_id) и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Ошибка.
//  Неопределено - Ответ придет после решения пользователя в предпросмотре.
Функция Откатить(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Ошибка = ОшибкаЗанятости();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;
	Подготовленный = ИИО_ДействияВызовСервера.ПодготовитьОткат(ПараметрыОбработчика.Аргументы,
		ПараметрыОбработчика.Вызов.Источник);
	Возврат ОткрытьПредпросмотр(ПараметрыОбработчика.Вызов, Подготовленный);

КонецФункции

// Откат пакета из формы «Журнал операций»: тот же путь, что у инструмента undo, с источником journal.
//
// Параметры:
//  Пакет - Строка - batch_id.
//  ОповещениеОЗавершении - ОписаниеОповещения - Получает ответ undo: ошибку сразу или итог после предпросмотра.
Процедура ОткатитьПакет(Пакет, ОповещениеОЗавершении) Экспорт

	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("journal");
	ПараметрыВызова.ОповещениеОЗавершении = ОповещениеОЗавершении;
	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать("undo", Новый Структура("batch_id", Пакет), ПараметрыВызова);
	Если Ответ <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Ответ);
	КонецЕсли;

КонецПроцедуры

// Передает модели итог предпросмотра. Вызывается формой предпросмотра после выполнения или отмены.
//
// Параметры:
//  Пакет - Строка - batch_id.
//  Ответ - Структура - Ответ модели.
Процедура ЗавершитьПредпросмотр(Пакет, Ответ) Экспорт

	Активный = АктивныйПредпросмотр(Пакет);
	Если Активный = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыПриложения.Удалить(ИмяАктивногоПредпросмотра());
	ИИО_РеестрИнструментовКлиент.Завершить(Активный.Вызов, Ответ);

КонецПроцедуры

// Сообщает клиенту MCP о ходе ожидания или выполнения: продлевает таймаут клиентов с progressToken.
//
// Параметры:
//  Пакет - Строка - batch_id.
//  Прогресс - Число
//  Всего - Число
//  Сообщение - Строка
Процедура СообщитьПрогресс(Пакет, Прогресс, Всего, Сообщение) Экспорт

	Активный = АктивныйПредпросмотр(Пакет);
	Если Активный <> Неопределено Тогда
		ИИО_РеестрИнструментовКлиент.СообщитьПрогресс(Активный.Вызов, Прогресс, Всего, Сообщение);
	КонецЕсли;

КонецПроцедуры

// Обработчик закрытия формы предпросмотра. Форма сама сообщает итог; сюда вызов доходит незавершенным,
// только если форму закрыли, минуя ее обработчики.
//
// Параметры:
//  Результат - Произвольный
//  Пакет - Строка - batch_id.
Процедура ПослеЗакрытияПредпросмотра(Результат, Пакет) Экспорт

	Ответ = Новый Структура("batch_id, cancelled, reason, done, failed",
		Пакет, Истина, "closed", Новый Массив, Новый Массив);
	Ответ.Вставить("hint", НСтр("ru = 'Форма предпросмотра закрыта без подтверждения, данные не изменены.'"));
	ЗавершитьПредпросмотр(Пакет, Ответ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОткрытьПредпросмотр(Вызов, Подготовленный)

	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Подготовленный) Тогда
		Возврат Подготовленный;
	КонецЕсли;
	ЗакрытьПрошлыеПредпросмотры();
	ПараметрыФормы = Новый Структура("АдресПлана", Подготовленный.АдресПлана);

	Если Подготовленный.ПробныйЗапуск Тогда
		// Пробный запуск ничего не ждет: форма только показывает план, модель получает его сразу.
		Форма = ОткрытьФорму("ОбщаяФорма.ИИО_Предпросмотр", ПараметрыФормы, , Подготовленный.Пакет);
		ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
		Ответ = Подготовленный.Ответ;
		Ответ.Вставить("shown", Форма <> Неопределено);
		Возврат Ответ;
	КонецЕсли;

	Активный = Новый Структура("Вызов, Пакет", Вызов, Подготовленный.Пакет);
	ПараметрыПриложения.Вставить(ИмяАктивногоПредпросмотра(), Активный);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияПредпросмотра", ИИО_ДействияКлиент, Подготовленный.Пакет);
	Попытка
		Форма = ОткрытьФорму("ОбщаяФорма.ИИО_Предпросмотр", ПараметрыФормы, , Подготовленный.Пакет, , , Оповещение);
	Исключение
		ПараметрыПриложения.Удалить(ИмяАктивногоПредпросмотра());
		ВызватьИсключение;
	КонецПопытки;
	Если Форма = Неопределено Тогда
		ПараметрыПриложения.Удалить(ИмяАктивногоПредпросмотра());
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INTERNAL", НСтр("ru = 'Форма предпросмотра не открылась.'"));
	КонецЕсли;
	ИИО_ФормыКлиент.ЗапомнитьФорму(Форма);
	Возврат Неопределено;

КонецФункции

// Окна с итогом прошлого пакета или пробным запуском заменяются новым предпросмотром, чтобы не копились.
// Окно, которое ждет решения пользователя или выполняет пакет, не закрывается. Признак - реквизит формы Режим:
// «готово» - показан итог, «просмотр» - пробный запуск.
Процедура ЗакрытьПрошлыеПредпросмотры()

	Для Каждого Форма Из ИИО_ФормыКлиент.ОткрытыеФормыПоИмени("ОбщаяФорма.ИИО_Предпросмотр") Цикл
		Если Форма.Режим = "готово" Или Форма.Режим = "просмотр" Тогда
			Форма.Закрыть();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОшибкаЗанятости()

	Если ПараметрыПриложения.Получить(ИмяАктивногоПредпросмотра()) <> Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_READY",
			НСтр("ru = 'Пользователь еще не ответил на предыдущий предпросмотр в 1С.'"),
			НСтр("ru = 'Дождись его ответа: действия подтверждаются по одному.'"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция АктивныйПредпросмотр(Пакет)

	Активный = ПараметрыПриложения.Получить(ИмяАктивногоПредпросмотра());
	Если Активный = Неопределено Или Активный.Пакет <> Пакет Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Активный;

КонецФункции

Функция ИмяАктивногоПредпросмотра()

	Возврат "ИИО.АктивныйПредпросмотр";

КонецФункции

#КонецОбласти
