// Запуск и остановка MCP-сервера ИИ-оператора из раздела «ИИ-оператор».

#Область СлужебныйПрограммныйИнтерфейс

// Запускает MCP-сервер: только localhost, инструкции для модели, самопроверка авторизации.
Асинх Процедура Запустить() Экспорт

	Если Не ИИО_ПраваВызовСервера.ДоступенИИОператор() Тогда
		ИИО_ЖурналВызовСервера.ЗаписатьЗапускСервера(Новый Структура("status", "NO_ROLE"));
		ПоказатьПредупреждение(, ТекстНетРоли());
		Возврат;
	КонецЕсли;

	Параметры = ИИО_НастройкиВызовСервера.ПараметрыЗапуска();
	Сведения = Новый Структура("status, port, version", "ok", Параметры.Порт, Параметры.Версия);
	СведенияОСервере = Новый Структура("name, version, title, description, instructions",
		Параметры.Имя, Параметры.Версия, Параметры.Заголовок, Параметры.Описание, Параметры.Инструкции);
	Попытка
		Результат = Ждать ИИО_ТранспортMCPКлиент.Запустить(Параметры.Порт, Параметры.ТаймаутСек, СведенияОСервере,
			ИИО_ПровайдерMCPКлиент.ОписанияИнструментов());
	Исключение
		// Пользователь видит краткий текст, администратор в журнале - подробное представление.
		СведенияОбОшибке = ИнформацияОбОшибке();
		Результат = Новый Структура("ok, code, error", Ложь, "START_FAILED",
			ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(СведенияОбОшибке));
		Сведения.Вставить("details", ОбработкаОшибок.ПодробноеПредставлениеОшибки(СведенияОбОшибке));
	КонецПопытки;
	Если Не Результат.ok Тогда
		Сведения.status = Результат.code;
		Сведения.Вставить("message", Результат.error);
		ИИО_ЖурналВызовСервера.ЗаписатьЗапускСервера(Сведения);
		ПоказатьПредупреждение(, ТекстОшибкиЗапуска(Результат, Параметры.Порт));
		Возврат;
	КонецЕсли;

	// Сервер без авторизации останавливаем сразу: компонента не стартует без токена, но проверка
	// по факту не зависит от того, какая сборка компоненты подключилась.
	КодОтвета = КодОтветаБезТокена(Параметры.Порт);
	Если КодОтвета <> 401 Тогда
		Ждать ИИО_ТранспортMCPКлиент.Остановить();
		Сведения.status = "NO_AUTH";
		Сведения.Вставить("message", СтрШаблон("Запрос без токена получил ответ %1 вместо 401",
			Формат(КодОтвета, "ЧН=0; ЧГ=0")));
		ИИО_ЖурналВызовСервера.ЗаписатьЗапускСервера(Сведения);
		ПоказатьПредупреждение(, ТекстНетАвторизации(КодОтвета));
		Возврат;
	КонецЕсли;

	ИИО_ЖурналВызовСервера.ЗаписатьЗапускСервера(Сведения);
	// Адрес не настраивается: сервер слушает только 127.0.0.1, так его запускает компонента.
	ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор запущен'"), ,
		СтрШаблон(НСтр("ru = 'MCP-сервер: http://127.0.0.1:%1/mcp'"), Формат(Параметры.Порт, "ЧГ=0")));
	// Без журнала регистрации действия недоступны: чтение работает, а perform и undo отказывают.
	Если Не ИИО_ЖурналВызовСервера.ЖурналДействийВключен() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Действия ИИ-оператора недоступны'"), ,
			НСтр("ru = 'Журнал регистрации не записывает события уровня «Информация». Попросите администратора включить его.'"));
	КонецЕсли;

КонецПроцедуры

// Останавливает MCP-сервер.
Асинх Процедура Остановить() Экспорт

	Ждать ИИО_ТранспортMCPКлиент.Остановить();
	ИИО_ЖурналВызовСервера.ЗаписатьОстановкуСервера();
	ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор остановлен'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает HTTP-код ответа сервера на запрос без токена.
// Отказ 401 компонента выдает сама, не обращаясь к 1С, поэтому синхронный запрос из клиента не блокируется.
//
// Параметры:
//  Порт - Число - порт MCP-сервера.
//
// Возвращаемое значение:
//  Число - код состояния HTTP; 0 - сервер не ответил.
Функция КодОтветаБезТокена(Порт)

	Попытка
		// Сервер слушает только 127.0.0.1: самопроверка обращается туда же.
		Соединение = Новый HTTPСоединение("127.0.0.1", Порт, , , , 5);
		Запрос = Новый HTTPЗапрос("/mcp");
		Запрос.Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки.Вставить("Accept", "application/json, text/event-stream");
		Запрос.УстановитьТелоИзСтроки("{""jsonrpc"":""2.0"",""id"":1,""method"":""ping""}");
		Возврат Соединение.ОтправитьДляОбработки(Запрос).КодСостояния;
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ТекстНетРоли()

	Возврат НСтр("ru = 'У пользователя нет роли «Пользователь ИИ-оператора». Попросите администратора добавить ее в профиль группы доступа.'");

КонецФункции

// Текст предупреждения о неудачном запуске: что случилось и что сделать.
//
// Параметры:
//  Результат - см. ИИО_ТранспортMCPКлиент.Запустить
//  Порт - Число
//
// Возвращаемое значение:
//  Строка
Функция ТекстОшибкиЗапуска(Результат, Порт)

	Если СтрНачинаетсяС(Результат.code, "NO_TOKEN") Или СтрНачинаетсяС(Результат.code, "TOKEN_") Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'ИИ-оператор не запущен: нет токена доступа к MCP-серверу (%1).
			|Создайте токен скриптом tools/new-mcp-token.ps1: он запишет файл %2.
			|Тот же токен укажите в MCP-клиенте.'"),
			Результат.error, ФайлТокена());
	ИначеЕсли Результат.code = "PORT_BUSY" Тогда
		Возврат СтрШаблон(
			НСтр("ru = 'ИИ-оператор не запущен: порт %1 занят.
			|Возможно, ИИ-оператор уже запущен в другом окне 1С или работает client_mcp прежней установки.
			|Остановите его или задайте другой порт в настройках ИИ-оператора.'"),
			Формат(Порт, "ЧГ=0"));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Не удалось запустить ИИ-оператор: %1'"), Результат.error);

КонецФункции

Функция ТекстНетАвторизации(КодОтвета)

	Возврат СтрШаблон(
		НСтр("ru = 'ИИ-оператор остановлен: MCP-сервер принимал запросы без токена авторизации (ответ %1 вместо 401).
		|Проверьте, что файл токена %2 существует (его создает tools/new-mcp-token.ps1),
		|и обновите расширение ИИ-оператора.'"),
		Формат(КодОтвета, "ЧН=0; ЧГ=0"), ФайлТокена());

КонецФункции

// Файл токена по умолчанию, как его читает компонента транспорта: подсказка пользователю, а не путь для чтения.
//
// Возвращаемое значение:
//  Строка
Функция ФайлТокена()

	Возврат "%LOCALAPPDATA%\WebTransport\mcp-token";

КонецФункции

#КонецОбласти
