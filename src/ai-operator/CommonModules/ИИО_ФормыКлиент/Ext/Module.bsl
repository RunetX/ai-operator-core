// Формы, которые ИИ-оператор открыл пользователю в этом сеансе: списки, объекты, отчеты, предпросмотр.
// Инструмент close_forms закрывает их по просьбе пользователя при любом режиме отображения форм
// (отдельные окна, закладки, одно окно), не трогая формы, измененные пользователем.
// Закрытия чужих форм (например, КЭДО), после которого вызов получит ответ, ИИ-оператор ждет не дольше срока.

#Область СлужебныйПрограммныйИнтерфейс

// Запоминает форму, открытую ИИ-оператором.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения, Неопределено - Результат ОткрытьФорму.
Процедура ЗапомнитьФорму(Форма) Экспорт

	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Формы = ОткрытыеФормы();
	Если Формы.Найти(Форма) = Неопределено Тогда
		Формы.Добавить(Форма);
	КонецЕсли;

КонецПроцедуры

// Открытые сейчас формы ИИ-оператора с указанным именем.
//
// Параметры:
//  ИмяФормы - Строка - Например, "ОбщаяФорма.ИИО_Предпросмотр".
//
// Возвращаемое значение:
//  Массив из ФормаКлиентскогоПриложения
Функция ОткрытыеФормыПоИмени(ИмяФормы) Экспорт

	Результат = Новый Массив;
	Для Каждого Форма Из ОткрытыеФормы() Цикл
		Если Форма.Открыта() И Форма.ИмяФормы = ИмяФормы Тогда
			Результат.Добавить(Форма);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Обработчик инструмента close_forms.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - closed, left_open и, если есть, left_open_forms - имена форм, оставленных открытыми.
Функция ЗакрытьФормы(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Закрыто = 0;
	Оставлены = Новый Массив;
	Формы = ОткрытыеФормы();
	Для Каждого Форма Из Формы Цикл
		Если Не Форма.Открыта() Тогда
			Продолжить;
		КонецЕсли;
		// Измененную форму закрытие остановило бы вопросом «Сохранить изменения?»: решает пользователь.
		Если Форма.Модифицированность Тогда
			Оставлены.Добавить(Форма.ИмяФормы);
			Продолжить;
		КонецЕсли;
		Форма.Закрыть();
		Если Форма.Открыта() Тогда
			Оставлены.Добавить(Форма.ИмяФормы);
		Иначе
			Закрыто = Закрыто + 1;
		КонецЕсли;
	КонецЦикла;
	Формы.Очистить();

	Ответ = Новый Структура("closed, left_open", Закрыто, Оставлены.Количество());
	Если Оставлены.Количество() > 0 Тогда
		Ответ.Вставить("left_open_forms", Оставлены);
		Ответ.Вставить("hint",
			НСтр("ru = 'Эти формы изменены пользователем или идет выполнение действия: закрыть их может только он сам.'"));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Ограничивает ожидание формы, после закрытия которой отложенный вызов получит ответ.
// Если пользователь не закрыл форму к сроку, вызов завершается ответом ИтогПоСроку, а форма остается открытой.
// Без срока MCP-сервер оборвал бы вызов сам, а ответ после закрытия формы уронил бы компоненту client_mcp.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Открытая форма.
//  Вызов - см. ИИО_РеестрИнструментовКлиент.НовыйВызов
//  ИтогПоСроку - ОписаниеОповещения - Функция(Форма, ДополнительныеПараметры), возвращающая ответ модели.
//  СрокСек - Число, Неопределено - По умолчанию см. ИИО_НастройкиВызовСервера.СрокОжиданияФормыСек.
Процедура ОжидатьЗакрытия(Форма, Вызов, ИтогПоСроку, СрокСек = Неопределено) Экспорт

	Ожидание = Новый Структура("Форма, Вызов, ИтогПоСроку, Начало, СрокСек", Форма, Вызов, ИтогПоСроку,
		ТекущаяУниверсальнаяДатаВМиллисекундах(),
		?(СрокСек = Неопределено, ИИО_НастройкиВызовСервера.СрокОжиданияФормыСек(), СрокСек));
	ОжидаемыеФормы().Добавить(Ожидание);
	// Обработчик ожидания из общего модуля подключается с интервалом не меньше 1 с.
	ПодключитьОбработчикОжидания("ИИО_ПроверитьОжидаемыеФормы", 5, Ложь);

КонецПроцедуры

// Завершает по сроку вызовы, чьи формы еще открыты, остальным сообщает прогресс.
// Вызывается обработчиком ожидания из ИИО_Глобальный.
Процедура ПроверитьОжидание() Экспорт

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Остались = Новый Массив;
	Истекли = Новый Массив;
	Для Каждого Ожидание Из ОжидаемыеФормы() Цикл
		ПрошлоСек = Цел((Сейчас - Ожидание.Начало) / 1000);
		Если Ожидание.Вызов.Завершен Или Не Ожидание.Форма.Открыта() Тогда
			Продолжить;
		ИначеЕсли ПрошлоСек >= Ожидание.СрокСек Тогда
			Истекли.Добавить(Ожидание);
		Иначе
			Остались.Добавить(Ожидание);
			ИИО_РеестрИнструментовКлиент.СообщитьПрогресс(Ожидание.Вызов, ПрошлоСек, Ожидание.СрокСек,
				НСтр("ru = 'Ожидание действия пользователя в форме 1С'"));
		КонецЕсли;
	КонецЦикла;
	ПараметрыПриложения.Вставить(ИмяОжидаемыхФорм(), Остались);
	Если Остались.Количество() = 0 Тогда
		ОтключитьОбработчикОжидания("ИИО_ПроверитьОжидаемыеФормы");
	КонецЕсли;

	Для Каждого Ожидание Из Истекли Цикл
		Попытка
			Ответ = ВыполнитьОбработкуОповещения(Ожидание.ИтогПоСроку, Ожидание.Форма);
		Исключение
			Ответ = ИИО_ОтветКлиентСервер.Ошибка("INTERNAL",
				ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке()));
		КонецПопытки;
		ИИО_РеестрИнструментовКлиент.Завершить(Ожидание.Вызов, Ответ);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОжидаемыеФормы()

	Формы = ПараметрыПриложения.Получить(ИмяОжидаемыхФорм());
	Если Формы = Неопределено Тогда
		Формы = Новый Массив;
		ПараметрыПриложения.Вставить(ИмяОжидаемыхФорм(), Формы);
	КонецЕсли;
	Возврат Формы;

КонецФункции

Функция ИмяОжидаемыхФорм()

	Возврат "ИИО.ОжидаемыеФормы";

КонецФункции

Функция ОткрытыеФормы()

	Формы = ПараметрыПриложения.Получить("ИИО.ОткрытыеФормы");
	Если Формы = Неопределено Тогда
		Формы = Новый Массив;
		ПараметрыПриложения.Вставить("ИИО.ОткрытыеФормы", Формы);
	КонецЕсли;
	Возврат Формы;

КонецФункции

#КонецОбласти
