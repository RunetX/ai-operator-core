// Минимальный механизм пакетов: пакет - расширение с подсистемой <Префикс>_ИИО_Пакеты,
// выключенной из командного интерфейса (тот же прием, что у провайдеров client_mcp). Состав подсистемы:
// - клиентские общие модули с процедурой ПриРегистрацииИнструментов(Инструменты);
// - серверные общие модули с процедурой ПриРегистрацииРазрешений(Разрешения): действия пакета для регистра
//   ИИО_РазрешенияДействий;
// - текстовый макет <Префикс>_ОписанияИнструментов в формате ИИО_ОписанияИнструментов;
// - макет <Префикс>_ПреднастройкаМаскирования в формате ИИО_ПреднастройкаМаскирования.

#Область СлужебныйПрограммныйИнтерфейс

// Клиентские общие модули пакетов, которые регистрируют инструменты.
//
// Возвращаемое значение:
//  Массив из Строка - Имена модулей.
Функция КлиентскиеМодули() Экспорт

	Результат = Новый Массив;
	Для Каждого Подсистема Из Подсистемы() Цикл
		Для Каждого Объект Из Подсистема.Состав Цикл
			Если Метаданные.ОбщиеМодули.Содержит(Объект) И Объект.КлиентУправляемоеПриложение Тогда
				Результат.Добавить(Объект.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Серверные общие модули пакетов, которые регистрируют разрешаемые действия.
//
// Возвращаемое значение:
//  Массив из Строка - Имена модулей.
Функция СерверныеМодули() Экспорт

	Результат = Новый Массив;
	Для Каждого Подсистема Из Подсистемы() Цикл
		Для Каждого Объект Из Подсистема.Состав Цикл
			Если Метаданные.ОбщиеМодули.Содержит(Объект) И Объект.Сервер И Не Объект.ВызовСервера Тогда
				Результат.Добавить(Объект.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общие макеты пакетов с именем на заданное окончание.
//
// Параметры:
//  Окончание - Строка - Например, _ОписанияИнструментов.
//
// Возвращаемое значение:
//  Массив из Строка - Имена макетов.
Функция Макеты(Окончание) Экспорт

	Результат = Новый Массив;
	Для Каждого Подсистема Из Подсистемы() Цикл
		Для Каждого Объект Из Подсистема.Состав Цикл
			Если Метаданные.ОбщиеМакеты.Содержит(Объект) И СтрЗаканчиваетсяНа(Объект.Имя, Окончание) Тогда
				Результат.Добавить(Объект.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Подсистемы()

	Результат = Новый Массив;
	Для Каждого Подсистема Из Метаданные.Подсистемы Цикл
		Если Не Подсистема.ВключатьВКомандныйИнтерфейс И СтрЗаканчиваетсяНа(Подсистема.Имя, "_ИИО_Пакеты") Тогда
			Результат.Добавить(Подсистема);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
