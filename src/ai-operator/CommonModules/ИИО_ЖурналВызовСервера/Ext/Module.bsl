#Область СлужебныйПрограммныйИнтерфейс

// Записывает вызов инструмента в журнал регистрации (событие ИИОператор.ВызовИнструмента).
//
// Параметры:
//  Сведения - Структура - tool, source, status, duration_ms, arguments и, для внутренних ошибок, details.
Процедура ЗаписатьВызовИнструмента(Знач Сведения) Экспорт

	Если Сведения.status = "ok" Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Сведения.status = "INTERNAL" Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	ЗаписатьСобытие("ВызовИнструмента", Уровень, Сведения);

КонецПроцедуры

// Записывает попытку запуска MCP-сервера (событие ИИОператор.ЗапускСервера).
//
// Параметры:
//  Сведения - Структура - status (ok, NO_ROLE, START_FAILED, NO_AUTH), port, version и, при отказе, message.
Процедура ЗаписатьЗапускСервера(Знач Сведения) Экспорт

	Если Сведения.status = "ok" Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Сведения.status = "NO_ROLE" Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;

	ЗаписатьСобытие("ЗапускСервера", Уровень, Сведения);

КонецПроцедуры

// Записывает, почему инструменты пакета не зарегистрированы (событие ИИОператор.ОшибкаПакета).
//
// Параметры:
//  ИмяМодуля - Строка - Клиентский модуль пакета.
//  Текст - Строка - Причина.
Процедура ЗаписатьОшибкуПакета(Знач ИмяМодуля, Знач Текст) Экспорт

	ЗаписатьСобытие("ОшибкаПакета", УровеньЖурналаРегистрации.Ошибка,
		Новый Структура("module, message", ИмяМодуля, Текст));

КонецПроцедуры

// Записывает остановку MCP-сервера командой (событие ИИОператор.ОстановкаСервера).
Процедура ЗаписатьОстановкуСервера() Экспорт

	ЗаписатьСобытие("ОстановкаСервера", УровеньЖурналаРегистрации.Информация, Новый Структура("status", "ok"));

КонецПроцедуры

// Пишет ли журнал регистрации события уровня «Информация»: без этого действия ИИ-оператора недоступны.
//
// Возвращаемое значение:
//  Булево
Функция ЖурналДействийВключен() Экспорт

	Возврат ИИО_Журнал.ЖурналДействийВключен();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьСобытие(Событие, Уровень, Сведения)

	ИИО_Журнал.ЗаписатьСобытие(Событие, Уровень, Сведения);

КонецПроцедуры

#КонецОбласти
