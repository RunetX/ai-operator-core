#Область СлужебныйПрограммныйИнтерфейс

// Записывает вызов инструмента в журнал регистрации (событие ИИОператор.ВызовИнструмента), а вызов
// от MCP-клиента - еще и в журнал обмена с моделью. Сбой журнала обмена не мешает ответу модели:
// он пишется в журнал регистрации.
//
// Параметры:
//  Сведения - Структура - tool, source, status, duration_ms, arguments и, для внутренних ошибок, details.
//  Обмен - Структура, Неопределено - Запись журнала обмена канала MCP:
//   * Разговор - Строка - Ключ клиентского сеанса.
//   * Скрыто - Строка - См. ИИО_МаскированиеКлиентСервер.СводкаСкрытого.
//   * Переписка - Строка - JSON: вызов модели и ответ инструмента с токенами вместо ПДн.
Процедура ЗаписатьВызовИнструмента(Знач Сведения, Знач Обмен = Неопределено) Экспорт

	Если Сведения.status = "ok" Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Сведения.status = "INTERNAL" Тогда
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	КонецЕсли;

	ЗаписатьСобытие("ВызовИнструмента", Уровень, Сведения);
	Если Обмен = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// Метод вызывается с клиента, а журнал пишется в привилегированном режиме: право проверяется здесь (485).
	Если Не ИИО_ПраваВызовСервера.ДоступенИИОператор() Тогда
		ВызватьИсключение НСтр("ru = 'Журнал обмена с моделью пишет только пользователь ИИ-оператора.'");
	КонецЕсли;

	Запись = ИИО_Журнал.НовыеСведенияОбмена();
	Запись.Канал = "mcp";
	Запись.Разговор = Обмен.Разговор;
	Запись.Инструмент = Сведения.tool;
	Запись.Статус = Сведения.status;
	Запись.ДлительностьМс = Сведения.duration_ms;
	Запись.Скрыто = Обмен.Скрыто;
	Запись.Переписка = ИИО_ОтветКлиентСервер.Обрезать(Обмен.Переписка, МаксимумПереписки());
	Попытка
		ИИО_Журнал.ЗаписатьОбменСМоделью(Запись);
	Исключение
		ЗаписатьСобытие("ЖурналОбмена.Запись", УровеньЖурналаРегистрации.Ошибка,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Записывает попытку запуска MCP-сервера (событие ИИОператор.ЗапускСервера).
//
// Параметры:
//  Сведения - Структура - status (ok, NO_ROLE, START_FAILED, NO_AUTH), port, version и, при отказе, message.
Процедура ЗаписатьЗапускСервера(Знач Сведения) Экспорт

	Если Сведения.status = "ok" Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	ИначеЕсли Сведения.status = "NO_ROLE" Тогда
		Уровень = УровеньЖурналаРегистрации.Предупреждение;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;

	ЗаписатьСобытие("ЗапускСервера", Уровень, Сведения);
	// В базе без канала бота журнал обмена чистить некому, кроме запуска MCP-сервера.
	Если Сведения.status = "ok" Тогда
		Попытка
			ИИО_Журнал.УдалитьУстаревшийОбмен();
		Исключение
			ЗаписатьСобытие("ЖурналОбмена.Очистка", УровеньЖурналаРегистрации.Ошибка,
				Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Записывает, почему инструменты пакета не зарегистрированы (событие ИИОператор.ОшибкаПакета).
//
// Параметры:
//  ИмяМодуля - Строка - Клиентский модуль пакета.
//  Текст - Строка - Причина.
Процедура ЗаписатьОшибкуПакета(Знач ИмяМодуля, Знач Текст) Экспорт

	ЗаписатьСобытие("ОшибкаПакета", УровеньЖурналаРегистрации.Ошибка,
		Новый Структура("module, message", ИмяМодуля, Текст));

КонецПроцедуры

// Записывает сбой MCP-транспорта на клиенте (событие ИИОператор.ТранспортMCP): компонента прислала
// неразборчивый ответ, вызов инструмента упал до реестра. Данные вызова не пишутся: в аргументах бывают ПДн.
//
// Параметры:
//  Текст - Строка - Подробное представление ошибки.
Процедура ЗаписатьОшибкуТранспорта(Знач Текст) Экспорт

	ЗаписатьСобытие("ТранспортMCP", УровеньЖурналаРегистрации.Ошибка, Новый Структура("message", Текст));

КонецПроцедуры

// Записывает остановку MCP-сервера командой (событие ИИОператор.ОстановкаСервера).
Процедура ЗаписатьОстановкуСервера() Экспорт

	ЗаписатьСобытие("ОстановкаСервера", УровеньЖурналаРегистрации.Информация, Новый Структура("status", "ok"));

КонецПроцедуры

// Пишет ли журнал регистрации события уровня «Информация»: без этого действия ИИ-оператора недоступны.
//
// Возвращаемое значение:
//  Булево
Функция ЖурналДействийВключен() Экспорт

	Возврат ИИО_Журнал.ЖурналДействийВключен();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Предел длины переписки одной записи журнала обмена канала MCP, символов: ответ инструмента больше
// не бывает (лимит строк запроса), а произвольный объем с клиента не принимается.
//
// Возвращаемое значение:
//  Число
Функция МаксимумПереписки()

	Возврат 1000000;

КонецФункции

Процедура ЗаписатьСобытие(Событие, Уровень, Сведения)

	ИИО_Журнал.ЗаписатьСобытие(Событие, Уровень, Сведения);

КонецПроцедуры

#КонецОбласти
