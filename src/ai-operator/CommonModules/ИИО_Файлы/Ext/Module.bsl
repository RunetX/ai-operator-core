// Ответ файлом: результат run_query и run_report уходит пользователю таблицей XLSX, а модель получает
// только имя файла и число строк - сами данные к ней не уходят. Файл собирается в фоновом задании
// инструмента, то есть в правах пользователя, из тех же колонок и строк, что модель получила бы в ответе.
// Дальше файл забирает канал (ИИО_ОтветКлиентСервер.ИзвлечьФайл): в боте он становится вложением сообщения
// (ИИОБ_Бот), в канале MCP открывается пользователю в 1С (ИИО_ПоказКлиент.ОткрытьФайлОтвета).

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, запрошен ли файл аргументом file.
//
// Параметры:
//  Аргументы - Структура, Соответствие - Аргументы инструмента.
//
// Возвращаемое значение:
//  Булево
Функция ЗапрошенФайл(Аргументы) Экспорт

	Возврат ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "file", Ложь) = Истина;

КонецФункции

// Возвращает число строк, которые попадают в файл. Предел задан в коде, а не настройкой: файл собирается
// внутри таймаута инструмента, и его цена - время сборки, а не размер ответа модели.
//
// Возвращаемое значение:
//  Число
Функция ЛимитСтрок() Экспорт

	Возврат 10000;

КонецФункции

// Заменяет данные ответа файлом: строки и итоги уходят пользователю файлом, модель получает имя файла
// и число строк. Вызывается вместо ИИО_Ответ.ДанныеДляМодели: в файл идут значения 1С, а не их вид для модели,
// и маскирование не тратится на строки, которых модель не увидит.
//
// Параметры:
//  Результат - Структура - Ответ инструмента до подготовки для модели: columns, rows и, у отчета, totals.
//  Основа - Строка - Основа имени файла, см. НовыйФайл.
//
// Возвращаемое значение:
//  Структура - Ответ для модели с полем file и служебным ключом файла, см. ИИО_ОтветКлиентСервер.ДобавитьФайл.
Функция ОтветФайлом(Результат, Основа) Экспорт

	Файл = НовыйФайл(Основа, Результат.columns, Результат.rows);
	Результат.Удалить("rows");
	Если Результат.Свойство("totals") Тогда
		Результат.Удалить("totals");
	КонецЕсли;
	ДляМодели = ИИО_Ответ.ДанныеДляМодели(Результат);
	ИИО_ОтветКлиентСервер.ДобавитьФайл(ДляМодели, Файл);
	Возврат ДляМодели;

КонецФункции

// Собирает файл по колонкам и строкам ответа инструмента: шапка из заголовков колонок и строки значений.
//
// Параметры:
//  Основа - Строка - Чем таблица называется для человека: «Запрос 2016-03-31 14-05» или вариант отчета
//    с периодом. Отсюда берутся заголовок окна в 1С и, транслитерацией, имя файла.
//  Колонки - Массив из Структура - Колонки ответа: name, type и, у отчета, title.
//  Строки - Массив из Массив - Значения по колонкам, см. ЗначениеЯчейки.
//
// Возвращаемое значение:
//  Структура:
//   * Имя - Строка - Имя файла латиницей с расширением, см. ИмяФайла.
//   * Заголовок - Строка - Название таблицы для человека: заголовок окна в 1С.
//   * Строк - Число - Сколько строк данных в файле.
//   * Документ - ТабличныйДокумент - Таблица файла: его записывает ДвоичныеДанныеXLSX или открывает канал MCP.
Функция НовыйФайл(Основа, Колонки, Строки) Экспорт

	Имя = ИмяФайла(Основа);
	Заголовок = СокрЛП(Строка(Основа));
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = Имя;
	КонецЕсли;
	Документ = Новый ТабличныйДокумент;
	ЗаписатьШапку(Документ, Колонки);
	// Описания типов значений создаются один раз: их получает каждая ячейка с числом или датой.
	Типы = Новый Структура("Число, Дата", Новый ОписаниеТипов("Число"), Новый ОписаниеТипов("Дата"));
	НомерСтроки = 1;
	Для Каждого ЗначенияСтроки Из Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		Для НомерКолонки = 1 По Мин(Колонки.Количество(), ЗначенияСтроки.Количество()) Цикл
			ЗаписатьЗначение(Документ.Область(НомерСтроки, НомерКолонки), ЗначенияСтроки[НомерКолонки - 1], Типы);
		КонецЦикла;
	КонецЦикла;
	// Шапка остается на месте при прокрутке и в 1С, и в Excel.
	Документ.ФиксацияСверху = 1;
	Возврат Новый Структура("Имя, Заголовок, Строк, Документ", Имя, Заголовок, Строки.Количество(), Документ);

КонецФункции

// Возвращает двоичные данные файла XLSX. Табличный документ пишется в поток в памяти, а не во временный
// файл: данные нужны в памяти, и временные файлы на сервере лучше не плодить (542 п. 2.1).
//
// Параметры:
//  Файл - см. НовыйФайл
//
// Возвращаемое значение:
//  ДвоичныеДанные
Функция ДвоичныеДанныеXLSX(Файл) Экспорт

	Поток = Новый ПотокВПамяти;
	Файл.Документ.Записать(Поток, ТипФайлаТабличногоДокумента.XLSX);
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пишет шапку файла: заголовки колонок и ширину колонки по длине заголовка. Шрифтом и цветом шапка
// не выделяется: оформление меняется элементами стиля (667), а их у ядра в чужой конфигурации нет -
// от данных шапку отделяет фиксация строки.
//
// Параметры:
//  Документ - ТабличныйДокумент
//  Колонки - см. НовыйФайл
Процедура ЗаписатьШапку(Документ, Колонки)

	НомерКолонки = 0;
	Для Каждого Колонка Из Колонки Цикл
		НомерКолонки = НомерКолонки + 1;
		Заголовок = "";
		Если Не Колонка.Свойство("title", Заголовок) Или Не ЗначениеЗаполнено(Заголовок) Тогда
			Заголовок = Колонка.name;
		КонецЕсли;
		Ячейка = Документ.Область(1, НомерКолонки);
		Ячейка.Текст = Заголовок;
		Ячейка.ШиринаКолонки = Мин(МаксимумШириныКолонки(), Макс(МинимумШириныКолонки(), СтрДлина(Заголовок) + 2));
	КонецЦикла;

КонецПроцедуры

// Пишет значение в ячейку файла. Число и дата пишутся значением ячейки, а не текстом: число попадает в XLSX
// числом, и Excel его сложит. Дату платформа все равно выгружает текстом, поэтому ей задается формат даты -
// иначе в файле было бы «31.03.2016 0:00:00». Остальное - текстом.
//
// Параметры:
//  Ячейка - ОбластьЯчеекТабличногоДокумента
//  Значение - Произвольный - Значение строки ответа, см. ЗначениеЯчейки.
//  Типы - Структура - Описания типов Число и Дата.
Процедура ЗаписатьЗначение(Ячейка, Значение, Типы)

	Содержимое = ЗначениеЯчейки(Значение);
	Если Содержимое = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Тип = ТипЗнч(Содержимое);
	Если Тип = Тип("Число") Или Тип = Тип("Дата") Тогда
		Ячейка.СодержитЗначение = Истина;
		Ячейка.ТипЗначения = ?(Тип = Тип("Число"), Типы.Число, Типы.Дата);
		Если Тип = Тип("Дата") Тогда
			Ячейка.Формат = ?(Содержимое = НачалоДня(Содержимое), "ДФ=dd.MM.yyyy", "ДФ=dd.MM.yyyy HH:mm:ss");
		КонецЕсли;
		Ячейка.Значение = Содержимое;
	Иначе
		Ячейка.Текст = Строка(Содержимое);
	КонецЕсли;

КонецПроцедуры

// Значение для ячейки файла. В строках ответа лежат значения 1С, кроме помеченных ПДн ({pii, value})
// и подписей пустых значений ({presentation}), см. ИИО_Ответ.ЗначениеСПДн и ИИО_Отчеты.ЗначениеДляМодели:
// в файл идет реальное значение, его модель не видит.
//
// Параметры:
//  Значение - Произвольный - Значение строки ответа.
//
// Возвращаемое значение:
//  Произвольный - Число, Дата, Строка или Неопределено для пустой ячейки.
Функция ЗначениеЯчейки(Значение)

	Тип = ТипЗнч(Значение);
	Если Значение = Неопределено Или Значение = Null Или (Тип = Тип("Дата") И Не ЗначениеЗаполнено(Значение)) Тогда
		Возврат Неопределено;
	ИначеЕсли Тип = Тип("Структура") Или Тип = Тип("Соответствие") Тогда
		Вложенное = ИИО_ОтветКлиентСервер.Аргумент(Значение, "value",
			ИИО_ОтветКлиентСервер.Аргумент(Значение, "presentation"));
		// Значение с пометкой ПДн уже преобразовано для модели, и дата в нем - строка ISO: в файл она
		// возвращается датой, иначе пользователь увидел бы «1980-05-12T00:00:00» вместо 12.05.1980.
		// Разбирается только запись, которая совпала с датой целиком: у строкового поля с ПДн значение
		// может начинаться отметкой времени, и усечение разбора отрезало бы остальной текст.
		Если ТипЗнч(Вложенное) = Тип("Строка") Тогда
			Дата = ИИО_ОтветКлиентСервер.ДатаАргумента(Вложенное);
			Если Дата <> Неопределено И XMLСтрока(Дата) = СокрЛП(Вложенное) Тогда
				Возврат Дата;
			КонецЕсли;
		КонецЕсли;
		Возврат ЗначениеЯчейки(Вложенное);
	ИначеЕсли Тип = Тип("Число") Или Тип = Тип("Дата") Или Тип = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Имя файла по основе. Имя формирует код, а файл уходит в файловую систему пользователя, поэтому в нем только
// латиница и цифры (542 п. 4.1): основа транслитерируется, остальные символы заменяются пробелом, пробелы
// подряд сводятся к одному («klientam za», а не «klientam  za» на месте запятой), длина ограничена.
// Русское название таблицы остается заголовком окна, см. НовыйФайл.
//
// Параметры:
//  Основа - Строка
//
// Возвращаемое значение:
//  Строка
Функция ИмяФайла(Основа)

	Разрешенные = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 -_.";
	Транслитерация = СтроковыеФункцииКлиентСервер.СтрокаЛатиницей(Строка(Основа));
	Отобранные = Новый Массив;
	Для Индекс = 1 По СтрДлина(Транслитерация) Цикл
		Символ = Сред(Транслитерация, Индекс, 1);
		Отобранные.Добавить(?(СтрНайти(Разрешенные, Символ) = 0, " ", Символ));
	КонецЦикла;
	Слова = СтрРазделить(СтрСоединить(Отобранные, ""), " ", Ложь);
	Имя = СокрЛП(Лев(СтрСоединить(Слова, " "), МаксимумДлиныИмени()));
	// Имя по умолчанию тоже латиницей: пустая основа не должна давать русское имя файла.
	Возврат ?(ПустаяСтрока(Имя), "export", Имя) + ".xlsx";

КонецФункции

Функция МаксимумДлиныИмени()

	Возврат 80;

КонецФункции

Функция МинимумШириныКолонки()

	Возврат 12;

КонецФункции

Функция МаксимумШириныКолонки()

	Возврат 50;

КонецФункции

#КонецОбласти
