// Обработчики ожидания ИИ-оператора: подключаются по имени, поэтому живут в глобальном модуле.

#Область СлужебныйПрограммныйИнтерфейс

// Отложенный запуск ИИ-оператора по параметру запуска ИИО_Запустить.
Процедура ИИО_ЗапуститьПоПараметруЗапуска() Экспорт

	ИИО_СерверMCPКлиент.Запустить();

КонецПроцедуры

// Отложенное открытие формы «Состояние ИИ-оператора» по параметру запуска ИИО_Состояние.
Процедура ИИО_ОткрытьСостояниеПоПараметруЗапуска() Экспорт

	ОткрытьФорму("ОбщаяФорма.ИИО_Состояние");

КонецПроцедуры

// Отложенное включение в группу доступа «ИИ-оператор» по параметру запуска ИИО_ДобавитьВГруппу.
Процедура ИИО_ДобавитьВГруппуПоПараметруЗапуска() Экспорт

	Попытка
		Результат = ИИО_ПраваВызовСервера.ДобавитьВГруппуИИОператор();
	Исключение
		// Без прав администратора: платформа уже записала нарушение прав в журнал регистрации.
		Результат = Новый Структура("ok, error", Ложь,
			Строка(ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке())));
	КонецПопытки;
	Если Результат.ok Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор'"), , НСтр("ru = 'Вы добавлены в группу доступа «ИИ-оператор».'"));
	Иначе
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Не удалось добавить вас в группу доступа «ИИ-оператор»: %1
			|Добавьте пользователя в группу вручную: «Администрирование → Пользователи и права → Группы доступа».'"),
			Результат.error));
	КонецЕсли;

КонецПроцедуры

// Проверка фонового задания модели: запроса run_query или отчета run_report.
Процедура ИИО_ПроверитьФоновоеЗадание() Экспорт

	ИИО_ФоновыеЗаданияКлиент.Проверить();

КонецПроцедуры

// Проверка форм, закрытия которых ждут вызовы инструментов: срок и прогресс.
Процедура ИИО_ПроверитьОжидаемыеФормы() Экспорт

	ИИО_ФормыКлиент.ПроверитьОжидание();

КонецПроцедуры

// Команда печати print_documents после ответа модели, как после нажатия кнопки меню «Печать».
Процедура ИИО_ВыполнитьОтложеннуюПечать() Экспорт

	ИИО_ПоказКлиент.ВыполнитьОтложеннуюПечать();

КонецПроцедуры

#КонецОбласти
