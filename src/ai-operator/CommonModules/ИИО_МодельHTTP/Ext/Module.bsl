// Клиент модели с OpenAI-совместимым API: chat/completions с function tools. Один клиент для
// LM Studio и облачных сервисов с тем же API. Ошибки сети и модели возвращаются структурой, а не исключением:
// канал превращает их в понятный ответ пользователю.

#Область СлужебныйПрограммныйИнтерфейс

// Параметры подключения к модели из настроек ИИ-оператора.
//
// Параметры:
//  Назначение - Строка - «агент» - модель, которая отвечает пользователю; «маскирование» - локальная модель,
//    которая ищет людей в вопросе пользователя.
//
// Возвращаемое значение:
//  Структура:
//   * Адрес - Строка - Адрес API без /chat/completions, например http://localhost:1234/v1.
//   * Модель - Строка - Имя модели.
//   * ТаймаутСек - Число
//   * Ключ - Строка - Ключ API из безопасного хранилища или пустая строка.
//   * Настроена - Булево - Адрес и имя модели заданы.
//   * СрокМс - Число, Неопределено - Момент (ТекущаяУниверсальнаяДатаВМиллисекундах), позже которого запрос
//     не повторяется после сбоя; задает вызывающий (срок хода агента).
Функция ПараметрыМодели(Назначение = "агент") Экспорт

	Если Назначение = "маскирование" Тогда
		Адрес = ИИО_Настройки.Значение("ИИО_АдресМоделиМаскирования");
		Модель = ИИО_Настройки.Значение("ИИО_ИмяМоделиМаскирования");
		ТаймаутСек = ТаймаутМаскированияСек();
		Ключ = "";
	Иначе
		Адрес = ИИО_Настройки.Значение("ИИО_АдресМодели");
		Модель = ИИО_Настройки.Значение("ИИО_ИмяМодели");
		ТаймаутСек = ИИО_Настройки.Значение("ИИО_ТаймаутМоделиСек");
		Ключ = КлючДоступа();
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Модель = СокрЛП(Модель);
	Возврат Новый Структура("Адрес, Модель, ТаймаутСек, Ключ, Настроена, СрокМс", Адрес, Модель, ТаймаутСек, Ключ,
		Адрес <> "" И Модель <> "", Неопределено);

КонецФункции

// Запрос к chat/completions. Сбой, который проходит сам (обрыв соединения, ошибка сервера, падение движка
// LM Studio), повторяется после паузы, если запрос выполняется в фоновом задании (ход бота) и пауза
// укладывается в срок Параметры.СрокМс.
//
// Параметры:
//  Параметры - см. ПараметрыМодели
//  Сообщения - Массив из Структура, Соответствие - Сообщения role, content, tool_calls, tool_call_id.
//  Инструменты - Массив из Структура, Неопределено - Инструменты в формате function tools.
//  Дополнительно - Структура, Неопределено - Другие поля тела запроса: temperature, max_tokens,
//    response_format, reasoning_effort.
//
// Возвращаемое значение:
//  Структура:
//   * Сообщение - Соответствие, Неопределено - Ответ модели: role, content без рассуждений, tool_calls.
//   * Использование - Соответствие - Поле usage ответа: prompt_tokens, completion_tokens.
//   * ДлительностьМс - Число
//   * Ошибка - Структура, Неопределено - Код (MODEL_UNAVAILABLE, MODEL_ERROR), Текст и Подробно - текст
//     для журнала регистрации.
Функция ЗапросЧата(Параметры, Сообщения, Инструменты = Неопределено, Дополнительно = Неопределено) Экспорт

	Результат = Новый Структура("Сообщение, Использование, ДлительностьМс, Ошибка", Неопределено,
		Новый Соответствие, 0, Неопределено);

	Адрес = РазобратьАдрес(Параметры.Адрес);
	Если Адрес = Неопределено Тогда
		Результат.Ошибка = ОписаниеСбояМодели("MODEL_UNAVAILABLE",
			СтрШаблон(НСтр("ru = 'Неверный адрес модели: %1.'"), Параметры.Адрес));
		Возврат Результат;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("model", Параметры.Модель);
	Тело.Вставить("messages", Сообщения);
	Если ЗначениеЗаполнено(Инструменты) Тогда
		Тело.Вставить("tools", Инструменты);
	КонецЕсли;
	Если Дополнительно <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Дополнительно Цикл
			Тело.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(Адрес.Путь + "/chat/completions");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если Параметры.Ключ <> "" Тогда
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + Параметры.Ключ);
	КонецЕсли;
	Запрос.УстановитьТелоИзСтроки(ИИО_ОтветКлиентСервер.ВJSON(Тело), КодировкаТекста.UTF8,
		ИспользованиеByteOrderMark.НеИспользовать);

	Паузы = ПаузыПовтораСек();
	Повтор = 0;
	Пока Истина Цикл
		Повторяемый = ОтправитьЗапрос(Адрес, Запрос, Параметры, Результат);
		Если Результат.Ошибка = Неопределено Или Не Повторяемый Или Повтор = Паузы.Количество() Тогда
			Прервать;
		КонецЕсли;
		Пауза = Паузы[Повтор];
		Если Параметры.СрокМс <> Неопределено
			И ТекущаяУниверсальнаяДатаВМиллисекундах() + Пауза * 1000 >= Параметры.СрокМс
			Или Не ИИО_ФоновыеЗадания.Подождать(Пауза) Тогда
			Прервать;
		КонецЕсли;
		Повтор = Повтор + 1;
		ИИО_Журнал.ЗаписатьСобытие("Модель.Повтор", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("code, error, retry, pause_sec", Результат.Ошибка.Код, Результат.Ошибка.Подробно, Повтор,
				Пауза));
		Результат.Ошибка = Неопределено;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Убирает рассуждения «думающих» моделей: блоки <think>...</think> и незакрытый <think> в начале ответа.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
Функция БезРассуждений(Текст) Экспорт

	Результат = Текст;
	Начало = СтрНайти(Результат, "<think>");
	Пока Начало > 0 Цикл
		Конец = СтрНайти(Результат, "</think>", НаправлениеПоиска.СНачала, Начало);
		Если Конец = 0 Тогда
			Результат = Лев(Результат, Начало - 1);
			Прервать;
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Сред(Результат, Конец + СтрДлина("</think>"));
		Начало = СтрНайти(Результат, "<think>");
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

// Адрес модели в этом компьютере или в частной сети: localhost, 127.x, 10.x, 172.16-31.x, 192.168.x.
// Модели маскирования исходный текст с ПДн отдается только по такому адресу.
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Булево
Функция ЛокальныйАдрес(Адрес) Экспорт

	Разбор = РазобратьАдрес(Адрес);
	Если Разбор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Хост = НРег(Разбор.Хост);
	Если Хост = "localhost" Тогда
		Возврат Истина;
	КонецЕсли;
	Части = СтрРазделить(Хост, ".");
	Если Части.Количество() <> 4 Тогда
		Возврат Ложь;
	КонецЕсли;
	Числа = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если Часть = "" Или СтрДлина(Часть) > 3 Или Не СтрокаИзЦифр(Часть) Тогда
			Возврат Ложь;
		КонецЕсли;
		Числа.Добавить(Число(Часть));
	КонецЦикла;
	Возврат Числа[0] = 127 Или Числа[0] = 10 Или Числа[0] = 192 И Числа[1] = 168
		Или Числа[0] = 172 И Числа[1] >= 16 И Числа[1] <= 31;

КонецФункции

// Записывает ключ API модели в безопасное хранилище. Только для администратора ИИ-оператора.
//
// Параметры:
//  Ключ - Строка - Пустая строка удаляет ключ.
Процедура ЗаписатьКлючДоступа(Ключ) Экспорт

	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		ВызватьИсключение НСтр("ru = 'Ключ API модели меняет только администратор ИИ-оператора.'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Если ЗначениеЗаполнено(Ключ) Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецКлюча(), СокрЛП(Ключ), "КлючДоступа");
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючДоступа");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Запросы разрешений на адреса моделей для профилей безопасности БСП (стандарт 794). Владелец разрешения -
// константа адреса: новый адрес заменяет разрешение прежнего, пустой адрес разрешение снимает.
// Если в базе профили безопасности не используются, БСП записывает запрос без мастера настройки.
//
// Параметры:
//  АдресМодели - Строка - Значение константы ИИО_АдресМодели.
//  АдресМоделиМаскирования - Строка - Значение константы ИИО_АдресМоделиМаскирования.
//
// Возвращаемое значение:
//  Массив из УникальныйИдентификатор - Идентификаторы запросов для
//    РаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов.
Функция ЗапросыРазрешений(АдресМодели, АдресМоделиМаскирования) Экспорт

	Запросы = Новый Массив;
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПрофилиБезопасности") Тогда
		Возврат Запросы;
	КонецЕсли;
	ДобавитьЗапросРазрешения(Запросы, Метаданные.Константы.ИИО_АдресМодели, АдресМодели,
		НСтр("ru = 'Модель агента ИИ-оператора.'"));
	ДобавитьЗапросРазрешения(Запросы, Метаданные.Константы.ИИО_АдресМоделиМаскирования, АдресМоделиМаскирования,
		НСтр("ru = 'Модель маскирования ИИ-оператора.'"));
	Возврат Запросы;

КонецФункции

// Задан ли ключ API модели, без чтения самого ключа: для формы настроек.
//
// Возвращаемое значение:
//  Булево
Функция КлючДоступаЗадан() Экспорт

	Возврат КлючДоступа() <> "";

КонецФункции

// Разбирает JSON в соответствия и массивы.
//
// Параметры:
//  Текст - Строка, Произвольный - Не строка дает Неопределено.
//
// Возвращаемое значение:
//  Соответствие, Массив, Строка, Число, Булево, Неопределено - Неопределено, если текст - не JSON.
Функция ИзJSON(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = ИИО_ОтветКлиентСервер.ИзJSON(Текст);
	Исключение
		// Текст пишет модель, и он не обязан быть JSON: вызывающий получает Неопределено и отвечает модели
		// ошибкой формата, а причина остается в журнале.
		Данные = Неопределено;
		ИИО_Журнал.ЗаписатьСобытие("Модель.РазборJSON", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет запрос разрешения на адрес модели или, если адрес пуст или не разобран, запрос на снятие
// разрешения прежнего адреса.
//
// Параметры:
//  Запросы - Массив из УникальныйИдентификатор
//  Константа - ОбъектМетаданныхКонстанта - Владелец разрешения.
//  Адрес - Строка
//  Описание - Строка - Зачем нужен ресурс: показывается администратору в мастере разрешений.
Процедура ДобавитьЗапросРазрешения(Запросы, Константа, Адрес, Описание)

	МодульРаботаВБезопасномРежиме = ОбщегоНазначения.ОбщийМодуль("РаботаВБезопасномРежиме");
	Владелец = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Константа);
	Разбор = РазобратьАдрес(Адрес);
	Если Разбор = Неопределено Тогда
		Запросы.Добавить(МодульРаботаВБезопасномРежиме.ЗапросНаОчисткуРазрешенийИспользованияВнешнихРесурсов(Владелец));
		Возврат;
	КонецЕсли;
	Разрешение = МодульРаботаВБезопасномРежиме.РазрешениеНаИспользованиеИнтернетРесурса(
		?(Разбор.Защищенное, "HTTPS", "HTTP"), Разбор.Хост, Разбор.Порт, Описание);
	Разрешения = Новый Массив;
	Разрешения.Добавить(Разрешение);
	Запросы.Добавить(МодульРаботаВБезопасномРежиме.ЗапросНаИспользованиеВнешнихРесурсов(Разрешения, Владелец));

КонецПроцедуры

// Разбирает адрес вида http(s)://хост[:порт][/путь].
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Структура, Неопределено - Защищенное, Хост, Порт, Путь (без завершающей «/»); Неопределено - адрес не разобран.
Функция РазобратьАдрес(Адрес)

	Текст = СокрЛП(Адрес);
	Если СтрНачинаетсяС(НРег(Текст), "https://") Тогда
		Защищенное = Истина;
		Текст = Сред(Текст, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Текст), "http://") Тогда
		Защищенное = Ложь;
		Текст = Сред(Текст, 8);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	ПозицияПути = СтрНайти(Текст, "/");
	Путь = ?(ПозицияПути = 0, "", Сред(Текст, ПозицияПути));
	Сервер = ?(ПозицияПути = 0, Текст, Лев(Текст, ПозицияПути - 1));
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Порт = ?(Защищенное, 443, 80);
	ПозицияПорта = СтрНайти(Сервер, ":", НаправлениеПоиска.СКонца);
	Если ПозицияПорта > 0 И СтрНайти(Сервер, "]") < ПозицияПорта Тогда
		ТекстПорта = Сред(Сервер, ПозицияПорта + 1);
		Если ТекстПорта = "" Или Не СтрокаИзЦифр(ТекстПорта) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Порт = Число(ТекстПорта);
		Сервер = Лев(Сервер, ПозицияПорта - 1);
	КонецЕсли;
	Если Сервер = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Защищенное, Хост, Порт, Путь", Защищенное, Сервер, Порт, Путь);

КонецФункции

// Отправляет запрос модели и заполняет результат ЗапросЧата.
//
// Параметры:
//  Адрес - см. РазобратьАдрес
//  Запрос - HTTPЗапрос
//  Параметры - см. ПараметрыМодели
//  Результат - см. ЗапросЧата - Заполняются Сообщение, Использование, Ошибка; к ДлительностьМс добавляется
//    время запроса.
//
// Возвращаемое значение:
//  Булево - Ошибка проходит сама, запрос стоит повторить: обрыв соединения, ошибка сервера, лимит запросов,
//    падение движка LM Studio (он отвечает 400 «Engine protocol predict request failed»).
Функция ОтправитьЗапрос(Адрес, Запрос, Параметры, Результат)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , Параметры.ТаймаутСек,
			?(Адрес.Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ПрошлоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
		Результат.ДлительностьМс = Результат.ДлительностьМс + ПрошлоМс;
		Информация = ИнформацияОбОшибке();
		Результат.Ошибка = ОписаниеСбояМодели("MODEL_UNAVAILABLE",
			ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Информация),
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация));
		// Обрыв соединения проходит сам, а таймаут повторять незачем: модель не успевает ответить.
		Возврат ПрошлоМс < Параметры.ТаймаутСек * 900;
	КонецПопытки;
	Результат.ДлительностьМс = Результат.ДлительностьМс + ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Ошибка = ОписаниеСбояМодели("MODEL_ERROR", СтрШаблон("HTTP %1: %2",
			Формат(Ответ.КодСостояния, "ЧГ=0"), ИИО_ОтветКлиентСервер.Обрезать(ТекстОтвета, 500)));
		Возврат Ответ.КодСостояния >= 500 Или Ответ.КодСостояния = 429
			Или Ответ.КодСостояния = 400 И СтрНайти(ТекстОтвета, "Engine protocol") > 0;
	КонецЕсли;

	Данные = ИзJSON(ТекстОтвета);
	Сообщение = СообщениеОтвета(Данные);
	Если Сообщение = Неопределено Тогда
		Результат.Ошибка = ОписаниеСбояМодели("MODEL_ERROR", СтрШаблон(НСтр("ru = 'Ответ модели без сообщения: %1'"),
			ИИО_ОтветКлиентСервер.Обрезать(ТекстОтвета, 500)));
		Возврат Ложь;
	КонецЕсли;
	Содержимое = Сообщение.Получить("content");
	Сообщение.Вставить("content", ?(ТипЗнч(Содержимое) = Тип("Строка"), БезРассуждений(Содержимое), ""));
	Результат.Сообщение = Сообщение;
	Если ТипЗнч(Данные.Получить("usage")) = Тип("Соответствие") Тогда
		Результат.Использование = Данные.Получить("usage");
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Паузы перед повторами запроса после сбоя, с. Движок LM Studio после падения перезапускается: повтор сразу
// получает тот же отказ, через полминуты проходит.
//
// Возвращаемое значение:
//  Массив из Число
Функция ПаузыПовтораСек()

	Паузы = Новый Массив;
	Паузы.Добавить(5);
	Паузы.Добавить(10);
	Паузы.Добавить(15);
	Возврат Паузы;

КонецФункции

Функция СтрокаИзЦифр(Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Первое сообщение ответа: choices[0].message.
//
// Параметры:
//  Данные - Соответствие, Неопределено - Разобранный ответ.
//
// Возвращаемое значение:
//  Соответствие, Неопределено
Функция СообщениеОтвета(Данные)

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Варианты = Данные.Получить("choices");
	Если ТипЗнч(Варианты) <> Тип("Массив") Или Варианты.Количество() = 0
		Или ТипЗнч(Варианты[0]) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сообщение = Варианты[0].Получить("message");
	Возврат ?(ТипЗнч(Сообщение) = Тип("Соответствие"), Сообщение, Неопределено);

КонецФункции

Функция ОписаниеСбояМодели(Код, Текст, Подробно = "")

	Возврат Новый Структура("Код, Текст, Подробно", Код, Текст, ?(Подробно = "", Текст, Подробно));

КонецФункции

Функция КлючДоступа()

	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецКлюча(), "КлючДоступа");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(ТипЗнч(Ключ) = Тип("Строка"), Ключ, "");

КонецФункции

Функция ВладелецКлюча()

	Возврат "ИИОператор.МодельАгента";

КонецФункции

Функция ТаймаутМаскированияСек()

	Возврат 30;

КонецФункции

