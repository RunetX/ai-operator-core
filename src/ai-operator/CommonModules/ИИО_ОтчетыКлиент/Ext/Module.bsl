// Инструменты list_reports и run_report на клиенте. Отчет для модели формируется фоновым заданием,
// а пользователю открывается его штатная форма с теми же настройками: цифры в чате и в 1С совпадают.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента list_reports.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция НайтиОтчеты(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИО_ОтчетыВызовСервера.НайтиОтчеты(ПараметрыОбработчика.Аргументы);

КонецФункции

// Обработчик инструмента run_report.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Ошибка или результат, если задание завершилось сразу.
//  Неопределено - Ответ придет после завершения фонового задания.
Функция СформироватьОтчет(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Ошибка = ИИО_ФоновыеЗаданияКлиент.ОшибкаЗанятости();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запуск = ИИО_ОтчетыВызовСервера.НачатьФормирование(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Запуск) Тогда
		Возврат Запуск;
	КонецЕсли;

	Настройка = ИИО_ФоновыеЗаданияКлиент.НоваяНастройкаОжидания("REPORT_TIMEOUT",
		НСтр("ru = 'Отчет не сформировался за %1 с и отменен.'"),
		НСтр("ru = 'Сузь период или добавь отбор (организация, контрагент). База освобождается после отмены до минуты, поэтому сразу не повторяй.'"),
		НСтр("ru = 'Отчет формируется'"));
	Если Запуск.Открытие <> Неопределено Тогда
		Настройка.ПослеУспеха = Новый ОписаниеОповещения("ПослеФормирования", ИИО_ОтчетыКлиент, Запуск.Открытие);
	КонецЕсли;
	Возврат ИИО_ФоновыеЗаданияКлиент.Ожидать(ПараметрыОбработчика.Вызов, Запуск, Начало, Настройка);

КонецФункции

// Открывает пользователю форму отчета с теми же настройками после того, как модель получила данные.
//
// Параметры:
//  Ответ - Структура - Ответ run_report.
//  Открытие - см. ИИО_Отчеты.ПараметрыОткрытияФормы
//
// Возвращаемое значение:
//  Структура - Ответ с полями opened и form.
Функция ПослеФормирования(Ответ, Открытие) Экспорт

	Попытка
		// Уникальность: каждый вызов открывает свой экземпляр формы с переданными настройками.
		ИИО_ФормыКлиент.ЗапомнитьФорму(ОткрытьФорму(Открытие.ИмяФормы, Открытие.Параметры, , Истина));
		ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор открыл отчет'"), , Открытие.Заголовок);
		Ответ.Вставить("opened", Истина);
		Ответ.Вставить("form", Открытие.ИмяФормы);
	Исключение
		Ответ.Вставить("opened", Ложь);
		Ответ.Вставить("open_error", ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Ответ;

КонецФункции

#КонецОбласти
