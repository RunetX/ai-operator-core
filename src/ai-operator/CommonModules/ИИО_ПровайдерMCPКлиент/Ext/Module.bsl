// Адаптер ядра ИИ-оператора к client_mcp. Вся логика инструментов - в ядре.

#Область ПрограммныйИнтерфейс

// Регистрирует инструменты ядра в client_mcp.
// Вызывается client_mcp для модулей подсистемы ИИО_Мсп_Провайдеры.
//
// Параметры:
//  ИсточникРегистрации - Строка - Имя модуля-провайдера.
Процедура Зарегистрировать(ИсточникРегистрации) Экспорт

	Для Каждого КлючИЗначение Из ИИО_РеестрИнструментовКлиент.Инструменты() Цикл
		Инструмент = КлючИЗначение.Значение;
		Мсп_Сервер.ЗарегистрироватьИнструмент(Мсп_Сервер.НовыйИнструмент(
			Инструмент.Имя,
			Инструмент.Описание,
			Инструмент.Схема,
			Новый ОписаниеОповещения("ВызватьИнструмент", ИИО_ПровайдерMCPКлиент, Инструмент.Имя),
			Инструмент.ОтложенныйОтвет),
			ИсточникРегистрации);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик вызова инструмента из client_mcp.
//
// Параметры:
//  Запрос - Структура - Запрос client_mcp: Аргументы, Контекст, Идентификатор.
//  ИмяИнструмента - Строка - Имя инструмента ядра.
//
// Возвращаемое значение:
//  Структура - Результат или ошибка для client_mcp.
//  Неопределено - Ответ отложен.
Функция ВызватьИнструмент(Запрос, ИмяИнструмента) Экспорт

	ТокенПрогресса = Запрос.Контекст.progressToken;
	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("mcp");
	ПараметрыВызова.ТокенПрогресса = ТокенПрогресса;
	ПараметрыВызова.ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершитьВызов", ИИО_ПровайдерMCPКлиент,
		Запрос.Идентификатор);
	Если ТокенПрогресса <> Неопределено Тогда
		ПараметрыВызова.ОповещениеОПрогрессе = Новый ОписаниеОповещения("СообщитьПрогресс", ИИО_ПровайдерMCPКлиент,
			ТокенПрогресса);
	КонецЕсли;

	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать(ИмяИнструмента, Запрос.Аргументы, ПараметрыВызова);
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоВнутренняяОшибка(Ответ) Тогда
		Возврат Мсп_Сервер.ОшибкаИнструмента("INTERNAL", Ответ.error.message);
	КонецЕсли;
	Возврат Мсп_Результаты.JSON(Ответ);

КонецФункции

// Завершает отложенный вызов в client_mcp.
//
// Параметры:
//  Ответ - Структура, Соответствие - Подготовленный ответ ядра.
//  ИдентификаторЗапроса - Произвольный - Идентификатор запроса client_mcp.
Процедура ЗавершитьВызов(Ответ, ИдентификаторЗапроса) Экспорт

	Если ЭтоВнутренняяОшибка(Ответ) Тогда
		Мсп_Сервер.ЗавершитьВызовИнструментаСОшибкой(ИдентификаторЗапроса, "INTERNAL", Ответ.error.message);
	Иначе
		Мсп_Сервер.ЗавершитьВызовИнструментаУспешно(ИдентификаторЗапроса, Мсп_Результаты.JSON(Ответ));
	КонецЕсли;

КонецПроцедуры

// Передает прогресс долгого вызова клиенту MCP.
//
// Параметры:
//  Прогресс - Структура - Прогресс, Всего, Сообщение.
//  ТокенПрогресса - Произвольный - progressToken клиента.
Процедура СообщитьПрогресс(Прогресс, ТокенПрогресса) Экспорт

	Мсп_Сервер.УведомитьОПрогрессе(ТокенПрогресса, Прогресс.Прогресс, Прогресс.Всего, Прогресс.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, что ответ - внутренняя ошибка INTERNAL. Сбои, которые модель исправить не может,
// уходят JSON-RPC ошибкой.
//
// Параметры:
//  Ответ - Структура, Соответствие - Подготовленный ответ ядра.
//
// Возвращаемое значение:
//  Булево - Истина, если код ошибки ответа INTERNAL.
Функция ЭтоВнутренняяОшибка(Ответ)

	Возврат ИИО_ОтветКлиентСервер.КодОшибки(Ответ) = "INTERNAL";

КонецФункции

#КонецОбласти
