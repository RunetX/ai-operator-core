// Адаптер ядра ИИ-оператора к MCP-транспорту. Вся логика инструментов - в ядре.

#Область СлужебныйПрограммныйИнтерфейс

// Инструменты ядра и пакетов для tools/list.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * name - Строка
//   * description - Строка
//   * inputSchema - Структура
Функция ОписанияИнструментов() Экспорт

	Описания = Новый Массив;
	Для Каждого КлючИЗначение Из ИИО_РеестрИнструментовКлиент.Инструменты() Цикл
		Инструмент = КлючИЗначение.Значение;
		Описания.Добавить(Новый Структура("name, description, inputSchema",
			Инструмент.Имя, Инструмент.Описание, Инструмент.Схема));
	КонецЦикла;
	Возврат Описания;

КонецФункции

// Вызов инструмента клиентом MCP. Ответ уходит в транспорт сразу или после завершения отложенного вызова.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты транспорта.
//  ИмяИнструмента - Строка
//  Аргументы - Структура, Соответствие - Аргументы от модели.
//  ТокенПрогресса - Строка, Число, Неопределено - progressToken клиента.
Процедура ВызватьИнструмент(Идентификатор, ИмяИнструмента, Аргументы, ТокенПрогресса) Экспорт

	ПараметрыВызова = ИИО_РеестрИнструментовКлиент.НовыеПараметрыВызова("mcp");
	ПараметрыВызова.Идентификатор = Идентификатор;
	ПараметрыВызова.ТокенПрогресса = ТокенПрогресса;
	ПараметрыВызова.ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершитьВызов", ИИО_ПровайдерMCPКлиент,
		Идентификатор);
	Если ТокенПрогресса <> Неопределено Тогда
		ПараметрыВызова.ОповещениеОПрогрессе = Новый ОписаниеОповещения("СообщитьПрогресс", ИИО_ПровайдерMCPКлиент,
			Идентификатор);
	КонецЕсли;

	Ответ = ИИО_РеестрИнструментовКлиент.Вызвать(ИмяИнструмента,
		?(Аргументы = Неопределено, Новый Структура, Аргументы), ПараметрыВызова);
	Если Ответ <> Неопределено Тогда
		ЗавершитьВызов(Ответ, Идентификатор);
	КонецЕсли;

КонецПроцедуры

// Передает ответ ядра клиенту MCP.
//
// Параметры:
//  Ответ - Структура, Соответствие - Подготовленный ответ ядра.
//  Идентификатор - Строка - Номер вызова компоненты транспорта.
Процедура ЗавершитьВызов(Ответ, Идентификатор) Экспорт

	// Сбои, которые модель исправить не может, уходят ошибкой JSON-RPC, как раньше в client_mcp.
	КодОшибки = ИИО_ОтветКлиентСервер.КодОшибки(Ответ);
	Если КодОшибки = "INTERNAL" Тогда
		ИИО_ТранспортMCPКлиент.ОтправитьОшибку(Идентификатор, -32000, "INTERNAL: " + Ответ.error.message);
	Иначе
		ИИО_ТранспортMCPКлиент.ОтправитьОтвет(Идентификатор, ТекстОтвета(Ответ));
	КонецЕсли;

КонецПроцедуры

// Передает прогресс долгого вызова клиенту MCP.
//
// Параметры:
//  Прогресс - Структура - Прогресс, Всего, Сообщение.
//  Идентификатор - Строка - Номер вызова компоненты транспорта.
Процедура СообщитьПрогресс(Прогресс, Идентификатор) Экспорт

	ИИО_ТранспортMCPКлиент.УведомитьОПрогрессе(Идентификатор, Прогресс.Прогресс, Прогресс.Всего, Прогресс.Сообщение);

КонецПроцедуры

// Отмена вызова клиентом MCP (notifications/cancelled) или по таймауту сервера.
//
// Параметры:
//  Идентификатор - Строка - Номер вызова компоненты транспорта.
//  Причина - Строка - client или timeout.
Процедура ОтменитьВызов(Идентификатор, Причина) Экспорт

	ИИО_РеестрИнструментовКлиент.Отменить("mcp", Идентификатор, Причина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст ответа для модели. Запись JSON с параметрами по умолчанию: тот же текст, что раньше отдавал client_mcp,
// поэтому модель не видит разницы (снимок MCP).
//
// Параметры:
//  Ответ - Структура, Соответствие
//
// Возвращаемое значение:
//  Строка
Функция ТекстОтвета(Ответ)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Ответ);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
