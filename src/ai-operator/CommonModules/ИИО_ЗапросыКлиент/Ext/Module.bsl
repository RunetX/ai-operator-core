// Инструмент run_query на клиенте: запрос выполняется фоновым заданием модели,
// ожидание и таймаут - в ИИО_ФоновыеЗаданияКлиент.

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента run_query.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура - Ошибка или результат, если задание завершилось сразу.
//  Неопределено - Ответ придет после завершения фонового задания.
Функция ВыполнитьЗапрос(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Ошибка = ИИО_ФоновыеЗаданияКлиент.ОшибкаЗанятости();
	Если Ошибка <> Неопределено Тогда
		Возврат Ошибка;
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запуск = ИИО_ЗапросыВызовСервера.НачатьВыполнение(ПараметрыОбработчика.Аргументы);
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Запуск) Тогда
		Возврат Запуск;
	КонецЕсли;

	Настройка = ИИО_ФоновыеЗаданияКлиент.НоваяНастройкаОжидания("QUERY_TIMEOUT",
		НСтр("ru = 'Запрос не выполнился за %1 с и отменен.'"),
		НСтр("ru = 'Сузь отбор (период, организация, контрагент) или воспользуйся отчетом. База освобождается после отмены до минуты, поэтому сразу не повторяй.'"),
		НСтр("ru = 'Запрос выполняется'"));
	Возврат ИИО_ФоновыеЗаданияКлиент.Ожидать(ПараметрыОбработчика.Вызов, Запуск, Начало, Настройка);

КонецФункции

#КонецОбласти
