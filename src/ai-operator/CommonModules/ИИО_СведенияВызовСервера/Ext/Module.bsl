#Область СлужебныйПрограммныйИнтерфейс

// Технические сведения для инструмента ping. Персональных данных не содержит.
//
// Возвращаемое значение:
//  Структура - Сведения о расширении, конфигурации, платформе и режимах выполнения.
Функция Сведения() Экспорт

	СистемнаяИнформация = Новый СистемнаяИнформация;

	Результат = Новый Структура;
	Результат.Вставить("status", "ok");
	Результат.Вставить("extension", "ИИОператор");
	Результат.Вставить("extension_version", ИИО_Настройки.ВерсияРасширения());
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("configuration_version", Метаданные.Версия);
	Результат.Вставить("platform", СистемнаяИнформация.ВерсияПриложения);
	Результат.Вставить("file_infobase", ОбщегоНазначения.ИнформационнаяБазаФайловая());
	Результат.Вставить("safe_mode", БезопасныйРежим() <> Ложь);
	Результат.Вставить("privileged_mode_available", ПривилегированныйРежимДоступен());
	Результат.Вставить("server_time", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	// Без уровня «Информация» в журнале регистрации действия недоступны: модель узнает об этом заранее.
	Результат.Вставить("event_log_info", ИИО_Журнал.ЖурналДействийВключен());
	Результат.Вставить("packages", ИИО_Диагностика.ПакетыДляPing());
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, можно ли включить привилегированный режим из кода расширения
// (в безопасном режиме расширения он недоступен). Нужно журналу операций.
//
// Возвращаемое значение:
//  Булево - Истина, если привилегированный режим включается.
Функция ПривилегированныйРежимДоступен()

	Результат = Ложь;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Результат = ПривилегированныйРежим();
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти
