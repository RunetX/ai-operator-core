#Область СлужебныйПрограммныйИнтерфейс

// Описания инструментов и инструкции для модели из макета ИИО_ОписанияИнструментов
// и макетов <Префикс>_ОписанияИнструментов пакетов (см. ИИО_Пакеты).
// Раздел макета начинается строкой «## <имя>»: имя инструмента или instructions.
// Раздел instructions пакета дописывается к инструкциям ядра.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Имя раздела.
//   * Значение - Строка - Текст раздела.
Функция ОписанияИнструментов() Экспорт

	Разделы = Новый Соответствие;
	РазобратьОписания(ПолучитьОбщийМакет("ИИО_ОписанияИнструментов").ПолучитьТекст(), Разделы);
	Для Каждого ИмяМакета Из ИИО_Пакеты.Макеты("_ОписанияИнструментов") Цикл
		РазобратьОписания(ПолучитьОбщийМакет(ИмяМакета).ПолучитьТекст(), Разделы);
	КонецЦикла;
	Возврат Разделы;

КонецФункции

// Клиентские модули пакетов, которые регистрируют инструменты (см. ИИО_Пакеты).
//
// Возвращаемое значение:
//  Массив из Строка
Функция МодулиПакетов() Экспорт

	Возврат ИИО_Пакеты.КлиентскиеМодули();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РазобратьОписания(Текст, Разделы)

	ИмяРаздела = "";
	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Строка = СокрП(СтрЗаменить(Строка, Символы.ВК, ""));
		Если СтрНачинаетсяС(Строка, "## ") Тогда
			ДобавитьРаздел(Разделы, ИмяРаздела, Строки);
			ИмяРаздела = СокрЛП(Сред(Строка, 4));
			Строки = Новый Массив;
		ИначеЕсли ЗначениеЗаполнено(ИмяРаздела) Тогда
			Строки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	ДобавитьРаздел(Разделы, ИмяРаздела, Строки);

КонецПроцедуры

Процедура ДобавитьРаздел(Разделы, ИмяРаздела, Строки)

	Если Не ЗначениеЗаполнено(ИмяРаздела) Тогда
		Возврат;
	КонецЕсли;
	Текст = СокрЛП(СтрСоединить(Строки, Символы.ПС));
	Имеющийся = Разделы.Получить(ИмяРаздела);
	Если ИмяРаздела = "instructions" И ЗначениеЗаполнено(Имеющийся) Тогда
		Текст = Имеющийся + Символы.ПС + Символы.ПС + Текст;
	КонецЕсли;
	Разделы.Вставить(ИмяРаздела, Текст);

КонецПроцедуры

#КонецОбласти
