#Область СлужебныйПрограммныйИнтерфейс

// Описания инструментов и инструкции для модели из макета ИИО_ОписанияИнструментов
// и макетов <Префикс>_ОписанияИнструментов пакетов (см. ИИО_Пакеты).
// Раздел макета начинается строкой «## <имя>»: имя инструмента или instructions.
// Раздел instructions пакета дописывается к инструкциям ядра.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - Имя раздела.
//   * Значение - Строка - Текст раздела.
Функция ОписанияИнструментов() Экспорт

	Возврат ИИО_РеестрИнструментов.РазделыОписаний("ИИО_ОписанияИнструментов", "_ОписанияИнструментов");

КонецФункции

// Клиентские модули пакетов, которые регистрируют инструменты (см. ИИО_Пакеты).
//
// Возвращаемое значение:
//  Массив из Строка
Функция МодулиПакетов() Экспорт

	Возврат ИИО_Пакеты.КлиентскиеМодули();

КонецФункции

// Все серверные данные для построения клиентского реестра за один вызов.
//
// Возвращаемое значение:
//  Структура:
//   * Описания - см. ОписанияИнструментов
//   * МодулиПакетов - см. МодулиПакетов
//   * ДействияПакетов - Массив из Структура - Действия пакетов для схемы perform (см. ИИО_Действия.ДействияПакетов):
//     ** Код - Строка
//     ** Представление - Строка
Функция ДанныеРеестра() Экспорт

	ДействияПакетов = Новый Массив;
	Для Каждого Описание Из ИИО_Действия.ДействияПакетов() Цикл
		ДействияПакетов.Добавить(Новый Структура("Код, Представление", Описание.Код, Описание.Представление));
	КонецЦикла;
	Данные = Новый Структура;
	Данные.Вставить("Описания", ОписанияИнструментов());
	Данные.Вставить("МодулиПакетов", МодулиПакетов());
	Данные.Вставить("ДействияПакетов", ДействияПакетов);
	Возврат Данные;

КонецФункции

// Выполняет встроенный инструмент канала MCP без работы на клиенте тем же серверным обработчиком,
// что в канале бота (ИИО_ИнструментыБота.ВыполнитьИнструмент). Выполняются только инструменты, у которых
// в определении клиентский обработчик ИИО_ИнструментыКлиент.ВыполнитьНаСервере; другие имена - нет.
//
// Параметры:
//  ИмяИнструмента - Строка
//  Аргументы - Структура, Соответствие - Аргументы без токенов.
//
// Возвращаемое значение:
//  Структура, Соответствие - Ответ для модели до маскирования или ошибка NOT_FOUND, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция ВыполнитьИнструмент(Знач ИмяИнструмента, Знач Аргументы) Экспорт

	Для Каждого Определение Из ИИО_ИнструментыКлиентСервер.Определения() Цикл
		Если Определение.Имя = ИмяИнструмента
			И Определение.ОбработчикКлиента = "ИИО_ИнструментыКлиент.ВыполнитьНаСервере" Тогда
			Возврат ИИО_ИнструментыБота.ВыполнитьИнструмент(ИмяИнструмента, Аргументы, Неопределено);
		КонецЕсли;
	КонецЦикла;
	Возврат ИИО_ИнструментыКлиентСервер.ОшибкаНетИнструмента(ИмяИнструмента);

КонецФункции

#КонецОбласти
