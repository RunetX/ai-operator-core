// Инструмент explain_error: почему документ не проводится и какие ошибки пользователь видел недавно.
// Основной источник - пробное проведение с правами пользователя: проверка заполнения и проведение в транзакции,
// которая всегда отменяется. Сообщения о незаполненном поле, нехватке остатка и дате запрета типовая выводит
// пользователю, а в журнал регистрации они не попадают, поэтому журнал - второй источник: ошибки самого
// пользователя в его клиентских сеансах за последние минуты.
// Тексты ошибок называют людей (пользователь в тексте даты запрета, физлицо в представлении документа): модели
// они уходят токенами, см. КонтекстПДн.

#Область СлужебныйПрограммныйИнтерфейс

// Разбирает ошибку пользователя по документу и журналу регистрации.
//
// Параметры:
//  Аргументы - Структура, Соответствие - ref, minutes.
//  СсылкаФормы - Произвольный - Документ из активного окна пользователя (канал MCP), если ref не задан.
//  ФормаИзменена - Булево - В форме документа есть незаписанные изменения.
//
// Возвращаемое значение:
//  Структура - Ошибка для модели или ответ после ИИО_Ответ.ДанныеДляМодели:
//   * object - Структура - Документ {ref, presentation}, если он задан.
//   * posted - Булево - Документ проведен.
//   * check - Структура - Итог пробного проведения, см. ПробноеПроведение.
//   * unsaved_changes - Булево - В форме есть незаписанные изменения: проверен записанный документ.
//   * journal - Массив из Структура - Ошибки пользователя в журнале регистрации: date, event, object, text.
//   * hint - Строка - Что делать модели.
//   * pii_context - Массив - Люди из текстов ошибок: модели не уходят, пополняют словарь, см. КонтекстПДн.
Функция РазобратьОшибку(Аргументы, СсылкаФормы = Неопределено, ФормаИзменена = Ложь) Экспорт

	Минут = ИИО_ОтветКлиентСервер.ЦелоеВПределах(ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "minutes"),
		МинутПоУмолчанию(), МаксимумМинут());
	Ссылка = Неопределено;
	Идентификатор = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "ref");
	// Из окна приходит и ключ записи регистра (текущая строка списка регистра): проверяются только ссылки.
	ИзФормы = Не ЗначениеЗаполнено(Идентификатор) И ЗначениеЗаполнено(СсылкаФормы)
		И ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СсылкаФормы));
	Если ИзФормы Тогда
		Идентификатор = ИИО_Ответ.СсылкаВСтроку(СсылкаФормы);
	КонецЕсли;
	Если ЗначениеЗаполнено(Идентификатор) Тогда
		Ссылка = ДокументДляПроверки(Идентификатор);
		Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;

	// Журнал читается до пробного проведения: его ошибки - то, что пользователь видел, а не результат проверки.
	Журнал = ОшибкиЖурнала(ТекущаяДатаСеанса() - Минут * 60);
	Ответ = Новый Структура;
	Тексты = Новый Массив;
	Объекты = Новый Массив;
	Если Ссылка <> Неопределено Тогда
		Проверка = ПробноеПроведение(Ссылка);
		Ответ.Вставить("object", Ссылка);
		Ответ.Вставить("posted", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Проведен"));
		Ответ.Вставить("check", Проверка);
		Если ИзФормы И ФормаИзменена Тогда
			Ответ.Вставить("unsaved_changes", Истина);
		КонецЕсли;
		Объекты.Добавить(Ссылка);
		ДобавитьТекстыПроверки(Тексты, Проверка);
	КонецЕсли;
	Ответ.Вставить("journal", Журнал.Ошибки);
	Ответ.Вставить("hint", Подсказка(Ответ, Минут));
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Объекты, Журнал.Объекты, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Тексты, Журнал.Тексты);
	Ответ.Вставить(ИмяКонтекстаПДн(), КонтекстПДн(Объекты, Тексты));
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проводимый документ, доступный пользователю.
//
// Параметры:
//  Идентификатор - Произвольный - ref от модели или из формы.
//
// Возвращаемое значение:
//  ДокументСсылка, Структура - Ссылка или ошибка для модели.
Функция ДокументДляПроверки(Идентификатор)

	Открытие = ИИО_ПоказВызовСервера.ПодготовитьОткрытие(Новый Структура("ref", Идентификатор));
	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Открытие) Тогда
		Возврат Открытие;
	КонецЕсли;
	МетаданныеОбъекта = Открытие.Ссылка.Метаданные();
	Если Не Метаданные.Документы.Содержит(МетаданныеОбъекта)
		Или МетаданныеОбъекта.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = '%1 - не проводимый документ: пробное проведение невозможно.'"),
				МетаданныеОбъекта.ПолноеИмя()),
			НСтр("ru = 'Вызови explain_error без ref, чтобы посмотреть ошибки пользователя в журнале, или передай документ.'"));
	КонецЕсли;
	Возврат Открытие.Ссылка;

КонецФункции

// Пробное проведение как при интерактивном: проверка заполнения, затем запись с проведением в транзакции,
// которая отменяется всегда. Документ, движения, регистрация изменений для обменов и номер не меняются
//. Выполняется с правами пользователя, без привилегированного режима.
//
// Параметры:
//  Ссылка - ДокументСсылка
//
// Возвращаемое значение:
//  Структура:
//   * result - Строка - ok (проводится), not_filled (не прошел проверку заполнения), failed (ошибка проведения),
//     denied (нет права проводить), deleted (помечен на удаление).
//   * messages - Массив из Структура - Сообщения 1С: text и, если 1С его указала, field - поле документа.
//   * error - Строка - Текст ошибки 1С, если он не повторяет сообщения.
Функция ПробноеПроведение(Ссылка)

	Итог = Новый Структура("result, messages", "ok", Новый Массив);
	МетаданныеДокумента = Ссылка.Метаданные();
	Если Не ПравоДоступа("Проведение", МетаданныеДокумента) Тогда
		Итог.result = "denied";
		Итог.Вставить("error", СтрШаблон(НСтр("ru = 'У пользователя нет права проводить документы «%1».'"),
			МетаданныеДокумента.Представление()));
		Возврат Итог;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект.ПометкаУдаления Тогда
		Итог.result = "deleted";
		Итог.Вставить("error", НСтр("ru = 'Документ помечен на удаление: провести его можно после снятия пометки.'"));
		Возврат Итог;
	КонецЕсли;

	ПолучитьСообщенияПользователю(Истина);
	Если Не Объект.ПроверитьЗаполнение() Тогда
		Итог.result = "not_filled";
		ДобавитьСообщения(Итог);
		Возврат Итог;
	КонецЕсли;

	Ошибка = Неопределено;
	НачатьТранзакцию();
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение, ИИО_ДействияПроведение.РежимПроведения(Объект));
		// Проведение пробное: удачное тоже отменяется.
		ОтменитьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Ошибка = ИнформацияОбОшибке();
		// Модели уходит текст для пользователя, а подробности - администратору. Событие ИИ-оператора разбор
		// ошибок из журнала не берет.
		ИИО_Журнал.ЗаписатьСобытие("РазборОшибки.ПробноеПроведение", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("error", ОбработкаОшибок.ПодробноеПредставлениеОшибки(Ошибка)), Ссылка);
	КонецПопытки;
	ДобавитьСообщения(Итог);
	Если Ошибка <> Неопределено Тогда
		Итог.result = "failed";
		Текст = СокрЛП(Строка(ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(Ошибка)));
		Если Не ЕстьСообщение(Итог.messages, Текст) Тогда
			Итог.Вставить("error", ИИО_ОтветКлиентСервер.Обрезать(Текст, МаксимумСимволов()));
		КонецЕсли;
	КонецЕсли;
	Возврат Итог;

КонецФункции

Процедура ДобавитьСообщения(Итог)

	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Текст = ИИО_ОтветКлиентСервер.Обрезать(СокрЛП(Сообщение.Текст), МаксимумСимволов());
		Если Не ЗначениеЗаполнено(Текст) Или ЕстьСообщение(Итог.messages, Текст)
			Или Итог.messages.Количество() >= МаксимумСообщений() Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Новый Структура("text", Текст);
		Если ЗначениеЗаполнено(Сообщение.Поле) Тогда
			Элемент.Вставить("field", Сообщение.Поле);
		КонецЕсли;
		Итог.messages.Добавить(Элемент);
	КонецЦикла;

КонецПроцедуры

Функция ЕстьСообщение(Сообщения, Текст)

	Для Каждого Сообщение Из Сообщения Цикл
		Если Сообщение.text = Текст Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ошибки пользователя в журнале регистрации.
//
// Параметры:
//  Начало - Дата
//
// Возвращаемое значение:
//  Структура:
//   * Ошибки - Массив из Структура - date, event, object, text.
//   * Объекты - Массив из ЛюбаяСсылка - Ссылки из данных событий.
//   * Тексты - Массив из Строка - Тексты событий.
Функция ОшибкиЖурнала(Начало)

	Результат = Новый Структура("Ошибки, Объекты, Тексты", Новый Массив, Новый Массив, Новый Массив);
	События = ИИО_Журнал.ОшибкиПользователя(Начало, МаксимумСобытий());
	Ссылки = Новый Массив;
	Для Каждого Событие Из События Цикл
		Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Событие.Данные)) И ЗначениеЗаполнено(Событие.Данные) Тогда
			Ссылки.Добавить(Событие.Данные);
		КонецЕсли;
	КонецЦикла;
	// Журнал прочитан привилегированно, а событие могла записать типовая из привилегированного кода:
	// ссылка уходит модели, только если объект доступен пользователю, иначе - только вид объекта.
	Доступные = ДоступныеСсылки(Ссылки);

	Для Каждого Событие Из События Цикл
		Ошибка = Новый Структура;
		Ошибка.Вставить("date", Событие.Дата);
		Ошибка.Вставить("event", Событие.Событие);
		Если Доступные.Получить(Событие.Данные) <> Неопределено Тогда
			Ошибка.Вставить("object", Событие.Данные);
			Результат.Объекты.Добавить(Событие.Данные);
		ИначеЕсли Ссылки.Найти(Событие.Данные) <> Неопределено Тогда
			Ошибка.Вставить("object", Событие.Данные.Метаданные().Представление());
		ИначеЕсли ЗначениеЗаполнено(Событие.ПредставлениеДанных) Тогда
			Ошибка.Вставить("object", Событие.ПредставлениеДанных);
			Результат.Тексты.Добавить(Событие.ПредставлениеДанных);
		КонецЕсли;
		Ошибка.Вставить("text", ИИО_ОтветКлиентСервер.Обрезать(СокрЛП(Событие.Комментарий), МаксимумСимволов()));
		Результат.Тексты.Добавить(Ошибка.text);
		Результат.Ошибки.Добавить(Ошибка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ссылки, доступные пользователю: право чтения вида объекта и ограничение на уровне записей. Один запрос
// по всем видам, без привилегированного режима.
//
// Параметры:
//  Ссылки - Массив из ЛюбаяСсылка
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ЛюбаяСсылка - Доступная ссылка.
//   * Значение - Булево - Истина.
Функция ДоступныеСсылки(Ссылки)

	Доступные = Новый Соответствие;
	ПоВидам = Новый Соответствие;
	Для Каждого Ссылка Из Ссылки Цикл
		ОбъектМетаданных = Ссылка.Метаданные();
		Если Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Если ПоВидам.Получить(ПолноеИмя) = Неопределено Тогда
			ПоВидам.Вставить(ПолноеИмя, Новый Массив);
		КонецЕсли;
		ПоВидам.Получить(ПолноеИмя).Добавить(Ссылка);
	КонецЦикла;
	Если ПоВидам.Количество() = 0 Тогда
		Возврат Доступные;
	КонецЕсли;

	ШаблонЧасти =
	"ВЫБРАТЬ
	|	ДанныеОбъекта.Ссылка КАК Ссылка
	|ИЗ
	|	#Таблица КАК ДанныеОбъекта
	|ГДЕ
	|	ДанныеОбъекта.Ссылка В (&Ссылки)";
	Запрос = Новый Запрос;
	Части = Новый Массив;
	Для Каждого КлючИЗначение Из ПоВидам Цикл
		ИмяПараметра = "Ссылки" + Формат(Части.Количество(), "ЧН=0; ЧГ=0");
		Часть = СтрЗаменить(СтрЗаменить(ШаблонЧасти, "#Таблица", КлючИЗначение.Ключ), "&Ссылки", "&" + ИмяПараметра);
		// РАЗРЕШЕННЫЕ указывается в первом запросе объединения и действует на все.
		Если Части.Количество() = 0 Тогда
			Часть = СтрЗаменить(Часть, "ВЫБРАТЬ", "ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		КонецЕсли;
		Части.Добавить(Часть);
		Запрос.УстановитьПараметр(ИмяПараметра, КлючИЗначение.Значение);
	КонецЦикла;
	Запрос.Текст = СтрСоединить(Части, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Доступные.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Доступные;

КонецФункции

Процедура ДобавитьТекстыПроверки(Тексты, Проверка)

	Для Каждого Сообщение Из Проверка.messages Цикл
		Тексты.Добавить(Сообщение.text);
	КонецЦикла;
	Если Проверка.Свойство("error") Тогда
		Тексты.Добавить(Проверка.error);
	КонецЕсли;

КонецПроцедуры

// ПДн в текстах ошибок: люди из реквизитов документов и текущий пользователь (ИИО_Маскирование.КонтекстПДн),
// а также люди, которых нашло маскирование ввода, - так же, как в вопросе пользователя: в журнале
// и в сообщениях бывают люди, которых нет в реквизитах документа.
//
// Параметры:
//  Объекты - Массив из ЛюбаяСсылка
//  Тексты - Массив из Строка
//
// Возвращаемое значение:
//  Массив из ЛюбаяСсылка, Структура - Ссылки и значения {"pii", "value"}.
Функция КонтекстПДн(Объекты, Тексты)

	Контекст = ИИО_Маскирование.КонтекстПДн(Объекты);
	Текст = СтрСоединить(Тексты, Символы.ПС);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Контекст;
	КонецЕсли;
	// Люди из контекста скрываются до маскирования ввода: их не видит и локальная модель маскирования.
	Словарь = ИИО_МаскированиеКлиентСервер.НовыйСловарь();
	ИИО_МаскированиеКлиентСервер.Замаскировать(
		ИИО_Ответ.ДанныеДляМодели(Новый Структура(ИмяКонтекстаПДн(), Контекст)), Словарь);
	Ввод = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Текст, Словарь);
	Для Каждого Замена Из Ввод.Замены Цикл
		// Токен вида [ФИО#1]: вид ПДн - между скобкой и решеткой. Замены по словарю - это уже контекст.
		Вид = Сред(Замена.Токен, 2, СтрНайти(Замена.Токен, "#") - 2);
		Если ЗначениеЗаполнено(Вид) И Замена.Источник <> "словарь и шаблоны" Тогда
			Контекст.Добавить(Новый Структура("pii, value", Вид, Замена.Фрагмент));
		КонецЕсли;
	КонецЦикла;
	Возврат Контекст;

КонецФункции

Функция Подсказка(Ответ, Минут)

	Части = Новый Массив;
	Если Не Ответ.Свойство("check") Тогда
		Части.Добавить(НСтр("ru = 'Документ не задан, и в активном окне 1С его нет. Если ошибка про документ, спроси, какой, или найди его через find_ref и вызови explain_error с ref.'"));
	ИначеЕсли Ответ.check.result = "ok" Тогда
		Части.Добавить(НСтр("ru = 'Пробное проведение прошло без ошибок: сейчас документ проводится. Провести его можно через perform.'"));
	ИначеЕсли Ответ.check.result = "not_filled" Или Ответ.check.result = "failed" Тогда
		Части.Добавить(НСтр("ru = 'Объясни причину простыми словами по messages и error: какое поле заполнить, какого товара не хватает, какая дата запрета. Исправляет пользователь в документе, после исправления провести можно через perform.'"));
	КонецЕсли;
	Если Ответ.Свойство("check") Тогда
		Части.Добавить(НСтр("ru = 'Проведение было пробным: документ не изменен.'"));
	КонецЕсли;
	Если Ответ.journal.Количество() = 0 Тогда
		Части.Добавить(СтрШаблон(НСтр("ru = 'В журнале регистрации ошибок пользователя за %1 мин нет.'"), Минут));
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");

КонецФункции

