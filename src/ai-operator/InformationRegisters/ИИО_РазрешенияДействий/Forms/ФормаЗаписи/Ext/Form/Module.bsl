// Разрешение действия ИИ-оператора пользователю или группе. Действие выбирается из действий ядра
// и пакетов (ИИО_Права.РазрешаемыеДействия), а не вводится кодом.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Для Каждого КлючИЗначение Из ИИО_Права.РазрешаемыеДействия() Цикл
		Элементы.Действие.СписокВыбора.Добавить(КлючИЗначение.Ключ,
			СтрШаблон("%1 (%2)", КлючИЗначение.Значение, КлючИЗначение.Ключ));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
