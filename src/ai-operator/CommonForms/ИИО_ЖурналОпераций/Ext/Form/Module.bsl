// Журнал операций ИИ-оператора: пакеты действий из журнала регистрации, результаты по объектам
// и откат пакета через тот же предпросмотр, что у инструмента undo.
// Пользователь видит свои пакеты, администратор ИИ-оператора - пакеты всех пользователей.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - 6 * 86400);
	Период.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	Элементы.ВсеПользователи.Видимость = ИИО_Права.ЭтоАдминистраторИИОператора();
	ЗаполнитьПакеты();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ЗаполнитьПакеты();

КонецПроцедуры

&НаКлиенте
Процедура ВсеПользователиПриИзменении(Элемент)

	ЗаполнитьПакеты();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПакеты

&НаКлиенте
Процедура ПакетыПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьОбъектыПакета", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбъектыПакетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ОбъектыПакета.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьПакеты();

КонецПроцедуры

&НаКлиенте
Процедура ОткатитьПакет(Команда)

	ТекущиеДанные = Элементы.Пакеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ТекущиеДанные.МожноОткатить Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В этом пакете нет изменений, которые можно откатить.'"));
		Возврат;
	КонецЕсли;
	ИИО_ДействияКлиент.ОткатитьПакет(ТекущиеДанные.Пакет, Новый ОписаниеОповещения("ПослеОтката", ЭтотОбъект));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеОтката(Ответ, ДополнительныеПараметры) Экспорт

	Если ИИО_ОтветКлиентСервер.ЭтоОшибка(Ответ) Тогда
		Подсказка = "";
		Ответ.error.Свойство("hint", Подсказка);
		ПоказатьПредупреждение(, СокрЛП(Ответ.error.message + Символы.ПС + Подсказка));
	КонецЕсли;
	ЗаполнитьПакеты();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОбъектыПакета()

	ТекущиеДанные = Элементы.Пакеты.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ОбъектыПакета.Очистить();
		ТекущийПакет = "";
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Пакет = ТекущийПакет Тогда
		Возврат;
	КонецЕсли;
	ТекущийПакет = ТекущиеДанные.Пакет;
	ЗаполнитьОбъектыПакета(ТекущиеДанные.Пакет, ТекущиеДанные.Дата);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПакеты()

	Пакеты.Очистить();
	ОбъектыПакета.Очистить();
	ТекущийПакет = "";
	Действия = ИИО_Действия.Действия();
	Для Каждого Пакет Из ИИО_Журнал.ПакетыЗаПериод(Период.ДатаНачала, Период.ДатаОкончания, ВсеПользователи) Цикл
		Строка = Пакеты.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Пакет, "Дата, Пользователь, Объектов, Выполнено, Ошибок, Пропущено, Пакет");
		Строка.Действие = ПредставлениеДействия(Пакет.Действие, Действия);
		Строка.Состояние = ПредставлениеСостояния(Пакет.Состояние);
		Строка.Источник = ПредставлениеИсточника(Пакет.Источник);
		Строка.МожноОткатить = Пакет.Неоткачено > 0;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыПакета(Знач Пакет, Знач ДатаПакета)

	ОбъектыПакета.Очистить();
	Действия = ИИО_Действия.Действия();
	Для Каждого Объект Из ИИО_Журнал.ОбъектыПакета(Пакет, ДатаПакета) Цикл
		Строка = ОбъектыПакета.Добавить();
		Строка.Объект = Объект.Объект;
		Строка.Действие = ПредставлениеДействия(Объект.Действие, Действия);
		Строка.Результат = ?(Объект.Результат = "done", НСтр("ru = 'Выполнено'"), НСтр("ru = 'Ошибка'"));
		Строка.Ошибка = Объект.Ошибка;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредставлениеДействия(Код, Действия)

	Если Код = "undo" Тогда
		Возврат НСтр("ru = 'Откат пакета'");
	КонецЕсли;
	Описание = Действия.Получить(Код);
	Возврат ?(Описание = Неопределено, Код, Описание.Представление);

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеСостояния(Состояние)

	Если Состояние = "completed" Тогда
		Возврат НСтр("ru = 'Выполнен'");
	ИначеЕсли Состояние = "cancelled" Тогда
		Возврат НСтр("ru = 'Отменен'");
	ИначеЕсли Состояние = "undone" Тогда
		Возврат НСтр("ru = 'Откачен'");
	КонецЕсли;
	Возврат НСтр("ru = 'Не завершен'");

КонецФункции

&НаСервереБезКонтекста
Функция ПредставлениеИсточника(Источник)

	Если Источник = "mcp" Тогда
		Возврат НСтр("ru = 'Чат (MCP)'");
	ИначеЕсли Источник = "journal" Тогда
		Возврат НСтр("ru = 'Журнал операций'");
	КонецЕсли;
	Возврат Источник;

КонецФункции

#КонецОбласти
