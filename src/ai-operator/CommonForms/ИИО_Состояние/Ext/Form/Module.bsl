// Состояние ИИ-оператора (этап 3д, Р-2): все проверки на одном экране со статусом, причиной и подсказкой,
// а где это безопасно - с действием. Серверные проверки - ИИО_Диагностика, клиентские - ИИО_ДиагностикаКлиент.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Порт = ИИО_Настройки.Значение("ИИО_ПортMCP");
	Для Каждого КлючИЗначение Из ИИО_Диагностика.Группы() Цикл
		ГруппыПроверок.Добавить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	ЗаполнитьСерверныеПроверки(Проверки, ГруппыПроверок, ИИО_Диагностика.Проверки());
	НастроитьОформление();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Серверные проверки уже в таблице: их заполнило создание формы.
	Элементы.Итог.Заголовок = НСтр("ru = 'Проверка...'");
	ДобавитьКлиентскиеПроверки();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроверки

&НаКлиенте
Процедура ПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = Проверки.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Строка <> Неопределено И ЗначениеЗаполнено(Строка.Действие) Тогда
		ВыполнитьДействиеСтроки(Строка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьПроверки();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	Строка = Элементы.Проверки.ТекущиеДанные;
	Если Строка = Неопределено Или Не ЗначениеЗаполнено(Строка.Действие) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите проверку с действием в колонке «Исправить».'"));
		Возврат;
	КонецЕсли;
	ВыполнитьДействиеСтроки(Строка);

КонецПроцедуры

&НаКлиенте
Асинх Процедура НастройкиClaudeCode(Команда)

	Файлы = Ждать ФайлыКлиентов();
	Если Файлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сервер = Новый Структура;
	Сервер.Вставить("type", "http");
	Сервер.Вставить("url", АдресСервера());
	Сервер.Вставить("headersHelper", Файлы.headersHelper);
	Текст = НСтр("ru = 'Сохраните в файл .mcp.json в папке проекта Claude Code. Токен в настройки не попадает:
		|заголовок авторизации печатает скрипт, он читает токен из файла.'") + Символы.ПС + Символы.ПС
		+ НастройкиСервера(Сервер);
	ПоказатьТекст(Текст, НСтр("ru = 'Настройки для Claude Code'"));

КонецПроцедуры

&НаКлиенте
Асинх Процедура НастройкиClaudeDesktop(Команда)

	Файлы = Ждать ФайлыКлиентов();
	Если Файлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Сервер = Новый Структура;
	Сервер.Вставить("command", Файлы.bridge);
	Сервер.Вставить("args", Новый Массив);
	Текст = НСтр("ru = 'Добавьте в claude_desktop_config.json (Claude Desktop) или mcp.json (LM Studio). Нужен Node.js:
		|мост запускает npx mcp-remote. Токен в настройки не попадает: мост читает его из файла.'") + Символы.ПС
		+ Символы.ПС + НастройкиСервера(Сервер);
	ПоказатьТекст(Текст, НСтр("ru = 'Настройки для Claude Desktop и LM Studio'"));

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьОтчет(Команда)

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Состояние ИИ-оператора на %1'"), Формат(ОбщегоНазначенияКлиент.ДатаСеанса(), "ДЛФ=DT")));
	Для Каждого Строка Из Проверки Цикл
		Строки.Добавить(СтрШаблон("[%1] %2 / %3: %4", Строка.СостояниеПредставление, Строка.ГруппаПредставление,
			Строка.Заголовок, СтрЗаменить(Строка.Описание, Символы.ПС, " ")));
	КонецЦикла;
	ПоказатьТекст(СтрСоединить(Строки, Символы.ПС), НСтр("ru = 'Отчет для поддержки'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пересчитывает все проверки.
//
// Параметры:
//  Серверные - Массив из см. ИИО_Диагностика.НоваяПроверка - Уже полученные с сервера вместе с действием;
//            - Неопределено - Получить заново.
&НаКлиенте
Асинх Процедура ОбновитьПроверки(Серверные = Неопределено)

	Элементы.Итог.Заголовок = НСтр("ru = 'Проверка...'");
	// После пересчета курсор остается на той же проверке: по ней обычно и нажимают «Исправить» следующей.
	ТекущаяСтрока = Элементы.Проверки.ТекущиеДанные;
	КодТекущей = ?(ТекущаяСтрока = Неопределено, "", ТекущаяСтрока.Код);
	Если Серверные = Неопределено Тогда
		Серверные = ИИО_ДиагностикаВызовСервера.Проверки();
	КонецЕсли;
	Клиентские = Ждать ИИО_ДиагностикаКлиент.Проверки(Порт);
	ЗаполнитьСерверныеПроверки(Проверки, ГруппыПроверок, Серверные);
	ДобавитьПроверки(Клиентские, КодТекущей);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ДобавитьКлиентскиеПроверки()

	Клиентские = Ждать ИИО_ДиагностикаКлиент.Проверки(Порт);
	ДобавитьПроверки(Клиентские, "");

КонецПроцедуры

// Добавляет клиентские проверки к серверным и показывает итог.
//
// Параметры:
//  Клиентские - Массив из см. ИИО_Диагностика.НоваяПроверка
//  КодТекущей - Строка - Проверка, на которую вернуть курсор.
&НаКлиенте
Процедура ДобавитьПроверки(Клиентские, КодТекущей)

	Для Каждого Проверка Из Клиентские Цикл
		ДобавитьСтроку(Проверки, ГруппыПроверок, Проверка);
	КонецЦикла;
	Проверки.Сортировать("Порядок");
	Найденные = Проверки.НайтиСтроки(Новый Структура("Код", КодТекущей));
	Если Найденные.Количество() > 0 Тогда
		Элементы.Проверки.ТекущаяСтрока = Найденные[0].ПолучитьИдентификатор();
	КонецЕсли;
	ПоказатьИтог();

КонецПроцедуры

// Заменяет строки таблицы серверными проверками.
//
// Параметры:
//  Таблица - ДанныеФормыКоллекция - Реквизит Проверки.
//  Группы - СписокЗначений - Реквизит ГруппыПроверок.
//  Серверные - Массив из см. ИИО_Диагностика.НоваяПроверка
&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСерверныеПроверки(Таблица, Группы, Серверные)

	Таблица.Очистить();
	Для Каждого Проверка Из Серверные Цикл
		ДобавитьСтроку(Таблица, Группы, Проверка);
	КонецЦикла;

КонецПроцедуры

// Строка таблицы проверок: порядок - по группе, внутри группы - по порядку добавления.
//
// Параметры:
//  Таблица - ДанныеФормыКоллекция - Реквизит Проверки.
//  Группы - СписокЗначений - Реквизит ГруппыПроверок.
//  Проверка - см. ИИО_Диагностика.НоваяПроверка
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьСтроку(Таблица, Группы, Проверка)

	Строка = Таблица.Добавить();
	ЗаполнитьЗначенияСвойств(Строка, Проверка);
	Группа = Группы.НайтиПоЗначению(Проверка.Группа);
	Если Группа = Неопределено Тогда
		Строка.ГруппаПредставление = Проверка.Группа;
		НомерГруппы = Группы.Количество();
	Иначе
		Строка.ГруппаПредставление = Группа.Представление;
		НомерГруппы = Группы.Индекс(Группа);
	КонецЕсли;
	Строка.Порядок = (НомерГруппы + 1) * 1000 + Таблица.Количество();
	ЗаполнитьПредставление(Строка, Проверка);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьПредставление(Строка, Проверка)

	Строка.Статус = Проверка.Статус;
	Если Проверка.Статус = "ok" Тогда
		Строка.СостояниеПредставление = НСтр("ru = 'Ок'");
	ИначеЕсли Проверка.Статус = "warning" Тогда
		Строка.СостояниеПредставление = НСтр("ru = 'Внимание'");
	ИначеЕсли Проверка.Статус = "error" Тогда
		Строка.СостояниеПредставление = НСтр("ru = 'Ошибка'");
	Иначе
		Строка.СостояниеПредставление = "-";
	КонецЕсли;
	Строка.Описание = Проверка.Текст;
	Если ЗначениеЗаполнено(Проверка.Подсказка) Тогда
		Строка.Описание = Строка.Описание + Символы.ПС + НСтр("ru = 'Что сделать: '") + Проверка.Подсказка;
	КонецЕсли;
	Строка.Действие = Проверка.Действие;
	Строка.ДействиеПредставление = ПредставлениеДействия(Проверка.Действие);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИтог()

	Ошибок = Проверки.НайтиСтроки(Новый Структура("Статус", "error")).Количество();
	Предупреждений = Проверки.НайтиСтроки(Новый Структура("Статус", "warning")).Количество();
	Если Ошибок = 0 И Предупреждений = 0 Тогда
		Элементы.Итог.Заголовок = НСтр("ru = 'Все в порядке.'");
	Иначе
		Элементы.Итог.Заголовок = СтрШаблон(
			НСтр("ru = 'Ошибок: %1, предупреждений: %2. Двойной щелчок по строке с действием исправляет.'"),
			Ошибок, Предупреждений);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеДействия(Действие)

	Если Действие = "start" Тогда
		Возврат НСтр("ru = 'Запустить'");
	ИначеЕсли Действие = "create_token" Тогда
		Возврат НСтр("ru = 'Создать токен'");
	ИначеЕсли Действие = "enable_log" Тогда
		Возврат НСтр("ru = 'Включить'");
	ИначеЕсли Действие = "test_model" Тогда
		Возврат НСтр("ru = 'Проверить модель'");
	ИначеЕсли ЗначениеЗаполнено(Действие) Тогда
		// Действие пакета: <Модуль>.<код>, представление дает сам пакет после двоеточия.
		Части = СтрРазделить(Действие, ":");
		Возврат ?(Части.Количество() > 1, Части[1], НСтр("ru = 'Выполнить'"));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Асинх Процедура ВыполнитьДействиеСтроки(Строка)

	Действие = Строка.Действие;
	Если Действие = "start" Тогда
		ИИО_СерверMCPКлиент.Запустить();
		ПодключитьОбработчикОжидания("ОбновитьПослеДействия", 5, Истина);
	ИначеЕсли Действие = "create_token" Тогда
		Создан = Ждать СоздатьТокен();
		Если Создан Тогда
			ОбновитьПроверки();
		КонецЕсли;
	ИначеЕсли Действие = "enable_log" Тогда
		Результат = ИИО_ДиагностикаВызовСервера.ВключитьЖурнал();
		Если Не Результат.ok Тогда
			ПоказатьПредупреждение(, Результат.error);
		КонецЕсли;
		ОбновитьПроверки(Результат.Проверки);
	ИначеЕсли Действие = "test_model" Тогда
		Назначение = ?(Строка.Код = "model.masking", "маскирование", "агент");
		Элементы.Итог.Заголовок = НСтр("ru = 'Запрос к модели...'");
		Проверка = ИИО_ДиагностикаВызовСервера.ПроверитьМодель(Назначение);
		ЗаполнитьПредставление(Строка, Проверка);
		ПоказатьИтог();
	Иначе
		Результат = ИИО_ДиагностикаВызовСервера.ВыполнитьДействиеПакета(СтрРазделить(Действие, ":")[0]);
		ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор'"), , Результат.Текст);
		ОбновитьПроверки(Результат.Проверки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПослеДействия()

	ОбновитьПроверки();

КонецПроцедуры

// Новый токен. Существующий заменяется только после вопроса: у настроенных клиентов старый перестанет работать.
//
// Возвращаемое значение:
//  Обещание - Результат Булево: Истина, если токен создан.
&НаКлиенте
Асинх Функция СоздатьТокен()

	Компонента = Ждать ИИО_ТранспортMCPКлиент.КомпонентаБезУстановки();
	Если Компонента = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала нажмите «Запустить»: 1С установит компоненту MCP-транспорта.'"));
		Возврат Ложь;
	КонецЕсли;
	Результат = Ждать ИИО_ТранспортMCPКлиент.СоздатьТокен(Компонента, Ложь);
	Если Не Результат.ok И Результат.code = "EXISTS" Тогда
		Вопрос = НСтр("ru = 'Токен уже есть. Заменить его? У MCP-клиентов, настроенных со старым токеном,
			|подключение перестанет работать, пока они не прочитают новый.'");
		Ответ = Ждать ВопросАсинх(Вопрос, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат Ложь;
		КонецЕсли;
		Результат = Ждать ИИО_ТранспортMCPКлиент.СоздатьТокен(Компонента, Истина);
	КонецЕсли;
	Если Не Результат.ok Тогда
		ПоказатьПредупреждение(, Результат.error);
		Возврат Ложь;
	КонецЕсли;
	Текст = НСтр("ru = 'Токен создан. Если ИИ-оператор уже запущен, остановите его и запустите снова.'");
	Если Не (ТипЗнч(Результат.active) = Тип("Булево") И Результат.active) Тогда
		Текст = Текст + " " + НСтр("ru = 'Но сейчас действует токен из переменной окружения AI_OPERATOR_MCP_TOKEN.'");
	КонецЕсли;
	ПоказатьОповещениеПользователя(НСтр("ru = 'ИИ-оператор'"), , Текст);
	Возврат Истина;

КонецФункции

// Скрипты для настроек MCP-клиентов, см. ИИО_ТранспортMCPКлиент.ПодготовитьФайлыКлиентов.
//
// Возвращаемое значение:
//  Обещание - Результат Структура - headersHelper и bridge; Неопределено, если подготовить не удалось.
&НаКлиенте
Асинх Функция ФайлыКлиентов()

	Компонента = Ждать ИИО_ТранспортMCPКлиент.КомпонентаБезУстановки();
	Если Компонента = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Сначала нажмите «Запустить»: 1С установит компоненту MCP-транспорта.'"));
		Возврат Неопределено;
	КонецЕсли;
	Результат = Ждать ИИО_ТранспортMCPКлиент.ПодготовитьФайлыКлиентов(Компонента, Порт);
	Если Не Результат.ok Тогда
		ПоказатьПредупреждение(, Результат.error);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция АдресСервера()

	Возврат СтрШаблон("http://127.0.0.1:%1/mcp", Формат(Порт, "ЧГ=0"));

КонецФункции

// Настройки одного MCP-сервера в формате клиентов: {"mcpServers": {"onec": ...}}.
//
// Параметры:
//  Сервер - Структура
//
// Возвращаемое значение:
//  Строка
&НаКлиенте
Функция НастройкиСервера(Сервер)

	Серверы = Новый Структура("onec", Сервер);
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  "));
	ЗаписатьJSON(Запись, Новый Структура("mcpServers", Серверы));
	Возврат Запись.Закрыть();

КонецФункции

// Показывает текст, который можно выделить и скопировать: в режиме совместимости 8.3.20 буфера обмена нет.
//
// Параметры:
//  Текст - Строка
//  Заголовок - Строка
&НаКлиенте
Асинх Процедура ПоказатьТекст(Текст, Заголовок)

	// ПоказатьВводСтроки требует описание оповещения: с Неопределено первым параметром окно не открывается.
	Ждать ВвестиСтрокуАсинх(Текст, Заголовок, 0, Истина);

КонецПроцедуры

&НаСервере
Процедура НастроитьОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(Элементы.ПроверкиСостояниеПредставление.Имя);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проверки.Статус");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = "error";
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);

КонецПроцедуры

