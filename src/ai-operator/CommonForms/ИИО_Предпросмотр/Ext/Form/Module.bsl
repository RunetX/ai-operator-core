// Предпросмотр действия ИИ-оператора: объекты, их состояние, что изменится и результаты проверок.
// Изменения выполняются только по кнопке «Выполнить»: ключ подтверждения создается при открытии формы
// и без него сервер ничего не меняет. Отмена и истечение срока ничего не меняют и сообщаются модели как cancelled.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Параметры.АдресПлана, УникальныйИдентификатор);
	План = Предпросмотр.План;
	АдресПлана = Предпросмотр.АдресПлана;
	Если Предпросмотр.Ключ <> Неопределено Тогда
		КлючПодтверждения = Предпросмотр.Ключ;
	КонецЕсли;
	ПробныйЗапуск = План.ПробныйЗапуск;
	Пакет = План.Пакет;
	ПредставлениеДействия = План.Представление;
	Режим = ?(ПробныйЗапуск, "просмотр", "ожидание");
	СрокСек = ИИО_Настройки.Значение("ИИО_СрокПредпросмотраСек");

	Изменится = 0;
	СОшибками = 0;
	Необратимых = 0;
	Для Каждого Строка Из План.Объекты Цикл
		НоваяСтрока = Объекты.Добавить();
		НоваяСтрока.Объект = Строка.Ссылка;
		НоваяСтрока.Состояние = Строка.ПредставлениеСостояния;
		НоваяСтрока.Изменение = ?(Строка.Выполнять, Строка.ПредставлениеИзменения, Строка.Причина);
		Замечания = Новый Массив;
		Для Каждого Текст Из Строка.Ошибки Цикл
			Замечания.Добавить(Текст);
		КонецЦикла;
		Для Каждого Текст Из Строка.Предупреждения Цикл
			Замечания.Добавить(Текст);
		КонецЦикла;
		НоваяСтрока.Проверки = ?(Замечания.Количество() = 0 И Строка.Выполнять, НСтр("ru = 'Замечаний нет'"),
			СтрСоединить(Замечания, Символы.ПС));
		НоваяСтрока.Выполнять = Строка.Выполнять;
		НоваяСтрока.ЕстьОшибки = Строка.Ошибки.Количество() > 0;
		Изменится = Изменится + ?(Строка.Выполнять, 1, 0);
		СОшибками = СОшибками + ?(НоваяСтрока.ЕстьОшибки, 1, 0);
		Необратимых = Необратимых + ?(Строка.Выполнять И Не Строка.Обратимо, 1, 0);
	КонецЦикла;
	КОбработке = Объекты.Количество();

	Заголовок = ?(ПробныйЗапуск, НСтр("ru = 'ИИ-оператор: пробный запуск действия'"),
		НСтр("ru = 'ИИ-оператор: подтвердите действие'"));
	Элементы.ТекстДействия.Заголовок = СтрШаблон(НСтр("ru = 'ИИ-оператор предлагает: %1'"), План.Представление);
	Элементы.ТекстДействия.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Если ПробныйЗапуск Тогда
		Пояснение = НСтр("ru = 'Пробный запуск: ничего не изменится, это только проверка.'");
	Иначе
		Пояснение = НСтр(
			"ru = 'Изменения будут выполнены только после нажатия «Выполнить». «Отмена» ничего не меняет.'");
	КонецЕсли;
	Элементы.ТекстПояснения.Заголовок = СтрШаблон(НСтр("ru = '%1 Изменится объектов: %2 из %3.'"),
		Пояснение, Формат(Изменится, "ЧН=0; ЧГ=0"), Формат(Объекты.Количество(), "ЧН=0; ЧГ=0"));

	Предупреждения = Новый Массив;
	Если Необратимых > 0 Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Объектов, изменение которых нельзя откатить: %1.'"),
			Формат(Необратимых, "ЧГ=0")));
	КонецЕсли;
	Если СОшибками > 0 Тогда
		Предупреждения.Добавить(СтрШаблон(
			НСтр("ru = 'У %1 объектов проверки нашли ошибки: скорее всего, по ним действие не выполнится.'"),
			Формат(СОшибками, "ЧГ=0")));
	КонецЕсли;
	Если План.НеНайдено.Количество() > 0 Тогда
		Предупреждения.Добавить(СтрШаблон(НСтр("ru = 'Не найдено или недоступно объектов: %1.'"),
			Формат(План.НеНайдено.Количество(), "ЧГ=0")));
	КонецЕсли;
	Элементы.ТекстПредупреждения.Заголовок = СтрСоединить(Предупреждения, Символы.ПС);
	Элементы.ТекстПредупреждения.Видимость = Предупреждения.Количество() > 0;
	Элементы.ТекстПредупреждения.ЦветТекста = ЦветаСтиля.ПоясняющийОшибкуТекст;

	Элементы.ФормаВыполнитьДействие.Видимость = Не ПробныйЗапуск И Изменится > 0;
	Элементы.ФормаВыполнитьДействие.Шрифт = ШрифтыСтиля.ВажнаяНадписьШрифт;
	Элементы.ФормаОтменитьДействие.Видимость = Не ПробныйЗапуск;
	Элементы.ФормаКомандаЗакрыть.Видимость = ПробныйЗапуск;
	Элементы.ОбъектыРезультат.Видимость = Ложь;
	Элементы.ТекстИтога.Видимость = Ложь;

	// Надписи во всю ширину формы, строки таблицы - по высоте текста проверок и результатов.
	Для Каждого ИмяЭлемента Из СтрРазделить("ТекстДействия,ТекстПояснения,ТекстПредупреждения,ТекстИтога", ",") Цикл
		Элементы[ИмяЭлемента].АвтоМаксимальнаяШирина = Ложь;
		Элементы[ИмяЭлемента].РастягиватьПоГоризонтали = Истина;
	КонецЦикла;
	Для Каждого ИмяЭлемента Из СтрРазделить("ОбъектыИзменение,ОбъектыПроверки,ОбъектыРезультат", ",") Цикл
		Элементы[ИмяЭлемента].АвтоВысотаЯчейки = Истина;
	КонецЦикла;
	НастроитьОформление();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Режим = "ожидание" Тогда
		НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
		ПоказатьСрок();
		ПодключитьОбработчикОжидания("ПроверитьСрок", 1, Ложь);
	КонецЕсли;
	Активизировать();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Режим = "выполнение" Тогда
		Отказ = Истина;
		Если Не ЗавершениеРаботы Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Дождитесь окончания выполнения: объекты обрабатываются по одному.'"));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Режим = "ожидание" И Не ЗавершениеРаботы Тогда
		// Закрытие окна без решения - такая же отмена, как кнопка «Отмена».
		Отменить("user");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьДействие(Команда)

	Если Режим <> "ожидание" Тогда
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ПроверитьСрок");
	Режим = "выполнение";
	Позиция = 0;
	Элементы.ФормаВыполнитьДействие.Доступность = Ложь;
	Элементы.ФормаОтменитьДействие.Доступность = Ложь;
	Элементы.ОбъектыРезультат.Видимость = Истина;
	Элементы.ТекстИтога.Видимость = Истина;
	ПодключитьОбработчикОжидания("ВыполнитьСледующуюПорцию", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьДействие(Команда)

	Если Режим = "ожидание" Тогда
		Отменить("user");
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрыть(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Порции обрабатываются через обработчик ожидания, чтобы между ними форма успевала показать результаты.
&НаКлиенте
Процедура ВыполнитьСледующуюПорцию()

	Размер = 5;
	Попытка
		Результаты = ВыполнитьПорциюНаСервере(АдресПлана, КлючПодтверждения, Позиция, Размер);
	Исключение
		Режим = "готово";
		ТекстОшибки = ОбработкаОшибок.СообщениеОбОшибкеДляПользователя(ИнформацияОбОшибке());
		Элементы.ТекстИтога.Заголовок = СтрШаблон(НСтр("ru = 'Выполнение прервано: %1'"), ТекстОшибки);
		ИИО_ДействияКлиент.ЗавершитьПредпросмотр(Пакет, ИИО_ОтветКлиентСервер.Ошибка("INTERNAL",
			СтрШаблон(НСтр("ru = 'Выполнение пакета %1 прервано: %2'"), Пакет, ТекстОшибки),
			НСтр("ru = 'Часть объектов могла измениться: результат виден в журнале операций ИИ-оператора в 1С.'")));
		ПоказатьКнопкуЗакрыть();
		Возврат;
	КонецПопытки;

	Для Каждого Результат Из Результаты Цикл
		Строка = Объекты[Результат.Индекс];
		Если Результат.Результат = "done" Тогда
			Строка.Результат = НСтр("ru = 'Выполнено'");
		ИначеЕсли Результат.Результат = "failed" Тогда
			Строка.Результат = НСтр("ru = 'Ошибка: '") + Результат.ТекстОшибки;
		Иначе
			Строка.Результат = НСтр("ru = 'Пропущено'");
		КонецЕсли;
	КонецЦикла;
	Позиция = Позиция + Размер;
	Сделано = Мин(Позиция, КОбработке);
	Элементы.ТекстИтога.Заголовок = СтрШаблон(НСтр("ru = 'Обработано %1 из %2...'"),
		Формат(Сделано, "ЧН=0; ЧГ=0"), Формат(КОбработке, "ЧН=0; ЧГ=0"));
	ИИО_ДействияКлиент.СообщитьПрогресс(Пакет, Сделано, КОбработке,
		НСтр("ru = 'Пользователь подтвердил, объекты обрабатываются'"));

	Если Позиция < КОбработке Тогда
		ПодключитьОбработчикОжидания("ВыполнитьСледующуюПорцию", 0.1, Истина);
		Возврат;
	КонецЕсли;

	Ответ = ЗавершитьПакетНаСервере(АдресПлана, КлючПодтверждения);
	Режим = "готово";
	Итог = СтрШаблон(НСтр("ru = 'Выполнено: %1, с ошибкой: %2, пропущено: %3.'"),
		Формат(Ответ.summary.done, "ЧН=0; ЧГ=0"), Формат(Ответ.summary.failed, "ЧН=0; ЧГ=0"),
		Формат(Ответ.summary.skipped, "ЧН=0; ЧГ=0"));
	Элементы.ТекстИтога.Заголовок = СтрШаблон(НСтр("ru = 'Готово. %1 Пакет записан в журнал операций ИИ-оператора.'"),
		Итог);
	ИИО_ДействияКлиент.ЗавершитьПредпросмотр(Пакет, Ответ);
	ОповеститьОбИзмененииОбъектов();

	Если Ответ.summary.failed = 0 Тогда
		// Итог без ошибок не требует внимания: окно закрывается, итог остается в оповещении и в журнале операций.
		ПоказатьОповещениеПользователя(СтрШаблон(НСтр("ru = 'ИИ-оператор: %1'"), ПредставлениеДействия), , Итог);
		Закрыть();
		Возврат;
	КонецЕсли;
	ПоказатьКнопкуЗакрыть();

КонецПроцедуры

// Срок ожидания решения: по истечении форма закрывается как отмененная.
&НаКлиенте
Процедура ПроверитьСрок()

	Если Режим <> "ожидание" Тогда
		ОтключитьОбработчикОжидания("ПроверитьСрок");
		Возврат;
	КонецЕсли;
	ПрошлоСек = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания) / 1000);
	Если ПрошлоСек >= СрокСек Тогда
		ОтключитьОбработчикОжидания("ПроверитьСрок");
		Отменить("timeout");
		Закрыть();
		Возврат;
	КонецЕсли;
	ПоказатьСрок();
	Если ПрошлоСек % 5 = 0 Тогда
		ИИО_ДействияКлиент.СообщитьПрогресс(Пакет, ПрошлоСек, СрокСек,
			НСтр("ru = 'Ожидание подтверждения пользователя в 1С'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСрок()

	Осталось = Макс(0, СрокСек - Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания) / 1000));
	Элементы.ТекстИтога.Видимость = Истина;
	Элементы.ТекстИтога.Заголовок = СтрШаблон(НСтр("ru = 'Окно закроется без изменений через %1 с.'"),
		Формат(Осталось, "ЧН=0; ЧГ=0"));

КонецПроцедуры

// Отмена по запросу клиента MCP, пока пользователь не принял решение.
//
// Параметры:
//  Причина - Строка - client или timeout.
&НаКлиенте
Процедура ОтменитьПоЗапросуКлиента(Причина) Экспорт

	Если Режим = "ожидание" Тогда
		Отменить(Причина);
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отменить(Причина)

	Режим = "отменено";
	ОтключитьОбработчикОжидания("ПроверитьСрок");
	Ответ = ОтменитьНаСервере(АдресПлана, Причина);
	Если Ответ <> Неопределено Тогда
		ИИО_ДействияКлиент.ЗавершитьПредпросмотр(Пакет, Ответ);
	КонецЕсли;

КонецПроцедуры

// Открытые списки и формы объектов пакета перечитывают данные.
&НаКлиенте
Процедура ОповеститьОбИзмененииОбъектов()

	Типы = Новый Массив;
	Для Каждого Строка Из Объекты Цикл
		Если Строка.Выполнять И Типы.Найти(ТипЗнч(Строка.Объект)) = Неопределено Тогда
			Типы.Добавить(ТипЗнч(Строка.Объект));
		КонецЕсли;
	КонецЦикла;
	Для Каждого Тип Из Типы Цикл
		ОповеститьОбИзменении(Тип);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКнопкуЗакрыть()

	Элементы.ФормаВыполнитьДействие.Видимость = Ложь;
	Элементы.ФормаОтменитьДействие.Видимость = Ложь;
	Элементы.ФормаКомандаЗакрыть.Видимость = Истина;
	Элементы.ФормаКомандаЗакрыть.КнопкаПоУмолчанию = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьПорциюНаСервере(Знач АдресПлана, Знач КлючПодтверждения, Знач Позиция, Знач Размер)

	Возврат ИИО_Действия.ВыполнитьПорцию(АдресПлана, КлючПодтверждения, Позиция, Размер);

КонецФункции

&НаСервереБезКонтекста
Функция ЗавершитьПакетНаСервере(Знач АдресПлана, Знач КлючПодтверждения)

	Возврат ИИО_Действия.ЗавершитьПакет(АдресПлана, КлючПодтверждения);

КонецФункции

&НаСервереБезКонтекста
Функция ОтменитьНаСервере(Знач АдресПлана, Знач Причина)

	Возврат ИИО_Действия.ОтменитьПакет(АдресПлана, Причина);

КонецФункции

&НаСервере
Процедура НастроитьОформление()

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Кирпичный);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объекты.ЕстьОшибки");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Истина;
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ОбъектыПроверки");

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Серый);
	Отбор = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объекты.Выполнять");
	Отбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Отбор.ПравоеЗначение = Ложь;
	Для Каждого ИмяПоля Из СтрРазделить("ОбъектыОбъект,ОбъектыСостояние,ОбъектыИзменение,ОбъектыПроверки", ",") Цикл
