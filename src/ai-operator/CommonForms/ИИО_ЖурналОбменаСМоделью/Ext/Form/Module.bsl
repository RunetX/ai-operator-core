// Что видела нейросеть - журнал обмена с моделью: обращения за период и переписка выбранного
// обращения - ровно в том виде, в каком ее получила модель, с токенами вместо персональных данных.
// Пользователь видит свои обращения, администратор ИИ-оператора - обращения всех пользователей.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = НачалоДня(ТекущаяДатаСеанса() - 6 * 86400);
	Период.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
	Элементы.ВсеПользователи.Видимость = ИИО_Права.ЭтоАдминистраторИИОператора();
	ЗаполнитьОбращения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)

	ЗаполнитьОбращения();

КонецПроцедуры

&НаКлиенте
Процедура ВсеПользователиПриИзменении(Элемент)

	ЗаполнитьОбращения();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбращения

&НаКлиенте
Процедура ОбращенияПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьПереписку", 0.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОбращенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Обращения.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьОбращения();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьПереписку()

	ТекущиеДанные = Элементы.Обращения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Переписка = "";
		ТекущийКлюч = "";
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Ключ = ТекущийКлюч Тогда
		Возврат;
	КонецЕсли;
	ТекущийКлюч = ТекущиеДанные.Ключ;
	Переписка = ПерепискаHTML(ТекущиеДанные.Ключ);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбращения()

	Обращения.Очистить();
	Переписка = "";
	ТекущийКлюч = "";
	Для Каждого Запись Из ИИО_Журнал.ОбменСМоделью(Период.ДатаНачала, Период.ДатаОкончания, ВсеПользователи) Цикл
		Строка = Обращения.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Запись, "Дата, Ключ, Автор, Шаги, Скрыто, Объект");
		Строка.Статус = ПредставлениеСтатуса(Запись.Статус);
		Строка.Канал = ?(Запись.Канал = "bot", НСтр("ru = 'Обсуждение (бот)'"), НСтр("ru = 'Чат (MCP)'"));
		Строка.Источник = ?(Запись.Канал = "bot", Запись.Модель, Запись.Инструмент);
		Строка.Токены = Запись.ТокеныЗапроса + Запись.ТокеныОтвета;
		Строка.Длительность = Запись.ДлительностьМс / 1000;
	КонецЦикла;

КонецПроцедуры

// Статус хода бота или вызова инструмента словами; коды ошибок инструментов (QUERY_SYNTAX и т. п.) - как есть.
//
// Параметры:
//  Статус - Строка
//
// Возвращаемое значение:
//  Строка
&НаСервереБезКонтекста
Функция ПредставлениеСтатуса(Статус)

	Если Статус = "ok" Тогда
		Возврат НСтр("ru = 'Готово'");
	ИначеЕсли Статус = "model_error" Тогда
		Возврат НСтр("ru = 'Ошибка модели'");
	ИначеЕсли Статус = "model_unavailable" Тогда
		Возврат НСтр("ru = 'Модель недоступна'");
	ИначеЕсли Статус = "step_limit" Тогда
		Возврат НСтр("ru = 'Лимит шагов'");
	ИначеЕсли Статус = "deadline" Тогда
		Возврат НСтр("ru = 'Не успел ответить'");
	КонецЕсли;
	Возврат Статус;

КонецФункции

// Переписка обращения как чат: вопрос, ответы модели, вызовы инструментов и их ответы; токены подсвечены.
// Все тексты экранируются: в переписке могут быть строки из базы и ответы модели.
//
// Параметры:
//  Ключ - Строка - Ключ записи журнала.
//
// Возвращаемое значение:
//  Строка - HTML.
&НаСервереБезКонтекста
Функция ПерепискаHTML(Знач Ключ)

	Текст = ИИО_Журнал.ПерепискаОбмена(Ключ);
	Если Текст = Неопределено Тогда
		Возврат ДокументHTML(НСтр("ru = '<p>Запись недоступна.</p>'"));
	КонецЕсли;
	Сообщения = Неопределено;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Сообщения = ПрочитатьJSON(Чтение, Истина);
	Исключение
		// Ожидаемый случай - переписка обрезана по пределу длины: показываем ее текстом, а причину пишем
		// в журнал регистрации, чтобы другие сбои разбора не прошли бесследно.
		ИИО_Журнал.ЗаписатьСобытие("ЖурналОбмена.Разбор", УровеньЖурналаРегистрации.Предупреждение,
			Новый Структура("key, error", Ключ, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат ДокументHTML("<pre>" + ТекстHTML(Текст) + "</pre>");
	КонецПопытки;
	Если ТипЗнч(Сообщения) <> Тип("Массив") Тогда
		Возврат ДокументHTML("<pre>" + ТекстHTML(Текст) + "</pre>");
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Роль = Сообщение.Получить("role");
		Содержимое = Сообщение.Получить("content");
		Содержимое = ?(ТипЗнч(Содержимое) = Тип("Строка"), Содержимое, "");
		Если Роль = "system" Тогда
			Части.Добавить(СтрШаблон("<details><summary>%1</summary><pre>%2</pre></details>",
				НСтр("ru = 'Инструкции и контекст (системное сообщение)'"), ТекстHTML(Содержимое)));
		ИначеЕсли Роль = "user" Тогда
			Части.Добавить("<div class=""user"">" + ТекстHTML(Содержимое) + "</div>");
		ИначеЕсли Роль = "tool" Тогда
			Части.Добавить(СтрШаблон("<details><summary>%1</summary><pre>%2</pre></details>",
				СтрШаблон(НСтр("ru = 'Ответ инструмента, символов: %1'"), Формат(СтрДлина(Содержимое), "ЧН=0; ЧГ=0")),
				ТекстHTML(Содержимое)));
		Иначе
			Если ЗначениеЗаполнено(Содержимое) Тогда
				Части.Добавить("<div class=""bot"">" + ТекстHTML(Содержимое) + "</div>");
			КонецЕсли;
			ДобавитьВызовы(Части, Сообщение.Получить("tool_calls"));
		КонецЕсли;
	КонецЦикла;
	Возврат ДокументHTML(СтрСоединить(Части, Символы.ПС));

КонецФункции

// Добавляет вызовы инструментов ответа модели плашками «▸ имя(аргументы)».
//
// Параметры:
//  Части - Массив из Строка
//  Вызовы - Массив из Соответствие, Неопределено
&НаСервереБезКонтекста
Процедура ДобавитьВызовы(Части, Вызовы)

	Если ТипЗнч(Вызовы) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вызов Из Вызовы Цикл
		ОписаниеФункции = ?(ТипЗнч(Вызов) = Тип("Соответствие"), Вызов.Получить("function"), Неопределено);
		Если ТипЗнч(ОписаниеФункции) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Аргументы = ОписаниеФункции.Получить("arguments");
		Части.Добавить(СтрШаблон("<div class=""call"">&#9656; %1(%2)</div>",
			ТекстHTML(Строка(ОписаниеФункции.Получить("name"))),
			ТекстHTML(?(ТипЗнч(Аргументы) = Тип("Строка"), Аргументы, ""))));
	КонецЦикла;

КонецПроцедуры

// Экранирует текст для HTML и подсвечивает токены маскирования.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
&НаСервереБезКонтекста
Функция ТекстHTML(Текст)

	Результат = СтрЗаменить(Текст, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	Подсвеченные = Новый Соответствие;
	// Токен «[Вид#номер]» после экранирования не меняется: в нем нет экранируемых символов.
	Для Каждого Токен Из ИИО_МаскированиеКлиентСервер.ТокеныТекста(Результат) Цикл
		Если Подсвеченные.Получить(Токен.Токен) = Неопределено Тогда
			Подсвеченные.Вставить(Токен.Токен, Истина);
			Результат = СтрЗаменить(Результат, Токен.Токен, "<mark>" + Токен.Токен + "</mark>");
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ДокументHTML(Тело)

	Возврат "<html><head><meta charset=""utf-8""><style>
	|body { font-family: Arial, sans-serif; font-size: 10pt; color: #1f2430; margin: 8px; }
	|div.user { background: #e8eefc; border-radius: 8px; padding: 6px 10px; margin: 6px 0 6px 15%;
	|  white-space: pre-wrap; }
	|div.bot { background: #f3f4f7; border-radius: 8px; padding: 6px 10px; margin: 6px 15% 6px 0;
	|  white-space: pre-wrap; }
	|div.call { font-family: Consolas, monospace; font-size: 9pt; color: #1d6b3a; margin: 4px 0; }
	|details { margin: 4px 0; } summary { color: #5b6170; cursor: pointer; }
	|pre { white-space: pre-wrap; font-size: 9pt; background: #fafafa; padding: 6px; }
	|mark { background: #fdf0c8; }
	|</style></head><body>" + Тело + "</body></html>";

КонецФункции

#КонецОбласти
