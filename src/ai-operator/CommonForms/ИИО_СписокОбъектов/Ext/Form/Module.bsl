// Объекты разных видов, которые ИИ-оператор показал пользователю (инструмент show_in_1c).
// Объекты одного вида открываются в их штатной форме списка, а не здесь.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	Если ТипЗнч(Параметры.Ссылки) <> Тип("Массив") И ТипЗнч(Параметры.Ссылки) <> Тип("ФиксированныйМассив") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Ссылка Из Параметры.Ссылки Цикл
		НоваяСтрока = Объекты.Добавить();
		НоваяСтрока.Объект = Ссылка;
		НоваяСтрока.Вид = Ссылка.Метаданные().Представление();
	КонецЦикла;
	Объекты.Сортировать("Вид");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъекты

&НаКлиенте
Процедура ОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.Объекты.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(, ТекущиеДанные.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти