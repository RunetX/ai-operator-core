// Что видит нейросеть: состояние защиты и сводка журнала обмена за 30 дней,
// проверка фразы пользователя, списки слов маскирования ввода и реестр полей - преднастройка для конфигурации
// и изменения администратора.
// В регистр ИИО_МаскируемыеПоля пишутся только отличия от преднастройки.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВидыПДн = ИИО_Маскирование.ВидыПДн();
	ЗаполнитьВидыПДн(Элементы.ПравилаВидПДн.СписокВыбора, ВидыПДн);
	ЗаполнитьВидыПДн(Элементы.СловаВидПДн.СписокВыбора, ВидыПДн);
	ЭтоАдминистратор = ИИО_Права.ЭтоАдминистраторИИОператора();
	Если Не ЭтоАдминистратор Тогда
		Элементы.Правила.ТолькоПросмотр = Истина;
		Элементы.Слова.ТолькоПросмотр = Истина;
		Элементы.ФормаЗаписать.Доступность = Ложь;
		Элементы.ФормаВернутьПреднастройку.Доступность = Ложь;
	КонецЕсли;
	// Откуда взята замена (база, эвристика) говорит, есть ли человек в базе: это видит только администратор.
	Элементы.Замены.Видимость = ЭтоАдминистратор;
	Элементы.СостояниеПоиска.Заголовок = СостояниеПоиска();
	СтрогийРежим = ИИО_Настройки.Значение("ИИО_СтрогийРежимМаскирования") = Истина;
	Элементы.СтрогийРежим.Доступность = ЭтоАдминистратор;
	Элементы.Состояние.Заголовок = СостояниеЗащиты();
	ЗаполнитьПравила();
	ЗаполнитьСлова();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Изменения правил маскирования не записаны.'");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Правила маскирования изменены. Записать?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрогийРежимПриИзменении(Элемент)

	Элементы.Состояние.Заголовок = ЗаписатьСтрогийРежим(СтрогийРежим);
	Если Не СтрогийРежим Тогда
		// Юрлица, скрытые строгим режимом, остались в словаре токенов сеанса и скрывались бы в тексте ответов.
		ИИО_МаскированиеКлиент.ЗабытьЗначения();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СостояниеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "journal" Тогда
		ОткрытьФорму("ОбщаяФорма.ИИО_ЖурналОбменаСМоделью", , ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравила

&НаКлиенте
Процедура ПравилаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Источник = ИсточникПравила(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПравилаПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ЕстьВПреднастройке Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(,
			НСтр("ru = 'Правило преднастройки не удаляется. Чтобы не маскировать поле, очистите вид ПДн.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьФразу(Команда)

	ПроверитьФразуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьПравила();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьПреднастройку(Команда)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЕстьВПреднастройке Тогда
		ТекущиеДанные.ВидПДн = ТекущиеДанные.ВидПреднастройки;
		ТекущиеДанные.Условие = ТекущиеДанные.УсловиеПреднастройки;
		ТекущиеДанные.Источник = ИсточникПравила(ТекущиеДанные);
	Иначе
		Правила.Удалить(ТекущиеДанные);
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если Не ЗаписатьПравила() Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Функция ЗаписатьПравила()

	Запись = ЗаписатьНаСервере();
	Если Запись.Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Запись.Ошибки, Символы.ПС));
		Возврат Ложь;
	КонецЕсли;
	// Кэш правил этого сеанса сбрасывается сразу, остальные сеансы увидят изменения после перезапуска.
	ОбновитьПовторноИспользуемыеЗначения();
	// Значения, которые скрывали прежние правила, остались в словаре токенов сеанса и скрывались бы в тексте
	// ответов. Забываются только после ослабления: иначе словарь перестал бы скрывать и то, что скрыто по-прежнему.
	Если Запись.Ослаблено Тогда
		ИИО_МаскированиеКлиент.ЗабытьЗначения();
	КонецЕсли;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Правила маскирования записаны'"));
	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	Строки = Новый Массив;
	Для Каждого Строка Из Правила Цикл
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			Строка.Объект, Строка.Поле, Строка.ВидПДн, Строка.Условие));
	КонецЦикла;
	СтрокиСлов = Новый Массив;
	Для Каждого Строка Из Слова Цикл
		СтрокиСлов.Добавить(Новый Структура("Слово, ВидПДн", Строка.Слово, Строка.ВидПДн));
	КонецЦикла;
	Ослаблено = МаскированиеОслаблено(Строки, СтрокиСлов);
	// Слова проверяются до записи правил: при ошибке в списке слов не пишется ни один список.
	// ЗаписатьПравила сама проверяет правила до записи.
	Ошибки = ИИО_МаскированиеВвода.ОшибкиСлов(СтрокиСлов);
	Если Ошибки.Количество() = 0 Тогда
		Ошибки = ИИО_Маскирование.ЗаписатьПравила(Строки);
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		Ошибки = ИИО_МаскированиеВвода.ЗаписатьСлова(СтрокиСлов);
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		ЗаполнитьПравила();
		ЗаполнитьСлова();
		Модифицированность = Ложь;
	КонецЕсли;
	Возврат Новый Структура("Ошибки, Ослаблено", Ошибки, Ослаблено);

КонецФункции

// Ослабляет ли запись маскирование: правило, которое скрывало поле, отключено, удалено или получило другое
// условие; слово, которое скрывалось всегда, удалено или больше не скрывается.
//
// Параметры:
//  Строки - Массив из Структура - Правила формы: Объект, Поле, ВидПДн, Условие.
//  СтрокиСлов - Массив из Структура - Слова формы: Слово, ВидПДн.
//
// Возвращаемое значение:
//  Булево
&НаСервереБезКонтекста
Функция МаскированиеОслаблено(Строки, СтрокиСлов)

	Новые = Новый Соответствие;
	Для Каждого Строка Из Строки Цикл
		Новые.Вставить(Строка.Объект + "|" + Строка.Поле, Строка);
	КонецЦикла;
	Для Каждого Прежнее Из ИИО_Маскирование.ПравилаДляНастройки() Цикл
		Новое = Новые.Получить(Прежнее.Объект + "|" + Прежнее.Поле);
		Если ЗначениеЗаполнено(Прежнее.ВидПДн) И (Новое = Неопределено Или Не ЗначениеЗаполнено(Новое.ВидПДн)
			Или Новое.Условие <> Прежнее.Условие) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	НовыеСлова = Новый Соответствие;
	Для Каждого Строка Из СтрокиСлов Цикл
		НовыеСлова.Вставить(НРег(СокрЛП(Строка.Слово)), Строка.ВидПДн);
	КонецЦикла;
	Для Каждого Прежнее Из ИИО_МаскированиеВвода.СловаДляНастройки() Цикл
		Если ЗначениеЗаполнено(Прежнее.ВидПДн) И Не ЗначениеЗаполнено(НовыеСлова.Получить(НРег(Прежнее.Слово))) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Пустой вид - «не скрывать»: так отключается правило поля и слово списка не маскируется.
//
// Параметры:
//  СписокВыбора - СписокЗначений - Список выбора поля вида ПДн.
//  ВидыПДн - Массив из Строка - см. ИИО_Маскирование.ВидыПДн
&НаСервере
Процедура ЗаполнитьВидыПДн(СписокВыбора, ВидыПДн)

	СписокВыбора.Добавить("", НСтр("ru = 'не скрывать'"));
	Для Каждого Вид Из ВидыПДн Цикл
		СписокВыбора.Добавить(Вид);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПравила()

	Правила.Очистить();
	Для Каждого Описание Из ИИО_Маскирование.ПравилаДляНастройки() Цикл
		Строка = Правила.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Описание);
		Строка.Источник = ИсточникПравила(Строка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлова()

	Слова.Очистить();
	Для Каждого Описание Из ИИО_МаскированиеВвода.СловаДляНастройки() Цикл
		ЗаполнитьЗначенияСвойств(Слова.Добавить(), Описание);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПроверитьФразуНаСервере()

	Замены.Очистить();
	Если ПустаяСтрока(Фраза) Тогда
		РезультатПроверки = "";
		Возврат;
	КонецЕсли;
	Результат = ИИО_МаскированиеВвода.ЗамаскироватьВвод(Фраза, ИИО_МаскированиеКлиентСервер.НовыйСловарь());
	РезультатПроверки = Результат.Текст;
	Элементы.СостояниеПоиска.Заголовок = СостояниеПоиска() + Символы.ПС + ТекстПроверки(Результат.Проверка);
	Для Каждого Замена Из Результат.Замены Цикл
		ЗаполнитьЗначенияСвойств(Замены.Добавить(), Замена);
	КонецЦикла;

КонецПроцедуры

// Записывает строгий режим маскирования и сбрасывает кэш правил этого сеанса; остальные сеансы видят
// изменение после перезапуска, как и правки правил.
//
// Параметры:
//  Включить - Булево
//
// Возвращаемое значение:
//  ФорматированнаяСтрока - Новое состояние защиты, см. СостояниеЗащиты.
&НаСервереБезКонтекста
Функция ЗаписатьСтрогийРежим(Знач Включить)

	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		ВызватьИсключение НСтр("ru = 'Строгий режим включает и выключает администратор ИИ-оператора.'");
	КонецЕсли;
	Константы.ИИО_СтрогийРежимМаскирования.Установить(Включить);
	ОбновитьПовторноИспользуемыеЗначения();
	Возврат СостояниеЗащиты();

КонецФункции

// Состояние защиты для владельца данных: кто ищет людей не из базы, полнотекстовый поиск и сводка журнала
// обмена с моделью за 30 дней со ссылкой на журнал.
//
// Возвращаемое значение:
//  ФорматированнаяСтрока
&НаСервереБезКонтекста
Функция СостояниеЗащиты()

	Строки = Новый Массив;
	Строки.Добавить(НСтр("ru = 'Модель получает токены вместо персональных данных: людей из базы, ИНН физлиц, СНИЛС, паспорта, телефоны и почту.'"));
	Если ИИО_Настройки.Значение("ИИО_СтрогийРежимМаскирования") = Истина Тогда
		Строки.Добавить(НСтр("ru = 'Строгий режим: скрыты и данные контрагентов-юрлиц - наименование, ИНН, КПП, адреса и контакты.'"));
	КонецЕсли;
	Модель = ИИО_МодельHTTP.ПараметрыМодели("маскирование");
	Если Модель.Настроена И ИИО_МодельHTTP.ЛокальныйАдрес(Модель.Адрес) Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Людей не из базы ищет локальная модель маскирования (%1).'"), Модель.Адрес));
	Иначе
		Строки.Добавить(НСтр("ru = 'Людей не из базы ищут правила: локальная модель маскирования не задана.'"));
	КонецЕсли;
	Строки.Добавить(СостояниеПоиска());
	Сводка = ИИО_Журнал.СводкаОбращений(НачалоДня(ТекущаяДатаСеанса() - 29 * 86400), КонецДня(ТекущаяДатаСеанса()),
		ИИО_Права.ЭтоАдминистраторИИОператора());
	Строки.Добавить(СтрШаблон(НСтр("ru = 'За 30 дней обращений к модели: %1 (бот: %2, MCP: %3), скрыто: %4.'"),
		Формат(Сводка.Обращений, "ЧН=0; ЧГ=0"), Формат(Сводка.ХодовБота, "ЧН=0; ЧГ=0"),
		Формат(Сводка.ВызововMCP, "ЧН=0; ЧГ=0"), ?(ЗначениеЗаполнено(Сводка.Скрыто), Сводка.Скрыто, НСтр("ru = 'ничего'"))));
	Возврат Новый ФорматированнаяСтрока(СтрСоединить(Строки, Символы.ПС) + " ",
		Новый ФорматированнаяСтрока(НСтр("ru = 'Что видела нейросеть'"), , , , "journal"));

КонецФункции

// Подпись о том, как находятся люди из базы.
//
// Возвращаемое значение:
//  Строка
&НаСервереБезКонтекста
Функция СостояниеПоиска()

	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда
		Возврат НСтр("ru = 'Людей из базы находит полнотекстовый поиск.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Полнотекстовый поиск выключен: люди из базы находятся только по фамилии.
		|Включите поиск в настройках программы.'");

КонецФункции

// Кто искал людей, которых нет в базе, см. ИИО_МаскированиеВвода.ЗамаскироватьВвод.
//
// Параметры:
//  Проверка - Строка
//
// Возвращаемое значение:
//  Строка
&НаСервереБезКонтекста
Функция ТекстПроверки(Проверка)

	Если Проверка = "модель" Тогда
		Возврат НСтр("ru = 'Остальных людей искала локальная модель маскирования.'");
	ИначеЕсли Проверка = "эвристика" Тогда
		Возврат НСтр("ru = 'Остальных людей искали правила: локальная модель маскирования не задана.'");
	КонецЕсли;
	Возврат НСтр("ru = 'Остальных людей искали правила: локальная модель маскирования не ответила.'");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИсточникПравила(Строка)

	Если Не Строка.ЕстьВПреднастройке Тогда
		Возврат НСтр("ru = 'добавлено'");
	ИначеЕсли Строка.ВидПДн = Строка.ВидПреднастройки И Строка.Условие = Строка.УсловиеПреднастройки Тогда
		Возврат НСтр("ru = 'преднастройка'");
	ИначеЕсли Не ЗначениеЗаполнено(Строка.ВидПДн) Тогда
		Возврат НСтр("ru = 'отключено'");
	КонецЕсли;
	Возврат НСтр("ru = 'изменено'");

