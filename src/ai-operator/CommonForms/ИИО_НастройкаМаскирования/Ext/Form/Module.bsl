// Реестр маскирования ПДн: преднастройка для конфигурации и изменения администратора.
// В регистр ИИО_МаскируемыеПоля пишутся только отличия от преднастройки.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ПравилаВидПДн.СписокВыбора.ЗагрузитьЗначения(ИИО_Маскирование.ВидыПДн());
	Если Не ИИО_Права.ЭтоАдминистраторИИОператора() Тогда
		ТолькоПросмотр = Истина;
		Элементы.ФормаЗаписать.Доступность = Ложь;
		Элементы.ФормаВернутьПреднастройку.Доступность = Ложь;
	КонецЕсли;
	ЗаполнитьПравила();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = НСтр("ru = 'Изменения правил маскирования не записаны.'");
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
		НСтр("ru = 'Правила маскирования изменены. Записать?'"), РежимДиалогаВопрос.ДаНетОтмена);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравила

&НаКлиенте
Процедура ПравилаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные.Источник = ИсточникПравила(ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПравилаПередУдалением(Элемент, Отказ)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.ЕстьВПреднастройке Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(,
			НСтр("ru = 'Правило преднастройки не удаляется. Чтобы не маскировать поле, очистите вид ПДн.'"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)

	ЗаписатьПравила();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьПреднастройку(Команда)

	ТекущиеДанные = Элементы.Правила.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ЕстьВПреднастройке Тогда
		ТекущиеДанные.ВидПДн = ТекущиеДанные.ВидПреднастройки;
		ТекущиеДанные.Условие = ТекущиеДанные.УсловиеПреднастройки;
		ТекущиеДанные.Источник = ИсточникПравила(ТекущиеДанные);
	Иначе
		Правила.Удалить(ТекущиеДанные);
	КонецЕсли;
	Модифицированность = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если Не ЗаписатьПравила() Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Функция ЗаписатьПравила()

	Ошибки = ЗаписатьНаСервере();
	Если Ошибки.Количество() > 0 Тогда
		ПоказатьПредупреждение(, СтрСоединить(Ошибки, Символы.ПС));
		Возврат Ложь;
	КонецЕсли;
	// Кэш правил этого сеанса сбрасывается сразу, остальные сеансы увидят изменения после перезапуска.
	ОбновитьПовторноИспользуемыеЗначения();
	ПоказатьОповещениеПользователя(НСтр("ru = 'Правила маскирования записаны'"));
	Возврат Истина;

КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	Строки = Новый Массив;
	Для Каждого Строка Из Правила Цикл
		Строки.Добавить(Новый Структура("Объект, Поле, ВидПДн, Условие",
			Строка.Объект, Строка.Поле, Строка.ВидПДн, Строка.Условие));
	КонецЦикла;
	Ошибки = ИИО_Маскирование.ЗаписатьПравила(Строки);
	Если Ошибки.Количество() = 0 Тогда
		ЗаполнитьПравила();
		Модифицированность = Ложь;
	КонецЕсли;
	Возврат Ошибки;

КонецФункции

&НаСервере
Процедура ЗаполнитьПравила()

	Правила.Очистить();
	Для Каждого Описание Из ИИО_Маскирование.ПравилаДляНастройки() Цикл
		Строка = Правила.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Описание);
		Строка.Источник = ИсточникПравила(Строка);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИсточникПравила(Строка)

	Если Не Строка.ЕстьВПреднастройке Тогда
		Возврат НСтр("ru = 'добавлено'");
	ИначеЕсли Строка.ВидПДн = Строка.ВидПреднастройки И Строка.Условие = Строка.УсловиеПреднастройки Тогда
		Возврат НСтр("ru = 'преднастройка'");
	ИначеЕсли Не ЗначениеЗаполнено(Строка.ВидПДн) Тогда
		Возврат НСтр("ru = 'отключено'");
	КонецЕсли;
	Возврат НСтр("ru = 'изменено'");

КонецФункции

#КонецОбласти
