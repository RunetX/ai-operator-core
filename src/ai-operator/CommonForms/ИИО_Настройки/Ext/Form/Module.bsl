// Форма настроек ИИ-оператора: константы редактируются через основной реквизит «Набор констант».
// Ключ API модели хранится в безопасном хранилище и в форму не читается. Новые адреса моделей требуют
// разрешения на внешние ресурсы, если в базе включены профили безопасности (стандарт 794).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИсходныйАдресМодели = НаборКонстант.ИИО_АдресМодели;
	ИсходныйАдресМоделиМаскирования = НаборКонстант.ИИО_АдресМоделиМаскирования;
	ОбновитьПолеКлюча();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если ПараметрыЗаписи.Свойство("РазрешенияПолучены")
		Или НаборКонстант.ИИО_АдресМодели = ИсходныйАдресМодели
		И НаборКонстант.ИИО_АдресМоделиМаскирования = ИсходныйАдресМоделиМаскирования Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Оповещение = Новый ОписаниеОповещения("ПослеПроверкиРазрешений", ЭтотОбъект, ПараметрыЗаписи);
	Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.ПрофилиБезопасности") Тогда
		МодульРаботаВБезопасномРежимеКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("РаботаВБезопасномРежимеКлиент");
		Запросы = ЗапросыРазрешений(НаборКонстант.ИИО_АдресМодели, НаборКонстант.ИИО_АдресМоделиМаскирования);
		МодульРаботаВБезопасномРежимеКлиент.ПрименитьЗапросыНаИспользованиеВнешнихРесурсов(Запросы, ЭтотОбъект,
			Оповещение);
	Иначе
		ВыполнитьОбработкуОповещения(Оповещение, КодВозвратаДиалога.ОК);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если УдалитьКлючДоступа Тогда
		ИИО_МодельHTTP.ЗаписатьКлючДоступа("");
	ИначеЕсли ЗначениеЗаполнено(КлючДоступа) Тогда
		ИИО_МодельHTTP.ЗаписатьКлючДоступа(КлючДоступа);
	КонецЕсли;
	КлючДоступа = "";
	УдалитьКлючДоступа = Ложь;
	ИсходныйАдресМодели = НаборКонстант.ИИО_АдресМодели;
	ИсходныйАдресМоделиМаскирования = НаборКонстант.ИИО_АдресМоделиМаскирования;
	ОбновитьПолеКлюча();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Продолжение ПередЗаписью: разрешения получены или профили безопасности не используются.
//
// Параметры:
//  Результат - КодВозвратаДиалога
//  ПараметрыЗаписи - Структура
&НаКлиенте
Процедура ПослеПроверкиРазрешений(Результат, ПараметрыЗаписи) Экспорт

	Если Результат = КодВозвратаДиалога.ОК Тогда
		ПараметрыЗаписи.Вставить("РазрешенияПолучены");
		Записать(ПараметрыЗаписи);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗапросыРазрешений(Знач АдресМодели, Знач АдресМоделиМаскирования)

	Возврат ИИО_МодельHTTP.ЗапросыРазрешений(АдресМодели, АдресМоделиМаскирования);

КонецФункции

&НаСервере
Процедура ОбновитьПолеКлюча()

	КлючЗадан = ИИО_МодельHTTP.КлючДоступаЗадан();
	Элементы.КлючДоступа.ПодсказкаВвода = ?(КлючЗадан, НСтр("ru = 'Ключ задан'"), НСтр("ru = 'Ключ не задан'"));
	Элементы.УдалитьКлючДоступа.Видимость = КлючЗадан;

КонецПроцедуры

#КонецОбласти
